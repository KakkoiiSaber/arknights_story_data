    {
        "id": 78,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 79,
        "raw": "[name=\"메피스토\"]    …그건 뭐야? 누구한테 무슨 신호를 보낸 거야?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "…그건 뭐야? 누구한테 무슨 신호를 보낸 거야?"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 81,
        "raw": "[name=\"도베르만\"]    네가 상관할 일이 아니다, 꼬맹이.",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "네가 상관할 일이 아니다, 꼬맹이."
    },
    {
        "id": 82,
        "raw": "[name=\"도베르만\"]    (아미야?)",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "(아미야?)"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 84,
        "raw": "[name=\"메피스토\"]    이런, 다 큰 어른이 돼서 그렇게 예의 없는 말을 쓰면 안 되지. 그런 것도 몰라?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "이런, 다 큰 어른이 돼서 그렇게 예의 없는 말을 쓰면 안 되지. 그런 것도 몰라?"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 86,
        "raw": "[name=\"도베르만\"]    너 같은 놈들이 날뛰는 세상인데, 이런 말을 쓸 수밖에 없지 않겠나?",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "너 같은 놈들이 날뛰는 세상인데, 이런 말을 쓸 수밖에 없지 않겠나?"
    },
    {
        "id": 87,
        "raw": "[name=\"도베르만\"]    (아미야, 무슨 일이지?)",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "(아미야, 무슨 일이지?)"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 89,
        "raw": "[name=\"아미야\"]    (도베르만 씨, 퇴로가… 적 부대에 봉쇄당했어요!)",
        "type": "dialog",
        "speaker": "아미야",
        "content": "(도베르만 씨, 퇴로가… 적 부대에 봉쇄당했어요!)"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 91,
        "raw": "[name=\"도베르만\"]    (뭐라고! 몇 분밖에 안 지났는데 벌써 놈들이……)",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "(뭐라고! 몇 분밖에 안 지났는데 벌써 놈들이……)"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 93,
        "raw": "[name=\"메피스토\"]    저런 저런, 이러면 곤란하지.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "저런 저런, 이러면 곤란하지."
    },
    {
        "id": 94,
        "raw": "[name=\"메피스토\"]    성심성의껏 너희를 대접해주고 있는데…",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "성심성의껏 너희를 대접해주고 있는데…"
    },
    {
        "id": 95,
        "raw": "[name=\"메피스토\"]    너희는 설마……",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "너희는 설마……"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 97,
        "raw": "[name=\"메피스토\"]    ……도망치려는 거야?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "……도망치려는 거야?"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 99,
        "raw": "[name=\"도베르만\"]    쳇!",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "쳇!"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 101,
        "raw": "[name=\"메피스토\"]    너희가 게임에서 이기면, 여기서 도망치게 해줄게.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "너희가 게임에서 이기면, 여기서 도망치게 해줄게."
    },
    {
        "id": 102,
        "raw": "[name=\"메피스토\"]    내 친구가 너희를 갈가리 찢어놓고 싶은 모양이거든.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "내 친구가 너희를 갈가리 찢어놓고 싶은 모양이거든."
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 104,
        "raw": "[name=\"메피스토\"]    살아남기만 하면 너희가 이기는 거야! 어때? 정말 쉽지?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "살아남기만 하면 너희가 이기는 거야! 어때? 정말 쉽지?"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 106,
        "raw": "[name=\"도베르만\"]    에이스!",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "에이스!"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_014_riope\" )]",
        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 108,
        "raw": "[name=\"에이스\"]    강행 돌파 준비는 끝났다!",
        "type": "dialog",
        "speaker": "에이스",
        "content": "강행 돌파 준비는 끝났다!"
    },
    {
        "id": 109,
        "raw": "[name=\"에이스\"]    하지만 우선은 이 공격을 버텨야 해!",
        "type": "dialog",
        "speaker": "에이스",
        "content": "하지만 우선은 이 공격을 버텨야 해!"
    },
    {
        "id": 110,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 111,
        "raw": "[name=\"아미야\"]    ……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……"
    },
    {
        "id": 112,
        "raw": "[name=\"아미야\"]    왜 이러는 거죠! 재앙이 곧 닥친다고요! 빨리 몸을 피하지 않으면, 다들……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "왜 이러는 거죠! 재앙이 곧 닥친다고요! 빨리 몸을 피하지 않으면, 다들……"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 114,
        "raw": "[name=\"메피스토\"]    무슨 소리를 하는 거야?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "무슨 소리를 하는 거야?"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 116,
        "raw": "[name=\"메피스토\"]    재앙이 눈앞에 닥쳤을 때야말로… 축제를 열기 딱 좋은 때잖아?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "재앙이 눈앞에 닥쳤을 때야말로… 축제를 열기 딱 좋은 때잖아?"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 118,
        "raw": "[name=\"아미야\"]    …당신은…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…당신은…"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 120,
        "raw": "[name=\"메피스토\"]    자, 우리 고귀한 손님들. 너희를 게임에 초대할 수 있어서 정말 영광이야.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "자, 우리 고귀한 손님들. 너희를 게임에 초대할 수 있어서 정말 영광이야."
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_1002_nsabr_2\",name2=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2",
        "name2": "char_1002_nsabr_2"
    },
    {
        "id": 122,
        "raw": "[name=\"리유니온 멤버\"]    아… 아…!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "아… 아…!"
    },
    {
        "id": 123,
        "raw": "[name=\"리유니온 멤버\"]    주…죽인다!! 죽여버리겠어…네놈들을…!!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "주…죽인다!! 죽여버리겠어…네놈들을…!!"
    },
    {
        "id": 124,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 125,
        "raw": "[name=\"도베르만\"]    아미야, 조심해!",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "아미야, 조심해!"
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 127,
        "raw": "[name=\"메피스토\"]    아, 그렇지…",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "아, 그렇지…"
    },
    {
        "id": 128,
        "raw": "[name=\"메피스토\"]    우린 너희가 중심 구역에서 뭘 했는지도 알고 있어.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "우린 너희가 중심 구역에서 뭘 했는지도 알고 있어."
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 130,
        "raw": "[name=\"아미야\"]    …!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…!"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 132,
        "raw": "[name=\"메피스토\"]    너희가 중심 구역에서 데려간 계속 얼굴을 가리고 있던 그 녀석… 정말 놀라울 정도로 흥미롭던데?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "너희가 중심 구역에서 데려간 계속 얼굴을 가리고 있던 그 녀석… 정말 놀라울 정도로 흥미롭던데?"
    },
    {
        "id": 133,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 134,
        "raw": "[name=\"아미야\"]    ……?!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……?!"
    },
    {
        "id": 135,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 136,
        "raw": "[name=\"메피스토\"]    크라운슬레이어는 너희가 뭘 하는지, 어디로 가는지 궁금한 게 많은가 봐.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "크라운슬레이어는 너희가 뭘 하는지, 어디로 가는지 궁금한 게 많은가 봐."
    },
    {
        "id": 137,
        "raw": "[name=\"메피스토\"]    하지만 난 아니거든. 내가 관심 있는 건…",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "하지만 난 아니거든. 내가 관심 있는 건…"
    },
    {
        "id": 138,
        "raw": "[name=\"메피스토\"]    바로 너라고…… 넌 대체 누구야? 어디에서 온 거지?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "바로 너라고…… 넌 대체 누구야? 어디에서 온 거지?"
    },
    {
        "id": 139,
        "raw": "[name=\"메피스토\"]    그래, 너. 너 말이야… 넌 우리와 뭔가 달라.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "그래, 너. 너 말이야… 넌 우리와 뭔가 달라."
    },
    {
        "id": 140,
        "raw": "[name=\"메피스토\"]    그 시설에 대체 어떤 장치가 있었길래, 그 목숨을 유지할 수 있었던 걸까?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "그 시설에 대체 어떤 장치가 있었길래, 그 목숨을 유지할 수 있었던 걸까?"
    },
    {
        "id": 141,
        "raw": "[name=\"메피스토\"]    궁금해. 궁금해 미치겠단 말이지.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "궁금해. 궁금해 미치겠단 말이지."
    },
    {
        "id": 142,
        "raw": "[name=\"메피스토\"]    나도 그렇게 차가운 사람은 아니거든……",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "나도 그렇게 차가운 사람은 아니거든……"
    },
    {
        "id": 143,
        "raw": "[name=\"메피스토\"]    로도스 아일랜드의 손님들, 인사 겸 선물한다 치고 그 녀석을 나한테 선물로 넘겨줘.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "로도스 아일랜드의 손님들, 인사 겸 선물한다 치고 그 녀석을 나한테 선물로 넘겨줘."
    },
    {
        "id": 144,
        "raw": "[name=\"메피스토\"]    그럼 내가 좀 손해 보는 느낌이긴 하지만… 너희를 보내줄 수도 있을 것 같거든?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "그럼 내가 좀 손해 보는 느낌이긴 하지만… 너희를 보내줄 수도 있을 것 같거든?"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 146,
        "raw": "[name=\"아미야\"]    박사님……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "박사님……"
    },
    {
        "id": 147,
        "raw": "[name=\"아미야\"]    ……제 뒤로 물러서세요!!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……제 뒤로 물러서세요!!"
