        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"첸\"]  네겐 보여줄 수 없는 일이다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "네겐 보여줄 수 없는 일이다."
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"스와이어\"]  첩보원들한테 연락이 안 와?",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "첩보원들한테 연락이 안 와?"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"첸\"]  굳이 이런 일에까지 네 직감을 발휘해야겠나?",
        "type": "dialog",
        "speaker": "첸",
        "content": "굳이 이런 일에까지 네 직감을 발휘해야겠나?"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 81,
        "raw": "[name=\"스와이어\"]  맞나 보네? 감염자야?",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "맞나 보네? 감염자야?"
    },
