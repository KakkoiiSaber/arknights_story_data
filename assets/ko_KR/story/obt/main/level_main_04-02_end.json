    {
        "id": 103,
        "raw": "[name=\"아미야\"]   저런 어린아이도 마지막엔, 마지막에는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저런 어린아이도 마지막엔, 마지막에는…"
    },
    {
        "id": 104,
        "raw": "신분을 박탈당한 자. 감염자. 너희는 사람도 아니야.",
        "type": "narration",
        "content": "신분을 박탈당한 자. 감염자. 너희는 사람도 아니야."
    },
    {
        "id": 105,
        "raw": "[name=\"아미야\"]   내가 뭘 할 수 있을까? 내가 더 할 수 있는 건…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "내가 뭘 할 수 있을까? 내가 더 할 수 있는 건…"
    },
    {
        "id": 106,
        "raw": "[name=\"아미야\"]   난 왜… 모두를 지켜줄 수 없는 걸까…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "난 왜… 모두를 지켜줄 수 없는 걸까…"
    },
    {
        "id": 107,
        "raw": "넌 아무것도 할 수 없어.",
        "type": "narration",
        "content": "넌 아무것도 할 수 없어."
    },
    {
        "id": 108,
        "raw": "[name=\"아미야\"]   아니야… 나는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아니야… 나는…"
    },
    {
        "id": 109,
        "raw": "굶주림… 핍박… 죽음…",
        "type": "narration",
        "content": "굶주림… 핍박… 죽음…"
    },
    {
        "id": 110,
        "raw": "감염자를 기다리는 최후란 결국 그런 것뿐이지.",
        "type": "narration",
        "content": "감염자를 기다리는 최후란 결국 그런 것뿐이지."
    },
    {
        "id": 111,
        "raw": "[name=\"아미야\"]   그렇지 않아…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그렇지 않아…"
    },
    {
        "id": 112,
        "raw": "[name=\"아미야\"]   로도스 아일랜드가 감염자의 힘이 되어준다면…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "로도스 아일랜드가 감염자의 힘이 되어준다면…"
    },
    {
        "id": 113,
        "raw": "너는 일부 운 좋은 사람일 뿐이야.",
        "type": "narration",
        "content": "너는 일부 운 좋은 사람일 뿐이야."
    },
    {
        "id": 114,
        "raw": "[name=\"아미야\"]   아니야, 모두가 함께 같은 목표를 위해 끊임없이 노력하고 있는걸.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아니야, 모두가 함께 같은 목표를 위해 끊임없이 노력하고 있는걸."
    },
    {
        "id": 115,
        "raw": "이 대지는 이미 전부 마비되어 버렸어.",
        "type": "narration",
        "content": "이 대지는 이미 전부 마비되어 버렸어."
    },
    {
        "id": 116,
        "raw": "[name=\"아미야\"]   아직 그 정도는 아니야…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아직 그 정도는 아니야…"
    },
    {
        "id": 117,
        "raw": "[name=\"아미야\"]   감염자는 절대 절망에 삼켜져선 안 돼…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "감염자는 절대 절망에 삼켜져선 안 돼…"
    },
    {
        "id": 118,
        "raw": "너는.",
        "type": "narration",
        "content": "너는."
    },
