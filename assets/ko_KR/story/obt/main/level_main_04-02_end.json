        "id": 27,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 28,
        "raw": "[name=\"아이\"]   으음… 알았어!",
        "type": "dialog",
        "speaker": "아이",
        "content": "으음… 알았어!"
    },
    {
        "id": 29,
        "raw": "[name=\"아이\"]   누나, 그러면…",
        "type": "dialog",
        "speaker": "아이",
        "content": "누나, 그러면…"
    },
    {
        "id": 30,
        "raw": "[name=\"아이\"]   으음… 누나는 안 될지도 모르겠다. 키가 작아서…",
        "type": "dialog",
        "speaker": "아이",
        "content": "으음… 누나는 안 될지도 모르겠다. 키가 작아서…"
