        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 26,
        "raw": "[name=\"아미야\"]   안 가르쳐 주지~! 누나의 비밀이거든.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "안 가르쳐 주지~! 누나의 비밀이거든."
