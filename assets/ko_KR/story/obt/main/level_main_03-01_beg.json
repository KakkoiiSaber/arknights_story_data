    {
        "id": 78,
        "raw": "[name=\"리유니온 멤버\"]   그, 그만! 공격하지 말아줘……",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "그, 그만! 공격하지 말아줘……"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 80,
        "raw": "[name=\"첸\"]   용문을 공격하고도 멀쩡히 살아 돌아갈 수 있을 줄 알았나!",
        "type": "dialog",
        "speaker": "첸",
        "content": "용문을 공격하고도 멀쩡히 살아 돌아갈 수 있을 줄 알았나!"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 82,
        "raw": "[name=\"리유니온 멤버\"]   으아악!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
