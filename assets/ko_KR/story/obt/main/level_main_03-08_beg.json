    },
    {
        "id": 69,
        "raw": "[name=\"호시구마\"]   폭발인가?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "폭발인가?"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
        "name": "char_015_lmg.png"
    },
    {
        "id": 71,
        "raw": "[name=\"용문근위국 대원\"]   놈들이 사방에서 우리를 포위할 생각인가 봅니다!",
        "type": "dialog",
        "speaker": "용문근위국 대원",
        "content": "놈들이 사방에서 우리를 포위할 생각인가 봅니다!"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_010_chen_1#2\")]",
        "type": "character",
        "name": "char_010_chen_1#2.png"
    },
    {
        "id": 73,
        "raw": "[name=\"첸\"]   이대로 있다간 측면이 버티지 못해… 반격한다!",
        "type": "dialog",
        "speaker": "첸",
        "content": "이대로 있다간 측면이 버티지 못해… 반격한다!"
    },
    {
        "id": 74,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
