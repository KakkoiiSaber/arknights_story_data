    },
    {
        "id": 175,
        "raw": "[name=\"리유니온 멤버\"]  누, 누구냐! 하늘에서 떨어진 건가?!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "누, 누구냐! 하늘에서 떨어진 건가?!"
    },
    {
        "id": 176,
        "raw": "[name=\"리유니온 멤버\"]  후퇴, 모두 후퇴해라! 적에게 비행 능력이 있는 것 같다!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "후퇴, 모두 후퇴해라! 적에게 비행 능력이 있는 것 같다!"
    },
    {
        "id": 177,
        "raw": "[Character(name=\"char_017_homura_3#7\")]",
        "type": "character",
        "name": "char_017_homura_3#7"
    },
    {
        "id": 178,
        "raw": "[name=\"블레이즈\"]  에이…… 설마 진짜 날아다닐라고!",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "에이…… 설마 진짜 날아다닐라고!"
    },
    {
        "id": 179,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
        "name": "char_015_lmg"
    },
    {
        "id": 180,
        "raw": "[name=\"경찰\"]  식별 코드를 대라!",
        "type": "dialog",
        "speaker": "경찰",
        "content": "식별 코드를 대라!"
    },
    {
        "id": 181,
        "raw": "[Character(name=\"char_017_homura_3#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#4",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 182,
        "raw": "[name=\"블레이즈\"]  그건 너희가 직접 스캔하던가!",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "그건 너희가 직접 스캔하던가!"
    },
    {
        "id": 183,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 184,
        "raw": "[name=\"블레이즈\"]  (미안, 일단 쟤네들이랑 얘기 좀 할게!)",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "(미안, 일단 쟤네들이랑 얘기 좀 할게!)"
    },
    {
        "id": 185,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 186,
        "raw": "[name=\"리유니온 멤버\"]  뭐?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "뭐?"
    },
    {
        "id": 187,
        "raw": "[Character(name=\"char_017_homura_3#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#4",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 188,
        "raw": "[name=\"블레이즈\"]  용문 경찰, 잘 들어! 나는 로도스 아일랜드 소속이야.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "용문 경찰, 잘 들어! 나는 로도스 아일랜드 소속이야."
    },
    {
        "id": 189,
        "raw": "[name=\"블레이즈\"]  그러니 쏘지 마, 나도 총알 피하면서 싸우긴 싫으니까.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "그러니 쏘지 마, 나도 총알 피하면서 싸우긴 싫으니까."
    },
    {
        "id": 190,
        "raw": "[name=\"블레이즈\"]  여긴 나한테 맡기고, 너흰 어서 다음 봉쇄 지점으로 출발해.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "여긴 나한테 맡기고, 너흰 어서 다음 봉쇄 지점으로 출발해."
    },
    {
        "id": 191,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 192,
        "raw": "[name=\"블레이즈\"]  좋아, 그럼 이제 이쪽 일을 마저 해결해 볼까.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "좋아, 그럼 이제 이쪽 일을 마저 해결해 볼까."
    },
    {
        "id": 193,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 194,
        "raw": "[name=\"리유니온 멤버\"]  이 여자는 대체 무슨 말을 하는 거야?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "이 여자는 대체 무슨 말을 하는 거야?"
    },
    {
        "id": 195,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 196,
        "raw": "[name=\"블레이즈\"]  내가 설명해주면 금방 알아들을걸? 아마?",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "내가 설명해주면 금방 알아들을걸? 아마?"
    },
    {
        "id": 197,
        "raw": "[name=\"블레이즈\"]  (흐읍~ 하아~)",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "(흐읍~ 하아~)"
    },
    {
        "id": 198,
        "raw": "[Character(name=\"char_017_homura_3#6\")]",
        "type": "character",
        "name": "char_017_homura_3#6"
    },
    {
        "id": 199,
        "raw": "[name=\"블레이즈\"]  나는 로도스 아일랜드의 정예 오퍼레이터인 블레이즈야. 내 작전 목표는 너희들을 무력화시키는 거지.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "나는 로도스 아일랜드의 정예 오퍼레이터인 블레이즈야. 내 작전 목표는 너희들을 무력화시키는 거지."
    },
    {
        "id": 200,
        "raw": "[name=\"블레이즈\"]  다들 무슨 생각으로 애먼 도시를 침범한 건지는 모르겠지만, 우린 무장 해제를 목표로 움직이고 있어, 일단은 말이지.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "다들 무슨 생각으로 애먼 도시를 침범한 건지는 모르겠지만, 우린 무장 해제를 목표로 움직이고 있어, 일단은 말이지."
    },
    {
        "id": 201,
        "raw": "[name=\"블레이즈\"]  타인에 대한 상해 행위, 재산적인 손실, 그리고 사후 형벌 같은 건 지금 당장은 문제 삼지 않겠지만, 지금 너희가 하는 저항은 아무런 의미가 없다는 걸 알아두는 편이 좋을 거야. 아직 안 늦었다, 얌전히 무기 내려놔.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "타인에 대한 상해 행위, 재산적인 손실, 그리고 사후 형벌 같은 건 지금 당장은 문제 삼지 않겠지만, 지금 너희가 하는 저항은 아무런 의미가 없다는 걸 알아두는 편이 좋을 거야. 아직 안 늦었다, 얌전히 무기 내려놔."
    },
    {
        "id": 202,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 203,
        "raw": "[name=\"리유니온 멤버\"]  뭐? 이 자식이…",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "뭐? 이 자식이…"
    },
    {
        "id": 204,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 205,
        "raw": "[name=\"블레이즈\"]  같은 감염자로서 너희한테 선택의 기회를 주는 거야.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "같은 감염자로서 너희한테 선택의 기회를 주는 거야."
    },
    {
        "id": 206,
        "raw": "[name=\"블레이즈\"]  지금 바로 투항하면 너희를 로도스 아일랜드로 잡아간 다음에, 감염자한테 그나마 관대한 지역으로 보내줄게. 나한테 그럴 권한 있으니까 믿어도 돼.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "지금 바로 투항하면 너희를 로도스 아일랜드로 잡아간 다음에, 감염자한테 그나마 관대한 지역으로 보내줄게. 나한테 그럴 권한 있으니까 믿어도 돼."
    },
