        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"아미야\"]   네… 지금은요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "네… 지금은요."
    },
    {
