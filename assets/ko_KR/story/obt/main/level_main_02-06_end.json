        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"미샤\"]   …조금… 머리가 어지러운 것뿐이야.",
        "type": "dialog",
        "speaker": "미샤",
        "content": "…조금… 머리가 어지러운 것뿐이야."
    },
    {
        "id": 25,
        "raw": "[name=\"미샤\"]   괜…찮아.",
        "type": "dialog",
        "speaker": "미샤",
        "content": "괜…찮아."
    },
    {
        "id": 26,
