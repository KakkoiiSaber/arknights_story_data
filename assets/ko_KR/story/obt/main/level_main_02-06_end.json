        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"아미야\"]   …낯빛이 좋지 않으시네요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…낯빛이 좋지 않으시네요."
