        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"엑시아\"]  오른쪽 조심해!",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "오른쪽 조심해!"
    },
    {
