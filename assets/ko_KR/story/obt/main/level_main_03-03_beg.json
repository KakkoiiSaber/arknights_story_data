        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"텍사스\"]  엄호를 부탁한다.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "엄호를 부탁한다."
    },
    {
        "id": 26,
