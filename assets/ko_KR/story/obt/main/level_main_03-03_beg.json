        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 27,
        "raw": "[name=\"리유니온 멤버\"]   그 녀석을 붙잡아! 내가 마무리한다!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "그 녀석을 붙잡아! 내가 마무리한다!"
    },
