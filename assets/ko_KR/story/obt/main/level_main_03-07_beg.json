        "name": "char_106_franka_1",
        "name2": "char_136_hsguma",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"프란카\"]   이거 신세 한 번 졌네, 용문의 여장부님.",
        "type": "dialog",
        "speaker": "프란카",
