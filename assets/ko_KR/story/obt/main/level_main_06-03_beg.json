        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_367_swllow_1#3\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_367_swllow_1#3",
        "focus": 2
    },
