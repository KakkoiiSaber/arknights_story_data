        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"파우스트\"]  메피스토?",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "메피스토?"
    },
    {
        "id": 9,
        "raw": "[name=\"파우스트\"]  방금 무슨 아츠를 쓴 거지? 네 부대가…… 전보다 더 미쳐 날뛰고 있는데.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "방금 무슨 아츠를 쓴 거지? 네 부대가…… 전보다 더 미쳐 날뛰고 있는데."
    },
    {
        "id": 10,
        "raw": "[name=\"파우스트\"]  굉장히…… 굉장히 고통스러워하고 있어.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "굉장히…… 굉장히 고통스러워하고 있어."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"메피스토\"]  아, 봤구나? 심어두었던 씨앗이 꽃을 피운 거야.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "아, 봤구나? 심어두었던 씨앗이 꽃을 피운 거야."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"메피스토\"]  괜찮아, 파우스트. 우리를 공격하진 않을 테니까.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "괜찮아, 파우스트. 우리를 공격하진 않을 테니까."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"파우스트\"]  저들의 감염을 촉진시킨 건가?",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "저들의 감염을 촉진시킨 건가?"
    },
    {
        "id": 17,
        "raw": "[name=\"파우스트\"]  메피스토… 그만해. 우린 살아나갈 수 있어.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "메피스토… 그만해. 우린 살아나갈 수 있어."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"메피스토\"]  내 아츠로 이렇게라도 하지 않으면, 우리가 도망칠 수 있을 거 같아?!",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "내 아츠로 이렇게라도 하지 않으면, 우리가 도망칠 수 있을 거 같아?!"
    },
    {
        "id": 20,
        "raw": "[name=\"메피스토\"]  너도 정찰하며 똑똑히 봤을거 아냐, 지금 우리 상태로 무리하게 돌파하려 했다간, 슬럼가 쪽 비밀 통로에 도착하기 전에 근위국 놈들한테 죽게 될 거야.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "너도 정찰하며 똑똑히 봤을거 아냐, 지금 우리 상태로 무리하게 돌파하려 했다간, 슬럼가 쪽 비밀 통로에 도착하기 전에 근위국 놈들한테 죽게 될 거야."
    },
    {
        "id": 21,
        "raw": "[name=\"메피스토\"]  이제까지 그런 무기 본 적 있어? 체르노보그의 수비대도 그런 무기를 쓰진 않았어!",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "이제까지 그런 무기 본 적 있어? 체르노보그의 수비대도 그런 무기를 쓰진 않았어!"
    },
    {
        "id": 22,
        "raw": "[name=\"메피스토\"]  놈들은 이 도시를 빠삭히 알고 있지, 근데 우리는 한낱 외지인일 뿐이야! 우리가 놈들이 어디서 나타나고 어디로 사라지는지 미리 알 수 있을 거 같아? 지금 인원들로 놈들한테 정면으로 붙었다간, 전부 개죽음당할 거라고!",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "놈들은 이 도시를 빠삭히 알고 있지, 근데 우리는 한낱 외지인일 뿐이야! 우리가 놈들이 어디서 나타나고 어디로 사라지는지 미리 알 수 있을 거 같아? 지금 인원들로 놈들한테 정면으로 붙었다간, 전부 개죽음당할 거라고!"
    },
    {
        "id": 23,
        "raw": "[name=\"메피스토\"]  체르노보그의 우르수스인들이 너무 약했던 거야…… 용문은 우리를 군대로 간주하고 상대하고 있는데, 우린 군대 같은 게 아니잖아…… 우리가 데려온 건 그저 살아남고 싶어 하는 동포들 일 뿐이라고……",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "체르노보그의 우르수스인들이 너무 약했던 거야…… 용문은 우리를 군대로 간주하고 상대하고 있는데, 우린 군대 같은 게 아니잖아…… 우리가 데려온 건 그저 살아남고 싶어 하는 동포들 일 뿐이라고……"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"파우스트\"]  목소리를 낮춰. 아군의 사기가 많이 떨어져 있다.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "목소리를 낮춰. 아군의 사기가 많이 떨어져 있다."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"메피스토\"]  겨우 그런 것 따위로 내 가축들은 동요하지 않아!",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "겨우 그런 것 따위로 내 가축들은 동요하지 않아!"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"파우스트\"]  ……아까 합류한 리유니온 멤버들도 많이 있다.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "……아까 합류한 리유니온 멤버들도 많이 있다."
    },
    {
        "id": 30,
        "raw": "[name=\"파우스트\"]  분명 프로스트노바가 우릴 구하러 올 거다.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "분명 프로스트노바가 우릴 구하러 올 거다."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"메피스토\"]  프로스트노바? 그 프로스트노바가?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "프로스트노바? 그 프로스트노바가?"
    },
    {
        "id": 33,
        "raw": "[name=\"메피스토\"]  하… 하하… 프로스트노바랑 눈의 악마들은 우릴 배신한 거 아니었어?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "하… 하하… 프로스트노바랑 눈의 악마들은 우릴 배신한 거 아니었어?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"파우스트\"]  메피스토!",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "메피스토!"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"메피스토\"]  배반한 게 아니라면, 대체 왜 안 오고 있는 건데! 누가 걔네들을 막을 수 있다고!",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "배반한 게 아니라면, 대체 왜 안 오고 있는 건데! 누가 걔네들을 막을 수 있다고!"
    },
    {
        "id": 38,
        "raw": "[name=\"메피스토\"]  난 걔네들 탓을 하는 게 아니야. 만약 배신을 했다면, 분명 살아남기 위해서겠지.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "난 걔네들 탓을 하는 게 아니야. 만약 배신을 했다면, 분명 살아남기 위해서겠지."
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"파우스트\"]  프로스트노바가 배신했을 리 없다. 직접 확인해보자고 이야기했잖아?",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "프로스트노바가 배신했을 리 없다. 직접 확인해보자고 이야기했잖아?"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"메피스토\"]  그래…… 다들 살아남기 위해 노력하고 있다 이거겠지.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "그래…… 다들 살아남기 위해 노력하고 있다 이거겠지."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"파우스트\"]  진정해라, 근위국의 계략에 흔들리면 안 돼!",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "진정해라, 근위국의 계략에 흔들리면 안 돼!"
    },
    {
        "id": 45,
        "raw": "[stopmusic(fadetime=2)]",
        "type": "stop_music",
        "fadetime": 2
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"메피스토\"]  나한테 좋은 수가 있어, 파우스트. 우리 동포들을 살릴 수 있는 더 좋은 수가.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "나한테 좋은 수가 있어, 파우스트. 우리 동포들을 살릴 수 있는 더 좋은 수가."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"파우스트\"]  ……대체 뭘 어쩌려는 건데?",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "……대체 뭘 어쩌려는 건데?"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"메피스토\"]  근위국 놈들한테 군대보다 더 무서운 걸 보여주지. 우리 동포들한테 피어나는 꽃이 어떤 모습인지, 놈들은 아마 상상조차 할 수 없을 거야.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "근위국 놈들한테 군대보다 더 무서운 걸 보여주지. 우리 동포들한테 피어나는 꽃이 어떤 모습인지, 놈들은 아마 상상조차 할 수 없을 거야."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"파우스트\"]  메피스토?!",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "메피스토?!"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
