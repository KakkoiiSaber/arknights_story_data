        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"아미야\"] 맞아요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "맞아요."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#7\",focus=1)]",
