    {
        "id": 44,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"avg_npc_058\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "avg_npc_058",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"방패병\"] 다른 세력이 사령탑에 들어가는 걸 우리더러 막아달라는 거로군.",
        "type": "dialog",
        "speaker": "방패병",
        "content": "다른 세력이 사령탑에 들어가는 걸 우리더러 막아달라는 거로군."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"avg_npc_058\",focus=1)]",
