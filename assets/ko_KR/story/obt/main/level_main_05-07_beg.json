        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"첸\"]  얼마나 오래 기절했지?",
        "type": "dialog",
        "speaker": "첸",
        "content": "얼마나 오래 기절했지?"
