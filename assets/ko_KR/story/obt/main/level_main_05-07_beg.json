    },
    {
        "id": 78,
        "raw": "[name=\"리유니온 멤버\"]  젠장, 감히 우리를 도발하다니!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "젠장, 감히 우리를 도발하다니!"
