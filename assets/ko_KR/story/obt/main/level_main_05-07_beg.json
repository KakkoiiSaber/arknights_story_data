        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"호시구마\"]  십몇 초 정도.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "십몇 초 정도."
    },
    {
        "id": 15,
