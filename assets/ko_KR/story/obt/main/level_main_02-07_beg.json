    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"엑시아\"]   이 아이… 왜 이러는 거야?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "이 아이… 왜 이러는 거야?"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"아미야\"]   이, 이건 광석병 발작 전조증상이에요!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이, 이건 광석병 발작 전조증상이에요!"
    },
    {
        "id": 11,
        "raw": "[name=\"아미야\"]   어째서… 고작 일주일밖에 안 됐는데…!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "어째서… 고작 일주일밖에 안 됐는데…!"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"리스캄\"]   급성으로 걸리는 광석병도 있었나?",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "급성으로 걸리는 광석병도 있었나?"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"리스캄\"]   프란카, 너는 어떤 광석병이지?",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "프란카, 너는 어떤 광석병이지?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"프란카\"]   어머, 내 걱정해주는 거야?",
        "type": "dialog",
        "speaker": "프란카",
        "content": "어머, 내 걱정해주는 거야?"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"리스캄\"]   아미야, 프란카가 죽으면 로도스 아일랜드에서 화장해다오.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "아미야, 프란카가 죽으면 로도스 아일랜드에서 화장해다오."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"프란카\"]   아 진짜!",
        "type": "dialog",
        "speaker": "프란카",
        "content": "아 진짜!"
    },
    {
        "id": 22,
        "raw": "[name=\"프란카\"]   너무한 거 아니야? 리스캄!",
        "type": "dialog",
        "speaker": "프란카",
        "content": "너무한 거 아니야? 리스캄!"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"리스캄\"]   평소에 광석병을 옮기겠다고 협박하는 건 프란카 너잖아!",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "평소에 광석병을 옮기겠다고 협박하는 건 프란카 너잖아!"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"아미야\"]   아, 아하하…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아, 아하하…"
    },
    {
        "id": 27,
        "raw": "[name=\"아미야\"]   급성 광석병과 만성 광석병에 대해 설명하면 이야기가 길어지겠지만…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "급성 광석병과 만성 광석병에 대해 설명하면 이야기가 길어지겠지만…"
    },
    {
        "id": 28,
        "raw": "[name=\"아미야\"]   확실한 건, 미샤 씨의 상태는 정말 위험하다는 거예요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "확실한 건, 미샤 씨의 상태는 정말 위험하다는 거예요."
    },
    {
        "id": 29,
        "raw": "[name=\"아미야\"]   이대로라면 정말 짧은 시간 안에 미샤 씨의 목숨이 위험해질 수도 있어요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이대로라면 정말 짧은 시간 안에 미샤 씨의 목숨이 위험해질 수도 있어요…"
    },
    {
        "id": 30,
        "raw": "[name=\"아미야\"]   지금은 응급처치밖에 해드릴 수 있는 게 없지만…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "지금은 응급처치밖에 해드릴 수 있는 게 없지만…"
    },
    {
        "id": 31,
        "raw": "[name=\"아미야\"]   미샤 씨의 상태가 촌각을 다투는 상황이란 건 확실해요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "미샤 씨의 상태가 촌각을 다투는 상황이란 건 확실해요."
    },
    {
        "id": 32,
        "raw": "[name=\"아미야\"]   용문에 전할게요. 사건이 진정되면 미샤 씨를 로도스 아일랜드에 맡겨달라고요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "용문에 전할게요. 사건이 진정되면 미샤 씨를 로도스 아일랜드에 맡겨달라고요."
    },
    {
        "id": 33,
        "raw": "[name=\"아미야\"]   그게 우리 책임이기도 하니까요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그게 우리 책임이기도 하니까요."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"엑시아\"]   으음…",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "으음…"
    },
    {
        "id": 36,
        "raw": "[name=\"엑시아\"]   이 아이… 조금 더 있으면… 폭발해버리는 거 아니야?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "이 아이… 조금 더 있으면… 폭발해버리는 거 아니야?"
