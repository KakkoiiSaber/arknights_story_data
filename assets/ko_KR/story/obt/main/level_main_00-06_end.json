        "name": "char_013_riop"
    },
    {
        "id": 18,
        "raw": "[name=\"가드 오퍼레이터\"]  도베르만 교관님…",
        "type": "dialog",
        "speaker": "가드 오퍼레이터",
        "content": "도베르만 교관님…"
