        "type": "character",
        "name": "char_013_riop",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"아미야\"]   감염된 짐승들이 리유니온의 병사로 쓰이다니…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "감염된 짐승들이 리유니온의 병사로 쓰이다니…"
