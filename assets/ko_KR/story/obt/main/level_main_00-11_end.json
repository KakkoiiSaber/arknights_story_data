        "name": "char_002_amiya_1#1"
    },
    {
        "id": 69,
        "raw": "[name=\"아미야\"]  맞아요, 하지만…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "맞아요, 하지만…"
