        "type": "character",
        "name": "char_148_nearl_1#1"
    },
    {
        "id": 80,
        "raw": "[name=\"니어\"]  이제 움직여볼까.",
        "type": "dialog",
        "speaker": "니어",
        "content": "이제 움직여볼까."
