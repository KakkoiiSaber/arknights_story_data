        "name": "char_002_amiya_1#1",
        "name2": "char_148_nearl_1#6",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"니어\"]  후후.",
        "type": "dialog",
        "speaker": "니어",
        "content": "후후."
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_148_nearl_1#1\")]",
        "type": "character",
        "name": "char_148_nearl_1#1"
    },
    {
        "id": 67,
        "raw": "[name=\"니어\"]  네 옆에 계신 분이, 그 유명한 박사님이신가.",
        "type": "dialog",
        "speaker": "니어",
        "content": "네 옆에 계신 분이, 그 유명한 박사님이신가."
