    },
    {
        "id": 11,
        "raw": "[name=\"메테오라이트\"]   …목표 지점 도착.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "…목표 지점 도착."
    },
    {
        "id": 12,
        "raw": "[name=\"메테오라이트\"]   별다른 이상은 확인되지 않습니다.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "별다른 이상은 확인되지 않습니다."
    },
    {
        "id": 13,
        "raw": "[name=\"메테오라이트\"]   이상 보고를 마칩니다.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "이상 보고를 마칩니다."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_219_meteo_1\")]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 15,
        "raw": "[name=\"메테오라이트\"]   프로스트리프… 왜 계속 얼굴을 찡그리고 있어?",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "프로스트리프… 왜 계속 얼굴을 찡그리고 있어?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 17,
        "raw": "[name=\"프로스트리프\"]   아미야 쪽 사람들이 좀 걱정돼서.",
        "type": "dialog",
        "speaker": "프로스트리프",
        "content": "아미야 쪽 사람들이 좀 걱정돼서."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_219_meteo_1\" )]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 19,
        "raw": "[name=\"메테오라이트\"]   아미야네 팀은 이미 로도스 아일랜드로 무사히 돌아왔잖아.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "아미야네 팀은 이미 로도스 아일랜드로 무사히 돌아왔잖아."
    },
    {
        "id": 20,
        "raw": "[name=\"메테오라이트\"]   그건 그렇고, 니어랑 도베르만이 일주일도 전에 용문 바깥쪽 다른 구역으로 갔다는데…",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "그건 그렇고, 니어랑 도베르만이 일주일도 전에 용문 바깥쪽 다른 구역으로 갔다는데…"
    },
    {
        "id": 21,
        "raw": "[name=\"메테오라이트\"]   그 둘이 동시에 출동할 정도니, 분명 엄청 힘든 임무겠지.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "그 둘이 동시에 출동할 정도니, 분명 엄청 힘든 임무겠지."
    },
    {
        "id": 22,
        "raw": "[name=\"메테오라이트\"]   블랙스틸이랑 펭귄 로지스틱스도 각자 할 일이 있다는 것 같고… 요즘 꽤 어수선하네.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "블랙스틸이랑 펭귄 로지스틱스도 각자 할 일이 있다는 것 같고… 요즘 꽤 어수선하네."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_259_Jessica_1\")]",
        "type": "character",
        "name": "char_259_Jessica_1"
    },
    {
        "id": 24,
        "raw": "[name=\"제시카\"]   아, 리스캄 선배랑 프란카 선배가…",
        "type": "dialog",
        "speaker": "제시카",
        "content": "아, 리스캄 선배랑 프란카 선배가…"
    },
    {
        "id": 25,
        "raw": "[name=\"제시카\"]   그 두 분이 무사하시다니 다행이지만…",
        "type": "dialog",
        "speaker": "제시카",
        "content": "그 두 분이 무사하시다니 다행이지만…"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"메테오라이트\"]   너도 열심히 해야지.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "너도 열심히 해야지."
    },
    {
        "id": 28,
        "raw": "[name=\"메테오라이트\"]   프란카가 널 나한테 맡겼을 때, 널 정말 높게 평가한다고 그랬는걸.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "프란카가 널 나한테 맡겼을 때, 널 정말 높게 평가한다고 그랬는걸."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"제시카\"]   저, 정말요…?",
        "type": "dialog",
        "speaker": "제시카",
        "content": "저, 정말요…?"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"메테오라이트\"]   \"그 겁쟁이 기질을 고치면\"이라는 전제가 붙긴 했지만.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "\"그 겁쟁이 기질을 고치면\"이라는 전제가 붙긴 했지만."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#4",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"제시카\"]   우으으…",
        "type": "dialog",
        "speaker": "제시카",
        "content": "우으으…"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1#4",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"메테오라이트\"]   …얘는, 왜 갑자기 울라 그래!",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "…얘는, 왜 갑자기 울라 그래!"
    },
    {
        "id": 37,
        "raw": "[name=\"메테오라이트\"]   너도 블랙스틸의 일원이잖니…?",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "너도 블랙스틸의 일원이잖니…?"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_259_Jessica_1#5\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#5",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"제시카\"]   저, 저… 안… 안 울었어요…",
        "type": "dialog",
        "speaker": "제시카",
        "content": "저, 저… 안… 안 울었어요…"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_219_meteo_1\")]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 41,
        "raw": "[name=\"메테오라이트\"]   ……",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "……"
    },
    {
        "id": 42,
        "raw": "[name=\"메테오라이트\"]   …어쨌든, 임무를 속행하지.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "…어쨌든, 임무를 속행하지."
    },
    {
        "id": 43,
        "raw": "[name=\"메테오라이트\"]   다음 임무는 다른 정찰팀과 협력해서 이 버려진 도시의 각 구역을 조사하는 거야.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "다음 임무는 다른 정찰팀과 협력해서 이 버려진 도시의 각 구역을 조사하는 거야."
    },
    {
        "id": 44,
        "raw": "[name=\"메테오라이트\"]   생존자를 수색하는 것과 더불어 이곳의 실제 상황도 조사해야 해.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "생존자를 수색하는 것과 더불어 이곳의 실제 상황도 조사해야 해."
    },
    {
        "id": 45,
        "raw": "[name=\"메테오라이트\"]   만약 감염자와 관련된 문제가 확인되면 속전속결로 처리해야 한다는 점 명심하고.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "만약 감염자와 관련된 문제가 확인되면 속전속결로 처리해야 한다는 점 명심하고."
    },
    {
        "id": 46,
        "raw": "[name=\"메테오라이트\"]   특별히 위험요소가 있는 임무는 아니지만, 그래도 조심해.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "특별히 위험요소가 있는 임무는 아니지만, 그래도 조심해."
    },
    {
        "id": 47,
        "raw": "[name=\"메테오라이트\"]   그리고 만에 하나라도 리유니온과 관련된 뭔가를 찾아내면, 바로 켈시 선생님께 연락 드리고 퇴각해야 한다는 것도 잊지 말고.",
        "type": "dialog",
        "speaker": "메테오라이트",
        "content": "그리고 만에 하나라도 리유니온과 관련된 뭔가를 찾아내면, 바로 켈시 선생님께 연락 드리고 퇴각해야 한다는 것도 잊지 말고."
    },
    {
