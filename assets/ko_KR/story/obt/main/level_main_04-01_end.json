        "type": "character",
        "name": "char_259_Jessica_1"
    },
    {
        "id": 49,
        "raw": "[name=\"제시카\"]   아, 넵.",
        "type": "dialog",
        "speaker": "제시카",
        "content": "아, 넵."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
