    {
        "id": 48,
        "raw": "[name=\"첸\"]  누구냐?!",
        "type": "dialog",
        "speaker": "첸",
        "content": "누구냐?!"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_010_chen_1#2\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_010_chen_1#2.png",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"근위국 멤버\"]  저입니다, 보고 드립니다!",
        "type": "dialog",
        "speaker": "근위국 멤버",
        "content": "저입니다, 보고 드립니다!"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_010_chen_1#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_010_chen_1#4.png",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"첸\"]  너한테 한 소리가 아니야……",
        "type": "dialog",
        "speaker": "첸",
        "content": "너한테 한 소리가 아니야……"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_010_chen_1#4\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_010_chen_1#4.png",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"근위국 멤버\"]  ……예?",
        "type": "dialog",
        "speaker": "근위국 멤버",
        "content": "……예?"
    },
    {
        "id": 55,
