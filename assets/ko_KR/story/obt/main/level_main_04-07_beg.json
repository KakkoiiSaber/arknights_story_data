        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 39,
        "raw": "[name=\"켈시\"]   그리고 늘 반지에 신경을 쓰도록.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "그리고 늘 반지에 신경을 쓰도록."
    },
