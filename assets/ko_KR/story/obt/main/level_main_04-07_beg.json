    {
        "id": 47,
        "raw": "[name=\"아미야\"]   켈시 선생님도 박사님을 걱정하고 계신 것 같아요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "켈시 선생님도 박사님을 걱정하고 계신 것 같아요."
    },
    {
        "id": 48,
        "raw": "[name=\"아미야\"]   눈치채지 못한 사이에…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "눈치채지 못한 사이에…"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 50,
        "raw": "[name=\"아미야\"]   위험한 맹수들이 날카로운 발톱을 드러냈군요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "위험한 맹수들이 날카로운 발톱을 드러냈군요."
    },
    {
        "id": 51,
        "raw": "[Decision(options=\"리유니온이 바로 뒤에서 쫓아오고 있다.;퇴로는…끊겨버렸군.;이 감염자 폭도들은 우리에게 다른 목적을 갖고 있는 것 같다.\", values=\"1;2;3\")]",
        "type": "decision",
        "options": "리유니온이 바로 뒤에서 쫓아오고 있다.;퇴로는…끊겨버렸군.;이 감염자 폭도들은 우리에게 다른 목적을 갖고 있는 것 같다.",
        "values": "1;2;3"
    },
