        "type": "character",
        "name": "char_empty",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 105,
        "raw": "[name=\"첸\"]  너의 높은 수준과 나의 높은 수준은 차이가 엄청나게 커.",
        "type": "dialog",
        "speaker": "첸",
