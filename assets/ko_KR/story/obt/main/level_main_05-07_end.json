        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"첸\"]  지금 뭐라고?!",
        "type": "dialog",
        "speaker": "첸",
        "content": "지금 뭐라고?!"
    },
    {
        "id": 70,
