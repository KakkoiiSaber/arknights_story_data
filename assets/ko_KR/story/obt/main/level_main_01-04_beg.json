        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"에이스\"]  ——",
        "type": "dialog",
        "speaker": "에이스",
        "content": "——"
    },
    {
        "id": 21,
        "raw": "[name=\"에이스\"]  이 넓은 구역은 대광장인가. 지금은 폐허밖에 남지 않았지만…",
        "type": "dialog",
        "speaker": "에이스",
        "content": "이 넓은 구역은 대광장인가. 지금은 폐허밖에 남지 않았지만…"
    },
    {
        "id": 22,
        "raw": "[name=\"에이스\"]  감염자를 탄압하던 도시가, 감염자의 보복을 받은 셈이로군.",
        "type": "dialog",
        "speaker": "에이스",
        "content": "감염자를 탄압하던 도시가, 감염자의 보복을 받은 셈이로군."
