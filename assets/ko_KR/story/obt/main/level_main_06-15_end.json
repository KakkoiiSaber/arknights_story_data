        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 24,
        "raw": "[name=\"아미야\"]  콜록, 콜록…… 블레이즈 씨!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "콜록, 콜록…… 블레이즈 씨!"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_017_homura_3#5\")] ",
        "type": "character",
        "name": "char_017_homura_3#5.png"
    },
    {
        "id": 26,
        "raw": "[name=\"블레이즈\"]  한기가… 사라졌어.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "한기가… 사라졌어."
    },
    {
        "id": 27,
        "raw": "[name=\"블레이즈\"]  난 괜찮아! 아미야, 저기 흰 토끼부터 봐줘!",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "난 괜찮아! 아미야, 저기 흰 토끼부터 봐줘!"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1505_frstar_1\")]",
        "type": "character",
        "name": "char_1505_frstar_1.png"
    },
    {
        "id": 29,
        "raw": "[name=\"프로스트노바\"]  멋지게 이겼구나, 로도스 아일랜드.",
        "type": "dialog",
        "speaker": "프로스트노바",
        "content": "멋지게 이겼구나, 로도스 아일랜드."
    },
    {
        "id": 30,
        "raw": "[name=\"프로스트노바\"]  내가… 형제자매들의 죽음을 헛되게 만들었어.",
        "type": "dialog",
        "speaker": "프로스트노바",
        "content": "내가… 형제자매들의 죽음을 헛되게 만들었어."
    },
    {
        "id": 31,
        "raw": "[name=\"프로스트노바\"]  우린 아무것도 해내지 못한 거야.",
        "type": "dialog",
        "speaker": "프로스트노바",
        "content": "우린 아무것도 해내지 못한 거야."
    },
    {
        "id": 32,
        "raw": "[name=\"프로스트노바\"]  나의 생명은… 아무런 가치도 없었다는 거지.",
        "type": "dialog",
        "speaker": "프로스트노바",
        "content": "나의 생명은… 아무런 가치도 없었다는 거지."
