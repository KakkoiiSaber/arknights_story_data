    },
    {
        "id": 6,
        "raw": "[name=\"프란카\"]  청소 완료!",
        "type": "dialog",
        "speaker": "프란카",
        "content": "청소 완료!"
    },
    {
        "id": 7,
        "raw": "[name=\"프란카\"]  확실히 이 감염자들… 준비를 단단히 했나 봐!",
        "type": "dialog",
        "speaker": "프란카",
        "content": "확실히 이 감염자들… 준비를 단단히 했나 봐!"
    },
    {
        "id": 8,
        "raw": "[name=\"프란카\"]  다들 어서 서둘러!",
        "type": "dialog",
        "speaker": "프란카",
        "content": "다들 어서 서둘러!"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1.png"
    },
    {
        "id": 10,
        "raw": "[name=\"미샤\"]   …하아아… 대체 뭔데… 이게 다…",
        "type": "dialog",
        "speaker": "미샤",
        "content": "…하아아… 대체 뭔데… 이게 다…"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 12,
        "raw": "[name=\"아미야\"]   여러분, 속도를 올려주세요!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "여러분, 속도를 올려주세요!"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"리스캄\"]   아미야, 뒤에 추적자가 가까이 오고 있어.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "아미야, 뒤에 추적자가 가까이 오고 있어."
    },
    {
        "id": 15,
        "raw": "[name=\"리스캄\"]   반격할 수 있겠어?",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "반격할 수 있겠어?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"아미야\"]   우선 교전은 최대한 피하기로 해요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "우선 교전은 최대한 피하기로 해요…"
    },
    {
        "id": 18,
        "raw": "[name=\"아미야\"]   적은 될 수 있는 한 뿌리쳐내는 게 좋겠어요. 전투를 피해야 하니…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "적은 될 수 있는 한 뿌리쳐내는 게 좋겠어요. 전투를 피해야 하니…"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1.png"
    },
    {
        "id": 20,
        "raw": "[name=\"리스캄\"]   안전한 경로라고 할 만한 상황이 아니군…",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "안전한 경로라고 할 만한 상황이 아니군…"
    },
    {
        "id": 21,
        "raw": "[name=\"리스캄\"]   어서 슬럼가를 벗어나 첸 팀장과 합류할 수 있는 경로가 필요해.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "어서 슬럼가를 벗어나 첸 팀장과 합류할 수 있는 경로가 필요해."
    },
    {
        "id": 22,
        "raw": "[name=\"리스캄\"]   리유니온은 이미 우리 흔적을 눈치챈 상황이고…",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "리유니온은 이미 우리 흔적을 눈치챈 상황이고…"
    },
    {
        "id": 23,
        "raw": "[name=\"리스캄\"]   여기서 시간을 허비하면 로도스 아일랜드가 위험에 처하겠지.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "여기서 시간을 허비하면 로도스 아일랜드가 위험에 처하겠지."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"엑시아\"]   나한테 맡겨! 적이 예상도 못 할 경로를 발견했으니까.",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "나한테 맡겨! 적이 예상도 못 할 경로를 발견했으니까."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"리스캄\"]   뭔가 좋은 생각이라도 있나?",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "뭔가 좋은 생각이라도 있나?"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"엑시아\"]   물론이지~",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "물론이지~"
    },
    {
        "id": 30,
        "raw": "[name=\"엑시아\"]   하지만 정말 괜찮은지 여부는 정찰해 봐야 알 수 있을 거야.",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "하지만 정말 괜찮은지 여부는 정찰해 봐야 알 수 있을 거야."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"리스캄\"]   부탁한다.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "부탁한다."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1.png"
    },
    {
        "id": 34,
        "raw": "[name=\"엑시아\"]   좋~았어, 그럼 다녀올게. 금방 돌아올 거야!",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "좋~았어, 그럼 다녀올게. 금방 돌아올 거야!"
    },
    {
        "id": 35,
        "raw": "[name=\"엑시아\"]   무슨 일이 있으면 펭귄 로지스틱스의 다른 직원에게 연락해줘!",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "무슨 일이 있으면 펭귄 로지스틱스의 다른 직원에게 연락해줘!"
    },
