    {
        "id": 46,
        "raw": "[name=\"스컬슈레더\"]   허둥대지 마라, 전원 반격 준비!",
        "type": "dialog",
        "speaker": "스컬슈레더",
        "content": "허둥대지 마라, 전원 반격 준비!"
