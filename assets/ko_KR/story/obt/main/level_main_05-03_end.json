        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 19,
        "raw": "[name=\"호시구마\"]  ……겨우 그 정도로 날 막으려고 했나?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "……겨우 그 정도로 날 막으려고 했나?"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 21,
        "raw": "[name=\"리유니온 멤버\"]  아니, 나는, 아니…",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "아니, 나는, 아니…"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 23,
        "raw": "[name=\"호시구마\"]  겨우 그걸로…… 나를 막을 수 있을 줄 알았나!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "겨우 그걸로…… 나를 막을 수 있을 줄 알았나!"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 25,
        "raw": "[name=\"리유니온 멤버\"]  요… 용서해줘!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
