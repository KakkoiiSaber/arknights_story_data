        "raw": "[Character(name=\"char_010_chen_1#1\",name2=\"avg_npc_012\",focus=2)]",
        "type": "character",
        "name": "char_010_chen_1#1.png",
        "name2": "avg_npc_012",
        "focus": 2
    },
    {
        "id": 194,
        "raw": "[name=\"로도스 오퍼레이터\"]   알겠습니다.",
        "type": "dialog",
        "speaker": "로도스 오퍼레이터",
        "content": "알겠습니다."
    },
    {
