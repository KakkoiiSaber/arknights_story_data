        "name2": "avg_npc_012",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"첸\"]   알겠다. 금방 가도록 하지.",
        "type": "dialog",
        "speaker": "첸",
        "content": "알겠다. 금방 가도록 하지."
