        "id": 29,
        "raw": "[Character(name=\"char_1504_cqbw\", name2=\"char_1002_nsabr_2\", focus=1)]",
        "type": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"W\"]   당연하지. 왜냐면…",
        "type": "dialog",
        "speaker": "W",
        "content": "당연하지. 왜냐면…"
    },
    {
