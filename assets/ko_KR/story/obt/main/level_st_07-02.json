    },
    {
        "id": 15,
        "raw": "[name=\"후미즈키\"]  ……",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "……"
    },
    {
        "id": 16,
        "raw": "[name=\"후미즈키\"]  커튼 안 칠 거예요?",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "커튼 안 칠 거예요?"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 18,
        "raw": "[name=\"웨이 옌우\"]  유리도 이미 다 깨졌는데, 커튼으로 감춘다고 되겠어.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "유리도 이미 다 깨졌는데, 커튼으로 감춘다고 되겠어."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"후미즈키\"]  유리가 깨진 거야 별일 아니지만, 첸이…… 걱정이네요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "유리가 깨진 거야 별일 아니지만, 첸이…… 걱정이네요."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"웨이 옌우\"]  솜씨가 대단해. 어쩜 제 아빠도, 엄마도 안 닮았는지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "솜씨가 대단해. 어쩜 제 아빠도, 엄마도 안 닮았는지."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"후미즈키\"]  그러게요, 그녀와는 정말 다르네요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "그러게요, 그녀와는 정말 다르네요."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"웨이 옌우\"]  ……",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "……"
    },
    {
        "id": 27,
        "raw": "[name=\"웨이 옌우\"]  발아래 도시의 등불은 다시 밝혀졌다. 용문이 이전의 모습을 회복하긴 했지만, 이후에 어떤 일이 벌어질지는 아무도 모르지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "발아래 도시의 등불은 다시 밝혀졌다. 용문이 이전의 모습을 회복하긴 했지만, 이후에 어떤 일이 벌어질지는 아무도 모르지."
    },
    {
        "id": 28,
        "raw": "[name=\"웨이 옌우\"]  이 재앙은 첸 훼이지에 한 사람의 힘으로는 막을 수 없다.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "이 재앙은 첸 훼이지에 한 사람의 힘으로는 막을 수 없다."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"후미즈키\"]  로도스 아일랜드가 첸과 함께할 거예요. 그들이 첸을 찾아낼 겁니다.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "로도스 아일랜드가 첸과 함께할 거예요. 그들이 첸을 찾아낼 겁니다."
    },
    {
        "id": 31,
        "raw": "[name=\"후미즈키\"]  그리고……",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "그리고……"
    },
    {
        "id": 32,
        "raw": "[name=\"후미즈키\"]  위트 의장도 더 이상 보수 세력을 억압할 수 없을 거예요. 오랜 시간 동안 공작들을 견제해왔지만, 완벽히 제압할 순 없었어요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "위트 의장도 더 이상 보수 세력을 억압할 수 없을 거예요. 오랜 시간 동안 공작들을 견제해왔지만, 완벽히 제압할 순 없었어요."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"웨이 옌우\"]  대반란 이후, 각 군단의 장교들과 구 귀족들은 힘을 잃고, 그 지위와 재산도 모두 제국 의회에 넘어갔으니……",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "대반란 이후, 각 군단의 장교들과 구 귀족들은 힘을 잃고, 그 지위와 재산도 모두 제국 의회에 넘어갔으니……"
    },
    {
        "id": 35,
        "raw": "[name=\"웨이 옌우\"]  다만 내가 걱정하는 건……",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "다만 내가 걱정하는 건……"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"후미즈키\"]  뭔가요?",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "뭔가요?"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"웨이 옌우\"]  만약 위트의 말이 거짓이라면? 이 모든 게 위트와 제국 황제가 꾸민 계략이라면? 그 젊은 황제가 이 모든 일을 꾸몄다면?",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "만약 위트의 말이 거짓이라면? 이 모든 게 위트와 제국 황제가 꾸민 계략이라면? 그 젊은 황제가 이 모든 일을 꾸몄다면?"
    },
    {
        "id": 40,
        "raw": "[name=\"웨이 옌우\"]  우리의 적은 늘 어둠 속에 숨어 있었어. 우린 가장 밝은 곳으로 몸을 피할 수밖에 없지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "우리의 적은 늘 어둠 속에 숨어 있었어. 우린 가장 밝은 곳으로 몸을 피할 수밖에 없지."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"후미즈키\"]  다른 사람들에 비하면, 당신도 이미 어둠 속에 있잖아요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "다른 사람들에 비하면, 당신도 이미 어둠 속에 있잖아요."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"웨이 옌우\"]  이 정도론 부족해…… 그때와 마찬가지지. 카셰이…… 카셰이라면, 더 깊은 곳에 숨었을 거야.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "이 정도론 부족해…… 그때와 마찬가지지. 카셰이…… 카셰이라면, 더 깊은 곳에 숨었을 거야."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"후미즈키\"]  하지만 당신은 카셰이가 아니잖아요. 카셰이였다면 용문을 이만큼 부흥시키진 못했을 거예요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "하지만 당신은 카셰이가 아니잖아요. 카셰이였다면 용문을 이만큼 부흥시키진 못했을 거예요."
    },
    {
        "id": 47,
        "raw": "[name=\"후미즈키\"]  다만, 만약 탈루가…… 카셰이의 가르침으로 이렇게 변한 거라면……",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "다만, 만약 탈루가…… 카셰이의 가르침으로 이렇게 변한 거라면……"
    },
    {
        "id": 48,
        "raw": "[name=\"후미즈키\"]  ……",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "……"
    },
    {
        "id": 49,
        "raw": "[name=\"후미즈키\"]  당신 생각엔, 그 로도스 아일랜드의 의사가 거짓말을 하는 것 같나요?",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "당신 생각엔, 그 로도스 아일랜드의 의사가 거짓말을 하는 것 같나요?"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"웨이 옌우\"]  확신할 순 없지. 그 의사 같은 부류의 인간들 중엔 거짓말을 안 하는 자를 찾기가 더 힘들어. 그리고 로도스 아일랜드는 자신들을 숨기는 데 능숙한 자들이다. 약한 모습을 보이고는 있지만, 우리에게 중요한 비밀은 절대 흘리지 않지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "확신할 순 없지. 그 의사 같은 부류의 인간들 중엔 거짓말을 안 하는 자를 찾기가 더 힘들어. 그리고 로도스 아일랜드는 자신들을 숨기는 데 능숙한 자들이다. 약한 모습을 보이고는 있지만, 우리에게 중요한 비밀은 절대 흘리지 않지."
    },
    {
        "id": 52,
        "raw": "[name=\"웨이 옌우\"]  하지만, 차라리 카셰이가 지금의 탈룰라를 만들었다고 믿는 편이 나아. 적을 얕잡아 봤다가는 큰코다칠 테니.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "하지만, 차라리 카셰이가 지금의 탈룰라를 만들었다고 믿는 편이 나아. 적을 얕잡아 봤다가는 큰코다칠 테니."
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"후미즈키\"]  ……탈루……",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "……탈루……"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"웨이 옌우\"]  그리고 그렇기 때문에, 첸 훼이지에에게 이 일을 맡겨서는 안 되는 거라고.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "그리고 그렇기 때문에, 첸 훼이지에에게 이 일을 맡겨서는 안 되는 거라고."
    },
    {
        "id": 57,
        "raw": "[name=\"웨이 옌우\"]  카셰이…… 모든 일이 그가 바라는 대로 완벽하게 흘러가고 있어. 카셰이가 죽는다 해도, 탈룰라가 뒤를 이어 그의 염원을 대신 이뤄줄 테니까.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "카셰이…… 모든 일이 그가 바라는 대로 완벽하게 흘러가고 있어. 카셰이가 죽는다 해도, 탈룰라가 뒤를 이어 그의 염원을 대신 이뤄줄 테니까."
    },
    {
        "id": 58,
        "raw": "[name=\"웨이 옌우\"]  카셰이가 바라는 대로 흘러가게 내버려 둘 순 없지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "카셰이가 바라는 대로 흘러가게 내버려 둘 순 없지."
    },
    {
        "id": 59,
        "raw": "[name=\"웨이 옌우\"]  정찰팀이 보고해주더군, 용문을 떠난 감염자 일부가 코어 쪽으로 이동 중이라고.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "정찰팀이 보고해주더군, 용문을 떠난 감염자 일부가 코어 쪽으로 이동 중이라고."
    },
    {
        "id": 60,
        "raw": "[name=\"웨이 옌우\"]  코어는 반드시 일정 시간 동안 멈춰야 하니, 그 사이에 감염자 난민을 구조하려 할 거야.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "코어는 반드시 일정 시간 동안 멈춰야 하니, 그 사이에 감염자 난민을 구조하려 할 거야."
    },
    {
        "id": 61,
        "raw": "[name=\"웨이 옌우\"]  설령 탈룰라가 우르수스의 악랄한 송곳니를 드러내 보인다 해도, 모두의 앞에서 리유니온을 배신할 순 없겠지. 이건 절호의 기회야.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "설령 탈룰라가 우르수스의 악랄한 송곳니를 드러내 보인다 해도, 모두의 앞에서 리유니온을 배신할 순 없겠지. 이건 절호의 기회야."
    },
    {
        "id": 62,
        "raw": "[name=\"웨이 옌우\"]  내가 그림자 부대를 지휘해야겠어.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "내가 그림자 부대를 지휘해야겠어."
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"후미즈키\"]  당신이요?!",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "당신이요?!"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"웨이 옌우\"]  그들은 이미 날 위해 충분히 많은 일을 해주었지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "그들은 이미 날 위해 충분히 많은 일을 해주었지."
    },
    {
        "id": 67,
        "raw": "[name=\"웨이 옌우\"]  그들 손에 다신 피를 묻히지 않겠다 약속했지만… 매번 그 약속을 지키지 못했고…",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "그들 손에 다신 피를 묻히지 않겠다 약속했지만… 매번 그 약속을 지키지 못했고…"
    },
    {
        "id": 68,
        "raw": "[name=\"웨이 옌우\"]  그런데 지금 또다시 그들에게 용문을 위해 목숨을 바치길 강요할 수 있겠나?",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "그런데 지금 또다시 그들에게 용문을 위해 목숨을 바치길 강요할 수 있겠나?"
    },
    {
        "id": 69,
        "raw": "[name=\"웨이 옌우\"]  ……나도 그들과 함께하는 수밖에.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "……나도 그들과 함께하는 수밖에."
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"후미즈키\"]  안 돼요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "안 돼요."
    },
    {
        "id": 72,
        "raw": "[name=\"후미즈키\"]  그게 바로 카셰이가 바라는 일이에요. 이렇게 해선 절대 그를 이길 수 없어요.",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "그게 바로 카셰이가 바라는 일이에요. 이렇게 해선 절대 그를 이길 수 없어요."
    },
    {
        "id": 73,
        "raw": "[name=\"후미즈키\"]  설마 우리가 용문을 탈환했을 때부터…… 카셰이의 함정에 빠졌던 건 아닐까요?",
        "type": "dialog",
        "speaker": "후미즈키",
        "content": "설마 우리가 용문을 탈환했을 때부터…… 카셰이의 함정에 빠졌던 건 아닐까요?"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"웨이 옌우\"]  ……",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "……"
    },
    {
        "id": 76,
        "raw": "[name=\"웨이 옌우\"]  우린 승리했었지.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "우린 승리했었지."
    },
    {
        "id": 77,
        "raw": "[name=\"웨이 옌우\"]  처음엔 우리의 승리였어. 참담하지만, 나, 당신, 애드워드, 거뤠이, 우리가 없었다면, 그는 이 도시를 깨끗이 집어삼켰을 거야.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "처음엔 우리의 승리였어. 참담하지만, 나, 당신, 애드워드, 거뤠이, 우리가 없었다면, 그는 이 도시를 깨끗이 집어삼켰을 거야."
    },
    {
        "id": 78,
        "raw": "[name=\"웨이 옌우\"]  난 이 일을 불행의 시작이라 생각하지 않아.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "난 이 일을 불행의 시작이라 생각하지 않아."
    },
    {
        "id": 79,
        "raw": "[name=\"웨이 옌우\"]  애드워드의 죽음 역시…… 카셰이의 계획 안에 있었다고 생각하지 않고.",
        "type": "dialog",
        "speaker": "웨이 옌우",
        "content": "애드워드의 죽음 역시…… 카셰이의 계획 안에 있었다고 생각하지 않고."
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\")]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png"
    },
    {
        "id": 81,
        "raw": "[name=\"후미즈키\"]  당신은 그걸 그저 악몽으로 치부하려는 건가요?",
