    {
        "id": 18,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 19,
        "raw": "[name=\"리유니온\"]   서둘러! 후속 부대도 빨리 움직여라!",
        "type": "dialog",
        "speaker": "리유니온",
        "content": "서둘러! 후속 부대도 빨리 움직여라!"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 21,
        "raw": "[name=\"텍사스\"]   거기 가면 쓴 남자.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "거기 가면 쓴 남자."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 23,
        "raw": "[name=\"리유니온\"]   누구냐?!",
        "type": "dialog",
        "speaker": "리유니온",
        "content": "누구냐?!"
    },
    {
        "id": 24,
        "raw": "[name=\"리유니온\"]   무슨 속셈이지?",
        "type": "dialog",
        "speaker": "리유니온",
        "content": "무슨 속셈이지?"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 26,
        "raw": "[name=\"텍사스\"]   한꺼번에 덤벼라. 시간 아까우니까.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "한꺼번에 덤벼라. 시간 아까우니까."
    },
