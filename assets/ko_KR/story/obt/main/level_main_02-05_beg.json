    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_106_franka_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_106_franka_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"프란카\"]   아미야, 펭귄 로지스틱스의 텍사스가 돌아왔어.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "아미야, 펭귄 로지스틱스의 텍사스가 돌아왔어."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_106_franka_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"아미야\"]   아… 다행이에요!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아… 다행이에요!"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_102_texas_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"텍사스\"]   새롭게 들어온 정보가 있다.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "새롭게 들어온 정보가 있다."
    },
    {
        "id": 38,
        "raw": "[name=\"텍사스\"]   저 리유니온이라는 녀석들을 꽤 쓰러뜨렸는데 말이지.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "저 리유니온이라는 녀석들을 꽤 쓰러뜨렸는데 말이지."
    },
    {
        "id": 39,
        "raw": "[name=\"텍사스\"]   …저들의 후속 부대는 지금보다 규모가 더 큰 모양이다.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "…저들의 후속 부대는 지금보다 규모가 더 큰 모양이다."
    },
    {
        "id": 40,
        "raw": "[name=\"텍사스\"]   이제 잠복은 안 하나 봐, 대놓고 떼거지로 움직이던데.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "이제 잠복은 안 하나 봐, 대놓고 떼거지로 움직이던데."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_102_texas_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"아미야\"]   …역시 그렇군요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…역시 그렇군요…"
    },
    {
        "id": 43,
        "raw": "[name=\"아미야\"]   리유니온은 슬럼가를 경유해서 용문에 숨어들어온 거예요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "리유니온은 슬럼가를 경유해서 용문에 숨어들어온 거예요…"
    },
    {
        "id": 44,
        "raw": "[name=\"아미야\"]   게다가… 목표도 저희와 똑같고요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "게다가… 목표도 저희와 똑같고요."
    },
    {
        "id": 45,
        "raw": "[name=\"아미야\"]   그렇지 않고서야 리유니온에서 우리 로도스 아일랜드를 공격할 이유가 없어요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그렇지 않고서야 리유니온에서 우리 로도스 아일랜드를 공격할 이유가 없어요."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"리스캄\"]   용문과 리유니온만 알고 있는 무언가가 미샤에게 숨겨져 있는 거겠지.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "용문과 리유니온만 알고 있는 무언가가 미샤에게 숨겨져 있는 거겠지."
    },
    {
        "id": 48,
        "raw": "[name=\"리스캄\"]   로도스 아일랜드는 그 정보가 없으니 여기선 불리한 입장이고.",
        "type": "dialog",
        "speaker": "리스캄",
        "content": "로도스 아일랜드는 그 정보가 없으니 여기선 불리한 입장이고."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"프란카\"]   상황이 매우 급박하게 돌아가는 느낌이야.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "상황이 매우 급박하게 돌아가는 느낌이야."
    },
    {
        "id": 51,
        "raw": "[name=\"프란카\"]   지금 알 수 없는 것들은, 나중에 그 귀여운 팀장님한테 직접 물어보자고.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "지금 알 수 없는 것들은, 나중에 그 귀여운 팀장님한테 직접 물어보자고."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 53,
        "raw": "[name=\"텍사스\"]   …아직 할 얘기 남았나?",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "…아직 할 얘기 남았나?"
    },
    {
        "id": 54,
        "raw": "[name=\"텍사스\"]   없으면 출발하지, 어떻게 가야 할지는 파악해뒀어.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "없으면 출발하지, 어떻게 가야 할지는 파악해뒀어."
    },
    {
        "id": 55,
        "raw": "[name=\"텍사스\"]   엑시아한테 확실한 퇴각 경로 정보를 받았거든. 길 안내는 내가 할게.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "엑시아한테 확실한 퇴각 경로 정보를 받았거든. 길 안내는 내가 할게."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 57,
        "raw": "[name=\"아미야\"]   프란카 씨, 각 팀을 소집해 주세요. 우리는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "프란카 씨, 각 팀을 소집해 주세요. 우리는…"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 59,
        "raw": "[name=\"프란카\"]   …우선 몸을 숨길 곳부터 찾아야겠어.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "…우선 몸을 숨길 곳부터 찾아야겠어."
    },
    {
        "id": 60,
        "raw": "[name=\"프란카\"]   리유니온이 벌써 도착한 것 같거든.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "리유니온이 벌써 도착한 것 같거든."
    },
    {
        "id": 61,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 62,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 63,
        "raw": "[name=\"리유니온\"]   저쪽이다! 놓치지 마라!",
        "type": "dialog",
        "speaker": "리유니온",
        "content": "저쪽이다! 놓치지 마라!"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 65,
        "raw": "[name=\"프란카\"]   난 이렇게 뒤에서 덮치는 게 제일 싫더라고.",
        "type": "dialog",
        "speaker": "프란카",
        "content": "난 이렇게 뒤에서 덮치는 게 제일 싫더라고."
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 67,
        "raw": "[name=\"아미야\"]   저건…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저건…"
    },
    {
        "id": 68,
        "raw": "[name=\"아미야\"]   …저건…!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…저건…!"
    },
    {
        "id": 69,
        "raw": "[name=\"아미야\"]   저 사람들… 리더를 데려왔어요!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저 사람들… 리더를 데려왔어요!"
    },
    {
