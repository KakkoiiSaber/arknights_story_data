        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 15,
        "raw": "[name=\"텍사스\"]   쳇, 드디어 오셨나… 방금 막 포장 뜯었는데.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "쳇, 드디어 오셨나… 방금 막 포장 뜯었는데."
    },
    {
        "id": 16,
        "raw": "[name=\"텍사스\"]   짜증나게.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "짜증나게."
    },
    {
        "id": 17,
        "raw": "[PlaySound(key=\"$d_gen_soldiersrun\")]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_soldiersrun.mp3"
