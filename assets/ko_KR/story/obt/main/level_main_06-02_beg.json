        "raw": "[PlaySound(key=\"$d_gen_walk_n\")]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_walk_n.mp3"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_014_riope\",fadetime=1,block=true)]",
        "type": "character",
        "name": "char_014_riope",
        "fadetime": "1,block=true"
    },
    {
