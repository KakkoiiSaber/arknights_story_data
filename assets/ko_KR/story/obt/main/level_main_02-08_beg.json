        "type": "character",
        "name": "char_015_lmg.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"용문근위국 대원\"]   자, 이쪽으로.",
        "type": "dialog",
        "speaker": "용문근위국 대원",
