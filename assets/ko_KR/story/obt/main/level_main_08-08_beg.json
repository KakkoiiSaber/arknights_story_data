    {
        "id": 9,
        "raw": "훼이지에에게",
        "type": "narration",
        "content": "훼이지에에게"
    },
    {
        "id": 10,
        "raw": "우리는 계속 남하 중이야.",
        "type": "narration",
        "content": "우리는 계속 남하 중이야."
    },
    {
        "id": 11,
        "raw": "유격대는 각 광산의 감염자 멸종 계획이 시작되기 전에 감염자를 최대한 많이 구하려고 해.",
        "type": "narration",
        "content": "유격대는 각 광산의 감염자 멸종 계획이 시작되기 전에 감염자를 최대한 많이 구하려고 해."
    },
    {
        "id": 12,
        "raw": "주둔군이 한 발 후퇴하면, 우리는 한 발 나아갔지.",
        "type": "narration",
        "content": "주둔군이 한 발 후퇴하면, 우리는 한 발 나아갔지."
    },
    {
        "id": 13,
        "raw": "우리가 우르수스 부대를 추격하는 것 같지만 그건 절대 불가능해.",
        "type": "narration",
        "content": "우리가 우르수스 부대를 추격하는 것 같지만 그건 절대 불가능해."
    },
    {
        "id": 14,
        "raw": "우르수스 정규군을 피하면서, 그들이 보는 앞에서 감염자를 구하고 있어.",
        "type": "narration",
        "content": "우르수스 정규군을 피하면서, 그들이 보는 앞에서 감염자를 구하고 있어."
    },
    {
        "id": 15,
        "raw": "왜 이래야 하느냐고 묻는다면, \"이렇게 해야 하니까\"라고 대답할 수밖에 없을 것 같아.",
        "type": "narration",
        "content": "왜 이래야 하느냐고 묻는다면, \"이렇게 해야 하니까\"라고 대답할 수밖에 없을 것 같아."
    },
    {
        "id": 16,
        "raw": "하지만 나는 더 많은 감염자를 수용해 다른 부대에게 공간을 확보해 주는 것 역시 패트리어트 씨의 전략 중 하나라고 생각해.",
        "type": "narration",
        "content": "하지만 나는 더 많은 감염자를 수용해 다른 부대에게 공간을 확보해 주는 것 역시 패트리어트 씨의 전략 중 하나라고 생각해."
    },
    {
        "id": 17,
        "raw": "패트리어트 씨는 선을 그은 것 같아, 우리가 넘을 수 없는 선을……",
        "type": "narration",
        "content": "패트리어트 씨는 선을 그은 것 같아, 우리가 넘을 수 없는 선을……"
    },
    {
        "id": 18,
        "raw": "그 선을 넘는다는 건 절대 불가능하겠지만, 우리가 우르수스 주둔군과 정면승부를 벌이거나 매복해야 한다는 뜻일 거야.",
        "type": "narration",
        "content": "그 선을 넘는다는 건 절대 불가능하겠지만, 우리가 우르수스 주둔군과 정면승부를 벌이거나 매복해야 한다는 뜻일 거야."
    },
    {
        "id": 19,
        "raw": "그러니까 설원을 떠난다는 건 우르수스의 진짜 영토, 엄격한 법에 따라 관리되는 이동 영토에 비밀리에 들어간다는 뜻이겠지.",
        "type": "narration",
        "content": "그러니까 설원을 떠난다는 건 우르수스의 진짜 영토, 엄격한 법에 따라 관리되는 이동 영토에 비밀리에 들어간다는 뜻이겠지."
    },
    {
        "id": 20,
        "raw": "그때가 되면, 우리가 다시 공격할 기회를 찾기 전까지 유격대는 무기를 내려놔야 할 거야.",
        "type": "narration",
        "content": "그때가 되면, 우리가 다시 공격할 기회를 찾기 전까지 유격대는 무기를 내려놔야 할 거야."
    },
    {
        "id": 21,
        "raw": "황야에는 우르수스 군함이 활개를 치고, 도시에선 감염자를 더 무자비하게 다룰 거야. 분명 고통스러운 시간이 되겠지.",
        "type": "narration",
        "content": "황야에는 우르수스 군함이 활개를 치고, 도시에선 감염자를 더 무자비하게 다룰 거야. 분명 고통스러운 시간이 되겠지."
    },
    {
        "id": 22,
        "raw": "이 한 걸음을 내딛는 게 너무 힘들어.",
        "type": "narration",
        "content": "이 한 걸음을 내딛는 게 너무 힘들어."
    },
    {
        "id": 23,
        "raw": "하지만 서북 툰드라는…… 온통 눈뿐이야.",
