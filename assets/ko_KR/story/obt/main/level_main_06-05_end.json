        "raw": "[Character(name=\"char_1507_Mephisto_1#1\",name2=\"char_1508_Faust_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1.png",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
