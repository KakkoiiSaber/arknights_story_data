    {
        "id": 95,
        "raw": "[Character(name=\"char_308_swire_1#6\")]",
        "type": "character",
        "name": "char_308_swire_1#6.png"
    },
    {
        "id": 96,
        "raw": "[name=\"스와이어\"]  야이 쥐새끼야! 너 지금 뭐 하자는 거야! 너 맞지?!",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "야이 쥐새끼야! 너 지금 뭐 하자는 거야! 너 맞지?!"
    },
    {
        "id": 97,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 98,
        "raw": "[name=\"???\"]  ……왜 날 의심하는 거야?",
        "type": "dialog",
        "speaker": "???",
        "content": "……왜 날 의심하는 거야?"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_308_swire_1#6\")]",
        "type": "character",
        "name": "char_308_swire_1#6.png"
    },
    {
        "id": 100,
        "raw": "[name=\"스와이어\"]  네가 아니면 됐어. 에이 씨, 괜히 걱정했……",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "네가 아니면 됐어. 에이 씨, 괜히 걱정했……"
    },
    {
        "id": 101,
        "raw": "[Character]",
