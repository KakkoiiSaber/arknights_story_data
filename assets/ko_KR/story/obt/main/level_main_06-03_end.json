    },
    {
        "id": 125,
        "raw": "[name=\"파우스트\"]  너의 옳고 그름은 나와 아무 상관없다.",
        "type": "dialog",
        "speaker": "파우스트",
        "content": "너의 옳고 그름은 나와 아무 상관없다."
