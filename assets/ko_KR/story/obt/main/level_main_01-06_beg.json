        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"도베르만\"]  무슨 소릴 하는 거냐!",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "무슨 소릴 하는 거냐!"
    },
