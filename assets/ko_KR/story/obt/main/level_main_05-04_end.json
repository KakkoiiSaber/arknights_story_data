        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"첸\"]  그때는 숙소에 머물렀었지.",
        "type": "dialog",
        "speaker": "첸",
        "content": "그때는 숙소에 머물렀었지."
