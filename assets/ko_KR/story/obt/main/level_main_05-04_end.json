        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"호시구마\"]  그래.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "그래."
    },
    {
        "id": 70,
        "raw": "[name=\"호시구마\"]  내 기억에 넌, 빅토리아에서 졸업하고 용문으로 돌아오자마자 바로 근위국에 들어갔던 것 같은데.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "내 기억에 넌, 빅토리아에서 졸업하고 용문으로 돌아오자마자 바로 근위국에 들어갔던 것 같은데."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
