    {
        "id": 30,
        "raw": "[name=\"호시구마\"]   이 지형……",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "이 지형……"
    },
    {
        "id": 31,
        "raw": "[name=\"호시구마\"]   리유니온이 의도적으로 우리를 이곳으로 유인했을 가능성이 있다.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "리유니온이 의도적으로 우리를 이곳으로 유인했을 가능성이 있다."
    },
    {
        "id": 32,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 33,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 34,
        "raw": "[Blocker(a=0, r=0, g=0, b=0, fadetime=2, block=true)]",
        "type": "blocker",
        "a": "0,",
        "r": "0,",
