        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 144,
        "raw": "[name=\"미샤\"]   아니야…",
        "type": "dialog",
