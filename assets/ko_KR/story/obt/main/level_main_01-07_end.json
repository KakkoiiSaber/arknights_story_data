        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 20,
        "raw": "[name=\"도베르만\"]   오리지늄이 생겨나기 시작한 건가…",
        "type": "dialog",
        "speaker": "도베르만",
        "content": "오리지늄이 생겨나기 시작한 건가…"
    },
