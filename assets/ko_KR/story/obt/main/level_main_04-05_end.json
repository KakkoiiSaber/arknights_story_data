    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 6,
        "raw": "[name=\"아미야\"]   상황이 이렇게 된 이상… 저희는 이미 다른 선택지가 없어요. 만약 첸 팀장님께서 거절하신다면…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "상황이 이렇게 된 이상… 저희는 이미 다른 선택지가 없어요. 만약 첸 팀장님께서 거절하신다면…"
    },
    {
        "id": 7,
        "raw": "[name=\"아미야\"]   로도스 아일랜드만이라도 움직이도록 하겠습니다.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "로도스 아일랜드만이라도 움직이도록 하겠습니다."
    },
    {
        "id": 8,
        "raw": "[name=\"아미야\"]   이 구출 임무 자체가 용문과 맺은 계약을 위반하는 행위는 아닐 테니까요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이 구출 임무 자체가 용문과 맺은 계약을 위반하는 행위는 아닐 테니까요."
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"첸\"]   당연히 근위국도 갈 생각이다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "당연히 근위국도 갈 생각이다."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"아미야\"]   그, 그러신가요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그, 그러신가요…"
    },
    {
        "id": 13,
        "raw": "[name=\"아미야\"]   ……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……"
    },
    {
        "id": 14,
        "raw": "[name=\"아미야\"]   그럼 제가 로도스 아일랜드의 대표로서, 첸 팀장님께 감사드려야겠네요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그럼 제가 로도스 아일랜드의 대표로서, 첸 팀장님께 감사드려야겠네요."
    },
    {
        "id": 15,
        "raw": "[name=\"아미야\"]   저도 알고 있습니다. 용문에서 감염자는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저도 알고 있습니다. 용문에서 감염자는…"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"첸\"]   그런 건 중요하지 않아.",
        "type": "dialog",
        "speaker": "첸",
        "content": "그런 건 중요하지 않아."
    },
    {
        "id": 18,
        "raw": "[name=\"첸\"]   다만 근위국의 각 소대가 굳이 버려진 도시 내부까지 돌입할 필요가 있을지 의문이 남아서 말이지.",
        "type": "dialog",
        "speaker": "첸",
        "content": "다만 근위국의 각 소대가 굳이 버려진 도시 내부까지 돌입할 필요가 있을지 의문이 남아서 말이지."
    },
    {
        "id": 19,
        "raw": "[name=\"첸\"]   도시 내부의 돌입 여부는 상대가 어떻게 나오느냐에 달렸다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "도시 내부의 돌입 여부는 상대가 어떻게 나오느냐에 달렸다."
    },
    {
        "id": 20,
        "raw": "[name=\"첸\"]   하지만 우리는 구출이 아니라, 리유니온을 철저히 제거하는 것을 최우선 목표로 삼아 행동하려 한다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "하지만 우리는 구출이 아니라, 리유니온을 철저히 제거하는 것을 최우선 목표로 삼아 행동하려 한다."
    },
    {
        "id": 21,
        "raw": "[name=\"첸\"]   그래도 가능한 범위 내에서는 반드시 너희에게 힘을 보태주도록 하지.",
        "type": "dialog",
        "speaker": "첸",
        "content": "그래도 가능한 범위 내에서는 반드시 너희에게 힘을 보태주도록 하지."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"아미야\"]   그걸로도… 충분합니다.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그걸로도… 충분합니다."
    },
    {
        "id": 24,
        "raw": "[name=\"아미야\"]   …정말 감사합니다, 첸 팀장님.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…정말 감사합니다, 첸 팀장님."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"첸\"]   미안하군. 내게도 내 나름의 사명이 있어서.",
        "type": "dialog",
        "speaker": "첸",
        "content": "미안하군. 내게도 내 나름의 사명이 있어서."
    },
    {
        "id": 27,
        "raw": "[name=\"첸\"]   통신기로 듣고 있는 거기 의사, 내 목소리 잘 들리나?",
        "type": "dialog",
        "speaker": "첸",
        "content": "통신기로 듣고 있는 거기 의사, 내 목소리 잘 들리나?"
    },
    {
        "id": 28,
        "raw": "[name=\"첸\"]   나는 로도스 아일랜드와 함께 움직일 거다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "나는 로도스 아일랜드와 함께 움직일 거다."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 30,
        "raw": "[name=\"켈시\"]   아미야, 몸조심해라.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "아미야, 몸조심해라."
    },
    {
        "id": 31,
        "raw": "[name=\"켈시\"]   그렇게 간단한 상황이 아니야.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "그렇게 간단한 상황이 아니야."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 33,
        "raw": "[name=\"아미야\"]   네, 신중하게 움직일게요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "네, 신중하게 움직일게요."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 35,
        "raw": "[name=\"켈시\"]   그리고, 여기서는 계속 정보를 취합하고 있다.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "그리고, 여기서는 계속 정보를 취합하고 있다."
    },
    {
        "id": 36,
        "raw": "[name=\"켈시\"]   취합한 정보를 바탕으로 구조팀을 파견해서 다른 정찰팀을 지원하도록 했지.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "취합한 정보를 바탕으로 구조팀을 파견해서 다른 정찰팀을 지원하도록 했지."
    },
    {
        "id": 37,
        "raw": "[name=\"켈시\"]   그런데 메테오라이트가 있는 곳은 구조팀도 깊이 들어갈 수가 없어서, 큰 도움을 줄 수 없는 상황이야.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "그런데 메테오라이트가 있는 곳은 구조팀도 깊이 들어갈 수가 없어서, 큰 도움을 줄 수 없는 상황이야."
    },
    {
        "id": 38,
        "raw": "[name=\"켈시\"]   메테오라이트 일행은 네게 맡길 수밖에 없다.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "메테오라이트 일행은 네게 맡길 수밖에 없다."
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 40,
        "raw": "[name=\"아미야\"]   그말은, 메테오라이트 씨 일행이 있는 곳이 제일 위험하다는 거군요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그말은, 메테오라이트 씨 일행이 있는 곳이 제일 위험하다는 거군요…"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 42,
        "raw": "[name=\"아미야\"]   알겠어요. 메테오라이트 씨가 계신 곳으로 가겠습니다.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "알겠어요. 메테오라이트 씨가 계신 곳으로 가겠습니다."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 44,
        "raw": "[name=\"켈시\"]   위치 좌표는 지금 보내두지.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "위치 좌표는 지금 보내두지."
    },
    {
        "id": 45,
        "raw": "[name=\"켈시\"]   잊지 마라, 항상 네 안전을 최우선으로 생각해야 한다.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "잊지 마라, 항상 네 안전을 최우선으로 생각해야 한다."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 47,
