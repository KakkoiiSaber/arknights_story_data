        "type": "character",
        "name": "avg_npc_059"
    },
    {
        "id": 56,
        "raw": "[name=\"로도스 아일랜드 가드 오퍼레이터?\"] 거짓말하지 마!",
        "type": "dialog",
        "speaker": "로도스 아일랜드 가드 오퍼레이터?",
        "content": "거짓말하지 마!"
