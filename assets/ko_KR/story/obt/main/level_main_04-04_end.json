        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"제시카\"]   게다가… 더 많은 증원군이…",
        "type": "dialog",
        "speaker": "제시카",
