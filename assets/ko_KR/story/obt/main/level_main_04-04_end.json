    {
        "id": 40,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 41,
        "raw": "[name=\"메피스토\"]   하하… 이런 상황에서 그런 말을 할 여유가 있나봐?",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "하하… 이런 상황에서 그런 말을 할 여유가 있나봐?"
    },
    {
        "id": 42,
        "raw": "[name=\"메피스토\"]   자신감이 넘치나 보네.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "자신감이 넘치나 보네."
