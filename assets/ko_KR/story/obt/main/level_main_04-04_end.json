    {
        "id": 29,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 30,
        "raw": "[name=\"프로스트리프\"]   저 녀석의 지팡이에서 빛이 나는데…?",
        "type": "dialog",
        "speaker": "프로스트리프",
        "content": "저 녀석의 지팡이에서 빛이 나는데…?"
