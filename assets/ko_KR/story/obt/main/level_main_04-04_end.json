    {
        "id": 31,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 32,
        "raw": "[name=\"메피스토\"]   아직 나는 손도 안 썼는데 말이야.",
        "type": "dialog",
        "speaker": "메피스토",
        "content": "아직 나는 손도 안 썼는데 말이야."
