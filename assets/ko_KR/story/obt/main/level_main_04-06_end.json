    },
    {
        "id": 6,
        "raw": "[name=\"아미야\"]   리유니온을 모두 처치했어요!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "리유니온을 모두 처치했어요!"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"호시구마\"]   큭, 장애물치곤 흉폭한 녀석들이었다!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "큭, 장애물치곤 흉폭한 녀석들이었다!"
    },
    {
        "id": 9,
        "raw": "[name=\"호시구마\"]   ……",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "……"
    },
    {
        "id": 10,
        "raw": "[name=\"호시구마\"]   첸은 그림자도 안 보이는군.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "첸은 그림자도 안 보이는군."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"아미야\"]   이대로는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이대로는…"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"호시구마\"]   통신도 받지 않는다. 칫, 여전하군그래!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "통신도 받지 않는다. 칫, 여전하군그래!"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 16,
        "raw": "[name=\"호시구마\"]   근위국 전원! 나와 함께 돌입할 준비를…",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "근위국 전원! 나와 함께 돌입할 준비를…"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 18,
        "raw": "[name=\"아미야\"]   아니에요, 호시구마 씨.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "아니에요, 호시구마 씨."
    },
    {
        "id": 19,
        "raw": "[name=\"아미야\"]   저희에게 맡겨주세요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저희에게 맡겨주세요."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"아미야\"]   이 앞은 재앙 때문에 생겨난 오리지늄이 뿌리내린 곳이에요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이 앞은 재앙 때문에 생겨난 오리지늄이 뿌리내린 곳이에요."
    },
    {
        "id": 22,
        "raw": "[name=\"아미야\"]   건강한 사람이 더 깊이 들어가면 광석병에 감염될 위험이 있습니다.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "건강한 사람이 더 깊이 들어가면 광석병에 감염될 위험이 있습니다."
    },
    {
        "id": 23,
        "raw": "[name=\"아미야\"]   그렇게 되면 심각한 결과를 초래할 거예요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그렇게 되면 심각한 결과를 초래할 거예요."
    },
    {
        "id": 24,
        "raw": "[name=\"아미야\"]   게다가 저희 감염자들은…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "게다가 저희 감염자들은…"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"호시구마\"]   훗, 그 작은 몸으로 열심히 우리를 설득하는 모습, 꽤 귀엽군.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "훗, 그 작은 몸으로 열심히 우리를 설득하는 모습, 꽤 귀엽군."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"아미야\"]   ……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"아미야\"]   에, 에에?!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "에, 에에?!"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"호시구마\"]   후후후, 마음에 담아두지 마라.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "후후후, 마음에 담아두지 마라."
    },
    {
        "id": 33,
        "raw": "[name=\"호시구마\"]   그렇게 설득하려 들지 않아도, 네가 무슨 생각인지는 잘 알았으니까.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "그렇게 설득하려 들지 않아도, 네가 무슨 생각인지는 잘 알았으니까."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 35,
        "raw": "[name=\"호시구마\"]   근위국! 우리는 로도스 아일랜드의 방패 역할을 맡는다!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "근위국! 우리는 로도스 아일랜드의 방패 역할을 맡는다!"
    },
    {
        "id": 36,
        "raw": "[name=\"호시구마\"]   입구를 사수해라! 단 한 명의 적도 들여보내선 안 된다!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "입구를 사수해라! 단 한 명의 적도 들여보내선 안 된다!"
    },
    {
        "id": 37,
        "raw": "[name=\"호시구마\"]   감염자 문제는 감염자 전문가들에게 맡긴다!",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "감염자 문제는 감염자 전문가들에게 맡긴다!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 39,
        "raw": "[name=\"아미야\"]   호시구마 씨…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "호시구마 씨…"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"호시구마\"]   아, 그리고 이젠 그냥 편하게 호시구마라 불러.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "아, 그리고 이젠 그냥 편하게 호시구마라 불러."
    },
    {
        "id": 42,
        "raw": "[name=\"호시구마\"]   어서 가라, 첸은 너희에게 맡길 테니.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "어서 가라, 첸은 너희에게 맡길 테니."
    },
    {
        "id": 43,
        "raw": "[name=\"호시구마\"]   꼭 첸을 무사히 데려와 줘.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "꼭 첸을 무사히 데려와 줘."
    },
