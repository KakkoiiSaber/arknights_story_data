        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"아미야\"]   알겠어요, 호시구마…! 첸 팀장님을 꼭 무사히 모셔오겠습니다!",
        "type": "dialog",
        "speaker": "아미야",
        "content": "알겠어요, 호시구마…! 첸 팀장님을 꼭 무사히 모셔오겠습니다!"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"호시구마\"]   너희들도 조심하도록.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "너희들도 조심하도록."
