        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"미샤\"]   …무슨… 말을 하는 거야.",
        "type": "dialog",
        "speaker": "미샤",
        "content": "…무슨… 말을 하는 거야."
