        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"아미야\"]   네, 미샤 씨와 똑같아요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "네, 미샤 씨와 똑같아요."
    },
    {
