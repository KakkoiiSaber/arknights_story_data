        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"프로스트리프\"]   메피스토는 들러리 같은 거다.",
        "type": "dialog",
        "speaker": "프로스트리프",
        "content": "메피스토는 들러리 같은 거다."
    },
    {
        "id": 110,
        "raw": "[name=\"프로스트리프\"]   이 버려진 도시에는…",
