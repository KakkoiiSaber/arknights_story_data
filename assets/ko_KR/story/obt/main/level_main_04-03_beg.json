        "name": "char_003_kalts_1.png"
    },
    {
        "id": 6,
        "raw": "[name=\"켈시\"]   알았다.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "알았다."
    },
    {
        "id": 7,
        "raw": "[name=\"켈시\"]   그래, 수시로 연락해라. 수상한 낌새가 있으면 바로 알려주고.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "그래, 수시로 연락해라. 수상한 낌새가 있으면 바로 알려주고."
    },
    {
        "id": 8,
        "raw": "[name=\"켈시\"]   세 번째 키를 누르면 돼, 맞아.",
        "type": "dialog",
        "speaker": "켈시",
        "content": "세 번째 키를 누르면 돼, 맞아."
    },
    {
        "id": 9,
        "raw": "[name=\"켈시\"]   …음? {@nickname} 박사?",
        "type": "dialog",
        "speaker": "켈시",
        "content": "…음? {@nickname} 박사?"
    },
    {
        "id": 10,
        "raw": "[name=\"켈시\"]   아미야는?",
        "type": "dialog",
        "speaker": "켈시",
        "content": "아미야는?"
    },
    {
        "id": 11,
