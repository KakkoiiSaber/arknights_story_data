        "type": "character",
        "name": "char_003_kalts_1.png",
        "focus": -1
    },
    {
        "id": 12,
        "raw": "[Decision(options=\"아미야는 슬럼가에 갔다.\", values=\"1\")]",
        "type": "decision",
        "options": "아미야는 슬럼가에 갔다.",
        "values": "1"
    },
    {
        "id": 13,
