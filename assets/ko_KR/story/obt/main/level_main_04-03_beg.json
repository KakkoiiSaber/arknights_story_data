    },
    {
        "id": 32,
        "raw": "[name=\"아미야\"]   어라, 박사님?",
        "type": "dialog",
        "speaker": "아미야",
        "content": "어라, 박사님?"
    },
    {
        "id": 33,
        "raw": "[name=\"아미야\"]   계속 저를 기다리고 계셨던 건가요…?",
        "type": "dialog",
        "speaker": "아미야",
        "content": "계속 저를 기다리고 계셨던 건가요…?"
    },
    {
        "id": 34,
        "raw": "[name=\"아미야\"]   오래 기다리시게 해서 죄송해요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "오래 기다리시게 해서 죄송해요."
    },
    {
        "id": 35,
        "raw": "[name=\"아미야\"]   네? 제 표정이 출발하기 전이랑 달라 보인다고요?",
        "type": "dialog",
        "speaker": "아미야",
        "content": "네? 제 표정이 출발하기 전이랑 달라 보인다고요?"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#3\")]",
        "type": "character",
        "name": "char_002_amiya_1#3.png"
    },
    {
        "id": 37,
        "raw": "[name=\"아미야\"]   ……",
        "type": "dialog",
        "speaker": "아미야",
        "content": "……"
    },
    {
        "id": 38,
        "raw": "[name=\"아미야\"]   네… 뭐…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "네… 뭐…"
    },
    {
        "id": 39,
        "raw": "[name=\"아미야\"]   저는…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저는…"
    },
    {
        "id": 40,
        "raw": "[name=\"아미야\"]   첸 팀장님도 나름 생각이 있으신 게 아닐까 해요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "첸 팀장님도 나름 생각이 있으신 게 아닐까 해요."
    },
    {
        "id": 41,
        "raw": "[name=\"아미야\"]   첸 팀장님은 차가운 말을 하시거나, 제가 이해 못 할 일들을 하긴 하시지만…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "첸 팀장님은 차가운 말을 하시거나, 제가 이해 못 할 일들을 하긴 하시지만…"
    },
    {
        "id": 42,
        "raw": "[name=\"아미야\"]   어쩌면 그분도… 저희와 비슷한 분일지도 모른다는 생각이 들어요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "어쩌면 그분도… 저희와 비슷한 분일지도 모른다는 생각이 들어요."
    },
    {
        "id": 43,
        "raw": "[name=\"아미야\"]   첸 팀장님에게도 그분만의 책임이 있는 거니까요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "첸 팀장님에게도 그분만의 책임이 있는 거니까요."
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2.png"
    },
    {
        "id": 45,
        "raw": "[name=\"아미야\"]   …네… 분명 그럴 거예요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…네… 분명 그럴 거예요."
    },
    {
        "id": 46,
        "raw": "[name=\"아미야\"]   첸 팀장님은 너무 많은 책임을 떠맡고 계신 것 같아요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "첸 팀장님은 너무 많은 책임을 떠맡고 계신 것 같아요."
    },
    {
        "id": 47,
        "raw": "[name=\"아미야\"]   그런 의미에서는 저도…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그런 의미에서는 저도…"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_002_amiya_1#2\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "focus": -1
    },
    {
        "id": 49,
        "raw": "[Decision(options=\"아미야, 너도 너무 많은 책임을 떠맡고 있어.;……\", values=\"1;2\")]",
        "type": "decision",
        "options": "아미야, 너도 너무 많은 책임을 떠맡고 있어.;……",
        "values": "1;2"
    },
    {
        "id": 50,
        "raw": "[Predicate(references=\"1;2\")]",
        "type": "predicate",
        "references": "1;2"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 52,
        "raw": "[name=\"아미야\"]   그럴지도 모르겠네요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그럴지도 모르겠네요…"
    },
    {
        "id": 53,
        "raw": "[name=\"아미야\"]   그렇지만, 저는… 달리 선택지가 없을 뿐이에요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그렇지만, 저는… 달리 선택지가 없을 뿐이에요."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "focus": -1
    },
    {
        "id": 55,
        "raw": "[Decision(options=\"적어도 넌 네 선택을 믿고 나아가고 있잖아.;……\", values=\"1;2\")]",
        "type": "decision",
        "options": "적어도 넌 네 선택을 믿고 나아가고 있잖아.;……",
        "values": "1;2"
    },
    {
        "id": 56,
        "raw": "[Predicate(references=\"1;2\")]",
        "type": "predicate",
        "references": "1;2"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 58,
        "raw": "[name=\"아미야\"]   …그런 결과를 맞이하고서도 제가 선택한 길을 변함없이 걸어가고 있다고 할 수 있을지는, 솔직히 잘 모르겠어요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "…그런 결과를 맞이하고서도 제가 선택한 길을 변함없이 걸어가고 있다고 할 수 있을지는, 솔직히 잘 모르겠어요…"
    },
    {
        "id": 59,
        "raw": "[name=\"아미야\"]   박사님… 그런 식으로 절 위로하지 않으셔도 돼요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "박사님… 그런 식으로 절 위로하지 않으셔도 돼요."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 61,
        "raw": "[name=\"아미야\"]   저도 아니까요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "저도 아니까요."
    },
    {
        "id": 62,
        "raw": "[name=\"아미야\"]   하지만…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "하지만…"
    },
    {
        "id": 63,
        "raw": "[name=\"아미야\"]   대체 언제쯤이면, 이 땅이 변하는 날이 올 수 있을까요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "대체 언제쯤이면, 이 땅이 변하는 날이 올 수 있을까요…"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1#3\")]",
        "type": "character",
        "name": "char_002_amiya_1#3.png"
    },
    {
        "id": 65,
        "raw": "[name=\"아미야\"]   그래도 이것만큼은 분명해요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "그래도 이것만큼은 분명해요."
    },
    {
        "id": 66,
        "raw": "[name=\"아미야\"]   전 포기하지 않을 거예요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "전 포기하지 않을 거예요."
    },
    {
        "id": 67,
        "raw": "[name=\"아미야\"]   어떤 결과가 나오더라도 책임을 질 각오가 되어 있어요… 제가 선택한 길이니까요.",
        "type": "dialog",
        "speaker": "아미야",
        "content": "어떤 결과가 나오더라도 책임을 질 각오가 되어 있어요… 제가 선택한 길이니까요."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_002_amiya_1#3\")]",
        "type": "character",
        "name": "char_002_amiya_1#3.png"
    },
    {
        "id": 69,
        "raw": "[name=\"아미야\"]   박사님…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "박사님…"
    },
    {
        "id": 70,
        "raw": "[name=\"아미야\"]   박사님께서는… 그래도 제 곁에 있어 주실 건가요?",
        "type": "dialog",
        "speaker": "아미야",
        "content": "박사님께서는… 그래도 제 곁에 있어 주실 건가요?"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 72,
        "raw": "[name=\"아미야\"]   이 죄책감은… 저를 평생 따라다닐 거예요…",
        "type": "dialog",
        "speaker": "아미야",
        "content": "이 죄책감은… 저를 평생 따라다닐 거예요…"
    },
    {
        "id": 73,
        "raw": "[name=\"아미야\"]   모든 사람의 뜻을 한데 모으지 못했던 데서 오는 속상함, 친구를 구하지 못한 데서 오는 죄책감…",
