    {
        "id": 175,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 176,
        "raw": "[name=\"스와이어\"]  내가 언제 너한테 뻥 친 적 있어?",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "내가 언제 너한테 뻥 친 적 있어?"
