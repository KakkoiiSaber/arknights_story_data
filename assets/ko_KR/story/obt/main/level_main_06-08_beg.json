        "type": "character",
        "name": "char_308_swire_1#5.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"스와이어\"]  이곳을 지키기 위해서라면, 린은 분명 받아줄 거야.",
        "type": "dialog",
        "speaker": "스와이어",
