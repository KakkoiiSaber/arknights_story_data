    {
        "id": 7,
        "raw": "[name=\"첸\"]  호시구마?",
        "type": "dialog",
        "speaker": "첸",
        "content": "호시구마?"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"호시구마\"]  어?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "어?"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"첸\"]  안색이 별로 좋지 않군.",
        "type": "dialog",
        "speaker": "첸",
        "content": "안색이 별로 좋지 않군."
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"호시구마\"]  별거 아니야. 잠깐 생각 좀 하느라.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "별거 아니야. 잠깐 생각 좀 하느라."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"첸\"] …나도 녀석이 휘말려 들 줄은 몰랐다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "…나도 녀석이 휘말려 들 줄은 몰랐다."
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"호시구마\"]  괜찮아. 나 알잖아? 지나간 건 지나간 거야… 용문 말로 표현하자면, 이것도 운명이란 거겠지.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "괜찮아. 나 알잖아? 지나간 건 지나간 거야… 용문 말로 표현하자면, 이것도 운명이란 거겠지."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"첸\"] 극동 사람도 그런 걸 믿나?",
        "type": "dialog",
        "speaker": "첸",
        "content": "극동 사람도 그런 걸 믿나?"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"호시구마\"]  이렇게 많은 일을 겪었는데, 믿기 싫어도 이젠 인정할 수밖에.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "이렇게 많은 일을 겪었는데, 믿기 싫어도 이젠 인정할 수밖에."
    },
    {
        "id": 22,
        "raw": "[name=\"호시구마\"]  아팟이 준 정보는 문제없는 거지?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "아팟이 준 정보는 문제없는 거지?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"첸\"] 확실해. 이곳이 바로 그 위치다.",
        "type": "dialog",
        "speaker": "첸",
        "content": "확실해. 이곳이 바로 그 위치다."
    },
