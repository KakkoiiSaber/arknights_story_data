    {
        "id": 95,
        "raw": "[name=\"그레이스롯\"]  난 아직 살아 있는 건가?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "난 아직 살아 있는 건가?"
    },
    {
