    },
    {
        "id": 22,
        "raw": "[name=\"그레이스롯\"]  ……안녕.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "……안녕."
    },
    {
        "id": 23,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "[name=\"아이\"]  누, 누구세요?",
        "type": "dialog",
        "speaker": "아이",
        "content": "누, 누구세요?"
    },
    {
        "id": 25,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 26,
        "raw": "[name=\"아이\"]  용문 사람이에요?",
        "type": "dialog",
        "speaker": "아이",
        "content": "용문 사람이에요?"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 28,
        "raw": "[name=\"그레이스롯\"]  ……널 해칠 사람은 아니야. 난 우르수스 말이 서툴러. 나쁜 뜻은 없어.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "……널 해칠 사람은 아니야. 난 우르수스 말이 서툴러. 나쁜 뜻은 없어."
    },
    {
        "id": 29,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 30,
        "raw": "[name=\"아이\"]  무슨 말이에요?",
        "type": "dialog",
        "speaker": "아이",
        "content": "무슨 말이에요?"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 32,
        "raw": "[name=\"그레이스롯\"]  나와 같이 가자, 여긴 너무 위험해.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "나와 같이 가자, 여긴 너무 위험해."
    },
    {
        "id": 33,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 34,
        "raw": "[name=\"아이\"]  아저씨가 여기서 기다리라고 했어요……",
        "type": "dialog",
        "speaker": "아이",
        "content": "아저씨가 여기서 기다리라고 했어요……"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 36,
        "raw": "[name=\"그레이스롯\"]  ……내가 아빠를 찾아줄게.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "……내가 아빠를 찾아줄게."
    },
    {
        "id": 37,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 38,
        "raw": "[name=\"아이\"]  정말요?",
        "type": "dialog",
        "speaker": "아이",
        "content": "정말요?"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 40,
        "raw": "[name=\"그레이스롯\"]  정말로.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "정말로."
    },
    {
        "id": 41,
        "raw": "[name=\"그레이스롯\"]  내 뒤에 숨어있는 녀석, 어서 나와.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "내 뒤에 숨어있는 녀석, 어서 나와."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1.png"
    },
    {
        "id": 43,
        "raw": "[name=\"리유니온 멤버\"]  너……",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "너……"
    },
    {
        "id": 44,
        "raw": "[name=\"리유니온 멤버\"]  넌 그 녀석들이 아니군.",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "넌 그 녀석들이 아니군."
    },
    {
        "id": 45,
        "raw": "[name=\"리유니온 멤버\"]  너… 로도스 아일랜드 소속인가?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "너… 로도스 아일랜드 소속인가?"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4.png"
    },
    {
        "id": 47,
        "raw": "[name=\"그레이스롯\"]  아이야, 물러나있으렴. 가까이 오면 안 돼.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "아이야, 물러나있으렴. 가까이 오면 안 돼."
    },
    {
        "id": 48,
        "raw": "[name=\"그레이스롯\"]  무기를 내려놓고 얌전히 항복해라.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "무기를 내려놓고 얌전히 항복해라."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"리유니온 멤버\"]  어?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "어?"
    },
    {
        "id": 51,
        "raw": "[name=\"리유니온 멤버\"]  우릴 도우려고 온 게 아닌가?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "우릴 도우려고 온 게 아닌가?"
    },
    {
        "id": 52,
        "raw": "[name=\"리유니온 멤버\"]  로도스 아일랜드! 여기에 뭐가 숨겨져 있는지 알고 그러는 거냐?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "로도스 아일랜드! 여기에 뭐가 숨겨져 있는지 알고 그러는 거냐?"
    },
    {
        "id": 53,
        "raw": "[name=\"리유니온 멤버\"]  힘들게 한 매복이다… 그 녀석들을 유인해내서 죽이지 못하면, 우리가 죽는다고!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "힘들게 한 매복이다… 그 녀석들을 유인해내서 죽이지 못하면, 우리가 죽는다고!"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"그레이스롯\"]  아이를 미끼로 삼는 네놈들은 차라리 죽는 게 낫다.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "아이를 미끼로 삼는 네놈들은 차라리 죽는 게 낫다."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"리유니온 멤버\"]  ……무슨 생각을 하는 거지? 우리가 죽으면 그걸로 끝인 줄 알아?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "……무슨 생각을 하는 거지? 우리가 죽으면 그걸로 끝인 줄 알아?"
    },
    {
        "id": 58,
        "raw": "[name=\"리유니온 멤버\"]  우리가 죽어도 녀석들은 아이를 놓아주지 않을걸, 한 명도 놓아주지 않을 거다!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "우리가 죽어도 녀석들은 아이를 놓아주지 않을걸, 한 명도 놓아주지 않을 거다!"
    },
    {
        "id": 59,
        "raw": "[name=\"리유니온 멤버\"]  그렇게 간단히 끝날 일이었다면, 아이를 미끼로 쓰는 일 따위 없이 기꺼이 우리가 죽고 끝냈을 거다!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "그렇게 간단히 끝날 일이었다면, 아이를 미끼로 쓰는 일 따위 없이 기꺼이 우리가 죽고 끝냈을 거다!"
    },
    {
        "id": 60,
        "raw": "[name=\"리유니온 멤버\"]  우린 심지어 널 공격하지도 않았는데!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "우린 심지어 널 공격하지도 않았는데!"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"그레이스롯\"]  대체 누가 그런 짓을…… 검은 삿갓을 쓴 녀석들을 말하는 건가?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "대체 누가 그런 짓을…… 검은 삿갓을 쓴 녀석들을 말하는 건가?"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"리유니온 멤버\"]  너도 녀석들을 봤군, 그런데 왜 모르는 거냐! 녀석들은 눈에 보이는 모든 사람들을 닥치는 대로 다 죽일 거다!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "너도 녀석들을 봤군, 그런데 왜 모르는 거냐! 녀석들은 눈에 보이는 모든 사람들을 닥치는 대로 다 죽일 거다!"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 66,
        "raw": "[name=\"그레이스롯\"]  그걸 지금 변명이라고 하는 건가? 너희를 제압한 후, 너희를 보호해달라고 요청하겠다.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "그걸 지금 변명이라고 하는 건가? 너희를 제압한 후, 너희를 보호해달라고 요청하겠다."
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"리유니온 멤버\"]  널 믿으라고?! 다들 네 화살에 죽었는데, 누가 누굴 보호해 주겠다고?",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "널 믿으라고?! 다들 네 화살에 죽었는데, 누가 누굴 보호해 주겠다고?"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"그레이스롯\"]  잠시동안은 너희를 보호해주겠다.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "잠시동안은 너희를 보호해주겠다."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"리유니온 멤버\"]  신경 쓸 것 없다, 우선 저 여자를 처리한 후 다시 매복하면 돼!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "신경 쓸 것 없다, 우선 저 여자를 처리한 후 다시 매복하면 돼!"
    },
    {
        "id": 73,
        "raw": "[name=\"리유니온 멤버\"]  집결 명령과 후퇴 지점은 확실히 들었다, 여기서 이렇게 죽는다면 저 아이를 지키기 위해 죽은 동료들의 부모를 무슨 낯으로 볼 수 있겠어? 그놈들은 내 동료였다고!",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "집결 명령과 후퇴 지점은 확실히 들었다, 여기서 이렇게 죽는다면 저 아이를 지키기 위해 죽은 동료들의 부모를 무슨 낯으로 볼 수 있겠어? 그놈들은 내 동료였다고!"
    },
