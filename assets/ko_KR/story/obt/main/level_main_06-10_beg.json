    {
        "id": 97,
        "raw": "[Character(name=\"char_017_homura_3#3\")]",
        "type": "character",
        "name": "char_017_homura_3#3.png"
    },
    {
        "id": 98,
        "raw": "[name=\"???\"]  안 그러면 뭐? 죽는 편이 더 좋았을려고?",
        "type": "dialog",
        "speaker": "???",
        "content": "안 그러면 뭐? 죽는 편이 더 좋았을려고?"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 100,
        "raw": "[name=\"그레이스롯\"]  오퍼레이터 블레이즈?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "오퍼레이터 블레이즈?"
    },
    {
        "id": 101,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 102,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_017_homura_3#5\",fadetime=1,block=true)]",
        "type": "character",
        "name": "char_017_homura_3#5.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 104,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 105,
        "raw": "[name=\"블레이즈\"]  네가 죽는다 해도 이 일들이 없어지는 건 아니야. 그럴 거면 살아있는 게 낫지.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "네가 죽는다 해도 이 일들이 없어지는 건 아니야. 그럴 거면 살아있는 게 낫지."
    },
    {
        "id": 106,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#5\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#5",
        "focus": 1
    },
    {
        "id": 107,
        "raw": "[name=\"그레이스롯\"]  그… 리유니온은? 그 아이들은?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "그… 리유니온은? 그 아이들은?"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#5\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#5",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"블레이즈\"]  ……",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "……"
    },
    {
        "id": 110,
        "raw": "[name=\"블레이즈\"]  오퍼레이터 그레이스롯, 예전에는 널 오해했었다. 미안해.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "오퍼레이터 그레이스롯, 예전에는 널 오해했었다. 미안해."
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_017_homura_3#5\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_017_homura_3#5",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"그레이스롯\"]  아이들은!",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "아이들은!"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_017_homura_3#9\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_017_homura_3#9",
        "focus": 2
    },
    {
        "id": 114,
        "raw": "[name=\"블레이즈\"]  리유니온은 내가 쓰러뜨렸어! 아이들은 내가 숨겼고! 내 말 좀 끝까지 들어주면 어디 덧나?!",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "리유니온은 내가 쓰러뜨렸어! 아이들은 내가 숨겼고! 내 말 좀 끝까지 들어주면 어디 덧나?!"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_367_swllow_1#3\",name2=\"char_017_homura_3#9\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#3.png",
        "name2": "char_017_homura_3#9",
        "focus": 1
    },
    {
        "id": 116,
        "raw": "[name=\"그레이스롯\"]  그럴 필요 없어… 아이들이 무사하면 그걸로 된 거야.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "그럴 필요 없어… 아이들이 무사하면 그걸로 된 거야."
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_367_swllow_1#3\",name2=\"char_017_homura_3#5\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#3.png",
        "name2": "char_017_homura_3#5",
        "focus": 2
    },
    {
        "id": 118,
        "raw": "[name=\"블레이즈\"]  …사람 성질을 꼭 그렇게 긁어야 속이 시원하겠어?",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "…사람 성질을 꼭 그렇게 긁어야 속이 시원하겠어?"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#5\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#5",
        "focus": 1
    },
    {
        "id": 120,
        "raw": "[name=\"그레이스롯\"]  나에 대해 뭘 오해했다는 거야?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "나에 대해 뭘 오해했다는 거야?"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"블레이즈\"]  네가 감염자 아이들을 위해 용기 있게 싸우는 모습을 보았지. 와… 정말 멋졌어.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "네가 감염자 아이들을 위해 용기 있게 싸우는 모습을 보았지. 와… 정말 멋졌어."
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"그레이스롯\"]  용문말이 정말 서툴구나.",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "용문말이 정말 서툴구나."
    },
    {
        "id": 125,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 2
    },
    {
        "id": 126,
        "raw": "[name=\"블레이즈\"]  보고 느낀 그대로 말하는 거야! 예전에 난 네가 피도 눈물도 없는 비감염자라 생각했고, 로도스 아일랜드에 들어온 것도 어쩌면 정보를 염탐하기 위한 게 아닐까 하고 오해했거든.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "보고 느낀 그대로 말하는 거야! 예전에 난 네가 피도 눈물도 없는 비감염자라 생각했고, 로도스 아일랜드에 들어온 것도 어쩌면 정보를 염탐하기 위한 게 아닐까 하고 오해했거든."
    },
    {
        "id": 127,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 1
    },
    {
        "id": 128,
        "raw": "[name=\"그레이스롯\"]  만일 내가 스파이라면 바로 이런 방법으로 너의 신뢰를 얻으려 하겠지. 그런데 내가 피를 흘려가며 죽게 내버려둘 정도로 네가 바보가 아니라면……",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "만일 내가 스파이라면 바로 이런 방법으로 너의 신뢰를 얻으려 하겠지. 그런데 내가 피를 흘려가며 죽게 내버려둘 정도로 네가 바보가 아니라면……"
    },
    {
        "id": 129,
        "raw": "[name=\"그레이스롯\"]  붕대 감는 거 좀 도와줄래?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "붕대 감는 거 좀 도와줄래?"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 2
    },
    {
        "id": 131,
        "raw": "[name=\"블레이즈\"]  이래봬도 난 정예 오퍼레이터라고, 당연히 해야지.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "이래봬도 난 정예 오퍼레이터라고, 당연히 해야지."
    },
    {
        "id": 132,
        "raw": "[name=\"블레이즈\"]  네 말이 맞을지도 몰라.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "네 말이 맞을지도 몰라."
    },
    {
        "id": 133,
        "raw": "[name=\"블레이즈\"]  진짜로 스파이라 해도… 네가 옳은 일을 했다는 사실에는 변함이 없어. 만약 네가 스파이라면, 난 일단 널 구해주고, 그다음에 처벌을 받게 할 거야.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "진짜로 스파이라 해도… 네가 옳은 일을 했다는 사실에는 변함이 없어. 만약 네가 스파이라면, 난 일단 널 구해주고, 그다음에 처벌을 받게 할 거야."
    },
    {
        "id": 134,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 1
    },
    {
        "id": 135,
        "raw": "[name=\"그레이스롯\"]  내가 도망칠 수도 있는데?",
        "type": "dialog",
        "speaker": "그레이스롯",
        "content": "내가 도망칠 수도 있는데?"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_017_homura_3#4\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_017_homura_3#4",
        "focus": 2
    },
    {
        "id": 137,
        "raw": "[name=\"블레이즈\"]  너무 깊게 생각하지 마. 네가 나보다 빠를 것 같아?",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "너무 깊게 생각하지 마. 네가 나보다 빠를 것 같아?"
    },
    {
        "id": 138,
        "raw": "[name=\"블레이즈\"]  신뢰라는 말은 아무런 대비도 하지 않는다는 뜻이 아니야. 신뢰라는 건 네가 뭘 할 수 있는지, 그리고 뭘 할 수 없는지를 안다는 거지.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "신뢰라는 말은 아무런 대비도 하지 않는다는 뜻이 아니야. 신뢰라는 건 네가 뭘 할 수 있는지, 그리고 뭘 할 수 없는지를 안다는 거지."
    },
    {
        "id": 139,
        "raw": "[name=\"블레이즈\"]  네가 옳은 행동을 한다면, 난 최선을 다해 도와줄 거야. 네가 잘못된 행동을 한다면 널 바로잡아주고, 심지어 널 막을 수도 있겠지. 신뢰란 이런 거라고.",
