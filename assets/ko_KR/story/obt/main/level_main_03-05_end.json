        "id": 35,
        "raw": "[Character(name=\"char_1504_cqbw\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_1504_cqbw",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"W\"]   어머나~ 무서워라.",
        "type": "dialog",
        "speaker": "W",
        "content": "어머나~ 무서워라."
    },
    {
        "id": 37,
        "raw": "[name=\"W\"]   그렇지만 이번엔 당신을 만나러 온 게 아니랍니다.",
        "type": "dialog",
        "speaker": "W",
        "content": "그렇지만 이번엔 당신을 만나러 온 게 아니랍니다."
    },
    {
        "id": 38,
        "raw": "[name=\"W\"]   아미야, 이거 받아~",
        "type": "dialog",
        "speaker": "W",
        "content": "아미야, 이거 받아~"
    },
    {
