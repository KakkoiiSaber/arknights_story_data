        "raw": "[Character(name=\"avg_npc_079\",name2=\"avg_npc_078\",focus=1)]",
        "type": "character",
        "name": "avg_npc_079",
        "name2": "avg_npc_078",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"알리나\"]  왜?",
        "type": "dialog",
        "speaker": "알리나",
        "content": "왜?"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"avg_npc_079\",name2=\"avg_npc_078#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_079",
        "name2": "avg_npc_078#2",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"탈룰라\"]  감염자 교육팀을 준비 중인데, 네가 팀장이 되는 게 어때?",
        "type": "dialog",
        "speaker": "탈룰라",
        "content": "감염자 교육팀을 준비 중인데, 네가 팀장이 되는 게 어때?"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"avg_npc_079\",name2=\"avg_npc_078#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_079",
        "name2": "avg_npc_078#2",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"알리나\"]  뭐? 내가?",
        "type": "dialog",
        "speaker": "알리나",
        "content": "뭐? 내가?"
    },
    {
        "id": 102,
