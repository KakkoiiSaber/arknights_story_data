        "name": "char_455_nothing_1#4"
    },
    {
        "id": 192,
        "raw": "[name=\"우요우\"]에휴~ 이번엔 모두 봉변을 당했지만, 그래도 괜찮습니다. 제가 두 분과 함께 정원 재건을 돕겠습니다.",
        "type": "dialog",
        "speaker": "우요우",
