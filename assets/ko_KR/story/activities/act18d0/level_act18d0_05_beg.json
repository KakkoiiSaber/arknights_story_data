    {
        "id": 18,
        "raw": "[name=\"헤비레인\"]  ……우리와 같이 가려는 건가요?",
        "type": "dialog",
        "speaker": "헤비레인",
        "content": "……우리와 같이 가려는 건가요?"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_304_hvrain\")]",
        "type": "character",
        "name": "char_304_hvrain"
    },
    {
        "id": 20,
        "raw": "[name=\"헤비레인\"]  우리에게 당신은 그저 수상한 인물에 불과하다는 건 잘 알고 있겠죠.",
        "type": "dialog",
        "speaker": "헤비레인",
        "content": "우리에게 당신은 그저 수상한 인물에 불과하다는 건 잘 알고 있겠죠."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_304_hvrain\", name2=\"avg_npc_172_1\", focus=2)]",
        "type": "character",
        "name": "char_304_hvrain",
        "name2": "avg_npc_172_1",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"'샌드솔저'\"]  당신의 대원들은 다 확인해 보셨습니까?",
        "type": "dialog",
        "speaker": "'샌드솔저'",
        "content": "당신의 대원들은 다 확인해 보셨습니까?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_304_hvrain\", name2=\"char_379_sesa_1#2\", focus=2)]",
        "type": "character",
        "name": "char_304_hvrain",
        "name2": "char_379_sesa_1#2",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"세사\"]  헤비레인, 어땠어?",
        "type": "dialog",
        "speaker": "세사",
        "content": "헤비레인, 어땠어?"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_304_hvrain\", name2=\"avg_npc_172_1\", focus=1)]",
        "type": "character",
        "name": "char_304_hvrain",
        "name2": "avg_npc_172_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"헤비레인\"]  ……모두 정상이었어요.",
        "type": "dialog",
        "speaker": "헤비레인",
        "content": "……모두 정상이었어요."
    },
    {
        "id": 27,
        "raw": "[name=\"헤비레인\"]  그래도 당신을 믿지 않아요.",
        "type": "dialog",
        "speaker": "헤비레인",
        "content": "그래도 당신을 믿지 않아요."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_304_hvrain\", name2=\"avg_npc_172_1\", focus=2)]",
        "type": "character",
        "name": "char_304_hvrain",
        "name2": "avg_npc_172_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"'샌드솔저'\"]  음, 그래요. 전 전혀 믿을 만한 존재가 아니죠.",
        "type": "dialog",
        "speaker": "'샌드솔저'",
        "content": "음, 그래요. 전 전혀 믿을 만한 존재가 아니죠."
