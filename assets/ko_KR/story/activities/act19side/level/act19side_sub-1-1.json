        "type": "character",
        "name": "avg_npc_522_1#1$1"
    },
    {
        "id": 18,
        "raw": "[name=\"퍼디낸드\"]게다가…… 나도 너한테 이 데이터가 필요한 이유를 알고 싶어.",
        "type": "dialog",
        "speaker": "퍼디낸드",
        "content": "게다가…… 나도 너한테 이 데이터가 필요한 이유를 알고 싶어."
