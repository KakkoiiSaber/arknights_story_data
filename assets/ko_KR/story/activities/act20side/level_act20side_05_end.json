    {
        "id": 62,
        "raw": "[Character(name=\"char_416_zumama_1#4\",name2=\"avg_npc_075\",focus=1)]",
        "type": "character",
        "name": "char_416_zumama_1#4",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"유넥티스\"]언니는 박사처럼 지적인 타입을 좋아하는 것 같은데, 그게 좀 걸려.",
        "type": "dialog",
