        "name": "char_416_zumama_1#5",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"유넥티스\"]다들 참 착한데 언니가 좋아할 타입은 아닌 것 같아.",
        "type": "dialog",
        "speaker": "유넥티스",
