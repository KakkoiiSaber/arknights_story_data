    {
        "id": 10,
        "raw": "[name=\"엑시아\"]   야호~",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "야호~"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_201_moeshd#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#8",
        "name2": "char_201_moeshd#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"크루아상\"]   길 똑바로 안 보나! 언니야, 핸들은 두 손으로 단디 잡아라 쫌! 한 손 띄지 말고!",
        "type": "dialog",
        "speaker": "크루아상",
        "content": "길 똑바로 안 보나! 언니야, 핸들은 두 손으로 단디 잡아라 쫌! 한 손 띄지 말고!"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 14,
        "raw": "[name=\"텍사스\"]   어쨌든 따라잡았군.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "어쨌든 따라잡았군."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_101_sora_1#4",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"소라\"]   텍사스 씨…… 다음번엔…… 제발 천천히 좀……",
        "type": "dialog",
        "speaker": "소라",
        "content": "텍사스 씨…… 다음번엔…… 제발 천천히 좀……"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_101_sora_1#4",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"텍사스\"]   음? 미안. 최대한 노력한 건데.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "음? 미안. 최대한 노력한 건데."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_103_angel_1#3\")]",
        "type": "character",
        "name": "char_103_angel_1#3"
    },
    {
        "id": 20,
        "raw": "[name=\"엑시아\"]   어쨌든 다 모였으니, 이제부터 보스를 찾으러 가볼까.",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "어쨌든 다 모였으니, 이제부터 보스를 찾으러 가볼까."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_103_angel_1#7\")]",
        "type": "character",
        "name": "char_103_angel_1#7"
    },
    {
        "id": 22,
        "raw": "[name=\"엑시아\"]   어라~? 잠깐, 뭔가 빠뜨린 것 같은데?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "어라~? 잠깐, 뭔가 빠뜨린 것 같은데?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 24,
        "raw": "[name=\"텍사스\"]   어?",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "어?"
    },
    {
        "id": 25,
        "raw": "[name=\"텍사스\"]   ……바이슨은?",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "……바이슨은?"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"엑시아\"]   에엥? 그쪽에서 데리고 오는 거 아니었어?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "에엥? 그쪽에서 데리고 오는 거 아니었어?"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"텍사스\"]   ……",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "……"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_101_sora_1#3\")]",
        "type": "character",
        "name": "char_101_sora_1#3"
    },
    {
        "id": 31,
        "raw": "[name=\"소라\"]   ……설마 우리, 아까 거기에 두고 온 건가?",
        "type": "dialog",
        "speaker": "소라",
        "content": "……설마 우리, 아까 거기에 두고 온 건가?"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1#2",
        "name2": "char_101_sora_1#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"텍사스\"]   ……늘 우리 하던 대로 하다 보니, 한 사람이 늘어난 걸 까맣게 잊고 있었군……",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "……늘 우리 하던 대로 하다 보니, 한 사람이 늘어난 걸 까맣게 잊고 있었군……"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1#2",
        "name2": "char_101_sora_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"소라\"]   ……지금 당장 돌아가서 도와줘야 하지 않아?",
        "type": "dialog",
        "speaker": "소라",
        "content": "……지금 당장 돌아가서 도와줘야 하지 않아?"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_103_angel_1#4\")]",
        "type": "character",
        "name": "char_103_angel_1#4"
    },
    {
        "id": 37,
        "raw": "[name=\"엑시아\"]   모스티마가 그 근처에 있을 테니까 괜찮지 않을까?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "모스티마가 그 근처에 있을 테니까 괜찮지 않을까?"
    },
