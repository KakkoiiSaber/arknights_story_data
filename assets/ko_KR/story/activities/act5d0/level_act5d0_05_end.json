        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"와이후\"]   그럼 전, 거절하겠어요.",
        "type": "dialog",
        "speaker": "와이후",
        "content": "그럼 전, 거절하겠어요."
    },
