    {
        "id": 68,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 69,
        "raw": "[name=\"엠퍼러\"]   하하! 아는 게 많구만. 도련님, 그건 우리의 총기 전문가가 설명해주지!",
        "type": "dialog",
        "speaker": "엠퍼러",
