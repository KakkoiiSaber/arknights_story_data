        "name": "char_213_mostma_1"
    },
    {
        "id": 20,
        "raw": "[name=\"???\"]   네 뿔에도 하나 꽂혀있어.",
        "type": "dialog",
        "speaker": "???",
        "content": "네 뿔에도 하나 꽂혀있어."
