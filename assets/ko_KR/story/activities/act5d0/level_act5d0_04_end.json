    {
        "id": 62,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 63,
        "raw": "[name=\"텍사스\"]   오토바이를 뺏은 건가? 좋은 생각인걸……",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "오토바이를 뺏은 건가? 좋은 생각인걸……"
    },
    {
        "id": 64,
        "raw": "[name=\"텍사스\"]   좋아. 너로 정했다.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "좋아. 너로 정했다."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_031\")]",
