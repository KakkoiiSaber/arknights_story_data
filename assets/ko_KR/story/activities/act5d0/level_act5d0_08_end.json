    {
        "id": 49,
        "raw": "[name=\"모스티마\"]   여기 있었구나. 방금 그건 무슨 일이야?",
        "type": "dialog",
        "speaker": "모스티마",
        "content": "여기 있었구나. 방금 그건 무슨 일이야?"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"avg_npc_034\",fadetime=2,block=true)]",
        "type": "character",
        "name": "avg_npc_034",
        "fadetime": "2,block=true"
    },
