        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 185,
        "raw": "[name=\"엑시아\"]   아! 텍사스~",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "아! 텍사스~"
    },
    {
        "id": 186,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 187,
        "raw": "[name=\"텍사스\"]   무사했네. 모스티마는?",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "무사했네. 모스티마는?"
    },
    {
        "id": 188,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 189,
        "raw": "[name=\"엑시아\"]   굳이 물어봐야 돼? 보면 알잖아.",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "굳이 물어봐야 돼? 보면 알잖아."
    },
    {
        "id": 190,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 191,
        "raw": "[name=\"텍사스\"]   그것도 그렇네. 미안.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "그것도 그렇네. 미안."
    },
    {
        "id": 192,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 193,
        "raw": "[name=\"엑시아\"]   ……왜 사과하는데! 그리고 너희는 왜 다 날 보고 있는 거야?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "……왜 사과하는데! 그리고 너희는 왜 다 날 보고 있는 거야?"
    },
    {
        "id": 194,
        "raw": "[Character(name=\"char_101_sora_1#5\")]",
        "type": "character",
        "name": "char_101_sora_1#5"
    },
    {
        "id": 195,
        "raw": "[name=\"소라\"]   아하하…… 모스티마는 돌아왔다면, 조만간 만날 수 있겠지……",
        "type": "dialog",
        "speaker": "소라",
        "content": "아하하…… 모스티마는 돌아왔다면, 조만간 만날 수 있겠지……"
    },
    {
