        "raw": "[Character(name=\"char_101_sora_1#2\")]",
        "type": "character",
        "name": "char_101_sora_1#2"
    },
    {
        "id": 183,
        "raw": "[name=\"소라\"]   정당방위니까 괜찮아요!",
        "type": "dialog",
        "speaker": "소라",
        "content": "정당방위니까 괜찮아요!"
