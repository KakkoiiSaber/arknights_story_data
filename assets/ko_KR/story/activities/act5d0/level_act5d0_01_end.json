    },
    {
        "id": 193,
        "raw": "[name=\"엑시아\"]   앗?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "앗?"
    },
    {
        "id": 194,
        "raw": "[Character(name=\"char_102_texas_1#2\")]",
        "type": "character",
        "name": "char_102_texas_1#2"
    },
    {
        "id": 195,
        "raw": "[name=\"텍사스\"]   하아 진짜… 엎드려!",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "하아 진짜… 엎드려!"
