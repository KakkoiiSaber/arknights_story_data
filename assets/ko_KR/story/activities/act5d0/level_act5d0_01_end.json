        "type": "dialog_marker"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 70,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 71,
        "raw": "[name=\"엠퍼러\"]   잠깐, 음악! 내 LP판! 여기 뒀던 거 얼로 치웠어?",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "잠깐, 음악! 내 LP판! 여기 뒀던 거 얼로 치웠어?"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_201_moeshd#4\")]",
        "type": "character",
        "name": "char_201_moeshd#4"
    },
    {
        "id": 73,
        "raw": "[name=\"크루아상\"]   아, 내가 갖고 왔을낀데. 그 상자 하나가 내 몇 개월 치 월급인 거 아나.",
        "type": "dialog",
        "speaker": "크루아상",
        "content": "아, 내가 갖고 왔을낀데. 그 상자 하나가 내 몇 개월 치 월급인 거 아나."
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"엑시아\"]   여기 있어. 어떤 걸로 틀어줄까?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "여기 있어. 어떤 걸로 틀어줄까?"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"엠퍼러\"]   아무거나 드뢉잇. 내 트랙리스트는 다 탈우주급 명곡이니.",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "아무거나 드뢉잇. 내 트랙리스트는 다 탈우주급 명곡이니."
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 79,
        "raw": "[name=\"엠퍼러\"]   그래 바로 이거지 뮤직… 예술 없는 인생은 김빠진 콜라, 브라보 마 뮤직 브라보 마 라이프!",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "그래 바로 이거지 뮤직… 예술 없는 인생은 김빠진 콜라, 브라보 마 뮤직 브라보 마 라이프!"
    },
    {
        "id": 80,
        "raw": "[name=\"엠퍼러\"]   바이슨, 계속해.",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "바이슨, 계속해."
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "id": 82,
        "raw": "[name=\"바이슨\"]   ……제, 제가 어디까지 말했죠?",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "……제, 제가 어디까지 말했죠?"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 84,
        "raw": "[name=\"엠퍼러\"]   그들의 목적.",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "그들의 목적."
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 86,
        "raw": "[name=\"바이슨\"]   그래요! 그들의 목적은 아마 저일 거예요. 귀사와 저희 회사 사이에 분쟁을 일으키려는 거예요!",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "그래요! 그들의 목적은 아마 저일 거예요. 귀사와 저희 회사 사이에 분쟁을 일으키려는 거예요!"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 88,
        "raw": "[name=\"엠퍼러\"]   왓 더…  겨우 그거야? 지난 일의 복수인 줄 알았는데…",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "왓 더…  겨우 그거야? 지난 일의 복수인 줄 알았는데…"
    },
    {
        "id": 89,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 90,
        "raw": "[name=\"바이슨\"]   혹시 짚이는 게 있으신가요?",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "혹시 짚이는 게 있으신가요?"
    },
    {
        "id": 91,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"엠퍼러\"]   ……크흠! 텍사스! 녀석들을 조사해봐!",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "……크흠! 텍사스! 녀석들을 조사해봐!"
    },
    {
        "id": 93,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1#2",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 94,
        "raw": "[name=\"텍사스\"]   추가근무수당, 3배.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "추가근무수당, 3배."
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_103_angel_1#7\")]",
        "type": "character",
        "name": "char_103_angel_1#7"
    },
    {
        "id": 96,
        "raw": "[name=\"엑시아\"]   흐음… 이 정도 싸움은 매달 열일곱? 열여덟 번은 있는 것 같아. 전달자는 다 이렇게 일하는 거 아냐?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "흐음… 이 정도 싸움은 매달 열일곱? 열여덟 번은 있는 것 같아. 전달자는 다 이렇게 일하는 거 아냐?"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_103_angel_1#7\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_103_angel_1#7",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"바이슨\"]   ……어째서죠?",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "……어째서죠?"
    },
    {
        "id": 99,
        "raw": "[name=\"바이슨\"]   전달자라면 조금 더 은밀하고 신속해야 하지 않나요…… 무력이 기준이 된 적은 없었던 걸로 아는데……",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "전달자라면 조금 더 은밀하고 신속해야 하지 않나요…… 무력이 기준이 된 적은 없었던 걸로 아는데……"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_103_angel_1#7\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_103_angel_1#7",
        "focus": 2
    },
    {
        "id": 101,
        "raw": "[name=\"엑시아\"]   그런 거야?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "그런 거야?"
    },
    {
        "id": 102,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 103,
        "raw": "[name=\"텍사스\"]   ……우리는 분명 물류 회사인데, 왜 항상 이런 세력 다툼에 휘말리는 거지?",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "……우리는 분명 물류 회사인데, 왜 항상 이런 세력 다툼에 휘말리는 거지?"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 105,
        "raw": "[name=\"엠퍼러\"]   다 플로우가 없어서 그래 플로우가. 남을 대하는 플로우가 너무 격 떨어지는 것들.",
        "type": "dialog",
        "speaker": "엠퍼러",
        "content": "다 플로우가 없어서 그래 플로우가. 남을 대하는 플로우가 너무 격 떨어지는 것들."
    },
    {
        "id": 106,
        "raw": "[Character(name=\"char_201_moeshd\")]",
        "type": "character",
        "name": "char_201_moeshd"
    },
    {
        "id": 107,
        "raw": "[name=\"크루아상\"]   보스가 우리한테 월급을 주니까 그렇지. 우린 그래도 배달할 때 규칙은 지킨다 안카나!",
        "type": "dialog",
        "speaker": "크루아상",
        "content": "보스가 우리한테 월급을 주니까 그렇지. 우린 그래도 배달할 때 규칙은 지킨다 안카나!"
    },
    {
        "id": 108,
        "raw": "[name=\"크루아상\"]   마 쪼~끔 많이, 부득이하게 무장 운송이 되어 버려서 그렇긴 하지만.",
        "type": "dialog",
        "speaker": "크루아상",
        "content": "마 쪼~끔 많이, 부득이하게 무장 운송이 되어 버려서 그렇긴 하지만."
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_103_angel_1#8\")]",
        "type": "character",
        "name": "char_103_angel_1#8"
    },
    {
        "id": 110,
        "raw": "[name=\"엑시아\"]   맞아 맞아! 딱히 문제없잖아?",
        "type": "dialog",
        "speaker": "엑시아",
        "content": "맞아 맞아! 딱히 문제없잖아?"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_325_bison_1#4\")]",
        "type": "character",
        "name": "char_325_bison_1#4"
    },
    {
        "id": 112,
        "raw": "[name=\"바이슨\"]   ……??? 이게 정말 문제가 없다고요?",
        "type": "dialog",
        "speaker": "바이슨",
        "content": "……??? 이게 정말 문제가 없다고요?"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_102_texas_1#2\")]",
        "type": "character",
        "name": "char_102_texas_1#2"
    },
    {
        "id": 114,
        "raw": "[name=\"텍사스\"]   뭐……",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "뭐……"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 116,
        "raw": "[name=\"텍사스\"]   잠시만.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "잠시만."
    },
    {
        "id": 117,
        "raw": "[name=\"텍사스\"]   여기, 소라가 남긴 암호다.",
        "type": "dialog",
        "speaker": "텍사스",
        "content": "여기, 소라가 남긴 암호다."
    },
    {
        "id": 118,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 119,
        "raw": "[Character]",
        "type": "character"
