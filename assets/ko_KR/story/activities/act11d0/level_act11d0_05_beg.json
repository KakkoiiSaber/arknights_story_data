        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 186,
        "raw": "[name=\"스즈란\"]  전 그런 뜻이 아니었는데……",
        "type": "dialog",
        "speaker": "스즈란",
        "content": "전 그런 뜻이 아니었는데……"
