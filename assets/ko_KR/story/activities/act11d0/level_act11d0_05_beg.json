        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 158,
        "raw": "[name=\"폴리닉\"]  아직 정보를 다 듣지 못……",
        "type": "dialog",
        "speaker": "폴리닉",
        "content": "아직 정보를 다 듣지 못……"
