        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"타쟈나\"]  아직 미처 빠져나가지 못한 주민이 많아요, 우리가 도와야 해요!",
        "type": "dialog",
        "speaker": "타쟈나",
