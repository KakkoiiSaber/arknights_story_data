        "name": "char_143_ghost"
    },
    {
        "id": 44,
        "raw": "[name=\"스펙터\"]   이름을…… 가르쳐 주시겠어요?",
        "type": "dialog",
        "speaker": "스펙터",
        "content": "이름을…… 가르쳐 주시겠어요?"
