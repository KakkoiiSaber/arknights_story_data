        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"빅 밥\"]   그 한 발자국 앞에 꼬챙이가 가득 박힌 구멍이 있다.",
        "type": "dialog",
        "speaker": "빅 밥",
        "content": "그 한 발자국 앞에 꼬챙이가 가득 박힌 구멍이 있다."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"클로어\"]   앗……!",
        "type": "dialog",
        "speaker": "클로어",
        "content": "앗……!"
