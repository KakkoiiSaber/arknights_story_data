        "type": "character",
        "name": "avg_npc_010",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"클로어\"]   아… 네?",
        "type": "dialog",
        "speaker": "클로어",
        "content": "아… 네?"
