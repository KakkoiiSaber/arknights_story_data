        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 81,
        "raw": "[name=\"그라니\"]   밥 아저씨가 우리의 발목을 잡는 일은……",
        "type": "dialog",
        "speaker": "그라니",
        "content": "밥 아저씨가 우리의 발목을 잡는 일은……"
    },
    {
        "id": 82,
        "raw": "[name=\"그라니\"]   마지막에 아저씨가 보물을 넘기려 하지 않을 때 뿐이야.",
        "type": "dialog",
        "speaker": "그라니",
        "content": "마지막에 아저씨가 보물을 넘기려 하지 않을 때 뿐이야."
