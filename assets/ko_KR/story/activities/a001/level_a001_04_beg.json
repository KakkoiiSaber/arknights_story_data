        "id": 73,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"빅 밥\"]   ……조금 말이 지나쳤군. 잊어라.",
        "type": "dialog",
        "speaker": "빅 밥",
        "content": "……조금 말이 지나쳤군. 잊어라."
    },
