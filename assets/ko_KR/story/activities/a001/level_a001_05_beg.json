        "fadetime": 0.5
    },
    {
        "id": 61,
        "raw": "[name=\"바운티 헌터\"]   이 가면 녀석들, 너희까지 방해하는 거냐!",
        "type": "dialog",
        "speaker": "바운티 헌터",
        "content": "이 가면 녀석들, 너희까지 방해하는 거냐!"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 63,
        "raw": "[name=\"리유니온 멤버\"]   오합지졸인가.",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "오합지졸인가."
    },
    {
        "id": 64,
        "raw": "[name=\"리유니온 멤버\"]   우리와 보물을 다툴 자격조차 없군.",
        "type": "dialog",
        "speaker": "리유니온 멤버",
        "content": "우리와 보물을 다툴 자격조차 없군."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 66,
        "raw": "[name=\"바운티 헌터\"]   뭐라고?! 잘도 떠드는군. 여기는 우리가 훨씬 전에 점령했어. 썩 꺼지라고!",
        "type": "dialog",
