    {
        "id": 10,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"빅 밥\"]   이제 됐어.",
        "type": "dialog",
        "speaker": "빅 밥",
