    {
        "id": 24,
        "raw": "[name=\"바운티 헌터\"]   응?",
        "type": "dialog",
        "speaker": "바운티 헌터",
        "content": "응?"
    },
    {
        "id": 25,
        "raw": "[name=\"바운티 헌터\"]   이 꼬마……",
        "type": "dialog",
        "speaker": "바운티 헌터",
        "content": "이 꼬마……"
    },
    {
        "id": 26,
        "raw": "[name=\"바운티 헌터\"]   어, 어이, 뭐야, 그 표정은……",
        "type": "dialog",
        "speaker": "바운티 헌터",
        "content": "어, 어이, 뭐야, 그 표정은……"
    },
    {
        "id": 27,
        "raw": "[name=\"바운티 헌터\"]   오, 오지 마. 벌집이 되고 싶은 거냐!",
        "type": "dialog",
        "speaker": "바운티 헌터",
