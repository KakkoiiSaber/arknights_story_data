        "id": 68,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 69,
        "raw": "[name=\"클로어\"]   저는……",
        "type": "dialog",
        "speaker": "클로어",
        "content": "저는……"
