    },
    {
        "id": 44,
        "raw": "[name=\"빅 밥\"]   놀랍군. 그 작은 몸으로… 의지가 강하구나.",
        "type": "dialog",
        "speaker": "빅 밥",
        "content": "놀랍군. 그 작은 몸으로… 의지가 강하구나."
    },
