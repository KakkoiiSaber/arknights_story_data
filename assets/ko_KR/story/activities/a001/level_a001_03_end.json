        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"빅 밥\"]   로도스 아일랜드……",
        "type": "dialog",
        "speaker": "빅 밥",
        "content": "로도스 아일랜드……"
    },
