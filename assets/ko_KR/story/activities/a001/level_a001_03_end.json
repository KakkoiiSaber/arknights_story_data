        "id": 45,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"그라니\"]   거기 앉아서 가만히 있어. 붕대를 감을 테니까.",
        "type": "dialog",
        "speaker": "그라니",
        "content": "거기 앉아서 가만히 있어. 붕대를 감을 테니까."
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"빅 밥\"]   별일 아니다. 일으켜 주겠나.",
        "type": "dialog",
        "speaker": "빅 밥",
