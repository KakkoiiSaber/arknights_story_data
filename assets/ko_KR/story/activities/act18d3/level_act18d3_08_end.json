        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 26,
        "raw": "[Subtitle(text=\"그것은 주교를 '보고' 있었다.\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "그것은 주교를 '보고' 있었다.",
        "x": "300,",
