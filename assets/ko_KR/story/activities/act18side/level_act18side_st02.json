        "name": "avg_npc_491_1#1$1"
    },
    {
        "id": 17,
        "raw": "[name=\"제멋대로인 캐스터\"]그럼 어떻게 하라고?",
        "type": "dialog",
        "speaker": "제멋대로인 캐스터",
        "content": "그럼 어떻게 하라고?"
    },
