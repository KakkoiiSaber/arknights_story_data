        "type": "character",
        "name": "avg_npc_492_1#1$1"
    },
    {
        "id": 19,
        "raw": "[name=\"주눅이 든 귀족\"]좀 더 신중해야 할 것 같습니다……",
        "type": "dialog",
        "speaker": "주눅이 든 귀족",
        "content": "좀 더 신중해야 할 것 같습니다……"
    },
