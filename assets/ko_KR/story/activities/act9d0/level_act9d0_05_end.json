        "name": "avg_npc_052"
    },
    {
        "id": 98,
        "raw": "[name=\"이네스\"]  감염자……? 무슨 용건이라도?",
        "type": "dialog",
        "speaker": "이네스",
        "content": "감염자……? 무슨 용건이라도?"
