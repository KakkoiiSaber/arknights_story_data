    {
        "id": 99,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 100,
        "raw": "[name=\"리유니온 병사\"]  말조심해, 이 마족아.",
        "type": "dialog",
        "speaker": "리유니온 병사",
        "content": "말조심해, 이 마족아."
    },
    {
        "id": 101,
        "raw": "[name=\"리유니온 병사\"]  용병단을 도망치게 둔 것도 모자라서, 적을 도시 안으로 들어오게 만들다니.",
        "type": "dialog",
        "speaker": "리유니온 병사",
        "content": "용병단을 도망치게 둔 것도 모자라서, 적을 도시 안으로 들어오게 만들다니."
    },
    {
        "id": 102,
        "raw": "[name=\"리유니온 병사\"]  실수가 너무 잦아. 설마 리더가 모를 거라 생각하지는 않겠지?",
        "type": "dialog",
        "speaker": "리유니온 병사",
        "content": "실수가 너무 잦아. 설마 리더가 모를 거라 생각하지는 않겠지?"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052"
    },
    {
        "id": 104,
        "raw": "[name=\"이네스\"]  비켜. 네 말을 듣고 있을 의무 따위는 없으니까.",
        "type": "dialog",
        "speaker": "이네스",
        "content": "비켜. 네 말을 듣고 있을 의무 따위는 없으니까."
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 106,
        "raw": "[name=\"리유니온 병사\"]  탈룰라에겐 있겠지.",
        "type": "dialog",
        "speaker": "리유니온 병사",
        "content": "탈룰라에겐 있겠지."
    },
    {
        "id": 107,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052"
    },
    {
        "id": 108,
        "raw": "[name=\"이네스\"]  ……알았어. W에게 보고한 다음, 바로 탈룰라에게 보고하러 가지.",
        "type": "dialog",
        "speaker": "이네스",
        "content": "……알았어. W에게 보고한 다음, 바로 탈룰라에게 보고하러 가지."
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 110,
        "raw": "[name=\"리유니온 병사\"]  필요 없어.",
        "type": "dialog",
        "speaker": "리유니온 병사",
        "content": "필요 없어."
    },
    {
        "id": 111,
        "raw": "[name=\"리유니온 병사\"]  우리에게 필요한 건 그런 '책임'이 아니니까.",
        "type": "dialog",
        "speaker": "리유니온 병사",
