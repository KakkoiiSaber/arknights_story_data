        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"프로방스\"]   응? 어… 나 부른 거였어?",
        "type": "dialog",
        "speaker": "프로방스",
        "content": "응? 어… 나 부른 거였어?"
