    {
        "id": 50,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=2)]",
        "type": "character",
        "name": "char_145_prove_1",
        "name2": "char_166_skfire_3#1",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"스카이파이어\"]   아까부터 좀 이상한 냄새가 나는 것 같지 않나요?",
        "type": "dialog",
        "speaker": "스카이파이어",
        "content": "아까부터 좀 이상한 냄새가 나는 것 같지 않나요?"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=1)]",
        "type": "character",
        "name": "char_145_prove_1",
        "name2": "char_166_skfire_3#1",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"프로방스\"]   그렇게 말하니까 확실히 조금…",
        "type": "dialog",
        "speaker": "프로방스",
        "content": "그렇게 말하니까 확실히 조금…"
    },
    {
        "id": 54,
        "raw": "[name=\"프로방스\"]   음, 아주 살짝 나긴 하네. 근데 확실히 나긴 해.",
        "type": "dialog",
        "speaker": "프로방스",
        "content": "음, 아주 살짝 나긴 하네. 근데 확실히 나긴 해."
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=2)]",
        "type": "character",
        "name": "char_145_prove_1",
        "name2": "char_166_skfire_3#1",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"스카이파이어\"]   화산 가스 배출량이 생각보다 훨씬 많군요… 게다가 에피한테 받은 측정기도 이미 반응하고 있고 말이죠.",
        "type": "dialog",
        "speaker": "스카이파이어",
        "content": "화산 가스 배출량이 생각보다 훨씬 많군요… 게다가 에피한테 받은 측정기도 이미 반응하고 있고 말이죠."
    },
    {
        "id": 57,
        "raw": "[name=\"스카이파이어\"]   이대로라면 제가 아무것도 안 해도, 여긴 얼마 지나지 않아 불바다가 되어버릴지도 모르겠군요.",
        "type": "dialog",
        "speaker": "스카이파이어",
        "content": "이대로라면 제가 아무것도 안 해도, 여긴 얼마 지나지 않아 불바다가 되어버릴지도 모르겠군요."
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=1)]",
        "type": "character",
        "name": "char_145_prove_1",
        "name2": "char_166_skfire_3#1",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"프로방스\"]   확실히 이 화산, 문제가 있어……",
        "type": "dialog",
        "speaker": "프로방스",
        "content": "확실히 이 화산, 문제가 있어……"
    },
    {
        "id": 60,
        "raw": "[name=\"프로방스\"]   그래도 자세한 정보는 에피한테 분석해달라 해야겠지.",
        "type": "dialog",
        "speaker": "프로방스",
        "content": "그래도 자세한 정보는 에피한테 분석해달라 해야겠지."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=2)]",
        "type": "character",
        "name": "char_145_prove_1",
        "name2": "char_166_skfire_3#1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"스카이파이어\"]   여기, 암벽에 아직 샘플이 있는 것 같습니다만.",
        "type": "dialog",
        "speaker": "스카이파이어",
        "content": "여기, 암벽에 아직 샘플이 있는 것 같습니다만."
