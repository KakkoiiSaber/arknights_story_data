    {
        "id": 47,
        "raw": "[name=\"스카이파이어\"]   왕꼬리! 부르는 거 안 들려요?",
        "type": "dialog",
        "speaker": "스카이파이어",
        "content": "왕꼬리! 부르는 거 안 들려요?"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#1\",focus=1)]",
        "type": "character",
        "name": "char_145_prove_1",
