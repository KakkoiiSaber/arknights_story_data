    {
        "id": 9,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"실론\"]     저, 전부 쓰러뜨렸어? 나는…… 지금까지…… 네가 이렇게 강한 줄은 몰랐었어.",
        "type": "dialog",
        "speaker": "실론",
        "content": "저, 전부 쓰러뜨렸어? 나는…… 지금까지…… 네가 이렇게 강한 줄은 몰랐었어."
    },
    {
        "id": 11,
        "raw": "[name=\"실론\"]     강할 거라곤 생각했지만, 그래도……",
        "type": "dialog",
        "speaker": "실론",
        "content": "강할 거라곤 생각했지만, 그래도……"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"슈바르츠\"]     그래서 아가씨께서 알게 되는 걸 원치 않았던 겁니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "그래서 아가씨께서 알게 되는 걸 원치 않았던 겁니다."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"실론\"]     정말 너무 대단해! 멋있어. 슈바르츠!",
        "type": "dialog",
        "speaker": "실론",
        "content": "정말 너무 대단해! 멋있어. 슈바르츠!"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"슈바르츠\"]     윽……",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "윽……"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"실론\"]     어떻게 그렇게 높이 뛰어오른 거야?! 벽을 뛰어 올라가다 바로 몸을 돌려서 뛰어내리다니!",
        "type": "dialog",
        "speaker": "실론",
        "content": "어떻게 그렇게 높이 뛰어오른 거야?! 벽을 뛰어 올라가다 바로 몸을 돌려서 뛰어내리다니!"
    },
    {
        "id": 20,
        "raw": "[name=\"실론\"]     공중에서 막 이렇게 이렇게 회전하면서, 총알을 전부 피해버렸잖아!",
        "type": "dialog",
        "speaker": "실론",
        "content": "공중에서 막 이렇게 이렇게 회전하면서, 총알을 전부 피해버렸잖아!"
    },
    {
        "id": 21,
        "raw": "[name=\"실론\"]     그러곤 몸을 틀어서는 파파팍! 하고 화살로 전부 쓰러트리다니…… 세상에!",
        "type": "dialog",
        "speaker": "실론",
        "content": "그러곤 몸을 틀어서는 파파팍! 하고 화살로 전부 쓰러트리다니…… 세상에!"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"슈바르츠\"]     아가씨…… 그렇게 말씀하시면, 제 얼굴이 빨개집니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨…… 그렇게 말씀하시면, 제 얼굴이 빨개집니다."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"실론\"]     하지만 슈바르츠, 하나 말을 정정해야 할 것 같아. 방금 난 네게 명령을 내린 게 아니야. 그저 친구로서, 부탁을 한 거지.",
        "type": "dialog",
        "speaker": "실론",
        "content": "하지만 슈바르츠, 하나 말을 정정해야 할 것 같아. 방금 난 네게 명령을 내린 게 아니야. 그저 친구로서, 부탁을 한 거지."
    },
    {
        "id": 26,
        "raw": "[name=\"실론\"]     너도 부탁하고 싶은 일이 있으면, 뭐든지 얘기해도 돼.",
        "type": "dialog",
        "speaker": "실론",
        "content": "너도 부탁하고 싶은 일이 있으면, 뭐든지 얘기해도 돼."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"슈바르츠\"]     알겠습니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "알겠습니다."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#1\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"실론\"]     어머, 내가 방금 우리는 뭐라고 했지?",
        "type": "dialog",
        "speaker": "실론",
        "content": "어머, 내가 방금 우리는 뭐라고 했지?"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"슈바르츠\"]     ……네?",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "……네?"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#1\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"실론\"]     그렇게 존댓말 하지 마! 우리는 친구, 친구니까!",
        "type": "dialog",
        "speaker": "실론",
        "content": "그렇게 존댓말 하지 마! 우리는 친구, 친구니까!"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"슈바르츠\"]     전…… 알았어.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "전…… 알았어."
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"실론\"]     후후, 어서 시청으로 가자. 박사 쪽 상황은 어떤지 모르니까……",
        "type": "dialog",
        "speaker": "실론",
        "content": "후후, 어서 시청으로 가자. 박사 쪽 상황은 어떤지 모르니까……"
    },
