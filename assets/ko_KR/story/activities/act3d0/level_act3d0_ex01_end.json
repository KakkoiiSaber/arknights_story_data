        "type": "character",
        "name": "avg_NPC_017_3#2"
    },
    {
        "id": 61,
        "raw": "[name=\"D.D.D.\"]   하지만 라이타니엔인은 해냈잖아.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "하지만 라이타니엔인은 해냈잖아."
