        "type": "character",
        "name": "avg_NPC_017_3#3"
    },
    {
        "id": 25,
        "raw": "[name=\"D.D.D.\"]   아… 그런 일이 있었던가…",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "아… 그런 일이 있었던가…"
