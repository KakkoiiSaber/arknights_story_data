        "type": "character",
        "name": "avg_NPC_017_3#1",
        "focus": -1
    },
    {
        "id": 45,
        "raw": "[name=\"매니저\"]   또 그런다 또!",
        "type": "dialog",
        "speaker": "매니저",
        "content": "또 그런다 또!"
    },
    {
