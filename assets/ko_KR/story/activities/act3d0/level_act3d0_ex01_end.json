        "name": "avg_NPC_017_3#6",
        "focus": -1
    },
    {
        "id": 32,
        "raw": "[name=\"매니저\"]   지금도 충분히 잘하고 있어.",
        "type": "dialog",
        "speaker": "매니저",
        "content": "지금도 충분히 잘하고 있어."
