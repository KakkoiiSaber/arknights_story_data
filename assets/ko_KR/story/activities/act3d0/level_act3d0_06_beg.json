    {
        "id": 78,
        "raw": "[name=\"실론\"]   슈바르츠……",
        "type": "dialog",
        "speaker": "실론",
        "content": "슈바르츠……"
    },
    {
        "id": 79,
        "raw": "[name=\"실론\"]   왜 나를 멀리하는 거야?",
        "type": "dialog",
        "speaker": "실론",
        "content": "왜 나를 멀리하는 거야?"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 81,
        "raw": "[name=\"슈바르츠\"]   ……",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "……"
    },
    {
        "id": 82,
        "raw": "[name=\"슈바르츠\"]   빅토리아에서 우수한 교육을 받은 아가씨께선, 저 같은 것과 함께 이 도시에서 발버둥칠 게 아니라, 더 나은 곳으로 가셔야 합니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "빅토리아에서 우수한 교육을 받은 아가씨께선, 저 같은 것과 함께 이 도시에서 발버둥칠 게 아니라, 더 나은 곳으로 가셔야 합니다."
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"실론\"]   ……아니야. 그건 절대 아니야.",
        "type": "dialog",
        "speaker": "실론",
        "content": "……아니야. 그건 절대 아니야."
    },
    {
        "id": 85,
        "raw": "[name=\"실론\"]   슈바르츠, 내 마음속의 넌 어떤 사람이었니? 너한테 난 대체 뭐였냐고!",
        "type": "dialog",
        "speaker": "실론",
        "content": "슈바르츠, 내 마음속의 넌 어떤 사람이었니? 너한테 난 대체 뭐였냐고!"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"슈바르츠\"]   전 아가씨께서 생각하시는 그런 사람이 아닙니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "전 아가씨께서 생각하시는 그런 사람이 아닙니다."
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"실론\"]   사람을 죽였기 때문에?",
        "type": "dialog",
        "speaker": "실론",
        "content": "사람을 죽였기 때문에?"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 91,
        "raw": "[name=\"슈바르츠\"]   ……",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "……"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 93,
        "raw": "[name=\"실론\"]   많은 사람을 죽였으니까?",
        "type": "dialog",
        "speaker": "실론",
        "content": "많은 사람을 죽였으니까?"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#8",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 95,
        "raw": "[name=\"슈바르츠\"]   아닙니다. 아가씨. 그만하십시오.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아닙니다. 아가씨. 그만하십시오."
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"실론\"]   어쩌면 우린 다 잘못한 걸지도 몰라, 슈바르츠.",
        "type": "dialog",
        "speaker": "실론",
        "content": "어쩌면 우린 다 잘못한 걸지도 몰라, 슈바르츠."
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"슈바르츠\"]   아가씨, 그런 이야기는…!",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨, 그런 이야기는…!"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"실론\"]   미안해.",
        "type": "dialog",
        "speaker": "실론",
        "content": "미안해."
    },
    {
        "id": 102,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 103,
        "raw": "[name=\"슈바르츠\"]   ……아가씨?",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "……아가씨?"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 105,
        "raw": "[name=\"실론\"]   너의 과거… 나, 이미 알아버렸는걸… 전부는 아닐지도 모르지만.",
        "type": "dialog",
        "speaker": "실론",
        "content": "너의 과거… 나, 이미 알아버렸는걸… 전부는 아닐지도 모르지만."
    },
    {
        "id": 106,
        "raw": "[name=\"실론\"]   내가 몰랐으면 한다고 해도, 난 이제 모른다곤 말할 수 없게 되어버렸어.",
        "type": "dialog",
        "speaker": "실론",
        "content": "내가 몰랐으면 한다고 해도, 난 이제 모른다곤 말할 수 없게 되어버렸어."
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_348_ceylon_4#9\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#9",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"슈바르츠\"]   아닙니다. 아가씨! 그런 건 전혀 몰라도 됩니다! 아가씨께서 해야 하는 건……",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아닙니다. 아가씨! 그런 건 전혀 몰라도 됩니다! 아가씨께서 해야 하는 건……"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_348_ceylon_4#3\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#3",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"실론\"]   내가 뭐! 뭘 해야 하는데? 이래라저래라 하라는 데로만 하고, 공부나 열심히 하고, 유명인사들이랑 인맥 쌓고, 그런 거 말이야?",
        "type": "dialog",
        "speaker": "실론",
        "content": "내가 뭐! 뭘 해야 하는데? 이래라저래라 하라는 데로만 하고, 공부나 열심히 하고, 유명인사들이랑 인맥 쌓고, 그런 거 말이야?"
    },
    {
        "id": 111,
        "raw": "[name=\"실론\"]   나는 온실 속 꽃 같은 게 아니야. 세상 물정 어두운 아가씨도 아니고! 내가 해야 할 일이 뭔지는 잘 알고 있다고!",
        "type": "dialog",
        "speaker": "실론",
        "content": "나는 온실 속 꽃 같은 게 아니야. 세상 물정 어두운 아가씨도 아니고! 내가 해야 할 일이 뭔지는 잘 알고 있다고!"
    },
    {
        "id": 112,
        "raw": "[name=\"실론\"]   시에스타를 지키는 건 아버지나 너만의 일이 아니야, 내가 해야 할 일이기도 하다고!",
        "type": "dialog",
        "speaker": "실론",
        "content": "시에스타를 지키는 건 아버지나 너만의 일이 아니야, 내가 해야 할 일이기도 하다고!"
    },
    {
        "id": 113,
        "raw": "[name=\"실론\"]   내가 이런 일에 휘말리지 않기를 바라는 건, 전부 나를 지키기 위해서지?",
        "type": "dialog",
        "speaker": "실론",
        "content": "내가 이런 일에 휘말리지 않기를 바라는 건, 전부 나를 지키기 위해서지?"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_348_ceylon_4#3\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#3",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"슈바르츠\"]   아닙니다…… 저는……",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아닙니다…… 저는……"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_348_ceylon_4#3\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#3",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"실론\"]   너나 아버지나 똑같아. 이렇게 날 가둬놓는 게 날 위한 거라고 생각하지. 하지만 그게 아니라고!",
        "type": "dialog",
        "speaker": "실론",
        "content": "너나 아버지나 똑같아. 이렇게 날 가둬놓는 게 날 위한 거라고 생각하지. 하지만 그게 아니라고!"
    },
    {
        "id": 118,
        "raw": "[name=\"실론\"]   바깥이 위험하니까 뭐 어쩌란 거야, 네 과거 따위 하나도 신경 안 써! 왜 이런 일들이 날 울리고 슬프게 만든다는 걸 몰라주는 거야……",
        "type": "dialog",
        "speaker": "실론",
        "content": "바깥이 위험하니까 뭐 어쩌란 거야, 네 과거 따위 하나도 신경 안 써! 왜 이런 일들이 날 울리고 슬프게 만든다는 걸 몰라주는 거야……"
    },
    {
        "id": 119,
        "raw": "[name=\"실론\"]   슈바르츠가 내 도움이 필요하다고 하면, 나는 반드시 네 곁에 있을 거야! 네가 무슨 말을 하든 다 들어줄게!",
        "type": "dialog",
        "speaker": "실론",
        "content": "슈바르츠가 내 도움이 필요하다고 하면, 나는 반드시 네 곁에 있을 거야! 네가 무슨 말을 하든 다 들어줄게!"
    },
    {
        "id": 120,
        "raw": "[name=\"실론\"]   친구란 건 그런 거잖아. 어느 한 쪽이 바치기만 하는 건 친구가 아니라고!",
        "type": "dialog",
        "speaker": "실론",
        "content": "친구란 건 그런 거잖아. 어느 한 쪽이 바치기만 하는 건 친구가 아니라고!"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 122,
        "raw": "[name=\"실론\"]   그러니까… 슈바르츠, 지금 나를 도와줄 수 있을까?",
        "type": "dialog",
        "speaker": "실론",
        "content": "그러니까… 슈바르츠, 지금 나를 도와줄 수 있을까?"
    },
    {
        "id": 123,
        "raw": "[name=\"실론\"]   아까 왜 이렇게 해야 하느냐 물었지? 이게 내 대답이야……",
        "type": "dialog",
        "speaker": "실론",
        "content": "아까 왜 이렇게 해야 하느냐 물었지? 이게 내 대답이야……"
    },
    {
        "id": 124,
        "raw": "[name=\"실론\"]   그러니까, 너도 내게 답을 주면 안 될까? 만약 과거를 다 흘려보낸다면, 다시 내 친구가 되어주면 안 될까? 어렸을 때처럼.",
        "type": "dialog",
        "speaker": "실론",
        "content": "그러니까, 너도 내게 답을 주면 안 될까? 만약 과거를 다 흘려보낸다면, 다시 내 친구가 되어주면 안 될까? 어렸을 때처럼."
    },
    {
        "id": 125,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#5\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#5",
        "focus": 2
    },
    {
        "id": 126,
        "raw": "[name=\"슈바르츠\"]   아가씨… 죄송합니다. 제 과거의 언행에 대해 사죄드리겠습니다. 제 행동이 오해를 불러일으켰습니다. 이런 일이 있어선 안 됐는데…",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨… 죄송합니다. 제 과거의 언행에 대해 사죄드리겠습니다. 제 행동이 오해를 불러일으켰습니다. 이런 일이 있어선 안 됐는데…"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#5\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#5",
        "focus": 1
    },
    {
        "id": 128,
        "raw": "[name=\"실론\"]   아……",
        "type": "dialog",
        "speaker": "실론",
        "content": "아……"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#1",
        "focus": 2
    },
    {
        "id": 130,
        "raw": "[name=\"슈바르츠\"]   아가씨께선 저의 친구입니다. 언제나요.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨께선 저의 친구입니다. 언제나요."
    },
    {
        "id": 131,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 132,
        "raw": "[name=\"크로닌의 부하\"]   ……",
        "type": "dialog",
        "speaker": "크로닌의 부하",
        "content": "……"
    },
    {
        "id": 133,
        "raw": "[name=\"크로닌의 부하\"]   아까부터 무슨 수다를 그렇게 떨고 있는 거냐, 그래서 결론은? 이젠 어떻게 되는 거지?",
        "type": "dialog",
        "speaker": "크로닌의 부하",
        "content": "아까부터 무슨 수다를 그렇게 떨고 있는 거냐, 그래서 결론은? 이젠 어떻게 되는 거지?"
    },
    {
        "id": 134,
        "raw": "[Character(name=\"char_348_ceylon_4#2\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 135,
        "raw": "[name=\"슈바르츠\"]   아가씨, 이젠 어떻게 하실 생각이십니까?",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨, 이젠 어떻게 하실 생각이십니까?"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#7",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 137,
        "raw": "[name=\"실론\"]   어? 음…… 정상적인 방법으로 재해 보고서를 발표하고 싶어.",
        "type": "dialog",
        "speaker": "실론",
        "content": "어? 음…… 정상적인 방법으로 재해 보고서를 발표하고 싶어."
    },
    {
        "id": 138,
        "raw": "[name=\"실론\"]   지금쯤이면 로도스 아일랜드가 증거들을 찾고 있으니, 곧 크로닌 씨를 시청에서 내쫓을 수 있을 거야…",
        "type": "dialog",
        "speaker": "실론",
        "content": "지금쯤이면 로도스 아일랜드가 증거들을 찾고 있으니, 곧 크로닌 씨를 시청에서 내쫓을 수 있을 거야…"
    },
    {
        "id": 139,
        "raw": "[name=\"실론\"]   하지만 화산 폭발에 대한 정보가 발표되면 옵시디언 페스티벌은 취소해야 할 수도 있어. 사람들도 다른 곳으로 대피해야 할지도 몰라. 사실은 조금, 무섭기도 해……",
        "type": "dialog",
        "speaker": "실론",
        "content": "하지만 화산 폭발에 대한 정보가 발표되면 옵시디언 페스티벌은 취소해야 할 수도 있어. 사람들도 다른 곳으로 대피해야 할지도 몰라. 사실은 조금, 무섭기도 해……"
    },
    {
        "id": 140,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#7",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 141,
        "raw": "[name=\"슈바르츠\"]   괜찮습니다. 아가씨.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "괜찮습니다. 아가씨."
    },
    {
        "id": 142,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#7",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 143,
        "raw": "[name=\"실론\"]   그, 그래?",
        "type": "dialog",
        "speaker": "실론",
        "content": "그, 그래?"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#7",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 145,
        "raw": "[name=\"슈바르츠\"]   만약 아가씨께서 그렇게 생각하신다면, 저는 아가씨를 돕겠습니다.",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "만약 아가씨께서 그렇게 생각하신다면, 저는 아가씨를 돕겠습니다."
    },
    {
        "id": 146,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 147,
        "raw": "[name=\"실론\"]   ……슈바르츠……",
        "type": "dialog",
        "speaker": "실론",
        "content": "……슈바르츠……"
    },
    {
        "id": 148,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 149,
        "raw": "[name=\"슈바르츠\"]   아가씨, 제 보호가 필요하십니까?",
        "type": "dialog",
        "speaker": "슈바르츠",
        "content": "아가씨, 제 보호가 필요하십니까?"
