        "type": "character",
        "name": "char_249_muesys_1#5",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"뮤엘시스\"]……그렇구나.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "……그렇구나."
    },
    {
        "id": 70,
        "raw": "[name=\"뮤엘시스\"]어머, 난 그냥 물어본 건데, 나한테 이렇게 다 말해줘도 괜찮겠어?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "어머, 난 그냥 물어본 건데, 나한테 이렇게 다 말해줘도 괜찮겠어?"
    },
