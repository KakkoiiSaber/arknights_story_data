        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"뮤엘시스\"]사일런스 씨, 괜찮아?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "사일런스 씨, 괜찮아?"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#3",
        "name2": "char_108_silent_1#1",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"사일런스\"]괜찮아, 사실 난 당신에게 감사해야 할 것 같아.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "괜찮아, 사실 난 당신에게 감사해야 할 것 같아."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#3",
        "name2": "char_108_silent_1#1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"뮤엘시스\"]왜?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "왜?"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#3",
        "name2": "char_108_silent_1#1",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"사일런스\"]그냥.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "그냥."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#1\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#4",
        "name2": "char_108_silent_1#1",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"뮤엘시스\"]그래…… 그럼, 계속할까?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "그래…… 그럼, 계속할까?"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"사일런스\"]둘이 방금 어디까지 얘기했어?",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "둘이 방금 어디까지 얘기했어?"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"뮤엘시스\"]앤소니 씨가 로빈 씨에게 러브콜을 보내는 부분까지.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "앤소니 씨가 로빈 씨에게 러브콜을 보내는 부분까지."
    },
    {
        "id": 29,
        "raw": "[name=\"뮤엘시스\"]앤소니 씨의 수가 고도의 심리전이라고, 굉장한 것 같다는 얘기를 메이어 씨랑 하고 있었지.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "앤소니 씨의 수가 고도의 심리전이라고, 굉장한 것 같다는 얘기를 메이어 씨랑 하고 있었지."
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#1",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"사일런스\"]넌 그냥 너무 깊게 생각하는 것 같은데……",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "넌 그냥 너무 깊게 생각하는 것 같은데……"
    },
    {
        "id": 32,
        "raw": "[name=\"사일런스\"]아마 앤소니는 당시에 그렇게 많이 생각하진 않았을 거야, 단순히 로빈에게 선의를 베푼 게 아닐까?",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "아마 앤소니는 당시에 그렇게 많이 생각하진 않았을 거야, 단순히 로빈에게 선의를 베푼 게 아닐까?"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"뮤엘시스\"]음, 그럴 가능성을 부인할 순 없겠네.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "음, 그럴 가능성을 부인할 순 없겠네."
    },
    {
        "id": 35,
        "raw": "[name=\"뮤엘시스\"]하지만 단순하고 선한 사람은 이 땅에서 살아남을 수 없다구, 사일런스 씨.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "하지만 단순하고 선한 사람은 이 땅에서 살아남을 수 없다구, 사일런스 씨."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#1",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"사일런스\"]……됐다. 애초에 이런 얘길 하는 게 아니었는데. 메이어가 어디까지 얘기했지?",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "……됐다. 애초에 이런 얘길 하는 게 아니었는데. 메이어가 어디까지 얘기했지?"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"뮤엘시스\"]카프카 씨와 논의 끝에, 앤소니 씨가 탈옥을 결정한 이야기까지.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "카프카 씨와 논의 끝에, 앤소니 씨가 탈옥을 결정한 이야기까지."
    },
    {
        "id": 40,
        "raw": "[name=\"뮤엘시스\"]의무실에서 깨어난 로빈 씨가 앤소니 씨로부터 탈옥 대열에 합류하란 제의를 받았다는 대목까지였어.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "의무실에서 깨어난 로빈 씨가 앤소니 씨로부터 탈옥 대열에 합류하란 제의를 받았다는 대목까지였어."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#5",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"뮤엘시스\"]사일런스 씨, 당신이 어디에서 앤소니 씨에 대한 단서를 얻었는지 궁금한데.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "사일런스 씨, 당신이 어디에서 앤소니 씨에 대한 단서를 얻었는지 궁금한데."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#5",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"사일런스\"]나의 선생님에게서.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "나의 선생님에게서."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#5",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"뮤엘시스\"]음? 설마 파르비스 주임님도 이번 일에 개입한 거야?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "음? 설마 파르비스 주임님도 이번 일에 개입한 거야?"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#3\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#5",
        "name2": "char_108_silent_1#3",
        "focus": 2
    },
    {
        "id": 48,
        "raw": "[name=\"사일런스\"]아니…… 그 사람과 직접 연락 안 한진 굉장히 오래되었어.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "아니…… 그 사람과 직접 연락 안 한진 굉장히 오래되었어."
    },
    {
        "id": 49,
        "raw": "[name=\"사일런스\"]그 사람도 아마 이 일에 대해선 모를 거야.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "그 사람도 아마 이 일에 대해선 모를 거야."
    },
    {
        "id": 50,
        "raw": "[name=\"사일런스\"]라인 랩을 떠난 뒤, 난 과거에는 전혀 신경 쓰지 않았던 정보를 다시 한번 정리해봤지.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "라인 랩을 떠난 뒤, 난 과거에는 전혀 신경 쓰지 않았던 정보를 다시 한번 정리해봤지."
    },
    {
        "id": 51,
        "raw": "[name=\"사일런스\"]거기에서 난 사이몬 가문과의 연관성을 찾아낸 거야.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "거기에서 난 사이몬 가문과의 연관성을 찾아낸 거야."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#4\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#3",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"뮤엘시스\"]그래?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "그래?"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#4\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4",
        "name2": "char_108_silent_1#4",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"사일런스\"]이 가문은 몰락한 시간이 매우 짧은 데다, 일부 데이터는 위장이 잘 되어 있기 때문에 많은 사람이 보기엔 데이터가 변화가 없는 것처럼 보였지.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "이 가문은 몰락한 시간이 매우 짧은 데다, 일부 데이터는 위장이 잘 되어 있기 때문에 많은 사람이 보기엔 데이터가 변화가 없는 것처럼 보였지."
    },
    {
        "id": 56,
        "raw": "[name=\"사일런스\"]하지만 아무리 위장을 해도 흔적은 남는 법이거든. 일부 보고서의 데이터는 자세히 대조해 보기만 하면 바로 문제를 발견할 수 있는 수준이었어.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "하지만 아무리 위장을 해도 흔적은 남는 법이거든. 일부 보고서의 데이터는 자세히 대조해 보기만 하면 바로 문제를 발견할 수 있는 수준이었어."
    },
    {
        "id": 57,
        "raw": "[name=\"사일런스\"]원래는 그냥 시범 삼아 해보자는 마음으로 데이터를 정리해 본 건데, 설마 그런 걸 찾게 될 줄이야.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "원래는 그냥 시범 삼아 해보자는 마음으로 데이터를 정리해 본 건데, 설마 그런 걸 찾게 될 줄이야."
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#4\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#4",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"뮤엘시스\"]우연히 발견하다니…… 아니, 사실은 필연이었을지도.",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "우연히 발견하다니…… 아니, 사실은 필연이었을지도."
    },
    {
        "id": 60,
        "raw": "[name=\"뮤엘시스\"]그런데, 왜 갑자기 그 데이터들을 정리하게 된 거야?",
        "type": "dialog",
        "speaker": "뮤엘시스",
        "content": "그런데, 왜 갑자기 그 데이터들을 정리하게 된 거야?"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#3\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4",
        "name2": "char_108_silent_1#3",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"사일런스\"]왜냐하면, 난 라인 랩을 믿지 못하기 시작했고, 내 스승님도 믿지 못했으니까.",
        "type": "dialog",
        "speaker": "사일런스",
        "content": "왜냐하면, 난 라인 랩을 믿지 못하기 시작했고, 내 스승님도 믿지 못했으니까."
    },
