    {
        "id": 37,
        "raw": "[name=\"나이 든 장인\"]  음악을 그렇게 크게 틀어놓는데 어떻게 들어!",
        "type": "dialog",
        "speaker": "나이 든 장인",
        "content": "음악을 그렇게 크게 틀어놓는데 어떻게 들어!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"나이 든 기사\"]  이이이… 이게 다 자네가 MSR의 새 CD를 들고 와서 그런 거 아닌가!",
        "type": "dialog",
        "speaker": "나이 든 기사",
