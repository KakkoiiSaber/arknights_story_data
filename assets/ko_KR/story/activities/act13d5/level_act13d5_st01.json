        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"나이 든 기사\"]  내 방향감각은 문제없거든!",
        "type": "dialog",
        "speaker": "나이 든 기사",
        "content": "내 방향감각은 문제없거든!"
    },
