        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"레인저\"]허허허…… 그럴지도 모르지.",
        "type": "dialog",
        "speaker": "레인저",
        "content": "허허허…… 그럴지도 모르지."
    },
    {
        "id": 125,
        "raw": "[name=\"레인저\"]함께 싸워서 영광이었네, 알렉산드르.",
        "type": "dialog",
        "speaker": "레인저",
        "content": "함께 싸워서 영광이었네, 알렉산드르."
