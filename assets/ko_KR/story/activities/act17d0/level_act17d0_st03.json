    {
        "id": 15,
        "raw": "[name=\"피케일\"]코언, 쾨츠, 티나, 그리고 알렉산드르. 모두 고맙다.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "코언, 쾨츠, 티나, 그리고 알렉산드르. 모두 고맙다."
    },
    {
        "id": 16,
        "raw": "[name=\"피케일\"]롱스프링 마을을…… 대신하여……",
        "type": "dialog",
        "speaker": "피케일",
        "content": "롱스프링 마을을…… 대신하여……"
    },
    {
        "id": 17,
        "raw": "[name=\"피케일\"]……미안하다, 아직 외교 용어는 익숙하지가 않아서.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "……미안하다, 아직 외교 용어는 익숙하지가 않아서."
    },
    {
        "id": 18,
        "raw": "[name=\"피케일\"]너희 덕분에 난 드러지와의 싸움에서 살아남았고, 주민들은 자신이 나고 자란 곳에서 다시 삶을 이어갈 수 있게 됐어.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "너희 덕분에 난 드러지와의 싸움에서 살아남았고, 주민들은 자신이 나고 자란 곳에서 다시 삶을 이어갈 수 있게 됐어."
    },
    {
        "id": 19,
        "raw": "[name=\"피케일\"]정말 고맙다.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "정말 고맙다."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_456_ash_1#5\")]",
        "type": "character",
        "name": "char_456_ash_1#5"
    },
    {
        "id": 21,
        "raw": "[name=\"Ash\"]해야 할 일을 한 것뿐이야.",
        "type": "dialog",
        "speaker": "Ash",
        "content": "해야 할 일을 한 것뿐이야."
    },
    {
        "id": 22,
        "raw": "[name=\"Ash\"]우리가 일으킨 일이니, 우리가 마무리해야지.",
        "type": "dialog",
        "speaker": "Ash",
        "content": "우리가 일으킨 일이니, 우리가 마무리해야지."
    },
    {
        "id": 23,
        "raw": "[character(name=\"avg_npc_159_1#1\")]",
        "type": "character",
        "name": "avg_npc_159_1#1"
    },
    {
        "id": 24,
        "raw": "[name=\"피케일\"]구제불능인 드러지만 없었더라도 이런 일은 없었을 텐데.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "구제불능인 드러지만 없었더라도 이런 일은 없었을 텐데."
    },
    {
        "id": 25,
        "raw": "[name=\"피케일\"]너희에게 보상을 해주고 싶다.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "너희에게 보상을 해주고 싶다."
    },
    {
        "id": 26,
        "raw": "[name=\"피케일\"]하지만 보다시피, 마을이 파괴됐어.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "하지만 보다시피, 마을이 파괴됐어."
    },
    {
        "id": 27,
        "raw": "[name=\"피케일\"]우리 손에 남은 것들은 가능한 한 롱스프링을 재건하는 데 쓰고 싶다.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "우리 손에 남은 것들은 가능한 한 롱스프링을 재건하는 데 쓰고 싶다."
    },
    {
        "id": 28,
        "raw": "[name=\"피케일\"]그러니…… 너희에게 현금을 제공하진 못하겠지만,",
        "type": "dialog",
        "speaker": "피케일",
        "content": "그러니…… 너희에게 현금을 제공하진 못하겠지만,"
    },
    {
        "id": 29,
        "raw": "[character(name=\"avg_npc_159_1#3\")]",
        "type": "character",
        "name": "avg_npc_159_1#3"
    },
    {
        "id": 30,
        "raw": "[name=\"피케일\"]그래도 이 저택에 있는 건 무엇이든 가져도 좋다.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "그래도 이 저택에 있는 건 무엇이든 가져도 좋다."
    },
    {
        "id": 31,
        "raw": "[name=\"피케일\"]이곳도 허물고 생존자들과 함께 새로운 롱스프링을 건설해야 할 테니까.",
        "type": "dialog",
        "speaker": "피케일",
        "content": "이곳도 허물고 생존자들과 함께 새로운 롱스프링을 건설해야 할 테니까."
    },
