    {
        "id": 35,
        "raw": "[name=\"호시구마\"]흠, 맞는 말이지.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "흠, 맞는 말이지."
    },
    {
        "id": 36,
        "raw": "[name=\"호시구마\"]게다가 무슨 일이 있었는지 모르겠지만, 저 둘 사이의 분위기도 조금 누그러진 게 확실해.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "게다가 무슨 일이 있었는지 모르겠지만, 저 둘 사이의 분위기도 조금 누그러진 게 확실해."
    },
    {
        "id": 37,
        "raw": "[character(name=\"avg_npc_203_1#1\",name2=\"avg_npc_197_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#1",
        "name2": "avg_npc_197_1#4",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"스와이어\"]이베리아 시대의 산물이라니, 어쩐지……",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "이베리아 시대의 산물이라니, 어쩐지……"
    },
    {
        "id": 39,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#4",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"호시구마\"]응? 아가씨, 경기는 안 보고 뭘 보고 있어?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "응? 아가씨, 경기는 안 보고 뭘 보고 있어?"
    },
    {
        "id": 41,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#5",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"스와이어\"]저 크루즈에 대한 정보를 찾고 있어.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "저 크루즈에 대한 정보를 찾고 있어."
    },
    {
        "id": 43,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#5",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"호시구마\"]뭐 재미있는 거라도 있어? 방금 이베리아 이야기를 한 것 같은데?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "뭐 재미있는 거라도 있어? 방금 이베리아 이야기를 한 것 같은데?"
    },
    {
        "id": 45,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"스와이어\"]응, 저 크루즈의 전신이 이베리아 시대의 유물이래.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "응, 저 크루즈의 전신이 이베리아 시대의 유물이래."
    },
    {
        "id": 47,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#5",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"호시구마\"]그렇게 오래됐다고? ……하지만 잘 생각해 보면, 이베리아 말고는 저런 걸 소유할 국가가 확실히 없긴 해.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "그렇게 오래됐다고? ……하지만 잘 생각해 보면, 이베리아 말고는 저런 걸 소유할 국가가 확실히 없긴 해."
    },
    {
        "id": 49,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#5",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"스와이어\"]맞아.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "맞아."
    },
    {
        "id": 51,
        "raw": "[name=\"스와이어\"]저 배는 칸델라 시장이 거금을 들여 이베리아에서 기술을 사와 개조한 거야.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "저 배는 칸델라 시장이 거금을 들여 이베리아에서 기술을 사와 개조한 거야."
    },
    {
        "id": 52,
        "raw": "[name=\"스와이어\"]단지 이 도시의 바다에 저 배를 띄우려고 말이야.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "단지 이 도시의 바다에 저 배를 띄우려고 말이야."
    },
    {
        "id": 53,
        "raw": "[name=\"스와이어\"]이 대륙에서 그렇게 할 수 있는 사람은 칸델라 시장 빼고 아마 더는 없을 거야.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "이 대륙에서 그렇게 할 수 있는 사람은 칸델라 시장 빼고 아마 더는 없을 거야."
    },
    {
        "id": 54,
        "raw": "[character(name=\"avg_npc_203_1#1\",name2=\"avg_npc_197_1#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_203_1#1",
        "name2": "avg_npc_197_1#5",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"호시구마\"]확실히 새로운 경지의 사치로군.",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "확실히 새로운 경지의 사치로군."
    },
    {
        "id": 56,
        "raw": "[name=\"호시구마\"]그러고 보니 아가씨, 이틀 동안 시장에 대해 알아보지 않았어? 결론은 나왔어?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "그러고 보니 아가씨, 이틀 동안 시장에 대해 알아보지 않았어? 결론은 나왔어?"
    },
    {
        "id": 57,
        "raw": "[character(name=\"avg_npc_203_1#1\",name2=\"avg_npc_197_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#1",
        "name2": "avg_npc_197_1#2",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"스와이어\"]결론은…… 사실 간단해.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "결론은…… 사실 간단해."
    },
    {
        "id": 59,
        "raw": "[name=\"스와이어\"]이 칸델라 산체스는 어떤 의미에서는 웨이 장관님과 어깨를 견줄만한 인물이야.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "이 칸델라 산체스는 어떤 의미에서는 웨이 장관님과 어깨를 견줄만한 인물이야."
    },
    {
        "id": 60,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#2",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"호시구마\"]그렇게 대단해?",
        "type": "dialog",
        "speaker": "호시구마",
        "content": "그렇게 대단해?"
    },
    {
        "id": 62,
        "raw": "[character(name=\"avg_npc_203_1#4\",name2=\"avg_npc_197_1#6\",focus=2)]",
        "type": "character",
        "name": "avg_npc_203_1#4",
        "name2": "avg_npc_197_1#6",
        "focus": 2
    },
    {
        "id": 63,
        "raw": "[name=\"스와이어\"]응. 방향은 서로 다르지만, 마음속에 자신의 도시를 품고 도시의 고삐를 꽉 쥐고 있으려는 인물들이란 건 확실해.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "응. 방향은 서로 다르지만, 마음속에 자신의 도시를 품고 도시의 고삐를 꽉 쥐고 있으려는 인물들이란 건 확실해."
    },
    {
        "id": 64,
        "raw": "[character(name=\"avg_npc_197_1#2\")]",
        "type": "character",
        "name": "avg_npc_197_1#2"
    },
    {
        "id": 65,
        "raw": "[name=\"스와이어\"]용문근위국의 일원으로서, 이런 도시를 건설한 사람을 존경한다곤 결코 못 하겠지만,",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "용문근위국의 일원으로서, 이런 도시를 건설한 사람을 존경한다곤 결코 못 하겠지만,"
    },
    {
        "id": 66,
        "raw": "[character(name=\"avg_npc_197_1#6\")]",
        "type": "character",
        "name": "avg_npc_197_1#6"
    },
    {
        "id": 67,
        "raw": "[name=\"스와이어\"]그래도 스와이어 가문의 딸로서는, 이런 도시를 건설한 사람이 정말 대단하다는 걸 인정할 수밖에 없어.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "그래도 스와이어 가문의 딸로서는, 이런 도시를 건설한 사람이 정말 대단하다는 걸 인정할 수밖에 없어."
    },
    {
        "id": 68,
        "raw": "[character(name=\"avg_npc_197_1#5\")]",
        "type": "character",
        "name": "avg_npc_197_1#5"
    },
    {
        "id": 69,
        "raw": "[name=\"스와이어\"]만약 이 도시의 근간이 보이는 것보다 더 튼튼하다면, 이 도시의 상부구조는 그보다 훨씬 더 광적이겠지.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "만약 이 도시의 근간이 보이는 것보다 더 튼튼하다면, 이 도시의 상부구조는 그보다 훨씬 더 광적이겠지."
    },
    {
        "id": 70,
        "raw": "[name=\"스와이어\"]세 정부의 사람들이 매일 이 도시로 몰려들고 있어. 뉴스에서도 가끔 그 사람들 사이에 분쟁이 있으며 심지어는 소규모 충돌이 일어난다고 보도하고 있고.",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "세 정부의 사람들이 매일 이 도시로 몰려들고 있어. 뉴스에서도 가끔 그 사람들 사이에 분쟁이 있으며 심지어는 소규모 충돌이 일어난다고 보도하고 있고."
