        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"스와이어\"]너나 궁금해하는 거겠지!",
        "type": "dialog",
        "speaker": "스와이어",
        "content": "너나 궁금해하는 거겠지!"
