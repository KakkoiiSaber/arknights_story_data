        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"유넥티스\"]  노래 잘 못하지 않았던가?",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "노래 잘 못하지 않았던가?"
