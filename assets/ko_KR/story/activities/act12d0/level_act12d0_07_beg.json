        "name2": "char_416_zumama_1#6",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"아다크리스A\"]  네가 본 그대로야. 대족장, 이렇게 하니까 됐어!",
        "type": "dialog",
        "speaker": "아다크리스A",
        "content": "네가 본 그대로야. 대족장, 이렇게 하니까 됐어!"
