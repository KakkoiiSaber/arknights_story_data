        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1#2\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_411_tomimi_1#2",
        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"가비알\"]  그래, 확실히 도움이 되더라.",
