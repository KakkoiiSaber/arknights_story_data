    {
        "id": 21,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"가비알\"]  어이, 저 사람 괜찮은 거야?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "어이, 저 사람 괜찮은 거야?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"유넥티스\"]  걱정할 필요 없어. 곧 돌아올 거야.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "걱정할 필요 없어. 곧 돌아올 거야."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"가비알\"]  그래. 근데 정말 보통 사람 맞아? 저런 사람이 있다는 얘긴 들어본 적이 없는데.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "그래. 근데 정말 보통 사람 맞아? 저런 사람이 있다는 얘긴 들어본 적이 없는데."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"유넥티스\"]  몰라. 대제사장 본인 말로는 여기서 아주 오래 살았다나봐.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "몰라. 대제사장 본인 말로는 여기서 아주 오래 살았다나봐."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"가비알\"]  그래, 그보다……",
        "type": "dialog",
        "speaker": "가비알",
        "content": "그래, 그보다……"
    },
    {
        "id": 31,
        "raw": "[name=\"가비알\"]  후, 이 큰 녀석은 정말 대단하구나.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "후, 이 큰 녀석은 정말 대단하구나."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer.png"
    },
    {
        "id": 33,
        "raw": "[name=\"블레이즈\"]  가비알, 머리에서 피가 나는데, 괜찮아?",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "가비알, 머리에서 피가 나는데, 괜찮아?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 35,
        "raw": "[name=\"가비알\"]  이 정도 상처는 괜찮아. 토미미, 내 구급상자 좀 갖다 줘.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "이 정도 상처는 괜찮아. 토미미, 내 구급상자 좀 갖다 줘."
    },
    {
        "id": 36,
        "raw": "[name=\"가비알\"]  응? 토미미는?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "응? 토미미는?"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_337_utage_summer_1\")]",
        "type": "character",
        "name": "char_337_utage_summer_1.png"
    },
    {
        "id": 38,
        "raw": "[name=\"우타게\"]  자, 구급상자는 여기. 토미미는 방금 막 이기기 직전에 다급하게 다른 곳으로 뛰어간 것 같았는데……",
        "type": "dialog",
        "speaker": "우타게",
        "content": "자, 구급상자는 여기. 토미미는 방금 막 이기기 직전에 다급하게 다른 곳으로 뛰어간 것 같았는데……"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 40,
        "raw": "[name=\"가비알\"]  고마워. 설마 겁에 질린 건 아니겠지? 아 몰라, 일단 붕대부터 감자.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "고마워. 설마 겁에 질린 건 아니겠지? 아 몰라, 일단 붕대부터 감자."
    },
    {
        "id": 41,
        "raw": "[name=\"가비알\"]  다친 동료가 있는지 가서 봐주고, 있으면 모두 데려와 줘. 내가 치료할 테니.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "다친 동료가 있는지 가서 봐주고, 있으면 모두 데려와 줘. 내가 치료할 테니."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_2013_cerber_1\")]",
        "type": "character",
        "name": "char_2013_cerber_1.png"
    },
    {
        "id": 43,
        "raw": "[name=\"케오베\"]  응, 나한테 맡겨!",
        "type": "dialog",
        "speaker": "케오베",
        "content": "응, 나한테 맡겨!"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer.png"
    },
    {
        "id": 45,
        "raw": "[name=\"블레이즈\"]  하핫, 맡겨달라고.",
        "type": "dialog",
        "speaker": "블레이즈",
        "content": "하핫, 맡겨달라고."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_337_utage_summer_1#3\")]",
        "type": "character",
        "name": "char_337_utage_summer_1#3.png"
    },
    {
        "id": 47,
        "raw": "[name=\"우타게\"]  에에… 귀찮은데.",
        "type": "dialog",
        "speaker": "우타게",
        "content": "에에… 귀찮은데."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_201_moeshd_summer\")]",
        "type": "character",
        "name": "char_201_moeshd_summer.png"
    },
    {
        "id": 49,
        "raw": "[name=\"크루아상\"]  불평하지 마라!",
        "type": "dialog",
        "speaker": "크루아상",
        "content": "불평하지 마라!"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 51,
        "raw": "[name=\"가비알\"]  박사…… 음?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "박사…… 음?"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1.png"
    },
    {
        "id": 53,
        "raw": "[name=\"유넥티스\"]  거대하고 못생긴 게……",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "거대하고 못생긴 게……"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"가비알\"]  주마마, 미안해. 부술 수밖에 없었어.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "주마마, 미안해. 부술 수밖에 없었어."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"유넥티스\"]  알아.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "알아."
    },
    {
        "id": 58,
        "raw": "[name=\"유넥티스\"]  검사해봤는데, 네 엔진은 아직 쓸 수 있더라. 돌려줄게.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "검사해봤는데, 네 엔진은 아직 쓸 수 있더라. 돌려줄게."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"가비알\"]  그래? 정말 잘 됐다!",
        "type": "dialog",
        "speaker": "가비알",
        "content": "그래? 정말 잘 됐다!"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"유넥티스\"]  가비알, 여기 남을 생각 없어?",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "가비알, 여기 남을 생각 없어?"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"가비알\"]  응, 나도 너랑 같아, 해야 할 일을 찾았지.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "응, 나도 너랑 같아, 해야 할 일을 찾았지."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"유넥티스\"]  의사?",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "의사?"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"가비알\"]  응.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "응."
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
