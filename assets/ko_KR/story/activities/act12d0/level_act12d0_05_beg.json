    {
        "id": 10,
        "raw": "[name=\"가비알\"]  박사, 정글 깊숙한 곳까지 왔어.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "박사, 정글 깊숙한 곳까지 왔어."
    },
    {
        "id": 11,
        "raw": "[name=\"가비알\"]  이제부턴 더 습해질 거야, 나무도 더욱 무성할 거고.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "이제부턴 더 습해질 거야, 나무도 더욱 무성할 거고."
    },
    {
        "id": 12,
        "raw": "[name=\"가비알\"]  걸려 넘어지지 않게 발 밑 조심해.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "걸려 넘어지지 않게 발 밑 조심해."
    },
    {
        "id": 13,
        "raw": "[name=\"가비알\"]  앞쪽에 부락이 있는 거 같은데, 잠깐 가보자.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "앞쪽에 부락이 있는 거 같은데, 잠깐 가보자."
    },
