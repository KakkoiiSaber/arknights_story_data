        "type": "character",
        "name": "avg_npc_075"
    },
    {
        "id": 38,
        "raw": "[name=\"이남\"]  와… 살아있는 외지인이네.",
        "type": "dialog",
        "speaker": "이남",
        "content": "와… 살아있는 외지인이네."
    },
    {
