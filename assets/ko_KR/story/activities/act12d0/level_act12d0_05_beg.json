    {
        "id": 21,
        "raw": "[name=\"이남\"]  후아암~ 심심한데 낮잠이나 때려볼까……",
        "type": "dialog",
        "speaker": "이남",
        "content": "후아암~ 심심한데 낮잠이나 때려볼까……"
    },
    {
