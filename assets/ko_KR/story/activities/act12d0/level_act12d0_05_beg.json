        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 23,
        "raw": "[name=\"가비알\"]  이남!",
        "type": "dialog",
        "speaker": "가비알",
        "content": "이남!"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"이남\"]  가비알? 너 제전에서 주마마한테 졌다면서, 여긴 왜 온 거야?",
        "type": "dialog",
        "speaker": "이남",
        "content": "가비알? 너 제전에서 주마마한테 졌다면서, 여긴 왜 온 거야?"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"가비알\"]  소식이 정말 빠르구나, 이남.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "소식이 정말 빠르구나, 이남."
    },
    {
        "id": 28,
        "raw": "[name=\"가비알\"]  토미미한테 들었을 땐 솔직히 안 믿었는데, 네가 진짜 족장이 될 줄이야.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "토미미한테 들었을 땐 솔직히 안 믿었는데, 네가 진짜 족장이 될 줄이야."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"이남\"]  나도 싫거든? 근데 별수 없잖아. 이 사람들이 제멋대로 날 따른다고.",
        "type": "dialog",
        "speaker": "이남",
        "content": "나도 싫거든? 근데 별수 없잖아. 이 사람들이 제멋대로 날 따른다고."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"가비알\"]  제전에는 왜 안 온 거야?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "제전에는 왜 안 온 거야?"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"가비알\"]  박사, 이 녀석이 바로 토미미가 소개했던 이남이야.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "박사, 이 녀석이 바로 토미미가 소개했던 이남이야."
    },
