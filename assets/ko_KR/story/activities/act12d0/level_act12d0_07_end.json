        "raw": "[name=\"유넥티스\"]  알았어.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "알았어."
    },
    {
        "id": 219,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 220,
        "raw": "[name=\"가비알\"]  야 잠깐, 방금 엔진 어쩌구 하지 않았어?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "야 잠깐, 방금 엔진 어쩌구 하지 않았어?"
