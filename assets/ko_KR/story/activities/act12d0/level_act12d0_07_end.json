        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 160,
        "raw": "[name=\"가비알\"]  ……",
        "type": "dialog",
        "speaker": "가비알",
        "content": "……"
    },
    {
        "id": 161,
        "raw": "[name=\"가비알\"]  그렇구나.",
        "type": "dialog",
        "speaker": "가비알",
        "content": "그렇구나."
    },
    {
        "id": 162,
        "raw": "[name=\"가비알\"]  그래, 내가 괜히 널 오해했네. 미안해, 주마마.",
        "type": "dialog",
