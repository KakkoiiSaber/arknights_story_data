        "id": 122,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 123,
        "raw": "[name=\"가비알\"]  뭐?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "뭐?"
    },
    {
        "id": 124,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 125,
        "raw": "[name=\"유넥티스\"]  광산 깊은 곳으로는 가지 말라고 수차례 당부했어.",
        "type": "dialog",
        "speaker": "유넥티스",
        "content": "광산 깊은 곳으로는 가지 말라고 수차례 당부했어."
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_187_ccheal_1#4\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#4",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 127,
        "raw": "[name=\"가비알\"]  근데 네 부하는 광석병에 감염됐잖아!",
        "type": "dialog",
        "speaker": "가비알",
        "content": "근데 네 부하는 광석병에 감염됐잖아!"
