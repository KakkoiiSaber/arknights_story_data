        "raw": "[Character(name=\"char_337_utage_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_337_utage_1.png",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"우타게\"]  와, 이런 걸로 사르곤어를 배우려면 꽤 어려울 텐데?",
        "type": "dialog",
        "speaker": "우타게",
        "content": "와, 이런 걸로 사르곤어를 배우려면 꽤 어려울 텐데?"
