        "type": "dialog",
        "speaker": "토미미",
        "content": "꺄아악!!"
    },
    {
        "id": 67,
        "raw": "[name=\"가비알\"]  토미미, 괜찮아?",
        "type": "dialog",
        "speaker": "가비알",
        "content": "토미미, 괜찮아?"
