        "focus": 1
    },
    {
        "id": 139,
        "raw": "[name=\"Ines\"]  Say what? ...I have no idea if she's just a lunatic, or if she's... Goddamnit.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "Say what? ...I have no idea if she's just a lunatic, or if she's... Goddamnit."
