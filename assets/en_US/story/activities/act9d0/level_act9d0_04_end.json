    },
    {
        "id": 78,
        "raw": "[name=\"W\"]  Ahah...",
        "type": "dialog",
        "speaker": "W",
        "content": "Ahah..."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"Ines\"]  W! What are you doing—!",
        "type": "dialog",
        "speaker": "Ines",
        "content": "W! What are you doing—!"
    },
    {
        "id": 81,
        "raw": "[name=\"Ines\"]  The wind— is so strong here!",
        "type": "dialog",
        "speaker": "Ines",
        "content": "The wind— is so strong here!"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"W\"]  I'm enjoying the Catastrophe, what else?!",
        "type": "dialog",
        "speaker": "W",
        "content": "I'm enjoying the Catastrophe, what else?!"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"Ines\"]  Are you insane—",
        "type": "dialog",
        "speaker": "Ines",
        "content": "Are you insane—"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"W\"]  What'd you say? I— can't— hear— you—",
        "type": "dialog",
        "speaker": "W",
        "content": "What'd you say? I— can't— hear— you—"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"Ines\"]  Tch... I forgot you were always a lunatic.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "Tch... I forgot you were always a lunatic."
    },
    {
        "id": 90,
        "raw": "[name=\"Ines\"]  Don't get the Sarkaz on your team killed with you!",
        "type": "dialog",
        "speaker": "Ines",
        "content": "Don't get the Sarkaz on your team killed with you!"
    },
    {
        "id": 91,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"W\"]  I already told them to evacuate with Hoederer. I'm not stupid— Hah!",
        "type": "dialog",
        "speaker": "W",
        "content": "I already told them to evacuate with Hoederer. I'm not stupid— Hah!"
    },
    {
        "id": 93,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 94,
        "raw": "[name=\"Ines\"]  W! I'm telling you, be careful! Damn it!",
        "type": "dialog",
        "speaker": "Ines",
        "content": "W! I'm telling you, be careful! Damn it!"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 96,
        "raw": "[name=\"W\"]  You're the one who should stay back. You're not gonna make it if you fall down there—",
        "type": "dialog",
        "speaker": "W",
        "content": "You're the one who should stay back. You're not gonna make it if you fall down there—"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"Ines\"]  And you think you will? If you don't want to die, get your ass back here—!",
        "type": "dialog",
        "speaker": "Ines",
        "content": "And you think you will? If you don't want to die, get your ass back here—!"
    },
