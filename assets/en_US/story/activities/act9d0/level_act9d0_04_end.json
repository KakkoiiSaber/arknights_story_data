        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"Hoederer\"]  Let's all head back and rest first, then wait for the news.",
        "type": "dialog",
        "speaker": "Hoederer",
        "content": "Let's all head back and rest first, then wait for the news."
