    {
        "id": 7,
        "raw": "What happened to Babel? Any Sarkaz in contact with Her Majesty Theresa at the time would've asked this question.",
        "type": "narration",
        "content": "What happened to Babel? Any Sarkaz in contact with Her Majesty Theresa at the time would've asked this question."
    },
    {
        "id": 8,
        "raw": "W definitely saw the truth, but she said nothing during the long journey.",
        "type": "narration",
        "content": "W definitely saw the truth, but she said nothing during the long journey."
    },
    {
        "id": 9,
        "raw": "I didn't ask, and neither did Ines. But, I think she's closer to the truth than I am.",
        "type": "narration",
        "content": "I didn't ask, and neither did Ines. But, I think she's closer to the truth than I am."
    },
    {
        "id": 10,
        "raw": "Before I knew it, I found myself trailing behind everyone else.",
        "type": "narration",
        "content": "Before I knew it, I found myself trailing behind everyone else."
