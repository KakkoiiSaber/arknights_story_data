    {
        "id": 182,
        "raw": "We have more and more fresh faces on the team, but I feel better, knowing that I left Kazdel.",
        "type": "narration",
        "content": "We have more and more fresh faces on the team, but I feel better, knowing that I left Kazdel."
    },
    {
        "id": 183,
        "raw": "Among those traveling with me are both friends and enemies, but it's always been volatile like that.",
        "type": "narration",
        "content": "Among those traveling with me are both friends and enemies, but it's always been volatile like that."
    },
    {
        "id": 184,
        "raw": "Mercenaries don't care too much about the past because for our kind, life and death are easy come, easy go.",
        "type": "narration",
        "content": "Mercenaries don't care too much about the past because for our kind, life and death are easy come, easy go."
    },
    {
        "id": 185,
        "raw": "Maybe because the war ended too quickly, we immediately plunged first into the next battle without ever tasting a moment of peace.",
        "type": "narration",
        "content": "Maybe because the war ended too quickly, we immediately plunged first into the next battle without ever tasting a moment of peace."
    },
    {
        "id": 186,
        "raw": "...This kind of hope could just be another poison. Since the beginning, we've always needed war and conflict to ease this balance.",
        "type": "narration",
