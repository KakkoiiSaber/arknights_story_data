    },
    {
        "id": 154,
        "raw": "[name=\"W\"]  Of course.",
        "type": "dialog",
        "speaker": "W",
        "content": "Of course."
    },
    {
        "id": 155,
        "raw": "[name=\"W\"]  There's some news, but you don't get to hear it until we're out of this trash heap of a country.",
        "type": "dialog",
        "speaker": "W",
        "content": "There's some news, but you don't get to hear it until we're out of this trash heap of a country."
    },
    {
