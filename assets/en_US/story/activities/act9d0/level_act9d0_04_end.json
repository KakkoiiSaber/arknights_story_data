        "focus": 1
    },
    {
        "id": 119,
        "raw": "[name=\"W\"]  What's wrong with fighting during a Catastrophe? Are you afraid of the storm? Or of Oripathy?",
        "type": "dialog",
        "speaker": "W",
        "content": "What's wrong with fighting during a Catastrophe? Are you afraid of the storm? Or of Oripathy?"
