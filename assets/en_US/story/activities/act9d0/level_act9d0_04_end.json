        "block": true
    },
    {
        "id": 66,
        "raw": "[name=\"Ines\"]  Look, the clouds are converging on the other side of the mountain, and the air pressure has changed drastically... Is that a Catastrophe cloud?",
        "type": "dialog",
        "speaker": "Ines",
        "content": "Look, the clouds are converging on the other side of the mountain, and the air pressure has changed drastically... Is that a Catastrophe cloud?"
    },
    {
        "id": 67,
        "raw": "[name=\"Hoederer\"]  ...It might not be safe to station here given the size of that thing. Notify all our forces to retreat 50 kilometers along our original route.",
        "type": "dialog",
        "speaker": "Hoederer",
        "content": "...It might not be safe to station here given the size of that thing. Notify all our forces to retreat 50 kilometers along our original route."
    },
    {
        "id": 68,
        "raw": "[name=\"Hoederer\"]  Find W, and make it quick.",
        "type": "dialog",
        "speaker": "Hoederer",
        "content": "Find W, and make it quick."
    },
    {
        "id": 69,
        "raw": "[name=\"Ines\"]  ...I don't take orders from you.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "...I don't take orders from you."
    },
    {
        "id": 70,
        "raw": "[name=\"Ines\"]  *Sigh*...",
        "type": "dialog",
        "speaker": "Ines",
        "content": "*Sigh*..."
    },
    {
        "id": 71,
        "raw": "[name=\"Ines\"]  You know, the feeling W gives off now... is just like that thing.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "You know, the feeling W gives off now... is just like that thing."
    },
