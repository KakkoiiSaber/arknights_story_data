    },
    {
        "id": 169,
        "raw": "[name=\"W\"]  The 'Rhodes Island' already left Kazdel, right?",
        "type": "dialog",
        "speaker": "W",
        "content": "The 'Rhodes Island' already left Kazdel, right?"
    },
    {
        "id": 170,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 171,
        "raw": "[name=\"Sarkaz Warrior\"]  To be specific, we don't have any reports of a landship that big getting taken in by His Ma... by Theresis's.",
        "type": "dialog",
        "speaker": "Sarkaz Warrior",
        "content": "To be specific, we don't have any reports of a landship that big getting taken in by His Ma... by Theresis's."
    },
    {
        "id": 172,
