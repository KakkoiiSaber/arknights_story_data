        "focus": 1
    },
    {
        "id": 134,
        "raw": "[name=\"Ines\"]  What? I'm not upset. It's not like we're a couple of ornery kids you have to break apart.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "What? I'm not upset. It's not like we're a couple of ornery kids you have to break apart."
    },
    {
        "id": 135,
        "raw": "[name=\"Ines\"]  I can say... that W did a good job taking care of her team.",
        "type": "dialog",
        "speaker": "Ines",
        "content": "I can say... that W did a good job taking care of her team."
    },
