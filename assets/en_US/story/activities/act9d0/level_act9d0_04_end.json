        "name": "avg_npc_046#2",
        "name2": "avg_npc_052",
        "focus": 2
    },
    {
        "id": 121,
        "raw": "[name=\"Ines\"]  I'd just rather not die an early death.",
        "type": "dialog",
        "speaker": "Ines",
