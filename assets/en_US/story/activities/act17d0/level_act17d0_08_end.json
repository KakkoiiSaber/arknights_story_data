        "focus": 1
    },
    {
        "id": 173,
        "raw": "[name=\"Stormeye\"]What about your sword, Ranger?",
        "type": "dialog",
        "speaker": "Stormeye",
        "content": "What about your sword, Ranger?"
    },
    {
        "id": 174,
        "raw": "[character(name=\"avg_npc_167\",name2=\"char_503_rang\",focus=2)]",
