    },
    {
        "id": 169,
        "raw": "[name=\"Stormeye\"]You're back in business, huh?",
        "type": "dialog",
        "speaker": "Stormeye",
        "content": "You're back in business, huh?"
    },
    {
        "id": 170,
        "raw": "[character(name=\"avg_npc_167\",name2=\"char_503_rang\",focus=2)]",
