        "name": "avg_npc_167",
        "name2": "char_503_rang",
        "focus": 2
    },
    {
        "id": 175,
        "raw": "[name=\"Rangers\"] I'm too old. I haven't been able to swing it for years.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "I'm too old. I haven't been able to swing it for years."
    },
    {
        "id": 176,
        "raw": "[name=\"Rangers\"]If it weren't for you, today would be the end of these old bones.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "If it weren't for you, today would be the end of these old bones."
    },
