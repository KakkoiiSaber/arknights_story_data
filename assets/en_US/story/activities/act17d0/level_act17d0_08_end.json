    {
        "id": 108,
        "raw": "[name=\"Rangers\"]What are you doing?",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "What are you doing?"
    },
    {
        "id": 109,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
