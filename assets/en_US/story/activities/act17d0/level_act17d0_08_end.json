        "name2": "char_503_rang",
        "focus": 1
    },
    {
        "id": 178,
        "raw": "[name=\"Stormeye\"]You sell yourself short, Old Ranger.",
        "type": "dialog",
        "speaker": "Stormeye",
        "content": "You sell yourself short, Old Ranger."
    },
    {
        "id": 179,
        "raw": "[name=\"Stormeye\"]Listen up, squad. The objective is the Lord's manor.",
        "type": "dialog",
        "speaker": "Stormeye",
        "content": "Listen up, squad. The objective is the Lord's manor."
    },
    {
        "id": 180,
        "raw": "[name=\"Stormeye\"]The enemy is an extremely dangerous form of Originium organism.",
