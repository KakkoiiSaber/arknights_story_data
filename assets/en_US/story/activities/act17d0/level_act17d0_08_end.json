        "name": "avg_npc_167",
        "name2": "char_503_rang",
        "focus": 2
    },
    {
        "id": 171,
        "raw": "[name=\"Rangers\"]Haha, at my age? You're making fun.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "Haha, at my age? You're making fun."
    },
    {
        "id": 172,
