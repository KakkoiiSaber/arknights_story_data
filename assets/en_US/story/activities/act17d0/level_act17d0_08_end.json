        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"Tachanka\"]Making a shield. I always wanted to try, actually.",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "Making a shield. I always wanted to try, actually."
    },
    {
        "id": 111,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=1)]",
        "type": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"Rangers\"]Hahaha...",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "Hahaha..."
    },
    {
        "id": 113,
        "raw": "[character(name=\"char_503_rang\")]",
        "type": "character",
        "name": "char_503_rang"
    },
    {
        "id": 114,
        "raw": "[name=\"Rangers\"]What a trip down memory lane. Back to the glorious good old days.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "What a trip down memory lane. Back to the glorious good old days."
    },
    {
        "id": 115,
        "raw": "[name=\"Rangers\"]The young rangers all gathered at the edge of town.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "The young rangers all gathered at the edge of town."
    },
    {
        "id": 116,
        "raw": "[name=\"Rangers\"]Knowing the overwhelming odds stacked against them, knowing most would spill their blood in the wasteland after the war.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "Knowing the overwhelming odds stacked against them, knowing most would spill their blood in the wasteland after the war."
    },
    {
        "id": 117,
        "raw": "[name=\"Rangers\"]But they laughed and sang war songs, as if they were facing down bugs to be easily squashed.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "But they laughed and sang war songs, as if they were facing down bugs to be easily squashed."
    },
    {
        "id": 118,
        "raw": "[name=\"Rangers\"]War is cruel, and merciless. Some backed down. Many more held the line.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "War is cruel, and merciless. Some backed down. Many more held the line."
    },
    {
        "id": 119,
        "raw": "[name=\"Rangers\"]The fallen became legends. The survivors were tasked with remembering them.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "The fallen became legends. The survivors were tasked with remembering them."
    },
    {
        "id": 120,
        "raw": "[name=\"Rangers\"]And the last one standing in that bloodbath, after all that time, started to feel the fear of death set in.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "And the last one standing in that bloodbath, after all that time, started to feel the fear of death set in."
    },
    {
        "id": 121,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
        "type": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"Tachanka\"]Because he doesn't want the dead to be forgotten?",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "Because he doesn't want the dead to be forgotten?"
    },
    {
        "id": 123,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=1)]",
        "type": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"Rangers\"]Hahaha... maybe that's why.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "Hahaha... maybe that's why."
    },
    {
        "id": 125,
        "raw": "[name=\"Rangers\"]It's been an honor to fight alongside you, Alexsandr.",
        "type": "dialog",
        "speaker": "Rangers",
        "content": "It's been an honor to fight alongside you, Alexsandr."
    },
    {
        "id": 126,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
        "type": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "id": 127,
        "raw": "[name=\"Tachanka\"]The honor is mine, Rangers.",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "The honor is mine, Rangers."
    },
    {
        "id": 128,
        "raw": "[name=\"Tachanka\"]But don't be so gloomy. I haven't given up the fight.",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "But don't be so gloomy. I haven't given up the fight."
    },
    {
        "id": 129,
        "raw": "[name=\"Tachanka\"]I'll smash a few to death.",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "I'll smash a few to death."
