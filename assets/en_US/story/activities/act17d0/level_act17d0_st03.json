    {
        "id": 15,
        "raw": "[name=\"Picale\"]Thank you for all you've done, Cohen, Kötz, Tina, Alexsandr.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "Thank you for all you've done, Cohen, Kötz, Tina, Alexsandr."
    },
    {
        "id": 16,
        "raw": "[name=\"Picale\"]On behalf of... The town of Long Spring...",
        "type": "dialog",
        "speaker": "Picale",
        "content": "On behalf of... The town of Long Spring..."
    },
    {
        "id": 17,
        "raw": "[name=\"Picale\"]Sorry, I'm not so good with this kind of formal language.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "Sorry, I'm not so good with this kind of formal language."
    },
    {
        "id": 18,
        "raw": "[name=\"Picale\"]Thanks to you, I survived the conflict with my brother, and my people were able to return to live on their land.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "Thanks to you, I survived the conflict with my brother, and my people were able to return to live on their land."
    },
    {
        "id": 19,
        "raw": "[name=\"Picale\"]Thank you.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "Thank you."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_456_ash_1#5\")]",
        "type": "character",
        "name": "char_456_ash_1#5.png"
    },
    {
        "id": 21,
        "raw": "[name=\"Ash\"]We were only doing what had to be done.",
        "type": "dialog",
        "speaker": "Ash",
        "content": "We were only doing what had to be done."
    },
    {
        "id": 22,
        "raw": "[name=\"Ash\"]We started this, so it's our responsibility to end it.",
        "type": "dialog",
        "speaker": "Ash",
        "content": "We started this, so it's our responsibility to end it."
    },
    {
        "id": 23,
        "raw": "[character(name=\"avg_npc_159_1#1\")]",
        "type": "character",
        "name": "avg_npc_159_1#1.png"
    },
    {
        "id": 24,
        "raw": "[name=\"Picale\"]If it weren't for my irredeemable brother, none of this would've happened.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "If it weren't for my irredeemable brother, none of this would've happened."
    },
    {
        "id": 25,
        "raw": "[name=\"Picale\"]I would have liked to offer you a reward.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "I would have liked to offer you a reward."
    },
    {
        "id": 26,
        "raw": "[name=\"Picale\"]But, as you can see, our town has been destroyed.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "But, as you can see, our town has been destroyed."
    },
    {
        "id": 27,
        "raw": "[name=\"Picale\"]Anything we have left, I want used to rebuild Long Spring.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "Anything we have left, I want used to rebuild Long Spring."
    },
    {
        "id": 28,
        "raw": "[name=\"Picale\"]A cash reward... is beyond my power to give you.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "A cash reward... is beyond my power to give you."
    },
    {
        "id": 29,
        "raw": "[character(name=\"avg_npc_159_1#3\")]",
        "type": "character",
        "name": "avg_npc_159_1#3.png"
    },
    {
        "id": 30,
        "raw": "[name=\"Picale\"]But anything you may want from this home is yours to take.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "But anything you may want from this home is yours to take."
    },
    {
        "id": 31,
        "raw": "[name=\"Picale\"]I think we will have to tear it all down and build a new Long Spring with the survivors.",
        "type": "dialog",
        "speaker": "Picale",
        "content": "I think we will have to tear it all down and build a new Long Spring with the survivors."
    },
