        "type": "charslot"
    },
    {
        "id": 19,
        "raw": "Theresa does not look at the one frozen in place before her. She gently pats the back of the child in her arms and leaves a kiss on her puerile cheek.",
        "type": "narration",
        "content": "Theresa does not look at the one frozen in place before her. She gently pats the back of the child in her arms and leaves a kiss on her puerile cheek."
    },
    {
