    {
        "id": 105,
        "raw": "This face is both familiar and strange. Theresa knows its features well.",
        "type": "narration",
        "content": "This face is both familiar and strange. Theresa knows its features well."
    },
    {
        "id": 106,
        "raw": "She never had a chance to directly perceive the emotions on it until now.",
        "type": "narration",
        "content": "She never had a chance to directly perceive the emotions on it until now."
    },
    {
        "id": 107,
        "raw": "She smiles and stretches out her finger, snipping the scene before her into two, as if it were made of cloth.",
        "type": "narration",
        "content": "She smiles and stretches out her finger, snipping the scene before her into two, as if it were made of cloth."
    },
    {
        "id": 108,
        "raw": "Then, she slowly pulls out a loose thread from the rift, and the remnants unravel as the Doctor's memories dissipate.",
        "type": "narration",
        "content": "Then, she slowly pulls out a loose thread from the rift, and the remnants unravel as the Doctor's memories dissipate."
