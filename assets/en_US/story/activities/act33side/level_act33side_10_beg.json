        "duration": "1,",
        "isblock": true
    },
    {
        "id": 77,
        "raw": "[name=\"Theresa\"]You're crying, Doctor...",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You're crying, Doctor..."
    },
    {
        "id": 78,
        "raw": "[name=\"Theresa\"]Well, that's the kind of person you are. You know your own fragility, you know how much of a threat I pose to you even at a time like this... and yet... you still came here.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "Well, that's the kind of person you are. You know your own fragility, you know how much of a threat I pose to you even at a time like this... and yet... you still came here."
    },
    {
        "id": 79,
        "raw": "[name=\"Theresa\"]So, I still... am willing to believe in you.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "So, I still... am willing to believe in you."
    },
    {
        "id": 80,
        "raw": "[name=\"Theresa\"]To trust in who you really are.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "To trust in who you really are."
    },
    {
        "id": 81,
        "raw": "[name=\"Theresa\"]To trust in our {@nickname} who brings the rain, dew, and sun.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "To trust in our {@nickname} who brings the rain, dew, and sun."
    },
