        "id": 67,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 68,
        "raw": "[name=\"Doctor\"]...What?",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "...What?"
