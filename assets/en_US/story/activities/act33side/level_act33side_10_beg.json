    {
        "id": 16,
        "raw": "[name=\"Theresa\"]It's alright, Amiya. Everything's fine...",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "It's alright, Amiya. Everything's fine..."
    },
    {
        "id": 17,
        "raw": "[name=\"Theresa\"]It's over.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "It's over."
    },
