    {
        "id": 116,
        "raw": "Theresa goes in deeper, without looking back, until every memory is taken apart into a mess of disconnected white threads.",
        "type": "narration",
        "content": "Theresa goes in deeper, without looking back, until every memory is taken apart into a mess of disconnected white threads."
    },
    {
        "id": 117,
        "raw": "Like the very night, a long time ago, when she was still young, teaching herself to sew with Theresis by her side.",
        "type": "narration",
        "content": "Like the very night, a long time ago, when she was still young, teaching herself to sew with Theresis by her side."
    },
    {
        "id": 118,
        "raw": "The memories disintegrate until a mere fragment of the soul remains.",
        "type": "narration",
        "content": "The memories disintegrate until a mere fragment of the soul remains."
    },
    {
        "id": 119,
        "raw": "A silhouette stands at the end of that memory. Theresa thinks the figure both familiar and strange.",
        "type": "narration",
        "content": "A silhouette stands at the end of that memory. Theresa thinks the figure both familiar and strange."
