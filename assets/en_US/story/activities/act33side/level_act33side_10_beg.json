        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 21,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\", duration=1.5, isblock=true)]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png",
        "duration": "1.5,",
        "isblock": true
    },
    {
        "id": 22,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 23,
        "raw": "[name=\"Doctor\"]......",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "......"
    },
    {
        "id": 24,
        "raw": "[name=\"Doctor\"]Theresa. I can't throw away this opportunity I spent millions of lives and myriads of years to reach.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "Theresa. I can't throw away this opportunity I spent millions of lives and myriads of years to reach."
    },
    {
        "id": 25,
        "raw": "[name=\"Doctor\"]I can't let you ruin the plan for Originium. I can't... let you turn this great land into a beautiful but fleeting dream.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "I can't let you ruin the plan for Originium. I can't... let you turn this great land into a beautiful but fleeting dream."
    },
    {
        "id": 26,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#4$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#4$1.png"
    },
    {
        "id": 27,
        "raw": "[name=\"Theresa\"]And that's why you put Amiya in harm's way.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "And that's why you put Amiya in harm's way."
    },
    {
        "id": 28,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 29,
        "raw": "[name=\"Doctor\"]......",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "......"
    },
    {
        "id": 30,
        "raw": "[name=\"Doctor\"]...Seeing as the King of Sarkaz has already seen my memories, I believe there's no need for any further explanation.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "...Seeing as the King of Sarkaz has already seen my memories, I believe there's no need for any further explanation."
    },
    {
        "id": 31,
        "raw": "[name=\"Doctor\"]Do you hate me?",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "Do you hate me?"
    },
    {
        "id": 32,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#4$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#4$1.png"
    },
    {
        "id": 33,
        "raw": "[name=\"Theresa\"]You hurt Amiya. You're about to hurt Kal'tsit, and the fighters who trust you so deeply.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You hurt Amiya. You're about to hurt Kal'tsit, and the fighters who trust you so deeply."
    },
    {
        "id": 34,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#5$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#5$1.png"
    },
    {
        "id": 35,
        "raw": "[name=\"Theresa\"]Is this how you treat those lives?",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "Is this how you treat those lives?"
    },
    {
        "id": 36,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 37,
        "raw": "[name=\"Doctor\"]I'll do what I can to ensure their safety in the ensuing conflict. This is what Theresis swore to me as well.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "I'll do what I can to ensure their safety in the ensuing conflict. This is what Theresis swore to me as well."
    },
    {
        "id": 38,
        "raw": "[name=\"Doctor\"]We only... need you to die.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "We only... need you to die."
    },
    {
        "id": 39,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#1$1.png"
    },
    {
        "id": 40,
        "raw": "[name=\"Theresa\"]Doctor... did you present yourself before me out of guilt?",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "Doctor... did you present yourself before me out of guilt?"
    },
    {
        "id": 41,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 42,
        "raw": "[name=\"Doctor\"]Guilt... is too light of a word, compared to everything I've done.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "Guilt... is too light of a word, compared to everything I've done."
    },
    {
        "id": 43,
        "raw": "[name=\"Doctor\"]We made too many choices in a time that even Kal'tsit isn't familiar with.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "We made too many choices in a time that even Kal'tsit isn't familiar with."
    },
    {
        "id": 44,
        "raw": "[name=\"Doctor\"]I just...",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "I just..."
    },
    {
        "id": 45,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#10$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#10$1.png"
    },
    {
        "id": 46,
        "raw": "[name=\"Theresa\"]When Amiya grows up, if she remembers me, if she asks about me, will you tell her the truth... of how I left her?",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "When Amiya grows up, if she remembers me, if she asks about me, will you tell her the truth... of how I left her?"
    },
    {
        "id": 47,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 48,
        "raw": "[name=\"Doctor\"]No.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "No."
    },
    {
        "id": 49,
        "raw": "[name=\"Doctor\"]I'll help them search for another way to live.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "I'll help them search for another way to live."
    },
    {
        "id": 50,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#10$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#10$1.png"
    },
    {
        "id": 51,
        "raw": "[name=\"Theresa\"]You'll help them search for a final moment of peace before Originium destroys Terra?",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You'll help them search for a final moment of peace before Originium destroys Terra?"
    },
    {
        "id": 52,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 53,
        "raw": "[name=\"Doctor\"]I'm sorry... That's the one thing that's set in stone.",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "I'm sorry... That's the one thing that's set in stone."
    },
    {
        "id": 54,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#1$1.png"
    },
    {
        "id": 55,
        "raw": "[name=\"Theresa\"]You know it's futile... and yet you still wish to cure Amiya's sickness.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You know it's futile... and yet you still wish to cure Amiya's sickness."
    },
    {
        "id": 56,
        "raw": "[name=\"Theresa\"]Even if her family and homeland will all turn into the same hunks of Originium in the not-too-distant future, along with anyone and anything you'll ever know...",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "Even if her family and homeland will all turn into the same hunks of Originium in the not-too-distant future, along with anyone and anything you'll ever know..."
    },
    {
        "id": 57,
        "raw": "[name=\"Theresa\"]You still don't want the girl before your eyes to suffer.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You still don't want the girl before your eyes to suffer."
    },
    {
        "id": 58,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#8$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#8$1.png"
    },
    {
        "id": 59,
        "raw": "[name=\"Theresa\"]That's what you sincerely feel. Your purest thoughts. Your innate nature.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "That's what you sincerely feel. Your purest thoughts. Your innate nature."
    },
    {
        "id": 60,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 61,
        "raw": "[name=\"Doctor\"]......",
        "type": "dialog",
        "speaker": "Doctor",
        "content": "......"
    },
    {
        "id": 62,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#9$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#9$1.png"
    },
    {
        "id": 63,
        "raw": "[name=\"Theresa\"]And actually... I'm glad, Doctor.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "And actually... I'm glad, Doctor."
    },
    {
        "id": 64,
        "raw": "[name=\"Theresa\"]I'm glad you're real and true—the one who Kal'tsit willingly trusts, and in turn trusts us.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "I'm glad you're real and true—the one who Kal'tsit willingly trusts, and in turn trusts us."
    },
    {
        "id": 65,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#8$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#8$1.png"
    },
    {
        "id": 66,
        "raw": "[name=\"Theresa\"]You... the creator of Originium... {@nickname}. You are the poison that ruins everything, but also the antidote to it all.",
        "type": "dialog",
        "speaker": "Theresa",
        "content": "You... the creator of Originium... {@nickname}. You are the poison that ruins everything, but also the antidote to it all."
    },
