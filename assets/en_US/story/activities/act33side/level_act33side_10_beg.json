    {
        "id": 72,
        "raw": "Theresa strains to stand up, stretching her arms towards the Doctor, instilling in the latter an instinctive urge to retreat.",
        "type": "narration",
        "content": "Theresa strains to stand up, stretching her arms towards the Doctor, instilling in the latter an instinctive urge to retreat."
    },
    {
        "id": 73,
        "raw": "The Doctor tries to move, but fails. Sorrow far surpasses the collapsing rationality at this moment.",
        "type": "narration",
        "content": "The Doctor tries to move, but fails. Sorrow far surpasses the collapsing rationality at this moment."
    },
    {
        "id": 74,
        "raw": "Theresa touches the face beneath the mask.",
