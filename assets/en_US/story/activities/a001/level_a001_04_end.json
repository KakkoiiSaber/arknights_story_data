        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"Carol\"]   I'm fine... But, Mister Bob... what about him...?!",
        "type": "dialog",
        "speaker": "Carol",
        "content": "I'm fine... But, Mister Bob... what about him...?!"
    },
