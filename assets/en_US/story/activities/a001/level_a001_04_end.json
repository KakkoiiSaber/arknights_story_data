    {
        "id": 67,
        "raw": "[name=\"Grani\"]   ...The sounds of fighting are quieting down.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "...The sounds of fighting are quieting down."
    },
    {
        "id": 68,
        "raw": "[name=\"Grani\"]   But we can't afford to rest yet, Carol. Sorry...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "But we can't afford to rest yet, Carol. Sorry..."
    },
    {
        "id": 69,
