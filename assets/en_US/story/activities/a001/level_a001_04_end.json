        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"Grani\"]   He might need some time.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "He might need some time."
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#4\",focus=1)]",
