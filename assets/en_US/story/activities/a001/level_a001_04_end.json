        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"Grani\"]   We can only get in through the cave entrance?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "We can only get in through the cave entrance?"
    },
    {
