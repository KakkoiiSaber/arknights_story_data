    {
        "id": 13,
        "raw": "[name=\"Grani\"]   We're in the clear!",
        "type": "dialog",
        "speaker": "Grani",
        "content": "We're in the clear!"
    },
    {
        "id": 14,
        "raw": "[name=\"Grani\"]   You okay, Big Bob—",
        "type": "dialog",
        "speaker": "Grani",
        "content": "You okay, Big Bob—"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_220_grani#4\")]",
        "type": "character",
        "name": "char_220_grani#4"
    },
    {
        "id": 16,
        "raw": "[name=\"Grani\"]   Huh? That wound on your leg...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Huh? That wound on your leg..."
    },
    {
        "id": 17,
        "raw": "[Character(name=\"avg_npc_008\")]",
        "type": "character",
        "name": "avg_npc_008"
    },
    {
        "id": 18,
        "raw": "[name=\"Bounty Hunter\"]   There are some stragglers over there! They're probably from the Valk Vanguards!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "There are some stragglers over there! They're probably from the Valk Vanguards!"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010"
    },
    {
        "id": 20,
        "raw": "[name=\"Big Bob\"]   I can handle this on my own! Go after the ones who are fleeing!",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "I can handle this on my own! Go after the ones who are fleeing!"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_220_grani#5\")]",
        "type": "character",
        "name": "char_220_grani#5"
    },
    {
        "id": 22,
        "raw": "[name=\"Grani\"]   Sure.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Sure."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 24,
        "raw": "[name=\"Bounty Hunter\"]   Hmm?",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Hmm?"
    },
    {
        "id": 25,
        "raw": "[name=\"Bounty Hunter\"]   This kid...",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "This kid..."
    },
    {
        "id": 26,
        "raw": "[name=\"Bounty Hunter\"]   Hey, hey, why are you giving me that look?",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Hey, hey, why are you giving me that look?"
    },
    {
        "id": 27,
        "raw": "[name=\"Bounty Hunter\"]   G-get away from me or I'll put a hole through you!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "G-get away from me or I'll put a hole through you!"
    },
    {
        "id": 28,
        "raw": "[name=\"Bounty Hunter\"]   Huh?",
        "type": "dialog",
