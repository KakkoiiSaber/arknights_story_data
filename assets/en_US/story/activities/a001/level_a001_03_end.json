    {
        "id": 40,
        "raw": "[name=\"Big Bob\"]   You took care of them all?",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "You took care of them all?"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"Grani\"]   That's right.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "That's right."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Big Bob\"]   Impressive. This kid's got talent.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "Impressive. This kid's got talent."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"Grani\"]   Stay there and don't move. I'll patch you up.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Stay there and don't move. I'll patch you up."
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"Big Bob\"]   It's fine, I can take care of myself.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "It's fine, I can take care of myself."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"Grani\"]   No means no.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "No means no."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Big Bob\"]   You saw it, right?",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "You saw it, right?"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Grani\"]   Mhm.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Mhm."
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=30, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 57,
        "raw": "[name=\"Big Bob\"]   You saw the crystalization on my body, right? Are you trying to get yourself infected?!",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "You saw the crystalization on my body, right? Are you trying to get yourself infected?!"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"Grani\"]   Our mission at Rhodes Island is to help all the Infected.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Our mission at Rhodes Island is to help all the Infected."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"Big Bob\"]   Rhodes Island...",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "Rhodes Island..."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_220_grani#4\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_220_grani#4",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 63,
        "raw": "[name=\"Carol\"]   Rhodes Island? Aren't you from Victoria...?",
        "type": "dialog",
        "speaker": "Carol",
        "content": "Rhodes Island? Aren't you from Victoria...?"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_220_grani#3\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_220_grani#3",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 65,
        "raw": "[name=\"Grani\"]   Former Victoria Mounted Police. Now, I'm a Rhodes Island operator!",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Former Victoria Mounted Police. Now, I'm a Rhodes Island operator!"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010"
    },
    {
        "id": 67,
        "raw": "[name=\"Big Bob\"]   Stay back, lass. I'm an Infected.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "Stay back, lass. I'm an Infected."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 69,
        "raw": "[name=\"Carol\"]   I...",
        "type": "dialog",
        "speaker": "Carol",
        "content": "I..."
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"Grani\"]   Miss Carol, this might get a bit messy. You should step back a bit.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Miss Carol, this might get a bit messy. You should step back a bit."
