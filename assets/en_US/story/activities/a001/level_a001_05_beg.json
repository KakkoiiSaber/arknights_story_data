    {
        "id": 82,
        "raw": "[name=\"Grani\"]   (From this angle, I can see the fighting... It seems that the bounty hunters have gotten into a brawl with Reunion.)",
        "type": "dialog",
        "speaker": "Grani",
        "content": "(From this angle, I can see the fighting... It seems that the bounty hunters have gotten into a brawl with Reunion.)"
    },
    {
        "id": 83,
        "raw": "[name=\"Grani\"]   (No matter who approaches this cave, I'll make sure I...)",
        "type": "dialog",
        "speaker": "Grani",
        "content": "(No matter who approaches this cave, I'll make sure I...)"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 85,
        "raw": "[name=\"Bounty Hunter\"]   Let's make a run for the cave while those imbeciles duke it out!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Let's make a run for the cave while those imbeciles duke it out!"
    },
    {
        "id": 86,
        "raw": "[name=\"Bounty Hunter\"]   Wait, what's that kid doing there?!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Wait, what's that kid doing there?!"
    },
