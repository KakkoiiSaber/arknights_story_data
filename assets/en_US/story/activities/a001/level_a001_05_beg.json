    {
        "id": 61,
        "raw": "[name=\"Bounty Hunter\"]   Those damn whitemasks... Why do they always show up at the worst times?!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Those damn whitemasks... Why do they always show up at the worst times?!"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 63,
        "raw": "[name=\"Reunion Member\"]   Worthless scum, all of you.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Worthless scum, all of you."
    },
    {
        "id": 64,
        "raw": "[name=\"Reunion Member\"]   You don't even have the right to challenge us for the treasure.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "You don't even have the right to challenge us for the treasure."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 66,
        "raw": "[name=\"Bounty Hunter\"]   Haaah? What are you talking about? This has long been our turn, so you'd better get lost, or else!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Haaah? What are you talking about? This has long been our turn, so you'd better get lost, or else!"
