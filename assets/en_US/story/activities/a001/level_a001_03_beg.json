        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"Grani\"]   ...Oh...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "...Oh..."
    },
    {
        "id": 77,
        "raw": "[name=\"Grani\"]   Is this what I think it is...",
