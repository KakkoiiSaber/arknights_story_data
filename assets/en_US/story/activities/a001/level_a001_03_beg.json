        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"Grani\"]   Is it a trap?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Is it a trap?"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"Big Bob\"]   No...",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "No..."
    },
    {
        "id": 72,
        "raw": "[name=\"Big Bob\"]   A symbol drawn with blood...",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "A symbol drawn with blood..."
    },
    {
        "id": 73,
        "raw": "[name=\"Big Bob\"]   '...Monster?'",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "'...Monster?'"
    },
    {
        "id": 74,
        "raw": "[name=\"Big Bob\"]   What's the meaning of this? In all my years, I've never seen a symbol like this.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "What's the meaning of this? In all my years, I've never seen a symbol like this."
    },
    {
