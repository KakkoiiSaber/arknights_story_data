        "type": "character"
    },
    {
        "id": 12,
        "raw": "[name=\"Bounty Hunter\"]   ...S-stay away from me! I'm begging you!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "...S-stay away from me! I'm begging you!"
    },
    {
        "id": 13,
        "raw": "[name=\"Bounty Hunter\"]   I, I'll give you all my coins! My weapons! Anything you want...",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "I, I'll give you all my coins! My weapons! Anything you want..."
    },
    {
        "id": 14,
        "raw": "[name=\"???\"]    Where's the girl?",
        "type": "dialog",
        "speaker": "???",
        "content": "Where's the girl?"
    },
    {
        "id": 15,
        "raw": "[name=\"Bounty Hunter\"]   What are you talking about...?",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "What are you talking about...?"
    },
    {
        "id": 16,
        "raw": "[name=\"Bounty Hunter\"]   Don't come any closer...!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Don't come any closer...!"
    },
    {
        "id": 17,
        "raw": "[name=\"Bounty Hunter\"]   You monster—!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "You monster—!"
