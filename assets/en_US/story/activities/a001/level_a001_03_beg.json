        "content": "Ngh..."
    },
    {
        "id": 8,
        "raw": "[name=\"Bounty Hunter\"]   You... you took out all my buddies?",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "You... you took out all my buddies?"
    },
    {
        "id": 9,
        "raw": "[Delay=1]",
        "type": "delay",
        "time": 1.0
    },
    {
        "id": 10,
