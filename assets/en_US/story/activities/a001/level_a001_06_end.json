        "type": "character",
        "name": "char_220_grani#3"
    },
    {
        "id": 170,
        "raw": "[name=\"Grani\"]   Don't mention it!",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Don't mention it!"
    },
    {
        "id": 171,
        "raw": "[Character(name=\"char_263_skadi#2\")]",
        "type": "character",
        "name": "char_263_skadi#2"
    },
    {
        "id": 172,
        "raw": "[name=\"Skadi\"]   If we're all done here, then I'm going home.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "If we're all done here, then I'm going home."
    },
