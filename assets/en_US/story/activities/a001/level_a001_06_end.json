    },
    {
        "id": 197,
        "raw": "(Letter from Big Bob)",
        "type": "narration",
        "content": "(Letter from Big Bob)"
    },
    {
        "id": 198,
        "raw": "Good day.",
        "type": "narration",
        "content": "Good day."
    },
    {
        "id": 199,
        "raw": "Bob here.",
        "type": "narration",
        "content": "Bob here."
    },
    {
        "id": 200,
        "raw": "I'm writing this letter to you from a manor in the outskirts of Columbia.",
        "type": "narration",
        "content": "I'm writing this letter to you from a manor in the outskirts of Columbia."
    },
    {
        "id": 201,
        "raw": "We've all been doing well. Even though some problems never go away as the Infected, just being able to live with the sun shining upon our faces is more joy than we could ever have imagined.",
        "type": "narration",
        "content": "We've all been doing well. Even though some problems never go away as the Infected, just being able to live with the sun shining upon our faces is more joy than we could ever have imagined."
    },
    {
        "id": 202,
        "raw": "Thanks to the kindness of Grani and a little girl named Carol, who decided to leave us with the remainder of the treasure after repairing their village, I was able to settle down peacefully with my brothers.",
        "type": "narration",
        "content": "Thanks to the kindness of Grani and a little girl named Carol, who decided to leave us with the remainder of the treasure after repairing their village, I was able to settle down peacefully with my brothers."
    },
    {
        "id": 203,
        "raw": "We already have everything we need to be self sufficient, and we're even planning to try growing hops.",
        "type": "narration",
        "content": "We already have everything we need to be self sufficient, and we're even planning to try growing hops."
    },
    {
        "id": 204,
        "raw": "This was all made possible by that Dewville treasure.",
        "type": "narration",
        "content": "This was all made possible by that Dewville treasure."
    },
    {
        "id": 205,
        "raw": "That, of course, is an entirely different story. Real interesting. But, I won't go into the details here.",
        "type": "narration",
        "content": "That, of course, is an entirely different story. Real interesting. But, I won't go into the details here."
    },
    {
        "id": 206,
        "raw": "I've also slightly changed my views about some things.",
        "type": "narration",
        "content": "I've also slightly changed my views about some things."
    },
    {
        "id": 207,
        "raw": "And I know that you've long held your own opinions about this too. Just know that Reunion is not the only place that the Infected can go.",
        "type": "narration",
        "content": "And I know that you've long held your own opinions about this too. Just know that Reunion is not the only place that the Infected can go."
    },
    {
        "id": 208,
        "raw": "I know you'll be able to make the decision that is right for you.",
        "type": "narration",
        "content": "I know you'll be able to make the decision that is right for you."
    },
    {
        "id": 209,
        "raw": "I miss you a lot. I hope that I will see you in Columbia one day.",
        "type": "narration",
        "content": "I miss you a lot. I hope that I will see you in Columbia one day."
    },
    {
        "id": 210,
        "raw": "Bob",
        "type": "narration",
        "content": "Bob"
    },
    {
        "id": 211,
        "raw": "To, Mudrock.",
