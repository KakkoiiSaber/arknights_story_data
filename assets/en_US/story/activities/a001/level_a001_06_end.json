        "focus": 1
    },
    {
        "id": 136,
        "raw": "[name=\"Skadi\"]   Tsk. Not my problem.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "Tsk. Not my problem."
    },
    {
        "id": 137,
        "raw": "[name=\"Skadi\"]   There are quite a few of them. Considering you just recovered from... that... Are you sure you can handle them?",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "There are quite a few of them. Considering you just recovered from... that... Are you sure you can handle them?"
    },
    {
        "id": 138,
