    {
        "id": 6,
        "raw": "[name=\"Big Bob\"]   Hah... As I thought...",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "Hah... As I thought..."
    },
    {
        "id": 7,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"Reunion Member\"]   Bob! Y-you're bleeding!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Bob! Y-you're bleeding!"
    },
    {
        "id": 9,
        "raw": "[name=\"Reunion Member\"]   We can't let you bleed for nothing! I can still—",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "We can't let you bleed for nothing! I can still—"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"Big Bob\"]   No, that's enough.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "No, that's enough."
    },
    {
        "id": 12,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"Reunion Member\"]   Bob...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Bob..."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"Big Bob\"]   How much blood have we shed over the years?",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "How much blood have we shed over the years?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_263_skadi#2\")]",
        "type": "character",
        "name": "char_263_skadi#2"
    },
    {
        "id": 17,
        "raw": "[name=\"Skadi\"]   Do you intend to continue?",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "Do you intend to continue?"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"avg_npc_010#2\")]",
        "type": "character",
        "name": "avg_npc_010#2"
    },
    {
        "id": 19,
        "raw": "[name=\"Big Bob\"]   Hmph. We fight for our survival, so why would we throw away our lives?",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "Hmph. We fight for our survival, so why would we throw away our lives?"
    },
    {
        "id": 20,
        "raw": "[name=\"Big Bob\"]   I admit defeat. I'm not strong enough.",
        "type": "dialog",
        "speaker": "Big Bob",
        "content": "I admit defeat. I'm not strong enough."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_220_grani#4\")]",
        "type": "character",
        "name": "avg_npc_010#2",
        "name2": "char_220_grani#4"
    },
    {
        "id": 22,
        "raw": "[name=\"Grani\"]   ...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "..."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Carol\"]   Sorry, Mister Bob... But without this treasure, our village is doomed.",
        "type": "dialog",
        "speaker": "Carol",
        "content": "Sorry, Mister Bob... But without this treasure, our village is doomed."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Skadi\"]   Step away from that chest. Give me the key.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "Step away from that chest. Give me the key."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=30, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 29,
        "raw": "[name=\"Carol\"]   H-huh?",
        "type": "dialog",
        "speaker": "Carol",
        "content": "H-huh?"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"Skadi\"]   The moment you unlock that chest, you will die.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "The moment you unlock that chest, you will die."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Carol\"]   But I...",
        "type": "dialog",
        "speaker": "Carol",
        "content": "But I..."
    },
    {
        "id": 34,
        "raw": "[name=\"Carol\"]   This is something that we've safeguarded for generations. My father once said that taking care of this key was one of our most important duties—",
        "type": "dialog",
        "speaker": "Carol",
        "content": "This is something that we've safeguarded for generations. My father once said that taking care of this key was one of our most important duties—"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"Skadi\"]   —After you use that key, it will cut open your hand and drink your blood. If it comes in contact with someone not of the Kuranta bloodline, it will break.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "—After you use that key, it will cut open your hand and drink your blood. If it comes in contact with someone not of the Kuranta bloodline, it will break."
    },
    {
        "id": 37,
        "raw": "[name=\"Skadi\"]   Hand the key over to me!",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "Hand the key over to me!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 39,
        "raw": "[name=\"Carol\"]   I can't... This key holds the future of everyone in the village.",
        "type": "dialog",
        "speaker": "Carol",
        "content": "I can't... This key holds the future of everyone in the village."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 41,
        "raw": "[name=\"Grani\"]   Ugh...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Ugh..."
    },
    {
        "id": 42,
        "raw": "[name=\"Grani\"]   Is that true, Skadi?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Is that true, Skadi?"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Skadi\"]   The person who hid the Knight's Treasure took drastic measures in order to protect their secrets. Only—",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "The person who hid the Knight's Treasure took drastic measures in order to protect their secrets. Only—"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 46,
        "raw": "[name=\"Carol\"]   —Only those who possess the true, dauntless bloodline of Kazimierz may open the path.",
        "type": "dialog",
        "speaker": "Carol",
        "content": "—Only those who possess the true, dauntless bloodline of Kazimierz may open the path."
    },
