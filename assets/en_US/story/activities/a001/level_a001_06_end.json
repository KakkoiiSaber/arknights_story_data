        "id": 73,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3"
    },
    {
        "id": 74,
        "raw": "[name=\"Grani\"]   Carol, can I see that key real quick?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Carol, can I see that key real quick?"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 76,
        "raw": "[name=\"Carol\"]   Um... sure.",
        "type": "dialog",
        "speaker": "Carol",
        "content": "Um... sure."
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3"
    },
    {
        "id": 78,
        "raw": "[name=\"Grani\"]   This key isn't that big, is it?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "This key isn't that big, is it?"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"Skadi\"]   Even though it's not too big, the average person won't be able to survive losing this much blood.",
        "type": "dialog",
        "speaker": "Skadi",
        "content": "Even though it's not too big, the average person won't be able to survive losing this much blood."
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 82,
        "raw": "[name=\"Grani\"]   In other words, this monstrous key only sucks out a fixed amount of blood?",
        "type": "dialog",
        "speaker": "Grani",
        "content": "In other words, this monstrous key only sucks out a fixed amount of blood?"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
