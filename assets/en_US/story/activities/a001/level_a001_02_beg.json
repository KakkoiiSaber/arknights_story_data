        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"Violent Bounty Hunter\"]   Everyone, shut up! Shhhh!",
        "type": "dialog",
        "speaker": "Violent Bounty Hunter",
        "content": "Everyone, shut up! Shhhh!"
    },
