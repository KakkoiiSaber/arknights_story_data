        "name": "char_220_grani#1"
    },
    {
        "id": 104,
        "raw": "[name=\"Grani\"]   Huh? Why is someone crouching here...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Huh? Why is someone crouching here..."
    },
    {
