    {
        "id": 48,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 49,
        "raw": "[name=\"Bounty Hunter\"]   She? Who are you talking about? Don't ask me, I don't know anything!",
