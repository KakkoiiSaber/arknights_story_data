        "name": "avg_npc_008",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"Bounty Hunter\"]   Yeah, you peasants couldn't possibly understand. Did you not see that walking Catastrophe?!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "Yeah, you peasants couldn't possibly understand. Did you not see that walking Catastrophe?!"
    },
    {
        "id": 113,
        "raw": "[name=\"Bounty Hunter\"]   No bounty hunter would be stupid enough to face her head-on! The only people foolish enough to swagger up to her are those who haven't seen her level entire cities!",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "No bounty hunter would be stupid enough to face her head-on! The only people foolish enough to swagger up to her are those who haven't seen her level entire cities!"
    },
