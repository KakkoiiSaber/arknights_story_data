        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 81,
        "raw": "[name=\"Grani\"]   It's now or never. This is our chance to get out of the village.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "It's now or never. This is our chance to get out of the village."
    },
    {
        "id": 82,
        "raw": "[name=\"Grani\"]   If there are other operators coming to the village, we might even have the upper hand.",
        "type": "dialog",
        "speaker": "Grani",
        "content": "If there are other operators coming to the village, we might even have the upper hand."
    },
    {
