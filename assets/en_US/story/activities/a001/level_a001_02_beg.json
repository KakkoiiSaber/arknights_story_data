        "type": "character",
        "name": "char_220_grani#1",
        "name2": "avg_npc_007",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"Violent Bounty Hunter\"]   Quiet, don't let her hear us!",
        "type": "dialog",
        "speaker": "Violent Bounty Hunter",
        "content": "Quiet, don't let her hear us!"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"char_220_grani#1\",name2=\"avg_npc_007\",focus=1)]",
