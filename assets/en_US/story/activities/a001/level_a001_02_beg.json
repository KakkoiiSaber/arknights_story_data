        "name2": "avg_npc_007",
        "focus": 1
    },
    {
        "id": 119,
        "raw": "[name=\"Grani\"]   You know, I was hoping she'd notice me—",
        "type": "dialog",
        "speaker": "Grani",
        "content": "You know, I was hoping she'd notice me—"
