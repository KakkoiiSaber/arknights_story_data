        "name2": "avg_npc_007",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"Violent Bounty Hunter\"]   The captain fell into the river...!",
        "type": "dialog",
        "speaker": "Violent Bounty Hunter",
        "content": "The captain fell into the river...!"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_007\",name2=\"avg_npc_007\",focus=1)]",
        "type": "character",
        "name": "avg_npc_007",
        "name2": "avg_npc_007",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Bounty Hunter\"]   She... she sent him flying with just a single blow...",
        "type": "dialog",
        "speaker": "Bounty Hunter",
        "content": "She... she sent him flying with just a single blow..."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_263_skadi#1\")]",
        "type": "character",
        "name": "char_263_skadi#1"
    },
    {
        "id": 46,
        "raw": "[name=\"???\"]   Ah, I forgot they can't understand me... Oh well.",
        "type": "dialog",
        "speaker": "???",
        "content": "Ah, I forgot they can't understand me... Oh well."
    },
    {
        "id": 47,
        "raw": "[name=\"???\"]   Tell me, where is she?",
        "type": "dialog",
        "speaker": "???",
        "content": "Tell me, where is she?"
