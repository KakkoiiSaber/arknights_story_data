        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"Grani\"]   She might be my coworker...",
        "type": "dialog",
        "speaker": "Grani",
        "content": "She might be my coworker..."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#4\",focus=2)]",
