        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"Grani\"]   Wow, did she really! You mean she can do that all by herself—",
        "type": "dialog",
        "speaker": "Grani",
        "content": "Wow, did she really! You mean she can do that all by herself—"
    },
