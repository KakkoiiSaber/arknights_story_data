    {
        "id": 44,
        "raw": "[name=\"Hellagur\"]   (This woman... won't be simple to deal with.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(This woman... won't be simple to deal with.)"
    },
    {
        "id": 45,
        "raw": "[name=\"Hellagur\"]   (These bodyguards won't be able to harm me, but she poses a threat.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(These bodyguards won't be able to harm me, but she poses a threat.)"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_188_helage_1\",name2=\"char_340_shwaz_2#4\",focus=2)]",
        "type": "character",
        "name": "char_188_helage_1",
        "name2": "char_340_shwaz_2#4",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"Schwarz\"]   Foolish outsiders...",
        "type": "dialog",
        "speaker": "Schwarz",
        "content": "Foolish outsiders..."
    },
    {
        "id": 48,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 49,
        "raw": "[name=\"Hellagur\"]   (She's angry now.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(She's angry now.)"
    },
    {
        "id": 50,
        "raw": "[name=\"Hellagur\"]   (Perhaps from her perspective, she really believes that we deceived Miss Ceylon.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(Perhaps from her perspective, she really believes that we deceived Miss Ceylon.)"
    },
    {
        "id": 51,
        "raw": "[name=\"Hellagur\"]   (But, something's not right. Just who is she...)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(But, something's not right. Just who is she...)"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_188_helage_1\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_188_helage_1",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"Hellagur\"]   You must be a pretty experienced mercenary, staying disciplined even though your Mistress is gone.",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "You must be a pretty experienced mercenary, staying disciplined even though your Mistress is gone."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 55,
        "raw": "[name=\"Bodyguard\"]   Cut the crap! Since you know that our boss was... Ugh...",
        "type": "dialog",
        "speaker": "Bodyguard",
        "content": "Cut the crap! Since you know that our boss was... Ugh..."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_340_shwaz_2#2\",name2=\"avg_npc_020\",focus=1)]",
        "type": "character",
        "name": "char_340_shwaz_2#2",
        "name2": "avg_npc_020",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Schwarz\"]   Shut up.",
        "type": "dialog",
        "speaker": "Schwarz",
        "content": "Shut up."
    },
    {
        "id": 58,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 59,
        "raw": "[name=\"Hellagur\"]   (Hmm...? Wait... A crossbow, Feline, and that name...)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(Hmm...? Wait... A crossbow, Feline, and that name...)"
    },
    {
        "id": 60,
        "raw": "[name=\"Hellagur\"]   (Where have I heard that name before...)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(Where have I heard that name before...)"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 62,
        "raw": "[name=\"Bodyguard\"]   Wait, what is this geezer doing?!",
        "type": "dialog",
        "speaker": "Bodyguard",
        "content": "Wait, what is this geezer doing?!"
    },
    {
        "id": 63,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 64,
        "raw": "[name=\"Hellagur\"]   (I'm a bit worried about how the Doctor is doing.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(I'm a bit worried about how the Doctor is doing.)"
    },
    {
        "id": 65,
        "raw": "[name=\"Hellagur\"]   (...But the Doctor is capable enough, as are the others. There shouldn't be any issue.)",
        "type": "dialog",
        "speaker": "Hellagur",
        "content": "(...But the Doctor is capable enough, as are the others. There shouldn't be any issue.)"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 67,
        "raw": "[name=\"Bodyguard\"]   Is he senile or something? He's charging straight at us!",
        "type": "dialog",
        "speaker": "Bodyguard",
        "content": "Is he senile or something? He's charging straight at us!"
    },
    {
        "id": 68,
        "raw": "[name=\"Bodyguard\"]   Hurry, stop him!!!",
        "type": "dialog",
        "speaker": "Bodyguard",
        "content": "Hurry, stop him!!!"
