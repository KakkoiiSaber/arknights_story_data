    {
        "id": 35,
        "raw": "[name=\"Ceylon\"]   Is it really getting weaker? I can't tell from the appearance at all!",
        "type": "dialog",
        "speaker": "Ceylon",
        "content": "Is it really getting weaker? I can't tell from the appearance at all!"
    },
