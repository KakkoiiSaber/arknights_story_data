        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 125,
        "raw": "[name=\"Eunectes\"]  I told them many times to stay away from the depths of the mine.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "I told them many times to stay away from the depths of the mine."
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_187_ccheal_1#4\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#4",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 127,
        "raw": "[name=\"Gavial\"]  But your people are getting infected!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "But your people are getting infected!"
    },
    {
        "id": 128,
        "raw": "[Character(name=\"char_187_ccheal_1#4\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#4",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 129,
        "raw": "[name=\"Eunectes\"]  There's always someone who doesn't listen. I can't control them all. Isn't that right, Yogi?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "There's always someone who doesn't listen. I can't control them all. Isn't that right, Yogi?"
    },
