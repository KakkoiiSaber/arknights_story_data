    {
        "id": 114,
        "raw": "[name=\"Eunectes\"]  Gavial, I never took you for the sore loser type.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Gavial, I never took you for the sore loser type."
    },
    {
        "id": 115,
        "raw": "[name=\"Eunectes\"]  Are you that broken up about being beaten by the Big, Ugly Thing?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Are you that broken up about being beaten by the Big, Ugly Thing?"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_187_ccheal_1#4\", name2=\"char_416_zumama_1#2\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#4",
        "name2": "char_416_zumama_1#2",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"Gavial\"]  No, your Big Ugly Whatever is great. I'm totally fine with that.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "No, your Big Ugly Whatever is great. I'm totally fine with that."
    },
    {
        "id": 118,
        "raw": "[name=\"Gavial\"]  But if you're putting your people at risk of Oripathy infection for the sake of some ore, then as a doctor I have no choice but to stop you.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "But if you're putting your people at risk of Oripathy infection for the sake of some ore, then as a doctor I have no choice but to stop you."
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_187_ccheal_1#4\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#4",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 120,
        "raw": "[name=\"Eunectes\"]  Huh? Oripathy? Oh, you're talking about Stone Disease.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Huh? Oripathy? Oh, you're talking about Stone Disease."
    },
    {
        "id": 121,
        "raw": "[name=\"Eunectes\"]  I'm not putting anyone at risk.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "I'm not putting anyone at risk."
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 123,
        "raw": "[name=\"Gavial\"]  Huh?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Huh?"
    },
