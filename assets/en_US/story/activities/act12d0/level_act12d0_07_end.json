        "type": "character",
        "name": "avg_npc_070",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 131,
        "raw": "[name=\"Yogi\"]  Yes, my brother wanted to dig out more ore for the Great Chief, so he went deeper into the mine.",
        "type": "dialog",
        "speaker": "Yogi",
        "content": "Yes, my brother wanted to dig out more ore for the Great Chief, so he went deeper into the mine."
