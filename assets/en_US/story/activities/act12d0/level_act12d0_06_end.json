    {
        "id": 59,
        "raw": "[name=\"Blaze\"]  Doctor! Everyone! Great, I finally found you guys!",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Doctor! Everyone! Great, I finally found you guys!"
    },
    {
        "id": 60,
        "raw": "[name=\"Blaze\"]  *Sigh*, Doctor, you had me worried.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "*Sigh*, Doctor, you had me worried."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_017_homura_summer\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_017_homura_summer",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"Gavial\"]  Huh? Blaze, why are you wearing your swimsuit... and carrying some kid on your back?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Huh? Blaze, why are you wearing your swimsuit... and carrying some kid on your back?"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_017_homura_summer\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_017_homura_summer",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"Blaze\"]  I ran into this little girl on my way over here. She started hitting me for some reason.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "I ran into this little girl on my way over here. She started hitting me for some reason."
    },
    {
        "id": 65,
        "raw": "[name=\"Blaze\"]  I kicked her ass, of course, and beat down all her friends too.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "I kicked her ass, of course, and beat down all her friends too."
    },
    {
        "id": 66,
        "raw": "[name=\"Blaze\"]  Gotta hand it to her, she's not bad in a fight, didn't go down easy. So I brought her along. I figured you could help me ask why she wanted to fight me.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Gotta hand it to her, she's not bad in a fight, didn't go down easy. So I brought her along. I figured you could help me ask why she wanted to fight me."
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_017_homura_summer\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_017_homura_summer",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"Gavial\"]  It's Kemar. She probably just thought you looked strong. She just loves fighting.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "It's Kemar. She probably just thought you looked strong. She just loves fighting."
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_017_homura_summer\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_017_homura_summer",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"Blaze\"]  Hah. That means something, coming from you.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Hah. That means something, coming from you."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_017_homura_summer\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_017_homura_summer",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"Gavial\"]  I don't love fighting. I'm just a hands-on problem solver.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "I don't love fighting. I'm just a hands-on problem solver."
    },
