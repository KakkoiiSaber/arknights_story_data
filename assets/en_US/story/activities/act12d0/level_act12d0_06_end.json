    {
        "id": 9,
        "raw": "[name=\"???\"]  Where are the others?",
        "type": "dialog",
        "speaker": "???",
        "content": "Where are the others?"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"avg_npc_071\")]",
        "type": "character",
        "name": "avg_npc_071"
    },
    {
        "id": 11,
        "raw": "[name=\"Clan Leader A\"]  The people of the Great Wood Tribe are gone. I heard that leader was defeated by an outsider.",
        "type": "dialog",
        "speaker": "Clan Leader A",
        "content": "The people of the Great Wood Tribe are gone. I heard that leader was defeated by an outsider."
    },
    {
        "id": 12,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070"
    },
    {
        "id": 13,
        "raw": "[name=\"Peta\"]  The Firestone and Thick Tail Tribes were defeated by an stranger carrying a pile of weapons on her back.",
        "type": "dialog",
        "speaker": "Peta",
        "content": "The Firestone and Thick Tail Tribes were defeated by an stranger carrying a pile of weapons on her back."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"avg_npc_071\")]",
        "type": "character",
        "name": "avg_npc_071"
    },
    {
        "id": 15,
        "raw": "[name=\"Clan Leader A\"]  Some of the tribes decided to join up with Zumama.",
        "type": "dialog",
        "speaker": "Clan Leader A",
        "content": "Some of the tribes decided to join up with Zumama."
    },
    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070"
    },
    {
        "id": 17,
        "raw": "[name=\"Clan Leader B\"]  The truth is Zumama's managed to drum up a formidable front. If I weren't with Gavial, I might have gone to Zumama myself.",
        "type": "dialog",
        "speaker": "Clan Leader B",
        "content": "The truth is Zumama's managed to drum up a formidable front. If I weren't with Gavial, I might have gone to Zumama myself."
    },
    {
        "id": 18,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 19,
        "raw": "[name=\"???\"]  Doesn't matter.",
        "type": "dialog",
        "speaker": "???",
        "content": "Doesn't matter."
    },
    {
        "id": 20,
        "raw": "[name=\"???\"]  Your tribes will be enough.",
        "type": "dialog",
        "speaker": "???",
        "content": "Your tribes will be enough."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070"
    },
    {
        "id": 22,
        "raw": "[name=\"Clan Leader B\"]  Hey, can we really challenge Zumama on our own?",
        "type": "dialog",
        "speaker": "Clan Leader B",
        "content": "Hey, can we really challenge Zumama on our own?"
    },
    {
        "id": 23,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "[name=\"???\"]  Yes.",
        "type": "dialog",
        "speaker": "???",
        "content": "Yes."
    },
    {
        "id": 25,
        "raw": "[name=\"???\"]  Gavial can definitely beat Zumama's giant machine. Then, I will become the Great Chief and force Gavial to stay.",
        "type": "dialog",
        "speaker": "???",
        "content": "Gavial can definitely beat Zumama's giant machine. Then, I will become the Great Chief and force Gavial to stay."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070"
    },
    {
        "id": 27,
        "raw": "[name=\"Peta\"]  Peta thinks that is not a good idea.",
        "type": "dialog",
        "speaker": "Peta",
        "content": "Peta thinks that is not a good idea."
