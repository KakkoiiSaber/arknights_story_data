    {
        "id": 21,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 22,
        "raw": "[name=\"Gavial\"]  Hey, is he alright?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hey, is he alright?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Eunectes\"]  No need to worry, he'll be back in a minute.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "No need to worry, he'll be back in a minute."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Gavial\"]  Okay... is he like... a person? I've never heard of anyone like him before.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Okay... is he like... a person? I've never heard of anyone like him before."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Eunectes\"]  No idea, the High Priest only told me he's lived here for a very long time.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "No idea, the High Priest only told me he's lived here for a very long time."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"Gavial\"]  Alright then. What else can we say...",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Alright then. What else can we say..."
    },
    {
        "id": 31,
        "raw": "[name=\"Gavial\"]  Phew, he's really something...",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Phew, he's really something..."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer"
    },
    {
        "id": 33,
        "raw": "[name=\"Blaze\"]  Gavial, your head is bleeding. Are you okay?",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Gavial, your head is bleeding. Are you okay?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 35,
        "raw": "[name=\"Gavial\"]  It's fine, just a scratch. Tomimi, bring me my medical bag here.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "It's fine, just a scratch. Tomimi, bring me my medical bag here."
    },
    {
        "id": 36,
        "raw": "[name=\"Gavial\"]  Hm? Where did Tomimi go?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hm? Where did Tomimi go?"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_337_utage_summer_1\")]",
        "type": "character",
        "name": "char_337_utage_summer_1"
    },
    {
        "id": 38,
        "raw": "[name=\"Utage\"]  Here's your bag. And Tomimi, I think I saw her running off somewhere right before we won the fight.",
        "type": "dialog",
        "speaker": "Utage",
        "content": "Here's your bag. And Tomimi, I think I saw her running off somewhere right before we won the fight."
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 40,
        "raw": "[name=\"Gavial\"]  Thanks. She didn't get scared, did she? Anyway, let's patch ourselves up first.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Thanks. She didn't get scared, did she? Anyway, let's patch ourselves up first."
    },
    {
        "id": 41,
        "raw": "[name=\"Gavial\"]  You go check if anyone's injured, and bring them to me if they are. I'll take care of them.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "You go check if anyone's injured, and bring them to me if they are. I'll take care of them."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_2013_cerber_1\")]",
        "type": "character",
        "name": "char_2013_cerber_1"
    },
    {
        "id": 43,
        "raw": "[name=\"Ceobe\"]  Leave it to me!",
        "type": "dialog",
        "speaker": "Ceobe",
        "content": "Leave it to me!"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer"
    },
    {
        "id": 45,
        "raw": "[name=\"Blaze\"]  Haha, no problem.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Haha, no problem."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_337_utage_summer_1#3\")]",
        "type": "character",
        "name": "char_337_utage_summer_1#3"
    },
    {
        "id": 47,
        "raw": "[name=\"Utage\"]  Ugh, what a pain. Fine.",
        "type": "dialog",
        "speaker": "Utage",
        "content": "Ugh, what a pain. Fine."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_201_moeshd_summer\")]",
        "type": "character",
        "name": "char_201_moeshd_summer"
    },
    {
        "id": 49,
        "raw": "[name=\"Croissant\"]  Quit yer belly-achin'.",
        "type": "dialog",
        "speaker": "Croissant",
        "content": "Quit yer belly-achin'."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 51,
        "raw": "[name=\"Gavial\"]  Doctor... hmm?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Doctor... hmm?"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1"
    },
    {
        "id": 53,
        "raw": "[name=\"Eunectes\"]  The Big Ugly...",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "The Big Ugly..."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"Gavial\"]  Sorry, Zumama. We had to take it apart.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Sorry, Zumama. We had to take it apart."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"Eunectes\"]  I know.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "I know."
    },
    {
        "id": 58,
        "raw": "[name=\"Eunectes\"]  I checked your engine, I think it's working fine. You can have it back.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "I checked your engine, I think it's working fine. You can have it back."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"Gavial\"]  Oh yeah? That's great!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Oh yeah? That's great!"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"Eunectes\"]  You really won't stay, Gavial?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "You really won't stay, Gavial?"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"Gavial\"]  Yeah, just like you, I've found my calling.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Yeah, just like you, I've found my calling."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"Eunectes\"]  To be a doctor?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "To be a doctor?"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"Gavial\"]  That's it.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "That's it."
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"Eunectes\"]  Is doctoring fun?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Is doctoring fun?"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"Gavial\"]  Is building machines fun?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Is building machines fun?"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"Eunectes\"]  It is.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "It is."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1#5\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#5",
        "name2": "char_416_zumama_1#5",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"Gavial\"]  Same here.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Same here."
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#5",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"Eunectes\"]  But you still have to be the Great Chief.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "But you still have to be the Great Chief."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"Gavial\"]  Huh?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Huh?"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"Eunectes\"]  Any way you slice it, you beat the Big, Ugly Thing. You won, Gavial.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Any way you slice it, you beat the Big, Ugly Thing. You won, Gavial."
    },
    {
        "id": 83,
        "raw": "[name=\"Eunectes\"]  Look, everyone's here again. They're looking to you.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Look, everyone's here again. They're looking to you."
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_187_ccheal_1#2\")]",
        "type": "character",
        "name": "char_187_ccheal_1#2"
    },
    {
        "id": 85,
        "raw": "[name=\"Gavial\"]  Tch. Doctor, what do we do?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Tch. Doctor, what do we do?"
    },
    {
        "id": 86,
        "raw": "[Decision(options=\"Your call.;......;All hail Great Chief Gavial!\",values=\"1;2;3\")]",
        "type": "decision",
        "options": "Your call.;......;All hail Great Chief Gavial!",
        "values": "1;2;3"
    },
    {
        "id": 87,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
        "references": "1"
    },
    {
        "id": 88,
        "raw": "[name=\"Gavial\"]  You're not giving me anything here!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "You're not giving me anything here!"
    },
    {
        "id": 89,
        "raw": "[Predicate(references=\"2\")]",
        "type": "predicate",
        "references": "2"
    },
    {
        "id": 90,
        "raw": "[name=\"Gavial\"]  Doctor, I know you're awake! I'm a doctor!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Doctor, I know you're awake! I'm a doctor!"
    },
    {
        "id": 91,
        "raw": "[Predicate(references=\"3\")]",
        "type": "predicate",
        "references": "3"
    },
    {
        "id": 92,
        "raw": "[name=\"Gavial\"]  Tch. Doctor, I really want to punch you right now.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Tch. Doctor, I really want to punch you right now."
    },
    {
        "id": 93,
        "raw": "[Predicate(references=\"1;2;3\")]",
        "type": "predicate",
        "references": "1;2;3"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_411_tomimi_1\")]",
        "type": "character",
        "name": "char_411_tomimi_1"
    },
    {
        "id": 95,
        "raw": "[name=\"Tomimi\"]  Gavial, are you hurt?!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Gavial, are you hurt?!"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"Gavial\"]  Hm? I'm fine. Where did you run off to?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hm? I'm fine. Where did you run off to?"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_411_tomimi_1#4\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_411_tomimi_1#4",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"Tomimi\"]  Huh? Oh, that... I had to go pee!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Huh? Oh, that... I had to go pee!"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_411_tomimi_1#4\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_411_tomimi_1#4",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"Gavial\"]  Okay... Hm?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Okay... Hm?"
    },
    {
        "id": 102,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_411_tomimi_1#4\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_411_tomimi_1#4",
        "focus": 2
    },
    {
        "id": 103,
        "raw": "[name=\"Tomimi\"]  What's wrong, Gavial? Why are you looking at me like that?",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "What's wrong, Gavial? Why are you looking at me like that?"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1#4\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_411_tomimi_1#4",
        "focus": 1
    },
    {
        "id": 105,
        "raw": "[name=\"Gavial\"]  Hm... Haha, I've got it!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hm... Haha, I've got it!"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"char_187_ccheal_1#3\")]",
        "type": "character",
        "name": "char_187_ccheal_1#3"
    },
    {
        "id": 107,
        "raw": "[name=\"Gavial\"]  Everyone, listen up!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Everyone, listen up!"
    },
    {
        "id": 108,
        "raw": "[name=\"Gavial\"]  I beat the Big Ugly, so I'm going to be the Great Chief.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "I beat the Big Ugly, so I'm going to be the Great Chief."
    },
    {
        "id": 109,
        "raw": "[name=\"Gavial\"]  And so, my message to you is——",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "And so, my message to you is——"
    },
