    },
    {
        "id": 129,
        "raw": "[name=\"Utage\"]  Is that really gonna fly? Don't these people worship strength over everything?",
        "type": "dialog",
        "speaker": "Utage",
        "content": "Is that really gonna fly? Don't these people worship strength over everything?"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1"
    },
    {
        "id": 131,
        "raw": "[name=\"Eunectes\"]  Gavial is the Great Chief after all. She defeated everyone, so her word is law.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Gavial is the Great Chief after all. She defeated everyone, so her word is law."
    },
    {
        "id": 132,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 133,
        "raw": "[name=\"Gavial\"]  Haha. Zumama, machines are pretty cool, but I think I'll stick with my fists after all.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Haha. Zumama, machines are pretty cool, but I think I'll stick with my fists after all."
    },
    {
        "id": 134,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 135,
        "raw": "[name=\"Eunectes\"]  Hmph. Don't forget, I still don't recognize you. I'll build an even greater machine and challenge you again.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Hmph. Don't forget, I still don't recognize you. I'll build an even greater machine and challenge you again."
    },
    {
        "id": 136,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 137,
        "raw": "[name=\"Gavial\"]  Sure, I'll be waiting.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Sure, I'll be waiting."
    },
    {
        "id": 138,
        "raw": "[name=\"Gavial\"]  Oh, right. Before that, you need to come with me for a bit.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Oh, right. Before that, you need to come with me for a bit."
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 140,
        "raw": "[name=\"Eunectes\"]  Why?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Why?"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 142,
        "raw": "[name=\"Gavial\"]  You need to come with me to Rhodes Island to get an Oripathy checkup.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "You need to come with me to Rhodes Island to get an Oripathy checkup."
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 144,
        "raw": "[name=\"Eunectes\"]  Can I refuse? I still have to work on the Big Ugly...",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Can I refuse? I still have to work on the Big Ugly..."
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 146,
        "raw": "[name=\"Gavial\"]  You don't have a choice this time. Besides, until Tomimi takes over, I'm still the Great Chief. I'll bring you back even if I have to kidnap you.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "You don't have a choice this time. Besides, until Tomimi takes over, I'm still the Great Chief. I'll bring you back even if I have to kidnap you."
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 148,
        "raw": "[name=\"Eunectes\"]  Fine.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Fine."
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_411_tomimi_1\")]",
        "type": "character",
        "name": "char_411_tomimi_1"
    },
    {
        "id": 150,
        "raw": "[name=\"Tomimi\"]  ...Gavial, are you going to leave after all?",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "...Gavial, are you going to leave after all?"
    },
    {
        "id": 151,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 152,
        "raw": "[name=\"Gavial\"]  Yep, I'll probably be leaving right as soon as we get the engine back in the aircraft.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Yep, I'll probably be leaving right as soon as we get the engine back in the aircraft."
    },
