        "id": 110,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 111,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 112,
        "raw": "[name=\"Gavial\"]  Your fists are everything!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Your fists are everything!"
    },
    {
