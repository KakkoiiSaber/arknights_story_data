    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_411_tomimi_1#2\")]",
        "type": "character",
        "name": "char_411_tomimi_1#2"
    },
    {
        "id": 116,
        "raw": "[name=\"Tomimi\"]  Eh? Gavial, are you staying here to be the Great Chief?",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Eh? Gavial, are you staying here to be the Great Chief?"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_187_ccheal_1#3\")]",
        "type": "character",
        "name": "char_187_ccheal_1#3"
    },
    {
        "id": 118,
        "raw": "[name=\"Gavial\"]  But!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "But!"
    },
    {
        "id": 119,
        "raw": "[name=\"Gavial\"]  I have something very important I must do, so I have to leave.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "I have something very important I must do, so I have to leave."
    },
    {
        "id": 120,
        "raw": "[name=\"Gavial\"]  Worry not, though! When I'm gone, Tomimi will give orders on my behalf!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Worry not, though! When I'm gone, Tomimi will give orders on my behalf!"
    },
    {
        "id": 121,
        "raw": "[name=\"Gavial\"]  Just treat Tomimi as you would treat me!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Just treat Tomimi as you would treat me!"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_411_tomimi_1#2\")]",
        "type": "character",
        "name": "char_411_tomimi_1#2"
    },
    {
        "id": 123,
        "raw": "[name=\"Tomimi\"]  Eh, w-w-what?",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Eh, w-w-what?"
    },
