        "type": "character",
        "name": "char_411_tomimi_1#2"
    },
    {
        "id": 35,
        "raw": "[name=\"Tomimi\"]  Doctor. I bet you don't see people this strong on the outside!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Doctor. I bet you don't see people this strong on the outside!"
    },
    {
