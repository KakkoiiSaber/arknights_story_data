    {
        "id": 25,
        "raw": "[name=\"Tomimi\"]  Mm, I knew it! Zumama's so tough!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Mm, I knew it! Zumama's so tough!"
    },
    {
        "id": 26,
        "raw": "[name=\"Tomimi\"]  She may be fighting alone, but just like Gavial, your everyday Archosauria goonies are no match for her.",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "She may be fighting alone, but just like Gavial, your everyday Archosauria goonies are no match for her."
    },
    {
        "id": 27,
        "raw": "[name=\"Tomimi\"]  But...",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "But..."
    },
