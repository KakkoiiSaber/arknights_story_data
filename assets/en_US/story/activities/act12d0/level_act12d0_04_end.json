    {
        "id": 65,
        "raw": "[name=\"Gavial\"]  It's been a while, Zumama!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "It's been a while, Zumama!"
    },
    {
        "id": 66,
        "raw": "[name=\"Gavial\"]  Or should I call you the leader of the Eunectes now?",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Or should I call you the leader of the Eunectes now?"
    },
    {
