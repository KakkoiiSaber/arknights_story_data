    },
    {
        "id": 19,
        "raw": "[name=\"Tomimi\"]  Oh, Peta won.",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Oh, Peta won."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Gavial\"]  This Peta's pretty good. Makes me wanna rumble with him, actually.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "This Peta's pretty good. Makes me wanna rumble with him, actually."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"Tomimi\"]  Mm-hm! He's one of my tribe's warriors.",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Mm-hm! He's one of my tribe's warriors."
    },
    {
        "id": 24,
        "raw": "[name=\"Tomimi\"]  But he's definitely not as good as you, Gavial.",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "But he's definitely not as good as you, Gavial."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Gavial\"]  Haha, easy enough to say.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Haha, easy enough to say."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1#3\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_411_tomimi_1#3",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Tomimi\"]  Come on, Gavial! You already came so close to becoming Great Chief over when we were little! Like you could lose to Peta!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Come on, Gavial! You already came so close to becoming Great Chief over when we were little! Like you could lose to Peta!"
    },
    {
        "id": 29,
        "raw": "[Decision(options=\"When you were little?\",values=\"1\")]",
        "type": "decision",
        "options": "When you were little?",
        "values": "1"
    },
    {
