    {
        "id": 49,
        "raw": "[name=\"Archosauria A\"]  Pfeh. All our warriors taken down like nothing.",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Pfeh. All our warriors taken down like nothing."
    },
    {
        "id": 50,
        "raw": "[name=\"Archosauria B\"]  Let's go in together!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "Let's go in together!"
    },
    {
        "id": 51,
        "raw": "[name=\"Archosauria A\"]  We can't. No number at once will be enough... Can we only give up...?",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "We can't. No number at once will be enough... Can we only give up...?"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070.png"
    },
    {
        "id": 53,
        "raw": "[name=\"Archosauria Champion\"]  Who else wants to challenge me?! If you're all done, then it's just me versus the Great Chief!",
        "type": "dialog",
        "speaker": "Archosauria Champion",
        "content": "Who else wants to challenge me?! If you're all done, then it's just me versus the Great Chief!"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_187_ccheal_1#3\")]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png"
    },
    {
        "id": 55,
        "raw": "[name=\"Gavial\"]  I do!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "I do!"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070.png"
    },
    {
        "id": 57,
        "raw": "[name=\"Archosauria Champion\"]  And you're... Wilderness's Will's orphan, Gavial?",
        "type": "dialog",
        "speaker": "Archosauria Champion",
        "content": "And you're... Wilderness's Will's orphan, Gavial?"
    },
    {
        "id": 58,
        "raw": "[name=\"Archosauria Champion\"]  I hear you're a terror among the kids, but kids don't join the ceremony. Run back home and drink your milk. You've got a few more years.",
        "type": "dialog",
        "speaker": "Archosauria Champion",
        "content": "I hear you're a terror among the kids, but kids don't join the ceremony. Run back home and drink your milk. You've got a few more years."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_187_ccheal_1#3\")]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png"
    },
    {
        "id": 60,
        "raw": "[name=\"Gavial\"]  Hmph! Let's see who wins first!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hmph! Let's see who wins first!"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070.png"
    },
    {
        "id": 62,
        "raw": "[name=\"Archosauria Champion\"]  Hah! You really are an orphan. You don't fear death?!",
        "type": "dialog",
        "speaker": "Archosauria Champion",
        "content": "Hah! You really are an orphan. You don't fear death?!"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1#3\")]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png"
    },
    {
        "id": 64,
        "raw": "[name=\"Gavial\"]  My tribespeople are my family! Cut the crap! Do you wanna go or not?!",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "My tribespeople are my family! Cut the crap! Do you wanna go or not?!"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070.png"
    },
    {
        "id": 66,
        "raw": "[name=\"Archosauria Champion\"]  Heh! It's your funeral, brat!",
        "type": "dialog",
        "speaker": "Archosauria Champion",
        "content": "Heh! It's your funeral, brat!"
    },
