    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1#3\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_411_tomimi_1#3",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"Gavial\"]  Hmm? Oh, yeah, that one time.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Hmm? Oh, yeah, that one time."
    },
    {
        "id": 33,
        "raw": "[name=\"Gavial\"]  I was super young. Thought the idea was so cool, I actually went in for the ceremony once.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "I was super young. Thought the idea was so cool, I actually went in for the ceremony once."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1#3\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_411_tomimi_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"Tomimi\"]  Yeah, and you were already so super strong by then!",
        "type": "dialog",
        "speaker": "Tomimi",
        "content": "Yeah, and you were already so super strong by then!"
    },
