    {
        "id": 12,
        "raw": "[name=\"Gavial\"]  Doctor, I took a quick stroll around. Didn't seem like there were any others.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Doctor, I took a quick stroll around. Didn't seem like there were any others."
    },
    {
        "id": 13,
        "raw": "[name=\"Gavial\"]  Looks like we're gonna have to head back into the rainforest to look for her bunch after this.",
        "type": "dialog",
        "speaker": "Gavial",
        "content": "Looks like we're gonna have to head back into the rainforest to look for her bunch after this."
    },
