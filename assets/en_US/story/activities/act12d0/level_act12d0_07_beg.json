    {
        "id": 64,
        "raw": "[name=\"Archosauria A\"]  Ohh! Great Chief, it's moving!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Ohh! Great Chief, it's moving!"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"Archosauria B\"]  This wonderful engine sound! I've never heard anything so amazing!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "This wonderful engine sound! I've never heard anything so amazing!"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"avg_npc_070\", name2=\"avg_npc_072\", focus=2)]",
        "type": "character",
        "name": "avg_npc_070",
        "name2": "avg_npc_072",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"Archosauria C\"]  Haha, told you I'd get it done!",
        "type": "dialog",
        "speaker": "Archosauria C",
        "content": "Haha, told you I'd get it done!"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"avg_npc_072\", name2=\"char_416_zumama_1#6\", focus=2)]",
        "type": "character",
        "name": "avg_npc_072",
        "name2": "char_416_zumama_1#6",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"Eunectes\"]  How did you do it?",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "How did you do it?"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"char_416_zumama_1#6\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "char_416_zumama_1#6",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"Archosauria A\"]  Just as you saw, Great Chief, it moved just like that!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Just as you saw, Great Chief, it moved just like that!"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_416_zumama_1#6\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "char_416_zumama_1#6",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"Archosauria B\"]  We plugged this tube here and that one there!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "We plugged this tube here and that one there!"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_072\", name2=\"char_416_zumama_1#6\", focus=1)]",
        "type": "character",
        "name": "avg_npc_072",
        "name2": "char_416_zumama_1#6",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"Archosauria C\"]  Just like how we built the Big Ugly!",
        "type": "dialog",
        "speaker": "Archosauria C",
        "content": "Just like how we built the Big Ugly!"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1"
    },
    {
        "id": 78,
        "raw": "[name=\"Eunectes\"]  Good.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "Good."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_074\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "avg_npc_074",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"High Priest\"]  Ahh, the Big Ugly, once but a pile of scrap metal, is now truly majestic. I'm so moved. It makes me want to sing!",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "Ahh, the Big Ugly, once but a pile of scrap metal, is now truly majestic. I'm so moved. It makes me want to sing!"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"avg_npc_074\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "avg_npc_074",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"Eunectes\"]  But you're bad at singing.",
        "type": "dialog",
        "speaker": "Eunectes",
        "content": "But you're bad at singing."
    },
    {
        "id": 83,
        "raw": "[Character(name=\"avg_npc_074\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "avg_npc_074",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"High Priest\"]  I'm sorry?! Fine. I think I have a real talent for singing though... Terrible!",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "I'm sorry?! Fine. I think I have a real talent for singing though... Terrible!"
    },
    {
        "id": 85,
        "raw": "[name=\"High Priest\"]  Oh? Maybe it's a style problem.",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "Oh? Maybe it's a style problem."
    },
    {
        "id": 86,
        "raw": "[name=\"High Priest\"]  Yes, that's right. That has to be the reason. Next time, I'll try singing in bel canto!",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "Yes, that's right. That has to be the reason. Next time, I'll try singing in bel canto!"
    },
