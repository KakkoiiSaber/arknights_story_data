    {
        "id": 18,
        "raw": "[name=\"Archosauria A\"]  Tch, another failure. He's flying in a nice arc this time though.",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Tch, another failure. He's flying in a nice arc this time though."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"Archosauria B\"]  Where did he land?",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "Where did he land?"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"Archosauria A\"]  No idea. He'll come running back after a while anyway. Let's keep going.",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "No idea. He'll come running back after a while anyway. Let's keep going."
    },
    {
        "id": 23,
        "raw": "[name=\"Archosauria A\"]  Okay, what does this tube connect to——",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Okay, what does this tube connect to——"
    },
    {
        "id": 24,
        "raw": "[name=\"Archosauria A\"]  Haha, this looks like a good port, I'm plugging it in!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Haha, this looks like a good port, I'm plugging it in!"
    },
    {
        "id": 25,
        "raw": "[name=\"Archosauria A\"]  Hey, is it working?",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "Hey, is it working?"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"Archosauria B\"]  No. Do you even know what you're doing?!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "No. Do you even know what you're doing?!"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"Archosauria A\"]  What are you yelling for? I've never seen an engine like this before, just let me experiment a bit!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "What are you yelling for? I've never seen an engine like this before, just let me experiment a bit!"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"Archosauria B\"]  I want to try!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "I want to try!"
    },
    {
        "id": 32,
        "raw": "[name=\"Archosauria B\"]  I think this tube goes here. What does this button do then? Who cares, just press it.",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "I think this tube goes here. What does this button do then? Who cares, just press it."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"Archosauria A\"]  You're the one who's messing around! It obviously goes here!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "You're the one who's messing around! It obviously goes here!"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"avg_npc_072\")]",
        "type": "character",
        "name": "avg_npc_072"
    },
    {
        "id": 36,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 37,
        "raw": "[name=\"Archosauria C\"]  What are you two idiots doing? The gas pipe isn't even connected. Let me do it!",
        "type": "dialog",
        "speaker": "Archosauria C",
        "content": "What are you two idiots doing? The gas pipe isn't even connected. Let me do it!"
    },
    {
        "id": 38,
        "raw": "[name=\"Archosauria C\"]  Hmm, what does the gas pipe go to... Never mind, this port looks bigger, this is probably it!",
        "type": "dialog",
        "speaker": "Archosauria C",
        "content": "Hmm, what does the gas pipe go to... Never mind, this port looks bigger, this is probably it!"
    },
    {
        "id": 39,
        "raw": "[name=\"Archosauria C\"]  Hey, somebody try to start it!",
        "type": "dialog",
        "speaker": "Archosauria C",
        "content": "Hey, somebody try to start it!"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"avg_npc_074\")]",
        "type": "character",
        "name": "avg_npc_074"
    },
    {
        "id": 41,
        "raw": "[name=\"High Priest\"]  I'm back!",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "I'm back!"
    },
    {
        "id": 42,
        "raw": "[name=\"High Priest\"]  Youngsters nowadays really have no respect for their elders. No one bothered to look for me after I got blasted away!",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "Youngsters nowadays really have no respect for their elders. No one bothered to look for me after I got blasted away!"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Archosauria A\"]  But, High Priest, you always come back safe. Everyone's gotten used to it!",
        "type": "dialog",
        "speaker": "Archosauria A",
        "content": "But, High Priest, you always come back safe. Everyone's gotten used to it!"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"Archosauria B\"]  Stop wasting time, let's get on with the testing!",
        "type": "dialog",
        "speaker": "Archosauria B",
        "content": "Stop wasting time, let's get on with the testing!"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_074\")]",
        "type": "character",
        "name": "avg_npc_074"
    },
    {
        "id": 48,
        "raw": "[name=\"High Priest\"]  Yeah, yeah, alright.",
        "type": "dialog",
        "speaker": "High Priest",
        "content": "Yeah, yeah, alright."
    },
