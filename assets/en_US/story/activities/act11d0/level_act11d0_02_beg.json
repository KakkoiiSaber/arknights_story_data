    },
    {
        "id": 177,
        "raw": "[name=\"Suzuran\"]  Why is everyone quiet all of a sudden?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Why is everyone quiet all of a sudden?"
    },
    {
        "id": 178,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 179,
        "raw": "[name=\"Folinic\"]  No, this isn't right... Who's that talking to them?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "No, this isn't right... Who's that talking to them?"
    },
    {
        "id": 180,
        "raw": "[Character(name=\"avg_npc_069#4\")]",
        "type": "character",
        "name": "avg_npc_069#4.png"
    },
    {
        "id": 181,
        "raw": "[name=\"Tatjana\"]  Huh?",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Huh?"
    },
    {
        "id": 182,
        "raw": "[Character(name=\"char_345_folnic_1#3\")]",
        "type": "character",
        "name": "char_345_folnic_1#3.png"
    },
    {
        "id": 183,
        "raw": "[name=\"Folinic\"]  Behind them, in the very back, there's—",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Behind them, in the very back, there's—"
    },
    {
        "id": 184,
        "raw": "[name=\"Folinic\"]  A Sarkaz...?",
