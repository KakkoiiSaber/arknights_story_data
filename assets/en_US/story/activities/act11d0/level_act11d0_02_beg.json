    },
    {
        "id": 156,
        "raw": "[name=\"Suzuran\"]  There's... a lot of people up ahead. Is that where everyone is?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "There's... a lot of people up ahead. Is that where everyone is?"
    },
    {
        "id": 157,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 158,
        "raw": "[name=\"Folinic\"]  Shouldn't you do something?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Shouldn't you do something?"
    },
    {
        "id": 159,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 160,
        "raw": "[name=\"Tatjana\"]  Peaceful assembly isn't a crime. That alone isn't grounds to detain them.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Peaceful assembly isn't a crime. That alone isn't grounds to detain them."
    },
    {
        "id": 161,
        "raw": "[Character(name=\"avg_npc_069#4\")]",
        "type": "character",
        "name": "avg_npc_069#4.png"
    },
    {
        "id": 162,
        "raw": "[name=\"Tatjana\"]  They're looking this way...",
