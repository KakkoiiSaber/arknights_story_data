    {
        "id": 15,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"Suzuran\"]  Folinic... Are you angry?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Folinic... Are you angry?"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"Folinic\"]  The way they were acting, I know what it means. I know it all too well...",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "The way they were acting, I know what it means. I know it all too well..."
    },
    {
        "id": 19,
        "raw": "[name=\"Folinic\"]  But... But Atro wouldn't get herself into trouble. She knows Leithanien better than any of us!",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "But... But Atro wouldn't get herself into trouble. She knows Leithanien better than any of us!"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_358_lisa_1#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Suzuran\"]  Yeah! I'm sure she's fine!",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Yeah! I'm sure she's fine!"
    },
    {
        "id": 22,
        "raw": "[name=\"Suzuran\"]  At least, I hope...",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "At least, I hope..."
    },
