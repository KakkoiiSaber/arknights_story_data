        "focus": 2
    },
    {
        "id": 130,
        "raw": "[name=\"Folinic\"]  What was Atro doing here?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "What was Atro doing here?"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 132,
        "raw": "[name=\"Tatjana\"]  Um... Treating the local Infected, giving psychological counseling to those who were suffering.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Um... Treating the local Infected, giving psychological counseling to those who were suffering."
    },
    {
        "id": 133,
        "raw": "[name=\"Tatjana\"]  Wolumonde was unable to avoid the Great Rift because of an error the Catastrophe Messengers made, and we suffered immensely for it.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Wolumonde was unable to avoid the Great Rift because of an error the Catastrophe Messengers made, and we suffered immensely for it."
    },
    {
        "id": 134,
        "raw": "[name=\"Tatjana\"]  Dr. Atro could have left, but she decided to stay. After Wolumonde moored here, she set up a temporary medical facility to better serve the Infected.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Dr. Atro could have left, but she decided to stay. After Wolumonde moored here, she set up a temporary medical facility to better serve the Infected."
    },
    {
        "id": 135,
        "raw": "[name=\"Tatjana\"]  Dr. Atro... is their hero.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Dr. Atro... is their hero."
    },
    {
        "id": 136,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#2",
        "focus": 2
    },
    {
        "id": 137,
        "raw": "[name=\"Folinic\"]  ...She was just doing what she had to do.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "...She was just doing what she had to do."
    },
    {
        "id": 138,
        "raw": "[name=\"Folinic\"]  She's always been better at practical work than rote learning.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "She's always been better at practical work than rote learning."
    },
    {
        "id": 139,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#2",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"Tatjana\"]  ......",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "......"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"Folinic\"]  Heh. I can see her face right now, looking so self-satisfied. That's Atro.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Heh. I can see her face right now, looking so self-satisfied. That's Atro."
    },
    {
        "id": 143,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1",
        "focus": 1
    },
    {
        "id": 144,
        "raw": "[name=\"Tatjana\"]  This is the first time you've smiled since coming to Wolumonde.",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "This is the first time you've smiled since coming to Wolumonde."
    },
    {
        "id": 145,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 146,
        "raw": "[name=\"Folinic\"]  Is it?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Is it?"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 148,
        "raw": "[name=\"Suzuran\"]  You've been pretty scary all day long, Folinic.",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "You've been pretty scary all day long, Folinic."
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 150,
        "raw": "[name=\"Folinic\"]  Oh...",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Oh..."
    },
    {
