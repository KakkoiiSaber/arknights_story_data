    {
        "id": 30,
        "raw": "[name=\"Folinic\"]  Gah—!",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Gah—!"
    },
    {
        "id": 31,
        "raw": "[name=\"Folinic\"]  Are the rioters... just attacking at random?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Are the rioters... just attacking at random?"
    },
    {
        "id": 32,
