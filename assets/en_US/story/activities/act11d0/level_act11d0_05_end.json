    {
        "id": 122,
        "raw": "[Character(name=\"char_358_lisa_1#3\",fadetime=1,block=true)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 123,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 124,
        "raw": "[name=\"Suzuran\"]  Mr. Severin, we have a lot of wounded. We need help...!",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Mr. Severin, we have a lot of wounded. We need help...!"
    },
    {
        "id": 125,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 126,
        "raw": "[name=\"Severin\"]  Medics, you are to obey this young Vulpo's every word. Able-bodied youth will help as well.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Medics, you are to obey this young Vulpo's every word. Able-bodied youth will help as well."
    },
    {
        "id": 127,
        "raw": "[Character(name=\"avg_npc_065\")]",
        "type": "character",
        "name": "avg_npc_065.png"
    },
    {
        "id": 128,
        "raw": "[name=\"Townsfolk\"]  Yes, sir!",
        "type": "dialog",
        "speaker": "Townsfolk",
        "content": "Yes, sir!"
    },
    {
        "id": 129,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 130,
        "raw": "[Character]",
        "type": "character"
