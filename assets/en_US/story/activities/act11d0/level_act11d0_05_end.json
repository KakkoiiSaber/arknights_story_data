        "name": "avg_npc_067.png",
        "name2": "avg_npc_067",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"Armed Infected B\"]  Shut it! This thing isn't easy to use! Luckily I studied at the conservatory!",
        "type": "dialog",
        "speaker": "Armed Infected B",
        "content": "Shut it! This thing isn't easy to use! Luckily I studied at the conservatory!"
