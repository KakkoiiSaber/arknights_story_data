        "type": "character",
        "name": "avg_npc_067.png",
        "name2": "avg_npc_067",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"Armed Infected A\"]  Hey! It wasn't easy to get that gizmo. You better shoot straight!",
        "type": "dialog",
        "speaker": "Armed Infected A",
        "content": "Hey! It wasn't easy to get that gizmo. You better shoot straight!"
