    {
        "id": 120,
        "raw": "[name=\"Suzuran\"]  —An explosion?! Another attack?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "—An explosion?! Another attack?"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"avg_npc_065\")]",
        "type": "character",
        "name": "avg_npc_065.png"
    },
    {
        "id": 122,
        "raw": "[name=\"Townsfolk\"]  Schultz! Help! We need help!",
        "type": "dialog",
        "speaker": "Townsfolk",
        "content": "Schultz! Help! We need help!"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 124,
        "raw": "[name=\"Severin\"]  Slow down. What happened?",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Slow down. What happened?"
    },
    {
        "id": 125,
        "raw": "[Character(name=\"avg_npc_065\")]",
        "type": "character",
        "name": "avg_npc_065.png"
    },
    {
        "id": 126,
        "raw": "[name=\"Townsfolk\"]  They, they activated those town defense things! They exploded, and everything's burning, they—!",
        "type": "dialog",
        "speaker": "Townsfolk",
        "content": "They, they activated those town defense things! They exploded, and everything's burning, they—!"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 128,
        "raw": "[name=\"Severin\"]  Calm down!",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Calm down!"
    },
    {
        "id": 129,
        "raw": "[PlaySound(key=\"$rungeneral\", volume=0.6)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_rungeneral.mp3",
        "volume": 0.6
    },
    {
        "id": 130,
        "raw": "[Character(name=\"avg_npc_069#4\")]",
        "type": "character",
        "name": "avg_npc_069#4.png"
    },
    {
        "id": 131,
        "raw": "[name=\"Tatjana\"]  Schultz! The Infected... they've captured all of the Gendarmerie patrolling Zwölftontechnik Strasse! We lost contact with them!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Schultz! The Infected... they've captured all of the Gendarmerie patrolling Zwölftontechnik Strasse! We lost contact with them!"
    },
    {
        "id": 132,
        "raw": "[name=\"Tatjana\"]  They're using the Gramophones to push us back. The whole district is out of control!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "They're using the Gramophones to push us back. The whole district is out of control!"
    },
    {
        "id": 133,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 134,
        "raw": "[name=\"Severin\"]  They shouldn't be so well-organized. Who's leading them?",
        "type": "dialog",
        "speaker": "Severin",
        "content": "They shouldn't be so well-organized. Who's leading them?"
    },
    {
        "id": 135,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 1
    },
    {
        "id": 136,
        "raw": "[name=\"Tatjana\"]  We don't know. But a lot of the non-infected have joined the protest. Wolumonde is completely divided!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "We don't know. But a lot of the non-infected have joined the protest. Wolumonde is completely divided!"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"Severin\"]  Ugh. Damn you, Winterwisps...",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Ugh. Damn you, Winterwisps..."
    },
    {
        "id": 139,
        "raw": "[name=\"Severin\"]  Surround the district. Control the crowd. We have to take the town back.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Surround the district. Control the crowd. We have to take the town back."
    },
    {
        "id": 140,
        "raw": "[name=\"Severin\"]  *Cough* *cough*, *hack* *cough*!",
        "type": "dialog",
        "speaker": "Severin",
        "content": "*Cough* *cough*, *hack* *cough*!"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 1
    },
    {
        "id": 142,
        "raw": "[name=\"Tatjana\"]  Schultz!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Schultz!"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 144,
        "raw": "[name=\"Severin\"]  Damn it... You get back to the Rathaus and sound the alarm. This has devolved into something far worse than just a dispute between the Infected.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Damn it... You get back to the Rathaus and sound the alarm. This has devolved into something far worse than just a dispute between the Infected."
    },
    {
        "id": 145,
        "raw": "[name=\"Severin\"]  I'm putting Wolumonde under martial law. Raise the entire militia.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "I'm putting Wolumonde under martial law. Raise the entire militia."
    },
    {
        "id": 146,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 1
    },
    {
        "id": 147,
        "raw": "[name=\"Tatjana\"]  But if we start killing each other now, Wolumonde won't survive the winter!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "But if we start killing each other now, Wolumonde won't survive the winter!"
    },
    {
        "id": 148,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 149,
        "raw": "[name=\"Severin\"]  I gave you an order!",
        "type": "dialog",
        "speaker": "Severin",
        "content": "I gave you an order!"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"Tatjana\"]  Y-yes sir!",
        "type": "dialog",
        "speaker": "Tatjana",
        "content": "Y-yes sir!"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"Severin\"]  ......",
        "type": "dialog",
        "speaker": "Severin",
        "content": "......"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 155,
        "raw": "[name=\"Severin\"]  As for you Rhodes Islanders... Do what you feel is right.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "As for you Rhodes Islanders... Do what you feel is right."
    },
    {
        "id": 156,
        "raw": "[name=\"Severin\"]  To be frank, I don't have time to keep an eye on you.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "To be frank, I don't have time to keep an eye on you."
    },
    {
        "id": 157,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 158,
        "raw": "[name=\"Folinic\"]  I still need more information.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "I still need more information."
    },
    {
        "id": 159,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 160,
        "raw": "[name=\"Suzuran\"]  B-but we should do what we can to help people first... A lot of innocent civilians are getting caught up in this mess...",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "B-but we should do what we can to help people first... A lot of innocent civilians are getting caught up in this mess..."
    },
    {
        "id": 161,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 162,
        "raw": "[name=\"Folinic\"]  We'll find the killer. That takes priority.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "We'll find the killer. That takes priority."
    },
    {
        "id": 163,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 164,
        "raw": "[name=\"Severin\"]  ...I promise, Wolumonde will provide Rhodes Island with a satisfactory answer.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "...I promise, Wolumonde will provide Rhodes Island with a satisfactory answer."
    },
    {
        "id": 165,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 166,
        "raw": "[name=\"Folinic\"]  I hope you'll keep that promise.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "I hope you'll keep that promise."
    },
    {
        "id": 167,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 168,
        "raw": "[name=\"Severin\"]  If I'm still alive by then.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "If I'm still alive by then."
    },
    {
        "id": 169,
        "raw": "[Dialog]",
        "type": "dialog_marker"
