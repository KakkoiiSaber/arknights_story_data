    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_358_lisa_1#3\")]",
        "type": "character",
        "name": "char_358_lisa_1#3.png"
    },
    {
        "id": 13,
        "raw": "[name=\"Suzuran\"]  Wow, it's echoing through the whole town...",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Wow, it's echoing through the whole town..."
    },
    {
        "id": 14,
