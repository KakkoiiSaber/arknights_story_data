    },
    {
        "id": 55,
        "raw": "[name=\"Severin\"]  Find them.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Find them."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"avg_npc_068\")]",
        "type": "character",
        "name": "avg_npc_068.png"
    },
    {
        "id": 57,
        "raw": "[name=\"Townsfolk\"]  Sure, but then what? Arrest them?",
        "type": "dialog",
        "speaker": "Townsfolk",
        "content": "Sure, but then what? Arrest them?"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 59,
        "raw": "[name=\"Severin\"]  Yes.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Yes."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_068\")]",
        "type": "character",
        "name": "avg_npc_068.png"
    },
    {
        "id": 61,
        "raw": "[name=\"Townsfolk\"]  That'll just stir up even more resentment.",
        "type": "dialog",
        "speaker": "Townsfolk",
        "content": "That'll just stir up even more resentment."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"avg_npc_066\")]",
        "type": "character",
        "name": "avg_npc_066.png"
    },
    {
        "id": 63,
        "raw": "[name=\"Severin\"]  We're doing this to keep them from fomenting animosity between Infected and non-infected. The Winterwisps may well have been behind all this.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "We're doing this to keep them from fomenting animosity between Infected and non-infected. The Winterwisps may well have been behind all this."
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_066\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_066",
        "focus": 1
    },
    {
        "id": 65,
        "raw": "[name=\"Suzuran\"]  Mr. Severin?! Wh-what is this?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Mr. Severin?! Wh-what is this?"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"Severin\"]  It's a Winterwisp ballad, for rituals and funerals.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "It's a Winterwisp ballad, for rituals and funerals."
    },
    {
        "id": 68,
        "raw": "[name=\"Severin\"]  The Winterwisps are responsible for agitating Infected conflicts and leading the partisans to destroy our power plant.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "The Winterwisps are responsible for agitating Infected conflicts and leading the partisans to destroy our power plant."
    },
    {
        "id": 69,
        "raw": "[name=\"Severin\"]  Now is not the time for leniency. They're trying to tell us something.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Now is not the time for leniency. They're trying to tell us something."
    },
    {
        "id": 70,
        "raw": "[name=\"Severin\"]  They wouldn't tip their hand for no reason. There must be others out there in the shadows. Probably casters. Keep an eye out.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "They wouldn't tip their hand for no reason. There must be others out there in the shadows. Probably casters. Keep an eye out."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"Folinic\"]  What exactly is a Winterwisp?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "What exactly is a Winterwisp?"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"Severin\"]  Local Caprinae. They were the people of these mountains, centuries ago.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Local Caprinae. They were the people of these mountains, centuries ago."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"Folinic\"]  What happened to them?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "What happened to them?"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 78,
        "raw": "[name=\"Severin\"]  Wolumonde clashed with the Winterwisp. Nothing more.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "Wolumonde clashed with the Winterwisp. Nothing more."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 80,
        "raw": "[name=\"Folinic\"]  No. There's more to it than that.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "No. There's more to it than that."
    },
    {
        "id": 81,
        "raw": "[name=\"Folinic\"]  Columbia and Rim Billiton, pretty much every country has some kind of history of settler colonialism. There's another force at work here.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Columbia and Rim Billiton, pretty much every country has some kind of history of settler colonialism. There's another force at work here."
    },
    {
        "id": 82,
        "raw": "[name=\"Folinic\"]  You're just looking for a simple answer to dodge the question, aren't you? You'll just leave it as 'conflicts' and 'clashes?'",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "You're just looking for a simple answer to dodge the question, aren't you? You'll just leave it as 'conflicts' and 'clashes?'"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"Severin\"]  I'm not sure I should be talking about this with you. It goes beyond what Rhodes Island has a need to know...",
        "type": "dialog",
        "speaker": "Severin",
        "content": "I'm not sure I should be talking about this with you. It goes beyond what Rhodes Island has a need to know..."
    },
    {
        "id": 85,
        "raw": "[name=\"Severin\"]  A Gendarmerie telling these things to a foreign enterprise will make certain aristocrats very unhappy.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "A Gendarmerie telling these things to a foreign enterprise will make certain aristocrats very unhappy."
    },
    {
        "id": 86,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"Folinic\"]  You're... worried about unhappy aristocrats...?!",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "You're... worried about unhappy aristocrats...?!"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#5",
        "focus": 2
    },
    {
        "id": 89,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=40, fadeout=false)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "40,",
        "fadeout": false
    },
    {
        "id": 90,
        "raw": "[name=\"Folinic\"]  Atro sacrificed herself for you! And you're talking about saving face?!",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Atro sacrificed herself for you! And you're talking about saving face?!"
    },
    {
        "id": 91,
        "raw": "[Character(name=\"char_358_lisa_1#3\")]",
        "type": "character",
        "name": "char_358_lisa_1#3.png"
    },
    {
        "id": 92,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=false)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": false
    },
    {
        "id": 93,
        "raw": "[name=\"Suzuran\"]  M-Miss Folinic! Her sacrifice... shouldn't be ammunition for an argument.",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "M-Miss Folinic! Her sacrifice... shouldn't be ammunition for an argument."
    },
    {
        "id": 94,
        "raw": "[name=\"Suzuran\"]  Mr. Severin...! Can you please stop this manhunt? It's only agitating people. It's only going to make things worse!",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Mr. Severin...! Can you please stop this manhunt? It's only agitating people. It's only going to make things worse!"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_345_folnic_1#3\")]",
        "type": "character",
        "name": "char_345_folnic_1#3.png"
    },
    {
        "id": 96,
        "raw": "[name=\"Folinic\"]  ...",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "..."
    },
    {
        "id": 97,
        "raw": "[name=\"Folinic\"]  No... We're following our only lead. We can't afford to lose it.",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "No... We're following our only lead. We can't afford to lose it."
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_358_lisa_1#3\")]",
        "type": "character",
        "name": "char_358_lisa_1#3.png"
    },
    {
        "id": 99,
        "raw": "[name=\"Suzuran\"]  Huh...?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Huh...?"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_345_folnic_1#3\")]",
        "type": "character",
        "name": "char_345_folnic_1#3.png"
    },
    {
        "id": 101,
        "raw": "[name=\"Folinic\"]  Severin, with as many nomadic cities as there are in Leithanien, do you really think any of those nobles give a shit about you from atop their ivory towers?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Severin, with as many nomadic cities as there are in Leithanien, do you really think any of those nobles give a shit about you from atop their ivory towers?"
    },
    {
        "id": 102,
        "raw": "[name=\"Folinic\"]  Even considering the Great Rift, if a nearby city were to offer support, would there really be a famine?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Even considering the Great Rift, if a nearby city were to offer support, would there really be a famine?"
    },
    {
        "id": 103,
        "raw": "[name=\"Folinic\"]  Severin, look at the situation. See for yourself who is really here to help you!",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Severin, look at the situation. See for yourself who is really here to help you!"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"avg_npc_066\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_066.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 105,
        "raw": "[name=\"Severin\"]  I know... Miss Folinic. I know better than anyone.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "I know... Miss Folinic. I know better than anyone."
    },
    {
        "id": 106,
        "raw": "[name=\"Severin\"]  But I also know Rhodes Island can't help us forever. Once we're safe again and Wolumonde is back on course, I don't want to be getting letters from those ivory towers.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "But I also know Rhodes Island can't help us forever. Once we're safe again and Wolumonde is back on course, I don't want to be getting letters from those ivory towers."
    },
    {
        "id": 107,
        "raw": "[name=\"Severin\"]  You have to understand that.",
        "type": "dialog",
        "speaker": "Severin",
        "content": "You have to understand that."
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 109,
        "raw": "[name=\"Suzuran\"]  But Miss Folinic, we—",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "But Miss Folinic, we—"
    },
    {
        "id": 110,
        "raw": "[stopmusic(fadetime=2)]",
        "type": "stop_music",
        "fadetime": 2
    },
