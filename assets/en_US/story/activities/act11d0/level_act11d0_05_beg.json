    {
        "id": 30,
        "raw": "[name=\"Folinic\"]  What is this... what am I seeing? Are these Originium Arts?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "What is this... what am I seeing? Are these Originium Arts?"
    },
    {
        "id": 31,
        "raw": "[name=\"Folinic\"]  A folk song...? Or a poem? At sunset?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "A folk song...? Or a poem? At sunset?"
    },
    {
        "id": 32,
        "raw": "[name=\"Folinic\"]  Is this a Wolumonde tradition?",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "Is this a Wolumonde tradition?"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"Suzuran\"]  Um... Miss Folinic, do you understand the lyrics?",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "Um... Miss Folinic, do you understand the lyrics?"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"Folinic\"]  No... is that the Leithanian tongue? It doesn't sound like modern Leithanian pronunciation...",
        "type": "dialog",
        "speaker": "Folinic",
        "content": "No... is that the Leithanian tongue? It doesn't sound like modern Leithanian pronunciation..."
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_358_lisa_1\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"Suzuran\"]  But... it sounds nice.",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "But... it sounds nice."
    },
    {
        "id": 39,
        "raw": "[name=\"Suzuran\"]  It reminds me of looking out over the plains from the bridge of Rhodes Island for the very first time. It's melodious... ancient...",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "It reminds me of looking out over the plains from the bridge of Rhodes Island for the very first time. It's melodious... ancient..."
    },
    {
        "id": 40,
        "raw": "[name=\"Suzuran\"]  This is... also Arts... but the same kind as the ancient Arts of Higashi!",
        "type": "dialog",
        "speaker": "Suzuran",
        "content": "This is... also Arts... but the same kind as the ancient Arts of Higashi!"
    },
