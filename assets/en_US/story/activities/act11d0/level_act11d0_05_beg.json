        "type": "dialog_marker"
    },
    {
        "id": 15,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 16,
        "raw": "A pale blue light spills over the desolate streets. In amongst the flickers of illumination, are people and the lives they led.",
        "type": "narration",
        "content": "A pale blue light spills over the desolate streets. In amongst the flickers of illumination, are people and the lives they led."
    },
    {
        "id": 17,
        "raw": "The two stand alone in an otherwise empty town. The hazy song weaves into a web, and the sun continues to set.",
        "type": "narration",
        "content": "The two stand alone in an otherwise empty town. The hazy song weaves into a web, and the sun continues to set."
    },
