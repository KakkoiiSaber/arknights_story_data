    {
        "id": 11,
        "raw": "[name=\"D.D.D.\"]That's our Team LUNG wRATh! If it's a fight you want, they ain't gonna disappoint!",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "That's our Team LUNG wRATh! If it's a fight you want, they ain't gonna disappoint!"
    },
    {
        "id": 12,
        "raw": "[name=\"D.D.D.\"]They took down all the guys that surrounded them with ease!",
