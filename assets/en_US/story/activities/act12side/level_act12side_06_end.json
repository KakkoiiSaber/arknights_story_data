    },
    {
        "id": 23,
        "raw": "[name=\"Ch'en\"]What are you looking at? Get swimming.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "What are you looking at? Get swimming."
    },
    {
        "id": 24,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"Lin Yühsia\"]I'm trying to figure something out.",
        "type": "dialog",
        "speaker": "Lin Yühsia",
        "content": "I'm trying to figure something out."
    },
    {
        "id": 26,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"Ch'en\"]What?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "What?"
    },
    {
        "id": 28,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"Lin Yühsia\"]Now that both of us suspect Ernesto, and he's behind us, perhaps we should have prioritized taking him out.",
        "type": "dialog",
        "speaker": "Lin Yühsia",
        "content": "Now that both of us suspect Ernesto, and he's behind us, perhaps we should have prioritized taking him out."
    },
    {
        "id": 30,
        "raw": "[character(name=\"avg_1013_spchen_1#2\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#2",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"Ch'en\"]You have a point.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "You have a point."
    },
    {
        "id": 32,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"Ch'en\"]But we aren't sure he's actually behind any of this yet.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "But we aren't sure he's actually behind any of this yet."
    },
    {
        "id": 34,
        "raw": "[name=\"Ch'en\"]Besides, no matter who's behind it, it's clear they don't want us to win the competition.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Besides, no matter who's behind it, it's clear they don't want us to win the competition."
    },
    {
        "id": 35,
        "raw": "[name=\"Ch'en\"]But as a goal, that's not specific enough.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "But as a goal, that's not specific enough."
    },
    {
        "id": 36,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"Lin Yühsia\"]Right. In other words, they don't want us to get on the ship.",
        "type": "dialog",
        "speaker": "Lin Yühsia",
        "content": "Right. In other words, they don't want us to get on the ship."
    },
    {
        "id": 38,
        "raw": "[character(name=\"avg_1013_spchen_1#7\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#7",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"Ch'en\"]Enough chit-chat. We're losing.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Enough chit-chat. We're losing."
    },
    {
        "id": 40,
        "raw": "[character(name=\"avg_1013_spchen_1#7\",name2=\"avg_npc_196_1#5\",focus=2)]",
        "type": "character",
        "name": "avg_1013_spchen_1#7",
        "name2": "avg_npc_196_1#5",
        "focus": 2
    },
    {
        "id": 41,
        "raw": "[name=\"Lin Yühsia\"]Us? No way.",
        "type": "dialog",
        "speaker": "Lin Yühsia",
        "content": "Us? No way."
    },
    {
        "id": 42,
        "raw": "[name=\"Lin Yühsia\"]You go on ahead. I haven't done something like this in a while. I need to prepare first.",
        "type": "dialog",
