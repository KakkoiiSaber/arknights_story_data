    {
        "id": 16,
        "raw": "[name=\"D.D.D.\"]All the other teams up front are successively passing through, too.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "All the other teams up front are successively passing through, too."
    },
    {
        "id": 17,
        "raw": "[name=\"D.D.D.\"]And as for our most arresting LUNG wRATh, Ernesto has already been toppled at the rear, and our staff have judged that he's lost the ability to fight on.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "And as for our most arresting LUNG wRATh, Ernesto has already been toppled at the rear, and our staff have judged that he's lost the ability to fight on."
    },
    {
        "id": 18,
        "raw": "[name=\"D.D.D.\"]Ch'en and Lin, our two heroines, still show no signs of movement.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "Ch'en and Lin, our two heroines, still show no signs of movement."
    },
    {
        "id": 19,
        "raw": "[name=\"D.D.D.\"]Could this truly be where it all ends?!",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "Could this truly be where it all ends?!"
