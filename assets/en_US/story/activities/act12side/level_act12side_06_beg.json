    {
        "id": 11,
        "raw": "[name=\"D.D.D.\"]Contestant Mizuki gave up obstructing the ambush, headed on top of the arms shop ruins where Ch'en and Lin are buried, halted for a moment and then vanished without a trace.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "Contestant Mizuki gave up obstructing the ambush, headed on top of the arms shop ruins where Ch'en and Lin are buried, halted for a moment and then vanished without a trace."
    },
    {
        "id": 12,
        "raw": "[name=\"D.D.D.\"]All of our surveillance and drones have been unable to locate him.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "All of our surveillance and drones have been unable to locate him."
    },
    {
        "id": 13,
        "raw": "[name=\"D.D.D.\"]And of the teams at the head, Honey Summer has become the first to reach the swimming checkpoint.",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "And of the teams at the head, Honey Summer has become the first to reach the swimming checkpoint."
    },
