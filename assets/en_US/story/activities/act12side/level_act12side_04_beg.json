        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"Sideroca\"]They ran into some trouble, but I heard over the screen that the Doctor took a group on vacation somewhere.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "They ran into some trouble, but I heard over the screen that the Doctor took a group on vacation somewhere."
    },
    {
        "id": 73,
        "raw": "[name=\"Sideroca\"]It's only right that Eyjafjalla and the rest of us get one too.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "It's only right that Eyjafjalla and the rest of us get one too."
    },
