        "type": "character",
        "name": "avg_npc_199_1#7.png"
    },
    {
        "id": 68,
        "raw": "[name=\"Sussurro\"]Everyone should have the right to enjoy the sunshine.",
        "type": "dialog",
        "speaker": "Sussurro",
        "content": "Everyone should have the right to enjoy the sunshine."
    },
