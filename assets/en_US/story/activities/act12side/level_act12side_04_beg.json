        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"Sideroca\"]We came here on legitimate grounds, too. Rhodes Island wants to set up a branch office here, and we've never been able to get the mayor's approval.",
        "type": "dialog",
        "speaker": "Sideroca",
