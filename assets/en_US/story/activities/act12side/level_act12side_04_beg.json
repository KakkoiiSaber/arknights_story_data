    {
        "id": 47,
        "raw": "[name=\"Eyjafjalla\"]What a beautiful sea...",
        "type": "dialog",
        "speaker": "Eyjafjalla",
        "content": "What a beautiful sea..."
    },
    {
        "id": 48,
        "raw": "[character(name=\"avg_npc_190_1#6\",name2=\"avg_npc_206_1#8\",focus=2)]",
        "type": "character",
        "name": "avg_npc_190_1#6.png",
        "name2": "avg_npc_206_1#8",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Sideroca\"]It really is.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "It really is."
    },
    {
        "id": 50,
        "raw": "[name=\"Sideroca\"]Looks like we wasted nothing coming to this city.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "Looks like we wasted nothing coming to this city."
    },
    {
        "id": 51,
        "raw": "[character(name=\"avg_npc_190_1#6\",name2=\"avg_npc_206_1#8\",focus=2)]",
        "type": "character",
        "name": "avg_npc_190_1#6.png",
        "name2": "avg_npc_206_1#8",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"Sideroca\"]How about we sit down right here, then.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "How about we sit down right here, then."
    },
    {
        "id": 53,
        "raw": "[character(name=\"avg_npc_190_1#4\",name2=\"avg_npc_206_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_190_1#4.png",
        "name2": "avg_npc_206_1#1",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"Eyjafjalla\"]We could also head back. I'm worried we'll be a nuisance to the others here...",
        "type": "dialog",
        "speaker": "Eyjafjalla",
        "content": "We could also head back. I'm worried we'll be a nuisance to the others here..."
    },
    {
        "id": 55,
        "raw": "[character(name=\"avg_npc_190_1#4\",name2=\"avg_npc_206_1#8\",focus=2)]",
        "type": "character",
        "name": "avg_npc_190_1#4.png",
        "name2": "avg_npc_206_1#8",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"Sideroca\"]Don't let it weigh on you. This city doesn't seem to mind the Infected too much.",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "Don't let it weigh on you. This city doesn't seem to mind the Infected too much."
    },
    {
        "id": 57,
        "raw": "[character(name=\"avg_npc_190_1#4\",name2=\"avg_npc_206_1#7\",focus=2)]",
        "type": "character",
        "name": "avg_npc_190_1#4.png",
        "name2": "avg_npc_206_1#7",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"Sideroca\"]Though it's very plainly not because they're open-minded, but because they don't care...",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "Though it's very plainly not because they're open-minded, but because they don't care..."
    },
    {
        "id": 59,
        "raw": "[character(name=\"avg_npc_190_1#4\",name2=\"avg_npc_206_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_190_1#4.png",
        "name2": "avg_npc_206_1#1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"Sideroca\"]Besides, we have Sussurro with us. We'll be fine, right?",
        "type": "dialog",
        "speaker": "Sideroca",
        "content": "Besides, we have Sussurro with us. We'll be fine, right?"
    },
    {
        "id": 61,
        "raw": "[character(name=\"avg_npc_199_1#1\")]",
        "type": "character",
        "name": "avg_npc_199_1#1.png"
    },
    {
        "id": 62,
        "raw": "[name=\"Sussurro\"]Yes. I'm well aware of Eyjafjalla's condition.",
        "type": "dialog",
        "speaker": "Sussurro",
        "content": "Yes. I'm well aware of Eyjafjalla's condition."
    },
    {
        "id": 63,
        "raw": "[name=\"Sussurro\"]In my honest opinion, you should worry more about yourself than if you're troubling anyone else.",
        "type": "dialog",
        "speaker": "Sussurro",
        "content": "In my honest opinion, you should worry more about yourself than if you're troubling anyone else."
    },
    {
        "id": 64,
        "raw": "[name=\"Sussurro\"]You spend more time indoors than the average person, and that doesn't just have repercussions on your body, but your mental health as well.",
        "type": "dialog",
        "speaker": "Sussurro",
        "content": "You spend more time indoors than the average person, and that doesn't just have repercussions on your body, but your mental health as well."
    },
    {
        "id": 65,
        "raw": "[character(name=\"avg_npc_199_1#6\")]",
        "type": "character",
        "name": "avg_npc_199_1#6.png"
    },
    {
        "id": 66,
        "raw": "[name=\"Sussurro\"]That's why I, as a doctor, endorsed bringing you here, Eyjafjalla.",
        "type": "dialog",
        "speaker": "Sussurro",
        "content": "That's why I, as a doctor, endorsed bringing you here, Eyjafjalla."
    },
