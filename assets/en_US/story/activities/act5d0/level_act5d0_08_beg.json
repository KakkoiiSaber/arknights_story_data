    {
        "id": 6,
        "raw": "[Character(name=\"char_213_mostma_1#4\")]",
        "type": "character",
        "name": "char_213_mostma_1#4.png"
    },
    {
        "id": 7,
        "raw": "[name=\"Mostima\"]   Is everybody okay?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Is everybody okay?"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 9,
        "raw": "[name=\"Bison\"]   Y- yeah. The whole building is gone... what in the world was that...?",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Y- yeah. The whole building is gone... what in the world was that...?"
    },
    {
        "id": 10,
        "raw": "[PlayMusic(intro=\"$penguinlogistics_intro\", key=\"$penguinlogistics_loop\", volume=0.8, crossfade=1.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/act5d0/m_sys_penguinlogistics_intro.mp3",
        "key": "audio/sound_beta_2/music/act5d0/m_sys_penguinlogistics_loop.mp3",
        "volume": "0.8,",
        "crossfade": 1.5
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"Mostima\"]   How about you? You just passed straight through the center of an active Art, it's pretty wild in there.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "How about you? You just passed straight through the center of an active Art, it's pretty wild in there."
    },
    {
        "id": 13,
        "raw": "[name=\"Mostima\"]   Pfft, I just noticed, why did you cut your hair short?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Pfft, I just noticed, why did you cut your hair short?"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"Exusiai\"]   Did you just laugh at me?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Did you just laugh at me?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"Mostima\"]   Our heads are full of sand. Even short hair needs tender love and care.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Our heads are full of sand. Even short hair needs tender love and care."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"Exusiai\"]   I'm fine. Thank you.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "I'm fine. Thank you."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"Mostima\"]   Thank you? It's like we're strangers now.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Thank you? It's like we're strangers now."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"Exusiai\"]   Or it's like I know basic manners.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Or it's like I know basic manners."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"Mostima\"]   Heh. Yeah, I guess that's true.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Heh. Yeah, I guess that's true."
    },
    {
        "id": 26,
        "raw": "[name=\"Mostima\"]   Maybe if you weren't always sleeping during work, playing rock music outside the church, getting the Notarial Hall to chase you three blocks,",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Maybe if you weren't always sleeping during work, playing rock music outside the church, getting the Notarial Hall to chase you three blocks,"
    },
    {
        "id": 27,
        "raw": "[name=\"Mostima\"]   until your old school you accidentally blew up unfurls a big banner the day you leave Laterano, 'Good luck in Lungmen, Exusiai!'",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "until your old school you accidentally blew up unfurls a big banner the day you leave Laterano, 'Good luck in Lungmen, Exusiai!'"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"Exusiai\"]   Oh? Are we up to the part of our reunion where we pick away at old scars? Okay, my turn.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Oh? Are we up to the part of our reunion where we pick away at old scars? Okay, my turn."
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"Mostima\"]   By all means.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "By all means."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"Exusiai\"]   ...Nope. Come to think of it, I don't actually know any dirt on you!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "...Nope. Come to think of it, I don't actually know any dirt on you!"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"Mostima\"]   Good girls shouldn't know too much.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Good girls shouldn't know too much."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"Exusiai\"]   You playing my big sister now?!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "You playing my big sister now?!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#4\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#4",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Mostima\"]   Yeah, pretty much.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Yeah, pretty much."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 41,
        "raw": "[name=\"Bison\"]   ......",
        "type": "dialog",
        "speaker": "Bison",
        "content": "......"
    },
    {
        "id": 42,
        "raw": "[name=\"Bison\"]   (These two seem to get along well. Is it because they're both from Laterano?)",
        "type": "dialog",
        "speaker": "Bison",
        "content": "(These two seem to get along well. Is it because they're both from Laterano?)"
    },
    {
        "id": 43,
        "raw": "[name=\"Bison\"]   (And someone can actually talk over Exusiai...)",
        "type": "dialog",
        "speaker": "Bison",
        "content": "(And someone can actually talk over Exusiai...)"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"Exusiai\"]   Um... Mostima. I've got a little question I need to ask. A teensy weensy tiny little question.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Um... Mostima. I've got a little question I need to ask. A teensy weensy tiny little question."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"Mostima\"]   Yes?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Yes?"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"Exusiai\"]   Why did you come back now?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Why did you come back now?"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"Mostima\"]   Oh, well, lots of reasons. How can I explain it.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Oh, well, lots of reasons. How can I explain it."
    },
    {
        "id": 52,
        "raw": "[name=\"Mostima\"]   First, for work.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "First, for work."
    },
    {
        "id": 53,
        "raw": "[name=\"Mostima\"]   Second, Sauin means lots of sales in Lungmen. Things get pretty exciting.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Second, Sauin means lots of sales in Lungmen. Things get pretty exciting."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"Exusiai\"]   ...all those Sauins we had no idea where you were, you decide to come back this year?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "...all those Sauins we had no idea where you were, you decide to come back this year?"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"Mostima\"]   Let's get to what you're really asking.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Let's get to what you're really asking."
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"Exusiai\"]   *Sigh*... if you know what it is then just tell me already.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "*Sigh*... if you know what it is then just tell me already."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"Mostima\"]   Heh. It's nice to see you all twisted up at a loss for words. Brings back memories.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Heh. It's nice to see you all twisted up at a loss for words. Brings back memories."
    },
    {
        "id": 62,
        "raw": "[name=\"Mostima\"]   And it's probably not right to get into all this stuff in front of our guest.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "And it's probably not right to get into all this stuff in front of our guest."
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_325_bison_1\")]",
        "type": "character",
        "name": "char_325_bison_1.png"
    },
    {
        "id": 64,
        "raw": "[name=\"Bison\"]   Oh... Don't worry about me. I'll hang back here. You two can say what you need to.",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Oh... Don't worry about me. I'll hang back here. You two can say what you need to."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_213_mostma_1#2\")]",
        "type": "character",
        "name": "char_213_mostma_1#2.png"
    },
    {
        "id": 66,
        "raw": "[name=\"Mostima\"]   That's no good. There's still a chance we're being followed.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "That's no good. There's still a chance we're being followed."
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#2\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#2",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"Exusiai\"]   Hey! Don't use Bison as an excuse, you crafty witch!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Hey! Don't use Bison as an excuse, you crafty witch!"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#2",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"Mostima\"]   We should meet up with Texas and the girls first. Who knows how many scary mobsters have eyes on us now.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "We should meet up with Texas and the girls first. Who knows how many scary mobsters have eyes on us now."
    },
    {
        "id": 71,
        "raw": "[name=\"Mostima\"]   Are you always getting into this much trouble when I'm not around?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Are you always getting into this much trouble when I'm not around?"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#2\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#2",
        "focus": 1
    },
    {
        "id": 73,
        "raw": "[name=\"Exusiai\"]   I wouldn't say always. Maybe four days a week? Four or five? Or six or seven or eight?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "I wouldn't say always. Maybe four days a week? Four or five? Or six or seven or eight?"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#4\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#4",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"Mostima\"]   ...Right. Definitely not always.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "...Right. Definitely not always."
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1#4\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1#4",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"Exusiai\"]   What about you? Where did you go?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "What about you? Where did you go?"
    },
    {
        "id": 78,
        "raw": "[name=\"Exusiai\"]   You know, when I saw the boss back there, he told me you already left Lungmen. You know how that made me feel?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "You know, when I saw the boss back there, he told me you already left Lungmen. You know how that made me feel?"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 80,
        "raw": "[name=\"Mostima\"]   All kinds of places. Too many to name.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "All kinds of places. Too many to name."
    },
    {
        "id": 81,
        "raw": "[name=\"Mostima\"]   Down to a tiny village nobody's ever heard of to pick up a letter and then go hiking through a mountain range to chase after a nomadic city. That kind of thing.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Down to a tiny village nobody's ever heard of to pick up a letter and then go hiking through a mountain range to chase after a nomadic city. That kind of thing."
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"Exusiai\"]   Sounds lonely.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Sounds lonely."
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 85,
        "raw": "[name=\"Mostima\"]   But maybe my travelogue will sell well.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "But maybe my travelogue will sell well."
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 87,
        "raw": "[name=\"Bison\"]   Have you been to every country, Mostima?",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Have you been to every country, Mostima?"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 89,
        "raw": "[name=\"Mostima\"]   Most of them. You jealous?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Most of them. You jealous?"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 91,
        "raw": "[name=\"Bison\"]   ...a little. Most Messengers don't get to do things like that.",
        "type": "dialog",
        "speaker": "Bison",
        "content": "...a little. Most Messengers don't get to do things like that."
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"Mostima\"]   You'll get a chance. But don't count on Penguin Logistics. We don't really use common sense.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "You'll get a chance. But don't count on Penguin Logistics. We don't really use common sense."
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 95,
        "raw": "[name=\"Bison\"]   Yeah, I'm well aware by now...",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Yeah, I'm well aware by now..."
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1#5\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1.png",
        "name2": "char_213_mostma_1#5",
        "focus": 2
    },
    {
        "id": 97,
        "raw": "[name=\"Mostima\"]   Sitting in a truck in the middle of the endless desert, staring at the setting sun through the yellow sand... It sounds romantic, but when that romance stretches into hundreds of hours, it starts to wear thin.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Sitting in a truck in the middle of the endless desert, staring at the setting sun through the yellow sand... It sounds romantic, but when that romance stretches into hundreds of hours, it starts to wear thin."
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#5\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#5",
        "focus": 1
    },
    {
        "id": 99,
        "raw": "[name=\"Exusiai\"]   I've never seen a yellow sand sunset, but don't you think it's pretty dusty out here today?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "I've never seen a yellow sand sunset, but don't you think it's pretty dusty out here today?"
    },
    {
        "id": 100,
        "raw": "[name=\"Exusiai\"]   Lungmen's air quality has really dropped in the past few years. They need to add some more air purifiers!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Lungmen's air quality has really dropped in the past few years. They need to add some more air purifiers!"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#2",
        "focus": 2
    },
    {
        "id": 102,
        "raw": "[name=\"Mostima\"]   Air quality...? Maybe.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Air quality...? Maybe."
    },
    {
        "id": 103,
        "raw": "[name=\"Mostima\"]   Exusiai, Bison, I hate to do this, but you two go on...",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Exusiai, Bison, I hate to do this, but you two go on..."
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_325_bison_1#2"
    },
    {
        "id": 105,
        "raw": "[name=\"Bison & Exusiai\"]   Again?",
        "type": "dialog",
        "speaker": "Bison & Exusiai",
        "content": "Again?"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"char_213_mostma_1#3\")]",
        "type": "character",
        "name": "char_213_mostma_1#3.png"
    },
    {
        "id": 107,
        "raw": "[name=\"Mostima\"]   Come on. Don't you think I control my entrances and exits very well?",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Come on. Don't you think I control my entrances and exits very well?"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 109,
        "raw": "[name=\"Exusiai\"]   ...Are you serious?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "...Are you serious?"
    },
    {
        "id": 110,
        "raw": "[Character(name=\"char_103_angel_1#6\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#6.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 111,
        "raw": "[name=\"Exusiai\"]   It's just a few hours for you, but for me...",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "It's just a few hours for you, but for me..."
    },
    {
        "id": 112,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 113,
        "raw": "[name=\"Exusiai\"]   Fine, Mostima! But you better buy me dinner! Really!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Fine, Mostima! But you better buy me dinner! Really!"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"Mostima\"]   I know. I know.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "I know. I know."
    },
    {
        "id": 116,
        "raw": "[name=\"Mostima\"]   Whew. What a night.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "Whew. What a night."
