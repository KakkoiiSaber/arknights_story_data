        "type": "character",
        "name": "char_102_texas_1#2"
    },
    {
        "id": 79,
        "raw": "[name=\"Texas\"]   And yet this is the only time the boss seems to care what the law says.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "And yet this is the only time the boss seems to care what the law says."
    },
