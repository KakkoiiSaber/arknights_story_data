        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 69,
        "raw": "[name=\"Emperor\"]   Hah! See for yourself, little man. Let our firearms expert tell you about it.",
        "type": "dialog",
        "speaker": "Emperor",
        "content": "Hah! See for yourself, little man. Let our firearms expert tell you about it."
