        "name": "char_102_texas_1#2",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 81,
        "raw": "[name=\"Emperor\"]   If nobody follows the rules, our whole society goes to hell, you feel me? Texas, put the top down!",
        "type": "dialog",
        "speaker": "Emperor",
        "content": "If nobody follows the rules, our whole society goes to hell, you feel me? Texas, put the top down!"
