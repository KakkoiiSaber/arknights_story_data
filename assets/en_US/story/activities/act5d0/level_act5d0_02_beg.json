        "name": "char_325_bison_1#2"
    },
    {
        "id": 67,
        "raw": "[name=\"Bison\"]   Is that a gun?! But how are you going to pull the trigger...?",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Is that a gun?! But how are you going to pull the trigger...?"
    },
    {
        "id": 68,
