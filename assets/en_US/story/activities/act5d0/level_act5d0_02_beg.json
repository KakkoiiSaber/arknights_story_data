        "type": "character",
        "name": "char_105_emper",
        "name2": "char_103_angel_1#8",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"Emperor\"]   You can't use live ammo in downtown Lungmen. That's the law.",
        "type": "dialog",
        "speaker": "Emperor",
        "content": "You can't use live ammo in downtown Lungmen. That's the law."
    },
