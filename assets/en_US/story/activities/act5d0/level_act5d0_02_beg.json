        "type": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "id": 73,
        "raw": "[name=\"Bison\"]   You mean... it's a toy?",
        "type": "dialog",
        "speaker": "Bison",
        "content": "You mean... it's a toy?"
