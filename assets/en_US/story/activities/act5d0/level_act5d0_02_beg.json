        "name": "char_105_emper",
        "name2": "char_103_angel_1#8",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"Exusiai\"]   It's more of a slingshot——Ow! Err, it's a peacemaker!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "It's more of a slingshot——Ow! Err, it's a peacemaker!"
