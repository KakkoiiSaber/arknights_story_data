        "type": "character",
        "name": "char_105_emper",
        "name2": "char_103_angel_1#8",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"Exusiai\"]   That's forty-two layers of logistics-grade cardboard, seamlessly glued together with industrial adhesive, driven by the finest rubber bands. It's really a magnificent piece.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "That's forty-two layers of logistics-grade cardboard, seamlessly glued together with industrial adhesive, driven by the finest rubber bands. It's really a magnificent piece."
