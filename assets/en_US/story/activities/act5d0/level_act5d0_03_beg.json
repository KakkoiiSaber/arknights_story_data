        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"Exusiai\"]   And the bad guys are kinda hunting for him. You sure we shouldn't go get him?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "And the bad guys are kinda hunting for him. You sure we shouldn't go get him?"
