        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"Mafioso\"]   Penguin Logistics is here too. Tell the boss as soon as you spot the target.",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "Penguin Logistics is here too. Tell the boss as soon as you spot the target."
