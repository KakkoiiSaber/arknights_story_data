        "content": "Hm."
    },
    {
        "id": 178,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1#5\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1#5",
        "focus": 1
    },
    {
        "id": 179,
        "raw": "[name=\"Bison\"]   Wh- what is it?",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Wh- what is it?"
    },
    {
        "id": 180,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1#5\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1#5",
        "focus": 2
    },
    {
        "id": 181,
        "raw": "[name=\"Mostima\"]   If we keep going like this, we'll end up...",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "If we keep going like this, we'll end up..."
    },
    {
        "id": 182,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1#5\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1#5",
        "focus": 1
    },
    {
        "id": 183,
        "raw": "[name=\"Bison\"]   G- getting caught by the mob?!",
        "type": "dialog",
        "speaker": "Bison",
        "content": "G- getting caught by the mob?!"
    },
    {
        "id": 184,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 185,
        "raw": "[name=\"Mostima\"]   So that's where it was. It's been so many years since I've been back to Lungmen. All the signs are different.",
        "type": "dialog",
        "speaker": "Mostima",
        "content": "So that's where it was. It's been so many years since I've been back to Lungmen. All the signs are different."
    },
    {
        "id": 186,
