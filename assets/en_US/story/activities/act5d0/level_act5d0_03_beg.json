        "name2": "char_201_moeshd#2",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"Emperor\"]   I'm wearin' shades, not binoculars. Gimme some space!",
        "type": "dialog",
        "speaker": "Emperor",
        "content": "I'm wearin' shades, not binoculars. Gimme some space!"
    },
