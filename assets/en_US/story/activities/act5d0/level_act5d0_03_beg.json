    {
        "id": 32,
        "raw": "[name=\"Mafioso\"]   We lost Fronzo's signal. Oughta be around here somewhere!",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "We lost Fronzo's signal. Oughta be around here somewhere!"
    },
