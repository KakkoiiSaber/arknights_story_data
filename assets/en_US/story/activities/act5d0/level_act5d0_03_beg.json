    },
    {
        "id": 40,
        "raw": "[name=\"???\"]   You can come out.",
        "type": "dialog",
        "speaker": "???",
        "content": "You can come out."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"Bison\"]   Oh, okay...",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Oh, okay..."
    },
    {
        "id": 43,
        "raw": "[name=\"Bison\"]   I appreciate your help, but you really don't wanna get mixed up in this. You better go somewhere safe.",
        "type": "dialog",
        "speaker": "Bison",
        "content": "I appreciate your help, but you really don't wanna get mixed up in this. You better go somewhere safe."
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"???\"]   I'd love to. It's been a while since I had a trip to Lungmen. But a job's a job...",
        "type": "dialog",
        "speaker": "???",
        "content": "I'd love to. It's been a while since I had a trip to Lungmen. But a job's a job..."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"???\"]   Considering how I found you, I'm guessing your deal with Penguin Logistics isn't going so well?",
        "type": "dialog",
        "speaker": "???",
        "content": "Considering how I found you, I'm guessing your deal with Penguin Logistics isn't going so well?"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"Bison\"]   ...you could say that.",
        "type": "dialog",
        "speaker": "Bison",
        "content": "...you could say that."
    },
    {
        "id": 50,
        "raw": "[name=\"Bison\"]   Err, who are you, exactly? I get the feeling you're not a typical passer-by.",
        "type": "dialog",
        "speaker": "Bison",
        "content": "Err, who are you, exactly? I get the feeling you're not a typical passer-by."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"???\"]   Calm down. Let's just say I'm not your enemy.",
        "type": "dialog",
        "speaker": "???",
        "content": "Calm down. Let's just say I'm not your enemy."
    },
    {
        "id": 53,
        "raw": "[name=\"???\"]   Whoops, they're coming back. Hide.",
        "type": "dialog",
        "speaker": "???",
        "content": "Whoops, they're coming back. Hide."
