        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"Mafioso A\"]   Mamma mia! Those Penguin bastards got Fronzo! What're we gonna do?",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Mamma mia! Those Penguin bastards got Fronzo! What're we gonna do?"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"Mafioso B\"]   That Bison kid's all alone. This could be our big break.",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "That Bison kid's all alone. This could be our big break."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"Mafioso A\"]   Can we really just yoink him in the middle of downtown Lungmen?",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Can we really just yoink him in the middle of downtown Lungmen?"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"Mafioso B\"]   Mr. Capone says as long as we do it nice and quiet-like, hold off on the guns and bombs, Lungmen won't make a fuss.",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "Mr. Capone says as long as we do it nice and quiet-like, hold off on the guns and bombs, Lungmen won't make a fuss."
    },
    {
        "id": 66,
        "raw": "[name=\"Mafioso B\"]   Nobody's gonna go looking in those filthy old alleyways, eh?",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "Nobody's gonna go looking in those filthy old alleyways, eh?"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"Mafioso A\"]   Then we'll be the backup, you find the kid. Capiche?",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Then we'll be the backup, you find the kid. Capiche?"
    },
