        "type": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "id": 17,
        "raw": "[name=\"Bison\"]   I- I'm okay. What's this...? It's sticky...",
        "type": "dialog",
        "speaker": "Bison",
        "content": "I- I'm okay. What's this...? It's sticky..."
    },
    {
        "id": 18,
        "raw": "[name=\"Bison\"]   A Sauin candle? Real lucky these were here...",
        "type": "dialog",
        "speaker": "Bison",
        "content": "A Sauin candle? Real lucky these were here..."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_213_mostma_1\")]",
        "type": "character",
        "name": "char_213_mostma_1"
    },
    {
        "id": 20,
        "raw": "[name=\"???\"]   You got one stuck in your horn too.",
        "type": "dialog",
        "speaker": "???",
        "content": "You got one stuck in your horn too."
    },
    {
