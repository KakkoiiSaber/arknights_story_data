        "type": "character",
        "name": "char_103_angel_1#4"
    },
    {
        "id": 37,
        "raw": "[name=\"Exusiai\"]   Isn't Mostima here? I think he'll be okay.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Isn't Mostima here? I think he'll be okay."
    },
