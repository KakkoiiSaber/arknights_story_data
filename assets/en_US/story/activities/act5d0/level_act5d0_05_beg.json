        "name": "char_103_angel_1#8",
        "name2": "char_201_moeshd#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"Croissant\"]   Eyes on the road, Exusiai! Hands on ten and two!",
        "type": "dialog",
        "speaker": "Croissant",
        "content": "Eyes on the road, Exusiai! Hands on ten and two!"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 14,
        "raw": "[name=\"Texas\"]   I finally caught you.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "I finally caught you."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_101_sora_1#4",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"Sora\"]   Texas... please... slower next time...",
        "type": "dialog",
        "speaker": "Sora",
        "content": "Texas... please... slower next time..."
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_101_sora_1#4",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"Texas\"]   S- sorry. I was holding back as much as I could.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "S- sorry. I was holding back as much as I could."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_103_angel_1#3\")]",
        "type": "character",
        "name": "char_103_angel_1#3"
    },
    {
        "id": 20,
        "raw": "[name=\"Exusiai\"]   But at least we're all back together. Now we gotta go find the boss.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "But at least we're all back together. Now we gotta go find the boss."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_103_angel_1#7\")]",
        "type": "character",
        "name": "char_103_angel_1#7"
    },
    {
        "id": 22,
        "raw": "[name=\"Exusiai\"]   Wait, why do I feel like we're missing something?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Wait, why do I feel like we're missing something?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 24,
        "raw": "[name=\"Texas\"]   Huh?",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Huh?"
    },
    {
        "id": 25,
        "raw": "[name=\"Texas\"]   ...where's Bison?",
        "type": "dialog",
        "speaker": "Texas",
        "content": "...where's Bison?"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"Exusiai\"]   What? Wasn't he with you guys?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "What? Wasn't he with you guys?"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"Texas\"]   ......",
        "type": "dialog",
        "speaker": "Texas",
        "content": "......"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_101_sora_1#3\")]",
        "type": "character",
        "name": "char_101_sora_1#3"
    },
    {
        "id": 31,
        "raw": "[name=\"Sora\"]   ...We didn't leave him back there did we?",
        "type": "dialog",
        "speaker": "Sora",
        "content": "...We didn't leave him back there did we?"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1#2",
        "name2": "char_101_sora_1#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"Texas\"]   ...We're so used to doing things our own way, leaving him behind was kind of inevitable.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "...We're so used to doing things our own way, leaving him behind was kind of inevitable."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1#2",
        "name2": "char_101_sora_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"Sora\"]   So then we should probably go back and get him?",
        "type": "dialog",
        "speaker": "Sora",
        "content": "So then we should probably go back and get him?"
    },
    {
        "id": 36,
