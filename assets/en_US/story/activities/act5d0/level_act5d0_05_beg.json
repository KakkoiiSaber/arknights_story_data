        "name": "char_103_angel_1#7",
        "name2": "char_201_moeshd#5",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"Croissant\"]   Ain't that the honest truth.",
        "type": "dialog",
        "speaker": "Croissant",
        "content": "Ain't that the honest truth."
    },
    {
        "id": 93,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 94,
        "raw": "[name=\"Texas\"]   What do you want?",
        "type": "dialog",
        "speaker": "Texas",
        "content": "What do you want?"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"avg_npc_028#4\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#4",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 96,
        "raw": "[name=\"Gambino\"]   Hmph... I'm sick of you scuttling around like cockroaches, getting into my business, makin' yourselves a real pain in my tail.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Hmph... I'm sick of you scuttling around like cockroaches, getting into my business, makin' yourselves a real pain in my tail."
    },
    {
        "id": 97,
        "raw": "[name=\"Gambino\"]   That's the value of the little prince here. I got a hostage and all you can do is take me head on.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "That's the value of the little prince here. I got a hostage and all you can do is take me head on."
    },
    {
        "id": 98,
        "raw": "[name=\"Gambino\"]   And that'll save me a lotta trouble. That turns my little penguin problem into a very solvable problem.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "And that'll save me a lotta trouble. That turns my little penguin problem into a very solvable problem."
    },
    {
        "id": 99,
        "raw": "[name=\"Gambino\"]   Penguin Logistics got nowhere to run.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Penguin Logistics got nowhere to run."
    },
    {
