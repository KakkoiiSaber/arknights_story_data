        "raw": "[Character(name=\"char_103_angel_1#4\")]",
        "type": "character",
        "name": "char_103_angel_1#4"
    },
    {
        "id": 55,
        "raw": "[name=\"Exusiai\"]   He's got a lot of guys on his tail.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "He's got a lot of guys on his tail."
    },
    {
        "id": 56,
