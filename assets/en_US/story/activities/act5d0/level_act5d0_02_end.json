        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Jaye\"]   Welcome back. Done with work?",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "Welcome back. Done with work?"
