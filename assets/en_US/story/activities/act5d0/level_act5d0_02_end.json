    {
        "id": 97,
        "raw": "[name=\"Jaye\"]   You're spending Sauin studying?",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "You're spending Sauin studying?"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=2)]",
        "type": "character",
