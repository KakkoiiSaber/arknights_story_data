        "type": "delay",
        "time": 2
    },
    {
        "id": 42,
        "raw": "[name=\"Waai Fu\"]   And this is what you wear to work? Think about how this makes Uncle Tung look.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "And this is what you wear to work? Think about how this makes Uncle Tung look."
