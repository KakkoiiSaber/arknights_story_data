        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"Waai Fu\"]   Where'd that come from? I don't have any change on me.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Where'd that come from? I don't have any change on me."
    },
    {
