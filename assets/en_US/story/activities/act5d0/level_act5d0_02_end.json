        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Jaye\"]   Consider it a token of my appreciation for doing so much to look after my business.",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "Consider it a token of my appreciation for doing so much to look after my business."
    },
