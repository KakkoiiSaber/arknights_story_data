        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"Waai Fu\"]   Sauin is supposed to be about shepherding spirits into the afterlife. Our society has totally corrupted it with consumerism. Respectfully, I will abstain.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Sauin is supposed to be about shepherding spirits into the afterlife. Our society has totally corrupted it with consumerism. Respectfully, I will abstain."
    },
    {
        "id": 100,
        "raw": "[name=\"Waai Fu\"]   Not to mention, I don't get paid that much. I need to get my grades up and nab a scholarship.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Not to mention, I don't get paid that much. I need to get my grades up and nab a scholarship."
