        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"Waai Fu\"]   You could say that. The office said you took some credit. How much?",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "You could say that. The office said you took some credit. How much?"
    },
    {
        "id": 47,
