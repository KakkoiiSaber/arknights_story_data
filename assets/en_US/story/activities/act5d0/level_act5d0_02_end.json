        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 58,
        "raw": "[name=\"Jaye\"]   You always have to get your digs in. This one's on me...",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "You always have to get your digs in. This one's on me..."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"Waai Fu\"]   Okay then. You've definitely gotten better. I wish the other punks took things as seriously as you do.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Okay then. You've definitely gotten better. I wish the other punks took things as seriously as you do."
