        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Male Tourist\"]   The Foodie Guide says the owner is an old man called 'The Godly Finball Uncle.'",
        "type": "dialog",
        "speaker": "Male Tourist",
        "content": "The Foodie Guide says the owner is an old man called 'The Godly Finball Uncle.'"
