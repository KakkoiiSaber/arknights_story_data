        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Waai Fu\"]   All right. Don't mind if I do.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "All right. Don't mind if I do."
    },
    {
        "id": 55,
        "raw": "[name=\"Waai Fu\"]   Hmm...",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Hmm..."
    },
    {
        "id": 56,
        "raw": "[name=\"Waai Fu\"]   It's tasty and all, but isn't this Uncle Tung's stall? A tribute made with borrowed goods is one without meaning.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "It's tasty and all, but isn't this Uncle Tung's stall? A tribute made with borrowed goods is one without meaning."
    },
    {
