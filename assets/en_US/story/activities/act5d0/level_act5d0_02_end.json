        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"Jaye\"]   32.60, rounded. You want to try one?",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "32.60, rounded. You want to try one?"
