    {
        "id": 109,
        "raw": "[name=\"Mafioso\"]   That was a pretty bold thing you did there. Helping out Penguin Logistics...",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "That was a pretty bold thing you did there. Helping out Penguin Logistics..."
    },
    {
