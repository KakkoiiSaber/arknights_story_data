        "content": "......"
    },
    {
        "id": 162,
        "raw": "[name=\"Capone\"]   Right. The Family don't need cowards... the Family don't need rubes.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Right. The Family don't need cowards... the Family don't need rubes."
