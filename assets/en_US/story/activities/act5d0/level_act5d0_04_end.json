        "raw": "[Character(name=\"avg_npc_027\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_027",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 166,
        "raw": "[name=\"Mafioso\"]   Mr. Capone, you know if we can't get the Rat King to see sense...",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "Mr. Capone, you know if we can't get the Rat King to see sense..."
    },
    {
        "id": 167,
        "raw": "[Character(name=\"avg_npc_027#2\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_027#2",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 168,
        "raw": "[name=\"Capone\"]   Listen, if we're gonna do business in Lungmen, can we really let a rat hang over our heads the whole time?",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Listen, if we're gonna do business in Lungmen, can we really let a rat hang over our heads the whole time?"
    },
    {
        "id": 169,
        "raw": "[name=\"Capone\"]   We gotta do something about him sooner or later.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "We gotta do something about him sooner or later."
    },
    {
        "id": 170,
        "raw": "[name=\"Capone\"]   Go down this list of Lungmenites we know have some connection to the Rat King.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Go down this list of Lungmenites we know have some connection to the Rat King."
    },
    {
        "id": 171,
        "raw": "[Character(name=\"avg_npc_027#2\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_027#2",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 172,
        "raw": "[name=\"Mafioso\"]   Alright.",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "Alright."
    },
    {
        "id": 173,
        "raw": "[Character(name=\"avg_npc_027#4\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_027#4",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 174,
        "raw": "[name=\"Capone\"]   We don't have a lotta time here. I need results tonight. Get going.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "We don't have a lotta time here. I need results tonight. Get going."
