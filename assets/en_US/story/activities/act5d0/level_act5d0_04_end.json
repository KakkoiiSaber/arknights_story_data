    },
    {
        "id": 120,
        "raw": "[name=\"Capone\"]   Leave it. Don't mess with the civilians. Don't wanna get us in trouble.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Leave it. Don't mess with the civilians. Don't wanna get us in trouble."
    },
    {
        "id": 121,
        "raw": "[Character(name=\"avg_npc_027#2\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_027#2",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"Mafioso\"]   S- sorry. After him! Everybody get after him!",
        "type": "dialog",
        "speaker": "Mafioso",
        "content": "S- sorry. After him! Everybody get after him!"
    },
    {
        "id": 123,
