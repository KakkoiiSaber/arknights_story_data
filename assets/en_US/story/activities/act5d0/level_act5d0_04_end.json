        "type": "character",
        "name": "avg_npc_027",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 164,
        "raw": "[name=\"Capone\"]   Send some guys into the slums to find the Rat King. Let him know the deal's changed.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Send some guys into the slums to find the Rat King. Let him know the deal's changed."
    },
    {
