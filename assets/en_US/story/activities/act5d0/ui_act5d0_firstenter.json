    {
        "id": 64,
        "raw": "[name=\"???\"]   Can you not have your noisy lovers' quarrel in here? This lousy champagne's doin' enough to piss me off. Grab a bottle and take it outside, aight?",
        "type": "dialog",
        "speaker": "???",
        "content": "Can you not have your noisy lovers' quarrel in here? This lousy champagne's doin' enough to piss me off. Grab a bottle and take it outside, aight?"
    },
