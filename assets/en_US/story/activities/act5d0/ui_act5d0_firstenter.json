        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 75,
        "raw": "[name=\"???\"]   Who gives a shit who you are?",
        "type": "dialog",
        "speaker": "???",
        "content": "Who gives a shit who you are?"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"Gambino\"]   Yo, Capone, do me a favor and torch this tacky joint. Call it 'urban beautification.' Wei Yenwu'll thank us for tearin' down a tastelessly decorated rathole.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Yo, Capone, do me a favor and torch this tacky joint. Call it 'urban beautification.' Wei Yenwu'll thank us for tearin' down a tastelessly decorated rathole."
    },
    {
        "id": 78,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#4",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"Capone\"]   Quiet! Don't provoke him!",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Quiet! Don't provoke him!"
    },
