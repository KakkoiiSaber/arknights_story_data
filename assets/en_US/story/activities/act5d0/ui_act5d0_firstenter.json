    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_028#4\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028#4",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Capone\"]   You backin' out again?",
        "type": "dialog",
        "speaker": "Capone",
        "content": "You backin' out again?"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Gambino\"]   Shut up.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Shut up."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Capone\"]   Shut up? Wish you knew how to shut up last night. Coulda saved us a lotta trouble.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Shut up? Wish you knew how to shut up last night. Coulda saved us a lotta trouble."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[CameraShake(duration=0.4, xstrength=0, ystrength=8, vibrato=30, randomness=30, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.4,",
        "xstrength": "0,",
        "ystrength": "8,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 31,
        "raw": "[name=\"Gambino\"]   You been in Lungmen a long time, Capone. Maybe you need a reminder in how you talk to me, the boss.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "You been in Lungmen a long time, Capone. Maybe you need a reminder in how you talk to me, the boss."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Capone\"]   Sit down, you moron. It's thanks to that temper of yours that business in Siracusa's so lousy.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Sit down, you moron. It's thanks to that temper of yours that business in Siracusa's so lousy."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"Gambino\"]   You been here seven or eight years, and what've you done besides learn some Lungmen swearings? You stood here and watched our channels dry up?",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "You been here seven or eight years, and what've you done besides learn some Lungmen swearings? You stood here and watched our channels dry up?"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"Capone\"]   I'm the one who got us a supporter last night. Try as you did to cock it up.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "I'm the one who got us a supporter last night. Try as you did to cock it up."
    },
    {
        "id": 38,
        "raw": "[name=\"Capone\"]   And besides, here in Lungmen, you and me are equals, 'boss.'",
        "type": "dialog",
        "speaker": "Capone",
        "content": "And besides, here in Lungmen, you and me are equals, 'boss.'"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"Gambino\"]   The way this Rat King runs the show here, ain't it just the old worn out Siracusan tricks?",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "The way this Rat King runs the show here, ain't it just the old worn out Siracusan tricks?"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"Capone\"]   If only you could play a good Siracusan hand worth a damn.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "If only you could play a good Siracusan hand worth a damn."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Gambino\"]   Too bad you're the worst card in it.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Too bad you're the worst card in it."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"Capone\"]   We got a role to play in Lungmen. Think about it: we got a tired, broken down city with a rich underworld. It could be a new home for the Family.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "We got a role to play in Lungmen. Think about it: we got a tired, broken down city with a rich underworld. It could be a new home for the Family."
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"Gambino\"]   Only Siracusa can truly respect us, Capone. Don't forget the shame of being driven out of our home with our tails between our legs.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Only Siracusa can truly respect us, Capone. Don't forget the shame of being driven out of our home with our tails between our legs."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"Capone\"]   You can't eat honor.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "You can't eat honor."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Gambino\"]   Hmph.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Hmph."
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Capone\"]   Wei Yenwu set some rules for this city. As long as we don't break 'em, we can run our rackets here just like before. Lungmen needs a little 'legitimate business.'",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Wei Yenwu set some rules for this city. As long as we don't break 'em, we can run our rackets here just like before. Lungmen needs a little 'legitimate business.'"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"Gambino\"]   ...I ain't seen you in years and I'm already gettin' sick of you.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "...I ain't seen you in years and I'm already gettin' sick of you."
    },
    {
        "id": 57,
        "raw": "[Character(name=\"avg_npc_028\",name2=\"avg_npc_027#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"Capone\"]   Same same, boss.",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Same same, boss."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"Gambino\"]   You...!",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "You...!"
    },
