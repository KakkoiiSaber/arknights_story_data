        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027\",focus=2)]",
        "type": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"Capone\"]   Hey... ain't this guy...?",
        "type": "dialog",
        "speaker": "Capone",
        "content": "Hey... ain't this guy...?"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"avg_npc_028#3\")]",
        "type": "character",
        "name": "avg_npc_028#3"
    },
    {
        "id": 73,
        "raw": "[name=\"Gambino\"]   ...This is what we get since we left Siracusa. Nobody knows you're Sicilian.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "...This is what we get since we left Siracusa. Nobody knows you're Sicilian."
    },
