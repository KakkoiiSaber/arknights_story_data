        "type": "character",
        "name": "avg_npc_028#3"
    },
    {
        "id": 66,
        "raw": "[name=\"Gambino\"]   Get outta here. This don't concern you.",
        "type": "dialog",
        "speaker": "Gambino",
        "content": "Get outta here. This don't concern you."
    },
    {
        "id": 67,
