        "type": "character"
    },
    {
        "id": 68,
        "raw": "[name=\"???\"]   Watch your tone. I'm the boss in here.",
        "type": "dialog",
        "speaker": "???",
        "content": "Watch your tone. I'm the boss in here."
    },
    {
        "id": 69,
        "raw": "[name=\"???\"]   We got a one-stop funeral service, if you're interested. 20% off if you both die together.",
        "type": "dialog",
        "speaker": "???",
        "content": "We got a one-stop funeral service, if you're interested. 20% off if you both die together."
    },
    {
