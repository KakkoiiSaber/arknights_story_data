    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_243_waaifu_1#2\")]",
        "type": "character",
        "name": "char_243_waaifu_1#2.png"
    },
    {
        "id": 41,
        "raw": "[name=\"Waai Fu\"]   ...Can I help you?",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "...Can I help you?"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"Mafioso B\"]   (Hold up. Check the mug over there. I got a bad feeling about him.)",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "(Hold up. Check the mug over there. I got a bad feeling about him.)"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"Mafioso A\"]   (Some Lungmen triad? Mr. Capone says they're a bunch of pushovers.)",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "(Some Lungmen triad? Mr. Capone says they're a bunch of pushovers.)"
    },
    {
        "id": 46,
        "raw": "[name=\"Mafioso A\"]   I got a question for ya.",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "I got a question for ya."
    },
    {
        "id": 47,
        "raw": "[name=\"Mafioso A\"]   We don't want any trouble, right? Just give us a clean answer and we'll be on our way.",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "We don't want any trouble, right? Just give us a clean answer and we'll be on our way."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"Jaye\"]   ...There's blood on your knuckles.",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "...There's blood on your knuckles."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"Mafioso A\"]   Oh, pardon me. I was cleaning out the trash earlier.",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Oh, pardon me. I was cleaning out the trash earlier."
    },
    {
        "id": 52,
        "raw": "[name=\"Mafioso A\"]   But a couple of upright citizens like yourselves, you ain't trash, are you?",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "But a couple of upright citizens like yourselves, you ain't trash, are you?"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#2",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Waai Fu\"]   Is that a threat?",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Is that a threat?"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#2",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"Mafioso A\"]   You're a smart girl, you can figure it out.",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "You're a smart girl, you can figure it out."
    },
    {
        "id": 57,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"Waai Fu\"]   Then I refuse to help you.",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Then I refuse to help you."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"Mafioso B\"]   ...refuse?",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "...refuse?"
    },
    {
        "id": 61,
        "raw": "[name=\"Mafioso B\"]   I think that came out wrong, girly.",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "I think that came out wrong, girly."
    },
    {
        "id": 62,
        "raw": "[name=\"Mafioso B\"]   It sounded like you said you were dumpster garbage eager to get beaten half to death in that alleyway over there?",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "It sounded like you said you were dumpster garbage eager to get beaten half to death in that alleyway over there?"
    },
    {
