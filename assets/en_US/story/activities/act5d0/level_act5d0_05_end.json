        "name": "char_272_strong_1.png"
    },
    {
        "id": 64,
        "raw": "[name=\"Jaye\"]   Waai Fu, I'm pretty sure that scream I just heard was...",
        "type": "dialog",
        "speaker": "Jaye",
        "content": "Waai Fu, I'm pretty sure that scream I just heard was..."
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"Waai Fu\"]   Was 'garbage,' the word you just used?",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Was 'garbage,' the word you just used?"
    },
    {
        "id": 67,
        "raw": "[name=\"Waai Fu\"]   Because one must be thorough and prepared for all eventualities, I will ask one more question: is that how you refer to the people here?",
        "type": "dialog",
        "speaker": "Waai Fu",
        "content": "Because one must be thorough and prepared for all eventualities, I will ask one more question: is that how you refer to the people here?"
