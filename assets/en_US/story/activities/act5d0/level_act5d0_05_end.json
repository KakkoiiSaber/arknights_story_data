    {
        "id": 13,
        "raw": "[name=\"Mafioso A\"]   Tell us where the Rat King is and nobody has to die!",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Tell us where the Rat King is and nobody has to die!"
    },
    {
        "id": 14,
        "raw": "[name=\"Slum Dweller\"]   Wh- what?! What's a Rat King... I don't even know what that is!",
        "type": "dialog",
        "speaker": "Slum Dweller",
        "content": "Wh- what?! What's a Rat King... I don't even know what that is!"
    },
    {
        "id": 15,
        "raw": "[name=\"Mafioso A\"]   I dare you to say 'what' again...!",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "I dare you to say 'what' again...!"
    },
    {
        "id": 16,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 17,
        "raw": "[name=\"Mafioso B\"]   Hey, Mr. Capone said not to rough up civilians...",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "Hey, Mr. Capone said not to rough up civilians..."
    },
    {
        "id": 18,
        "raw": "[name=\"Mafioso A\"]   Does this piece of shit look like a civilian to you? I bet you're Infected, ain't you, cazzo? You still wanna play dumb?!",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Does this piece of shit look like a civilian to you? I bet you're Infected, ain't you, cazzo? You still wanna play dumb?!"
    },
    {
        "id": 19,
        "raw": "[name=\"Slum Dweller\"]   P- please! Don't hurt me! I really don't know anything!",
        "type": "dialog",
        "speaker": "Slum Dweller",
        "content": "P- please! Don't hurt me! I really don't know anything!"
    },
    {
        "id": 20,
        "raw": "[name=\"Mafioso A\"]   Cat got your tongue?!",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Cat got your tongue?!"
    },
    {
        "id": 21,
        "raw": "[name=\"Slum Dweller\"]   Ng... gah... glehh...",
        "type": "dialog",
        "speaker": "Slum Dweller",
        "content": "Ng... gah... glehh..."
    },
    {
        "id": 22,
        "raw": "[name=\"Mafioso B\"]   C'mon, forget about this one. It ain't worth it.",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "C'mon, forget about this one. It ain't worth it."
    },
    {
        "id": 23,
        "raw": "[name=\"Mafioso B\"]   Checking our list, looks like the next lucky contestant is some poor finball hawker. Lives right around here.",
        "type": "dialog",
        "speaker": "Mafioso B",
        "content": "Checking our list, looks like the next lucky contestant is some poor finball hawker. Lives right around here."
    },
    {
        "id": 24,
        "raw": "[name=\"Mafioso A\"]   Sounds like a waste of time.",
        "type": "dialog",
        "speaker": "Mafioso A",
        "content": "Sounds like a waste of time."
    },
    {
        "id": 25,
        "raw": "[name=\"Slum Dweller\"]   Gah... aaagh! They broke... my arm... those sons of...",
        "type": "dialog",
        "speaker": "Slum Dweller",
        "content": "Gah... aaagh! They broke... my arm... those sons of..."
    },
    {
        "id": 26,
        "raw": "[name=\"Slum Dweller\"]   I have to... tell them...",
        "type": "dialog",
        "speaker": "Slum Dweller",
        "content": "I have to... tell them..."
