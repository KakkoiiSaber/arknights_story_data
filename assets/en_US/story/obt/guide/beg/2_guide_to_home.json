        "content": "A-Amiya!"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_016_medic\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_016_medic",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"Amiya\"]   What's the matter?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "What's the matter?"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_016_medic\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_016_medic",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"Medic\"]   It's... it's a call from Rhodes Island!",
        "type": "dialog",
        "speaker": "Medic",
        "content": "It's... it's a call from Rhodes Island!"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_002_amiya_1#6\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#6",
        "focus": -1
    },
    {
        "id": 114,
        "raw": "[name=\"Amiya\"]   Are our communications back on? Is it Dr. Kal'tsit...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Are our communications back on? Is it Dr. Kal'tsit...?"
    },
    {
        "id": 115,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=0.5, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 116,
