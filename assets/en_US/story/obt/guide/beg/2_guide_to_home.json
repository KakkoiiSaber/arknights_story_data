        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"Dobermann\"]   What are you spacing out for? You almost got yourself killed!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "What are you spacing out for? You almost got yourself killed!"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"Guard\"]   I'm... I'm sorry!",
        "type": "dialog",
        "speaker": "Guard",
        "content": "I'm... I'm sorry!"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"Dobermann\"]   Quick! Get back into formation!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Quick! Get back into formation!"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"Guard\"]   Yessir!",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Yessir!"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]   Dobermann! You made it!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Dobermann! You made it!"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"Dobermann\"]   It's an emergency. My team was attacked by Reunion as well.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "It's an emergency. My team was attacked by Reunion as well."
    },
    {
        "id": 54,
        "raw": "[name=\"Dobermann\"]   I rushed over to join you as soon as I could.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I rushed over to join you as soon as I could."
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"Amiya\"]   Why would Reunion attack us...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Why would Reunion attack us...?"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"Dobermann\"]   An organization made up of the Infected... I've always thought they were a bit extreme...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "An organization made up of the Infected... I've always thought they were a bit extreme..."
    },
    {
        "id": 59,
        "raw": "[name=\"Dobermann\"]   ...and now they've resorted to violence, and in an Ursus city no less? That's a death wish.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...and now they've resorted to violence, and in an Ursus city no less? That's a death wish."
    },
    {
        "id": 60,
        "raw": "[name=\"Dobermann\"]   The situation is only going to get more chaotic from here on out.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "The situation is only going to get more chaotic from here on out."
    },
    {
        "id": 61,
        "raw": "[name=\"Dobermann\"]   Amiya, we need to leave Chernobog right now.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Amiya, we need to leave Chernobog right now."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1#1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#1",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"Amiya\"]   Okay. We've already rescued the Doctor, so we can retreat according to plan.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Okay. We've already rescued the Doctor, so we can retreat according to plan."
    },
    {
        "id": 64,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 66,
        "raw": "[name=\"Dobermann\"]    ...And this is Dr. {@nickname}?",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...And this is Dr. {@nickname}?"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 68,
        "raw": "[name=\"Amiya\"]   Yes.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Yes."
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 70,
        "raw": "[name=\"Dobermann\"]    Dr. {@nickname}, you probably don't know who I am, but you know Amiya. For your safety...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Dr. {@nickname}, you probably don't know who I am, but you know Amiya. For your safety..."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"Amiya\"]   No, no...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "No, no..."
    },
    {
        "id": 73,
        "raw": "[name=\"Amiya\"]   Um, Dobermann, Doctor isn't doing very well right now.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Um, Dobermann, Doctor isn't doing very well right now."
    },
    {
        "id": 74,
        "raw": "[name=\"Amiya\"]   To put it simply, Doctor... has amnesia.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "To put it simply, Doctor... has amnesia."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"Dobermann\"]    Amnesia?",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Amnesia?"
    },
    {
        "id": 77,
        "raw": "[name=\"Dobermann\"]    ...What are you going to do now? Weren't you planning to transfer leadership to—",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...What are you going to do now? Weren't you planning to transfer leadership to—"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 79,
        "raw": "[name=\"Amiya\"]   Doctor still has the capacity to command.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Doctor still has the capacity to command."
    },
    {
        "id": 80,
        "raw": "[name=\"Amiya\"]   ...At least, I've confirmed that from the previous battle.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...At least, I've confirmed that from the previous battle."
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"Dobermann\"]   ...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "..."
    },
    {
        "id": 83,
        "raw": "[name=\"Dobermann\"]   I can't bring myself to trust a stranger so easily.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I can't bring myself to trust a stranger so easily."
    },
    {
        "id": 84,
        "raw": "[name=\"Dobermann\"]   But I trust you, Amiya.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "But I trust you, Amiya."
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 86,
        "raw": "[name=\"Amiya\"]   ...I understand.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...I understand."
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 88,
        "raw": "[name=\"Dobermann\"]   Dr. {@nickname}, I am Dobermann, captain of Op Team E1.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Dr. {@nickname}, I am Dobermann, captain of Op Team E1."
    },
