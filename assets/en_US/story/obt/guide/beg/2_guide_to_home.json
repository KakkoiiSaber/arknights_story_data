        "yScaleTo": "1.8,",
        "xTo": "-200,",
        "duration": "75,",
        "block": false
    },
    {
        "id": 97,
        "raw": "[name=\"Amiya\"]   But... since we're cut off from Dr. Kal'tsit, Dobermann and I have lead our separate teams westward to a rendezvous point before confirming our signal to retreat.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But... since we're cut off from Dr. Kal'tsit, Dobermann and I have lead our separate teams westward to a rendezvous point before confirming our signal to retreat."
    },
    {
        "id": 98,
        "raw": "[name=\"Amiya\"]   That is, assuming everything goes according to plan.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "That is, assuming everything goes according to plan."
    },
    {
        "id": 99,
        "raw": "[name=\"Dobermann\"]    It'd be nice if things went that smoothly.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "It'd be nice if things went that smoothly."
    },
    {
        "id": 100,
        "raw": "[name=\"Dobermann\"]    Today is our last opportunity to get you out of here, Dr. {@nickname}.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Today is our last opportunity to get you out of here, Dr. {@nickname}."
    },
    {
        "id": 101,
        "raw": "[name=\"Dobermann\"]    But... I have a bad feeling about this.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "But... I have a bad feeling about this."
    },
