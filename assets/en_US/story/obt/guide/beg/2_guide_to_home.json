        "focus": 1
    },
    {
        "id": 122,
        "raw": "[name=\"Amiya\"]   PRTS...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "PRTS...?"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_002_amiya_1#1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#1",
        "focus": -1
    },
    {
        "id": 124,
        "raw": "[name=\"PRTS\"]   The Emergency Neural Connection Request System was activated.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "The Emergency Neural Connection Request System was activated."
    },
    {
        "id": 125,
        "raw": "[name=\"PRTS\"]   Interference has also been detected from Rhodes Island's end, and only partial Neural Network connection is possible.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Interference has also been detected from Rhodes Island's end, and only partial Neural Network connection is possible."
    },
    {
        "id": 126,
        "raw": "[name=\"PRTS\"]   Currently unable to establish communication with Kal'tsit, who has yet to return to Rhodes Island.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Currently unable to establish communication with Kal'tsit, who has yet to return to Rhodes Island."
    },
    {
        "id": 127,
        "raw": "[name=\"PRTS\"]   Your safety is confirmed; therefore, my mission is now complete.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Your safety is confirmed; therefore, my mission is now complete."
    },
    {
        "id": 128,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 129,
        "raw": "[name=\"Dobermann\"]   This piece of...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "This piece of..."
    },
    {
        "id": 130,
        "raw": "[name=\"Dobermann\"]   Do we really have time for this...?",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Do we really have time for this...?"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"char_002_amiya_1#1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#1",
        "focus": -1
    },
    {
        "id": 132,
        "raw": "[name=\"PRTS\"]   If you do not need to connect to Rhodes Island, communication will be severed momentarily.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "If you do not need to connect to Rhodes Island, communication will be severed momentarily."
    },
    {
        "id": 133,
        "raw": "[name=\"PRTS\"]   I am sincerely sorry for having interrupted your party.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "I am sincerely sorry for having interrupted your party."
    },
    {
        "id": 134,
        "raw": "[Character(name=\"char_002_amiya_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#5",
        "focus": 1
    },
    {
        "id": 135,
        "raw": "[name=\"Amiya\"]   Wait, wait! Don't hang up, I need your help still.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Wait, wait! Don't hang up, I need your help still."
    },
    {
        "id": 136,
        "raw": "[name=\"Amiya\"]   Dobermann, Doctor still needs some assistance.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Dobermann, Doctor still needs some assistance."
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 138,
        "raw": "[name=\"Dobermann\"]   I know, but make it quick.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I know, but make it quick."
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_002_amiya_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#5",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"Amiya\"]   Doctor, PRTS is also one of our... partners. It will show you what to do next.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Doctor, PRTS is also one of our... partners. It will show you what to do next."
    },
    {
        "id": 141,
        "raw": "[name=\"Amiya\"]   Time is of the essence, so I'm going to reconnect you to the Rhodes Island backup system.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Time is of the essence, so I'm going to reconnect you to the Rhodes Island backup system."
    },
    {
        "id": 142,
        "raw": "[name=\"Amiya\"]   This way, we'll have an edge in battle.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "This way, we'll have an edge in battle."
    },
    {
        "id": 143,
        "raw": "[name=\"Amiya\"]   It's different from giving verbal commands and might be a bit hard to get used to, but once you learn how to use it, the entire operation will be much smoother.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's different from giving verbal commands and might be a bit hard to get used to, but once you learn how to use it, the entire operation will be much smoother."
    },
    {
        "id": 144,
        "raw": "[name=\"Amiya\"]   ...Please trust me. Just like how you used to.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Please trust me. Just like how you used to."
    },
    {
        "id": 145,
        "raw": "[name=\"Amiya\"]   PRTS... Let's start.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "PRTS... Let's start."
    },
    {
        "id": 146,
        "raw": "[Character(name=\"char_002_amiya_1#1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#1",
        "focus": -1
    },
    {
        "id": 147,
        "raw": "[name=\"PRTS\"]   Identity verification required. Select verification method.",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Identity verification required. Select verification method."
    },
    {
        "id": 148,
        "raw": "[Character(name=\"char_002_amiya_1#2\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "focus": 1
    },
    {
        "id": 149,
        "raw": "[name=\"Amiya\"]   Ah, Doctor... Please say something.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Ah, Doctor... Please say something."
