        "type": "character",
        "name": "char_002_amiya_1#6",
        "focus": -1
    },
    {
        "id": 117,
        "raw": "[name=\"???\"]   Sorry, but not quite.",
        "type": "dialog",
        "speaker": "???",
        "content": "Sorry, but not quite."
    },
