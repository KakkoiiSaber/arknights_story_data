        "speaker": "Franka",
        "content": "Haha!"
    },
    {
        "id": 96,
        "raw": "[name=\"Franka\"]   Did you really think you could ambush us from there?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Did you really think you could ambush us from there?"
    },
