    {
        "id": 72,
        "raw": "[name=\"Franka\"]   The ruins are empty. The high ground is currently undefended.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "The ruins are empty. The high ground is currently undefended."
    },
    {
        "id": 73,
        "raw": "[name=\"Franka\"]   That's curious, does Reunion not have any commanders?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "That's curious, does Reunion not have any commanders?"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 75,
        "raw": "[name=\"Amiya\"]   Franka, is something wrong?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Franka, is something wrong?"
