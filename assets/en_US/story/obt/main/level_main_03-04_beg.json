        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 118,
        "raw": "[name=\"Amiya\"]   Good, continue pressuring the enemy. Don't let Reunion stage a counterattack!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Good, continue pressuring the enemy. Don't let Reunion stage a counterattack!"
