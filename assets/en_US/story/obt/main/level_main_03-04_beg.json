    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 36,
        "raw": "[name=\"Franka\"]   Nothing but sand and rocks in this wasteland. It's got all the makings of one of those movie showdowns.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Nothing but sand and rocks in this wasteland. It's got all the makings of one of those movie showdowns."
    },
    {
        "id": 37,
        "raw": "[name=\"Franka\"]   The only thing that's missing is the enemy, huh?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "The only thing that's missing is the enemy, huh?"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Ch'en\"]   Hoshiguma, stay here and back up Rhodes Island.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Hoshiguma, stay here and back up Rhodes Island."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"Hoshiguma\"]   Hm? Very well.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Hm? Very well."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"Ch'en\"]   I'll take the L.G.D. and change positions.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I'll take the L.G.D. and change positions."
    },
    {
        "id": 44,
        "raw": "[name=\"Ch'en\"]   If this stalemate continues, we won't be able to control Reunion's escape routes.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "If this stalemate continues, we won't be able to control Reunion's escape routes."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"Hoshiguma\"]   Understood.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Understood."
    },
    {
        "id": 47,
        "raw": "[name=\"Hoshiguma\"]   You take care as well.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "You take care as well."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 49,
        "raw": "[name=\"Exusiai\"]   --Wooah, that was a really strong wind.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "--Wooah, that was a really strong wind."
    },
    {
        "id": 50,
        "raw": "[name=\"Exusiai\"]   Ugh... The visibility's getting really poor too, I can barely see ahead of me...",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Ugh... The visibility's getting really poor too, I can barely see ahead of me..."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Franka\"]   Don't go any farther.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Don't go any farther."
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Liskarm\"]   Reunion might wait for us to fall into their trap before they attack again.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Reunion might wait for us to fall into their trap before they attack again."
    },
    {
        "id": 55,
        "raw": "[name=\"Liskarm\"]   We can't let that happen.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We can't let that happen."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_002_amiya_1\",focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Franka\"]  How about this, Amiya.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "How about this, Amiya."
    },
    {
        "id": 58,
        "raw": "[name=\"Franka\"]  Liskarm and I will fight for control over the high ground around here and scout out the enemy.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Liskarm and I will fight for control over the high ground around here and scout out the enemy."
    },
    {
        "id": 59,
        "raw": "[name=\"Franka\"]  Until we notify you, stay in this position.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Until we notify you, stay in this position."
    },
    {
        "id": 60,
        "raw": "[name=\"Franka\"]  Just don't rush out to us even if looks like the fighting is getting intense, Amiya.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Just don't rush out to us even if looks like the fighting is getting intense, Amiya."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_002_amiya_1\",focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"Amiya\"]  I know. I'll make my own judgment call.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I know. I'll make my own judgment call."
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 64,
        "raw": "[name=\"Franka\"]  Doctor, you keep an eye on her too!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Doctor, you keep an eye on her too!"
    },
