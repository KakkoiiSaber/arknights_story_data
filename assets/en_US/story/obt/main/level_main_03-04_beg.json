    {
        "id": 103,
        "raw": "[name=\"Reunion Member\"]   Fall back! Hurry!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Fall back! Hurry!"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 105,
        "raw": "[name=\"Franka\"]   I really thought there'd be more Reunion goons up here. I was even walking on tiptoes.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "I really thought there'd be more Reunion goons up here. I was even walking on tiptoes."
    },
    {
        "id": 106,
        "raw": "[name=\"Franka\"]   Turns out it's just a bunch of cowards. How disappointing.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Turns out it's just a bunch of cowards. How disappointing."
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"Liskarm\"]   You're going to get disappointed over that?!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "You're going to get disappointed over that?!"
    },
    {
        "id": 109,
        "raw": "[name=\"Liskarm\"]   More importantly, we have to go after them! Don't let them get away so easily!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "More importantly, we have to go after them! Don't let them get away so easily!"
    },
    {
        "id": 110,
        "raw": "[name=\"Liskarm\"]   Amiya, what do you think?",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya, what do you think?"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 112,
        "raw": "[name=\"Amiya\"]   I think... it's best not to risk it!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I think... it's best not to risk it!"
    },
    {
        "id": 113,
        "raw": "[name=\"Amiya\"]   Let's let Penguin Logistics stabilize the situation before we decide on the next thing to do.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Let's let Penguin Logistics stabilize the situation before we decide on the next thing to do."
    },
    {
        "id": 114,
        "raw": "[name=\"Amiya\"]   Exusiai, can you prioritize securing the high ground?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Exusiai, can you prioritize securing the high ground?"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 116,
        "raw": "[name=\"Exusiai\"]   Sure thing! I'm on my way!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Sure thing! I'm on my way!"
    },
    {
        "id": 117,
