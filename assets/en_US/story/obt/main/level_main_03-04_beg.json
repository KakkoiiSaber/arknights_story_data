    },
    {
        "id": 30,
        "raw": "[name=\"Hoshiguma\"]   This terrain...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "This terrain..."
    },
    {
        "id": 31,
        "raw": "[name=\"Hoshiguma\"]   Reunion must have lured us here on purpose.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Reunion must have lured us here on purpose."
    },
    {
        "id": 32,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 33,
        "raw": "[Character(fadetime=0)]",
