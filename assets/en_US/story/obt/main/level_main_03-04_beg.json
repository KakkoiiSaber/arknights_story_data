    {
        "id": 6,
        "raw": "[name=\"Exusiai\"]   So, what do you think about Penguin Logistics, Amiya? We're pretty good, aren't we?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "So, what do you think about Penguin Logistics, Amiya? We're pretty good, aren't we?"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_002_amiya_1#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_002_amiya_1#2",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"Amiya\"]   Yeah, you're great!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Yeah, you're great!"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_002_amiya_1#2\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_002_amiya_1#2",
        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"Exusiai\"]   W-woaaah!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "W-woaaah!"
    },
    {
        "id": 11,
        "raw": "[name=\"Exusiai\"]   It feels pretty embarrassing getting complimented by a little girl!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "It feels pretty embarrassing getting complimented by a little girl!"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 13,
        "raw": "[name=\"Texas\"]   Watch your mouth. She's our client.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Watch your mouth. She's our client."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 15,
        "raw": "[name=\"Exusiai\"]   Oops, sorry about that!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Oops, sorry about that!"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 17,
        "raw": "[name=\"Amiya\"]   Don't worry about it. It's you who we should be thanking!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Don't worry about it. It's you who we should be thanking!"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 19,
        "raw": "[name=\"Texas\"]   So, we've met up with Rhodes Island.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "So, we've met up with Rhodes Island."
    },
    {
        "id": 20,
        "raw": "[name=\"Texas\"]   What's next?",
        "type": "dialog",
        "speaker": "Texas",
        "content": "What's next?"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_002_amiya_1\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"Amiya\"]   I might need the L.G.D. to come to a decision before I give my input.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I might need the L.G.D. to come to a decision before I give my input."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_002_amiya_1\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"Texas\"]   Is that so...",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Is that so..."
    },
    {
        "id": 25,
        "raw": "[name=\"Texas\"]   I'll ask them to come take a look over here then.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "I'll ask them to come take a look over here then."
    },
