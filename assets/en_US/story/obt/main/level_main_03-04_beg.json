    {
        "id": 76,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 77,
        "raw": "[name=\"Franka\"]   Those place was supposed to be easy to defend but hard to attack.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Those place was supposed to be easy to defend but hard to attack."
    },
    {
        "id": 78,
        "raw": "[name=\"Franka\"]   There's no way that Reunion hasn't set up an ambush...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "There's no way that Reunion hasn't set up an ambush..."
    },
