        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 149,
        "raw": "[name=\"Hoshiguma\"]  Did you get any leads? Or did you want to play with the balls of yarn a bit longer?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Did you get any leads? Or did you want to play with the balls of yarn a bit longer?"
