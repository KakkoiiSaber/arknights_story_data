        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 155,
        "raw": "[name=\"Ch'en\"]  It's as you said. Maybe I did have a bit too much on my mind.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "It's as you said. Maybe I did have a bit too much on my mind."
