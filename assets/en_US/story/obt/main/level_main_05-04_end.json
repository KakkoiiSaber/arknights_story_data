    },
    {
        "id": 51,
        "raw": "[name=\"Hoshiguma\"]  Woah woah, isn't this your own house? Why'd you slice the door open?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Woah woah, isn't this your own house? Why'd you slice the door open?"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_010_chen_1#1\")]",
        "type": "character",
        "name": "char_010_chen_1#1"
    },
    {
        "id": 53,
        "raw": "[name=\"Ch'en\"]  I forgot to bring the key. Besides, Reunion also just opened a hole along the side wall. They might have caused some unexpected damage.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I forgot to bring the key. Besides, Reunion also just opened a hole along the side wall. They might have caused some unexpected damage."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 55,
        "raw": "[name=\"Hoshiguma\"]  That doesn't mean you should— Ah, forget it. If you say so.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "That doesn't mean you should— Ah, forget it. If you say so."
    },
