        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 151,
        "raw": "[name=\"Ch'en\"]  Hard to believe you're still in the mood to crack jokes.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Hard to believe you're still in the mood to crack jokes."
    },
    {
        "id": 152,
