        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 153,
        "raw": "[name=\"Hoshiguma\"]  I think your mood is just a tiny bit better than it was before though.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I think your mood is just a tiny bit better than it was before though."
    },
