        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 159,
        "raw": "[name=\"Ch'en\"]  That's good. That makes our job easier, and we're getting closer to our goal.",
        "type": "dialog",
        "speaker": "Ch'en",
