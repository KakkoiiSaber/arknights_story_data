    {
        "id": 132,
        "raw": "[name=\"Ch'en\"]  Here it is.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Here it is."
    },
    {
        "id": 133,
        "raw": "[name=\"Ch'en\"]  A photo from such a long time ago... I thought it had been lost.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "A photo from such a long time ago... I thought it had been lost."
    },
    {
        "id": 134,
        "raw": "[name=\"Ch'en\"]  Wait, no... could this be what they're searching for?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Wait, no... could this be what they're searching for?"
    },
    {
        "id": 135,
        "raw": "[name=\"Ch'en\"]  What's going on? Why would they be after this? Have you lost your marbles as well?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "What's going on? Why would they be after this? Have you lost your marbles as well?"
    },
    {
        "id": 136,
        "raw": "[name=\"Ch'en\"]  I'll certainly help you, but what are you thinking? Why here, why now?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I'll certainly help you, but what are you thinking? Why here, why now?"
    },
    {
        "id": 137,
