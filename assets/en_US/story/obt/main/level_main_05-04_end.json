    {
        "id": 63,
        "raw": "[name=\"Ch'en\"]  No need to take off your shoes.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "No need to take off your shoes."
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 65,
        "raw": "[name=\"Hoshiguma\"]  Are you serious? Ch'en, answer me honestly, do you hate your old man?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Are you serious? Ch'en, answer me honestly, do you hate your old man?"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"Ch'en\"]  He doesn't deserve to be my father.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "He doesn't deserve to be my father."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"Hoshiguma\"]  Okay.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Okay."
    },
    {
        "id": 70,
        "raw": "[name=\"Hoshiguma\"]  If I remember correctly, you joined the L.G.D. right after you graduated from Victoria and returned to Lungmen.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "If I remember correctly, you joined the L.G.D. right after you graduated from Victoria and returned to Lungmen."
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"Ch'en\"]  I was living in the dorms at the time.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I was living in the dorms at the time."
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"Hoshiguma\"]  So, you never returned here after that.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "So, you never returned here after that."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"Ch'en\"]  I have no lingering attachments to this place.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I have no lingering attachments to this place."
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 78,
        "raw": "[name=\"Hoshiguma\"]  People who say stuff like that usually have a lot more going on in their mind.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "People who say stuff like that usually have a lot more going on in their mind."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 80,
        "raw": "[name=\"Hoshiguma\"]  Anyways, do you have any ideas about what this high-value target might be?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Anyways, do you have any ideas about what this high-value target might be?"
    },
    {
        "id": 81,
