    },
    {
        "id": 22,
        "raw": "[name=\"Hoshiguma\"]  Wasn't your apartment in Tai Bo?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Wasn't your apartment in Tai Bo?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Ch'en\"]  This was the estate that belonged to my biological father's clan. Looks like it's been renovated. So much time has passed that I barely recognize it anymore.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "This was the estate that belonged to my biological father's clan. Looks like it's been renovated. So much time has passed that I barely recognize it anymore."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Hoshiguma\"]  Did you live here before studying abroad in Victoria?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Did you live here before studying abroad in Victoria?"
    },
    {
        "id": 27,
        "raw": "[name=\"Hoshiguma\"]  Even though I've heard that both you and Mister Wei were born to Yan aristocrats, it's really quite astonishing to see a mansion this big.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Even though I've heard that both you and Mister Wei were born to Yan aristocrats, it's really quite astonishing to see a mansion this big."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"Ch'en\"]  Aristocrats? They were, but I'm not.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Aristocrats? They were, but I'm not."
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"Hoshiguma\"]  But, your mansion here... How should I call it?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "But, your mansion here... How should I call it?"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Ch'en\"]  Hmm, the Ch'en Estate will do...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Hmm, the Ch'en Estate will do..."
    },
