    {
        "id": 6,
        "raw": "[name=\"Hoshiguma\"]  All the Reunion members have been captured. None of them knew anything about the specific instructions...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "All the Reunion members have been captured. None of them knew anything about the specific instructions..."
    },
    {
        "id": 7,
        "raw": "[name=\"Hoshiguma\"]  ...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "..."
    },
    {
        "id": 8,
        "raw": "[name=\"Hoshiguma\"]  Ch'en? What are you looking at that has you so absorbed?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Ch'en? What are you looking at that has you so absorbed?"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"Ch'en\"]  Didn't this used to be University Road?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Didn't this used to be University Road?"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"Hoshiguma\"]  Hmm? Seems so. Its name was changed later.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Hmm? Seems so. Its name was changed later."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"Ch'en\"]  I think this is where my home used to be...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I think this is where my home used to be..."
