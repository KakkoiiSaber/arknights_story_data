        "focus": 1
    },
    {
        "id": 157,
        "raw": "[name=\"Hoshiguma\"]  That's right, according to the reports, Reunion is scattered throughout this entire area, and the forces we deployed earlier are driving them out.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "That's right, according to the reports, Reunion is scattered throughout this entire area, and the forces we deployed earlier are driving them out."
