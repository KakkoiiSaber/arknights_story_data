    },
    {
        "id": 6,
        "raw": "[name=\"Amiya\"]   Franka, Liskarm, be aware of our surroundings.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Franka, Liskarm, be aware of our surroundings."
    },
    {
        "id": 7,
        "raw": "[name=\"Amiya\"]   I'll take Misha to Madam Ch'en.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I'll take Misha to Madam Ch'en."
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1"
    },
    {
        "id": 9,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"Ch'en\"]   You're late again.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "You're late again."
    },
    {
        "id": 12,
        "raw": "[name=\"Ch'en\"]   Lungmen doesn't want any more security risks.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Lungmen doesn't want any more security risks."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"Amiya\"]   Madam Ch'en, our escort team was attacked multiple times by Reunion.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Madam Ch'en, our escort team was attacked multiple times by Reunion."
    },
    {
        "id": 15,
        "raw": "[name=\"Amiya\"]   In fact, they're still around as we speak.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "In fact, they're still around as we speak."
    },
    {
        "id": 16,
        "raw": "[name=\"Amiya\"]   It's not safe here. Please take Misha and leave as soon as possible.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's not safe here. Please take Misha and leave as soon as possible."
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 18,
        "raw": "[name=\"Ch'en\"]   And you're Misha?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "And you're Misha?"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1"
    },
    {
        "id": 20,
        "raw": "[name=\"Misha\"]   I am...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I am..."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"Ch'en\"]   From now on, you will follow the L.G.D.'s arrangements.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "From now on, you will follow the L.G.D.'s arrangements."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 24,
        "raw": "[name=\"Ch'en\"]   PC94172, you're in charge of this girl.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "PC94172, you're in charge of this girl."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_015_lmg\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_015_lmg",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"L.G.D. Agent\"]   Come with me.",
        "type": "dialog",
        "speaker": "L.G.D. Agent",
        "content": "Come with me."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_015_lmg\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_015_lmg",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Misha\"]   Amiya...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Amiya..."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"Amiya\"]   It's fine.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's fine."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 32,
        "raw": "[name=\"Amiya\"]   ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"Amiya\"]   Madam Ch'en, I don't know what Lungmen needs her for...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Madam Ch'en, I don't know what Lungmen needs her for..."
    },
    {
        "id": 35,
        "raw": "[name=\"Amiya\"]   But I hope that you can ensure her safety.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But I hope that you can ensure her safety."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"Ch'en\"]   We already treat the Infected very well.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "We already treat the Infected very well."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Amiya\"]   I see...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I see..."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 41,
        "raw": "[name=\"Amiya\"]   But, Misha is not in good health.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But, Misha is not in good health."
    },
    {
        "id": 42,
        "raw": "[name=\"Amiya\"]   We hope that Lungmen will allow her to live in Rhodes Island after this.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We hope that Lungmen will allow her to live in Rhodes Island after this."
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Ch'en\"]   ...I'll send an application to Chief Wei.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...I'll send an application to Chief Wei."
    },
    {
        "id": 45,
        "raw": "[name=\"Ch'en\"]   Lungmen will transfer her to Rhodes Island if she passes our checks with no other issues.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Lungmen will transfer her to Rhodes Island if she passes our checks with no other issues."
    },
    {
        "id": 46,
        "raw": "[name=\"Ch'en\"]   ...That is, if there aren't any problems.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...That is, if there aren't any problems."
    },
    {
        "id": 47,
        "raw": "[name=\"Ch'en\"]   It shouldn't take long.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "It shouldn't take long."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#2\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1#2",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Amiya\"]   Understood.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Understood."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]   ...We'll part ways for the time being, Misha.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...We'll part ways for the time being, Misha."
    },
    {
        "id": 52,
        "raw": "[name=\"Amiya\"]   Rhodes Island welcomes you.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Rhodes Island welcomes you."
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1"
    },
    {
        "id": 54,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 55,
        "raw": "[name=\"Misha\"]   Amiya, while I'm gone, please protect those kids in the slums.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Amiya, while I'm gone, please protect those kids in the slums."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_002_amiya_1#2\",name2=\"char_012_misa_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Amiya\"]   Huh?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Huh?"
    },
    {
        "id": 58,
        "raw": "[name=\"Amiya\"]   ...Oh, that's right.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Oh, that's right."
    },
    {
        "id": 59,
        "raw": "[name=\"Amiya\"]   No problem, you have my promise!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "No problem, you have my promise!"
    },
    {
        "id": 60,
        "raw": "[name=\"Amiya\"]   By the way, Misha...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "By the way, Misha..."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_002_amiya_1#2\",name2=\"char_012_misa_1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"Misha\"]   Hmm?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Hmm?"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_002_amiya_1#2\",name2=\"char_012_misa_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"Amiya\"]   Next time, could you teach me... how to make dolls?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Next time, could you teach me... how to make dolls?"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_002_amiya_1#2\",name2=\"char_012_misa_1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"Misha\"]   ...Hehe.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...Hehe."
    },
    {
        "id": 67,
        "raw": "[name=\"Misha\"]   Mm, sure.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Mm, sure."
