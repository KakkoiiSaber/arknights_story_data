        "raw": "[name=\"Liskarm\"]   ...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "..."
    },
    {
        "id": 83,
        "raw": "[name=\"Liskarm\"]   Amiya.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya."
    },
    {
        "id": 84,
        "raw": "[name=\"Liskarm\"]   The enemy wants to attack the district we're staying at.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "The enemy wants to attack the district we're staying at."
    },
    {
        "id": 85,
        "raw": "[name=\"Franka\"]   Even though I've heard about it, Lungmen's architecture sure is complex!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Even though I've heard about it, Lungmen's architecture sure is complex!"
    },
    {
        "id": 86,
        "raw": "[name=\"Franka\"]   This entire street is actually built on rooftops...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "This entire street is actually built on rooftops..."
    },
    {
        "id": 87,
        "raw": "[name=\"Franka\"]   ...and that's giving our enemies a huge advantage to exploit!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "...and that's giving our enemies a huge advantage to exploit!"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 89,
        "raw": "[name=\"Amiya\"]   Reunion is attacking again...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion is attacking again...!"
    },
    {
        "id": 90,
        "raw": "[name=\"Amiya\"]   They've even chased us all the way out here?!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "They've even chased us all the way out here?!"
    },
