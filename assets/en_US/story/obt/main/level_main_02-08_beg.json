    {
        "id": 73,
        "raw": "[name=\"Franka\"]   Is our mission over now?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Is our mission over now?"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_102_texas_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"Texas\"]   Rhodes Island will have their hands tied the more they get dragged into all this.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Rhodes Island will have their hands tied the more they get dragged into all this."
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_102_texas_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"Franka\"]   But, Lungmen is still keeping a lot of secrets from us.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "But, Lungmen is still keeping a lot of secrets from us."
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"Liskarm\"]   Lungmen doesn't seem to care about us too much...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Lungmen doesn't seem to care about us too much..."
    },
    {
        "id": 80,
        "raw": "[name=\"Liskarm\"]   But the opposite seems to be true for Reunion.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "But the opposite seems to be true for Reunion."
    },
