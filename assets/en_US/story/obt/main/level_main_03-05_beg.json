        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 49,
        "raw": "[name=\"Amiya\"]   I don't know if I should be saying this, but...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I don't know if I should be saying this, but..."
    },
    {
        "id": 50,
        "raw": "[name=\"Amiya\"]   It shouldn't... only be hurting other people.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It shouldn't... only be hurting other people."
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]   I don't want you to see me like this, up close...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I don't want you to see me like this, up close..."
    },
    {
        "id": 52,
        "raw": "[name=\"Amiya\"]   ...I took someone's life.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...I took someone's life."
