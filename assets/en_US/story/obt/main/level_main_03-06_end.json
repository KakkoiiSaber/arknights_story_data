    },
    {
        "id": 101,
        "raw": "[name=\"Misha\"]   Bring Skullshatterer back to life.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Bring Skullshatterer back to life."
    },
    {
        "id": 102,
        "raw": "[name=\"Misha\"]   Skullshatterer isn't dead... Skullshatterer cannot die.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Skullshatterer isn't dead... Skullshatterer cannot die."
    },
