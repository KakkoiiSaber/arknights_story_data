        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"W\"]   Ah, that's right.",
        "type": "dialog",
        "speaker": "W",
        "content": "Ah, that's right."
    },
    {
        "id": 83,
        "raw": "[name=\"W\"]   Even though you saw everything that happened...",
        "type": "dialog",
        "speaker": "W",
        "content": "Even though you saw everything that happened..."
    },
    {
        "id": 84,
        "raw": "[name=\"W\"]   Y'know, ahh, how do I put this... I really don't have the spare energy to drag Skullshatterer back to Chernobog...",
        "type": "dialog",
        "speaker": "W",
        "content": "Y'know, ahh, how do I put this... I really don't have the spare energy to drag Skullshatterer back to Chernobog..."
