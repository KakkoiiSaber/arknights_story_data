        "name": "avg_npc_012"
    },
    {
        "id": 67,
        "raw": "[name=\"Pilot\"]  I can hear you! You don't have to yell!",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "I can hear you! You don't have to yell!"
    },
