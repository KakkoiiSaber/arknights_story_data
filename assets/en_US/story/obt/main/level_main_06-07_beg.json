        "type": "character"
    },
    {
        "id": 69,
        "raw": "[name=\"???\"]  Oh. Hi, Rhodes Islanders. I'm with the L. G. D. I've met up with your team by the ruins!",
        "type": "dialog",
        "speaker": "???",
        "content": "Oh. Hi, Rhodes Islanders. I'm with the L. G. D. I've met up with your team by the ruins!"
    },
