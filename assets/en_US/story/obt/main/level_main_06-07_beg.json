        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 71,
        "raw": "[name=\"Blaze\"]  Didn't the L. G. D. withdraw already? What are you trying to pull?",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Didn't the L. G. D. withdraw already? What are you trying to pull?"
    },
