    },
    {
        "id": 59,
        "raw": "[name=\"Blaze\"]  No problem.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "No problem."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 61,
        "raw": "[name=\"Pilot\"]  I'll wait for you by the entrance to the ruins. Be quick!",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "I'll wait for you by the entrance to the ruins. Be quick!"
    },
    {
        "id": 62,
        "raw": "[name=\"Pilot\"]  Huh? The comms.",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "Huh? The comms."
