        "id": 72,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 73,
        "raw": "[name=\"???\"]  I'm not like that Ch'en lady! Trust me, I can help you.",
        "type": "dialog",
        "speaker": "???",
        "content": "I'm not like that Ch'en lady! Trust me, I can help you."
    },
    {
        "id": 74,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 75,
        "raw": "[name=\"Pilot\"]  And how should we call you?",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "And how should we call you?"
    },
    {
        "id": 76,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 77,
        "raw": "[name=\"???\"]  Use my codename. Call me Officer Swire!",
        "type": "dialog",
        "speaker": "???",
        "content": "Use my codename. Call me Officer Swire!"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 79,
        "raw": "[name=\"Pilot\"]  ......",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "......"
    },
    {
        "id": 80,
        "raw": "[name=\"Pilot\"]  Isn't Swire just your name?",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "Isn't Swire just your name?"
    },
    {
        "id": 81,
        "raw": "[name=\"Pilot\"]  Blaze, can you take care of this? I'm not good with bureaucrats...",
        "type": "dialog",
        "speaker": "Pilot",
        "content": "Blaze, can you take care of this? I'm not good with bureaucrats..."
