    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"Liskarm\"]   Nope. It's clear that they have more reinforcements coming.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Nope. It's clear that they have more reinforcements coming."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 21,
        "raw": "[name=\"Amiya\"]   Curses... We still haven't had a chance to avenge them yet...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Curses... We still haven't had a chance to avenge them yet...!"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"Liskarm\"]   They ended up finding us first.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "They ended up finding us first."
    },
    {
        "id": 24,
        "raw": "[name=\"Liskarm\"]   Franka, look.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Franka, look."
    },
    {
        "id": 25,
        "raw": "[name=\"Liskarm\"]   Over by the east exit, I think those are Reunion's casters hiding over there.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Over by the east exit, I think those are Reunion's casters hiding over there."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"Franka\"]   A lot of them approaching from the central passage as well as from the high-rises to our sides...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "A lot of them approaching from the central passage as well as from the high-rises to our sides..."
    },
    {
        "id": 28,
        "raw": "[name=\"Franka\"]   ...They're trying to sneak over while pretending like they haven't noticed us yet.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "...They're trying to sneak over while pretending like they haven't noticed us yet."
    },
    {
        "id": 29,
        "raw": "[name=\"Franka\"]   But, we're on top of the roof...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "But, we're on top of the roof..."
    },
    {
        "id": 30,
        "raw": "[name=\"Franka\"]   No matter how many they send at us, they'll be doomed if they get knocked over...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "No matter how many they send at us, they'll be doomed if they get knocked over..."
    },
    {
        "id": 31,
        "raw": "[name=\"Franka\"]   I feel like they're insulting my intelligence by launching an attack as brazen as this...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "I feel like they're insulting my intelligence by launching an attack as brazen as this..."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Amiya\"]   Is Reunion launching their offensive?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Is Reunion launching their offensive?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"Amiya\"]   All operators, regroup!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "All operators, regroup!"
