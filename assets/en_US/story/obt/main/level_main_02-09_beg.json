    {
        "id": 13,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"Franka\"]   Am I the only one who thinks that there are more and more of them coming?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Am I the only one who thinks that there are more and more of them coming?"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 16,
        "raw": "[name=\"Reunion Member\"]   Ugh!!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Ugh!!"
    },
    {
        "id": 17,
        "raw": "[Character(fadetime=0.2)]",
