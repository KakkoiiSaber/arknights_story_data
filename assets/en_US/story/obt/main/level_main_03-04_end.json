    },
    {
        "id": 6,
        "raw": "[name=\"Liskarm\"]   ...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "..."
    },
    {
        "id": 7,
        "raw": "[name=\"Liskarm\"]   What the hell...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "What the hell..."
    },
    {
        "id": 8,
        "raw": "[name=\"Liskarm\"]   All that, for only a single Reunion squad...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "All that, for only a single Reunion squad..."
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 10,
        "raw": "[name=\"Franka\"]   And a really big guy.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "And a really big guy."
    },
    {
        "id": 11,
        "raw": "[name=\"Franka\"]   Now that was the highlight. I'm totally exhausted just from dealing with him!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Now that was the highlight. I'm totally exhausted just from dealing with him!"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 13,
        "raw": "[name=\"Hoshiguma\"]   Impossible.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Impossible."
    },
    {
        "id": 14,
        "raw": "[name=\"Hoshiguma\"]   How could so many Infected vanish so quickly?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "How could so many Infected vanish so quickly?"
    },
    {
        "id": 15,
        "raw": "[name=\"Hoshiguma\"]   Was that giant guy just a diversion?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Was that giant guy just a diversion?"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6.png"
    },
    {
        "id": 17,
        "raw": "[name=\"Amiya\"]   ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 18,
        "raw": "[name=\"Amiya\"]   Did Reunion manage to completely evacuate this area in such a short period of time?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Did Reunion manage to completely evacuate this area in such a short period of time?"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 20,
        "raw": "[name=\"Amiya\"]   No... Madam Ch'en should have blocked off their escape route...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "No... Madam Ch'en should have blocked off their escape route..."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"Franka\"]   I'm not seeing the designated waypoint.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "I'm not seeing the designated waypoint."
    },
    {
        "id": 23,
        "raw": "[name=\"Franka\"]   Something... isn't right about this.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Something... isn't right about this."
    },
    {
        "id": 24,
        "raw": "[name=\"Franka\"]   Weeds, ruins, sand dunes...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Weeds, ruins, sand dunes..."
    },
    {
        "id": 25,
        "raw": "[name=\"Franka\"]   All of which are potential spots for an ambush...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "All of which are potential spots for an ambush..."
    },
    {
        "id": 26,
        "raw": "[name=\"Franka\"]   But, I'm not seeing anything.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "But, I'm not seeing anything."
    },
    {
        "id": 27,
        "raw": "[name=\"Franka\"]   No footsteps, no sounds of clothing brushing against plants, no smell of explosives...",
        "type": "dialog",
        "speaker": "Franka",
        "content": "No footsteps, no sounds of clothing brushing against plants, no smell of explosives..."
    },
    {
        "id": 28,
        "raw": "[name=\"Franka\"]   I can't tell what's going on!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "I can't tell what's going on!"
    },
    {
        "id": 29,
        "raw": "[name=\"Franka\"]   Penguin Logistics, wake up and do your job!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Penguin Logistics, wake up and do your job!"
    },
    {
        "id": 30,
        "raw": "[name=\"Franka\"]   This isn't right at all!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "This isn't right at all!"
    },
    {
