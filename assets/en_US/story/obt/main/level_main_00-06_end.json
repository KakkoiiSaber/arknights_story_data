    },
    {
        "id": 6,
        "raw": "[name=\"Dobermann\"]  Ugh... Gahh...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Ugh... Gahh..."
    },
    {
        "id": 7,
        "raw": "[name=\"Dobermann\"]  Those sick bastards! I can't believe they, they...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Those sick bastards! I can't believe they, they..."
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_013_riop\",name2=\"char_002_amiya_1\",focus=1)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"Guard\"]  Those beasts...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Those beasts..."
    },
    {
        "id": 10,
        "raw": "[name=\"Guard\"]  Were they Reunion's doing...?",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Were they Reunion's doing...?"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_013_riop\",name2=\"char_002_amiya_1\",focus=2)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"Amiya\"]   Reunion enslaved infected beasts to use as troops...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion enslaved infected beasts to use as troops..."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 14,
        "raw": "[name=\"Dobermann\"]  No, it's not that simple.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "No, it's not that simple."
    },
    {
        "id": 15,
        "raw": "[name=\"Dobermann\"]  I can feel it, they...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I can feel it, they..."
    },
    {
        "id": 16,
        "raw": "[name=\"Dobermann\"]  Are no mere beasts. In fact, they're more like us...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Are no mere beasts. In fact, they're more like us..."
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop"
    },
    {
        "id": 18,
        "raw": "[name=\"Guard\"]  Instructor Dobermann...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Instructor Dobermann..."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 20,
        "raw": "[name=\"Dobermann\"]  ...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "..."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop"
    },
    {
        "id": 22,
        "raw": "[name=\"Guard\"]  Boss... What should we do?",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Boss... What should we do?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_013_riop\",focus=1)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"Ace\"]   Give them a merciful end.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Give them a merciful end."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_013_riop\",focus=2)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"Guard\"]  Boss...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Boss..."
    },
    {
        "id": 27,
        "raw": "[Character]",
        "type": "character"
    },
