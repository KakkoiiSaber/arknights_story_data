    {
        "id": 29,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 30,
        "raw": "[Blocker(a=0, fadetime=0.6, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.6,",
        "block": true
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_130_doberm_ex\",name2=\"char_014_riope\",focus=2)]",
        "type": "character",
        "name": "char_130_doberm_ex",
        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"Ace\"]   Dobermann, the battle is over.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Dobermann, the battle is over."
    },
    {
        "id": 33,
        "raw": "[name=\"Ace\"]   We also had to face off against Reunion forces.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "We also had to face off against Reunion forces."
    },
    {
        "id": 34,
        "raw": "[name=\"Ace\"]   The Catastrophe is already looming over us. It's likely to break at any moment.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "The Catastrophe is already looming over us. It's likely to break at any moment."
    },
    {
        "id": 35,
        "raw": "[name=\"Ace\"]   Even Chernobog will be reduced to rubble under its direct impact.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Even Chernobog will be reduced to rubble under its direct impact."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 37,
        "raw": "[name=\"Amiya\"]   Reunion is taking advantage of this to sow even more chaos.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion is taking advantage of this to sow even more chaos."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_130_doberm_ex\",name2=\"char_014_riope\",focus=2)]",
        "type": "character",
        "name": "char_130_doberm_ex",
        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Ace\"]   Dobermann, we're out of time.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Dobermann, we're out of time."
    },
    {
        "id": 40,
        "raw": "[name=\"Ace\"]   We might be able to outmaneuver Reunion or stay concealed from Ursus, but we're powerless in the face of a Catastrophe.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "We might be able to outmaneuver Reunion or stay concealed from Ursus, but we're powerless in the face of a Catastrophe."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 42,
        "raw": "[name=\"Dobermann\"]  ...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "..."
    },
    {
        "id": 43,
        "raw": "[name=\"Dobermann\"]  That's enough. Let's go.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "That's enough. Let's go."
    },
    {
        "id": 44,
        "raw": "[name=\"Dobermann\"]  No matter how reckless Reunion's plans are, the most important thing for us...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "No matter how reckless Reunion's plans are, the most important thing for us..."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 46,
        "raw": "[name=\"Amiya\"]   ...is everyone's safety.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...is everyone's safety."
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 48,
        "raw": "[name=\"Dobermann\"]  That's right.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "That's right."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 50,
        "raw": "[name=\"Amiya\"]   Reunion's leaders may see this event as a sign, or even as a means...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion's leaders may see this event as a sign, or even as a means..."
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]   But for me, it signifies that we will be in greater danger from now on.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But for me, it signifies that we will be in greater danger from now on."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1\",name2=\"char_014_riope\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"Ace\"]   Choosing a time like this to incite chaos...",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Choosing a time like this to incite chaos..."
    },
    {
        "id": 54,
        "raw": "[name=\"Ace\"]   Reunion is either insane, or just evil.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Reunion is either insane, or just evil."
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 56,
        "raw": "[name=\"Dobermann\"]  Perhaps, a bit of both.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Perhaps, a bit of both."
    },
