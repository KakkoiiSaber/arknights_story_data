    },
    {
        "id": 46,
        "raw": "[name=\"Child\"]   Woah, you're really strong, ma'am! Thank you!",
        "type": "dialog",
        "speaker": "Child",
        "content": "Woah, you're really strong, ma'am! Thank you!"
    },
