    {
        "id": 65,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 66,
        "raw": "[name=\"Child\"]   What?! That's such a pity. You're so pretty, too...!",
        "type": "dialog",
        "speaker": "Child",
        "content": "What?! That's such a pity. You're so pretty, too...!"
    },
