        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 38,
        "raw": "[name=\"Amiya\"]   Sure.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Sure."
    },
    {
        "id": 39,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
