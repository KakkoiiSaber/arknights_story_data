        "speaker": "Child",
        "content": "(Grrrrrr...)"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 76,
        "raw": "[name=\"Amiya\"]   ...Are you hungry?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Are you hungry?"
    },
    {
        "id": 77,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 78,
        "raw": "[name=\"Child\"]   ...Mmhm...",
        "type": "dialog",
        "speaker": "Child",
        "content": "...Mmhm..."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 80,
        "raw": "[name=\"Amiya\"]   ...Here, take this. It's all I have.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Here, take this. It's all I have."
