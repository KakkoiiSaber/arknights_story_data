        "type": "character",
        "fadetime": 0
    },
    {
        "id": 73,
        "raw": "[name=\"Child\"]   Huh...? I don't get it...",
        "type": "dialog",
        "speaker": "Child",
        "content": "Huh...? I don't get it..."
    },
