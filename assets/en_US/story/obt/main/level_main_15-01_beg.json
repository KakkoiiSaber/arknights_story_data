    },
    {
        "id": 48,
        "raw": "[name=\"Theresis\"]You should not use her to mock me, oh self-proclaimed <i>Creator.</i>",
        "type": "dialog",
        "speaker": "Theresis",
        "content": "You should not use her to mock me, oh self-proclaimed <i>Creator.</i>"
