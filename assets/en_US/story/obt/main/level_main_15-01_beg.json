    },
    {
        "id": 20,
        "raw": "[name=\"Theresis\"]...An eye staring at me.",
        "type": "dialog",
        "speaker": "Theresis",
        "content": "...An eye staring at me."
    },
    {
        "id": 21,
        "raw": "[charslot(slot = \"m\", focus = \"n\")]",
        "type": "charslot"
    },
    {
        "id": 22,
        "raw": "For the first time in his life, Theresis feels a shiver run down his spine.",
        "type": "narration",
        "content": "For the first time in his life, Theresis feels a shiver run down his spine."
    },
    {
        "id": 23,
        "raw": "But it isn't his own instinctive reaction. He feels that a force, a will he can't see is trying to make him submit.",
        "type": "narration",
        "content": "But it isn't his own instinctive reaction. He feels that a force, a will he can't see is trying to make him submit."
    },
