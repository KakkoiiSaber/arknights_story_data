    },
    {
        "id": 56,
        "raw": "[name=\"Theresis\"]Since those who truly control this place dare not face me directly, then Theresa has indeed succeeded. They must have already been subjected to numerous restrictions.",
        "type": "dialog",
        "speaker": "Theresis",
        "content": "Since those who truly control this place dare not face me directly, then Theresa has indeed succeeded. They must have already been subjected to numerous restrictions."
    },
    {
        "id": 57,
        "raw": "[name=\"Theresis\"]Otherwise, those arrogant beings wouldn't have tried to get you to stop me.",
        "type": "dialog",
        "speaker": "Theresis",
        "content": "Otherwise, those arrogant beings wouldn't have tried to get you to stop me."
    },
