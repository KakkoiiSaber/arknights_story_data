        "type": "charslot"
    },
    {
        "id": 50,
        "raw": "The Ascalon standing before him is no illusion. This marvelous space has materialized his memories.",
        "type": "narration",
        "content": "The Ascalon standing before him is no illusion. This marvelous space has materialized his memories."
    },
