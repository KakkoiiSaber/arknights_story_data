        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"Amiya\"]   Just one week...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Just one week...?"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Misha\"]   Mm... A lot of strange people appeared in the city... and then...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Mm... A lot of strange people appeared in the city... and then..."
    },
    {
        "id": 34,
        "raw": "[name=\"Misha\"]   I'm not sure what happened... Everyone started fleeing, so I also...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I'm not sure what happened... Everyone started fleeing, so I also..."
    },
    {
