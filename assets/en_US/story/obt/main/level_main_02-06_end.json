        "name": "char_002_amiya_1#4",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"Amiya\"]   It was Reunion... Reunion attacked Chernobog.",
        "type": "dialog",
        "speaker": "Amiya",
