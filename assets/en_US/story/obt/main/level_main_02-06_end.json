        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"Amiya\"]   Miss Misha, how long have you been in Lungmen?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Miss Misha, how long have you been in Lungmen?"
    },
    {
        "id": 28,
