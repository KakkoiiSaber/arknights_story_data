        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"Amiya\"]   Yes... For now.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Yes... For now."
    },
