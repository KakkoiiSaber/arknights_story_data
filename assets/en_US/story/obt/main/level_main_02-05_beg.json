        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Who is it? !"
    },
    {
        "id": 24,
        "raw": "[name=\"Reunion Member\"]   What do you want?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "What do you want?"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 26,
        "raw": "[name=\"Texas\"]   All of you, come at me. I'm short on time.",
        "type": "dialog",
