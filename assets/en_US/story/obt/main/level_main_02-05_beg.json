    },
    {
        "id": 21,
        "raw": "[name=\"Texas\"]   Hey, masked person over there.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Hey, masked person over there."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
