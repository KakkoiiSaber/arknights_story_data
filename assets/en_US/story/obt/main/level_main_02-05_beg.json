    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_106_franka_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_106_franka_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Franka\"]   Amiya, Texas from Penguin Logistics has returned.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Amiya, Texas from Penguin Logistics has returned."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_106_franka_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"Amiya\"]   Ahh... what a relief!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Ahh... what a relief!"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_102_texas_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"Texas\"]   I have an update here.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "I have an update here."
    },
    {
        "id": 38,
        "raw": "[name=\"Texas\"]   I just took care of some guys who called themselves 'Reunion.'",
        "type": "dialog",
        "speaker": "Texas",
        "content": "I just took care of some guys who called themselves 'Reunion.'"
    },
    {
        "id": 39,
        "raw": "[name=\"Texas\"]   ... But there are a lot more of them coming.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "... But there are a lot more of them coming."
    },
    {
        "id": 40,
        "raw": "[name=\"Texas\"]   Reunion has come out of hiding and are starting to move in groups.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Reunion has come out of hiding and are starting to move in groups."
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_102_texas_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"Amiya\"]   It's as I feared...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's as I feared..."
    },
    {
        "id": 43,
        "raw": "[name=\"Amiya\"]   Reunion has already infiltrated Lungmen through the slums...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion has already infiltrated Lungmen through the slums..."
    },
    {
        "id": 44,
        "raw": "[name=\"Amiya\"]   And their target... is the same as ours.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "And their target... is the same as ours."
    },
    {
        "id": 45,
        "raw": "[name=\"Amiya\"]   Otherwise, there would be no reason for them to come after Rhodes Island.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Otherwise, there would be no reason for them to come after Rhodes Island."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"Liskarm\"]   Miss Misha is carrying secrets that only Lungmen and Reunion know.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Miss Misha is carrying secrets that only Lungmen and Reunion know."
    },
    {
        "id": 48,
        "raw": "[name=\"Liskarm\"]   We're caught in a disadvantageous situation.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We're caught in a disadvantageous situation."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"Franka\"]   Things aren't looking good for us right now.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Things aren't looking good for us right now."
    },
    {
        "id": 51,
        "raw": "[name=\"Franka\"]   I'll really have to poke that officer's pretty little face later to find out what's actually going on.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "I'll really have to poke that officer's pretty little face later to find out what's actually going on."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 53,
        "raw": "[name=\"Texas\"]   ...Anything else to add?",
        "type": "dialog",
        "speaker": "Texas",
        "content": "...Anything else to add?"
    },
    {
        "id": 54,
        "raw": "[name=\"Texas\"]   If not, I'll lead the way. I know exactly where to go!",
        "type": "dialog",
        "speaker": "Texas",
        "content": "If not, I'll lead the way. I know exactly where to go!"
    },
    {
        "id": 55,
        "raw": "[name=\"Texas\"]   Exusiai has confirmed our escape route. I'll now take you through it.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Exusiai has confirmed our escape route. I'll now take you through it."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 57,
        "raw": "[name=\"Amiya\"]   Franka, gather all the squads. We--",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Franka, gather all the squads. We--"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 59,
        "raw": "[name=\"Franka\"]   We... should find cover first.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "We... should find cover first."
    },
    {
        "id": 60,
        "raw": "[name=\"Franka\"]   Reunion is already here.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Reunion is already here."
