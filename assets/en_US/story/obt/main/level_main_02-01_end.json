    },
    {
        "id": 29,
        "raw": "[name=\"Amiya\"]   Let's go, Doctor.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Let's go, Doctor."
    },
    {
        "id": 30,
        "raw": "[name=\"Amiya\"]   We're here.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We're here."
    },
    {
