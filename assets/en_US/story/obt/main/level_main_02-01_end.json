        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 42,
        "raw": "[name=\"Ch'en\"]   ...Who might this be?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...Who might this be?"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"Amiya\"]   Dr. {@nickname} is Rhodes Island's consultant. Dr. Kal'tsit should already have informed you.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Dr. {@nickname} is Rhodes Island's consultant. Dr. Kal'tsit should already have informed you."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 46,
        "raw": "[name=\"Ch'en\"]   Hmm...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Hmm..."
    },
    {
        "id": 47,
        "raw": "[name=\"Ch'en\"]   Well, since everyone is here, I'll now need you to follow me to...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Well, since everyone is here, I'll now need you to follow me to..."
