    },
    {
        "id": 20,
        "raw": "[name=\"Broadcast\"]   Due to the Catastrophe's interference, all air traffic in Lungmen has been stopped. All entrances to District 5 will be closed in two hours.",
        "type": "dialog",
        "speaker": "Broadcast",
        "content": "Due to the Catastrophe's interference, all air traffic in Lungmen has been stopped. All entrances to District 5 will be closed in two hours."
    },
    {
        "id": 21,
        "raw": "[name=\"Broadcast\"]   We thank you for your cooperation during Oripathy inspections.",
        "type": "dialog",
        "speaker": "Broadcast",
        "content": "We thank you for your cooperation during Oripathy inspections."
    },
    {
        "id": 22,
        "raw": "[name=\"Broadcast\"]   If you discover any unregistered Infected, please inform a nearby peace officer immediately.",
        "type": "dialog",
        "speaker": "Broadcast",
        "content": "If you discover any unregistered Infected, please inform a nearby peace officer immediately."
    },
    {
        "id": 23,
        "raw": "[name=\"Broadcast\"]   The L.G.D. will detain them in accordance with the 'Emergency Handling Act.'",
        "type": "dialog",
        "speaker": "Broadcast",
