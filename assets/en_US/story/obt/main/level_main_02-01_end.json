        "name": "char_010_chen_1.png"
    },
    {
        "id": 33,
        "raw": "[name=\"???\"]   Rhodes Island was scheduled to meet with the L.G.D. at 10 o'clock.",
        "type": "dialog",
        "speaker": "???",
        "content": "Rhodes Island was scheduled to meet with the L.G.D. at 10 o'clock."
    },
    {
        "id": 34,
        "raw": "[name=\"???\"]   It's 10:14 now.",
        "type": "dialog",
        "speaker": "???",
        "content": "It's 10:14 now."
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_010_chen_1#4\")]",
        "type": "character",
        "name": "char_010_chen_1#4.png"
    },
    {
        "id": 36,
        "raw": "[name=\"???\"]   You were late 14 minutes; therefore, you've wasted 14 minutes of my time.",
        "type": "dialog",
        "speaker": "???",
        "content": "You were late 14 minutes; therefore, you've wasted 14 minutes of my time."
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"Amiya\"]   ...I'm sorry, Madam Ch'en, we just found out that Reunion is here...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...I'm sorry, Madam Ch'en, we just found out that Reunion is here..."
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"Ch'en\"]   It's fine, I already know. But that's not important right now.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "It's fine, I already know. But that's not important right now."
    },
    {
        "id": 41,
