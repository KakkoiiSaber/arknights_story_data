        "focus": 1
    },
    {
        "id": 104,
        "raw": "[name=\"Amiya\"]   Your communicator?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Your communicator?"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#6",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"Amiya\"]   ...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...!"
    },
    {
        "id": 107,
        "raw": "[name=\"Amiya\"]   It's... frozen over? Did it get... ruined by the frost?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's... frozen over? Did it get... ruined by the frost?"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#6",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"Frostleaf\"]   Mephisto is a nobody.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Mephisto is a nobody."
    },
    {
        "id": 110,
        "raw": "[name=\"Frostleaf\"]   There's something wandering in this city...",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "There's something wandering in this city..."
    },
    {
        "id": 111,
        "raw": "[name=\"Frostleaf\"]   ...that is far more terrifying.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "...that is far more terrifying."
    },
    {
        "id": 112,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 113,
        "raw": "[name=\"Amiya\"]   Something more terrifying?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Something more terrifying?"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"Frostleaf\"]   The Yetis. If we run into them, we'll be in serious trouble.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "The Yetis. If we run into them, we'll be in serious trouble."
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"Amiya\"]   Yetis? Are you talking about the Yeti Squadron? What are they exactly...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Yetis? Are you talking about the Yeti Squadron? What are they exactly...?"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 119,
        "raw": "[name=\"Frostleaf\"]   I don't have time to explain right now.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "I don't have time to explain right now."
    },
    {
        "id": 120,
        "raw": "[name=\"Frostleaf\"]   But they are the ones... behind the sudden temperature drop, as well as our squads' injuries.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "But they are the ones... behind the sudden temperature drop, as well as our squads' injuries."
    },
    {
        "id": 121,
        "raw": "[name=\"Frostleaf\"]   It seems like this squad has already established their territory within this city.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "It seems like this squad has already established their territory within this city."
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 123,
        "raw": "[name=\"Amiya\"]   The sky is getting darker. This is a good opportunity for us...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "The sky is getting darker. This is a good opportunity for us..."
    },
    {
        "id": 124,
        "raw": "[name=\"Amiya\"]   We'll be able to cross this open area more easily.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We'll be able to cross this open area more easily."
    },
    {
        "id": 125,
        "raw": "[name=\"Amiya\"]   Let's go rescue Meteorite and Jessica first.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Let's go rescue Meteorite and Jessica first."
    },
