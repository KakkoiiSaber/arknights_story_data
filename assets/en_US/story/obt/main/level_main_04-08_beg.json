        "id": 126,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 127,
        "raw": "[name=\"Frostleaf\"]   I'll lead the way.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "I'll lead the way."
