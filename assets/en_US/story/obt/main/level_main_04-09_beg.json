        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 9,
        "raw": "[name=\"Meteorite\"]   ...It's better if you don't find out.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "...It's better if you don't find out."
    },
    {
        "id": 10,
        "raw": "[name=\"Meteorite\"]   It has nothing to do with our combat operations... so don't worry about it right now.",
        "type": "dialog",
