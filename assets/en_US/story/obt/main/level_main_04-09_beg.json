    {
        "id": 129,
        "raw": "[name=\"Amiya\"]   Did you do all this?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Did you do all this?"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "id": 131,
        "raw": "[name=\"Mephisto\"]   Of course~",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Of course~"
    },
    {
        "id": 132,
        "raw": "[name=\"Mephisto\"]   Without using some terror tactics, how else were we supposed to minimize the losses?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Without using some terror tactics, how else were we supposed to minimize the losses?"
    },
    {
        "id": 133,
        "raw": "[name=\"Mephisto\"]   Make an example out of these ten percent...",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Make an example out of these ten percent..."
    },
    {
        "id": 134,
        "raw": "[name=\"Mephisto\"]   ...and the other ninety percent fall into line.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "...and the other ninety percent fall into line."
    },
    {
        "id": 135,
        "raw": "[name=\"Mephisto\"]   This, you see, can be considered the best way of saving lives.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "This, you see, can be considered the best way of saving lives."
