    {
        "id": 120,
        "raw": "[name=\"Mephisto\"]   How long to you intend to keep hiding, my dear rabbit of Chernobog?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "How long to you intend to keep hiding, my dear rabbit of Chernobog?"
    },
    {
        "id": 121,
        "raw": "[name=\"Mephisto\"]   I saw your little rabble sneaking around earlier, so I thought you might've been up to something.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "I saw your little rabble sneaking around earlier, so I thought you might've been up to something."
    },
    {
        "id": 122,
        "raw": "[name=\"Mephisto\"]   But turns out, you're just here to enjoy the show... How boring.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "But turns out, you're just here to enjoy the show... How boring."
    },
    {
        "id": 123,
