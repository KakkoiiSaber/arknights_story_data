    },
    {
        "id": 17,
        "raw": "[name=\"Franka\"]   Where's the enemy commander?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Where's the enemy commander?"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"Liskarm\"]   ...Not with their main force.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "...Not with their main force."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Franka\"]   The enemy is lurking... we're being followed and watched.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "The enemy is lurking... we're being followed and watched."
    },
    {
        "id": 22,
        "raw": "[name=\"Franka\"]   Are they trying to wear us down until they have the perfect opportunity to strike?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Are they trying to wear us down until they have the perfect opportunity to strike?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Amiya\"]   Reunion is no stranger to sneak attacks.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion is no stranger to sneak attacks."
    },
    {
        "id": 25,
        "raw": "[name=\"Amiya\"]   We learned this the hard way at Chernobog.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We learned this the hard way at Chernobog."
    },
    {
        "id": 26,
        "raw": "[name=\"Amiya\"]   Let's fall back quickly...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Let's fall back quickly..."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"Liskarm\"]   I can't guarantee the safety of the escape route.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "I can't guarantee the safety of the escape route."
    },
    {
        "id": 29,
        "raw": "[name=\"Liskarm\"]   We'll be in danger if they start demolishing the nearby buildings to block the road.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We'll be in danger if they start demolishing the nearby buildings to block the road."
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"Amiya\"]   Hurry, let's see what other routes we can take. The stealthier, the better!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Hurry, let's see what other routes we can take. The stealthier, the better!"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1.png"
    },
    {
        "id": 33,
        "raw": "[name=\"Liskarm\"]   Amiya, how about taking that staircase to our 4 o'clock down?",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya, how about taking that staircase to our 4 o'clock down?"
    },
