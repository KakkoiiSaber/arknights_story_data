    {
        "id": 74,
        "raw": "[name=\"Ch'en\"]   ...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "..."
    },
    {
        "id": 75,
        "raw": "[name=\"Ch'en\"]   Do you know why we've been searching for you?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Do you know why we've been searching for you?"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"Misha\"]   ...I'm not sure.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...I'm not sure."
    },
    {
        "id": 78,
        "raw": "[name=\"Misha\"]   I can't think of any reason why you'd want me.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I can't think of any reason why you'd want me."
    },
    {
        "id": 79,
        "raw": "[name=\"Misha\"]   But I have a feeling...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "But I have a feeling..."
    },
    {
        "id": 80,
        "raw": "[name=\"Misha\"]   That this isn't about me...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "That this isn't about me..."
    },
    {
        "id": 81,
        "raw": "[name=\"Misha\"]   ...It's about my parents.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...It's about my parents."
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"Ch'en\"]   ...Yes.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...Yes."
    },
    {
        "id": 84,
        "raw": "[name=\"Ch'en\"]   Your father was the most famous scientist in Chernobog.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Your father was the most famous scientist in Chernobog."
    },
    {
        "id": 85,
        "raw": "[name=\"Ch'en\"]   As well as one of the most important political figures there.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "As well as one of the most important political figures there."
    },
    {
        "id": 86,
        "raw": "[name=\"Ch'en\"]   Perhaps, there's something you might know...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Perhaps, there's something you might know..."
    },
    {
        "id": 87,
        "raw": "[name=\"Ch'en\"]   ...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "..."
    },
    {
        "id": 88,
        "raw": "[name=\"Ch'en\"]   But even if that isn't the case...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "But even if that isn't the case..."
    },
    {
        "id": 89,
        "raw": "[name=\"Ch'en\"]   We cannot allow you to fall into Reunion's hands.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "We cannot allow you to fall into Reunion's hands."
    },
