    },
    {
        "id": 52,
        "raw": "[name=\"Misha\"]   Madam...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Madam..."
    },
    {
        "id": 53,
        "raw": "[name=\"Misha\"]   There are some Infected kids... still in the slums.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "There are some Infected kids... still in the slums."
    },
    {
        "id": 54,
        "raw": "[name=\"Misha\"]   If possible...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "If possible..."
    },
    {
        "id": 55,
        "raw": "[name=\"Misha\"]   I hope that you can take care of them...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I hope that you can take care of them..."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Ch'en\"]   Our duty is to protect Lungmen.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Our duty is to protect Lungmen."
    },
    {
        "id": 58,
        "raw": "[name=\"Ch'en\"]   The Infected are not considered citizens of Lungmen.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "The Infected are not considered citizens of Lungmen."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"Ch'en\"]   ...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "..."
    },
    {
        "id": 63,
        "raw": "[name=\"Ch'en\"]   However, citizens or not, the Infected still belong to Lungmen.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "However, citizens or not, the Infected still belong to Lungmen."
    },
    {
        "id": 64,
        "raw": "[name=\"Ch'en\"]   I have no obligation to promise you anything, but I will perform my duty.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I have no obligation to promise you anything, but I will perform my duty."
    },
    {
        "id": 65,
        "raw": "[name=\"Ch'en\"]   After all...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "After all..."
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"Misha\"]  They said they used to...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "They said they used to..."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]=",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1,
        "content": "="
    },
    {
        "id": 69,
        "raw": "[name=\"Ch'en\"]   It's something we've always been doing.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "It's something we've always been doing."
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 72,
        "raw": "[name=\"Misha\"]   Thank you...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Thank you..."
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
