        "raw": "[name=\"W\"]   Don't take this personally...",
        "type": "dialog",
        "speaker": "W",
        "content": "Don't take this personally..."
    },
    {
        "id": 97,
        "raw": "[name=\"W\"]   But I have a very interesting plot in my hands.",
        "type": "dialog",
        "speaker": "W",
        "content": "But I have a very interesting plot in my hands."
