    },
    {
        "id": 14,
        "raw": "[name=\"Dobermann\"]  Shh...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Shh..."
    },
    {
        "id": 15,
        "raw": "[name=\"Dobermann\"]  ...Don't let Amiya hear you.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...Don't let Amiya hear you."
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_148_nearl_1#7\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#7",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"Nearl\"]  Amiya's kept a clear head through this! She's a lot more mature than we thought...!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Amiya's kept a clear head through this! She's a lot more mature than we thought...!"
    },
    {
        "id": 18,
        "raw": "[name=\"Amiya\"]  ...Ngh...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Ngh..."
    },
    {
        "id": 19,
        "raw": "[name=\"Amiya\"]  ...Mmh...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Mmh...?"
