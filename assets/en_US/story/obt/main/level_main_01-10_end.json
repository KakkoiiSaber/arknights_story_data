        "name": "char_148_nearl_1#3",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Dobermann\"]  Even if that's the case, we can't let her hear this!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Even if that's the case, we can't let her hear this!"
    },
    {
        "id": 25,
        "raw": "[name=\"Dobermann\"]  We mustn't burden her any further. She's already... carrying the weight of the world on her shoulders.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "We mustn't burden her any further. She's already... carrying the weight of the world on her shoulders."
    },
    {
        "id": 26,
        "raw": "[name=\"Dobermann\"]  ...We can't... let their efforts go to waste!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...We can't... let their efforts go to waste!"
    },
    {
        "id": 27,
        "raw": "[name=\"Dobermann\"]  They made the ultimate choice to let us live, so we have to return the favor... by making sure Amiya and the Doctor return safely.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "They made the ultimate choice to let us live, so we have to return the favor... by making sure Amiya and the Doctor return safely."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_148_nearl_1#2\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"Nearl\"]  ...",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "..."
    },
    {
        "id": 30,
        "raw": "[name=\"Nearl\"]  That's right.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "That's right."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_148_nearl_1#2\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"Dobermann\"]  Now isn't the time to be dejected.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Now isn't the time to be dejected."
    },
    {
        "id": 33,
        "raw": "[name=\"Dobermann\"]  As the Radiant Knight, shouldn't you always be our beacon of hope, no matter what happens?",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "As the Radiant Knight, shouldn't you always be our beacon of hope, no matter what happens?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_148_nearl_1#4\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#4",
        "name2": "char_130_doberm_ex",
        "focus": 1
