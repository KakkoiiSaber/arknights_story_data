        "type": "character",
        "name": "char_148_nearl_1#3"
    },
    {
        "id": 38,
        "raw": "[name=\"Nearl\"]  Regroup! Don't let your guard down! We're almost there!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Regroup! Don't let your guard down! We're almost there!"
    },
