    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"Meteorite\"]   ...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "..."
    },
    {
        "id": 26,
        "raw": "[name=\"Meteorite\"]   ...but you shouldn't have come. This whole thing is one big trap.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "...but you shouldn't have come. This whole thing is one big trap."
    },
    {
        "id": 27,
        "raw": "[name=\"Meteorite\"]   It wasn't worth it for you to come to our rescue.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "It wasn't worth it for you to come to our rescue."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#3\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#3",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"Meteorite\"]   This was the wrong decision...!",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "This was the wrong decision...!"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 31,
        "raw": "[name=\"Frostleaf\"]   There's no point in blaming her now.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "There's no point in blaming her now."
    },
    {
        "id": 32,
        "raw": "[name=\"Frostleaf\"]   Besides, even if everyone else doesn't think you can be rescued, Amiya would still not give up on you.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Besides, even if everyone else doesn't think you can be rescued, Amiya would still not give up on you."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"Meteorite\"]   I wasn't blaming her! It's just that...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "I wasn't blaming her! It's just that..."
    },
    {
        "id": 35,
        "raw": "[name=\"Meteorite\"]   Tsk. Sorry, Amiya.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Tsk. Sorry, Amiya."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"Amiya\"]   It's okay. I'm just glad to see that you're all still safe.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It's okay. I'm just glad to see that you're all still safe."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Meteorite\"]   Amiya...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Amiya..."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"Amiya\"]   But... what happened to Jessica?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But... what happened to Jessica?"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_259_Jessica_1#5\")]",
        "type": "character",
        "name": "char_259_Jessica_1#5"
    },
    {
        "id": 43,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 44,
        "raw": "[name=\"Jessica\"]   Ugh...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Ugh..."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"Meteorite\"]   She's... still in shock.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "She's... still in shock."
    },
    {
        "id": 47,
        "raw": "[name=\"Meteorite\"]   Originally, I wanted to wait for her to get better, but...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Originally, I wanted to wait for her to get better, but..."
    },
    {
        "id": 48,
        "raw": "[name=\"Meteorite\"]   It seems like she's been... traumatized.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "It seems like she's been... traumatized."
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_259_Jessica_1#5\")]",
        "type": "character",
        "name": "char_259_Jessica_1#5"
    },
    {
