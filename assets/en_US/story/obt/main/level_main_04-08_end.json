        "block": true
    },
    {
        "id": 11,
        "raw": "[name=\"Frostleaf\"]   I know it's you behind there. Hold your fire.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "I know it's you behind there. Hold your fire."
    },
    {
        "id": 12,
        "raw": "[name=\"Frostleaf\"]   Look who I brought.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Look who I brought."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 14,
        "raw": "[name=\"Amiya\"]   Meteorite, it's us!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Meteorite, it's us!"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_219_meteo_1#4\")]",
        "type": "character",
        "name": "char_219_meteo_1#4"
    },
    {
        "id": 16,
        "raw": "[name=\"Meteorite\"]   Who? Is that.. Amiya?!",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Who? Is that.. Amiya?!"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_219_meteo_1#5\")]",
        "type": "character",
        "name": "char_219_meteo_1#5"
    },
    {
        "id": 18,
        "raw": "[name=\"Meteorite\"]   Amiya! Amiya, you really came!",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Amiya! Amiya, you really came!"
    },
    {
        "id": 19,
        "raw": "[name=\"Meteorite\"]   It's so good to see you...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "It's so good to see you..."
    },
    {
        "id": 20,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
