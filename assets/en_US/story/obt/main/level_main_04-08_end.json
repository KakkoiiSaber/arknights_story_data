        "name": "char_002_amiya_1#4"
    },
    {
        "id": 53,
        "raw": "[name=\"Amiya\"]   Jessica, are you okay?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Jessica, are you okay?"
    },
    {
