    {
        "id": 59,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 60,
        "raw": "[name=\"Amiya\"]   Frostleaf, do me a favor. Place her hands on my arm, and hold her fingers tight.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Frostleaf, do me a favor. Place her hands on my arm, and hold her fingers tight."
