        "name": "char_002_amiya_1#7"
    },
    {
        "id": 6,
        "raw": "[name=\"Amiya\"]   We've defeated Reunion's forces!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We've defeated Reunion's forces!"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"Hoshiguma\"]   Bah. For a bunch of roadblocks, these guys were a bit tough.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Bah. For a bunch of roadblocks, these guys were a bit tough."
    },
    {
        "id": 9,
        "raw": "[name=\"Hoshiguma\"]   ...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "..."
    },
    {
        "id": 10,
        "raw": "[name=\"Hoshiguma\"]   There's no sign of Ch'en.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "There's no sign of Ch'en."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"Amiya\"]   We're in a real mess now...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We're in a real mess now..."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"Hoshiguma\"]   She's not responding to my calls either! Tsk... This part of her hasn't ever changed.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "She's not responding to my calls either! Tsk... This part of her hasn't ever changed."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 16,
        "raw": "[name=\"Hoshiguma\"]   L.G.D.! All members, prepare to follow me--",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "L.G.D.! All members, prepare to follow me--"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 18,
        "raw": "[name=\"Amiya\"]   No, Inspector Hoshiguma.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "No, Inspector Hoshiguma."
    },
    {
        "id": 19,
        "raw": "[name=\"Amiya\"]   You should let us handle it.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "You should let us handle it."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"Amiya\"]   We're approaching the Originium-dense zones left by the Catastrophe...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We're approaching the Originium-dense zones left by the Catastrophe..."
    },
    {
        "id": 22,
        "raw": "[name=\"Amiya\"]   If you go any further, the healthy risk being infected by Oripathy.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "If you go any further, the healthy risk being infected by Oripathy."
    },
    {
        "id": 23,
        "raw": "[name=\"Amiya\"]   These consequences are too dire.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "These consequences are too dire."
    },
    {
        "id": 24,
        "raw": "[name=\"Amiya\"]   Furthermore, as Infected...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Furthermore, as Infected..."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Hoshiguma\"]   Hah. Given your small stature, it's cute when you try to give serious speeches.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Hah. Given your small stature, it's cute when you try to give serious speeches."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Amiya\"]   ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"Amiya\"]   Eh? Huh?!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Eh? Huh?!"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"Hoshiguma\"]   Hahaha, I was just giving you a hard time.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Hahaha, I was just giving you a hard time."
    },
    {
        "id": 33,
        "raw": "[name=\"Hoshiguma\"]   But you don't have to persuade me. I understand your concern.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "But you don't have to persuade me. I understand your concern."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 35,
        "raw": "[name=\"Hoshiguma\"]   L.G.D.! We will be Rhodes Island's shield!",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "L.G.D.! We will be Rhodes Island's shield!"
    },
    {
        "id": 36,
        "raw": "[name=\"Hoshiguma\"]   Block the entrance, and don't let a single Reunion member enter or exit!",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Block the entrance, and don't let a single Reunion member enter or exit!"
    },
    {
        "id": 37,
        "raw": "[name=\"Hoshiguma\"]   We'll let the experts handle this problem!",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "We'll let the experts handle this problem!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 39,
        "raw": "[name=\"Amiya\"]   Inspector...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Inspector..."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"Hoshiguma\"]   Oh, just call me Hoshiguma.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Oh, just call me Hoshiguma."
    },
    {
        "id": 42,
        "raw": "[name=\"Hoshiguma\"]   Go. Please take care of Ch'en.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Go. Please take care of Ch'en."
    },
    {
        "id": 43,
        "raw": "[name=\"Hoshiguma\"]   Make sure you bring her back with you in one piece.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Make sure you bring her back with you in one piece."
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"Amiya\"]   I will, Hoshiguma...! I swear I'll bring Madam Ch'en back safely...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I will, Hoshiguma...! I swear I'll bring Madam Ch'en back safely...!"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"Hoshiguma\"]   Make sure to stay safe yourselves.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Make sure to stay safe yourselves."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Amiya\"]   Okay!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Okay!"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]   Doctor, please follow me.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Doctor, please follow me."
    },
    {
        "id": 52,
        "raw": "[name=\"Amiya\"]   Rhodes Island, let's go!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Rhodes Island, let's go!"
