        "type": "character",
        "name": "char_148_nearl_1"
    },
    {
        "id": 50,
        "raw": "[name=\"Nearl\"]  Amiya...",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Amiya..."
    },
