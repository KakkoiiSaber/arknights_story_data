        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 6,
        "raw": "[name=\"W\"]  Ahh... What a nostalgic feeling!",
        "type": "dialog",
        "speaker": "W",
        "content": "Ahh... What a nostalgic feeling!"
    },
    {
        "id": 7,
        "raw": "[name=\"W\"]  Amiya, was it?",
        "type": "dialog",
        "speaker": "W",
        "content": "Amiya, was it?"
    },
    {
        "id": 8,
        "raw": "[name=\"W\"]  ——",
        "type": "dialog",
        "speaker": "W",
        "content": "——"
    },
    {
        "id": 9,
        "raw": "[name=\"W\"]  Ah, ahaha! I see... So that's what's going on.",
        "type": "dialog",
        "speaker": "W",
        "content": "Ah, ahaha! I see... So that's what's going on."
    },
    {
        "id": 10,
        "raw": "[name=\"W\"]  I remember now, Amiya.",
        "type": "dialog",
        "speaker": "W",
        "content": "I remember now, Amiya."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 12,
        "raw": "[name=\"Amiya\"]  ...What?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...What?"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 14,
        "raw": "[name=\"W\"]  I've already gotten what I came for. You can all go now. Shoo.",
        "type": "dialog",
        "speaker": "W",
        "content": "I've already gotten what I came for. You can all go now. Shoo."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 16,
        "raw": "[name=\"Amiya\"]  You...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "You...!"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=2)]",
        "type": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"Reunion Member\"]  W...?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "W...?"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=1)]",
        "type": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"W\"]  ... What, do you lot want to stay here and die? That's perfectly fine by me. You're all free to do as you please.",
        "type": "dialog",
        "speaker": "W",
        "content": "... What, do you lot want to stay here and die? That's perfectly fine by me. You're all free to do as you please."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=2)]",
        "type": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"Reunion Member\"]  ...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "..."
    },
    {
        "id": 23,
        "raw": "[name=\"Reunion Member\"]  We're falling back. Let them go. Talulah's orders.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "We're falling back. Let them go. Talulah's orders."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 25,
        "raw": "[name=\"Amiya\"]  ...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...?"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 27,
        "raw": "[name=\"W\"]  Forget it. Things get boring when they get dragged out too long. I hate being bored, that's all there is to it.",
        "type": "dialog",
        "speaker": "W",
        "content": "Forget it. Things get boring when they get dragged out too long. I hate being bored, that's all there is to it."
    },
    {
        "id": 28,
        "raw": "[name=\"W\"]  However, I do look forward to seeing you again, Amiya.",
        "type": "dialog",
        "speaker": "W",
        "content": "However, I do look forward to seeing you again, Amiya."
    },
    {
        "id": 29,
        "raw": "[name=\"W\"]  As well as... that person.",
        "type": "dialog",
        "speaker": "W",
        "content": "As well as... that person."
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1"
    },
    {
        "id": 31,
        "raw": "[name=\"Amiya\"]  What...? !",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "What...? !"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 33,
        "raw": "[name=\"W\"]  Next time, I will hear the truth from you, {@Nickname}.",
        "type": "dialog",
        "speaker": "W",
        "content": "Next time, I will hear the truth from you, {@Nickname}."
    },
    {
        "id": 34,
        "raw": "[name=\"W\"]  Bye~",
        "type": "dialog",
        "speaker": "W",
        "content": "Bye~"
    },
