        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 43,
        "raw": "[name=\"Dobermann\"]  Reunion... they've left.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Reunion... they've left."
    },
    {
        "id": 44,
        "raw": "[name=\"Dobermann\"]  --We've long missed the rendezvous time.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "--We've long missed the rendezvous time."
    },
    {
        "id": 45,
        "raw": "[name=\"Dobermann\"]  Retreat back to Rhodes Island... immediately.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Retreat back to Rhodes Island... immediately."
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 47,
        "raw": "[name=\"Amiya\"]  ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 48,
        "raw": "[name=\"Amiya\"]  I'll escort... the Operators in the back.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I'll escort... the Operators in the back."
    },
    {
        "id": 49,
