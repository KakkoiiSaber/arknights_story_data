    {
        "id": 89,
        "raw": "[name=\"Guard\"]  ... What...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "... What..."
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_013_riop\", focus=1)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 91,
        "raw": "[name=\"Ace\"]  We're the only two left.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "We're the only two left."
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_013_riop\", focus=2)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"Guard\"]  I remember now... That, that freak... Talulah... single-handedly...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "I remember now... That, that freak... Talulah... single-handedly..."
    },
    {
        "id": 94,
        "raw": "[name=\"Guard\"]  She knocked away our Guards like they were toy bricks...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "She knocked away our Guards like they were toy bricks..."
    },
    {
        "id": 95,
        "raw": "[name=\"Guard\"]  That monster cut through our Defenders as if they were butter...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "That monster cut through our Defenders as if they were butter..."
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_013_riop\", focus=1)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"Ace\"]  Hush... Your wounds are deep.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Hush... Your wounds are deep."
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_013_riop\", focus=2)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"Guard\"]  The Catastrophe...! She is Catastrophe incarnate... How, how else could she have reduced our squads to ashes in an instant...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "The Catastrophe...! She is Catastrophe incarnate... How, how else could she have reduced our squads to ashes in an instant..."
    },
    {
        "id": 100,
        "raw": "[name=\"Guard\"]  Even though I saw it with my own eyes, I can't... I can't believe it...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Even though I saw it with my own eyes, I can't... I can't believe it..."
    },
    {
        "id": 101,
        "raw": "[name=\"Guard\"]  The screams... Aagh... Gaaaah...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "The screams... Aagh... Gaaaah..."
    },
    {
        "id": 102,
        "raw": "[Character(name=\"char_014_riope\")]",
        "type": "character",
        "name": "char_014_riope"
    },
