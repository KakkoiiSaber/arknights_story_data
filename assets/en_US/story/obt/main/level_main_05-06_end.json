    {
        "id": 53,
        "raw": "[name=\"Reunion Caster\"]  (B-bastards...)",
        "type": "dialog",
        "speaker": "Reunion Caster",
        "content": "(B-bastards...)"
    },
    {
        "id": 54,
        "raw": "[name=\"Reunion Caster\"]  (At least I'll bury you with me...!)",
        "type": "dialog",
        "speaker": "Reunion Caster",
        "content": "(At least I'll bury you with me...!)"
