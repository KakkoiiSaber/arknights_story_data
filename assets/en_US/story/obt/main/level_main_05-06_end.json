    {
        "id": 61,
        "raw": "[name=\"L.G.D. Agent\"]  Right under where you're standing!!",
        "type": "dialog",
        "speaker": "L.G.D. Agent",
        "content": "Right under where you're standing!!"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_1011_wizard_1\")]",
        "type": "character",
        "name": "char_1011_wizard_1"
    },
    {
        "id": 63,
        "raw": "[name=\"Reunion Caster\"]  L.G.D., prepare to meet your makers!",
        "type": "dialog",
        "speaker": "Reunion Caster",
        "content": "L.G.D., prepare to meet your makers!"
    },
    {
