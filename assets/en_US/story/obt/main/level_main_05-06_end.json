    },
    {
        "id": 59,
        "raw": "[name=\"L.G.D. Agent\"]  Madam Ch'en! Run!! We've found a large number of explosives on the third floor!",
        "type": "dialog",
        "speaker": "L.G.D. Agent",
        "content": "Madam Ch'en! Run!! We've found a large number of explosives on the third floor!"
    },
    {
        "id": 60,
        "raw": "[PlayMusic(intro=\"$escapebattle_intro\", key=\"$escapebattle_loop\", volume=0.5, crossfade=1.5, delay=0.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta2_180603/m_bat_escapebattle_intro.mp3",
