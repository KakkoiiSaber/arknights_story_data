    {
        "id": 95,
        "raw": "[name=\"Mephisto\"]  You filthy vermin...",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "You filthy vermin..."
    },
    {
        "id": 96,
        "raw": "[name=\"Mephisto\"]  Why won't you just obediently roll over and die?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Why won't you just obediently roll over and die?"
    },
    {
        "id": 97,
        "raw": "[name=\"Mephisto\"]  Why can't I just put an end to you all right here?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Why can't I just put an end to you all right here?"
    },
    {
        "id": 98,
        "raw": "[name=\"Mephisto\"]  ...I want to kill... every... single... one... of you...",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "...I want to kill... every... single... one... of you..."
    },
