    {
        "id": 9,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1"
    },
    {
        "id": 10,
        "raw": "[name=\"Nearl\"]   ...You there.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "...You there."
    },
    {
        "id": 11,
        "raw": "[name=\"Nearl\"]   The Reunion forces worked like a well-oiled machine when they took over the Chernobog military strongholds.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "The Reunion forces worked like a well-oiled machine when they took over the Chernobog military strongholds."
    },
    {
        "id": 12,
        "raw": "[name=\"Nearl\"]   But your men act like deranged thugs.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "But your men act like deranged thugs."
    },
    {
        "id": 13,
        "raw": "[name=\"Nearl\"]   Mindless slaughter, burning down the city, hunting down innocents... This was all for your own sadistic pleasure, was it not?",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Mindless slaughter, burning down the city, hunting down innocents... This was all for your own sadistic pleasure, was it not?"
    },
    {
        "id": 14,
        "raw": "[name=\"Nearl\"]   Someone base enough to plot these senseless crimes at a time like this... could not possibly have designed the plan to take down an entire city.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Someone base enough to plot these senseless crimes at a time like this... could not possibly have designed the plan to take down an entire city."
    },
    {
        "id": 15,
        "raw": "[name=\"Nearl\"]   Your commander probably ordered you to cause chaos, but you succumbed to your perversion and tastelessness.",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Your commander probably ordered you to cause chaos, but you succumbed to your perversion and tastelessness."
    },
    {
