        "id": 43,
        "raw": "[Character(name=\"char_1507_Mephisto_1#3\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#3"
    },
    {
        "id": 44,
        "raw": "[name=\"Mephisto\"]  Unbelievable... Impossible!",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Unbelievable... Impossible!"
    },
    {
        "id": 45,
        "raw": "[name=\"Mephisto\"]  Do it again!! Blow her to pieces!",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Do it again!! Blow her to pieces!"
