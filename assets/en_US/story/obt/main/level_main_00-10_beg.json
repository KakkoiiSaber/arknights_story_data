        "content": "..."
    },
    {
        "id": 18,
        "raw": "[name=\"Mephisto\"]   ...Faust.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "...Faust."
    },
    {
        "id": 19,
        "raw": "[name=\"Mephisto\"]   I want her shot through the mouth.",
