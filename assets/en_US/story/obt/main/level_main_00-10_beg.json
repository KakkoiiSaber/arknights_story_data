        "name": "char_002_amiya_1#7 "
    },
    {
        "id": 87,
        "raw": "[name=\"Amiya\"]  Understood!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Understood!"
    },
    {
        "id": 88,
        "raw": "[name=\"Amiya\"]  Team E1 Snipers, come with me and suppress Reunion's forces!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Team E1 Snipers, come with me and suppress Reunion's forces!"
    },
    {
        "id": 89,
        "raw": "[name=\"Amiya\"]  Team E2, use all the firepower you have to break through their defensive line!",
