    },
    {
        "id": 78,
        "raw": "[name=\"Amiya\"]  Did we get him?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Did we get him?"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_014_riope\" )]",
        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 80,
        "raw": "[name=\"Ace\"]  I doubt it. The most we can hope for... is to put some pressure on him.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "I doubt it. The most we can hope for... is to put some pressure on him."
    },
    {
        "id": 81,
        "raw": "[name=\"Ace\"]  Unfortunately, we don't have the time to dissect our enemies' tactics.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Unfortunately, we don't have the time to dissect our enemies' tactics."
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_130_doberm_ex\",focus=2)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"Dobermann\"]  He's very mobile and has high firepower. The longer this drags on, the less likely we'll be able to block his shots!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "He's very mobile and has high firepower. The longer this drags on, the less likely we'll be able to block his shots!"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3"
    },
    {
        "id": 85,
        "raw": "[name=\"Nearl\"]  We can't give him time to set up...! Amiya, make your move while Team E3's Snipers keep him occupied!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "We can't give him time to set up...! Amiya, make your move while Team E3's Snipers keep him occupied!"
