    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#7 \")]",
        "type": "character",
        "name": "char_002_amiya_1#7 "
    },
    {
        "id": 37,
        "raw": "[name=\"Amiya\"]  Nearl, you need to retreat!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Nearl, you need to retreat!"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
