        "name": "char_130_doberm_ex"
    },
    {
        "id": 34,
        "raw": "[name=\"Dobermann\"]  Their sniper... is ridiculous!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Their sniper... is ridiculous!"
    },
    {
        "id": 35,
        "raw": "[name=\"Dobermann\"]  If Nearl gets hit again, she won't be able to defend herself anymore!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "If Nearl gets hit again, she won't be able to defend herself anymore!"
