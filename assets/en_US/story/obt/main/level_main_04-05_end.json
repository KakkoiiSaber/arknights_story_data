    {
        "id": 53,
        "raw": "[name=\"Hoshiguma\"]   So, when are we heading out?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "So, when are we heading out?"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"Ch'en\"]   Right now.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Right now."
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Hoshiguma\"]   I'll go get ready. Notify the other L.G.D. members.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I'll go get ready. Notify the other L.G.D. members."
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"Ch'en\"]   All right.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "All right."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 61,
        "raw": "[name=\"Ch'en\"]   Amiya, we'll leave from here in ten minutes.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Amiya, we'll leave from here in ten minutes."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 63,
        "raw": "[name=\"Amiya\"]   Okay.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Okay."
    },
