    {
        "id": 58,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"Franka\"]   Oh~ This one's finally decided to show up.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Oh~ This one's finally decided to show up."
    },
    {
        "id": 60,
        "raw": "[name=\"Franka\"]   Doesn't sound too impressive, though.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Doesn't sound too impressive, though."
    },
    {
        "id": 61,
        "raw": "[Character( name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1"
    },
    {
        "id": 62,
        "raw": "[name=\"Liskarm\"]   Amiya, seems like we--",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya, seems like we--"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 64,
        "raw": "[name=\"Franka\"]   Ack, it's a dead end!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Ack, it's a dead end!"
    },
    {
        "id": 65,
        "raw": "[name=\"Franka\"]   Did I run too far ahead? !",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Did I run too far ahead? !"
    },
    {
        "id": 66,
        "raw": "[Character( name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1"
    },
    {
        "id": 67,
        "raw": "[name=\"Liskarm\"]   Franka's also having some problems...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Franka's also having some problems..."
    },
    {
        "id": 68,
        "raw": "[name=\"Liskarm\"]   Reunion has us cornered.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Reunion has us cornered."
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 70,
        "raw": "[name=\"Amiya\"]   ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 71,
        "raw": "[Character( name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1"
    },
    {
        "id": 72,
        "raw": "[name=\"Liskarm\"]   We'll have to fight.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We'll have to fight."
    },
    {
        "id": 73,
        "raw": "[name=\"Liskarm\"]   I feel that... we more than match up against them.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "I feel that... we more than match up against them."
    },
    {
        "id": 74,
        "raw": "[name=\"Liskarm\"]   We just have to get a bit more serious...",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We just have to get a bit more serious..."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 76,
        "raw": "[name=\"Franka\"]   Liskarm, you just don't understand.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Liskarm, you just don't understand."
    },
    {
        "id": 77,
        "raw": "[name=\"Franka\"]   Whatever level of power we choose to display, we can't let the L.G.D. feel threatened.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Whatever level of power we choose to display, we can't let the L.G.D. feel threatened."
    },
    {
        "id": 78,
        "raw": "[Character( name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1"
    },
    {
        "id": 79,
        "raw": "[name=\"Liskarm\"]   But we can't just sit here and let them run over us!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "But we can't just sit here and let them run over us!"
    },
    {
        "id": 80,
        "raw": "[name=\"Liskarm\"]   Defenders, hold your ground!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Defenders, hold your ground!"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_1500_skulsr\")]",
        "type": "character",
        "name": "char_1500_skulsr"
    },
    {
        "id": 82,
        "raw": "[name=\"Skullshatterer\"]   A leader of Rhodes Island, eh...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "A leader of Rhodes Island, eh..."
    },
    {
        "id": 83,
        "raw": "[name=\"Skullshatterer\"]   You're an Infected, but you still assist Lungmen in their slaughter of other Infected!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You're an Infected, but you still assist Lungmen in their slaughter of other Infected!"
    },
    {
        "id": 84,
        "raw": "[name=\"Skullshatterer\"]   You have blood of so many of my comrades on your hands!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You have blood of so many of my comrades on your hands!"
    },
