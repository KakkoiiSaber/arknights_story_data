    },
    {
        "id": 34,
        "raw": "[name=\"Franka\"]   Amiya!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Amiya!"
    },
    {
        "id": 35,
        "raw": "[name=\"Franka\"]   How's the situation over there?",
        "type": "dialog",
        "speaker": "Franka",
