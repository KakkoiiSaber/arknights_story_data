    {
        "id": 6,
        "raw": "[name=\"Franka\"]   Liskarm Are you able to hold the line?",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Liskarm Are you able to hold the line?"
    },
    {
        "id": 7,
