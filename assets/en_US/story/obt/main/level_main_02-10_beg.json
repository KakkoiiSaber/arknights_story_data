        "name": "char_107_liskam_1"
    },
    {
        "id": 37,
        "raw": "[name=\"Liskarm\"]   I think we have a little issue here.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "I think we have a little issue here."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 39,
        "raw": "[name=\"Amiya\"]   Franka...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Franka..."
    },
    {
        "id": 40,
        "raw": "[name=\"Amiya\"]   The enemy leader... just showed up in front of me and Liskarm!",
        "type": "dialog",
        "speaker": "Amiya",
