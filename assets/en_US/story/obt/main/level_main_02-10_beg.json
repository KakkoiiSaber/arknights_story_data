        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"Liskarm\"]   I'm fine over here!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "I'm fine over here!"
    },
    {
        "id": 9,
        "raw": "[name=\"Liskarm\"]   Franka, watch out for an enemy flank!",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Franka, watch out for an enemy flank!"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"Franka\"]   There's no end to them...!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "There's no end to them...!"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 13,
        "raw": "[name=\"Reunion Member\"]   You don't have a chance of breaking through our defenses!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "You don't have a chance of breaking through our defenses!"
    },
    {
        "id": 14,
        "raw": "[name=\"Reunion Member\"]   I'm going to smash you...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "I'm going to smash you..."
    },
