    },
    {
        "id": 51,
        "raw": "[name=\"Skullshatterer\"]   Where else do you plan on hiding?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Where else do you plan on hiding?"
    },
    {
        "id": 52,
        "raw": "[name=\"Skullshatterer\"]   You can't escape us, Rhodes Island.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You can't escape us, Rhodes Island."
    },
    {
        "id": 53,
        "raw": "[name=\"Skullshatterer\"]   I'll grind you to dust...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "I'll grind you to dust..."
    },
    {
        "id": 54,
        "raw": "[name=\"Skullshatterer\"]   ...not even your bones will remain.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "...not even your bones will remain."
    },
    {
        "id": 55,
        "raw": "[name=\"Skullshatterer\"]   You traitors... have turned your backs on the Infected!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You traitors... have turned your backs on the Infected!"
    },
    {
        "id": 56,
        "raw": "[playsound(key=\"$e_skill_skulsrshot\", volume=0.5)]",
