    },
    {
        "id": 29,
        "raw": "[name=\"Franka\"]   Medic! There's someone injured here!",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Medic! There's someone injured here!"
    },
    {
        "id": 30,
        "raw": "[name=\"Franka\"]   Be careful when transporting them!",
