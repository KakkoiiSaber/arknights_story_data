    },
    {
        "id": 169,
        "raw": "[name=\"Kal'tsit\"]   It's related to the state of her health.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "It's related to the state of her health."
    },
    {
        "id": 170,
        "raw": "[name=\"Kal'tsit\"]   If Amiya is involved in an intense battle...",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "If Amiya is involved in an intense battle..."
    },
    {
        "id": 171,
        "raw": "[name=\"Kal'tsit\"]   ...You must check her rings immediately afterwards.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "...You must check her rings immediately afterwards."
    },
    {
        "id": 172,
        "raw": "[name=\"Kal'tsit\"]   No matter what changes you see, you must report them to me.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "No matter what changes you see, you must report them to me."
    },
    {
