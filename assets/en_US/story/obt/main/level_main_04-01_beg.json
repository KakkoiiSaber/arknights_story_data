        "name2": "char_002_amiya_1#5",
        "focus": 2
    },
    {
        "id": 144,
        "raw": "[name=\"Amiya\"]   Aww...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Aww..."
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_003_kalts_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_003_kalts_1",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
