        "name": "char_003_kalts_1"
    },
    {
        "id": 175,
        "raw": "[name=\"Kal'tsit\"]   For the time being, that's all you're allowed to know.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "For the time being, that's all you're allowed to know."
    },
