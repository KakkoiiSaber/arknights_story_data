        "name2": "char_002_amiya_1#2",
        "focus": 1
    },
    {
        "id": 138,
        "raw": "[name=\"Kal'tsit\"]   You may not.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "You may not."
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_003_kalts_1\", name2=\"char_002_amiya_1#3\", focus=2)]",
        "type": "character",
        "name": "char_003_kalts_1",
        "name2": "char_002_amiya_1#3",
        "focus": 2
    },
    {
