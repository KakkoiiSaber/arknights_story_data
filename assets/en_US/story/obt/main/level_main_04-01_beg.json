        "raw": "[name=\"Amiya\"]   May I listen in?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "May I listen in?"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_003_kalts_1\", name2=\"char_002_amiya_1#2\", focus=1)]",
        "type": "character",
