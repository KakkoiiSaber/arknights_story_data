        "type": "character",
        "name": "char_148_nearl_1#3"
    },
    {
        "id": 42,
        "raw": "[name=\"Nearl\"]  Rhodes Island Operators, stand your ground! Push Reunion back and open up an escape route!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Rhodes Island Operators, stand your ground! Push Reunion back and open up an escape route!"
