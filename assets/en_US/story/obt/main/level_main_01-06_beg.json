    {
        "id": 6,
        "raw": "[name=\"Mephisto\"]  Indeed. They don't know that Faust is following them. I received some information from one of his scouts.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Indeed. They don't know that Faust is following them. I received some information from one of his scouts."
    },
    {
        "id": 7,
        "raw": "[name=\"Mephisto\"]  Rhodes Island is trapped around the perimeter of the city center.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Rhodes Island is trapped around the perimeter of the city center."
    },
    {
        "id": 8,
        "raw": "[name=\"Mephisto\"]  Insects as they might be, they still might take advantage of the confusion caused by the Catastrophe to make their escape.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Insects as they might be, they still might take advantage of the confusion caused by the Catastrophe to make their escape."
    },
    {
        "id": 9,
        "raw": "[name=\"Mephisto\"]  Given their understanding of the situation in Chernobog, they could potentially interfere with our plans.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Given their understanding of the situation in Chernobog, they could potentially interfere with our plans."
    },
    {
        "id": 10,
        "raw": "[name=\"Mephisto\"]  ... At least, getting rid of them won't do us any harm.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "... At least, getting rid of them won't do us any harm."
    },
