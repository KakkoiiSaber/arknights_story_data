    },
    {
        "id": 37,
        "raw": "[name=\"Nearl\"]  Why is Reunion going completely berserk?",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "Why is Reunion going completely berserk?"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 39,
        "raw": "[name=\"Dobermann\"]  Why are they sending so many members out here now?!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Why are they sending so many members out here now?!"
    },
    {
        "id": 40,
        "raw": "[name=\"Dobermann\"]  This makes no sense! There's no reason for them to be defending this place so staunchly!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "This makes no sense! There's no reason for them to be defending this place so staunchly!"
    },
    {
        "id": 41,
