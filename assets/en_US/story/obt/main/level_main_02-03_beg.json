        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 126,
        "raw": "[name=\"Liskarm\"]   ...Understood.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "...Understood."
    },
    {
        "id": 127,
        "raw": "[name=\"Liskarm\"]   Amiya, Madam Ch'en wants us to immediately search for the Infected just described.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya, Madam Ch'en wants us to immediately search for the Infected just described."
    },
    {
        "id": 128,
        "raw": "[name=\"Liskarm\"]   Once we find her, we are to turn her in to the L.G.D. immediately.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Once we find her, we are to turn her in to the L.G.D. immediately."
