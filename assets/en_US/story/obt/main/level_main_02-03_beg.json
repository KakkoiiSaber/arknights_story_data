        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 116,
        "raw": "[name=\"Amiya\"]   Was that Madam Ch'en?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Was that Madam Ch'en?"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_002_amiya_1\",name2=\"char_107_liskam_1\",focus=2)]",
