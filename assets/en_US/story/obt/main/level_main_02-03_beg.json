        "id": 106,
        "raw": "[name=\"Amiya\"]   The deeper we head into the slums, the more volatile things are going to be...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "The deeper we head into the slums, the more volatile things are going to be..."
    },
