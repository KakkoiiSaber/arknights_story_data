        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 118,
        "raw": "[name=\"Liskarm\"]   Indeed.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Indeed."
    },
    {
        "id": 119,
        "raw": "[name=\"Liskarm\"]   ... That's right. We've already found a number of unregistered Infected.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "... That's right. We've already found a number of unregistered Infected."
    },
    {
        "id": 120,
        "raw": "[name=\"Liskarm\"]   ... Yes.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "... Yes."
    },
    {
        "id": 121,
        "raw": "[name=\"Liskarm\"]   ... What?",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "... What?"
    },
    {
        "id": 122,
        "raw": "[name=\"Liskarm\"]   ... We're after an Ursus girl, short white hair, height of about 145 cm, called Misha?",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "... We're after an Ursus girl, short white hair, height of about 145 cm, called Misha?"
