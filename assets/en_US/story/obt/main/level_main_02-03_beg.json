        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"Amiya\"]   Hm, I saw an Infected just now, probably unregistered...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Hm, I saw an Infected just now, probably unregistered..."
