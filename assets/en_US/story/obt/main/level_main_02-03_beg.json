        "content": "..."
    },
    {
        "id": 113,
        "raw": "[name=\"Liskarm\"]   That's right.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "That's right."
    },
    {
        "id": 114,
        "raw": "[name=\"Liskarm\"]   Amiya, it's the L.G.D.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "Amiya, it's the L.G.D."
