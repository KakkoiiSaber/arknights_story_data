    },
    {
        "id": 79,
        "raw": "[PlayMusic(intro=\"$darkness01_intro\", key=\"$darkness01_loop\", volume=0.8, crossfade=1.5, delay=0.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta1_180603/m_dia_darkness01_intro.mp3",
        "key": "audio/sound_beta_2/music/beta1_180603/m_dia_darkness01_loop.mp3",
        "volume": "0.8,",
        "crossfade": "1.5,",
        "delay": 0.5
    },
    {
        "id": 80,
        "raw": "[name=\"Skullshatterer\"]   When they came for me, they dragged me out of my house...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "When they came for me, they dragged me out of my house..."
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 82,
        "raw": "[name=\"Misha\"]   What's wrong?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "What's wrong?"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 84,
        "raw": "[name=\"Skullshatterer\"]   I saw my mother. She grabbed my hand...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "I saw my mother. She grabbed my hand..."
    },
    {
        "id": 85,
        "raw": "[name=\"Skullshatterer\"]   You saw it too.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You saw it too."
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 87,
        "raw": "[name=\"Misha\"]   ...No...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...No..."
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 89,
        "raw": "[name=\"Skullshatterer\"]   You must have--",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You must have--"
    },
    {
        "id": 90,
        "raw": "[name=\"Skullshatterer\"]   They beat her mercilessly, but she wouldn't let go of me...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "They beat her mercilessly, but she wouldn't let go of me..."
    },
    {
        "id": 91,
        "raw": "[name=\"Skullshatterer\"]   She left a trail of blood in the snow as they dragged her away.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "She left a trail of blood in the snow as they dragged her away."
    },
    {
        "id": 92,
        "raw": "[name=\"Skullshatterer\"]   If Reunion had... If the Infected could have... If only--!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "If Reunion had... If the Infected could have... If only--!"
    },
    {
        "id": 93,
        "raw": "[name=\"Skullshatterer\"]   If they came sooner, none of this would have happened!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "If they came sooner, none of this would have happened!"
    },
    {
        "id": 94,
        "raw": "[name=\"Skullshatterer\"]   We would not have had to suffer so much!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "We would not have had to suffer so much!"
    },
