        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"Misha\"]   I... I wasn't brave enough to...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I... I wasn't brave enough to..."
    },
    {
        "id": 98,
        "raw": "[name=\"Misha\"]   I... Aaaahh...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I... Aaaahh..."
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 100,
        "raw": "[name=\"Skullshatterer\"]   Misha...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Misha..."
    },
    {
        "id": 101,
        "raw": "[name=\"Skullshatterer\"]   It'll be fine... It'll all be fine in the end.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "It'll be fine... It'll all be fine in the end."
    },
    {
        "id": 102,
        "raw": "[name=\"Skullshatterer\"]   I don't blame you.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "I don't blame you."
    },
    {
        "id": 103,
        "raw": "[name=\"Skullshatterer\"]   Back then... who would've been brave enough?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Back then... who would've been brave enough?"
    },
    {
        "id": 104,
        "raw": "[name=\"Skullshatterer\"]   But now, Reunion has given me that bravery.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "But now, Reunion has given me that bravery."
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"Misha\"]   Al--",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Al--"
    },
    {
        "id": 107,
        "raw": "[name=\"Misha\"]   Skullshatterer...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Skullshatterer..."
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"Skullshatterer\"]   Whether or not you trust us is up to you.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Whether or not you trust us is up to you."
    },
    {
        "id": 110,
        "raw": "[name=\"Skullshatterer\"]   Even if you trust us, whether or not you join us is also up to you.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Even if you trust us, whether or not you join us is also up to you."
    },
    {
        "id": 111,
        "raw": "[name=\"Skullshatterer\"]   But you are an Infected.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "But you are an Infected."
    },
    {
        "id": 112,
        "raw": "[name=\"Skullshatterer\"]   Reunion... will definitely fight until the bitter end so that the Infected can be free.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Reunion... will definitely fight until the bitter end so that the Infected can be free."
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 114,
        "raw": "[name=\"Misha\"]   But... you destroyed Chernobog.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "But... you destroyed Chernobog."
    },
    {
        "id": 115,
        "raw": "[name=\"Misha\"]   Along with countless innocents--",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Along with countless innocents--"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"Skullshatterer\"]   ...Innocents?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "...Innocents?"
    },
    {
        "id": 118,
        "raw": "[name=\"Skullshatterer\"]   Hah. Who's innocent?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Hah. Who's innocent?"
    },
    {
        "id": 119,
        "raw": "[name=\"Skullshatterer\"]   When Chernobog implemented the quarantine, did any of them speak out against it?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "When Chernobog implemented the quarantine, did any of them speak out against it?"
    },
    {
        "id": 120,
        "raw": "[name=\"Skullshatterer\"]   When Ursus sent us to die in the mines and the frozen wastelands, did any of them do anything about it?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "When Ursus sent us to die in the mines and the frozen wastelands, did any of them do anything about it?"
    },
    {
        "id": 121,
        "raw": "[name=\"Skullshatterer\"]   Did any of them ever stand up for us?!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Did any of them ever stand up for us?!"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 123,
        "raw": "[name=\"Misha\"]   I don't know...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I don't know..."
    },
    {
        "id": 124,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 125,
        "raw": "[name=\"Skullshatterer\"]   ...Reunion has two leaders who fought for Ursus for a long time.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "...Reunion has two leaders who fought for Ursus for a long time."
    },
    {
        "id": 126,
        "raw": "[name=\"Skullshatterer\"]   They said that there were some in Ursus who stood against the government for the sake of the Infected.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "They said that there were some in Ursus who stood against the government for the sake of the Infected."
    },
    {
        "id": 127,
        "raw": "[name=\"Skullshatterer\"]   But they weren't in Chernobog.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "But they weren't in Chernobog."
    },
    {
        "id": 128,
        "raw": "[name=\"Skullshatterer\"]   Chernobog coldly turned a blind eye towards us as we died...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Chernobog coldly turned a blind eye towards us as we died..."
    },
    {
        "id": 129,
        "raw": "[name=\"Skullshatterer\"]   No, they laughed as they watched us die!!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "No, they laughed as they watched us die!!"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 131,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 132,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 133,
        "raw": "[name=\"Skullshatterer\"]   Chernobog... deserved to be destroyed!",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Chernobog... deserved to be destroyed!"
    },
    {
        "id": 134,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 135,
        "raw": "[name=\"Misha\"]   I met other people who were helping the Infected... They...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I met other people who were helping the Infected... They..."
    },
    {
        "id": 136,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 137,
        "raw": "[name=\"Skullshatterer\"]   Rhodes Island?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Rhodes Island?"
    },
    {
        "id": 138,
        "raw": "[name=\"Skullshatterer\"]   Despite being Infected, they helped Lungmen and harmed us, didn't they?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Despite being Infected, they helped Lungmen and harmed us, didn't they?"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 141,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"Skullshatterer\"]   They slew our comrades and decimated our brethren, didn't they?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "They slew our comrades and decimated our brethren, didn't they?"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 144,
        "raw": "[name=\"Misha\"]   No...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "No..."
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 146,
        "raw": "[name=\"Skullshatterer\"]   You couldn't see the truth. But it should be clear to you now...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "You couldn't see the truth. But it should be clear to you now..."
    },
    {
        "id": 147,
        "raw": "[name=\"Skullshatterer\"]   ...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "..."
    },
    {
        "id": 148,
        "raw": "[name=\"Skullshatterer\"]   ...Sorry, I let my anger take over.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "...Sorry, I let my anger take over."
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 150,
        "raw": "[name=\"Misha\"]   It's fine... I...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "It's fine... I..."
    },
    {
        "id": 151,
        "raw": "[name=\"Misha\"]   I understand how you feel...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I understand how you feel..."
    },
    {
        "id": 152,
        "raw": "[name=\"Misha\"]   You must have been suffering so much... all this time...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "You must have been suffering so much... all this time..."
    },
    {
        "id": 153,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 154,
        "raw": "[name=\"Skullshatterer\"]   Everyone has been through a lot.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Everyone has been through a lot."
    },
    {
        "id": 155,
        "raw": "[name=\"Skullshatterer\"]   But right now, at least we have hope.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "But right now, at least we have hope."
    },
    {
        "id": 156,
        "raw": "[name=\"Skullshatterer\"]   Talulah... She is the one who took charge of the Infected and led the fight against the cruelty of this world.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Talulah... She is the one who took charge of the Infected and led the fight against the cruelty of this world."
    },
    {
        "id": 157,
        "raw": "[name=\"Skullshatterer\"]   Reunion is the only hope we have.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Reunion is the only hope we have."
    },
    {
        "id": 158,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 159,
        "raw": "[name=\"Misha\"]   I see... You've all suffered so much...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I see... You've all suffered so much..."
    },
    {
        "id": 160,
        "raw": "[name=\"Misha\"]   If Reunion can really protect them all...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "If Reunion can really protect them all..."
    },
    {
        "id": 161,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 162,
        "raw": "[name=\"Skullshatterer\"]   Of course.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Of course."
    },
    {
        "id": 163,
        "raw": "[name=\"Skullshatterer\"]   Just like how Reunion will protect everyone... I will protect you.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Just like how Reunion will protect everyone... I will protect you."
    },
    {
        "id": 164,
        "raw": "[name=\"Skullshatterer\"]   I won't let anyone hurt you anymore.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "I won't let anyone hurt you anymore."
    },
    {
        "id": 165,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
