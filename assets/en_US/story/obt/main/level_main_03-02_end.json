        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 175,
        "raw": "[name=\"Exusiai\"]   Looks like they sustained some pretty serious losses.",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Looks like they sustained some pretty serious losses."
    },
    {
        "id": 176,
        "raw": "[name=\"Exusiai\"]   Luckily, I didn't head back to the company headquarters... Otherwise, I would've needed to make a long detour for this mission...",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Luckily, I didn't head back to the company headquarters... Otherwise, I would've needed to make a long detour for this mission..."
    },
    {
