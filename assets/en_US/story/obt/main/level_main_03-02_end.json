        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 178,
        "raw": "[name=\"Texas\"]   Try to predict their escape routes.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Try to predict their escape routes."
    },
    {
        "id": 179,
        "raw": "[name=\"Texas\"]   Send all likely routes along with their bearings to Amiya.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Send all likely routes along with their bearings to Amiya."
    },
    {
