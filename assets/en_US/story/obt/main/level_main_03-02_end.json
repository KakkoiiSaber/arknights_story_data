        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"Misha\"]   ...?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...?"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"Reunion Member\"]   I've heard a lot about you from Skullshatterer. Now, I finally get to meet you.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "I've heard a lot about you from Skullshatterer. Now, I finally get to meet you."
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"Misha\"]   Are you also... Infected...?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Are you also... Infected...?"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"Reunion Member\"]   Yes, I am.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Yes, I am."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"Misha\"]   Why did you... join Reunion?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Why did you... join Reunion?"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"Reunion Member\"]   Why?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Why?"
    },
    {
        "id": 23,
        "raw": "[name=\"Reunion Member\"]   ...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "..."
    },
    {
        "id": 24,
        "raw": "[name=\"Reunion Member\"]   My wife, my child... they were all killed by the Chernobogians.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "My wife, my child... they were all killed by the Chernobogians."
    },
    {
        "id": 25,
        "raw": "[name=\"Reunion Member\"]   Under Ursus, the Infected were treated worse than lifestock.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Under Ursus, the Infected were treated worse than lifestock."
    },
    {
        "id": 26,
        "raw": "[name=\"Reunion Member\"]   The destruction of Chernobog...? No, no. That is far too light of a punishment...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "The destruction of Chernobog...? No, no. That is far too light of a punishment..."
    },
    {
        "id": 27,
        "raw": "[name=\"Reunion Member\"]   Do you know how much blood is on their hands?!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Do you know how much blood is on their hands?!"
    },
    {
        "id": 28,
        "raw": "[name=\"Reunion Member\"]   Misha... We've been feared, exploited, humiliated, and persecuted...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Misha... We've been feared, exploited, humiliated, and persecuted..."
    },
    {
        "id": 29,
        "raw": "[name=\"Reunion Member\"]   ...Just because of the fact that we're Infected.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "...Just because of the fact that we're Infected."
    },
    {
        "id": 30,
        "raw": "[name=\"Reunion Member\"]   Not for any other reason.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Not for any other reason."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_012_misa_1#2\", name2=\"char_1002_nsabr_2\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#2.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"Reunion Member\"]   S-sorry, I got a bit heated. Forget what I said.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "S-sorry, I got a bit heated. Forget what I said."
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_012_misa_1#4\")]",
        "type": "character",
        "name": "char_012_misa_1#4.png"
    },
    {
        "id": 36,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 37,
        "raw": "[Delay(time=0.4)]",
        "type": "delay",
        "time": 0.4
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_1500_skulsr\")]",
        "type": "character",
        "name": "char_1500_skulsr.png"
    },
    {
        "id": 39,
        "raw": "[name=\"Skullshatterer\"]   Ivan, come help tend to the injured.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Ivan, come help tend to the injured."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_1500_skulsr\", name2=\"char_1002_nsabr_2\", focus=2)]",
        "type": "character",
        "name": "char_1500_skulsr.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 41,
        "raw": "[name=\"Reunion Member\"]   Coming.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Coming."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_1500_skulsr\", name2=\"char_1002_nsabr_2\", focus=1)]",
        "type": "character",
        "name": "char_1500_skulsr.png",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"Skullshatterer\"]   We're only using this abandoned mine as a temporary base until we can reorganize and regroup.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "We're only using this abandoned mine as a temporary base until we can reorganize and regroup."
    },
    {
        "id": 44,
        "raw": "[name=\"Skullshatterer\"]   Once the time is right, we'll make our way back to Chernobog.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Once the time is right, we'll make our way back to Chernobog."
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_012_misa_1#4\")]",
        "type": "character",
        "name": "char_012_misa_1#4.png"
    },
    {
        "id": 46,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 47,
        "raw": "[name=\"Misha\"]   ...Al--",
        "type": "dialog",
        "speaker": "Misha",
        "content": "...Al--"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Skullshatterer\"]   No...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "No..."
    },
    {
        "id": 50,
        "raw": "[name=\"Skullshatterer\"]   I threw away that name long ago.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "I threw away that name long ago."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Misha\"]   Why...?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Why...?"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"Skullshatterer\"]   That person already died.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "That person already died."
    },
    {
        "id": 55,
        "raw": "[name=\"Skullshatterer\"]   Just call me Skullshatterer.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Just call me Skullshatterer."
    },
    {
        "id": 56,
        "raw": "[name=\"Skullshatterer\"]   Are you... afraid?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Are you... afraid?"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 58,
        "raw": "[name=\"Misha\"]   Skull...shatterer? ...Why?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Skull...shatterer? ...Why?"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"Skullshatterer\"]   Ah... You'll soon understand.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "Ah... You'll soon understand."
    },
    {
        "id": 61,
        "raw": "[name=\"Skullshatterer\"]   After we learned that you ended up as a refugee in Lungmen, everyone volunteered to go rescue you.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "After we learned that you ended up as a refugee in Lungmen, everyone volunteered to go rescue you."
    },
    {
        "id": 62,
        "raw": "[name=\"Skullshatterer\"]   We've also accepted many new members there.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "We've also accepted many new members there."
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"Misha\"]   But... you're hurting people.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "But... you're hurting people."
    },
    {
        "id": 65,
        "raw": "[name=\"Misha\"]   I don't want to... do that...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I don't want to... do that..."
    },
    {
        "id": 66,
        "raw": "[name=\"Misha\"]   Why are the Infected fighting each other...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Why are the Infected fighting each other..."
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"Skullshatterer\"]   An eye for an eye, as things should be.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "An eye for an eye, as things should be."
    },
    {
        "id": 69,
        "raw": "[name=\"Skullshatterer\"]   There is a saying in Ursus. 'Welcome your kin as you would welcome the warm spring...'",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "There is a saying in Ursus. 'Welcome your kin as you would welcome the warm spring...'"
    },
    {
        "id": 70,
        "raw": "[name=\"Skullshatterer\"]   'But welcome your enemies...'",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "'But welcome your enemies...'"
    },
    {
        "id": 71,
        "raw": "[name=\"Skullshatterer\"]   ... ... ...",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "... ... ..."
    },
    {
        "id": 72,
        "raw": "[Delay(time=0.3)]",
        "type": "delay",
        "time": 0.3
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"Misha\"]   What's wrong?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "What's wrong?"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4.png",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"Skullshatterer\"]   ...Do you know?",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "...Do you know?"
    },
    {
        "id": 77,
        "raw": "[name=\"Skullshatterer\"]   No... No, you don't.",
        "type": "dialog",
        "speaker": "Skullshatterer",
        "content": "No... No, you don't."
    },
    {
