        "type": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "id": 99,
        "raw": "[name=\"Mephisto\"]   Pah.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Pah."
    },
    {
