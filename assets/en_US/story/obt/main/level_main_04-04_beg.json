        "name": "char_002_amiya_1"
    },
    {
        "id": 69,
        "raw": "[name=\"Amiya\"]   Ah, excuse me, I need to take this call...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Ah, excuse me, I need to take this call..."
    },
    {
        "id": 70,
        "raw": "[name=\"Amiya\"]   This is Amiya.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "This is Amiya."
    },
