        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"Ch'en\"]   Continue.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Continue."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Amiya\"]   Mm, to summarize...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Mm, to summarize..."
    },
    {
        "id": 50,
        "raw": "[name=\"Amiya\"]   Rhodes Island suggests a joint operation to completely eliminate the remaining Reunion forces in Lungmen.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Rhodes Island suggests a joint operation to completely eliminate the remaining Reunion forces in Lungmen."
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"Ch'en\"]   No good.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "No good."
    },
    {
        "id": 53,
        "raw": "[name=\"Ch'en\"]   The L.G.D. will not permit it.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "The L.G.D. will not permit it."
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"Amiya\"]   ...What? Madam Ch'en...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...What? Madam Ch'en...?"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"Ch'en\"]   I said, no.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I said, no."
    },
    {
        "id": 58,
        "raw": "[name=\"Ch'en\"]   You... are an Infected.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "You... are an Infected."
    },
    {
        "id": 59,
        "raw": "[name=\"Ch'en\"]   If you carry out any more missions in the slums, you'll only cause greater disorder.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "If you carry out any more missions in the slums, you'll only cause greater disorder."
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"Amiya\"]   ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"Ch'en\"]   This is our decision.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "This is our decision."
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"Amiya\"]   But--",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "But--"
    },
    {
        "id": 66,
        "raw": "[PlaySound(key=\"$phone\")]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/dialog/d_avg_phone.mp3"
