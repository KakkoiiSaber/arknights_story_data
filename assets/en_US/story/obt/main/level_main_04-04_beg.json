    },
    {
        "id": 72,
        "raw": "[name=\"???\"]   Is, is this Amiya?",
        "type": "dialog",
        "speaker": "???",
        "content": "Is, is this Amiya?"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 74,
        "raw": "[name=\"Amiya\"]   ...! Jessica?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...! Jessica?"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1#6\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#6",
        "focus": -1
    },
    {
        "id": 76,
        "raw": "[name=\"Jessica\"]   Yes, Jessica here...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Yes, Jessica here..."
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 78,
        "raw": "[name=\"Amiya\"]   Are you on a stealth mission? I can barely hear you...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Are you on a stealth mission? I can barely hear you..."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 80,
        "raw": "[name=\"Jessica\"]   We found them in the city ruins...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "We found them in the city ruins..."
    },
    {
        "id": 81,
        "raw": "[name=\"Jessica\"]   Reunion's leaders...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Reunion's leaders..."
    },
    {
        "id": 82,
        "raw": "[name=\"Jessica\"]   There are... two of them.",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "There are... two of them."
