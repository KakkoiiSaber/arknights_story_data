        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"Ch'en\"]  Impossible.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Impossible."
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"Swire\"]  You think the impossible happened?",
        "type": "dialog",
        "speaker": "Swire",
        "content": "You think the impossible happened?"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
