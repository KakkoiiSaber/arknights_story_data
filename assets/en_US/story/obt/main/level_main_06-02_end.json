        "raw": "[name=\"Ch'en\"]  Not this time.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Not this time."
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"Swire\"]  I'm thinking you lost contact with a spy.",
        "type": "dialog",
        "speaker": "Swire",
        "content": "I'm thinking you lost contact with a spy."
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"Ch'en\"]  Could you not waste your intuition on stuff like this?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Could you not waste your intuition on stuff like this?"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 81,
        "raw": "[name=\"Swire\"]  At least you own up to it when I guess right. Infected?",
        "type": "dialog",
        "speaker": "Swire",
        "content": "At least you own up to it when I guess right. Infected?"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#5\",focus=2)]",
