        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 28,
        "raw": "[name=\"Blaze\"]  Come on, Doctor.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Come on, Doctor."
    },
    {
        "id": 29,
