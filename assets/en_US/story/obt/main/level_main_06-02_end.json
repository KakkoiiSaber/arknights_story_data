        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"Swire\"]  You think he turned?",
        "type": "dialog",
        "speaker": "Swire",
        "content": "You think he turned?"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=2)]",
