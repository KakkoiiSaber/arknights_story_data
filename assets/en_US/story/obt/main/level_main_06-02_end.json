        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"Ch'en\"]  Yep.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Yep."
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=1)]",
