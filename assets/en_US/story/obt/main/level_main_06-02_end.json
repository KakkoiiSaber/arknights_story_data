        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"Ch'en\"]  None of your business, 'Little Miss.'",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "None of your business, 'Little Miss.'"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 73,
        "raw": "[name=\"Swire\"]  Hey, shouldn't we be sharing intel?",
        "type": "dialog",
        "speaker": "Swire",
        "content": "Hey, shouldn't we be sharing intel?"
