    },
    {
        "id": 15,
        "raw": "[name=\"Blaze\"]   This is Blaze. Come in, Team Blaze-4. Captured a dozen or so Reunion.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "This is Blaze. Come in, Team Blaze-4. Captured a dozen or so Reunion."
    },
    {
        "id": 16,
        "raw": "[name=\"Blaze\"]   Come recover them when you can. Otherwise just hand them over to Lungmen.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Come recover them when you can. Otherwise just hand them over to Lungmen."
    },
    {
        "id": 17,
        "raw": "[name=\"Blaze\"]   Hey, Lungmenite, do me a favor and lower your crossbows. We're all friends here.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Hey, Lungmenite, do me a favor and lower your crossbows. We're all friends here."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
        "name": "char_015_lmg"
    },
    {
        "id": 19,
        "raw": "[name=\"L. G. D. Officer\"]  ......",
        "type": "dialog",
        "speaker": "L. G. D. Officer",
        "content": "......"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_017_homura_3#9\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#9",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Blaze\"]  You still don't trust me? I saved your life.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "You still don't trust me? I saved your life."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_017_homura_3#8\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#8",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"L. G. D. Officer\"]  Get back...! I mean, y- you're... you're Infected...!",
        "type": "dialog",
        "speaker": "L. G. D. Officer",
        "content": "Get back...! I mean, y- you're... you're Infected...!"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_017_homura_3#5\")]",
        "type": "character",
        "name": "char_017_homura_3#5"
    },
    {
        "id": 25,
        "raw": "[name=\"Blaze\"]  Yeah. Yeah I am.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Yeah. Yeah I am."
    },
    {
        "id": 26,
        "raw": "[name=\"Blaze\"]  Ugh.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Ugh."
    },
