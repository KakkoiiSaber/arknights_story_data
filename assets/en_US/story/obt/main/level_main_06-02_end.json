    },
    {
        "id": 9,
        "raw": "[name=\"Blaze\"]  I'm sorry.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "I'm sorry."
    },
    {
        "id": 10,
        "raw": "[name=\"Blaze\"]  Now, me beating on you doesn't mean we aren't on the same side.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Now, me beating on you doesn't mean we aren't on the same side."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_017_homura_3#8\")]",
        "type": "character",
        "name": "char_017_homura_3#8"
    },
    {
        "id": 12,
        "raw": "[name=\"Blaze\"]  Haha! Yeah, no, seriously. It does. We're not on the same side.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Haha! Yeah, no, seriously. It does. We're not on the same side."
    },
    {
