    {
        "id": 65,
        "raw": "[name=\"Ch'en\"]  ...What's going on?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...What's going on?"
    },
    {
        "id": 66,
        "raw": "[name=\"Ch'en\"]  I'm getting vitals, but no reports? And no sign of any distress signals either.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I'm getting vitals, but no reports? And no sign of any distress signals either."
    },
    {
        "id": 67,
        "raw": "[name=\"Ch'en\"]  Something's not right...",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Something's not right..."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_308_swire_1#1\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#1",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"Swire\"]  Shouldn't you be, like, commanding? What are you standing here staring at?",
        "type": "dialog",
        "speaker": "Swire",
        "content": "Shouldn't you be, like, commanding? What are you standing here staring at?"
    },
