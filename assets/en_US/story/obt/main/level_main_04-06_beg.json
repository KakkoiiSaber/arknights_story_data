    },
    {
        "id": 69,
        "raw": "[name=\"Hoshiguma\"]   Ch'en, where are you going?!",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Ch'en, where are you going?!"
    },
    {
        "id": 70,
        "raw": "[name=\"Hoshiguma\"]   Damn it, she just took off running! Who could that have been...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Damn it, she just took off running! Who could that have been..."
    },
