    {
        "id": 49,
        "raw": "[name=\"Ch'en\"]  I'm ready, Hoshiguma.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I'm ready, Hoshiguma."
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 51,
        "raw": "[name=\"Hoshiguma\"]  That's more like it. I'm going to flush them out of their ambush spots. Give me three minutes.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "That's more like it. I'm going to flush them out of their ambush spots. Give me three minutes."
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"Ch'en\"]  Doing all that by yourself in three minutes? That's way too reckless!",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Doing all that by yourself in three minutes? That's way too reckless!"
    },
    {
        "id": 54,
        "raw": "[name=\"Ch'en\"]  If you show any signs of needing help, we're going to attack.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "If you show any signs of needing help, we're going to attack."
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"Hoshiguma\"]  No, just give me my three minutes.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "No, just give me my three minutes."
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"Ch'en\"]  ...It's all I'm going to need.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...It's all I'm going to need."
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"Hoshiguma\"]  Here we go.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Here we go."
    },
