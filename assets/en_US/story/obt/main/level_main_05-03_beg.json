    {
        "id": 6,
        "raw": "[name=\"\"]   11:11 A.M   Weather/Drizzle",
        "type": "narration",
        "content": "11:11 A.M   Weather/Drizzle"
    },
    {
        "id": 7,
        "raw": "[name=\"\"]   Outside of Muk Wo Warehouse, Sam Cheong Chai, Central Lungmen",
        "type": "narration",
        "content": "Outside of Muk Wo Warehouse, Sam Cheong Chai, Central Lungmen"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"Hoshiguma\"]  The scouting is more or less complete. Our observation spot is stealthy enough, and there's nobody around the warehouse.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "The scouting is more or less complete. Our observation spot is stealthy enough, and there's nobody around the warehouse."
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"Ch'en\"]  Looks like it's an abandoned construction site with piles of construction materials left behind. There are traces of things being dragged around.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Looks like it's an abandoned construction site with piles of construction materials left behind. There are traces of things being dragged around."
    },
    {
        "id": 12,
        "raw": "[name=\"Ch'en\"]  Reunion must have set up an ambush here.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Reunion must have set up an ambush here."
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"Hoshiguma\"]  Ch'en, is Phal your informant?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Ch'en, is Phal your informant?"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"Ch'en\"]  ...Yes. Did you overhear our conversation?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...Yes. Did you overhear our conversation?"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"Hoshiguma\"]  I tried my best not to.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I tried my best not to."
    },
    {
        "id": 19,
        "raw": "[name=\"Hoshiguma\"]  I'e known him for a long time, more than 10 years. There's no way I wouldn't recognize his voice.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I'e known him for a long time, more than 10 years. There's no way I wouldn't recognize his voice."
    },
    {
        "id": 20,
        "raw": "[name=\"Hoshiguma\"]  When did you make him a informant?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "When did you make him a informant?"
    },
    {
        "id": 21,
        "raw": "[name=\"Hoshiguma\"]  He was infected more than a year ago. At that time, he disappeared from his bar, leaving the glasses he cleaned every day unattended and covered in dust.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "He was infected more than a year ago. At that time, he disappeared from his bar, leaving the glasses he cleaned every day unattended and covered in dust."
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"Ch'en\"]  Maybe even before that.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Maybe even before that."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"Hoshiguma\"]  You at least should have told me about it.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "You at least should have told me about it."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"Ch'en\"]  Looks like it's about to rain. Let's get started and chase the enemies out of their ambush spots.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Looks like it's about to rain. Let's get started and chase the enemies out of their ambush spots."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"Hoshiguma\"]  Sigh...",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Sigh..."
    },
    {
        "id": 30,
        "raw": "[name=\"Hoshiguma\"]  We're too late. He's going to bleed out.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "We're too late. He's going to bleed out."
    },
    {
        "id": 31,
        "raw": "[name=\"Hoshiguma\"]  I'll draw Reunion's fire. The rest of you should seize the opportunity to surround them and end this battle quickly.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I'll draw Reunion's fire. The rest of you should seize the opportunity to surround them and end this battle quickly."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Ch'en\"]  Too dangerous.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Too dangerous."
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"Hoshiguma\"]  But it's the fastest way to win. You can trust me on this one.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "But it's the fastest way to win. You can trust me on this one."
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"Ch'en\"]  I always trust you.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I always trust you."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_010_chen_1#1\")]",
        "type": "character",
        "name": "char_010_chen_1#1"
    },
    {
        "id": 39,
        "raw": "[name=\"Ch'en\"]  Follow Hoshiguma's instructions. Make it quick.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Follow Hoshiguma's instructions. Make it quick."
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
        "name": "char_015_lmg"
    },
    {
        "id": 41,
        "raw": "[name=\"L.G.D. Agent\"]  Yessir!",
        "type": "dialog",
        "speaker": "L.G.D. Agent",
        "content": "Yessir!"
    },
