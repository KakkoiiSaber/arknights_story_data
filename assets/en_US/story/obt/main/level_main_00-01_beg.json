    {
        "id": 16,
        "raw": "[name=\"Reunion Member\"]  Search all these houses! I want every single room turned inside out!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Search all these houses! I want every single room turned inside out!"
    },
    {
        "id": 17,
        "raw": "[name=\"Female\"]  Let go of me...! No! You can't...",
        "type": "dialog",
        "speaker": "Female",
        "content": "Let go of me...! No! You can't..."
    },
    {
        "id": 18,
        "raw": "[name=\"Reunion Member\"]  Trying to resist? Too late, you filthy Chernos!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Trying to resist? Too late, you filthy Chernos!"
    },
    {
        "id": 19,
        "raw": "[name=\"Male\"]  Just run! Don't worry about me... Save... our child...",
        "type": "dialog",
        "speaker": "Male",
        "content": "Just run! Don't worry about me... Save... our child..."
    },
    {
        "id": 20,
        "raw": "[name=\"Child\"]  Mama... Mama...!",
        "type": "dialog",
        "speaker": "Child",
        "content": "Mama... Mama...!"
    },
    {
        "id": 21,
        "raw": "[name=\"Ursus Guard\"]  Forget about the civilians! Hold the line first! There are too many masked goons coming!",
        "type": "dialog",
        "speaker": "Ursus Guard",
        "content": "Forget about the civilians! Hold the line first! There are too many masked goons coming!"
    },
    {
        "id": 22,
        "raw": "[name=\"Reunion Member\"]  Don't give the cops any time to rest! Keep attacking!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Don't give the cops any time to rest! Keep attacking!"
    },
    {
        "id": 23,
        "raw": "[name=\"Ursus Guard\"]  Where are our reinforcements?! We're going to get overrun...",
        "type": "dialog",
        "speaker": "Ursus Guard",
        "content": "Where are our reinforcements?! We're going to get overrun..."
    },
    {
        "id": 24,
        "raw": "[name=\"Reunion Member\"]  Attack, attack!!",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Attack, attack!!"
    },
