        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 112,
        "raw": "[name=\"Dobermann\"]  ...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "..."
    },
    {
        "id": 113,
        "raw": "[name=\"Dobermann\"]  Understood. I'll follow your command.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Understood. I'll follow your command."
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 115,
        "raw": "[name=\"Dobermann\"]  All squads, listen up.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "All squads, listen up."
    },
    {
        "id": 116,
        "raw": "[name=\"Dobermann\"]  We have the element of surprise - these Reunion members don't know that we're here yet.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "We have the element of surprise - these Reunion members don't know that we're here yet."
    },
    {
        "id": 117,
        "raw": "[name=\"Dobermann\"]  Remember, be decisive! Take them out, cleanly and swiftly.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Remember, be decisive! Take them out, cleanly and swiftly."
    },
    {
        "id": 118,
        "raw": "[name=\"Dobermann\"]  Dr. {@nickname}, gather your team. It's time for you to prove yourself.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Dr. {@nickname}, gather your team. It's time for you to prove yourself."
    },
    {
        "id": 119,
        "raw": "[name=\"Dobermann\"]  We have no more time to second-guess ourselves.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "We have no more time to second-guess ourselves."
    },
    {
        "id": 120,
