        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 20,
        "raw": "[name=\"Amiya\"]  Not good enough... At this rate, they're going to close in on us.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Not good enough... At this rate, they're going to close in on us."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"Dobermann\"]  I've already found the weak point in their line, but without reinforcements, it's taking all we have just to hold them back!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I've already found the weak point in their line, but without reinforcements, it's taking all we have just to hold them back!"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 24,
        "raw": "[name=\"Amiya\"]  ...Please hold out a bit longer! Focus your fire on the ranged enemies!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...Please hold out a bit longer! Focus your fire on the ranged enemies!"
    },
    {
        "id": 25,
        "raw": "[name=\"Amiya\"]  Our Casters will take care of their vanguard!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Our Casters will take care of their vanguard!"
