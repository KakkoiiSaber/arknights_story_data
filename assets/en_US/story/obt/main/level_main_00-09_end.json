    },
    {
        "id": 51,
        "raw": "[name=\"Mephisto\"]  That's right, let me see how you struggle!",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "That's right, let me see how you struggle!"
    },
    {
        "id": 52,
        "raw": "[name=\"Mephisto\"]  Now, Casters. move to C7. Capture their Rook!",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Now, Casters. move to C7. Capture their Rook!"
    },
