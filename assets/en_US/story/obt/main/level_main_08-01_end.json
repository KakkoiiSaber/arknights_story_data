    },
    {
        "id": 68,
        "raw": "[name=\"Old Man\"] Ah, good question. Heh, hahah, sorry, I don't remember. Look at me now. Look at my memory...",
        "type": "dialog",
        "speaker": "Old Man",
        "content": "Ah, good question. Heh, hahah, sorry, I don't remember. Look at me now. Look at my memory..."
