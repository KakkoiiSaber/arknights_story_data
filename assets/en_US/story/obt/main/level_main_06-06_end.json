    {
        "id": 58,
        "raw": "[name=\"Amiya\"]  GreyThroat?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "GreyThroat?"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 60,
        "raw": "[name=\"GreyThroat\"]  He...",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "He..."
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"Amiya\"]  If I recall correctly, he was the crossbowman with Mephisto, and one of Reunion's commanders.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "If I recall correctly, he was the crossbowman with Mephisto, and one of Reunion's commanders."
    },
    {
        "id": 63,
        "raw": "[name=\"Amiya\"]  ...You knew him?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...You knew him?"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_367_swllow_1#3\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4.png",
        "name2": "char_367_swllow_1#3",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"GreyThroat\"]  I don't know. I'm not sure if you'd say we... knew each other.",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "I don't know. I'm not sure if you'd say we... knew each other."
    },
    {
        "id": 66,
        "raw": "[Decision(options=\"It seems like there's not much Rhodes Island can do.;......;Have we ever actually saved any Infected?\", values=\"1;2;3\")]",
        "type": "decision",
        "options": "It seems like there's not much Rhodes Island can do.;......;Have we ever actually saved any Infected?",
        "values": "1;2;3"
    },
    {
        "id": 67,
        "raw": "[Predicate(references=\"1;2;3\")]",
        "type": "predicate",
        "references": "1;2;3"
    },
    {
        "id": 68,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
