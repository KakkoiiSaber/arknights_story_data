        "focus": 1
    },
    {
        "id": 182,
        "raw": "[name=\"???\"]  Oh...?",
        "type": "dialog",
        "speaker": "???",
        "content": "Oh...?"
    },
    {
        "id": 183,
        "raw": "[name=\"???\"]  You have my condolences.",
