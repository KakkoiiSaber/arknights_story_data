        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 174,
        "raw": "[name=\"???\"]  Should I introduce myself?",
        "type": "dialog",
        "speaker": "???",
        "content": "Should I introduce myself?"
    },
    {
        "id": 175,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 176,
        "raw": "[name=\"GreyThroat\"]  No thank you.",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "No thank you."
    },
    {
        "id": 177,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 178,
        "raw": "[name=\"???\"]  It's dangerous to make friends with the Infected.",
        "type": "dialog",
        "speaker": "???",
        "content": "It's dangerous to make friends with the Infected."
    },
    {
        "id": 179,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 180,
        "raw": "[name=\"GreyThroat\"]  I don't care if my friends are sick or not.",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "I don't care if my friends are sick or not."
    },
    {
        "id": 181,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_041.png",
