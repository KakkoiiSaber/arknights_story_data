        "name": "char_017_homura_3#5.png",
        "name2": "char_002_amiya_1#1",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"Blaze\"]  Did she have an epiphany?",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "Did she have an epiphany?"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#1\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#5.png",
        "name2": "char_002_amiya_1#1",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"Amiya\"]  You don't know what she's been through?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "You don't know what she's been through?"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#1\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#5.png",
        "name2": "char_002_amiya_1#1",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"Blaze\"]  She never shared. We're not close.",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "She never shared. We're not close."
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#5.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 157,
        "raw": "[name=\"Amiya\"]  Her parents were Oripathy researchers, doing work for the Infected. They died in a clash between the Infected and police.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Her parents were Oripathy researchers, doing work for the Infected. They died in a clash between the Infected and police."
    },
    {
        "id": 158,
        "raw": "[name=\"Amiya\"]  She just thinks her suffering and ours are the same.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "She just thinks her suffering and ours are the same."
    },
    {
        "id": 159,
        "raw": "[name=\"Amiya\"]  GreyThroat is more sensitive than you give her credit for. She just doesn't express herself.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "GreyThroat is more sensitive than you give her credit for. She just doesn't express herself."
    },
    {
        "id": 160,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#5.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 161,
        "raw": "[name=\"Blaze\"]  How am I supposed to know if she doesn't speak up?",
        "type": "dialog",
        "speaker": "Blaze",
        "content": "How am I supposed to know if she doesn't speak up?"
    },
