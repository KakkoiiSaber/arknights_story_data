        "speaker": "???",
        "content": "You have my condolences."
    },
    {
        "id": 184,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 185,
        "raw": "[name=\"GreyThroat\"]  Why did you ask me that?",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "Why did you ask me that?"
    },
    {
        "id": 186,
        "raw": "[Character(name=\"avg_npc_041\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_041.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 187,
        "raw": "[name=\"???\"]  Because I worried you were making friends with Infected.",
        "type": "dialog",
        "speaker": "???",
        "content": "Because I worried you were making friends with Infected."
    },
