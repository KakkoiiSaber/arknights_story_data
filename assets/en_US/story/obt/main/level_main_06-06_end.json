    {
        "id": 17,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"Phantom Crossbowman\"]  ......",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "......"
    },
    {
        "id": 19,
        "raw": "[name=\"Phantom Crossbowman\"]  He stopped crying.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "He stopped crying."
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Reunion Member\"]  His eyes... it's like he's braindead.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "His eyes... it's like he's braindead."
    },
    {
        "id": 22,
        "raw": "[name=\"Reunion Member\"]  I don't care about him. I miss Faust. He saved my life. He was a good commander.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "I don't care about him. I miss Faust. He saved my life. He was a good commander."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Phantom Crossbowman\"]  Faust gave Mephisto to us... It was his last order. We're going to carry it out.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Faust gave Mephisto to us... It was his last order. We're going to carry it out."
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"Reunion Member\"]  None of my business.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "None of my business."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Phantom Crossbowman\"]  Get out of the city with us and you have a better shot at survival.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Get out of the city with us and you have a better shot at survival."
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"Reunion Member\"]  ...Okay. Let's go.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "...Okay. Let's go."
    },
    {
        "id": 31,
        "raw": "[name=\"Reunion Member\"]  Where are you taking him?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Where are you taking him?"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"Phantom Crossbowman\"]  Faust said he doesn't want us to take him back to Chernobog.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Faust said he doesn't want us to take him back to Chernobog."
    },
    {
        "id": 34,
        "raw": "[name=\"Phantom Crossbowman\"]  ...So where can he go?",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "...So where can he go?"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"Reunion Member\"]  How long were you with Faust?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "How long were you with Faust?"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"Phantom Crossbowman\"]  Um... At first, I'd say he was with us.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Um... At first, I'd say he was with us."
    },
    {
        "id": 39,
        "raw": "[name=\"Phantom Crossbowman\"]  Four or five years ago, Faust couldn't use any tactics and he really couldn't shoot a crossbow. We taught him all that.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Four or five years ago, Faust couldn't use any tactics and he really couldn't shoot a crossbow. We taught him all that."
    },
    {
        "id": 40,
        "raw": "[name=\"Phantom Crossbowman\"]  He studied hard, trained harder, compared notes with the Yetis, sparred with Patriot's boys, and got stronger and stronger...",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "He studied hard, trained harder, compared notes with the Yetis, sparred with Patriot's boys, and got stronger and stronger..."
    },
    {
        "id": 41,
        "raw": "[name=\"Phantom Crossbowman\"]  Patriot and FrostNova both taught him. He became our leader, even though we never much called him that, it's what he was.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Patriot and FrostNova both taught him. He became our leader, even though we never much called him that, it's what he was."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"Reunion Member\"]  You lucked out.",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "You lucked out."
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"Phantom Crossbowman\"]  No matter how Mephisto got, Faust never made us do anything.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "No matter how Mephisto got, Faust never made us do anything."
    },
    {
        "id": 46,
        "raw": "[name=\"Phantom Crossbowman\"]  Archers, don't save your high-explosive bolts.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Archers, don't save your high-explosive bolts."
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"Reunion Member\"]  Won't those bolts be useful against the L. G. D.?",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "Won't those bolts be useful against the L. G. D.?"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_1002_nsabr_1\",name2=\"avg_npc_016\",focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_1.png",
        "name2": "avg_npc_016",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"Phantom Crossbowman\"]  Faust insisted we honor the dead like this.",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "Faust insisted we honor the dead like this."
    },
    {
        "id": 51,
        "raw": "[name=\"Phantom Crossbowman\"]  'It's not a waste to show respect.'",
        "type": "dialog",
        "speaker": "Phantom Crossbowman",
        "content": "'It's not a waste to show respect.'"
    },
