        "focus": 2
    },
    {
        "id": 171,
        "raw": "[name=\"GreyThroat\"]  ...I don't know.",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "...I don't know."
    },
    {
        "id": 172,
        "raw": "[name=\"GreyThroat\"]  Who are you?",
        "type": "dialog",
        "speaker": "GreyThroat",
        "content": "Who are you?"
