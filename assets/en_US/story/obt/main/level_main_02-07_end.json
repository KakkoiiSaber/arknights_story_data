        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"Misha\"]   I'm just a bit dizzy... Don't worry.",
        "type": "dialog",
        "speaker": "Misha",
        "content": "I'm just a bit dizzy... Don't worry."
    },
    {
        "id": 50,
        "raw": "[name=\"Misha\"]   Is Reunion... still chasing us?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Is Reunion... still chasing us?"
    },
    {
        "id": 51,
        "raw": "[name=\"Misha\"]   I don't know what they want from me...",
