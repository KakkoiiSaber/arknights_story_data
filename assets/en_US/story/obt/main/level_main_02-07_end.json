        "id": 59,
        "raw": "[name=\"Amiya\"]   Let's leave right away.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Let's leave right away."
    },
    {
        "id": 60,
        "raw": "[name=\"Amiya\"]   Shortly, we'll be able to exit the slums and meet up with the L.G.D.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Shortly, we'll be able to exit the slums and meet up with the L.G.D."
