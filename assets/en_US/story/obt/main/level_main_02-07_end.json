        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"Amiya\"]   Be careful! You can't move around yet!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Be careful! You can't move around yet!"
    },
    {
        "id": 48,
