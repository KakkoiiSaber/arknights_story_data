        "content": "Leave...?"
    },
    {
        "id": 11,
        "raw": "[name=\"Infected\"]   Where... would we go?",
        "type": "dialog",
        "speaker": "Infected",
        "content": "Where... would we go?"
    },
    {
        "id": 12,
        "raw": "[name=\"Infected\"]   This was a place we could call home... But it's all ruined now...",
        "type": "dialog",
        "speaker": "Infected",
