    {
        "id": 8,
        "raw": "[name=\"Dobermann\"]  ...If only it was just you.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "...If only it was just you."
    },
    {
        "id": 9,
        "raw": "[name=\"Dobermann\"]  We never had much time anyway.",
