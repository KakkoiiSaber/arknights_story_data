    {
        "id": 14,
        "raw": "[name=\"Dobermann\"]  The shape of the Catastrophe cloud is more clearly defined than the black haze it was before.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "The shape of the Catastrophe cloud is more clearly defined than the black haze it was before."
    },
    {
        "id": 15,
        "raw": "[name=\"Dobermann\"]  Tsk. I don't like the feeling I get from watching it form over our heads. What a bad omen.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Tsk. I don't like the feeling I get from watching it form over our heads. What a bad omen."
