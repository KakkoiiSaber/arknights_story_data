    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"Liskarm\"]   We'll see you soon enough.",
        "type": "dialog",
        "speaker": "Liskarm",
        "content": "We'll see you soon enough."
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"Franka\"]   It won't be long before we're back on standby in Rhodes Island.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "It won't be long before we're back on standby in Rhodes Island."
    },
    {
        "id": 77,
        "raw": "[name=\"Franka\"]   Don't miss me too much.",
        "type": "dialog",
        "speaker": "Franka",
        "content": "Don't miss me too much."
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"Exusiai\"]   Well, unfortunately, we don't have such an official-sounding reason. Right, Texas?",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Well, unfortunately, we don't have such an official-sounding reason. Right, Texas?"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 81,
        "raw": "[name=\"Texas\"]   Hold on a second...",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Hold on a second..."
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"Exusiai\"]   Penguin Logistics... is about to go on vacation!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Penguin Logistics... is about to go on vacation!"
    },
    {
        "id": 84,
        "raw": "[name=\"Exusiai\"]   It's only going to one precious day... But still--",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "It's only going to one precious day... But still--"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 86,
        "raw": "[name=\"Texas\"]   ...Apologies. This isn't the best time to talk about it.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "...Apologies. This isn't the best time to talk about it."
    },
    {
        "id": 87,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2.png"
    },
    {
        "id": 89,
        "raw": "[name=\"Amiya\"]   Don't worry... Everyone needs to get some rest.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Don't worry... Everyone needs to get some rest."
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 91,
        "raw": "[name=\"Texas\"]   ...I should be the one saying that to you.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "...I should be the one saying that to you."
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"Amiya\"]   Huh...?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Huh...?"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 95,
        "raw": "[name=\"Exusiai\"]   That's right, that's right. Amiya, girl, you really need a bit of R&R!",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "That's right, that's right. Amiya, girl, you really need a bit of R&R!"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 97,
        "raw": "[name=\"Amiya\"]   There are many things in Rhodes Island that must be taken care of...",
