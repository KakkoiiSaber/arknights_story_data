    {
        "id": 65,
        "raw": "[name=\"Amiya\"]   Ah... You made it, Doctor.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Ah... You made it, Doctor."
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 67,
        "raw": "[name=\"Texas\"]   Good timing, Dr. {@nickname}.",
        "type": "dialog",
        "speaker": "Texas",
        "content": "Good timing, Dr. {@nickname}."
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"Exusiai\"]   Our job here is about done. You probably won't see us for a while~",
        "type": "dialog",
        "speaker": "Exusiai",
        "content": "Our job here is about done. You probably won't see us for a while~"
    },
    {
