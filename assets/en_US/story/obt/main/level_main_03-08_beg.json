        "name": "char_010_chen_1#2.png"
    },
    {
        "id": 73,
        "raw": "[name=\"Ch'en\"]   Our flank will collapse if we can't seize the initiative... Prepare to counterattack!",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Our flank will collapse if we can't seize the initiative... Prepare to counterattack!"
