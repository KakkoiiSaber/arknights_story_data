    {
        "id": 71,
        "raw": "[name=\"L.G.D. Agent\"]   He's planning to surround us from multiple directions!",
        "type": "dialog",
        "speaker": "L.G.D. Agent",
        "content": "He's planning to surround us from multiple directions!"
