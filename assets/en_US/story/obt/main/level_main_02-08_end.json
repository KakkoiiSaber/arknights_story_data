    },
    {
        "id": 81,
        "raw": "[name=\"Crownslayer\"]   If we can take control of Lungmen, Reunion will have a huge advantage.",
        "type": "dialog",
        "speaker": "Crownslayer",
        "content": "If we can take control of Lungmen, Reunion will have a huge advantage."
    },
    {
        "id": 82,
        "raw": "[name=\"Crownslayer\"]   Of course, this comes with a high risk.",
