    {
        "id": 63,
        "raw": "[name=\"Reunion Member\"]   H-how did they... get behind me...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "H-how did they... get behind me..."
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_259_Jessica_1#3\")]",
        "type": "character",
        "name": "char_259_Jessica_1#3"
    },
    {
        "id": 65,
        "raw": "[name=\"Jessica\"]  ...Eeehh??",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "...Eeehh??"
    },
