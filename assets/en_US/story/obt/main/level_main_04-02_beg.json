        "name": "char_193_frostl_1"
    },
    {
        "id": 73,
        "raw": "[name=\"Frostleaf\"]   We're fine for now, Dr. Kal'tsit. I've taken out the enemy.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "We're fine for now, Dr. Kal'tsit. I've taken out the enemy."
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_219_meteo_1\",name2=\"char_193_frostl_1\",focus=1)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"Meteorite\"]   You really are fast...",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "You really are fast..."
    },
    {
        "id": 76,
        "raw": "[name=\"Meteorite\"]   I couldn't even see how you managed to get over there and come back so quickly.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "I couldn't even see how you managed to get over there and come back so quickly."
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_219_meteo_1\",name2=\"char_193_frostl_1\",focus=2)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"Frostleaf\"]   --Actually, I never even left.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "--Actually, I never even left."
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_219_meteo_1\",name2=\"char_193_frostl_1\",focus=1)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"Meteorite\"]   ...",
