        "id": 6,
        "raw": "[name=\"Jessica\"]   Th-there are two enemies left!",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Th-there are two enemies left!"
    },
    {
        "id": 7,
        "raw": "[name=\"Jessica\"]   They're running toward the building to our east--",
