    {
        "id": 52,
        "raw": "[name=\"Kal'tsit\"]   Always could. Indeed, you can't afford to let your guard down yet.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "Always could. Indeed, you can't afford to let your guard down yet."
    },
    {
        "id": 53,
