        "block": "true,",
        "fadetime": 1
    },
    {
        "id": 169,
        "raw": "[name=\"Frostleaf\"]   I once heard of a certain legend.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "I once heard of a certain legend."
    },
    {
        "id": 170,
        "raw": "[name=\"Frostleaf\"]   ...about a creature called the 'yeti.'",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "...about a creature called the 'yeti.'"
    },
