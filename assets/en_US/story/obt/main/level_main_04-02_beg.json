        "name": "char_219_meteo_1",
        "focus": -1
    },
    {
        "id": 82,
        "raw": "[CharacterCutin(widgetID=\"1\", name=\"char_003_kalts_1\", style=\"cutin\", fadestyle= \"horiz_expand_center\", fadetime=0.5, offsetx=0, width=200, block=true)]",
