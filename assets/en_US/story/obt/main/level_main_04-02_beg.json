        "id": 66,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 67,
        "raw": "[name=\"Frostleaf\"]  If I can attack you from behind, that means you were too slow.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "If I can attack you from behind, that means you were too slow."
