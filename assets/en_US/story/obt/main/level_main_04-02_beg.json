    {
        "id": 128,
        "raw": "[name=\"Meteorite\"]   What happened?",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "What happened?"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 130,
        "raw": "[name=\"Frostleaf\"]   ...You two didn't feel it?",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "...You two didn't feel it?"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_259_Jessica_1\", focus=2)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_259_Jessica_1",
        "focus": 2
    },
    {
        "id": 132,
        "raw": "[name=\"Jessica\"]   Huh? What...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Huh? What..."
    },
    {
        "id": 133,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 134,
        "raw": "[name=\"Frostleaf\"]   The temperature.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "The temperature."
    },
    {
        "id": 135,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_259_Jessica_1\", focus=2)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_259_Jessica_1",
        "focus": 2
    },
    {
        "id": 136,
        "raw": "[name=\"Jessica\"]   Now that you mentioned it... it does seem colder...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Now that you mentioned it... it does seem colder..."
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_259_Jessica_1\", focus=1)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_259_Jessica_1",
        "focus": 1
    },
    {
        "id": 138,
        "raw": "[name=\"Frostleaf\"]   The temperature.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "The temperature."
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_193_frostl_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_193_frostl_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 140,
        "raw": "[name=\"Meteorite\"]   ...Indeed. There's at least a five-degree difference compared to the temperature outside.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "...Indeed. There's at least a five-degree difference compared to the temperature outside."
    },
    {
        "id": 141,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 142,
        "raw": "[name=\"Jessica\"]   How could such fair weather... change so suddenly...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "How could such fair weather... change so suddenly..."
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 144,
        "raw": "[name=\"Frostleaf\"]   Look above you. The weather hasn't changed.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Look above you. The weather hasn't changed."
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 146,
        "raw": "[name=\"Jessica\"]   ...Huh?",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "...Huh?"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 148,
        "raw": "[name=\"Frostleaf\"]   It's not the weather.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "It's not the weather."
    },
    {
        "id": 149,
        "raw": "[name=\"Frostleaf\"]   It's coming from here. Come, feel this.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "It's coming from here. Come, feel this."
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_219_meteo_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"Meteorite\"]   ...The walls of the ruins?",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "...The walls of the ruins?"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_219_meteo_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"Frostleaf\"]   That's right. These walls are heat-absorbing.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "That's right. These walls are heat-absorbing."
    },
    {
        "id": 154,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"Jessica\"]   ...No way?!",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "...No way?!"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 157,
        "raw": "[name=\"Frostleaf\"]   Before we came, the heat absorption had probably already worn off.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Before we came, the heat absorption had probably already worn off."
    },
    {
        "id": 158,
        "raw": "[name=\"Frostleaf\"]   It's returning to the previous temperature.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "It's returning to the previous temperature."
    },
    {
        "id": 159,
        "raw": "[name=\"Frostleaf\"]   But, why?",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "But, why?"
    },
    {
        "id": 160,
        "raw": "[name=\"Frostleaf\"]   Who would leave behind something like this?",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Who would leave behind something like this?"
    },
    {
        "id": 161,
        "raw": "[Character(name=\"char_219_meteo_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 162,
        "raw": "[name=\"Meteorite\"]   ...Reunion are the only ones who've been active in these parts.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "...Reunion are the only ones who've been active in these parts."
    },
    {
        "id": 163,
        "raw": "[Character(name=\"char_259_Jessica_1\")]",
        "type": "character",
        "name": "char_259_Jessica_1"
    },
    {
        "id": 164,
        "raw": "[name=\"Jessica\"]   Reunion? Could they... do something like this?",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "Reunion? Could they... do something like this?"
    },
    {
        "id": 165,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 166,
        "raw": "[name=\"Frostleaf\"]   The Infected...",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "The Infected..."
