    },
    {
        "id": 83,
        "raw": "[name=\"Kal'tsit\"]   Projekt Red contacted me.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "Projekt Red contacted me."
    },
    {
        "id": 84,
        "raw": "[name=\"Kal'tsit\"]   There are no signs of activity from the Reunion forces hiding in Lungmen.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "There are no signs of activity from the Reunion forces hiding in Lungmen."
    },
    {
        "id": 85,
        "raw": "[name=\"Kal'tsit\"]   At this stage, it'd be best not to poke the hornet's nest.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "At this stage, it'd be best not to poke the hornet's nest."
    },
    {
        "id": 86,
        "raw": "[name=\"Kal'tsit\"]   By the way, according to the intel I've received from the other recon teams, there may a fairly substantial Reunion presence in the desert.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "By the way, according to the intel I've received from the other recon teams, there may a fairly substantial Reunion presence in the desert."
    },
    {
        "id": 87,
        "raw": "[CharacterCutin(widgetID=\"1\", fadetime=0.5, block=true)]",
        "type": "character_cutin",
        "widgetID": "1",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 89,
        "raw": "[name=\"Meteorite\"]   In other words, we're the ones who hit the jackpot?",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "In other words, we're the ones who hit the jackpot?"
    },
    {
        "id": 90,
        "raw": "[name=\"Meteorite\"]   That does put a bit of pressure on us. We're also only a recon team after all.",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "That does put a bit of pressure on us. We're also only a recon team after all."
    },
    {
        "id": 91,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 92,
        "raw": "[name=\"Jessica\"]   If that's the case, we've already eliminated two Reunion squads so far...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "If that's the case, we've already eliminated two Reunion squads so far..."
