    {
        "id": 46,
        "raw": "[name=\"Dobermann\"]  I can't hear anything anymore.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "I can't hear anything anymore."
    },
    {
        "id": 47,
        "raw": "[name=\"Dobermann\"]  We can't tell who they are from this distance.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "We can't tell who they are from this distance."
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 49,
        "raw": "[name=\"Amiya\"]  ...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "...!"
