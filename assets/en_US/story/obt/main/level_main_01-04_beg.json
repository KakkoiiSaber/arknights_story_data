    },
    {
        "id": 6,
        "raw": "[name=\"Dobermann\"]  Phew... We finally lost them.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Phew... We finally lost them."
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"Ace\"]  If we keep up the pace, we'll be out of the central region shortly and arrive at the southern exit.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "If we keep up the pace, we'll be out of the central region shortly and arrive at the southern exit."
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"Dobermann\"]  It's starting to get noisier and more chaotic...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "It's starting to get noisier and more chaotic..."
    },
    {
        "id": 11,
        "raw": "[name=\"Dobermann\"]  It might be because the Chernobog civilians trying to evacuate the city are running into Reunion.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "It might be because the Chernobog civilians trying to evacuate the city are running into Reunion."
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 13,
        "raw": "[name=\"Amiya\"]  ...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "..."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"Ace\"]  It seems like a few districts have already been vacated.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "It seems like a few districts have already been vacated."
    },
    {
        "id": 16,
        "raw": "[name=\"Ace\"]  But those who didn't make it in time are now being held up by Reunion.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "But those who didn't make it in time are now being held up by Reunion."
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 18,
        "raw": "[name=\"Nearl\"]   ...",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "..."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"Ace\"]  ——",
        "type": "dialog",
        "speaker": "Ace",
        "content": "——"
    },
    {
        "id": 21,
        "raw": "[name=\"Ace\"]  This place used to be a magificent, sprawling plaza.Now... it's been reduced to ruins.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "This place used to be a magificent, sprawling plaza.Now... it's been reduced to ruins."
    },
    {
        "id": 22,
        "raw": "[name=\"Ace\"]  This city tormented the Infected. To meet their end this way is almost poetic.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "This city tormented the Infected. To meet their end this way is almost poetic."
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Dobermann\"]  Almost...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Almost..."
    },
    {
        "id": 25,
        "raw": "[name=\"Dobermann\"]  You seem quite sentimental.",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "You seem quite sentimental."
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"Ace\"]  Perhaps, at one point...",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Perhaps, at one point..."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
