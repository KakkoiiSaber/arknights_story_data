        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 51,
        "raw": "[name=\"Amiya\"]  Reunion is attacking them...!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Reunion is attacking them...!"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_014_riope\")]",
        "type": "character",
        "name": "char_014_riope.png"
    },
    {
        "id": 53,
        "raw": "[name=\"Ace\"]  We can't leverage the terrain to our advantage here. We don't have the capacity to save everybody.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "We can't leverage the terrain to our advantage here. We don't have the capacity to save everybody."
    },
    {
        "id": 54,
        "raw": "[name=\"Ace\"]  Life is very precious, Amiya. Each and every one.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Life is very precious, Amiya. Each and every one."
    },
    {
