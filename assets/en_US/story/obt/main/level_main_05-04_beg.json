        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"Hoshiguma\"]  Wait! Ch'en, are they about to break the door of that house down?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Wait! Ch'en, are they about to break the door of that house down?"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"Ch'en\"]  Has the target already been confirmed? Assemble, quickly!",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Has the target already been confirmed? Assemble, quickly!"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"Hoshiguma\"]  To minimize the loss of civilians, huh?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "To minimize the loss of civilians, huh?"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_010_chen_1#1\")]",
        "type": "character",
        "name": "char_010_chen_1#1"
    },
    {
        "id": 86,
        "raw": "[name=\"Ch'en\"]  Of course! Snipers, take aim!",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Of course! Snipers, take aim!"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
