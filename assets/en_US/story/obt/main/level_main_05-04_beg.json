    {
        "id": 7,
        "raw": "[name=\"Ch'en\"]  Hoshiguma?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Hoshiguma?"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"Hoshiguma\"]  Huh?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Huh?"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"Ch'en\"]  You don't look so good.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "You don't look so good."
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"Hoshiguma\"]  I'm fine, I was just thinking.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "I'm fine, I was just thinking."
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"Ch'en\"] ...I didn't think he'd get dragged into this.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "...I didn't think he'd get dragged into this."
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"Hoshiguma\"]  Don't worry, you know how I am. It's all in the past now, or as we say in Lungmen, such is fate.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Don't worry, you know how I am. It's all in the past now, or as we say in Lungmen, such is fate."
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"Ch'en\"] Do people in the Far East believe in fate?",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Do people in the Far East believe in fate?"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"Hoshiguma\"]  Having been through so many things, even if I didn't believe it before, I have to accept it now.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Having been through so many things, even if I didn't believe it before, I have to accept it now."
    },
    {
        "id": 22,
        "raw": "[name=\"Hoshiguma\"]  Is the intel accurate?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "Is the intel accurate?"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"Ch'en\"] Without a doubt. Here's the location indicated by the intel.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Without a doubt. Here's the location indicated by the intel."
    },
    {
        "id": 25,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 26,
