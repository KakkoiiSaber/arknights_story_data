    {
        "id": 6,
        "raw": "[name=\"Amiya\"]   Frostleaf? Frostleaf?!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Frostleaf? Frostleaf?!"
    },
    {
        "id": 7,
        "raw": "[name=\"Amiya\"]   What's going on...",
