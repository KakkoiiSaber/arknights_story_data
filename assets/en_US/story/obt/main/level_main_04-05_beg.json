        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 14,
        "raw": "[name=\"Amiya\"]   It cut out again?",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "It cut out again?"
    },
    {
        "id": 15,
        "raw": "[name=\"Amiya\"]   3rd Recon Squad! Do you copy? 3rd Recon Squad!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "3rd Recon Squad! Do you copy? 3rd Recon Squad!"
    },
