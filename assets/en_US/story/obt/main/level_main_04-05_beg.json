        "focus": -1
    },
    {
        "id": 20,
        "raw": "[name=\"Kal'tsit\"]   Amiya.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "Amiya."
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 22,
        "raw": "[name=\"Amiya\"]   Dr. Kal'tsit! It's me! Did you get--",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Dr. Kal'tsit! It's me! Did you get--"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 24,
        "raw": "[name=\"Kal'tsit\"]   I've been continuously monitoring them from the bridge.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "I've been continuously monitoring them from the bridge."
    },
    {
        "id": 25,
        "raw": "[name=\"Kal'tsit\"]   I need you to ask something to that officer next to you.",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "I need you to ask something to that officer next to you."
    },
    {
        "id": 26,
        "raw": "[name=\"Kal'tsit\"]   Ask her...",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "Ask her..."
    },
    {
        "id": 27,
        "raw": "[name=\"Kal'tsit\"]   'How long does Lungmen intend to keep playing dumb?'",
        "type": "dialog",
        "speaker": "Kal'tsit",
        "content": "'How long does Lungmen intend to keep playing dumb?'"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5"
    },
    {
        "id": 29,
        "raw": "[name=\"Ch'en\"]   I'll pretend I didn't hear that.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "I'll pretend I didn't hear that."
    },
    {
        "id": 30,
        "raw": "[name=\"Ch'en\"]   But, we certainly don't have time to waste.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "But, we certainly don't have time to waste."
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 32,
        "raw": "[name=\"Hoshiguma\"]   What happened? I just went to grab some forms, and you two look all serious now.",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "What happened? I just went to grab some forms, and you two look all serious now."
    },
    {
        "id": 33,
        "raw": "[name=\"Hoshiguma\"]   ...A new mission?",
        "type": "dialog",
        "speaker": "Hoshiguma",
        "content": "...A new mission?"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 35,
        "raw": "[name=\"Ch'en\"]   Correct.",
        "type": "dialog",
        "speaker": "Ch'en",
        "content": "Correct."
    },
