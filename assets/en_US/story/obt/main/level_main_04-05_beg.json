        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 37,
        "raw": "[name=\"Amiya\"]   Everyone... Gear up. It's about time for us to head out.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Everyone... Gear up. It's about time for us to head out."
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"Amiya\"]   Madam Ch'en, I'm am formally requesting that the L.G.D. provide assistance to Rhodes Island on this rescue mission.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Madam Ch'en, I'm am formally requesting that the L.G.D. provide assistance to Rhodes Island on this rescue mission."
    },
    {
        "id": 40,
        "raw": "[name=\"Amiya\"]   We may even be dealing with Reunion's new temporary headquarters...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We may even be dealing with Reunion's new temporary headquarters..."
    },
    {
