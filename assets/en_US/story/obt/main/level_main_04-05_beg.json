        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 9,
        "raw": "[name=\"Guard\"]   Amiya! This is the 2nd Recon Squad....",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Amiya! This is the 2nd Recon Squad...."
    },
    {
        "id": 10,
        "raw": "[name=\"Guard\"]   We're currently retreating! But, the enemy...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "We're currently retreating! But, the enemy..."
    },
    {
        "id": 11,
        "raw": "[name=\"Guard\"]   Reunion...",
        "type": "dialog",
