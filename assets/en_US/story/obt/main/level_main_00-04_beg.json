        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"Ace\"]   Is that so? You don't need to apologize to me.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Is that so? You don't need to apologize to me."
    },
    {
        "id": 65,
        "raw": "[name=\"Ace\"]   Have the Doctor's commanding capabilities suffered as a result of the amnesia?",
        "type": "dialog",
        "speaker": "Ace",
        "content": "Have the Doctor's commanding capabilities suffered as a result of the amnesia?"
    },
