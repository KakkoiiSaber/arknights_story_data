        "id": 56,
        "raw": "[name=\"Amiya\"]   Um, Ace...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Um, Ace..."
    },
    {
        "id": 57,
        "raw": "[name=\"Amiya\"]   Actually, something unexpected has happened.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Actually, something unexpected has happened."
    },
    {
        "id": 58,
        "raw": "[name=\"Amiya\"]   Doctor... is suffering from amnesia.",
