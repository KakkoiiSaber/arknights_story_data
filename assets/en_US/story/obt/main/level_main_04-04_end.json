    {
        "id": 24,
        "raw": "[Character(name=\"char_259_Jessica_1#3\")]",
        "type": "character",
        "name": "char_259_Jessica_1#3.png"
    },
    {
        "id": 25,
        "raw": "[name=\"Jessica\"]   What...! Wh-what's going on...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "What...! Wh-what's going on..."
    },
    {
        "id": 26,
        "raw": "[name=\"Jessica\"]   The enemies we just defeated are standing back up...?",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "The enemies we just defeated are standing back up...?"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 28,
        "raw": "[name=\"Mephisto\"]   What? Are you done already?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "What? Are you done already?"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 30,
        "raw": "[name=\"Frostleaf\"]   There's a glow... coming from that guy's staff...?",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "There's a glow... coming from that guy's staff...?"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 32,
        "raw": "[name=\"Mephisto\"]   I haven't even done anything yet.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "I haven't even done anything yet."
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"Jessica\"]   And... they've got a lot more reinforcements coming...",
        "type": "dialog",
        "speaker": "Jessica",
        "content": "And... they've got a lot more reinforcements coming..."
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"Meteorite\"]   Curse you...!",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Curse you...!"
    },
    {
        "id": 37,
        "raw": "[name=\"Meteorite\"]   Right now, I can only pray that this round can kill the enemy leader...!",
        "type": "dialog",
        "speaker": "Meteorite",
        "content": "Right now, I can only pray that this round can kill the enemy leader...!"
    },
    {
        "id": 38,
