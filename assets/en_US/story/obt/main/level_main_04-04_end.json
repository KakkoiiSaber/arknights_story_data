    {
        "id": 53,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 54,
        "raw": "[name=\"Mephisto\"]   Ohh? You're not going to shoot?",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "Ohh? You're not going to shoot?"
    },
    {
        "id": 55,
        "raw": "[name=\"Mephisto\"]   What a pity.",
        "type": "dialog",
        "speaker": "Mephisto",
        "content": "What a pity."
    },
    {
        "id": 56,
        "raw": "[name=\"Mephisto\"]   You know, you won't get another chance.",
