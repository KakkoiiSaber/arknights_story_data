        "type": "character",
        "name": "char_193_frostl_1.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"Frostleaf\"]   Don't.",
        "type": "dialog",
        "speaker": "Frostleaf",
        "content": "Don't."
