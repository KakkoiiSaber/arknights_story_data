        "content": "Uaaagh!"
    },
    {
        "id": 19,
        "raw": "[name=\"Reunion Member\"]   It hurts... It huuurrtsssss...",
        "type": "dialog",
        "speaker": "Reunion Member",
        "content": "It hurts... It huuurrtsssss..."
    },
    {
        "id": 20,
        "raw": "[name=\"Reunion Member\"]   Aaagh... Aaaargh! It itches! It itches!!",
        "type": "dialog",
        "speaker": "Reunion Member",
