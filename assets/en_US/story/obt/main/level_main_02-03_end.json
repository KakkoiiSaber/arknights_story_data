        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"Amiya\"]   Mhm.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Mhm."
    },
    {
        "id": 39,
        "raw": "[name=\"Amiya\"]   This isn't the best place for that though...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "This isn't the best place for that though..."
    },
    {
        "id": 40,
        "raw": "[name=\"Amiya\"]   As of right now, our top priority is keeping you safe.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "As of right now, our top priority is keeping you safe."
    },
    {
        "id": 41,
        "raw": "[name=\"Amiya\"]   For the time being, we'll protect you, so rest assured.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "For the time being, we'll protect you, so rest assured."
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"Misha\"]   What... are you talking about...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "What... are you talking about..."
    },
    {
        "id": 44,
        "raw": "[name=\"Misha\"]   ...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "..."
    },
    {
        "id": 45,
        "raw": "[name=\"Misha\"]   You're just going to capture me and lock me up, aren't you? !",
        "type": "dialog",
        "speaker": "Misha",
        "content": "You're just going to capture me and lock me up, aren't you? !"
    },
    {
        "id": 46,
        "raw": "[name=\"Misha\"]   Get away from me! My claws are sharp...! If you don't want to get hurt...",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Get away from me! My claws are sharp...! If you don't want to get hurt..."
    },
    {
