        "content": "Good day."
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 33,
        "raw": "[name=\"Amiya\"]   We're from Rhodes Island Pharmaceuticals. As an organization made to serve the Infected, at least...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We're from Rhodes Island Pharmaceuticals. As an organization made to serve the Infected, at least..."
    },
    {
        "id": 34,
        "raw": "[name=\"Amiya\"]   We hope to be able to help you. That's why we'd like to talk for a bit.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "We hope to be able to help you. That's why we'd like to talk for a bit."
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"Misha\"]   Talk?",
        "type": "dialog",
        "speaker": "Misha",
        "content": "Talk?"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_002_amiya_1#3\", name2=\"char_012_misa_1\", focus=1)]",
