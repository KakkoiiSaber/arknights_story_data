    {
        "id": 26,
        "raw": "[name=\"Amiya\"]   I'm sorry, Miss Misha. I hope I didn't scare you...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "I'm sorry, Miss Misha. I hope I didn't scare you..."
    },
    {
        "id": 27,
        "raw": "[name=\"Amiya\"]   These are my coleagues, Franka and Liskarm.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "These are my coleagues, Franka and Liskarm."
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
