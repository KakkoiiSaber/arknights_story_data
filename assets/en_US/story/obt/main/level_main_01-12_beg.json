    {
        "id": 79,
        "raw": "[name=\"W\"]  I'm not done talking yet.",
        "type": "dialog",
        "speaker": "W",
        "content": "I'm not done talking yet."
    },
    {
        "id": 80,
        "raw": "[name=\"W\"]  Amiya...",
        "type": "dialog",
        "speaker": "W",
        "content": "Amiya..."
    },
    {
        "id": 81,
        "raw": "[name=\"W\"]  ... Did I make you mad?",
        "type": "dialog",
        "speaker": "W",
        "content": "... Did I make you mad?"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 83,
        "raw": "[name=\"Amiya\"]  ... You've gone too far.",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "... You've gone too far."
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw.png"
    },
    {
        "id": 85,
        "raw": "[name=\"W\"]  Good, good... Now that's more like it.",
        "type": "dialog",
        "speaker": "W",
        "content": "Good, good... Now that's more like it."
    },
    {
        "id": 86,
        "raw": "[name=\"W\"]  Come at me.",
        "type": "dialog",
        "speaker": "W",
        "content": "Come at me."
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 88,
        "raw": "[name=\"Amiya\"]  W of the Reunion Movement, you've gone too far!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "W of the Reunion Movement, you've gone too far!"
    },
    {
        "id": 89,
        "raw": "[name=\"Amiya\"]  Every life is precious, each and every one...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "Every life is precious, each and every one..."
    },
    {
        "id": 90,
        "raw": "[name=\"Amiya\"]  This is something that you'll never tarnish!",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "This is something that you'll never tarnish!"
    },
    {
        "id": 91,
        "raw": "[name=\"Amiya\"]  Doctor!!",
        "type": "dialog",
