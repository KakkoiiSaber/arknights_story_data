    {
        "id": 13,
        "raw": "[name=\"???\"]  Did you really think we'd let you just stroll out of Chernobog?",
        "type": "dialog",
        "speaker": "???",
        "content": "Did you really think we'd let you just stroll out of Chernobog?"
    },
    {
        "id": 14,
        "raw": "[name=\"???\"]  Don't you think it's about time for someone to wake you from your daydream?",
        "type": "dialog",
