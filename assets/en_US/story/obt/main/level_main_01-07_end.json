    },
    {
        "id": 10,
        "raw": "[name=\"Dobermann\"]   *gasp* *gasp*...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "*gasp* *gasp*..."
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3"
    },
    {
        "id": 12,
        "raw": "[name=\"Nearl\"]   We made it...!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "We made it...!"
    },
    {
        "id": 13,
        "raw": "[name=\"Nearl\"]   We've not only managed to shake off Reunion...",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "We've not only managed to shake off Reunion..."
    },
    {
        "id": 14,
        "raw": "[name=\"Nearl\"]   ...but the Catastrophe is also visibly weakening!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "...but the Catastrophe is also visibly weakening!"
    },
    {
        "id": 15,
        "raw": "[name=\"Nearl\"]   But we're still in a terrible situation... Everyone, continue to exercise caution!",
        "type": "dialog",
        "speaker": "Nearl",
        "content": "But we're still in a terrible situation... Everyone, continue to exercise caution!"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#5\")]",
        "type": "character",
        "name": "char_002_amiya_1#5"
    },
    {
        "id": 17,
        "raw": "[name=\"Amiya\"]   The Catastrophe...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "The Catastrophe..."
    },
    {
        "id": 18,
        "raw": "[name=\"Amiya\"]   The streets are now buried underneath rubble, and collapsed buildings are blocking all the roads...",
        "type": "dialog",
        "speaker": "Amiya",
        "content": "The streets are now buried underneath rubble, and collapsed buildings are blocking all the roads..."
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 20,
        "raw": "[name=\"Dobermann\"]   Is the Originium already beginning to metastasize...?",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "Is the Originium already beginning to metastasize...?"
    },
    {
        "id": 21,
        "raw": "[name=\"Dobermann\"]   We're almost there, but everything is blocking our way!",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "We're almost there, but everything is blocking our way!"
    },
    {
        "id": 22,
        "raw": "[name=\"Dobermann\"]   If we can just...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "If we can just..."
    },
    {
        "id": 23,
        "raw": "[name=\"Dobermann\"]   ... Just...",
        "type": "dialog",
        "speaker": "Dobermann",
        "content": "... Just..."
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_014_riope\")]",
        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 25,
        "raw": "[name=\"Ace\"]  ——",
        "type": "dialog",
        "speaker": "Ace",
        "content": "——"
    },
    {
        "id": 26,
        "raw": "[name=\"Ace\"]  They're here.",
        "type": "dialog",
        "speaker": "Ace",
        "content": "They're here."
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_013_riop\",focus=2)]",
        "type": "character",
        "name": "char_014_riope",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"Guard\"]   What's here?",
        "type": "dialog",
        "speaker": "Guard",
        "content": "What's here?"
    },
    {
        "id": 29,
        "raw": "[name=\"Guard\"]   Reunion? They caught up to us? !",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Reunion? They caught up to us? !"
    },
    {
        "id": 30,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 31,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
