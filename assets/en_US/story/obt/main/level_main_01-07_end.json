    },
    {
        "id": 36,
        "raw": "[name=\"Medic\"]   Ugh...",
        "type": "dialog",
        "speaker": "Medic",
        "content": "Ugh..."
    },
    {
        "id": 37,
        "raw": "[name=\"Medic\"]   There's... so many of them...",
        "type": "dialog",
        "speaker": "Medic",
        "content": "There's... so many of them..."
    },
    {
        "id": 38,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 39,
        "raw": "[PlaySound(key=\"$d_gen_soldiersrun\",volume=1)]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_soldiersrun.mp3",
        "volume": 1
    },
    {
