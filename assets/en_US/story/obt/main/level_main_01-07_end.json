        "name": "char_013_riop"
    },
    {
        "id": 103,
        "raw": "[name=\"Guard\"]   Only a single enemy is approaching our defensive line!",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Only a single enemy is approaching our defensive line!"
    },
    {
        "id": 104,
        "raw": "[name=\"Guard\"]   Why is that person walking towards us alone...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Why is that person walking towards us alone..."
    },
    {
        "id": 105,
        "raw": "[name=\"Guard\"]   Are they sending an envoy? I don't think so...",
        "type": "dialog",
        "speaker": "Guard",
        "content": "Are they sending an envoy? I don't think so..."
    },
    {
