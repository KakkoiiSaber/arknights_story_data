        "focus": -1
    },
    {
        "id": 154,
        "raw": "[name=\"PRTS\"]   どうして、黙ったまま画面中央にタッチされたのかはわかりかねますが――",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "どうして、黙ったまま画面中央にタッチされたのかはわかりかねますが――"
