    },
    {
        "id": 39,
        "raw": "[name=\"？？？\"]   させるか！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "させるか！"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_013_riop\")]",
