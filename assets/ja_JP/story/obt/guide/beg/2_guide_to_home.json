    {
        "id": 19,
        "raw": "[name=\"前衛オペレーター\"]   敵部隊の撤退を確認！　ターゲットは全員排除しました！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "敵部隊の撤退を確認！　ターゲットは全員排除しました！"
    },
    {
        "id": 20,
        "raw": "[name=\"前衛オペレーター\"]   ……アーミヤさんの言ってた通り、Dr.{@nickname}の指揮があると本当に心強いですね。",
        "type": "dialog",
        "speaker": "前衛オペレーター",
