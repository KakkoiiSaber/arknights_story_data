    {
        "id": 107,
        "raw": "[Character(name=\"char_016_medic\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_016_medic.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"医療オペレーター\"]   あ、アーミヤさん！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "あ、アーミヤさん！"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_016_medic\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_016_medic.png",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"アーミヤ\"]   どうしたんですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "どうしたんですか？"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_016_medic\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_016_medic.png",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"医療オペレーター\"]   そ、それが……ロドスからの通信が入ったんです！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "そ、それが……ロドスからの通信が入ったんです！"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_002_amiya_1#6\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#6.png",
        "focus": -1
    },
    {
        "id": 114,
        "raw": "[name=\"アーミヤ\"]   よかった、繋がったんですね！　もしかして、ケルシー先生でしょうか……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "よかった、繋がったんですね！　もしかして、ケルシー先生でしょうか……？"
    },
    {
        "id": 115,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=0.5, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_002_amiya_1#6\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1#6.png",
        "focus": -1
    },
    {
        "id": 117,
        "raw": "[name=\"？？？\"]   申し訳ないのですが、違います。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "申し訳ないのですが、違います。"
    },
    {
        "id": 118,
        "raw": "[image(image=\"bg_2_call\")]",
        "type": "image",
