        "name": "char_013_riop.png"
    },
    {
        "id": 41,
        "raw": "[name=\"前衛オペレーター\"]   ド、ドーベルマン教官！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "ド、ドーベルマン教官！"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"ドーベルマン\"]   ぼーっとするな、蜂の巣になりたいのか！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "ぼーっとするな、蜂の巣になりたいのか！"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"前衛オペレーター\"]   す、すみません！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "す、すみません！"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"ドーベルマン\"]   急いで隊形を整えろ！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "急いで隊形を整えろ！"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"前衛オペレーター\"]   はい！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "はい！"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2.png"
    },
    {
        "id": 51,
        "raw": "[name=\"アーミヤ\"]   ドーベルマンさん！　来てくれたんですね！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ドーベルマンさん！　来てくれたんですね！"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"ドーベルマン\"]   ああ。こちらの小隊もレユニオンの攻撃を受けたものでな。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "ああ。こちらの小隊もレユニオンの攻撃を受けたものでな。"
    },
    {
        "id": 54,
        "raw": "[name=\"ドーベルマン\"]   すぐに合流をと思い、駆けつけてきたんだ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "すぐに合流をと思い、駆けつけてきたんだ。"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"アーミヤ\"]   ありがとうございます！　……ですが、レユニオンはなぜ我々を攻撃してくるんでしょうか……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ありがとうございます！　……ですが、レユニオンはなぜ我々を攻撃してくるんでしょうか……？"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"ドーベルマン\"]   さてな。奴らは感染者のための組織だが……元々、少し盲目的で過激な面があるとは思っていた。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "さてな。奴らは感染者のための組織だが……元々、少し盲目的で過激な面があるとは思っていた。"
    },
    {
        "id": 59,
        "raw": "[name=\"ドーベルマン\"]   だが、よりによってこのウルサスで、暴力に訴えるような真似をするとは……まったく、自殺行為としか思えんな。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "だが、よりによってこのウルサスで、暴力に訴えるような真似をするとは……まったく、自殺行為としか思えんな。"
    },
    {
        "id": 60,
        "raw": "[name=\"ドーベルマン\"]   とにかく、このままここにいても、周囲の混乱が深まっていくばかりだ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "とにかく、このままここにいても、周囲の混乱が深まっていくばかりだ。"
    },
    {
        "id": 61,
        "raw": "[name=\"ドーベルマン\"]   すぐにチェルノボーグから離脱するとしよう。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "すぐにチェルノボーグから離脱するとしよう。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1#1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"アーミヤ\"]   わかりました。ドクターの救出も完了しましたし、作戦通り撤退しましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "わかりました。ドクターの救出も完了しましたし、作戦通り撤退しましょう。"
    },
    {
        "id": 64,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 66,
        "raw": "[name=\"ドーベルマン\"]    ――では、こちらの人物がDr.{@nickname}か？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "――では、こちらの人物がDr.{@nickname}か？"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 68,
        "raw": "[name=\"アーミヤ\"]   はい、そうです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい、そうです。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 70,
        "raw": "[name=\"ドーベルマン\"]    わかった。……ドクター、私とは面識がなくとも、アーミヤのことは知っているだろう？　安全のために――",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "わかった。……ドクター、私とは面識がなくとも、アーミヤのことは知っているだろう？　安全のために――"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"アーミヤ\"]   あ、あの、ドーベルマンさん……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あ、あの、ドーベルマンさん……"
    },
    {
        "id": 73,
        "raw": "[name=\"アーミヤ\"]   ドクターは今、調子があまり良くないといいますか……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ドクターは今、調子があまり良くないといいますか……"
    },
    {
        "id": 74,
        "raw": "[name=\"アーミヤ\"]   一言で言ってしまうと……記憶喪失なんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "一言で言ってしまうと……記憶喪失なんです。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"ドーベルマン\"]    記憶喪失……？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "記憶喪失……？"
    },
    {
        "id": 77,
        "raw": "[name=\"ドーベルマン\"]    ……そんな状態で、ドクターに指揮権を委ねようというのか？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……そんな状態で、ドクターに指揮権を委ねようというのか？"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 79,
        "raw": "[name=\"アーミヤ\"]   はい。指揮能力に問題はありませんので。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい。指揮能力に問題はありませんので。"
    },
    {
        "id": 80,
        "raw": "[name=\"アーミヤ\"]   その点については、先ほどの戦いで確認済みです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "その点については、先ほどの戦いで確認済みです。"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"ドーベルマン\"]   ……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……"
    },
    {
        "id": 83,
        "raw": "[name=\"ドーベルマン\"]   私は、よく知らない人間を簡単に信用することはできない。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "私は、よく知らない人間を簡単に信用することはできない。"
    },
    {
        "id": 84,
        "raw": "[name=\"ドーベルマン\"]   だが、お前の判断ならば信じよう。アーミヤ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "だが、お前の判断ならば信じよう。アーミヤ。"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 86,
        "raw": "[name=\"アーミヤ\"]   ……ありがとうございます。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ありがとうございます。"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 88,
        "raw": "[name=\"ドーベルマン\"]   では、改めて。――私は行動隊E1の隊長、ドーベルマンだ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "では、改めて。――私は行動隊E1の隊長、ドーベルマンだ。"
    },
    {
        "id": 89,
        "raw": "[name=\"ドーベルマン\"]   我々が、ウルサスの都市であるこのチェルノボーグから、ロドス本艦までお前を送り届けよう。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "我々が、ウルサスの都市であるこのチェルノボーグから、ロドス本艦までお前を送り届けよう。"
    },
    {
        "id": 90,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=0.5, block=true)]",
