    {
        "id": 90,
        "raw": "[name=\"ウルサス人感染者\"]  …………",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "…………"
    },
    {
        "id": 91,
        "raw": "[name=\"ウルサス人感染者\"]  ここが何だか知ってる？",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "ここが何だか知ってる？"
    },
    {
        "id": 92,
        "raw": "[name=\"ウルサス人感染者\"]  あんたと同じ感染者の吹き溜りよ。生きてる感染者だけじゃなく、死体もごろごろあるわ。",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "あんたと同じ感染者の吹き溜りよ。生きてる感染者だけじゃなく、死体もごろごろあるわ。"
    },
    {
        "id": 93,
        "raw": "[name=\"ウルサス人感染者\"]  レユニオンのせいで苦しみもがいてる感染者、レユニオンのせいで死んでいった感染者……",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "レユニオンのせいで苦しみもがいてる感染者、レユニオンのせいで死んでいった感染者……"
    },
    {
        "id": 94,
        "raw": "[name=\"ウルサス人感染者\"]  でも前は感染者なんて一人もいなかったのよ。",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "でも前は感染者なんて一人もいなかったのよ。"
    },
    {
        "id": 95,
        "raw": "[name=\"ウルサス人感染者\"]  みんな善良なチェルノボーグの市民だった。それがあいつらに追い立てられ、燻し出された後、虐殺された。生き残っても拷問され、最後は捨てられた……ゴミのように！",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "みんな善良なチェルノボーグの市民だった。それがあいつらに追い立てられ、燻し出された後、虐殺された。生き残っても拷問され、最後は捨てられた……ゴミのように！"
    },
    {
        "id": 96,
        "raw": "[name=\"ウルサス人感染者\"]  一体何人がここで飢えて死んでいったのか……",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "一体何人がここで飢えて死んでいったのか……"
    },
    {
        "id": 97,
        "raw": "[name=\"ウルサス人感染者\"]  辛うじて生き延びた人たちも、源石と接触し続けたせいで、みんな感染したのよ！　今はもうまともな人なんて一人もいない！",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "辛うじて生き延びた人たちも、源石と接触し続けたせいで、みんな感染したのよ！　今はもうまともな人なんて一人もいない！"
    },
    {
        "id": 98,
        "raw": "[name=\"ウルサス人感染者\"]  感染者のせいで……",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "感染者のせいで……"
    },
    {
        "id": 99,
        "raw": "[name=\"ウルサス人感染者\"]  あんたたち感染者のせいで！！",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "あんたたち感染者のせいで！！"
    },
