    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012.png"
    },
    {
        "id": 62,
        "raw": "[name=\"オペレーター\"]  どこから出てきたんだ？　隠れる場所などなかったはず——",
        "type": "dialog",
        "speaker": "オペレーター",
        "content": "どこから出てきたんだ？　隠れる場所などなかったはず——"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"avg_npc_057\")]",
        "type": "character",
        "name": "avg_npc_057.png"
    },
    {
        "id": 64,
        "raw": "[name=\"？？？\"]  ここはウルサス人の墓場よ！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "ここはウルサス人の墓場よ！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 66,
        "raw": "[name=\"アーミヤ\"]  ！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "！？"
    },
    {
        "id": 67,
        "raw": "[name=\"アーミヤ\"]  （警戒態勢を維持……でも攻撃はしないでください。）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（警戒態勢を維持……でも攻撃はしないでください。）"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 69,
        "raw": "[name=\"アーミヤ\"]  私たちは中立の感染者検査組織です！　あの……皆さんを救助するためにこの都市に来たんです！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私たちは中立の感染者検査組織です！　あの……皆さんを救助するためにこの都市に来たんです！"
    },
    {
        "id": 70,
        "raw": "[name=\"アーミヤ\"]  私も普通の感染者ですが、あなたには敵意はありません――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私も普通の感染者ですが、あなたには敵意はありません――"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_002_amiya_1\",name2=\"avg_npc_057\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "avg_npc_057",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"？？？\"]  感染者？　チッ、私はウルサス人よ！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "感染者？　チッ、私はウルサス人よ！"
    },
    {
        "id": 73,
        "raw": "[name=\"ウルサス人感染者\"]  感染者を救助……！？　はっ、冗談じゃない……あんたたち感染者が私たちに何をしたか、わかってないようね！",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "感染者を救助……！？　はっ、冗談じゃない……あんたたち感染者が私たちに何をしたか、わかってないようね！"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"avg_npc_057\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4.png",
        "name2": "avg_npc_057",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"アーミヤ\"]  …………",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "…………"
    },
    {
        "id": 76,
        "raw": "[name=\"アーミヤ\"]  あの、もし不安でしたら、これ以上は近づきませんから。この距離でお話をさせてくださいませんか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あの、もし不安でしたら、これ以上は近づきませんから。この距離でお話をさせてくださいませんか？"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"avg_npc_057\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4.png",
        "name2": "avg_npc_057",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"ウルサス人感染者\"]  いや……違うわ、私も感染させられたの！　あんたと変わらない。そうでしょ？",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "いや……違うわ、私も感染させられたの！　あんたと変わらない。そうでしょ？"
    },
    {
        "id": 79,
        "raw": "[name=\"ウルサス人感染者\"]  感染者を救助！？　ふふ、あははははは……感染者はみんな死ねばいいのよ！",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "感染者を救助！？　ふふ、あははははは……感染者はみんな死ねばいいのよ！"
    },
    {
        "id": 80,
        "raw": "[name=\"ウルサス人感染者\"]  私も死ぬんだわ。私も死ねばいい！　……くそっ！！　感染者さえいなければ、こんなことには——",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "私も死ぬんだわ。私も死ねばいい！　……くそっ！！　感染者さえいなければ、こんなことには——"
    },
    {
        "id": 81,
        "raw": "[name=\"ウルサス人感染者\"]  人を陥れて、攻撃されたら報復して……感染者って皆そういうものでしょ！？　私もそうするべきなの！？",
        "type": "dialog",
        "speaker": "ウルサス人感染者",
        "content": "人を陥れて、攻撃されたら報復して……感染者って皆そういうものでしょ！？　私もそうするべきなの！？"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"ロスモンティス\"]  …………",
        "type": "dialog",
