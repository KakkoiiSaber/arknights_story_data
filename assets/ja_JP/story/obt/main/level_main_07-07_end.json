        "raw": "[Decision(options=\"またこのパターンか？;…………;前にも同じようなことがあった気がする。\", values=\"1;2;3\")]",
        "type": "decision",
        "options": "またこのパターンか？;…………;前にも同じようなことがあった気がする。",
