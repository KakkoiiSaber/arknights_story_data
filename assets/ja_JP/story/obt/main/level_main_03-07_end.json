        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"エクシア\"]   へっへ～ん。そこに隠れてる攻撃部隊、気付かれてないとでも思ってたのかな？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "へっへ～ん。そこに隠れてる攻撃部隊、気付かれてないとでも思ってたのかな？"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"テキサス\"]   やるな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "やるな。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"エクシア\"]   でしょ？　ふっふっふ～。",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "でしょ？　ふっふっふ～。"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"テキサス\"]   ……では、我々も行くとしよう。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……では、我々も行くとしよう。"
    },
    {
        "id": 57,
        "raw": "[name=\"テキサス\"]   雇い主を放ってはおけないしな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "雇い主を放ってはおけないしな。"
