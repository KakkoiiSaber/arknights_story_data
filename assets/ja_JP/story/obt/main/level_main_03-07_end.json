        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"フランカ\"]   さっぱりね。それらしい痕跡も見当たらないわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "さっぱりね。それらしい痕跡も見当たらないわ。"
    },
    {
        "id": 65,
        "raw": "[name=\"フランカ\"]   もしかすると、Wに連れて行かれたのかも。",
        "type": "dialog",
        "speaker": "フランカ",
