    {
        "id": 62,
        "raw": "[name=\"アーミヤ\"]   ミーシャさんの姿はありましたか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ミーシャさんの姿はありましたか？"
    },
    {
