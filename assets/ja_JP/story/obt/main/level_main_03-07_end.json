    {
        "id": 23,
        "raw": "[name=\"レユニオン構成員\"]   う、うわああっ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "う、うわああっ！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"フランカ\"]   あ～らら……そういえばロドスにも、ああいう乱暴な戦い方する人がいたわよね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あ～らら……そういえばロドスにも、ああいう乱暴な戦い方する人がいたわよね。"
    },
    {
        "id": 26,
        "raw": "[name=\"フランカ\"]   あの刑事さんとなら、気が合いそうだと思わない？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あの刑事さんとなら、気が合いそうだと思わない？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"リスカム\"]   よそ見しないの！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "よそ見しないの！"
    },
    {
        "id": 29,
        "raw": "[name=\"リスカム\"]   ほら、動いて！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "ほら、動いて！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"フランカ\"]   は～いはい、わかったわかった。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "は～いはい、わかったわかった。"
    },
    {
        "id": 32,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
