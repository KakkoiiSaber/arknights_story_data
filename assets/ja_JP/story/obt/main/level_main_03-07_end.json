        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"エクシア\"]   あははっ！　前から聞いてはいたけど、督察隊の噂って本当だったんだね～。",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "あははっ！　前から聞いてはいたけど、督察隊の噂って本当だったんだね～。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"テキサス\"]   いいから集中しろ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "いいから集中しろ。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_103_angel_1\", focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"エクシア\"]   大丈夫大丈夫！　こうやってお喋りしながら……",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "大丈夫大丈夫！　こうやってお喋りしながら……"
    },
    {
        "id": 41,
        "raw": "[name=\"エクシア\"]   ちゃんと周りも見てるんだから！　――はい、バーン！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "ちゃんと周りも見てるんだから！　――はい、バーン！"
