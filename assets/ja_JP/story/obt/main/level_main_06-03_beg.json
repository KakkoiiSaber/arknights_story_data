    {
        "id": 7,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"ファウスト\"]  メフィスト？",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "メフィスト？"
    },
    {
        "id": 9,
        "raw": "[name=\"ファウスト\"]  さっき使ったアーツは一体なんだ？　お前の……部隊が、さらに狂気を増しているじゃないか。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "さっき使ったアーツは一体なんだ？　お前の……部隊が、さらに狂気を増しているじゃないか。"
    },
    {
        "id": 10,
        "raw": "[name=\"ファウスト\"]  彼らは……苦しんでいる。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "彼らは……苦しんでいる。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"メフィスト\"]  ああ、見たんだね？　僕の植えた種がついに花を咲かせたんだ。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "ああ、見たんだね？　僕の植えた種がついに花を咲かせたんだ。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"メフィスト\"]  大丈夫だよファウスト。あいつらは僕たちには攻撃しない。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "大丈夫だよファウスト。あいつらは僕たちには攻撃しない。"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"ファウスト\"]  まだ彼らの鉱石病を活性化させ続けているのか？",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "まだ彼らの鉱石病を活性化させ続けているのか？"
    },
    {
        "id": 17,
        "raw": "[name=\"ファウスト\"]  メフィスト……止めろ。そんなことをしなくても、俺たちは生きていける。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "メフィスト……止めろ。そんなことをしなくても、俺たちは生きていける。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"メフィスト\"]  違うよ。こんなことは僕のアーツでしかできないし、このくらいやらなきゃ逃げ延びるなんて夢のまた夢だよ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "違うよ。こんなことは僕のアーツでしかできないし、このくらいやらなきゃ逃げ延びるなんて夢のまた夢だよ！"
    },
    {
        "id": 20,
        "raw": "[name=\"メフィスト\"]  君だって偵察に行った時に全部見ただろう。僕たちが今の状態で強行突破しようとすれば、スラムの抜け道に辿り着く前に、近衛局に皆殺しにされるよ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "君だって偵察に行った時に全部見ただろう。僕たちが今の状態で強行突破しようとすれば、スラムの抜け道に辿り着く前に、近衛局に皆殺しにされるよ！"
    },
    {
        "id": 21,
        "raw": "[name=\"メフィスト\"]  あんな武器、これまで見たことあった？　あのチェルノボーグの守衛だって使ってないような武器を！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "あんな武器、これまで見たことあった？　あのチェルノボーグの守衛だって使ってないような武器を！"
    },
    {
        "id": 22,
        "raw": "[name=\"メフィスト\"]  あいつらはこの都市を知り尽くしている。でも僕たちはただの余所者だ。あいつらが、いつどこから出てくるのかまるで分からない。今の僕たちの戦力では、正面から戦うのなんて無理だ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "あいつらはこの都市を知り尽くしている。でも僕たちはただの余所者だ。あいつらが、いつどこから出てくるのかまるで分からない。今の僕たちの戦力では、正面から戦うのなんて無理だ！"
    },
    {
        "id": 23,
        "raw": "[name=\"メフィスト\"]  チェルノボーグのウルサス人は弱かった……でも龍門は、まるで軍隊を相手にするかのような対応をしている。僕たちが率いているのは軍隊なんて程遠い、ただ生きていきたいと願う同胞たちだけなのに。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "チェルノボーグのウルサス人は弱かった……でも龍門は、まるで軍隊を相手にするかのような対応をしている。僕たちが率いているのは軍隊なんて程遠い、ただ生きていきたいと願う同胞たちだけなのに。"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"ファウスト\"]  声を抑えろ。こちらの士気は相当下がっている。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "声を抑えろ。こちらの士気は相当下がっている。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"メフィスト\"]  僕の家畜たちはこんなことじゃ揺るがないよ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "僕の家畜たちはこんなことじゃ揺るがないよ！"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"ファウスト\"]  ……俺たちと合流したばかりのレユニオン構成員も多くいる。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "……俺たちと合流したばかりのレユニオン構成員も多くいる。"
    },
    {
        "id": 30,
        "raw": "[name=\"ファウスト\"]  持ちこたえていれば、フロストノヴァが支援に駆けつけてくれるはずだ。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "持ちこたえていれば、フロストノヴァが支援に駆けつけてくれるはずだ。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"メフィスト\"]  フロストノヴァ？　あのフロストノヴァが？",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "フロストノヴァ？　あのフロストノヴァが？"
    },
    {
        "id": 33,
        "raw": "[name=\"メフィスト\"]  フッ、フフ、あいつも、あいつのスノーデビルとかいう小隊も、レユニオンを裏切ったんじゃない？",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "フッ、フフ、あいつも、あいつのスノーデビルとかいう小隊も、レユニオンを裏切ったんじゃない？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"ファウスト\"]  メフィスト！",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "メフィスト！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"メフィスト\"]  あれ程の実力を持ってるのに、それ以外にここに来られない理由なんてないだろ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "あれ程の実力を持ってるのに、それ以外にここに来られない理由なんてないだろ！"
    },
    {
        "id": 38,
        "raw": "[name=\"メフィスト\"]  ……でもあいつらを責めたりはしないさ。裏切りだって、生き延びるためだろ。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "……でもあいつらを責めたりはしないさ。裏切りだって、生き延びるためだろ。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"ファウスト\"]  フロストノヴァは裏切ったりしない。約束しただろ、自分の目で真相を確かめに行くと。",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "フロストノヴァは裏切ったりしない。約束しただろ、自分の目で真相を確かめに行くと。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"メフィスト\"]  そうだね……みんな生きるために努力している。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "そうだね……みんな生きるために努力している。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"ファウスト\"]  早まるな、このままだと近衛局の思うつぼだ！",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "早まるな、このままだと近衛局の思うつぼだ！"
    },
    {
        "id": 45,
        "raw": "[stopmusic(fadetime=2)]",
        "type": "stop_music",
        "fadetime": 2
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"メフィスト\"]  一つ方法があるよ、ファウスト。もっとたくさんの同胞たちを生き延びさせる方法が。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "一つ方法があるよ、ファウスト。もっとたくさんの同胞たちを生き延びさせる方法が。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"ファウスト\"]  ……？　何をするつもりだ？",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "……？　何をするつもりだ？"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"メフィスト\"]  近衛局のやつらに、軍隊なんかよりもっと恐ろしいものを見せてやるんだ。あいつらには僕の同胞たちが咲かせる花びらが、どんなものかなんて想像できないだろ。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "近衛局のやつらに、軍隊なんかよりもっと恐ろしいものを見せてやるんだ。あいつらには僕の同胞たちが咲かせる花びらが、どんなものかなんて想像できないだろ。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"ファウスト\"]  メフィスト！？",
        "type": "dialog",
        "speaker": "ファウスト",
        "content": "メフィスト！？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"メフィスト\"]  近衛局に自分たちがやったことのツケを払わせてやる……あのチェンとかいうやつにも、君を傷つけたツケを払わせてやるんだ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "近衛局に自分たちがやったことのツケを払わせてやる……あのチェンとかいうやつにも、君を傷つけたツケを払わせてやるんだ！"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5.png"
    },
    {
        "id": 57,
        "raw": "[name=\"メフィスト\"]  僕の同胞たち、僕の徒党たち、僕に応えろ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "僕の同胞たち、僕の徒党たち、僕に応えろ！"
    },
