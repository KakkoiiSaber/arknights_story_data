    {
        "id": 99,
        "raw": "[name=\"レユニオン構成員\"]  ああ？　なっ！？　何が起きてる？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ああ？　なっ！？　何が起きてる？"
    },
    {
        "id": 100,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 101,
        "raw": "[name=\"レユニオン構成員\"]  お、おい何するつもりだ？　俺たちとお前は別のチームだろ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "お、おい何するつもりだ？　俺たちとお前は別のチームだろ！"
    },
    {
        "id": 102,
        "raw": "[name=\"レユニオン構成員\"]  ……俺はお前たちを侮辱したりしてない！　メフィストのことだって……。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……俺はお前たちを侮辱したりしてない！　メフィストのことだって……。"
    },
    {
        "id": 103,
        "raw": "[name=\"レユニオン構成員\"]  隊長？　隊長はどこだ！？　隊長！！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "隊長？　隊長はどこだ！？　隊長！！"
    },
    {
        "id": 104,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 105,
        "raw": "[name=\"レユニオン構成員\"]  うわぁ！！　ど、どうして、どうして俺に噛み付くんだ！！　どうして……うぐぐ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "うわぁ！！　ど、どうして、どうして俺に噛み付くんだ！！　どうして……うぐぐ！"
    },
    {
        "id": 106,
        "raw": "[name=\"レユニオン構成員\"]  助けて！！　助けてくれ！！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "助けて！！　助けてくれ！！"
    },
    {
        "id": 107,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 108,
        "raw": "[name=\"レユニオン構成員\"]  ううあ、うわああああ！！！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ううあ、うわああああ！！！"
    },
