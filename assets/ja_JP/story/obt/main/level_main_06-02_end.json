    {
        "id": 7,
        "raw": "[name=\"レユニオン構成員\"]  ぐっ、ぐうっ……。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ぐっ、ぐうっ……。"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_017_homura_3#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#4",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"ブレイズ\"]  ごめんね。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "ごめんね。"
    },
    {
        "id": 10,
        "raw": "[name=\"ブレイズ\"]  君を殴ったからって、君のことを同胞じゃないと思ってるわけじゃないよ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "君を殴ったからって、君のことを同胞じゃないと思ってるわけじゃないよ。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_017_homura_3#8\")]",
        "type": "character",
        "name": "char_017_homura_3#8"
    },
    {
        "id": 12,
        "raw": "[name=\"ブレイズ\"]  ……まぁいいや。そんな言葉、自分でも信じられないから。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "……まぁいいや。そんな言葉、自分でも信じられないから。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 14,
        "raw": "[playsound(key=\"$d_gen_transmissionget\", volume=0.4)]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.4
    },
    {
        "id": 15,
        "raw": "[name=\"ブレイズ\"]   こちらブレイズ。Blaze-4小隊全員に通達、十数人規模のレユニオン構成員を捕えた。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "こちらブレイズ。Blaze-4小隊全員に通達、十数人規模のレユニオン構成員を捕えた。"
    },
    {
        "id": 16,
        "raw": "[name=\"ブレイズ\"]   余裕があれば回収に来てほしいところだけど、時間がなければ龍門当局に引き渡すよ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "余裕があれば回収に来てほしいところだけど、時間がなければ龍門当局に引き渡すよ。"
    },
    {
        "id": 17,
        "raw": "[name=\"ブレイズ\"]   そこの龍門人、そのクロスボウを下ろして。そんなに警戒しなくてもいいから。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "そこの龍門人、そのクロスボウを下ろして。そんなに警戒しなくてもいいから。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_015_lmg\")]",
        "type": "character",
        "name": "char_015_lmg"
    },
    {
        "id": 19,
        "raw": "[name=\"近衛局隊員\"]  ……。",
        "type": "dialog",
        "speaker": "近衛局隊員",
        "content": "……。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_017_homura_3#9\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#9",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"ブレイズ\"]  一体私のどこが信用できないのかな？　君たちの命だって救ってあげたじゃない。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "一体私のどこが信用できないのかな？　君たちの命だって救ってあげたじゃない。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_017_homura_3#8\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#8",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"近衛局隊員\"]  下がれ……！　分かっている。だ、だがお前は……感染者だ……！",
        "type": "dialog",
        "speaker": "近衛局隊員",
        "content": "下がれ……！　分かっている。だ、だがお前は……感染者だ……！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_017_homura_3#5\")]",
        "type": "character",
        "name": "char_017_homura_3#5"
    },
    {
        "id": 25,
        "raw": "[name=\"ブレイズ\"]  うん、そうだね。その通りだよ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "うん、そうだね。その通りだよ。"
    },
    {
        "id": 26,
        "raw": "[name=\"ブレイズ\"]  チッ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "チッ。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 28,
        "raw": "[name=\"ブレイズ\"]  ドクター、行くよ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "ドクター、行くよ。"
    },
    {
        "id": 29,
        "raw": "[Decision(options=\"......\", values=\"1\")]",
        "type": "decision",
        "options": "......",
        "values": "1"
    },
    {
