        "content": "……う、っ……"
    },
    {
        "id": 69,
        "raw": "[name=\"前衛オペレーター\"]  …………あ、れ……？",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "…………あ、れ……？"
    },
    {
        "id": 70,
        "raw": "[name=\"前衛オペレーター\"]  た……隊長……？",
