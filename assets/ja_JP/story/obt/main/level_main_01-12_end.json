    {
        "id": 40,
        "raw": "[name=\"アーミヤ\"]  ……彼女は、どうしてこんなことを……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……彼女は、どうしてこんなことを……？"
    },
    {
        "id": 41,
        "raw": "[Delay=0.5]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 43,
        "raw": "[name=\"ドーベルマン\"]  理由はわからんが……連中が退いたのは確かだ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "理由はわからんが……連中が退いたのは確かだ。"
    },
    {
        "id": 44,
        "raw": "[name=\"ドーベルマン\"]  ……なんにせよ、作戦の想定時刻を大幅に超えてしまった。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……なんにせよ、作戦の想定時刻を大幅に超えてしまった。"
    },
    {
        "id": 45,
        "raw": "[name=\"ドーベルマン\"]  我々のほうも、今すぐ引き上げるとしよう。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "我々のほうも、今すぐ引き上げるとしよう。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 47,
        "raw": "[name=\"アーミヤ\"]  ……はい。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……はい。"
    },
    {
        "id": 48,
        "raw": "[name=\"アーミヤ\"]  私……後方のオペレーターたちの、援護に回りますね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私……後方のオペレーターたちの、援護に回りますね。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 50,
        "raw": "[name=\"ニアール\"]  ……アーミヤ……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……アーミヤ……"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1.png"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]  心配しないでください。私は、大丈夫ですから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "心配しないでください。私は、大丈夫ですから。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 54,
        "raw": "[name=\"ニアール\"]  ……わかった。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……わかった。"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 56,
        "raw": "[name=\"ドーベルマン\"]  では、頼んだ。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "では、頼んだ。"
    },
