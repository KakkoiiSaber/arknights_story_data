        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw.png"
    },
    {
        "id": 6,
        "raw": "[name=\"W\"]  この感覚……なんだか、すっごく懐かしいわ。",
        "type": "dialog",
        "speaker": "W",
        "content": "この感覚……なんだか、すっごく懐かしいわ。"
    },
    {
        "id": 7,
        "raw": "[name=\"W\"]  あんた……アーミヤっていったわよね。",
        "type": "dialog",
        "speaker": "W",
        "content": "あんた……アーミヤっていったわよね。"
    },
    {
        "id": 8,
        "raw": "[name=\"W\"]  ——",
        "type": "dialog",
        "speaker": "W",
        "content": "——"
    },
    {
        "id": 9,
        "raw": "[name=\"W\"]  アハハッ、なるほど。……そういうことだったのね。",
        "type": "dialog",
        "speaker": "W",
        "content": "アハハッ、なるほど。……そういうことだったのね。"
    },
    {
        "id": 10,
        "raw": "[name=\"W\"]  あんたのこと、覚えておくわ。",
        "type": "dialog",
        "speaker": "W",
        "content": "あんたのこと、覚えておくわ。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 12,
        "raw": "[name=\"アーミヤ\"]  ……何を、言って……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……何を、言って……"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw.png"
    },
    {
        "id": 14,
        "raw": "[name=\"W\"]  あたしの欲しいものは手に入った、ってことよ。……ほら、行くならさっさと行きなさい。",
        "type": "dialog",
        "speaker": "W",
        "content": "あたしの欲しいものは手に入った、ってことよ。……ほら、行くならさっさと行きなさい。"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 16,
        "raw": "[name=\"アーミヤ\"]  っ、あなたは――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "っ、あなたは――"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=2)]",
        "type": "character",
        "name": "char_1504_cqbw.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"レユニオン構成員\"]  おい、W……？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "おい、W……？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=1)]",
        "type": "character",
        "name": "char_1504_cqbw.png",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"W\"]  ――まさかここで死のうってわけじゃないんでしょう？　あたしは別に、それでもいいけどね。",
        "type": "dialog",
        "speaker": "W",
        "content": "――まさかここで死のうってわけじゃないんでしょう？　あたしは別に、それでもいいけどね。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_1504_cqbw\",name2=\"char_1002_nsabr_2\",focus=2)]",
        "type": "character",
        "name": "char_1504_cqbw.png",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"レユニオン構成員\"]  ……ったく……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……ったく……"
    },
    {
        "id": 23,
        "raw": "[name=\"レユニオン構成員\"]  ……お前ら、繁華街まで撤退だ。あの連中は放っておけ。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……お前ら、繁華街まで撤退だ。あの連中は放っておけ。"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 25,
        "raw": "[name=\"アーミヤ\"]  えっ……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "えっ……？"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw.png"
    },
    {
        "id": 27,
        "raw": "[name=\"W\"]  こっちは飽き飽きしてんのよ。このままグダグダ続けてたってつまんないもの。",
        "type": "dialog",
        "speaker": "W",
        "content": "こっちは飽き飽きしてんのよ。このままグダグダ続けてたってつまんないもの。"
    },
    {
        "id": 28,
        "raw": "[name=\"W\"]  ――さて。次会う時を楽しみにしてるわ、アーミヤ。",
        "type": "dialog",
        "speaker": "W",
        "content": "――さて。次会う時を楽しみにしてるわ、アーミヤ。"
    },
    {
        "id": 29,
        "raw": "[name=\"W\"]  ああ、もちろん――そっちのあんたも、ね？",
        "type": "dialog",
        "speaker": "W",
        "content": "ああ、もちろん――そっちのあんたも、ね？"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1.png"
    },
    {
        "id": 31,
        "raw": "[name=\"アーミヤ\"]  っ……！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "っ……！？"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw.png"
    },
    {
        "id": 33,
        "raw": "[name=\"W\"]  今度は事の真相を聞かせてもらうわよ、{@Nickname}。",
        "type": "dialog",
        "speaker": "W",
        "content": "今度は事の真相を聞かせてもらうわよ、{@Nickname}。"
    },
    {
        "id": 34,
        "raw": "[name=\"W\"]  じゃ、またね～。",
        "type": "dialog",
        "speaker": "W",
        "content": "じゃ、またね～。"
    },
