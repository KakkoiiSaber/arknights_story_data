        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 30,
        "raw": "[name=\"フロストリーフ\"]   ……！　奴のアーツユニットから、光が……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……！　奴のアーツユニットから、光が……"
