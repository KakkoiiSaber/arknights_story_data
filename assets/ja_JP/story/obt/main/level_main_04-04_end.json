        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"ジェシカ\"]   ――う、嘘……増援まで来るなんて……！",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "――う、嘘……増援まで来るなんて……！"
