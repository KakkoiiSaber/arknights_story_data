        "type": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "id": 28,
        "raw": "[name=\"メフィスト\"]   おやおや？　もうくじけちゃったの？",
        "type": "dialog",
        "speaker": "メフィスト",
