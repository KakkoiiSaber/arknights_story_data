        "type": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "id": 32,
        "raw": "[name=\"メフィスト\"]   まだ何も始めてないんだけどなあ。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "まだ何も始めてないんだけどなあ。"
    },
