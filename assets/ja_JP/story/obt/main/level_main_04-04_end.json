        "raw": "[name=\"レユニオン構成員\"]   ぐ、うっ……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ぐ、うっ……"
    },
    {
        "id": 18,
        "raw": "[name=\"レユニオン構成員\"]   あ、あああああっ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "あ、あああああっ！"
    },
    {
        "id": 19,
        "raw": "[name=\"レユニオン構成員\"]   ひ……いたい……痛いい……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ひ……いたい……痛いい……"
    },
    {
        "id": 20,
        "raw": "[name=\"レユニオン構成員\"]   あ、うああっ……か、ゆい……痒い……痒い痒い痒い！！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "あ、うああっ……か、ゆい……痒い……痒い痒い痒い！！"
    },
    {
        "id": 21,
        "raw": "[name=\"レユニオン構成員\"]   ア……ぁあアァ……！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ア……ぁあアァ……！？"
    },
    {
        "id": 22,
