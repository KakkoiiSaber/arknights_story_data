        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"フロストリーフ\"]   よせ、メテオリーテ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "よせ、メテオリーテ。"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "id": 41,
        "raw": "[name=\"メフィスト\"]   ハハッ、この状況で議論なんかしてる余裕があるのかい？",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "ハハッ、この状況で議論なんかしてる余裕があるのかい？"
    },
