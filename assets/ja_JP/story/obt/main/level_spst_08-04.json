    },
    {
        "id": 56,
        "raw": "[name=\"疲弊したオペレーター\"] なっ……何が起きた！？",
        "type": "dialog",
        "speaker": "疲弊したオペレーター",
        "content": "なっ……何が起きた！？"
    },
    {
        "id": 57,
        "raw": "[name=\"疲弊したオペレーター\"] うわあぁっ――",
        "type": "dialog",
        "speaker": "疲弊したオペレーター",
        "content": "うわあぁっ――"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_089\")]",
        "type": "character",
        "name": "avg_npc_089"
    },
    {
        "id": 59,
        "raw": "[name=\"ベテランオペレーター\"] 掴まれ！",
        "type": "dialog",
        "speaker": "ベテランオペレーター",
        "content": "掴まれ！"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 61,
        "raw": "[name=\"疲弊したオペレーター\"] な、何だ？　……ひ、火が燃え広がっているぞ！？　ここに可燃物なんかあったか！？",
        "type": "dialog",
        "speaker": "疲弊したオペレーター",
        "content": "な、何だ？　……ひ、火が燃え広がっているぞ！？　ここに可燃物なんかあったか！？"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"avg_npc_089\")]",
        "type": "character",
        "name": "avg_npc_089"
    },
    {
        "id": 63,
        "raw": "[name=\"ベテランオペレーター\"] 自然発火……情報と同じだ。タルラのアーツだ……！",
        "type": "dialog",
        "speaker": "ベテランオペレーター",
        "content": "自然発火……情報と同じだ。タルラのアーツだ……！"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 65,
        "raw": "[name=\"疲弊したオペレーター\"] なに突っ立ってんだよ！　どうするんだ！？",
        "type": "dialog",
        "speaker": "疲弊したオペレーター",
        "content": "なに突っ立ってんだよ！　どうするんだ！？"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_089\")]",
        "type": "character",
        "name": "avg_npc_089"
    },
    {
        "id": 67,
        "raw": "[name=\"ベテランオペレーター\"] うむ――こっちだ。他の連中と合流するぞ！　おい、お前その足は大丈夫なのか！？",
        "type": "dialog",
        "speaker": "ベテランオペレーター",
        "content": "うむ――こっちだ。他の連中と合流するぞ！　おい、お前その足は大丈夫なのか！？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012"
    },
    {
        "id": 69,
        "raw": "[name=\"疲弊したオペレーター\"] 必死で気を紛らわせてるんだよ！！",
        "type": "dialog",
        "speaker": "疲弊したオペレーター",
        "content": "必死で気を紛らわせてるんだよ！！"
    },
