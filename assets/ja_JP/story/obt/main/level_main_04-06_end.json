    {
        "id": 58,
        "raw": "[name=\"アーミヤ\"]   （待っていてください、チェンさん……）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（待っていてください、チェンさん……）"
    },
    {
        "id": 59,
        "raw": "[name=\"アーミヤ\"]   （それに、フロストリーフさん、メテオリーテさん、ジェシカさんも……）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（それに、フロストリーフさん、メテオリーテさん、ジェシカさんも……）"
    },
    {
        "id": 60,
