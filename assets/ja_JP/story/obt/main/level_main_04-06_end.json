    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 6,
        "raw": "[name=\"アーミヤ\"]   これで、周囲のレユニオンは制圧できましたね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "これで、周囲のレユニオンは制圧できましたね。"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"ホシグマ\"]   やれやれ……単なる足止めにしては、やり過ぎなくらいの相手でしたよ。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "やれやれ……単なる足止めにしては、やり過ぎなくらいの相手でしたよ。"
    },
    {
        "id": 9,
        "raw": "[name=\"ホシグマ\"]   さて、チェン隊長のほうは……",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "さて、チェン隊長のほうは……"
    },
    {
        "id": 10,
        "raw": "[name=\"ホシグマ\"]   影も形もありませんね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "影も形もありませんね。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"アーミヤ\"]   これは、まずいですね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "これは、まずいですね……"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"ホシグマ\"]   通信にも……応答しない、と。相変わらず、困ったお人だ！　かくなる上は……",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "通信にも……応答しない、と。相変わらず、困ったお人だ！　かくなる上は……"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 16,
        "raw": "[name=\"ホシグマ\"]   近衛局各員に告ぐ！　突入するぞ、準備を――",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "近衛局各員に告ぐ！　突入するぞ、準備を――"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 18,
        "raw": "[name=\"アーミヤ\"]   ホシグマさん、待ってください。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ホシグマさん、待ってください。"
    },
    {
        "id": 19,
        "raw": "[name=\"アーミヤ\"]   ここは私たちに任せてもらえませんか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ここは私たちに任せてもらえませんか。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"アーミヤ\"]   ご承知の通り、この先の道は、天災によって発生した源石の群生地帯になっています。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ご承知の通り、この先の道は、天災によって発生した源石の群生地帯になっています。"
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   健康体の方があまり深くまで進んでしまうと、鉱石病への感染リスクは免れません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "健康体の方があまり深くまで進んでしまうと、鉱石病への感染リスクは免れません。"
    },
    {
        "id": 23,
        "raw": "[name=\"アーミヤ\"]   ともすれば、深刻な結果に繋がりかねないということです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ともすれば、深刻な結果に繋がりかねないということです。"
    },
    {
        "id": 24,
        "raw": "[name=\"アーミヤ\"]   それに、感染者の私たちであれば――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "それに、感染者の私たちであれば――"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"ホシグマ\"]   ――アーミヤさんが懸命に話すご様子は、実に健気で可愛らしい。何やら、心を打たれるものがありますね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "――アーミヤさんが懸命に話すご様子は、実に健気で可愛らしい。何やら、心を打たれるものがありますね。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#6",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"アーミヤ\"]   わわ、え、ええっと……！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "わわ、え、ええっと……！？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#6\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"ホシグマ\"]   はははっ、失礼。今のは忘れてください。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "はははっ、失礼。今のは忘れてください。"
    },
    {
        "id": 33,
        "raw": "[name=\"ホシグマ\"]   それより、小官を説得しようとお思いのようですが、その必要はありません。あなたの仰りたいことはわかっていますから。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "それより、小官を説得しようとお思いのようですが、その必要はありません。あなたの仰りたいことはわかっていますから。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 35,
        "raw": "[name=\"ホシグマ\"]   ――近衛局各員、聞け！　方針変更だ！　我々はこれより、ロドスの背中を預かる盾としてこの任務に当たることとする！",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "――近衛局各員、聞け！　方針変更だ！　我々はこれより、ロドスの背中を預かる盾としてこの任務に当たることとする！"
    },
    {
        "id": 36,
        "raw": "[name=\"ホシグマ\"]   レユニオンの出入りを許さぬよう、街の入り口を守るんだ！",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "レユニオンの出入りを許さぬよう、街の入り口を守るんだ！"
    },
    {
        "id": 37,
        "raw": "[name=\"ホシグマ\"]   感染者の問題は、その専門家に任せるとしよう！",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "感染者の問題は、その専門家に任せるとしよう！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 39,
        "raw": "[name=\"アーミヤ\"]   ホシグマさん……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ホシグマさん……"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"ホシグマ\"]   ああ、そうそう。私のことは気軽に「ホシグマ」と呼んでいただいて結構ですので。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "ああ、そうそう。私のことは気軽に「ホシグマ」と呼んでいただいて結構ですので。"
    },
    {
        "id": 42,
        "raw": "[name=\"ホシグマ\"]   ――チェン隊長のこと、よろしくお願いします。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "――チェン隊長のこと、よろしくお願いします。"
    },
    {
        "id": 43,
        "raw": "[name=\"ホシグマ\"]   あの人に死んでもらっては困りますから。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "あの人に死んでもらっては困りますから。"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"アーミヤ\"]   わかりました、ホシグマ……さん！　必ず、チェン隊長を無事に連れ帰ってきますので！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "わかりました、ホシグマ……さん！　必ず、チェン隊長を無事に連れ帰ってきますので！"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 47,
        "raw": "[name=\"ホシグマ\"]   ええ。あなた方も、どうかお気をつけて。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "ええ。あなた方も、どうかお気をつけて。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"アーミヤ\"]   はい！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい！"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 51,
        "raw": "[name=\"アーミヤ\"]   ドクター、ついてきてください。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ドクター、ついてきてください。"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]   ロドスのみなさんも、準備はいいですか？　――それでは、出発しましょう！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ロドスのみなさんも、準備はいいですか？　――それでは、出発しましょう！"
    },
