        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"ケルシー\"]   ……",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "……"
    },
    {
        "id": 70,
        "raw": "[name=\"ケルシー\"]   皮膚は赤く、腫れも見られる……全身の体温が低下し、組織の壊死まで起こっているようだが……",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "皮膚は赤く、腫れも見られる……全身の体温が低下し、組織の壊死まで起こっているようだが……"
    },
    {
        "id": 71,
        "raw": "[name=\"ケルシー\"]   考えられる原因は――",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "考えられる原因は――"
    },
