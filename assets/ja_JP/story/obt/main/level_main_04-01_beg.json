        "raw": "[Character(name=\"char_002_amiya_1#10\")]",
        "type": "character",
        "name": "char_002_amiya_1#10"
    },
    {
        "id": 71,
        "raw": "[name=\"アーミヤ\"]   ……あはは……お見通しでしたか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……あはは……お見通しでしたか。"
    },
    {
