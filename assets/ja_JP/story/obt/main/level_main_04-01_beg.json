        "fadetime": "0.3,",
        "block": true
    },
    {
        "id": 153,
        "raw": "[Character(name=\"char_003_kalts_1#3\")]",
        "type": "character",
        "name": "char_003_kalts_1#3"
    },
    {
        "id": 154,
        "raw": "[name=\"ケルシー\"]   ……さて。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "……さて。"
    },
    {
        "id": 155,
        "raw": "[name=\"ケルシー\"]   彼女に寄り添うことすら、まともにこなせないとはな。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "彼女に寄り添うことすら、まともにこなせないとはな。"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_003_kalts_1#2\")]",
        "type": "character",
        "name": "char_003_kalts_1#2"
    },
    {
        "id": 157,
        "raw": "[name=\"ケルシー\"]   まあいい。この結果は予想していた。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "まあいい。この結果は予想していた。"
    },
    {
        "id": 158,
        "raw": "[Character(name=\"char_003_kalts_1\")]",
        "type": "character",
        "name": "char_003_kalts_1"
    },
    {
        "id": 159,
        "raw": "[name=\"ケルシー\"]   ――アーミヤは、本当に強い子だ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "――アーミヤは、本当に強い子だ。"
    },
    {
        "id": 160,
        "raw": "[name=\"ケルシー\"]   しかし、どんなに堅い殻で己を守っていたとしても、強い圧力を受け続ければ、いずれは押し潰されてしまうもの……",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "しかし、どんなに堅い殻で己を守っていたとしても、強い圧力を受け続ければ、いずれは押し潰されてしまうもの……"
    },
    {
        "id": 161,
        "raw": "[name=\"ケルシー\"]   君には、そうした事態が訪れないようにしてもらいたい。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "君には、そうした事態が訪れないようにしてもらいたい。"
    },
    {
        "id": 162,
        "raw": "[name=\"ケルシー\"]   ゆえに、次に同様の事象が発生することがあれば、もう少し良い働きを期待したいものだ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "ゆえに、次に同様の事象が発生することがあれば、もう少し良い働きを期待したいものだ。"
    },
    {
        "id": 163,
        "raw": "[name=\"ケルシー\"]   ――？",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "――？"
    },
    {
        "id": 164,
        "raw": "[name=\"ケルシー\"]   その表情は何だ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "その表情は何だ。"
    },
    {
        "id": 165,
        "raw": "[Character(name=\"char_003_kalts_1\", focus=-1)]",
        "type": "character",
        "name": "char_003_kalts_1",
        "focus": -1
    },
    {
        "id": 166,
        "raw": "[Decision(options=\"一つ聞かせてほしい。アーミヤの指輪は何なんだ？;……\", values=\"1;2\")]",
        "type": "decision",
        "options": "一つ聞かせてほしい。アーミヤの指輪は何なんだ？;……",
        "values": "1;2"
    },
    {
        "id": 167,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
        "references": "1"
    },
    {
        "id": 168,
        "raw": "[Character(name=\"char_003_kalts_1#2\")]",
        "type": "character",
        "name": "char_003_kalts_1#2"
    },
    {
        "id": 169,
        "raw": "[name=\"ケルシー\"]   あれは、彼女の身体状況に関係している物だ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "あれは、彼女の身体状況に関係している物だ。"
    },
    {
        "id": 170,
        "raw": "[name=\"ケルシー\"]   それ以上のことは、まだ教えられない。ただ、一点だけ注意すべきことを伝えるとするなら……",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "それ以上のことは、まだ教えられない。ただ、一点だけ注意すべきことを伝えるとするなら……"
    },
    {
        "id": 171,
        "raw": "[name=\"ケルシー\"]   この先、仮にアーミヤが激しい戦闘に巻き込まれることがあれば――",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "この先、仮にアーミヤが激しい戦闘に巻き込まれることがあれば――"
    },
    {
        "id": 172,
        "raw": "[name=\"ケルシー\"]   ――状況が落ち着き次第、すぐに指輪の状態を確認するよう心がけてくれ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "――状況が落ち着き次第、すぐに指輪の状態を確認するよう心がけてくれ。"
    },
    {
        "id": 173,
        "raw": "[Blocker(fadetime=1.2, block=true)]",
        "type": "blocker",
        "fadetime": "1.2,",
        "block": true
    },
    {
        "id": 174,
        "raw": "[Character(name=\"char_003_kalts_1\")]",
        "type": "character",
        "name": "char_003_kalts_1"
    },
    {
        "id": 175,
        "raw": "[name=\"ケルシー\"]   なお、その際指輪に少しでも変化が見られた場合には、必ず私に報告するように。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "なお、その際指輪に少しでも変化が見られた場合には、必ず私に報告するように。"
    },
    {
        "id": 176,
        "raw": "[name=\"ケルシー\"]   ……ああ、それと。別件だが、二日後に検査センターで、君の身体検査を行う予定がある。忘れてくれるなよ。",
        "type": "dialog",
