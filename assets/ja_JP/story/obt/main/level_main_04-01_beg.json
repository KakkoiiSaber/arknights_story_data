    },
    {
        "id": 31,
        "raw": "[name=\"ケルシー\"]   幸い、指輪に亀裂や変色などはないようだな。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "幸い、指輪に亀裂や変色などはないようだな。"
    },
    {
        "id": 32,
        "raw": "[name=\"ケルシー\"]   だが、次もこう上手くいくとは限らない。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "だが、次もこう上手くいくとは限らない。"
    },
    {
        "id": 33,
        "raw": "[name=\"ケルシー\"]   改めて言っておくが――",
        "type": "dialog",
