        "content": "……ドクター……？"
    },
    {
        "id": 69,
        "raw": "[name=\"アーミヤ\"]   悩みごと……？　私が、ですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "悩みごと……？　私が、ですか？"
    },
