        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 73,
        "raw": "[name=\"アーミヤ\"]   ちゃんと隠せてるつもりだったんですけど……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ちゃんと隠せてるつもりだったんですけど……"
    },
    {
        "id": 74,
        "raw": "[name=\"アーミヤ\"]   確かに、少し……ほんの少しだけ、悩んでいることがあるんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "確かに、少し……ほんの少しだけ、悩んでいることがあるんです。"
    },
    {
        "id": 75,
        "raw": "[name=\"アーミヤ\"]   でも、それを我慢するのにも慣れてきてしまって。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "でも、それを我慢するのにも慣れてきてしまって。"
    },
    {
        "id": 76,
        "raw": "[name=\"アーミヤ\"]   やっぱり、みなさんの負担を増やすわけにはいきませんし……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "やっぱり、みなさんの負担を増やすわけにはいきませんし……"
    },
    {
        "id": 77,
        "raw": "[name=\"アーミヤ\"]   ドクターも、そう思いますよね？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ドクターも、そう思いますよね？"
    },
    {
