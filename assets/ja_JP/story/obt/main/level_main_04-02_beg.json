        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 116,
        "raw": "[name=\"ジェシカ\"]   了解しました。",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "了解しました。"
    },
    {
        "id": 117,
        "raw": "[name=\"ジェシカ\"]   フロストリーフさんのほうに、行ってみましょう。",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "フロストリーフさんのほうに、行ってみましょう。"
