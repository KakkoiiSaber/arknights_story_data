    {
        "id": 124,
        "raw": "[playMusic(intro=\"$nervous_intro\", key=\"$nervous_loop\", volume=0.4)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/act9d0d0/m_avg_nervous_intro.mp3",
        "key": "audio/sound_beta_2/music/act9d0d0/m_avg_nervous_loop.mp3",
