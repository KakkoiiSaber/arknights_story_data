        "content": "……"
    },
    {
        "id": 106,
        "raw": "[name=\"ミーシャ\"]   ……あの子が守ろうとした皆は、感染者で……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……あの子が守ろうとした皆は、感染者で……"
    },
    {
        "id": 107,
        "raw": "[name=\"ミーシャ\"]   今は……私も、同じ立場にいる。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "今は……私も、同じ立場にいる。"
    },
    {
        "id": 108,
        "raw": "[name=\"ミーシャ\"]   私たちには、行くあてなんてないけど……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "私たちには、行くあてなんてないけど……"
    },
