        "time": 0.6
    },
    {
        "id": 50,
        "raw": "[name=\"ミーシャ\"]   ……ねえ、聞こえなかったの？",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……ねえ、聞こえなかったの？"
    },
    {
        "id": 51,
        "raw": "[name=\"ミーシャ\"]   二人きりにしてほしい、って言ったんだけど。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "二人きりにしてほしい、って言ったんだけど。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 53,
        "raw": "[name=\"W\"]   でもあんた、そろそろここを離れたほうがいいと思うわよ？",
        "type": "dialog",
        "speaker": "W",
        "content": "でもあんた、そろそろここを離れたほうがいいと思うわよ？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1"
    },
    {
        "id": 55,
        "raw": "[name=\"ミーシャ\"]   ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1504_cqbw\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"W\"]   だってもうじき、ロドスと近衛局が攻め込んできて……",
        "type": "dialog",
        "speaker": "W",
        "content": "だってもうじき、ロドスと近衛局が攻め込んできて……"
    },
    {
        "id": 58,
        "raw": "[name=\"W\"]   足止め役のレユニオンたちは、み～んな死んじゃうでしょうから。",
        "type": "dialog",
        "speaker": "W",
        "content": "足止め役のレユニオンたちは、み～んな死んじゃうでしょうから。"
    },
    {
        "id": 59,
        "raw": "[name=\"W\"]   それにしても、迷惑な話よねえ。",
        "type": "dialog",
        "speaker": "W",
        "content": "それにしても、迷惑な話よねえ。"
    },
    {
        "id": 60,
        "raw": "[name=\"W\"]   あんたのために、大勢の人が死んでいくなんて……",
        "type": "dialog",
        "speaker": "W",
        "content": "あんたのために、大勢の人が死んでいくなんて……"
    },
    {
        "id": 61,
        "raw": "[name=\"W\"]   と～ってもお気の毒さま。",
        "type": "dialog",
        "speaker": "W",
        "content": "と～ってもお気の毒さま。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1504_cqbw\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"ミーシャ\"]   ……あなたにはもううんざり。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……あなたにはもううんざり。"
    },
    {
        "id": 64,
        "raw": "[name=\"ミーシャ\"]   そんなこと言ったところで、私からは何も得られないよ。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "そんなこと言ったところで、私からは何も得られないよ。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1504_cqbw\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"W\"]   アハハ、こわいこわ～い。",
        "type": "dialog",
        "speaker": "W",
        "content": "アハハ、こわいこわ～い。"
    },
    {
        "id": 67,
        "raw": "[name=\"W\"]   ところで、あのウサギちゃんはまだあんたのことを気にしてたみたいねえ？",
        "type": "dialog",
        "speaker": "W",
        "content": "ところで、あのウサギちゃんはまだあんたのことを気にしてたみたいねえ？"
    },
    {
        "id": 68,
        "raw": "[name=\"W\"]   だけど、近衛局様のチェン隊長はどうかしら？",
        "type": "dialog",
        "speaker": "W",
        "content": "だけど、近衛局様のチェン隊長はどうかしら？"
    },
    {
        "id": 69,
        "raw": "[name=\"W\"]   あたしの予想だと～、あの人はきっと、誰にも情けをかけたりしないでしょうね。",
        "type": "dialog",
        "speaker": "W",
        "content": "あたしの予想だと～、あの人はきっと、誰にも情けをかけたりしないでしょうね。"
    },
    {
        "id": 70,
        "raw": "[name=\"W\"]   確かに、あんたを利用するために生かしておくことはするかもしれないけど――",
        "type": "dialog",
        "speaker": "W",
        "content": "確かに、あんたを利用するために生かしておくことはするかもしれないけど――"
    },
    {
        "id": 71,
        "raw": "[name=\"W\"]   そのあとどうなるか、なんてことは……ウルサスで散々見てきたんだから、わかってるでしょ？",
        "type": "dialog",
        "speaker": "W",
        "content": "そのあとどうなるか、なんてことは……ウルサスで散々見てきたんだから、わかってるでしょ？"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1504_cqbw\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 1
    },
    {
        "id": 73,
        "raw": "[name=\"ミーシャ\"]   ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1504_cqbw\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1",
        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"W\"]   それじゃ、行きましょうか。よかったわねえ、今ならまだ間に合いそうよ。",
        "type": "dialog",
        "speaker": "W",
        "content": "それじゃ、行きましょうか。よかったわねえ、今ならまだ間に合いそうよ。"
    },
    {
        "id": 76,
        "raw": "[name=\"W\"]   とはいえ、ほかの人のことは成り行き任せになっちゃうんだけど……",
        "type": "dialog",
        "speaker": "W",
        "content": "とはいえ、ほかの人のことは成り行き任せになっちゃうんだけど……"
    },
    {
        "id": 77,
        "raw": "[name=\"W\"]   どの道、あの人たちの運命はもう決まっちゃってるでしょうしね。",
        "type": "dialog",
        "speaker": "W",
        "content": "どの道、あの人たちの運命はもう決まっちゃってるでしょうしね。"
    },
    {
        "id": 78,
        "raw": "[name=\"W\"]   ほ～んと、心底同情するわ。",
        "type": "dialog",
        "speaker": "W",
        "content": "ほ～んと、心底同情するわ。"
    },
    {
        "id": 79,
