        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"W\"]   あ、そうそう。",
        "type": "dialog",
        "speaker": "W",
        "content": "あ、そうそう。"
    },
    {
        "id": 83,
        "raw": "[name=\"W\"]   全部見てたなら、わかってると思うけど――",
        "type": "dialog",
        "speaker": "W",
        "content": "全部見てたなら、わかってると思うけど――"
    },
    {
        "id": 84,
        "raw": "[name=\"W\"]   その状態のスカルシュレッダーを連れ帰る余裕なんてないわよ。残念ながら、ね。",
        "type": "dialog",
        "speaker": "W",
        "content": "その状態のスカルシュレッダーを連れ帰る余裕なんてないわよ。残念ながら、ね。"
