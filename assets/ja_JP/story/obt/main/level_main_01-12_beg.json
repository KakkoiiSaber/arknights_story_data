        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 75,
        "raw": "[name=\"アーミヤ\"]  ――ッ……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――ッ……！"
    },
    {
        "id": 76,
        "raw": "[Decision(options=\"相手にするな、アーミヤ！;アーミヤ……;W……！　なぜそんなことを……！\", values=\"1;2;3\")]",
