    },
    {
        "id": 11,
        "raw": "[name=\"ドーベルマン\"]   出口は目の前だというのに……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "出口は目の前だというのに……！"
    },
    {
