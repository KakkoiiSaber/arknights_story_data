    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 79,
        "raw": "[name=\"W\"]  お医者さんはまだ黙っててちょうだい。",
        "type": "dialog",
        "speaker": "W",
        "content": "お医者さんはまだ黙っててちょうだい。"
    },
    {
        "id": 80,
        "raw": "[name=\"W\"]  ――で、ウサギさん？",
        "type": "dialog",
        "speaker": "W",
        "content": "――で、ウサギさん？"
    },
    {
        "id": 81,
        "raw": "[name=\"W\"]  あんた、もしかして怒ってんの？",
        "type": "dialog",
        "speaker": "W",
        "content": "あんた、もしかして怒ってんの？"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 83,
        "raw": "[name=\"アーミヤ\"]  ……彼らは、下僕などではありません。命を賭して戦ったのは、みなさん自身の意志があるからです……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……彼らは、下僕などではありません。命を賭して戦ったのは、みなさん自身の意志があるからです……！"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
