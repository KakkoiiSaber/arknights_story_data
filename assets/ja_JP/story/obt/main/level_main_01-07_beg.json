    },
    {
        "id": 115,
        "raw": "[name=\"アーミヤ\"]    だ、大丈夫ですか？　お怪我はありませんか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "だ、大丈夫ですか？　お怪我はありませんか？"
