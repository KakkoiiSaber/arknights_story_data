        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 126,
        "raw": "[name=\"アーミヤ\"]    ……ただ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ただ……"
    },
    {
        "id": 127,
        "raw": "[name=\"アーミヤ\"]    （あとどれだけ持ちこたえられるのか……）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（あとどれだけ持ちこたえられるのか……）"
    },
    {
        "id": 128,
        "raw": "[name=\"アーミヤ\"]    （本当に、生き延びることができるのか……どうにも、不安は尽きないけれど……）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（本当に、生き延びることができるのか……どうにも、不安は尽きないけれど……）"
    },
