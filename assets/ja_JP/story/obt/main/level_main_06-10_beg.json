        "raw": "[name=\"グレースロート\"]  私……まだ生きてる？",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "私……まだ生きてる？"
    },
    {
        "id": 96,
        "raw": "[PlayMusic(intro=\"$darkness02_intro\", key=\"$darkness02_loop\", volume=0.8, crossfade=1.5, delay=0.5)]",
