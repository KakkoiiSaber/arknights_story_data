        "type": "character"
    },
    {
        "id": 20,
        "raw": "[name=\"子供\"]  ぐすん……。",
        "type": "dialog",
        "speaker": "子供",
        "content": "ぐすん……。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"グレースロート\"]  ……こんにちは。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "……こんにちは。"
    },
    {
        "id": 23,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "[name=\"子供\"]  だ、だれ？",
        "type": "dialog",
        "speaker": "子供",
        "content": "だ、だれ？"
    },
    {
        "id": 25,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 26,
        "raw": "[name=\"子供\"]  龍門の人？",
        "type": "dialog",
        "speaker": "子供",
        "content": "龍門の人？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 28,
        "raw": "[name=\"グレースロート\"]  ……君たちを傷つけない人。ウルサス語は下手だけど、敵意はないから。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "……君たちを傷つけない人。ウルサス語は下手だけど、敵意はないから。"
    },
    {
        "id": 29,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 30,
        "raw": "[name=\"子供\"]  なに言ってるの？",
        "type": "dialog",
        "speaker": "子供",
        "content": "なに言ってるの？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 32,
        "raw": "[name=\"グレースロート\"]  私と来て、ここは危険だから。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "私と来て、ここは危険だから。"
    },
    {
        "id": 33,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 34,
        "raw": "[name=\"子供\"]  おじさんがここから動くなって言ってた……。",
        "type": "dialog",
        "speaker": "子供",
        "content": "おじさんがここから動くなって言ってた……。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 36,
        "raw": "[name=\"グレースロート\"]  ……でも私は君たちと一緒にパパを探してあげられる。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "……でも私は君たちと一緒にパパを探してあげられる。"
    },
    {
        "id": 37,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 38,
        "raw": "[name=\"子供\"]  本当？",
        "type": "dialog",
        "speaker": "子供",
        "content": "本当？"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 40,
        "raw": "[name=\"グレースロート\"]  本当。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "本当。"
    },
    {
        "id": 41,
        "raw": "[name=\"グレースロート\"]  後ろに隠れてるのは分かってる。出てきなさい。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "後ろに隠れてるのは分かってる。出てきなさい。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1.png"
    },
    {
        "id": 43,
        "raw": "[name=\"レユニオン構成員\"]  お前は……。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "お前は……。"
    },
    {
        "id": 44,
        "raw": "[name=\"レユニオン構成員\"]  お前はあいつらと違うな。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "お前はあいつらと違うな。"
    },
    {
        "id": 45,
        "raw": "[name=\"レユニオン構成員\"]  お前は……ロドスか？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "お前は……ロドスか？"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4.png"
    },
    {
        "id": 47,
        "raw": "[name=\"グレースロート\"]  君たち、下がって。こっちに来ちゃダメ。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "君たち、下がって。こっちに来ちゃダメ。"
    },
    {
        "id": 48,
        "raw": "[name=\"グレースロート\"]  あんたたち、武器を下ろして大人しく私に従って。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "あんたたち、武器を下ろして大人しく私に従って。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"レユニオン構成員\"]  なに？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "なに？"
    },
    {
        "id": 51,
        "raw": "[name=\"レユニオン構成員\"]  俺たちを助けに来たってわけじゃねぇのか？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "俺たちを助けに来たってわけじゃねぇのか？"
    },
    {
        "id": 52,
        "raw": "[name=\"レユニオン構成員\"]  ロドス！　お前たちはこのスラムに何が潜んでるか知らねぇのか？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ロドス！　お前たちはこのスラムに何が潜んでるか知らねぇのか？"
    },
    {
        "id": 53,
        "raw": "[name=\"レユニオン構成員\"]  こうしてやっと待ち伏せの罠を仕掛けたのに……。ここであいつらを奇襲して殺さなきゃ、逃げたっていずれ追いつかれて殺されちまう！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "こうしてやっと待ち伏せの罠を仕掛けたのに……。ここであいつらを奇襲して殺さなきゃ、逃げたっていずれ追いつかれて殺されちまう！"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"グレースロート\"]  子供を囮に使うような奴は、殺されたほうがいい。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "子供を囮に使うような奴は、殺されたほうがいい。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"レユニオン構成員\"]  ……何を勘違いしてやがる？　俺たちが殺されればそれで全部終わるとでも思ってんのか？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……何を勘違いしてやがる？　俺たちが殺されればそれで全部終わるとでも思ってんのか？"
    },
    {
        "id": 58,
        "raw": "[name=\"レユニオン構成員\"]  たとえ俺たちが殺されたって、あいつらは子供に情けをかけたりはしねぇ。誰一人逃がすつもりなんてないんだ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "たとえ俺たちが殺されたって、あいつらは子供に情けをかけたりはしねぇ。誰一人逃がすつもりなんてないんだ！"
    },
    {
        "id": 59,
        "raw": "[name=\"レユニオン構成員\"]  俺たちが殺されて全てが終わるってんなら、子供なんて使わず自ら命を差し出すさ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "俺たちが殺されて全てが終わるってんなら、子供なんて使わず自ら命を差し出すさ！"
    },
    {
        "id": 60,
        "raw": "[name=\"レユニオン構成員\"]  お前にだって攻撃してないだろ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "お前にだって攻撃してないだろ！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"グレースロート\"]  あいつらって……もしかしてあの黒装束たちのことを言ってるの？",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "あいつらって……もしかしてあの黒装束たちのことを言ってるの？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"レユニオン構成員\"]  そうさ、あいつらを知ってんならわかるだろ！　ここの奴らを皆殺しにするつもりだ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "そうさ、あいつらを知ってんならわかるだろ！　ここの奴らを皆殺しにするつもりだ！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 66,
        "raw": "[name=\"グレースロート\"]  そんなの言い訳にならない。あんたたちを制圧した後、保護してもらえるよう申請するから。ここは大人しく私に従って。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "そんなの言い訳にならない。あんたたちを制圧した後、保護してもらえるよう申請するから。ここは大人しく私に従って。"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"レユニオン構成員\"]  この状況で誰がお前を信じるんだ！？　お前のそのクロスボウで撃たれて死ねば、保護も何もあったもんじゃないだろ。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "この状況で誰がお前を信じるんだ！？　お前のそのクロスボウで撃たれて死ねば、保護も何もあったもんじゃないだろ。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"グレースロート\"]  一時的に命は保証してあげられる。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "一時的に命は保証してあげられる。"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"レユニオン構成員\"]  もう構うな、そいつをやっちまってまた待ち伏せをすればいい！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "もう構うな、そいつをやっちまってまた待ち伏せをすればいい！"
    },
    {
        "id": 73,
        "raw": "[name=\"レユニオン構成員\"]  集合命令と撤退ポイントの情報は受け取ってんだ。もしここで死んだら、子供たちを守るために死んでいった親たちに申し訳が立たない。あいつらだって俺たちの仲間だったんだ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "集合命令と撤退ポイントの情報は受け取ってんだ。もしここで死んだら、子供たちを守るために死んでいった親たちに申し訳が立たない。あいつらだって俺たちの仲間だったんだ！"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4.png"
    },
    {
        "id": 75,
        "raw": "[name=\"グレースロート\"]  チッ……子供たちは離れてて！",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "チッ……子供たちは離れてて！"
    },
