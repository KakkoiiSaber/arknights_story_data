    {
        "id": 5,
        "raw": "ううう、ぐすん……。",
        "type": "narration",
        "content": "ううう、ぐすん……。"
    },
    {
        "id": 6,
        "raw": "お腹が空いたよぉ……！",
        "type": "narration",
        "content": "お腹が空いたよぉ……！"
    },
    {
        "id": 7,
        "raw": "パパは？　パパはどこに行っちゃったの？",
        "type": "narration",
        "content": "パパは？　パパはどこに行っちゃったの？"
    },
    {
        "id": 8,
        "raw": "パパがいなきゃやだ……パパ！　パパ！",
        "type": "narration",
        "content": "パパがいなきゃやだ……パパ！　パパ！"
    },
    {
        "id": 9,
        "raw": "パパが迎えに来てくれるはずだもん！",
        "type": "narration",
        "content": "パパが迎えに来てくれるはずだもん！"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 11,
        "raw": "[name=\"グレースロート\"]  ……！",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "……！"
    },
    {
        "id": 12,
        "raw": "[name=\"グレースロート\"]  子供？",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "子供？"
    },
    {
        "id": 13,
        "raw": "[playsound(key=\"$d_gen_transmissionget\", volume=0.4)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.4
    },
    {
        "id": 14,
        "raw": "[name=\"グレースロート\"]  Blaze-4、Amiya-1小隊に報告。スラム四番街、破壊された十号建造物の中で、子供の生き残りを発見した。感染者よ。",
        "type": "dialog",
        "speaker": "グレースロート",
        "content": "Blaze-4、Amiya-1小隊に報告。スラム四番街、破壊された十号建造物の中で、子供の生き残りを発見した。感染者よ。"
    },
