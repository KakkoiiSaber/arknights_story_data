    },
    {
        "id": 71,
        "raw": "[name=\"近衛局隊員\"]   向こうの人員が、散開しました！　こちらを取り囲むつもりのようです！",
        "type": "dialog",
        "speaker": "近衛局隊員",
        "content": "向こうの人員が、散開しました！　こちらを取り囲むつもりのようです！"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_010_chen_1#2\")]",
        "type": "character",
        "name": "char_010_chen_1#2"
    },
    {
        "id": 73,
        "raw": "[name=\"チェン\"]   防戦一方では両翼が持たん……反撃に出るぞ！",
        "type": "dialog",
        "speaker": "チェン",
        "content": "防戦一方では両翼が持たん……反撃に出るぞ！"
    },
    {
        "id": 74,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 75,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 77,
        "raw": "[name=\"レユニオン構成員\"]   俺がカバーする！　あいつらを倒して、この戦いを終わらせよう！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "俺がカバーする！　あいつらを倒して、この戦いを終わらせよう！"
    },
    {
        "id": 78,
        "raw": "[name=\"レユニオン構成員\"]   頼むぞ、スカルシュレッダー！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "頼むぞ、スカルシュレッダー！"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_1500_skulsr\",name2=\"char_1002_nsabr_2\",focus=1)]",
        "type": "character",
        "name": "char_1500_skulsr",
        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"スカルシュレッダー\"]   ああ……俺は必ず、皆と一緒に……",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "ああ……俺は必ず、皆と一緒に……"
    },
    {
        "id": 81,
        "raw": "[name=\"スカルシュレッダー\"]   そうだ――絶対に！！",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "そうだ――絶対に！！"
    },
    {
        "id": 82,
        "raw": "[name=\"スカルシュレッダー\"]   ――――",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "――――"
    },
