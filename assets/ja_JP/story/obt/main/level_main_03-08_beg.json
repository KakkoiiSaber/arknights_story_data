    {
        "id": 56,
        "raw": "[Character(name=\"char_1500_skulsr\")]",
        "type": "character",
        "name": "char_1500_skulsr"
    },
    {
        "id": 57,
        "raw": "[name=\"スカルシュレッダー\"]   「道」？",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "「道」？"
    },
    {
        "id": 58,
        "raw": "[name=\"スカルシュレッダー\"]   ……それを選んだとして……",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "……それを選んだとして……"
    },
    {
        "id": 59,
        "raw": "[name=\"スカルシュレッダー\"]   私たちに……そしてあなたたちに、何ができるっていうの？",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "私たちに……そしてあなたたちに、何ができるっていうの？"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 61,
        "raw": "[name=\"レユニオン構成員\"]   あんな奴と話したところで、時間の無駄だ！　一気にかかるぞ、スカルシュレッダー！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "あんな奴と話したところで、時間の無駄だ！　一気にかかるぞ、スカルシュレッダー！"
    },
