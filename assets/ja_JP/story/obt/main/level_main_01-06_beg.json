    {
        "id": 89,
        "raw": "[name=\"レユニオン構成員\"]  ひ、ヒヒ、ヒヒヒヒッ――ぎ……あ、アアアッ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ひ、ヒヒ、ヒヒヒヒッ――ぎ……あ、アアアッ！"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 91,
        "raw": "[name=\"ドーベルマン\"]  なッ……！？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "なッ……！？"
    },
    {
        "id": 92,
        "raw": "[name=\"ドーベルマン\"]  あの連中……なぜ倒れたんだ……？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "あの連中……なぜ倒れたんだ……？"
    },
    {
        "id": 93,
        "raw": "[name=\"ドーベルマン\"]  ……味方の攻撃、か？",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……味方の攻撃、か？"
    },
    {
        "id": 94,
        "raw": "[name=\"ドーベルマン\"]  それとも――",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "それとも――"
    },
    {
        "id": 95,
        "raw": "[PlaySound(key=\"$d_gen_explo_n\", volume=0.4, delay=2)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_explo_n.mp3",
        "volume": "0.4,",
        "delay": 2
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 97,
        "raw": "[name=\"アーミヤ\"]  ――ドーベルマンさん！　空が……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――ドーベルマンさん！　空が……！"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 99,
        "raw": "[name=\"ニアール\"]  ッ、これは……！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "ッ、これは……！"
    },
    {
        "id": 100,
        "raw": "[Blocker(a=1, initr=2, r=0, g=0, b=0, fadetime=0.8, block=true)]",
        "type": "blocker",
        "a": "1,",
        "initr": "2,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.8,",
        "block": true
    },
    {
        "id": 101,
        "raw": "[name=\"ニアール\"]  空が、血のように紅く――",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "空が、血のように紅く――"
    },
    {
        "id": 102,
        "raw": "[name=\"ニアール\"]  ――「煮えたぎる雲が、焔へと転じる時」……まるで、あの一節のような……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "――「煮えたぎる雲が、焔へと転じる時」……まるで、あの一節のような……"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_014_riope\")]",
        "type": "character",
        "name": "char_014_riope.png"
    },
    {
        "id": 104,
        "raw": "[name=\"Ace\"]  皆、慌てず行動しろ！",
        "type": "dialog",
        "speaker": "Ace",
        "content": "皆、慌てず行動しろ！"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_148_nearl_1#7\")]",
        "type": "character",
        "name": "char_148_nearl_1#7.png"
    },
    {
        "id": 106,
        "raw": "[name=\"ニアール\"]  ……！　彼の言う通りだ！　全員、まずは自分の身を守ってくれ！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……！　彼の言う通りだ！　全員、まずは自分の身を守ってくれ！"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 108,
        "raw": "[name=\"ドーベルマン\"]  ……まだ、終わりじゃない……！　生き延びる方法は、必ずあるはずだ……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……まだ、終わりじゃない……！　生き延びる方法は、必ずあるはずだ……！"
    },
