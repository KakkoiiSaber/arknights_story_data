    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 34,
        "raw": "[name=\"ドーベルマン\"]  全員、構えろ！　あの狙撃手……かなり手強いぞ！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "全員、構えろ！　あの狙撃手……かなり手強いぞ！"
    },
    {
        "id": 35,
        "raw": "[name=\"ドーベルマン\"]  いくらニアールでも、もう一撃食らうのはまずい……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "いくらニアールでも、もう一撃食らうのはまずい……！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#7 \")]",
        "type": "character",
        "name": "char_002_amiya_1#7 "
    },
    {
        "id": 37,
        "raw": "[name=\"アーミヤ\"]  下がってください、ニアールさん！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "下がってください、ニアールさん！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3"
    },
    {
        "id": 39,
        "raw": "[name=\"ニアール\"]   ――いいや。今退くわけにはいかない。あの尋常ではない威力……あれが直撃すれば、部隊は壊滅的な被害を受けることになる。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "――いいや。今退くわけにはいかない。あの尋常ではない威力……あれが直撃すれば、部隊は壊滅的な被害を受けることになる。"
    },
    {
        "id": 40,
        "raw": "[name=\"ニアール\"]   ゆえに――私はここへ立つ。皆を守り抜いてみせる！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "ゆえに――私はここへ立つ。皆を守り抜いてみせる！"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_1507_Mephisto_1#2\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#2"
    },
    {
        "id": 42,
        "raw": "[name=\"メフィスト\"]  ……ファウストの砲撃が、防がれた……？　たった一枚の盾如きで……！？",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "……ファウストの砲撃が、防がれた……？　たった一枚の盾如きで……！？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_1507_Mephisto_1#3\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#3"
    },
    {
        "id": 44,
        "raw": "[name=\"メフィスト\"]  ありえない……そんなのありえない！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "ありえない……そんなのありえない！"
    },
    {
        "id": 45,
        "raw": "[name=\"メフィスト\"]  ……もう一度だ。もう一度やろう、ファウスト！　あいつをバラバラにしてやるんだ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "……もう一度だ。もう一度やろう、ファウスト！　あいつをバラバラにしてやるんだ！"
    },
