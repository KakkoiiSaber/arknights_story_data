    {
        "id": 79,
        "raw": "[Character(name=\"char_014_riope\" )]",
        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 80,
        "raw": "[name=\"Ace\"]  そう簡単にはいかんだろうな……今のはあくまで、ちょっとした時間稼ぎさ。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "そう簡単にはいかんだろうな……今のはあくまで、ちょっとした時間稼ぎさ。"
    },
    {
        "id": 81,
        "raw": "[name=\"Ace\"]  とにかく、急ぐぞ！　連中に構っている暇はない！",
        "type": "dialog",
        "speaker": "Ace",
        "content": "とにかく、急ぐぞ！　連中に構っている暇はない！"
    },
