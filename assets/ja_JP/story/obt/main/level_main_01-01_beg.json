        "type": "character",
        "name": "char_002_amiya_1#3 "
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_002_amiya_1#1 \")]",
        "type": "character",
        "name": "char_002_amiya_1#1 "
    },
    {
        "id": 55,
        "raw": "[name=\"アーミヤ\"]  大丈夫ですよ。私も笑ってしまいましたし……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "大丈夫ですよ。私も笑ってしまいましたし……"
    },
    {
        "id": 56,
        "raw": "[name=\"アーミヤ\"]  みなさんには、なるべく笑顔でいてほしいと思っていますから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "みなさんには、なるべく笑顔でいてほしいと思っていますから。"
    },
    {
        "id": 57,
        "raw": "[name=\"アーミヤ\"]  そもそも、ロドスを立ち上げたのは、みなさんの涙を見るためではありませんしね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そもそも、ロドスを立ち上げたのは、みなさんの涙を見るためではありませんしね。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_002_amiya_1#1 \",name2=\"char_016_medic\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#1 ",
        "name2": "char_016_medic",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"医療オペレーター\"]  ……アーミヤさん……",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "……アーミヤさん……"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_002_amiya_1#1 \",name2=\"char_016_medic\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#1 ",
        "name2": "char_016_medic",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"アーミヤ\"]  ですから、どうかお気になさらず。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ですから、どうかお気になさらず。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_130_doberm_ex\",name2=\"char_014_riope\",focus=1)]",
        "type": "character",
        "name": "char_130_doberm_ex",
        "name2": "char_014_riope",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"ドーベルマン\"]  ……さて、そろそろ偵察に行ってくる。小隊員は私に続け。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……さて、そろそろ偵察に行ってくる。小隊員は私に続け。"
    },
    {
        "id": 64,
        "raw": "[name=\"ドーベルマン\"]  四時方向の敵には、我々のほうで対処するとしよう。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "四時方向の敵には、我々のほうで対処するとしよう。"
    },
    {
        "id": 65,
        "raw": "[name=\"ドーベルマン\"]  爆音を放つアーツの使い手にでも出くわさなければ、まず問題は起こるまい。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "爆音を放つアーツの使い手にでも出くわさなければ、まず問題は起こるまい。"
