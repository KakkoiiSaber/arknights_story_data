        "raw": "[Character(name=\"char_148_nearl_1#2\", name2=\"char_016_medic\", focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1#2",
        "name2": "char_016_medic",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"医療オペレーター\"]  い、いえいえ、お気になさらず……！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "い、いえいえ、お気になさらず……！"
    },
    {
        "id": 51,
        "raw": "[name=\"医療オペレーター\"]  こちらこそ、笑ってしまってすみません……！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "こちらこそ、笑ってしまってすみません……！"
    },
    {
        "id": 52,
        "raw": "[name=\"医療オペレーター\"]  こんな大変な時なのに、私ったら……",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "こんな大変な時なのに、私ったら……"
