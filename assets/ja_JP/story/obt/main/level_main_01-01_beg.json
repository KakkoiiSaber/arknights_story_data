        "type": "character",
        "name": "char_148_nearl_1#2"
    },
    {
        "id": 47,
        "raw": "[name=\"ニアール\"]  ……いやはや……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……いやはや……"
    },
    {
        "id": 48,
        "raw": "[name=\"ニアール\"]  すまない。私はどうも、頭が固いようで……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "すまない。私はどうも、頭が固いようで……"
