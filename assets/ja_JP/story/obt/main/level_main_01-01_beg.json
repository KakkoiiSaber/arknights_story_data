        "type": "character",
        "name": "char_130_doberm_ex",
        "name2": "char_148_nearl_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"ニアール\"]  ああ。大方、「街中に溢れかえっている」とでもいうべき状況だろうな。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "ああ。大方、「街中に溢れかえっている」とでもいうべき状況だろうな。"
    },
