        "raw": "[Character(name=\"char_148_nearl_1#6\")]",
        "type": "character",
        "name": "char_148_nearl_1#6"
    },
    {
        "id": 45,
        "raw": "[name=\"ニアール\"]  てっきり私は、レユニオンについての分析だとばかり……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "てっきり私は、レユニオンについての分析だとばかり……"
    },
