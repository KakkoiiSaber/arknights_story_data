        "focus": 1
    },
    {
        "id": 51,
        "raw": "[name=\"アーミヤ\"]   （小声）フランカさん、まずは牽制をお願いします。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（小声）フランカさん、まずは牽制をお願いします。"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]   （小声）向こうが怯んだ隙に、下層階へ移動しましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（小声）向こうが怯んだ隙に、下層階へ移動しましょう。"
    },
    {
        "id": 53,
        "raw": "[name=\"アーミヤ\"]   （小声）もっと広い場所でないと、うまく立ち回れませんから……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（小声）もっと広い場所でないと、うまく立ち回れませんから……"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_106_franka_1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_106_franka_1",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"フランカ\"]   （小声）了解。ぶちかましてから走れってことね！",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "（小声）了解。ぶちかましてから走れってことね！"
    },
    {
