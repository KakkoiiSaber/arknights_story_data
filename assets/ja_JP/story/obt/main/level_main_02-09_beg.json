    {
        "id": 6,
        "raw": "[name=\"リスカム\"]   ッ――",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "ッ――"
    },
    {
        "id": 7,
        "raw": "[name=\"リスカム\"]   どうしてこんなに数が多いんだか……！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "どうしてこんなに数が多いんだか……！"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 9,
        "raw": "[name=\"レユニオン構成員\"]   ぐあっ……！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ぐあっ……！"
    },
    {
        "id": 10,
        "raw": "[Character(fadetime=0.2)]",
        "type": "character",
        "fadetime": 0.2
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 12,
        "raw": "[name=\"フランカ\"]   ……んー……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "……んー……"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"フランカ\"]   なーんか、いくら倒してもキリがないっていうか……どんどん増えてる気がするんだけど、気のせいかしら？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "なーんか、いくら倒してもキリがないっていうか……どんどん増えてる気がするんだけど、気のせいかしら？"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 16,
        "raw": "[name=\"レユニオン構成員\"]   う、っぐ……！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "う、っぐ……！"
    },
    {
        "id": 17,
        "raw": "[Character(fadetime=0.2)]",
        "type": "character",
        "fadetime": 0.2
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"リスカム\"]   気のせいじゃないよ。明らかにレユニオン側の増援が来てる。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "気のせいじゃないよ。明らかにレユニオン側の増援が来てる。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 21,
        "raw": "[name=\"アーミヤ\"]   っ……こちらは、反撃すらできていないのに……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "っ……こちらは、反撃すらできていないのに……！"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"リスカム\"]   ロドスに隙を与える気はない、ということでしょう。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "ロドスに隙を与える気はない、ということでしょう。"
    },
    {
        "id": 24,
        "raw": "[name=\"リスカム\"]   ――フランカ、気をつけて。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "――フランカ、気をつけて。"
    },
    {
        "id": 25,
        "raw": "[name=\"リスカム\"]   東側出口に、術師が隠れてる。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "東側出口に、術師が隠れてる。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"フランカ\"]   了解。……正面の道は、両側のビルに向こうさんのチンピラどもがわんさかいるわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "了解。……正面の道は、両側のビルに向こうさんのチンピラどもがわんさかいるわ。"
    },
    {
        "id": 28,
        "raw": "[name=\"フランカ\"]   こっちに気付かないフリをして、誘い込もうとしてるみたいね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "こっちに気付かないフリをして、誘い込もうとしてるみたいね。"
    },
    {
        "id": 29,
        "raw": "[name=\"フランカ\"]   だけど、お生憎様。ここは屋上なのよ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "だけど、お生憎様。ここは屋上なのよ。"
    },
    {
        "id": 30,
        "raw": "[name=\"フランカ\"]   この高さなら、どんなに大勢押し寄せてきても片っ端から落っことしちゃえばおしまいじゃない。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "この高さなら、どんなに大勢押し寄せてきても片っ端から落っことしちゃえばおしまいじゃない。"
    },
    {
        "id": 31,
        "raw": "[name=\"フランカ\"]   まったく……こんな場所であたしたちと戦おうとするなんて、随分馬鹿にしてくれたものね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "まったく……こんな場所であたしたちと戦おうとするなんて、随分馬鹿にしてくれたものね。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"アーミヤ\"]   ……もしかすると、総攻撃を仕掛けてくるつもりかもしれません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……もしかすると、総攻撃を仕掛けてくるつもりかもしれません。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"アーミヤ\"]   総員、隊列を立て直してください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "総員、隊列を立て直してください！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1#7\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"フランカ\"]   ！　待って。あれは――さっきのレユニオン幹部じゃない！",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "！　待って。あれは――さっきのレユニオン幹部じゃない！"
    },
    {
        "id": 38,
        "raw": "[name=\"フランカ\"]   やっぱり、あいつが部隊の指揮を執ってるみたいね……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "やっぱり、あいつが部隊の指揮を執ってるみたいね……"
