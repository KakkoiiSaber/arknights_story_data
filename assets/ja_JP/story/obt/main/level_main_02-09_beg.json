        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 57,
        "raw": "[name=\"アーミヤ\"]   ――彼女の所在など、あなたには関係ないはずです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――彼女の所在など、あなたには関係ないはずです。"
    },
