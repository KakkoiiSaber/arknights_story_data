    {
        "id": 59,
        "raw": "[name=\"スカルシュレッダー\"]    ……貴様……！",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "……貴様……！"
    },
    {
        "id": 60,
        "raw": "[name=\"スカルシュレッダー\"]    ……その物言い、後悔させてやる。",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "……その物言い、後悔させてやる。"
    },
    {
