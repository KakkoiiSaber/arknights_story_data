    },
    {
        "id": 53,
        "raw": "[name=\"ホシグマ\"]   では、出発はいつにいたしますか？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "では、出発はいつにいたしますか？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"チェン\"]   今だ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "今だ。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"ホシグマ\"]   了解です。小官のほうで準備をしつつ、近衛局の人員にも知らせてきましょう。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "了解です。小官のほうで準備をしつつ、近衛局の人員にも知らせてきましょう。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"チェン\"]   ああ、頼む。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ああ、頼む。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 61,
        "raw": "[name=\"チェン\"]   アーミヤ、あと10分で出るぞ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "アーミヤ、あと10分で出るぞ。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 63,
        "raw": "[name=\"アーミヤ\"]   了解しました。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "了解しました。"
    },
    {
