    },
    {
        "id": 46,
        "raw": "[name=\"「アスカロン」\"]まだ機は熟していない。戻ってほしい。",
        "type": "dialog",
        "speaker": "「アスカロン」",
        "content": "まだ機は熟していない。戻ってほしい。"
    },
    {
        "id": 47,
