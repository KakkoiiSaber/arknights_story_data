    {
        "id": 37,
        "raw": "[name=\"盾兵\"] その暗号……ウルサス軍か！？",
        "type": "dialog",
        "speaker": "盾兵",
        "content": "その暗号……ウルサス軍か！？"
    },
    {
        "id": 38,
        "raw": "[name=\"盾兵\"] クソが……！",
