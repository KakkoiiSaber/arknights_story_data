    {
        "id": 7,
        "raw": "[name=\"チェン\"]  ホシグマ？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ホシグマ？"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 9,
        "raw": "[name=\"ホシグマ\"]  はい。隊長。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "はい。隊長。"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"チェン\"]  顔色が悪いぞ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "顔色が悪いぞ。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"ホシグマ\"]  いえ、大丈夫です。少し考え事をしていました。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "いえ、大丈夫です。少し考え事をしていました。"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"チェン\"] ……奴を巻き込んだ結果がこう出るなんてな……。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……奴を巻き込んだ結果がこう出るなんてな……。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"ホシグマ\"]  仕方がありません。こういう生き方を選んだのですから。龍門の言葉でいうと、それが命運なのでしょう。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "仕方がありません。こういう生き方を選んだのですから。龍門の言葉でいうと、それが命運なのでしょう。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"チェン\"] 極東人もそんなものを信じるのか？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "極東人もそんなものを信じるのか？"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"ホシグマ\"]  これだけ多くのことを経験すれば、信じたくなかろうが認めざるを得ません。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "これだけ多くのことを経験すれば、信じたくなかろうが認めざるを得ません。"
    },
    {
        "id": 22,
        "raw": "[name=\"ホシグマ\"]  ファーが遺した情報はどうでしょうか？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "ファーが遺した情報はどうでしょうか？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"チェン\"] 正確なものだ。ここが記載されていた位置にあたる。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "正確なものだ。ここが記載されていた位置にあたる。"
    },
