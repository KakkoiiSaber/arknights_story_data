    {
        "id": 10,
        "raw": "[name=\"チェン\"]   ――",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――"
    },
    {
        "id": 11,
        "raw": "[name=\"チェン\"]   ……終わったぞ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……終わったぞ。"
    },
    {
        "id": 12,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 13,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 14,
        "raw": "[Image(image=\"bg_0_coma\", fadetime=1, screenadapt=\"coverall\")]",
        "type": "image",
        "image": "bg_0_coma.png",
        "fadetime": "1,",
        "screenadapt": "coverall"
    },
    {
        "id": 15,
        "raw": "[Delay(time=1.3)]",
        "type": "delay",
        "time": 1.3
    },
    {
        "id": 16,
        "raw": "[name=\"チェン\"]   本質的に、人の行動というものは予測しようがない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "本質的に、人の行動というものは予測しようがない。"
    },
    {
        "id": 17,
        "raw": "[name=\"チェン\"]   それが感染者であれば、なおのことだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "それが感染者であれば、なおのことだ。"
    },
    {
        "id": 18,
        "raw": "[name=\"チェン\"]   ――力は人を狂わせ、欲望は人を堕落させる。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――力は人を狂わせ、欲望は人を堕落させる。"
    },
    {
        "id": 19,
        "raw": "[name=\"チェン\"]   さながらガンのように、少しずつ、美しいすべてを食い潰していく……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "さながらガンのように、少しずつ、美しいすべてを食い潰していく……"
    },
    {
        "id": 20,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 21,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 22,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 23,
        "raw": "[name=\"チェン\"]   ……そのマスクは、キミにとって意味のない物だ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……そのマスクは、キミにとって意味のない物だ。"
    },
    {
        "id": 24,
        "raw": "[name=\"アーミヤ\"]   ですが……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ですが……"
    },
    {
        "id": 25,
        "raw": "[Background(screenadapt=\"coverall\", image=\"bg_wild_a\", width=1, height=1, fadetime=2, block=false)]",
        "type": "background",
        "screenadapt": "coverall",
        "image": "bg_wild_a.png",
        "width": "1,",
        "height": "1,",
        "fadetime": "2,",
        "block": false
    },
    {
        "id": 26,
        "raw": "[name=\"チェン\"]   とはいえ、持ち帰りたいのならそうしてもいい。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "とはいえ、持ち帰りたいのならそうしてもいい。"
    },
    {
        "id": 27,
        "raw": "[name=\"チェン\"]   だが、それを続けていくうちに……キミの部屋は、そうした物で埋め尽くされることだろう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "だが、それを続けていくうちに……キミの部屋は、そうした物で埋め尽くされることだろう。"
    },
    {
        "id": 28,
        "raw": "[name=\"チェン\"]   ――感染者であろうと、そうでなかろうと……人は皆、自らの選択がもたらす結果を背負わねばならないんだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――感染者であろうと、そうでなかろうと……人は皆、自らの選択がもたらす結果を背負わねばならないんだ。"
    },
    {
        "id": 29,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 30,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=1.6, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "1.6,",
        "block": true
    },
    {
        "id": 31,
        "raw": "[Image(fadetime=0)]",
        "type": "image",
        "fadetime": 0
    },
    {
        "id": 32,
        "raw": "[Blocker(a=0, fadetime=1.6, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "1.6,",
        "block": true
    },
    {
        "id": 33,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"アーミヤ\"]   ――――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――――"
    },
    {
        "id": 36,
        "raw": "[name=\"アーミヤ\"]   ――ごめんなさい……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――ごめんなさい……"
    },
    {
        "id": 37,
        "raw": "[name=\"アーミヤ\"]   チェンさん……私……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "チェンさん……私……"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"チェン\"]   ……いいか、アーミヤ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……いいか、アーミヤ。"
    },
    {
        "id": 40,
        "raw": "[name=\"チェン\"]   レユニオンの連中が、キミの言葉に耳を貸すのなら、その時は助けてやるといい。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "レユニオンの連中が、キミの言葉に耳を貸すのなら、その時は助けてやるといい。"
    },
    {
        "id": 41,
        "raw": "[name=\"チェン\"]   だが、奴らが聞く耳を持たず、狂気の沙汰へと身を投じたら……ためらう必要はない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "だが、奴らが聞く耳を持たず、狂気の沙汰へと身を投じたら……ためらう必要はない。"
    },
    {
        "id": 42,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 43,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 44,
        "raw": "[name=\"チェン\"]   ――――",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――――"
    },
    {
        "id": 45,
        "raw": "[name=\"チェン\"]   彼女は、悪事を為したわけではなかった。ゆえに、この結果は、罪への罰として下されたものではない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "彼女は、悪事を為したわけではなかった。ゆえに、この結果は、罪への罰として下されたものではない。"
    },
    {
        "id": 46,
        "raw": "[name=\"チェン\"]   単に、彼女自身がこうなることを選んだだけだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "単に、彼女自身がこうなることを選んだだけだ。"
    },
    {
        "id": 47,
        "raw": "[name=\"チェン\"]   誰一人、それを止められはしないし、責められもしない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "誰一人、それを止められはしないし、責められもしない。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"アーミヤ\"]   ……でも……私には、わからないんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……でも……私には、わからないんです。"
    },
    {
        "id": 50,
        "raw": "[name=\"アーミヤ\"]   これまでずっと、私たちには、救うべきすべての人を助ける責任があると思っていました。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "これまでずっと、私たちには、救うべきすべての人を助ける責任があると思っていました。"
    },
    {
        "id": 51,
        "raw": "[name=\"アーミヤ\"]   なのに……どうして、こんなことに？　……なぜ、彼女一人にこの結末を背負わせなければならなかったんでしょう……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "なのに……どうして、こんなことに？　……なぜ、彼女一人にこの結末を背負わせなければならなかったんでしょう……"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]   ロドスのしていることは、本当に正しいことなんでしょうか……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ロドスのしていることは、本当に正しいことなんでしょうか……？"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 55,
        "raw": "[name=\"チェン\"]   鉱石病に感染したその日から――彼らの運命はもはや、人の手に負えるものではなくなってしまった。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "鉱石病に感染したその日から――彼らの運命はもはや、人の手に負えるものではなくなってしまった。"
    },
    {
        "id": 56,
        "raw": "[name=\"チェン\"]   ロドスの見解では、道を踏み外した人々にも、救える余地があるのかもしれないが――",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ロドスの見解では、道を踏み外した人々にも、救える余地があるのかもしれないが――"
    },
    {
        "id": 57,
        "raw": "[name=\"チェン\"]   私と近衛局からすれば、そうは思えない。だから、必要に迫られた場合には……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "私と近衛局からすれば、そうは思えない。だから、必要に迫られた場合には……"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"アーミヤ\"]   …………",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "…………"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   私はただ、終わりの見えないこの状況を変えていきたいだけなんです……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私はただ、終わりの見えないこの状況を変えていきたいだけなんです……"
    },
    {
        "id": 61,
        "raw": "[name=\"アーミヤ\"]   それがたとえ、ほんの少しの変化だとしても――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "それがたとえ、ほんの少しの変化だとしても――"
    },
    {
        "id": 62,
        "raw": "[name=\"アーミヤ\"]   ですが……何をしたところで、こんな結末にしかならないのなら……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ですが……何をしたところで、こんな結末にしかならないのなら……"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 65,
        "raw": "[name=\"チェン\"]   ――アーミヤ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――アーミヤ。"
    },
    {
        "id": 66,
        "raw": "[name=\"チェン\"]   気持ちに、揺らぎがあるのか？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "気持ちに、揺らぎがあるのか？"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 69,
        "raw": "[name=\"アーミヤ\"]   ……わかりません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……わかりません。"
    },
    {
        "id": 70,
        "raw": "[name=\"アーミヤ\"]   ――今の感染者たちは、敵意に溺れるか、自ら破滅へ向かっていくばかりで……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――今の感染者たちは、敵意に溺れるか、自ら破滅へ向かっていくばかりで……"
    },
    {
        "id": 71,
        "raw": "[name=\"アーミヤ\"]   次々と悲劇が繰り返されているのが現状です。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "次々と悲劇が繰り返されているのが現状です。"
    },
    {
        "id": 72,
        "raw": "[name=\"アーミヤ\"]   けれど、その連鎖の中でも、感染者に希望を与える方法が――鉱石病の根絶以外にも、あるはずだと思います。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "けれど、その連鎖の中でも、感染者に希望を与える方法が――鉱石病の根絶以外にも、あるはずだと思います。"
    },
    {
        "id": 73,
        "raw": "[name=\"アーミヤ\"]   ……そして、その方法というのが、人々の間の憎しみを取り除いていくことなんだと思うんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……そして、その方法というのが、人々の間の憎しみを取り除いていくことなんだと思うんです。"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"チェン\"]   ……アーミヤ、よく聞け。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……アーミヤ、よく聞け。"
    },
    {
        "id": 76,
        "raw": "[name=\"チェン\"]   慈悲を与えようとするならば、その代償を払うことになるものだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "慈悲を与えようとするならば、その代償を払うことになるものだ。"
    },
    {
        "id": 77,
        "raw": "[name=\"チェン\"]   ――ロドスは近衛局のような組織にはなれないし、近衛局のようなやり方もできんだろう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――ロドスは近衛局のような組織にはなれないし、近衛局のようなやり方もできんだろう。"
    },
    {
        "id": 78,
        "raw": "[name=\"チェン\"]   だが、キミたちは進んで感染者を受け入れ、そして無謀なことに、事を荒立てず人々を救おうとさえしている。――それは、ロドスにしかできないことだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "だが、キミたちは進んで感染者を受け入れ、そして無謀なことに、事を荒立てず人々を救おうとさえしている。――それは、ロドスにしかできないことだ。"
    },
    {
        "id": 79,
        "raw": "[name=\"チェン\"]   あるいは、ロドスだけが試みていること、と言ってもいいかもしれない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "あるいは、ロドスだけが試みていること、と言ってもいいかもしれない。"
    },
    {
        "id": 80,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 81,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 82,
        "raw": "[name=\"チェン\"]   しかし、私には、そんなことはできん。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "しかし、私には、そんなことはできん。"
    },
    {
        "id": 83,
        "raw": "[name=\"チェン\"]   無論、近衛局もそれは同じことだ。",
        "type": "dialog",
        "speaker": "チェン",
