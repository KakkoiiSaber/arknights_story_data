    {
        "id": 9,
        "raw": "[Background(screenadapt=\"coverall\", image=\"bg_cher_3\", width=1, height=1, fadetime=1)]",
        "type": "background",
        "screenadapt": "coverall",
        "image": "bg_cher_3.png",
        "width": "1,",
        "height": "1,",
        "fadetime": 1
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_219_meteo_1#1\")]",
        "type": "character",
        "name": "char_219_meteo_1#1"
    },
    {
        "id": 11,
        "raw": "[name=\"メテオリーテ\"]   ……目標地点に到着。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……目標地点に到着。"
    },
    {
        "id": 12,
        "raw": "[name=\"メテオリーテ\"]   今のところ、異常なしよ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "今のところ、異常なしよ。"
    },
    {
        "id": 13,
        "raw": "[name=\"メテオリーテ\"]   ……これで報告はおしまい、と……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……これで報告はおしまい、と……"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_219_meteo_1\")]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 15,
        "raw": "[name=\"メテオリーテ\"]   フロストリーフ？　さっきから難しい顔をしてるけど……どうかしたの？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "フロストリーフ？　さっきから難しい顔をしてるけど……どうかしたの？"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 17,
        "raw": "[name=\"フロストリーフ\"]   いいや。単に、アーミヤたちの状況が少し気になっただけだ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "いいや。単に、アーミヤたちの状況が少し気になっただけだ。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_219_meteo_1\" )]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 19,
        "raw": "[name=\"メテオリーテ\"]   あの子たちなら、無事にロドスへ戻ったって聞いてるわよ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "あの子たちなら、無事にロドスへ戻ったって聞いてるわよ。"
    },
    {
        "id": 20,
        "raw": "[name=\"メテオリーテ\"]   だけど、ニアールとドーベルマンのほうは、一週間前に、龍門以外のエリアへ向かったみたい。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "だけど、ニアールとドーベルマンのほうは、一週間前に、龍門以外のエリアへ向かったみたい。"
    },
    {
        "id": 21,
        "raw": "[name=\"メテオリーテ\"]   わざわざあの二人を送り出すなんて、よほど大変な任務なんでしょうね。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "わざわざあの二人を送り出すなんて、よほど大変な任務なんでしょうね。"
    },
    {
        "id": 22,
        "raw": "[name=\"メテオリーテ\"]   BSWとペンギン急便にも、それぞれ仕事があるみたいだし、頼ってばかりもいられないのが困りものだけど。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "BSWとペンギン急便にも、それぞれ仕事があるみたいだし、頼ってばかりもいられないのが困りものだけど。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_259_Jessica_1\")]",
        "type": "character",
        "name": "char_259_Jessica_1"
    },
    {
        "id": 24,
        "raw": "[name=\"ジェシカ\"]   BSW……あっ、リスカム先輩とフランカ先輩のことですね。",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "BSW……あっ、リスカム先輩とフランカ先輩のことですね。"
    },
    {
        "id": 25,
        "raw": "[name=\"ジェシカ\"]   お二人なら、大丈夫だとは思いますが……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "お二人なら、大丈夫だとは思いますが……"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"メテオリーテ\"]   そうね。とはいえ、あなたも頑張りどころよ？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "そうね。とはいえ、あなたも頑張りどころよ？"
    },
    {
        "id": 28,
        "raw": "[name=\"メテオリーテ\"]   あなたを預けていった時、そのフランカが言ってたんだもの。あなたのことを高く買ってる、ってね。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "あなたを預けていった時、そのフランカが言ってたんだもの。あなたのことを高く買ってる、ってね。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"ジェシカ\"]   えっ？　ほ……本当ですか？",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "えっ？　ほ……本当ですか？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"メテオリーテ\"]   ええ――ただし、臆病なところを克服すれば、とも言ってたけど。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "ええ――ただし、臆病なところを克服すれば、とも言ってたけど。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#4",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"ジェシカ\"]   う、ぅ……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "う、ぅ……"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1#4",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"メテオリーテ\"]   ……ちょっと、急に泣き出さないの。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……ちょっと、急に泣き出さないの。"
    },
    {
        "id": 37,
        "raw": "[name=\"メテオリーテ\"]   あなただって、BSWの一員でしょう？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "あなただって、BSWの一員でしょう？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_259_Jessica_1#5\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#5",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"ジェシカ\"]   な、泣いてません……泣いてません、から……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "な、泣いてません……泣いてません、から……"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_219_meteo_1\")]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 41,
        "raw": "[name=\"メテオリーテ\"]   ……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……"
    },
    {
        "id": 42,
        "raw": "[name=\"メテオリーテ\"]   ……いいわ。とにかく、任務を続行しましょうか。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……いいわ。とにかく、任務を続行しましょうか。"
    },
    {
        "id": 43,
        "raw": "[name=\"メテオリーテ\"]   次は、各地点の偵察隊と合流して、廃都市内の調査を行うわよ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "次は、各地点の偵察隊と合流して、廃都市内の調査を行うわよ。"
    },
    {
        "id": 44,
        "raw": "[name=\"メテオリーテ\"]   これは主に生存者の捜索と救助活動、それから状況確認を目的とした任務ね。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "これは主に生存者の捜索と救助活動、それから状況確認を目的とした任務ね。"
    },
    {
        "id": 45,
        "raw": "[name=\"メテオリーテ\"]   特別危険な仕事というわけではないけれど、注意は怠らないようにしてちょうだい。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "特別危険な仕事というわけではないけれど、注意は怠らないようにしてちょうだい。"
    },
    {
        "id": 46,
        "raw": "[name=\"メテオリーテ\"]   もし、感染者関係の問題を確認した場合には、迅速に対処していきましょう。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "もし、感染者関係の問題を確認した場合には、迅速に対処していきましょう。"
    },
    {
        "id": 47,
        "raw": "[name=\"メテオリーテ\"]   でも、万一それがレユニオン関係の問題だった場合には、ケルシー先生に報告した上ですぐに撤退すること。わかった？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "でも、万一それがレユニオン関係の問題だった場合には、ケルシー先生に報告した上ですぐに撤退すること。わかった？"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_259_Jessica_1\")]",
        "type": "character",
        "name": "char_259_Jessica_1"
    },
    {
        "id": 49,
        "raw": "[name=\"ジェシカ\"]   は、はい。",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "は、はい。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 51,
        "raw": "[name=\"フロストリーフ\"]   了解。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "了解。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_219_meteo_1\")]",
        "type": "character",
        "name": "char_219_meteo_1"
    },
    {
        "id": 53,
        "raw": "[name=\"メテオリーテ\"]   よろしい。……それじゃ、早速仕事にかかりましょうか。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "よろしい。……それじゃ、早速仕事にかかりましょうか。"
    },
