        "focus": 2
    },
    {
        "id": 97,
        "raw": "[name=\"アーミヤ\"]   ですが、ロドスにはまだ対処すべきことがたくさん残っていますし……",
        "type": "dialog",
        "speaker": "アーミヤ",
