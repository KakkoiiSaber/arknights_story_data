        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 104,
        "raw": "[name=\"アーミヤ\"]   そんな……私なんて、見守ってもらってばかりですし。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そんな……私なんて、見守ってもらってばかりですし。"
