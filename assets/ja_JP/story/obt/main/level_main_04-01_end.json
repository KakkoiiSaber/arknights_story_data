        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"フランカ\"]   どんなに強い信念があっても、ずっと頑張り続けていると、そのうち身体を壊しちゃうわよ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "どんなに強い信念があっても、ずっと頑張り続けていると、そのうち身体を壊しちゃうわよ。"
    },
    {
        "id": 102,
        "raw": "[name=\"フランカ\"]   皆あなたを頼りにしてるんだから、元気でいてくれなくちゃね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "皆あなたを頼りにしてるんだから、元気でいてくれなくちゃね。"
