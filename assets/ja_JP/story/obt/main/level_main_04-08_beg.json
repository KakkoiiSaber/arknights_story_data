    {
        "id": 133,
        "raw": "[name=\"アーミヤ\"]   ……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……？"
    },
    {
        "id": 134,
        "raw": "[name=\"アーミヤ\"]   広場に何か、置かれているような……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "広場に何か、置かれているような……"
    },
    {
        "id": 135,
        "raw": "[name=\"アーミヤ\"]   彫刻……でしょうか？　変わった見た目ですね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "彫刻……でしょうか？　変わった見た目ですね……"
    },
    {
        "id": 136,
        "raw": "[name=\"アーミヤ\"]   それに、嫌なにおいもしますし……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "それに、嫌なにおいもしますし……"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"フロストリーフ\"]   ……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……"
    },
    {
        "id": 139,
        "raw": "[name=\"フロストリーフ\"]   あまり見ない方がいい。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "あまり見ない方がいい。"
    },
    {
        "id": 140,
        "raw": "[name=\"フロストリーフ\"]   それより、私のそばを離れるなよ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "それより、私のそばを離れるなよ。"
    },
    {
        "id": 141,
        "raw": "[name=\"フロストリーフ\"]   ――レユニオンの姿があるな……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "――レユニオンの姿があるな……"
    },
    {
        "id": 142,
        "raw": "[name=\"フロストリーフ\"]   ここは、音を立てずに片付けるとしよう。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "ここは、音を立てずに片付けるとしよう。"
