        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 94,
        "raw": "[name=\"フロストリーフ\"]   ……よし、やり過ごせたようだ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……よし、やり過ごせたようだ。"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 96,
        "raw": "[name=\"アーミヤ\"]   まさか、メフィストもここへ来ていたなんて……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "まさか、メフィストもここへ来ていたなんて……"
    },
    {
        "id": 97,
        "raw": "[name=\"アーミヤ\"]   いえ、とにかくまずは、メテオリーテさんたちに連絡を――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "いえ、とにかくまずは、メテオリーテさんたちに連絡を――"
    },
    {
        "id": 98,
        "raw": "[name=\"アーミヤ\"]   ……あれ？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……あれ？"
    },
    {
        "id": 99,
        "raw": "[name=\"アーミヤ\"]   汚染された区域は抜けたはずなのに……どうして、通信できないんでしょうか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "汚染された区域は抜けたはずなのに……どうして、通信できないんでしょうか？"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 101,
        "raw": "[name=\"フロストリーフ\"]   ……はぁ……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……はぁ……"
    },
    {
        "id": 102,
        "raw": "[name=\"フロストリーフ\"]   これを見ろ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "これを見ろ。"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 104,
        "raw": "[name=\"アーミヤ\"]   通信機……？　フロストリーフさんのですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "通信機……？　フロストリーフさんのですか？"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#6.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"アーミヤ\"]   ……！　凍ってる……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……！　凍ってる……！"
    },
    {
        "id": 107,
        "raw": "[name=\"アーミヤ\"]   一体、何が起きたんですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "一体、何が起きたんですか？"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#6.png",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"フロストリーフ\"]   さっきいたメフィストは、あくまでオマケみたいなものだ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "さっきいたメフィストは、あくまでオマケみたいなものだ。"
    },
    {
        "id": 110,
        "raw": "[name=\"フロストリーフ\"]   というのも、この廃都市には……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "というのも、この廃都市には……"
    },
    {
        "id": 111,
        "raw": "[name=\"フロストリーフ\"]   奴よりもよほど恐ろしい連中がうろついているからな。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "奴よりもよほど恐ろしい連中がうろついているからな。"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 113,
        "raw": "[name=\"アーミヤ\"]   恐ろしい連中、というのは？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "恐ろしい連中、というのは？"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"フロストリーフ\"]   スノーデビルだ。奴らに出くわせば、マズいことになる。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "スノーデビルだ。奴らに出くわせば、マズいことになる。"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"アーミヤ\"]   スノーデビル、というと……スノーデビル小隊のことですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "スノーデビル、というと……スノーデビル小隊のことですか？"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 119,
        "raw": "[name=\"フロストリーフ\"]   恐らくな。現状、推測でしかないが。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "恐らくな。現状、推測でしかないが。"
    },
    {
        "id": 120,
        "raw": "[name=\"フロストリーフ\"]   だが、辺り一帯の温度が低下していることや、会敵した各部隊の状況を鑑みると……奴らの仕業としか思えない。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "だが、辺り一帯の温度が低下していることや、会敵した各部隊の状況を鑑みると……奴らの仕業としか思えない。"
    },
    {
        "id": 121,
        "raw": "[name=\"フロストリーフ\"]   レユニオンの連中が、この廃都市に自らの領土を築き始めているということだろうな。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "レユニオンの連中が、この廃都市に自らの領土を築き始めているということだろうな。"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_193_frostl_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_193_frostl_1",
        "focus": 1
    },
    {
        "id": 123,
        "raw": "[name=\"アーミヤ\"]   ――そろそろ、暗くなってきましたね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――そろそろ、暗くなってきましたね……"
    },
    {
        "id": 124,
        "raw": "[name=\"アーミヤ\"]   今のうちに、移動しましょうか。この開けた道も、気付かれずに通り抜けられそうですし。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "今のうちに、移動しましょうか。この開けた道も、気付かれずに通り抜けられそうですし。"
    },
    {
        "id": 125,
        "raw": "[name=\"アーミヤ\"]   とにかく、まずはメテオリーテさんたちを助けに行かなくては。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "とにかく、まずはメテオリーテさんたちを助けに行かなくては。"
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 127,
        "raw": "[name=\"フロストリーフ\"]   わかった。付いてこい。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "わかった。付いてこい。"
    },
