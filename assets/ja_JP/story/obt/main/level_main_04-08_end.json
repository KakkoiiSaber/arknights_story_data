    {
        "id": 9,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 10,
        "raw": "[Blocker(a=0, fadetime=0.2, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.2,",
        "block": true
    },
    {
        "id": 11,
        "raw": "[name=\"フロストリーフ\"]   撃つな、私だ。……そこにいるんだろう。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "撃つな、私だ。……そこにいるんだろう。"
    },
    {
        "id": 12,
        "raw": "[name=\"フロストリーフ\"]   援軍を連れてきたぞ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "援軍を連れてきたぞ。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 14,
        "raw": "[name=\"アーミヤ\"]   メテオリーテさん、私です！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "メテオリーテさん、私です！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_219_meteo_1#4\")]",
        "type": "character",
        "name": "char_219_meteo_1#4"
    },
    {
        "id": 16,
        "raw": "[name=\"メテオリーテ\"]   誰？　待って……まさか、アーミヤ！？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "誰？　待って……まさか、アーミヤ！？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_219_meteo_1#5\")]",
        "type": "character",
        "name": "char_219_meteo_1#5"
    },
    {
        "id": 18,
        "raw": "[name=\"メテオリーテ\"]   あなたが来てくれるなんて……！",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "あなたが来てくれるなんて……！"
    },
    {
        "id": 19,
        "raw": "[name=\"メテオリーテ\"]   すごく嬉しいし、心強いわ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "すごく嬉しいし、心強いわ。"
    },
    {
        "id": 20,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 21,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=0.2, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.2,",
        "block": true
    },
    {
        "id": 22,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 23,
        "raw": "[Blocker(a=0, fadetime=0.2, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.2,",
        "block": true
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"メテオリーテ\"]   ――だけど……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "――だけど……"
    },
    {
        "id": 26,
        "raw": "[name=\"メテオリーテ\"]   あなたは来るべきじゃなかった。これは向こうの罠なのよ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "あなたは来るべきじゃなかった。これは向こうの罠なのよ。"
    },
    {
        "id": 27,
        "raw": "[name=\"メテオリーテ\"]   私たちを助けるためにあなたを危険にさらすのは、リスクが高すぎるわ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "私たちを助けるためにあなたを危険にさらすのは、リスクが高すぎるわ。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#3\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#3",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"メテオリーテ\"]   これは、判断としては間違いよ……！",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "これは、判断としては間違いよ……！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 31,
        "raw": "[name=\"フロストリーフ\"]   だが、どう見てもお前たちは逃げ切れそうにない状況だった。……この子がそれを知っていて、見捨てるわけがないだろう。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "だが、どう見てもお前たちは逃げ切れそうにない状況だった。……この子がそれを知っていて、見捨てるわけがないだろう。"
    },
    {
        "id": 32,
        "raw": "[name=\"フロストリーフ\"]   だから、今更アーミヤを責めても仕方がない。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "だから、今更アーミヤを責めても仕方がない。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"メテオリーテ\"]   責めてなんかないわ。ただ……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "責めてなんかないわ。ただ……"
    },
    {
        "id": 35,
        "raw": "[name=\"メテオリーテ\"]   ……ううん、やめておきましょう。……ごめんなさい、アーミヤ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……ううん、やめておきましょう。……ごめんなさい、アーミヤ。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"アーミヤ\"]   お気になさらず。お二人が無事で、本当に良かったです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "お気になさらず。お二人が無事で、本当に良かったです。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"メテオリーテ\"]   ……ありがとう。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……ありがとう。"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"アーミヤ\"]   ……ところで、ジェシカさんの様子が気になるんですが……彼女に何があったんでしょうか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ところで、ジェシカさんの様子が気になるんですが……彼女に何があったんでしょうか？"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_259_Jessica_1#5\")]",
        "type": "character",
        "name": "char_259_Jessica_1#5"
    },
    {
        "id": 43,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 44,
        "raw": "[name=\"ジェシカ\"]   うぅ……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "うぅ……"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"メテオリーテ\"]   それが……ちょっと、ショックで気が動転しちゃってるのよね。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "それが……ちょっと、ショックで気が動転しちゃってるのよね。"
    },
    {
        "id": 47,
        "raw": "[name=\"メテオリーテ\"]   本当は、自力で動けるようになるまで待とうと思ってたんだけど……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "本当は、自力で動けるようになるまで待とうと思ってたんだけど……"
    },
    {
        "id": 48,
        "raw": "[name=\"メテオリーテ\"]   この様子を見るに、精神的な傷が残ってる可能性もあるだろうし……",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "この様子を見るに、精神的な傷が残ってる可能性もあるだろうし……"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_259_Jessica_1#5\")]",
        "type": "character",
        "name": "char_259_Jessica_1#5"
    },
    {
        "id": 50,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 51,
        "raw": "[name=\"ジェシカ\"]   ……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "……"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 53,
        "raw": "[name=\"アーミヤ\"]   ……ジェシカさん、大丈夫ですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ジェシカさん、大丈夫ですか？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_259_Jessica_1#5\")]",
        "type": "character",
        "name": "char_259_Jessica_1#5"
    },
    {
        "id": 55,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 56,
        "raw": "[name=\"ジェシカ\"]   ……",
        "type": "dialog",
        "speaker": "ジェシカ",
        "content": "……"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 58,
        "raw": "[name=\"アーミヤ\"]   こうなったら……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "こうなったら……"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   フロストリーフさん、お願いがあります。ジェシカさんの手を私の腕に乗せて、握らせるように押さえておいてもらえませんか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "フロストリーフさん、お願いがあります。ジェシカさんの手を私の腕に乗せて、握らせるように押さえておいてもらえませんか。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 62,
        "raw": "[name=\"フロストリーフ\"]   ……わかった。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……わかった。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 64,
        "raw": "[name=\"アーミヤ\"]   ありがとうございます。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ありがとうございます。"
    },
