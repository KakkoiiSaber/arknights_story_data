        "type": "dialog_marker",
        "fadetime": 2
    },
    {
        "id": 13,
        "raw": "[Delay(time=2)]",
        "type": "delay",
        "time": 2
    },
    {
        "id": 14,
        "raw": "[name=\"？？？\"]  ——あの老公爵が彼女をさらった時、お前が何をしたか、覚えているか？——",
        "type": "dialog",
        "speaker": "？？？",
        "content": "——あの老公爵が彼女をさらった時、お前が何をしたか、覚えているか？——"
    },
    {
        "id": 15,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 16,
        "raw": "[name=\"？？？\"]  ——お前は龍門のためにできることなら、本当にどんなことだってしてみせるのだろう？——",
        "type": "dialog",
        "speaker": "？？？",
        "content": "——お前は龍門のためにできることなら、本当にどんなことだってしてみせるのだろう？——"
    },
    {
        "id": 17,
        "raw": "[name=\"？？？\"]  ——ウェイ……そしてお前は、いま誰を……何を犠牲にしようというのだ？——",
        "type": "dialog",
        "speaker": "？？？",
        "content": "——ウェイ……そしてお前は、いま誰を……何を犠牲にしようというのだ？——"
    },
