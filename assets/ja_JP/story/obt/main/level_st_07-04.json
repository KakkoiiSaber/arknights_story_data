    {
        "id": 59,
        "raw": "[name=\"タルラ\"]  あの子が来た。",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "あの子が来た。"
    },
    {
        "id": 60,
        "raw": "[name=\"タルラ\"]  やっと、あの子が来た。",
        "type": "dialog",
