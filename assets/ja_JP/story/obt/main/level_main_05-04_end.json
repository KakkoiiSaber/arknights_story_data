        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 86,
        "raw": "[name=\"ホシグマ\"]  ……。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "……。"
    },
    {
        "id": 87,
        "raw": "[name=\"ホシグマ\"]  何か思いにふけっているようですね……。過去の記憶でも蘇ったんでしょうか…。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "何か思いにふけっているようですね……。過去の記憶でも蘇ったんでしょうか…。"
    },
