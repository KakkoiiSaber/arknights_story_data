    {
        "id": 6,
        "raw": "[name=\"ホシグマ\"]  レユニオンは全員捕縛しました。ただ誰も具体的な命令は知らないようですが、奴らが口にしたのは――",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "レユニオンは全員捕縛しました。ただ誰も具体的な命令は知らないようですが、奴らが口にしたのは――"
    },
    {
        "id": 7,
        "raw": "[name=\"ホシグマ\"]  ……。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "……。"
    },
    {
        "id": 8,
        "raw": "[name=\"ホシグマ\"]  チェン隊長？　何を熱心に見てらっしゃるんですか。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "チェン隊長？　何を熱心に見てらっしゃるんですか。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"チェン\"]  ここは「大学通り」と呼ばれていた場所だったな？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ここは「大学通り」と呼ばれていた場所だったな？"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"ホシグマ\"]  え？　そうですよ。今は名前が変わりましたが。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "え？　そうですよ。今は名前が変わりましたが。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"チェン\"]  ……これは私の家のようだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……これは私の家のようだ。"
    },
