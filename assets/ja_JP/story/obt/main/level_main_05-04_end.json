    {
        "id": 145,
        "raw": "[name=\"ホシグマ\"]  ああ、やっと出てきましたね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "ああ、やっと出てきましたね。"
    },
    {
        "id": 146,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 147,
        "raw": "[name=\"チェン\"]  行くぞ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "行くぞ。"
    },
    {
        "id": 148,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 149,
        "raw": "[name=\"ホシグマ\"]  手がかりはもう見つかりましたか？　まだ遊び足りないなら、童心に帰って毛糸玉でお手玉でもしますか？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "手がかりはもう見つかりましたか？　まだ遊び足りないなら、童心に帰って毛糸玉でお手玉でもしますか？"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 151,
        "raw": "[name=\"チェン\"]  こんな時に冗談を言うとはどうした？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "こんな時に冗談を言うとはどうした？"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 153,
        "raw": "[name=\"ホシグマ\"]  さっきよりは元気になったように見えましたので。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "さっきよりは元気になったように見えましたので。"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 155,
        "raw": "[name=\"チェン\"]  お前が言った通り、糸口が見つかった……のかもな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "お前が言った通り、糸口が見つかった……のかもな。"
    },
    {
        "id": 156,
