        "name": "char_107_liskam_1.png"
    },
    {
        "id": 6,
        "raw": "[name=\"リスカム\"]   ……？",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "……？"
    },
    {
        "id": 7,
        "raw": "[name=\"リスカム\"]   どういうこと……？",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "どういうこと……？"
    },
    {
        "id": 8,
        "raw": "[name=\"リスカム\"]   小隊を一つ潰しただけなのに……",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "小隊を一つ潰しただけなのに……"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 10,
        "raw": "[name=\"フランカ\"]   って言っても、でっかいのはきっちり倒したじゃない。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "って言っても、でっかいのはきっちり倒したじゃない。"
    },
    {
        "id": 11,
        "raw": "[name=\"フランカ\"]   これで終わりって言ってくれないかしら。あれの相手で疲れてるんだけど。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "これで終わりって言ってくれないかしら。あれの相手で疲れてるんだけど。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 13,
        "raw": "[name=\"ホシグマ\"]   そうはいかないでしょうね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "そうはいかないでしょうね。"
    },
    {
        "id": 14,
        "raw": "[name=\"ホシグマ\"]   あんなにも多くの感染者たちが、跡形もなくどこかへ消えるとは思えません。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "あんなにも多くの感染者たちが、跡形もなくどこかへ消えるとは思えません。"
    },
    {
        "id": 15,
        "raw": "[name=\"ホシグマ\"]   それに、先ほどの大柄な相手も、単なる囮と考えるには奇妙です。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "それに、先ほどの大柄な相手も、単なる囮と考えるには奇妙です。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6.png"
    },
    {
        "id": 17,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 18,
        "raw": "[name=\"アーミヤ\"]   そもそも、この短時間で離脱なんてできるものでしょうか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そもそも、この短時間で離脱なんてできるものでしょうか？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 20,
        "raw": "[name=\"アーミヤ\"]   退路は近衛局が塞いでいるはずですし……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "退路は近衛局が塞いでいるはずですし……"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"フランカ\"]   ここ……何かおかしいとは思うんだけど。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ここ……何かおかしいとは思うんだけど。"
    },
    {
        "id": 23,
        "raw": "[name=\"フランカ\"]   手がかりは一つも見当たらないのよね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "手がかりは一つも見当たらないのよね。"
    },
    {
        "id": 24,
        "raw": "[name=\"フランカ\"]   草地に廃墟、それから砂丘……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "草地に廃墟、それから砂丘……"
    },
    {
        "id": 25,
        "raw": "[name=\"フランカ\"]   待ち伏せするにはぴったりの場所なのに。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "待ち伏せするにはぴったりの場所なのに。"
    },
    {
        "id": 26,
        "raw": "[name=\"フランカ\"]   新しい足跡どころか、衣服が草に擦れる音や、火薬の匂いすらも……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "新しい足跡どころか、衣服が草に擦れる音や、火薬の匂いすらも……"
    },
    {
        "id": 27,
        "raw": "[name=\"フランカ\"]   何一つないだなんて。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "何一つないだなんて。"
    },
    {
        "id": 28,
        "raw": "[name=\"フランカ\"]   あ～あ。わけわかんないわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あ～あ。わけわかんないわ。"
    },
    {
        "id": 29,
        "raw": "[name=\"フランカ\"]   ねえ、ペンギン急便のお二人さんで何とかしてくれない？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ねえ、ペンギン急便のお二人さんで何とかしてくれない？"
    },
    {
        "id": 30,
        "raw": "[name=\"フランカ\"]   だって、こんな状況、超不自然だし――",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "だって、こんな状況、超不自然だし――"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 32,
        "raw": "[Background(fadetime=1)]",
        "type": "background",
        "fadetime": 1
    },
    {
        "id": 33,
        "raw": "[name=\"ホシグマ\"]   ――静かに。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "――静かに。"
    },
    {
        "id": 34,
        "raw": "[name=\"ホシグマ\"]   何か聞こえます。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "何か聞こえます。"
    },
