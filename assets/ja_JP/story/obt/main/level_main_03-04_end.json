        "name": "char_103_angel_1.png"
    },
    {
        "id": 37,
        "raw": "[name=\"エクシア\"]   何か、って――ん？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "何か、って――ん？"
    },
    {
        "id": 38,
        "raw": "[name=\"エクシア\"]   ひょっとして……地面の下から聞こえてる！？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "ひょっとして……地面の下から聞こえてる！？"
    },
    {
        "id": 39,
        "raw": "[name=\"エクシア\"]   ――アーミヤ！　相手は下だ！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "――アーミヤ！　相手は下だ！"
