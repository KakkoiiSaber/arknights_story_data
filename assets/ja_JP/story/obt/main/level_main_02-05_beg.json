        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 75,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 76,
        "raw": "[Blocker(a=0, initr=2, r=0, g=0, b=0, fadetime=0.5, block=true)]",
        "type": "blocker",
        "a": "0,",
        "initr": "2,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 77,
        "raw": "[name=\"レユニオン構成員\"]   スカルシュレッダー！　奴らは――いや、彼女はあそこだ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "スカルシュレッダー！　奴らは――いや、彼女はあそこだ！"
    },
    {
        "id": 78,
        "raw": "[name=\"レユニオン構成員\"]   術師部隊、行け！　邪魔な連中を八つ裂きにしてやれ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "術師部隊、行け！　邪魔な連中を八つ裂きにしてやれ！"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 80,
        "raw": "[name=\"リスカム\"]   邪魔だなんて、言ってくれるね……全員、警戒態勢を！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "邪魔だなんて、言ってくれるね……全員、警戒態勢を！"
    },
    {
        "id": 81,
        "raw": "[name=\"リスカム\"]   敵術師が複数接近中！　迎撃準備！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "敵術師が複数接近中！　迎撃準備！"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"アーミヤ\"]   護衛対象の元へ、急いでください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "護衛対象の元へ、急いでください！"
    },
    {
        "id": 84,
        "raw": "[name=\"アーミヤ\"]   彼らの目的は――ミーシャさんです！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "彼らの目的は――ミーシャさんです！"
    },
    {
        "id": 85,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
