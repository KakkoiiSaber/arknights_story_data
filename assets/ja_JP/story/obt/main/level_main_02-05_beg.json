        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 15,
        "raw": "[name=\"テキサス\"]   ……やれやれ。さっき封を開けたばかりなんだが……",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……やれやれ。さっき封を開けたばかりなんだが……"
    },
    {
        "id": 16,
        "raw": "[name=\"テキサス\"]   無駄にしてしまったな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "無駄にしてしまったな。"
    },
    {
