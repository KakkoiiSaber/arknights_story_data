        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 19,
        "raw": "[name=\"レユニオン構成員\"]   早くしろ！　後続部隊も遅れるな！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "早くしろ！　後続部隊も遅れるな！"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 21,
        "raw": "[name=\"テキサス\"]   ――おい、そこの仮面男。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "――おい、そこの仮面男。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 23,
        "raw": "[name=\"レユニオン構成員\"]   っ、誰だ！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "っ、誰だ！？"
    },
    {
        "id": 24,
        "raw": "[name=\"レユニオン構成員\"]   てめえ、何のつもりで……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "てめえ、何のつもりで……"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 26,
        "raw": "[name=\"テキサス\"]   御託はいい。さっさとかかってこい。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "御託はいい。さっさとかかってこい。"
    },
    {
