    {
        "id": 13,
        "raw": "[name=\"レユニオン構成員\"]   ――急げ、もうすぐ迎撃ポイントだ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "――急げ、もうすぐ迎撃ポイントだ！"
