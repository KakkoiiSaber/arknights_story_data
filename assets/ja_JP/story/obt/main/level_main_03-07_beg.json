        "raw": "[name=\"リスカム\"]   はぁ、はあ……",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "はぁ、はあ……"
    },
    {
        "id": 61,
        "raw": "[name=\"リスカム\"]   フランカ！　さっきから、前に出すぎだってば！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "フランカ！　さっきから、前に出すぎだってば！"
