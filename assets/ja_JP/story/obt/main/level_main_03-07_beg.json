    {
        "id": 70,
        "raw": "[name=\"レユニオン構成員\"]   くっ……あいつら……！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "くっ……あいつら……！"
    },
    {
        "id": 71,
        "raw": "[name=\"レユニオン構成員\"]   近衛局とロドスで手を組んでやがったのか！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "近衛局とロドスで手を組んでやがったのか！"
    },
    {
        "id": 72,
        "raw": "[name=\"レユニオン構成員\"]   これじゃ、俺たちには止めようがない……！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "これじゃ、俺たちには止めようがない……！"
    },
    {
        "id": 73,
