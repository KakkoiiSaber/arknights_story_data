    {
        "id": 18,
        "raw": "[name=\"リスカム\"]   フランカ！　前に出すぎ！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "フランカ！　前に出すぎ！"
    },
    {
        "id": 19,
        "raw": "[name=\"リスカム\"]   それじゃカバーできないでしょ！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "それじゃカバーできないでしょ！"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_107_liskam_1\",name2=\"char_106_franka_1\",focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_106_franka_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"フランカ\"]   あら、あたしが考えなしにこんなことするとでも思ってるの？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あら、あたしが考えなしにこんなことするとでも思ってるの？"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_107_liskam_1\",name2=\"char_106_franka_1\",focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"リスカム\"]   ――言ってる間に……！　四時方向、来るよ！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "――言ってる間に……！　四時方向、来るよ！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_107_liskam_1\",name2=\"char_106_franka_1\",focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_106_franka_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"フランカ\"]   じゃあ、そっちはお願いね、リスカム！",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "じゃあ、そっちはお願いね、リスカム！"
    },
    {
        "id": 26,
        "raw": "[name=\"フランカ\"]   ああいう遠距離攻撃からは、あなたが守ってくれるでしょ？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ああいう遠距離攻撃からは、あなたが守ってくれるでしょ？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_107_liskam_1\",name2=\"char_106_franka_1\",focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"リスカム\"]   っあ～、もう……！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "っあ～、もう……！"
    },
