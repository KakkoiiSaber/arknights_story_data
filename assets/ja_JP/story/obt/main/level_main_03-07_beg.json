    {
        "id": 38,
        "raw": "[name=\"レユニオン構成員\"]   よし、うまくいっ――",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "よし、うまくいっ――"
    },
    {
        "id": 39,
        "raw": "[name=\"レユニオン構成員\"]   ……え？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……え？"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 41,
        "raw": "[name=\"ホシグマ\"]   くだらん真似を。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "くだらん真似を。"
    },
    {
        "id": 42,
        "raw": "[name=\"ホシグマ\"]   この程度の攻撃で、どうにかできるとでも？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "この程度の攻撃で、どうにかできるとでも？"
    },
    {
        "id": 43,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 44,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 45,
        "raw": "[name=\"レユニオン構成員\"]   うわっ！！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "うわっ！！"
    },
    {
        "id": 46,
        "raw": "[name=\"レユニオン構成員\"]   こ、こいつ……一体どこから降りてきたんだ！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "こ、こいつ……一体どこから降りてきたんだ！？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_136_hsguma\",focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_136_hsguma",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"フランカ\"]   借りができちゃったわね、おっきな刑事さん。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "借りができちゃったわね、おっきな刑事さん。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_136_hsguma\",focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"ホシグマ\"]   ははっ、光栄です。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "ははっ、光栄です。"
    },
    {
        "id": 51,
        "raw": "[name=\"ホシグマ\"]   しかし、フランカさん。あなたのご担当は陽動であるとお見受けします。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "しかし、フランカさん。あなたのご担当は陽動であるとお見受けします。"
    },
    {
        "id": 52,
        "raw": "[name=\"ホシグマ\"]   それでも、ここまで深く敵陣に斬り込むというのは……さすがに目立ちすぎるのでは？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "それでも、ここまで深く敵陣に斬り込むというのは……さすがに目立ちすぎるのでは？"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_136_hsguma\",focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_136_hsguma",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"フランカ\"]   大丈夫よ。こういう時こそ、パートナーを信じなくちゃ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "大丈夫よ。こういう時こそ、パートナーを信じなくちゃ。"
