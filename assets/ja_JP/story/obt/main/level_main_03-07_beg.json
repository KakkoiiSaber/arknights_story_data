        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"ホシグマ\"]   そちらも、お怪我はないようですね。よかった。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "そちらも、お怪我はないようですね。よかった。"
