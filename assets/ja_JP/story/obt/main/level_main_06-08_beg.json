        "focus": 2
    },
    {
        "id": 157,
        "raw": "[name=\"チェン\"]  ところで……。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ところで……。"
    },
    {
        "id": 158,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=1)]",
