        "raw": "[name=\"スワイヤー\"]  えっ、あれ？",
        "type": "dialog",
        "speaker": "スワイヤー",
        "content": "えっ、あれ？"
    },
    {
        "id": 215,
        "raw": "[Character(name=\"avg_npc_036\")]",
