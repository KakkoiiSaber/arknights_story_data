    },
    {
        "id": 81,
        "raw": "[name=\"チェン\"]  聞こえていたのか？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "聞こえていたのか？"
    },
    {
        "id": 82,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 83,
        "raw": "[name=\"スワイヤー\"]  ええ、確かにデカい声だったわね、この街中に響いてたわよ。",
        "type": "dialog",
        "speaker": "スワイヤー",
        "content": "ええ、確かにデカい声だったわね、この街中に響いてたわよ。"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_010_chen_1#1\")]",
        "type": "character",
        "name": "char_010_chen_1#1.png"
    },
    {
        "id": 85,
        "raw": "[name=\"チェン\"]  だとしても、お前の大声にはかなわんさ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "だとしても、お前の大声にはかなわんさ。"
    },
    {
        "id": 86,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 87,
