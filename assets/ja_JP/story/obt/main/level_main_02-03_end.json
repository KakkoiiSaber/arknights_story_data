    {
        "id": 6,
        "raw": "[name=\"ミーシャ\"]   ……ふぅ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……ふぅ……"
    },
    {
        "id": 7,
        "raw": "[name=\"ミーシャ\"]   ……ここに隠れておけば、きっと見つからないよね。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……ここに隠れておけば、きっと見つからないよね。"
    },
    {
        "id": 8,
        "raw": "[name=\"ミーシャ\"]   代わりに、あの子たちのところには戻れそうにないけど……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "代わりに、あの子たちのところには戻れそうにないけど……"
    },
    {
        "id": 9,
        "raw": "[name=\"ミーシャ\"]   ……無事でいてくれるといいな……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……無事でいてくれるといいな……"
    },
    {
        "id": 10,
        "raw": "[name=\"ミーシャ\"]   はぁ……どうしてこんなことになっちゃったんだろ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "はぁ……どうしてこんなことになっちゃったんだろ……"
    },
    {
        "id": 11,
        "raw": "[name=\"ミーシャ\"]   ……！",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……！"
    },
    {
        "id": 12,
        "raw": "[name=\"ミーシャ\"]   そこにいるのは誰？",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "そこにいるのは誰？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"アーミヤ\"]   ……すみません、脅かすつもりはなかったのですが……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……すみません、脅かすつもりはなかったのですが……"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 16,
