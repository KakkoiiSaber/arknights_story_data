    },
    {
        "id": 70,
        "raw": "[Blocker(a=0, fadetime=0.6, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.6,",
        "block": true
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 72,
        "raw": "[name=\"フランカ\"]   この辺りには誰もいないみたい。高台を守ってる様子もないし……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "この辺りには誰もいないみたい。高台を守ってる様子もないし……"
    },
    {
        "id": 73,
        "raw": "[name=\"フランカ\"]   まったく、お笑いぐさね。レユニオンにはまともな指揮官がいないのかしら？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "まったく、お笑いぐさね。レユニオンにはまともな指揮官がいないのかしら？"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 75,
        "raw": "[name=\"アーミヤ\"]   というと……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "というと……？"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 77,
        "raw": "[name=\"フランカ\"]   ここはどう見ても、守りやすくて攻めにくい地形なのよ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ここはどう見ても、守りやすくて攻めにくい地形なのよ。"
    },
    {
        "id": 78,
        "raw": "[name=\"フランカ\"]   つまりあたしならここに伏兵を置くけど、あの連中ときたら――",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "つまりあたしならここに伏兵を置くけど、あの連中ときたら――"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 80,
        "raw": "[name=\"レユニオン構成員\"]   ――かかったな！　死ねっ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "――かかったな！　死ねっ！"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 82,
        "raw": "[name=\"フランカ\"]   あ～あ、言ったそばから……恥かかせないでちょうだい。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あ～あ、言ったそばから……恥かかせないでちょうだい。"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 84,
        "raw": "[name=\"アーミヤ\"]   ――フランカさんっ！　側面にも注意してください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――フランカさんっ！　側面にも注意してください！"
    },
    {
        "id": 85,
        "raw": "[name=\"アーミヤ\"]   建物の下に、レユニオンが――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "建物の下に、レユニオンが――"
