    },
    {
        "id": 28,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 29,
        "raw": "[Delay(time=1.5)]",
        "type": "delay",
        "time": 1.5
    },
    {
        "id": 30,
        "raw": "[name=\"ホシグマ\"]   この地形を見るに……",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "この地形を見るに……"
    },
    {
        "id": 31,
        "raw": "[name=\"ホシグマ\"]   レユニオンは、あえて我々を誘い込んだのかもしれませんね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "レユニオンは、あえて我々を誘い込んだのかもしれませんね。"
    },
    {
        "id": 32,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 33,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 34,
        "raw": "[Blocker(a=0, r=0, g=0, b=0, fadetime=2, block=true)]",
        "type": "blocker",
        "a": "0,",
        "r": "0,",
        "g": "0,",
        "b": "0,",
        "fadetime": "2,",
        "block": true
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 36,
        "raw": "[name=\"フランカ\"]   荒れ地に広がる砂と岩……野外作戦にはうってつけの条件が揃ってるものね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "荒れ地に広がる砂と岩……野外作戦にはうってつけの条件が揃ってるものね。"
    },
    {
        "id": 37,
        "raw": "[name=\"フランカ\"]   ここに足りないものなんて、あとは敵影くらいじゃない？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ここに足りないものなんて、あとは敵影くらいじゃない？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"チェン\"]   ――ホシグマ、お前にはロドスのサポートを頼む。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――ホシグマ、お前にはロドスのサポートを頼む。"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"ホシグマ\"]   なるほど？　了解です。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "なるほど？　了解です。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"チェン\"]   私は近衛局の部隊と共にポジションを移動する。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "私は近衛局の部隊と共にポジションを移動する。"
    },
    {
        "id": 44,
        "raw": "[name=\"チェン\"]   このまま膠着状態が続けば、レユニオンを見失ってしまう可能性もあるからな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "このまま膠着状態が続けば、レユニオンを見失ってしまう可能性もあるからな。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"ホシグマ\"]   わかりました。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "わかりました。"
    },
    {
        "id": 47,
        "raw": "[name=\"ホシグマ\"]   では、どうかお気をつけて。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "では、どうかお気をつけて。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 49,
        "raw": "[name=\"エクシア\"]   ――うんわあ～、それにしてもすっごい風！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "――うんわあ～、それにしてもすっごい風！"
    },
    {
        "id": 50,
        "raw": "[name=\"エクシア\"]   あーあー、視界最悪、何も見えないでありま～す……",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "あーあー、視界最悪、何も見えないでありま～す……"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"フランカ\"]   これ以上は進めそうにないわね。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "これ以上は進めそうにないわね。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"リスカム\"]   レユニオンとしては、こっちが包囲網に入るのを待って仕掛けてくるつもりなのかも。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "レユニオンとしては、こっちが包囲網に入るのを待って仕掛けてくるつもりなのかも。"
    },
    {
        "id": 55,
        "raw": "[name=\"リスカム\"]   だけど、思い通りにはさせられないね。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "だけど、思い通りにはさせられないね。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_002_amiya_1\",focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"フランカ\"]  それじゃ、こうしましょうか。――アーミヤ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "それじゃ、こうしましょうか。――アーミヤ。"
    },
    {
        "id": 58,
        "raw": "[name=\"フランカ\"]  あたしとリスカムたちで迂回して、敵方を偵察しつつ、高台に陣取れないかやってみるわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あたしとリスカムたちで迂回して、敵方を偵察しつつ、高台に陣取れないかやってみるわ。"
    },
    {
        "id": 59,
        "raw": "[name=\"フランカ\"]  だから、こっちから連絡を入れるまで、ほかのみんなにはここで待機しててほしいの。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "だから、こっちから連絡を入れるまで、ほかのみんなにはここで待機しててほしいの。"
    },
    {
        "id": 60,
        "raw": "[name=\"フランカ\"]  もちろん、私たちがどんなに派手にやりあってようと、飛び出してきちゃダメよ？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "もちろん、私たちがどんなに派手にやりあってようと、飛び出してきちゃダメよ？"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_002_amiya_1\",focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"アーミヤ\"]  わかりました。とはいえ、状況に合わせて判断しますね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "わかりました。とはいえ、状況に合わせて判断しますね。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 64,
        "raw": "[name=\"フランカ\"]  はいはい。ドクター、あなたもちゃ～んと見ててあげてね！",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "はいはい。ドクター、あなたもちゃ～んと見ててあげてね！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"リスカム\"]   それでは、また後ほどご連絡します。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "それでは、また後ほどご連絡します。"
    },
    {
        "id": 67,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 68,
        "raw": "[Blocker(a=1, initr=2, r=0, g=0, b=0, fadetime=0.6, block=true)]",
        "type": "blocker",
