        "volume": 0.7
    },
    {
        "id": 103,
        "raw": "[name=\"レユニオン\"]   っ、退却だ！　全員、撤退しろ！",
        "type": "dialog",
        "speaker": "レユニオン",
        "content": "っ、退却だ！　全員、撤退しろ！"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 105,
        "raw": "[name=\"フランカ\"]   やれやれね。レユニオンが大勢待ち構えてるだろうと思って、こっちも慎重に進んできたのに。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "やれやれね。レユニオンが大勢待ち構えてるだろうと思って、こっちも慎重に進んできたのに。"
    },
    {
        "id": 106,
        "raw": "[name=\"フランカ\"]   待ってたのは小物のザコばっかりなんて、正直がっかりだわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "待ってたのは小物のザコばっかりなんて、正直がっかりだわ。"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"リスカム\"]   がっかりしてる場合じゃないよ、フランカ！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "がっかりしてる場合じゃないよ、フランカ！"
    },
    {
        "id": 109,
        "raw": "[name=\"リスカム\"]   そう簡単に逃がすわけにもいかないでしょ。追いかけないと！",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "そう簡単に逃がすわけにもいかないでしょ。追いかけないと！"
    },
    {
        "id": 110,
        "raw": "[name=\"リスカム\"]   アーミヤさん、追跡の許可をお願いできますか？",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "アーミヤさん、追跡の許可をお願いできますか？"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 112,
        "raw": "[name=\"アーミヤ\"]   いえ、やはりここは堅実に。リスクは回避して動きましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "いえ、やはりここは堅実に。リスクは回避して動きましょう。"
    },
    {
        "id": 113,
        "raw": "[name=\"アーミヤ\"]   まずはペンギン急便のお二人にお願いして、態勢を整えてから行動すべきだと思います。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "まずはペンギン急便のお二人にお願いして、態勢を整えてから行動すべきだと思います。"
    },
    {
        "id": 114,
        "raw": "[name=\"アーミヤ\"]   エクシアさん、高台の確保を優先してもらってもいいですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "エクシアさん、高台の確保を優先してもらってもいいですか？"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 116,
        "raw": "[name=\"エクシア\"]   りょうか～い！　今すぐ行ってこよっか？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "りょうか～い！　今すぐ行ってこよっか？"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 118,
        "raw": "[name=\"アーミヤ\"]   はい。できる限り、牽制もお願いできると嬉しいです。レユニオンに反撃の機会を与えないようにしたいので。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい。できる限り、牽制もお願いできると嬉しいです。レユニオンに反撃の機会を与えないようにしたいので。"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 120,
        "raw": "[name=\"テキサス\"]   ――待った。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "――待った。"
    },
    {
        "id": 121,
        "raw": "[name=\"テキサス\"]   あの連中、一度退いた先で陣形を立て直しているようだ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "あの連中、一度退いた先で陣形を立て直しているようだ。"
    },
    {
        "id": 122,
        "raw": "[name=\"テキサス\"]   それに……先ほどは見なかった人員を連れている。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "それに……先ほどは見なかった人員を連れている。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 124,
        "raw": "[name=\"アーミヤ\"]   ――！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――！"
    },
    {
        "id": 125,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 126,
        "raw": "[name=\"アーミヤ\"]   注意してください。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "注意してください。"
    },
    {
        "id": 127,
        "raw": "[name=\"アーミヤ\"]   あの人たちは……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あの人たちは……"
    },
    {
        "id": 128,
        "raw": "[name=\"アーミヤ\"]   普通の戦闘員ではありません！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "普通の戦闘員ではありません！"
    },
    {
        "id": 129,
        "raw": "[name=\"アーミヤ\"]   どうして、レユニオンに彼らの姿が……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "どうして、レユニオンに彼らの姿が……"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_107_liskam_1\",focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 131,
        "raw": "[name=\"フランカ\"]   ……あれって、もしかして……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "……あれって、もしかして……"
    },
    {
        "id": 132,
        "raw": "[Character(name=\"char_106_franka_1\",name2=\"char_107_liskam_1\",focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 133,
        "raw": "[name=\"リスカム\"]   もしかして、何？",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "もしかして、何？"
    },
    {
        "id": 134,
        "raw": "[name=\"リスカム\"]   ……あっ……",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "……あっ……"
    },
    {
        "id": 135,
        "raw": "[name=\"リスカム\"]   まさか……あの構成員たちは、サルカズ……？",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "まさか……あの構成員たちは、サルカズ……？"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 137,
        "raw": "[name=\"アーミヤ\"]   恐らく、そうかと……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "恐らく、そうかと……"
    },
    {
        "id": 138,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_107_liskam_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 139,
        "raw": "[name=\"アーミヤ\"]   （小声）リスカムさん。今は近衛局との共同作戦中ですから、こうしたデリケートな問題に触れることは避けておきましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（小声）リスカムさん。今は近衛局との共同作戦中ですから、こうしたデリケートな問題に触れることは避けておきましょう。"
    },
    {
        "id": 140,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_107_liskam_1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 141,
        "raw": "[name=\"リスカム\"]   （小声）了解しました。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "（小声）了解しました。"
    },
    {
        "id": 142,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_107_liskam_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 143,
        "raw": "[name=\"アーミヤ\"]   （小声）ありがとうございます。私の推測については、また改めてお話ししますので！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（小声）ありがとうございます。私の推測については、また改めてお話ししますので！"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 145,
        "raw": "[name=\"テキサス\"]   ……構えろ。来るぞ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……構えろ。来るぞ。"
    },
    {
        "id": 146,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 147,
        "raw": "[name=\"アーミヤ\"]   はい！　みなさん、準備をお願いします！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい！　みなさん、準備をお願いします！"
    },
    {
        "id": 148,
        "raw": "[name=\"アーミヤ\"]   今回は……厳しい戦いになりそうですから！",
        "type": "dialog",
