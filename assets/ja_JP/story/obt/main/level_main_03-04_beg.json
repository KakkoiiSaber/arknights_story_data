    },
    {
        "id": 92,
        "raw": "[name=\"レユニオン構成員\"]   ぐっ……た、太刀筋が、見えない……！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ぐっ……た、太刀筋が、見えない……！？"
    },
    {
        "id": 93,
        "raw": "[name=\"レユニオン構成員\"]   どう……して……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "どう……して……"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 95,
        "raw": "[name=\"フランカ\"]   ふふっ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ふふっ。"
    },
    {
        "id": 96,
        "raw": "[name=\"フランカ\"]   そこに隠れれば、足元から奇襲できるとでも思ってたの？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "そこに隠れれば、足元から奇襲できるとでも思ってたの？"
    },
    {
        "id": 97,
        "raw": "[name=\"フランカ\"]   だとしたら、あたしをちょっと甘く見すぎじゃないかしら。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "だとしたら、あたしをちょっと甘く見すぎじゃないかしら。"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 99,
        "raw": "[name=\"レユニオン構成員\"]   ……く、そっ……ブラック……スチール……",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……く、そっ……ブラック……スチール……"
    },
    {
        "id": 100,
        "raw": "[Dialog(fadetime=0)]",
