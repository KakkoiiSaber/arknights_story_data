        "name": "char_103_angel_1"
    },
    {
        "id": 6,
        "raw": "[name=\"エクシア\"]   アーミヤ、どうだった？　ペンギン急便ってすっごいでしょ～？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "アーミヤ、どうだった？　ペンギン急便ってすっごいでしょ～？"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_002_amiya_1#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_002_amiya_1#2",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"アーミヤ\"]   はい、とってもすごかったです！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい、とってもすごかったです！"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_002_amiya_1#2\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_002_amiya_1#2",
        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"エクシア\"]   おっ、おお～う……",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "おっ、おお～う……"
    },
    {
        "id": 11,
        "raw": "[name=\"エクシア\"]   自分より若い子に直球で褒められると、なんかちょっぴり照れちゃうなあ。へへっ……",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "自分より若い子に直球で褒められると、なんかちょっぴり照れちゃうなあ。へへっ……"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 13,
        "raw": "[name=\"テキサス\"]   彼女は依頼主だぞ。礼儀をわきまえろ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "彼女は依頼主だぞ。礼儀をわきまえろ。"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_103_angel_1\")]",
        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 15,
        "raw": "[name=\"エクシア\"]   おっと、ごめんなさ～い！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "おっと、ごめんなさ～い！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 17,
        "raw": "[name=\"アーミヤ\"]   いえ、お気になさらず。お二人には、感謝してもしきれないほどですし！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "いえ、お気になさらず。お二人には、感謝してもしきれないほどですし！"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 19,
        "raw": "[name=\"テキサス\"]   そうか。ともあれ、これでロドスとは合流できたな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "そうか。ともあれ、これでロドスとは合流できたな。"
    },
    {
        "id": 20,
        "raw": "[name=\"テキサス\"]   次はどう動く？",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "次はどう動く？"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_002_amiya_1\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   今回は共同作戦ですし、まずは近衛局の判断を仰いでみましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "今回は共同作戦ですし、まずは近衛局の判断を仰いでみましょう。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_002_amiya_1\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"テキサス\"]   わかった。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "わかった。"
    },
    {
        "id": 25,
        "raw": "[name=\"テキサス\"]   ならば、彼らにも合流を呼びかけてみよう。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "ならば、彼らにも合流を呼びかけてみよう。"
    },
    {
        "id": 26,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 27,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=2,block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,",
