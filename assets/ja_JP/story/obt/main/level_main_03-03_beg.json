        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"テキサス\"]  ああ。だから早くしろ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "ああ。だから早くしろ。"
