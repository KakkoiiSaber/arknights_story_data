    {
        "id": 8,
        "raw": "フェイゼへ：",
        "type": "narration",
        "content": "フェイゼへ："
    },
    {
        "id": 9,
        "raw": "前回の話の続きをしよう。",
        "type": "narration",
        "content": "前回の話の続きをしよう。"
    },
    {
        "id": 10,
        "raw": "私は長い逃亡の末、小さな村にたどり着いた。",
        "type": "narration",
        "content": "私は長い逃亡の末、小さな村にたどり着いた。"
    },
    {
        "id": 11,
        "raw": "その時は特に深く考えず、ただ一時的に隠れる場所を探していた。まさかそこに腰を落ち着かせることになるとは思いもしなかった。",
        "type": "narration",
        "content": "その時は特に深く考えず、ただ一時的に隠れる場所を探していた。まさかそこに腰を落ち着かせることになるとは思いもしなかった。"
    },
    {
        "id": 12,
        "raw": "あの老夫婦は恐らく、ウルサスの度重なる戦火で早くに子を失ったのだろう。私をまるで娘のように可愛がった。",
        "type": "narration",
        "content": "あの老夫婦は恐らく、ウルサスの度重なる戦火で早くに子を失ったのだろう。私をまるで娘のように可愛がった。"
    },
    {
        "id": 13,
        "raw": "私の持つ秘密さえ、二人は私のために隠してくれた。",
        "type": "narration",
        "content": "私の持つ秘密さえ、二人は私のために隠してくれた。"
    },
    {
        "id": 14,
        "raw": "あの二人には、感謝してもしきれないほど世話になった。",
        "type": "narration",
        "content": "あの二人には、感謝してもしきれないほど世話になった。"
    },
    {
        "id": 15,
        "raw": "ただ残念なことに、十分な恩返しはできずに終わってしまった。",
        "type": "narration",
        "content": "ただ残念なことに、十分な恩返しはできずに終わってしまった。"
    },
    {
        "id": 16,
        "raw": "1月13日",
        "type": "narration",
        "content": "1月13日"
    },
