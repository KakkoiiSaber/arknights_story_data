        "name": "avg_npc_092#3"
    },
    {
        "id": 145,
        "raw": "[name=\"おじいさん\"] そうじゃない。わしのアーツを……わしのアーツの力を見てほしいんじゃ！",
        "type": "dialog",
        "speaker": "おじいさん",
        "content": "そうじゃない。わしのアーツを……わしのアーツの力を見てほしいんじゃ！"
