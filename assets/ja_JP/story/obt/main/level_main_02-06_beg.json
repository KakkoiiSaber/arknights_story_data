        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"リスカム\"]   下がっていていただけますか？　ここは、私のアーツで――",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "下がっていていただけますか？　ここは、私のアーツで――"
