        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"テキサス\"]   ……いや。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……いや。"
    },
    {
        "id": 14,
        "raw": "[name=\"テキサス\"]   その必要はない。",
