    {
        "id": 7,
        "raw": "[name=\"アーミヤ\"]   えっ？　もしかして……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "えっ？　もしかして……"
    },
    {
        "id": 8,
