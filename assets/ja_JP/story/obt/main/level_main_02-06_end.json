    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"ミーシャ\"]   ……もう、大丈夫……かな？",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……もう、大丈夫……かな？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"アーミヤ\"]   そうですね……今のところは。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そうですね……今のところは。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   ……顔色が悪いですね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……顔色が悪いですね。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"ミーシャ\"]   ううん、平気……ちょっと、めまいがするだけだから。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "ううん、平気……ちょっと、めまいがするだけだから。"
    },
    {
        "id": 25,
        "raw": "[name=\"ミーシャ\"]   このくらい……なんでもないよ。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "このくらい……なんでもないよ。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"アーミヤ\"]   そう、ですか。……ところで、話は変わりますが……ミーシャさんが龍門に来てから、どのくらいになりますか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そう、ですか。……ところで、話は変わりますが……ミーシャさんが龍門に来てから、どのくらいになりますか？"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"ミーシャ\"]   大体、一週間くらい……かな。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "大体、一週間くらい……かな。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"アーミヤ\"]   一週間……ですか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "一週間……ですか。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"ミーシャ\"]   うん。……前は、チェルノボーグにいたんだ。……でもある日、街に怖い人たちがやってきて……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "うん。……前は、チェルノボーグにいたんだ。……でもある日、街に怖い人たちがやってきて……"
    },
    {
        "id": 34,
        "raw": "[name=\"ミーシャ\"]   何が何だかわからなかったけど、とにかく皆逃げ出して……私もそれで、逃げてきたの。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "何が何だかわからなかったけど、とにかく皆逃げ出して……私もそれで、逃げてきたの。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"アーミヤ\"]   その人たちは、レユニオンの構成員ですね……レユニオンは、チェルノボーグの街を攻撃していましたから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "その人たちは、レユニオンの構成員ですね……レユニオンは、チェルノボーグの街を攻撃していましたから。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"ミーシャ\"]   そう、だったんだ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "そう、だったんだ……"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"アーミヤ\"]   あなたは……そうなる前から、感染者だったんですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あなたは……そうなる前から、感染者だったんですか？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"ミーシャ\"]   どうだろう……わかんないや。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "どうだろう……わかんないや。"
    },
    {
        "id": 43,
        "raw": "[name=\"ミーシャ\"]   でも……脚にこれが生えてきたのは、ここ数日のことなんだ。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "でも……脚にこれが生えてきたのは、ここ数日のことなんだ。"
    },
    {
        "id": 44,
        "raw": "[name=\"ミーシャ\"]   ……それで、私……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……それで、私……"
    },
    {
        "id": 45,
        "raw": "[name=\"ミーシャ\"]   ……っ、う……！",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……っ、う……！"
    },
