        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"テキサス\"]   来るのが遅かったからな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "来るのが遅かったからな。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 10,
        "raw": "[name=\"アーミヤ\"]   何はともあれ、みなさんが無事で何よりです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "何はともあれ、みなさんが無事で何よりです。"
    },
    {
        "id": 11,
        "raw": "[name=\"アーミヤ\"]   さあ、そろそろ行きましょうか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "さあ、そろそろ行きましょうか。"
    },
    {
        "id": 12,
        "raw": "[name=\"アーミヤ\"]   東側の建物に向かって、そこから下へ降りていけば、レユニオンに私たちの位置を悟られずに済むはずです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "東側の建物に向かって、そこから下へ降りていけば、レユニオンに私たちの位置を悟られずに済むはずです。"
    },
