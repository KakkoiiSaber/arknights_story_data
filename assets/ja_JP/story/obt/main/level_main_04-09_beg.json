        "focus": 2
    },
    {
        "id": 9,
        "raw": "[name=\"メテオリーテ\"]   ……知らないままでいるほうが、良いと思うわ。",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "……知らないままでいるほうが、良いと思うわ。"
    },
    {
        "id": 10,
        "raw": "[name=\"メテオリーテ\"]   戦略上関わってくるようなことではないし……気にしないでちょうだい。",
        "type": "dialog",
        "speaker": "メテオリーテ",
