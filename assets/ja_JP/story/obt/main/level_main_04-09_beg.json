    },
    {
        "id": 26,
        "raw": "[name=\"アーミヤ\"]   ――！（小声）メフィスト……！　我々の痕跡に気付いたんでしょうか……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――！（小声）メフィスト……！　我々の痕跡に気付いたんでしょうか……？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_193_frostl_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_193_frostl_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"フロストリーフ\"]   （小声）静かに。……あれは奴の常套手段だ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "（小声）静かに。……あれは奴の常套手段だ。"
    },
    {
        "id": 29,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
