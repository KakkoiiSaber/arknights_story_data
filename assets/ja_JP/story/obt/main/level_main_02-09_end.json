    {
        "id": 50,
        "raw": "[Blocker(a=0, fadetime=1, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "1,",
        "block": true
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"ミーシャ\"]   ……あの、隊長さん。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……あの、隊長さん。"
    },
    {
        "id": 53,
        "raw": "[name=\"ミーシャ\"]   ――スラムの中には……子供の感染者もいるんです。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "――スラムの中には……子供の感染者もいるんです。"
    },
    {
        "id": 54,
        "raw": "[name=\"ミーシャ\"]   できることなら、どうか……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "できることなら、どうか……"
    },
    {
        "id": 55,
        "raw": "[name=\"ミーシャ\"]   あの子たちを、守ってあげてくれませんか。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "あの子たちを、守ってあげてくれませんか。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"チェン\"]   ……龍門の治安を守ることは、もとより近衛局の責務だ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……龍門の治安を守ることは、もとより近衛局の責務だ。"
    },
    {
        "id": 58,
        "raw": "[name=\"チェン\"]   感染者は、龍門の市民ではないが――",
        "type": "dialog",
        "speaker": "チェン",
        "content": "感染者は、龍門の市民ではないが――"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"ミーシャ\"]   ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"チェン\"]   ――紛れもなく、龍門の一部ではある。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――紛れもなく、龍門の一部ではある。"
    },
    {
        "id": 63,
        "raw": "[name=\"チェン\"]   ゆえに、私は私の為すべきことを為そう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ゆえに、私は私の為すべきことを為そう。"
    },
    {
        "id": 64,
        "raw": "[name=\"チェン\"]   キミの頼みには、何を保障することもできんがな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "キミの頼みには、何を保障することもできんがな。"
    },
    {
        "id": 65,
        "raw": "[name=\"チェン\"]   結局のところ――",
        "type": "dialog",
        "speaker": "チェン",
        "content": "結局のところ――"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"ミーシャ\"]  ――でも、あの子たちから聞いたんです。前にも、あなたが……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "――でも、あの子たちから聞いたんです。前にも、あなたが……"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]=",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1,
        "content": "="
    },
    {
        "id": 69,
        "raw": "[name=\"チェン\"]   ――我々は常に、そうした責務に努めてきたし、今後もそう在り続ける。それだけの話だ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――我々は常に、そうした責務に努めてきたし、今後もそう在り続ける。それだけの話だ。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"ミーシャ\"]   ……！",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……！"
    },
    {
        "id": 72,
        "raw": "[name=\"ミーシャ\"]   ……ありがとう、ございます。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……ありがとう、ございます。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 75,
        "raw": "[name=\"チェン\"]   ときに、我々がキミを探していた理由については理解しているか？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ときに、我々がキミを探していた理由については理解しているか？"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"ミーシャ\"]   いえ……はっきりとはわかりません。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "いえ……はっきりとはわかりません。"
    },
    {
        "id": 78,
        "raw": "[name=\"ミーシャ\"]   私には、あなたたちに必要とされるような心当たりはないですし……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "私には、あなたたちに必要とされるような心当たりはないですし……"
    },
    {
        "id": 79,
        "raw": "[name=\"ミーシャ\"]   だけど、もしかしたら……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "だけど、もしかしたら……"
    },
    {
        "id": 80,
        "raw": "[name=\"ミーシャ\"]   その理由は、私自身じゃなくて――",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "その理由は、私自身じゃなくて――"
    },
    {
        "id": 81,
        "raw": "[name=\"ミーシャ\"]   ――お父さんにあるんじゃないか、って。",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "――お父さんにあるんじゃないか、って。"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"チェン\"]   ……その通りだ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……その通りだ。"
    },
    {
        "id": 84,
        "raw": "[name=\"チェン\"]   キミのお父上は、チェルノボーグの高名な科学者だったと聞いた。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "キミのお父上は、チェルノボーグの高名な科学者だったと聞いた。"
    },
    {
        "id": 85,
