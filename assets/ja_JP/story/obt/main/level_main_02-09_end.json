    {
        "id": 45,
        "raw": "[name=\"スカルシュレッダー\"]   行け、続けて追撃しろ！",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "行け、続けて追撃しろ！"
    },
    {
