    {
        "id": 5,
        "raw": "[name=\"感染者\"]   本当にありがとう、お陰で助かったよ……",
        "type": "dialog",
        "speaker": "感染者",
        "content": "本当にありがとう、お陰で助かったよ……"
    },
    {
        "id": 6,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 7,
        "raw": "[name=\"アーミヤ\"]   どういたしまして。この辺りはまだ危険ですから、どうか離れていてくださいね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "どういたしまして。この辺りはまだ危険ですから、どうか離れていてくださいね。"
    },
    {
        "id": 8,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 9,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 10,
        "raw": "[name=\"感染者\"]   ……離れて、って……そんなこと、言われてもなあ……",
        "type": "dialog",
        "speaker": "感染者",
        "content": "……離れて、って……そんなこと、言われてもなあ……"
    },
    {
        "id": 11,
        "raw": "[name=\"感染者\"]   俺たちに行くあてなんてないんだよ、お嬢ちゃん……",
        "type": "dialog",
        "speaker": "感染者",
        "content": "俺たちに行くあてなんてないんだよ、お嬢ちゃん……"
    },
    {
        "id": 12,
        "raw": "[name=\"感染者\"]   ここが皆の家だったのに、あいつらが全部めちゃくちゃにしちまったし……",
        "type": "dialog",
        "speaker": "感染者",
        "content": "ここが皆の家だったのに、あいつらが全部めちゃくちゃにしちまったし……"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 14,
        "raw": "[name=\"アーミヤ\"]   ……そう、だったんですね。ごめんなさい……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……そう、だったんですね。ごめんなさい……"
    },
    {
        "id": 15,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 16,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 17,
        "raw": "[name=\"感染者\"]   謝るこたないさ……あんたたちは悪くない。",
        "type": "dialog",
        "speaker": "感染者",
        "content": "謝るこたないさ……あんたたちは悪くない。"
    },
    {
        "id": 18,
        "raw": "[name=\"感染者\"]   なんにも、悪くないんだ……",
        "type": "dialog",
        "speaker": "感染者",
        "content": "なんにも、悪くないんだ……"
    },
