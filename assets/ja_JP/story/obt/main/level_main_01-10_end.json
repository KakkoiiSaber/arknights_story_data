    {
        "id": 8,
        "raw": "[name=\"ドーベルマン\"]  これで、包囲を突破したとみて良さそうだな……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "これで、包囲を突破したとみて良さそうだな……"
    },
    {
        "id": 9,
        "raw": "[name=\"ニアール\"]  しかし、あの場に残った彼らが……！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "しかし、あの場に残った彼らが……！"
    },
    {
        "id": 10,
        "raw": "[name=\"ニアール\"]  ……それを思うと、私は……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……それを思うと、私は……"
    },
