    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_148_nearl_1#3\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1#3",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"ドーベルマン\"]  そこまでにしろ、ニアール。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "そこまでにしろ、ニアール。"
    },
    {
        "id": 15,
        "raw": "[name=\"ドーベルマン\"]  ……気を失っているとは言え、アーミヤには聞かせられん。無論、ほかのメンバーにもな。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……気を失っているとは言え、アーミヤには聞かせられん。無論、ほかのメンバーにもな。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_148_nearl_1#7\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#7",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"ニアール\"]  だが、彼女も内心では理解しているはずだ。アーミヤは、私たちが思うよりもずっと大人なのだから……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "だが、彼女も内心では理解しているはずだ。アーミヤは、私たちが思うよりもずっと大人なのだから……"
    },
    {
        "id": 18,
        "raw": "[name=\"アーミヤ\"]  ……う……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……う……"
    },
    {
        "id": 19,
        "raw": "[name=\"アーミヤ\"]  ……ううん……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ううん……"
    },
    {
        "id": 20,
        "raw": "[Blocker(a=1, r=0, g=0, b=0, fadetime=0.6, block=true)]",
        "type": "blocker",
        "a": "1,",
