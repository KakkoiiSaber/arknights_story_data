    {
        "id": 12,
        "raw": "フェイゼへ：",
        "type": "narration",
        "content": "フェイゼへ："
    },
    {
        "id": 13,
        "raw": "私の頼りない記憶が確かなら、あの爺さんは「イヴァン・イジャスラフ」という名前だったはずだ。",
        "type": "narration",
        "content": "私の頼りない記憶が確かなら、あの爺さんは「イヴァン・イジャスラフ」という名前だったはずだ。"
    },
    {
        "id": 14,
        "raw": "よくある名前の、どこにでもいる農民だった。",
        "type": "narration",
        "content": "よくある名前の、どこにでもいる農民だった。"
    },
    {
        "id": 15,
        "raw": "だが彼は自分を犠牲にした。色々なもののために、彼は自分の命を犠牲にしたんだ。",
        "type": "narration",
        "content": "だが彼は自分を犠牲にした。色々なもののために、彼は自分の命を犠牲にしたんだ。"
    },
    {
        "id": 16,
        "raw": "私は他人が命を犠牲にするほどの価値がある人間だろうか、そんなことをふと考える時がある。",
        "type": "narration",
        "content": "私は他人が命を犠牲にするほどの価値がある人間だろうか、そんなことをふと考える時がある。"
    },
    {
        "id": 17,
        "raw": "アリーナは常に私と一緒に行動していた。普段は優しい彼女だが、時折見せるとげとげしい一面に、私は戸惑いを感じることもある。",
        "type": "narration",
        "content": "アリーナは常に私と一緒に行動していた。普段は優しい彼女だが、時折見せるとげとげしい一面に、私は戸惑いを感じることもある。"
    },
    {
        "id": 18,
        "raw": "計画は順調に進んでいる。",
        "type": "narration",
        "content": "計画は順調に進んでいる。"
    },
    {
        "id": 19,
        "raw": "このままいけば、ここら一帯の感染者はいずれ団結するだろう。",
        "type": "narration",
        "content": "このままいけば、ここら一帯の感染者はいずれ団結するだろう。"
    },
    {
        "id": 20,
        "raw": "上手くいってほしい。",
        "type": "narration",
        "content": "上手くいってほしい。"
    },
    {
        "id": 21,
        "raw": "そして、爺さんに安らかに眠ってほしい。婆さん以外で、あれほど私に優しくしてくれた人はいなかった……",
        "type": "narration",
        "content": "そして、爺さんに安らかに眠ってほしい。婆さん以外で、あれほど私に優しくしてくれた人はいなかった……"
    },
    {
        "id": 22,
        "raw": "2月7日",
        "type": "narration",
        "content": "2月7日"
    },
