    {
        "id": 143,
        "raw": "[name=\"アリーナ\"]  タルラ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "タルラ……"
    },
    {
        "id": 144,
        "raw": "[name=\"タルラ\"]  なんだ……聞いてるぞ……ちゃんと聞いているぞ！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "なんだ……聞いてるぞ……ちゃんと聞いているぞ！"
    },
    {
        "id": 145,
        "raw": "[name=\"アリーナ\"]  誰がやったかなんて、教えてあげないわ……！",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "誰がやったかなんて、教えてあげないわ……！"
    },
    {
        "id": 146,
        "raw": "[name=\"タルラ\"]  なぜだ！？　私はアリーナの仇を討つことさえできないのか！！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "なぜだ！？　私はアリーナの仇を討つことさえできないのか！！"
    },
    {
        "id": 147,
        "raw": "[name=\"アリーナ\"]  ダメよ……自分で言ったことをどうして忘れるの？",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "ダメよ……自分で言ったことをどうして忘れるの？"
    },
    {
        "id": 148,
        "raw": "[name=\"アリーナ\"]  復讐のために戦ってはいけないわ……タルラ、だってあなたは選んだじゃない。あなたは選んだのよ、一つの道を……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "復讐のために戦ってはいけないわ……タルラ、だってあなたは選んだじゃない。あなたは選んだのよ、一つの道を……"
    },
    {
        "id": 149,
        "raw": "[name=\"アリーナ\"]  その道を私のために……中途半端で終わらせるっていうの……？　ダメよ、そんなの……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "その道を私のために……中途半端で終わらせるっていうの……？　ダメよ、そんなの……"
    },
    {
        "id": 150,
        "raw": "[name=\"アリーナ\"]  誰かを……憎んではダメ。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "誰かを……憎んではダメ。"
    },
    {
        "id": 151,
        "raw": "[name=\"タルラ\"]  何を言ってる！？　無理だ……無理に決まってるだろう！！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "何を言ってる！？　無理だ……無理に決まってるだろう！！"
    },
    {
        "id": 152,
        "raw": "[name=\"アリーナ\"]  自分で言ったじゃない……誰も憎まないって……でなきゃあなたは……あなたを呪ったあの人に……呑み込まれてしまう……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "自分で言ったじゃない……誰も憎まないって……でなきゃあなたは……あなたを呪ったあの人に……呑み込まれてしまう……"
    },
    {
        "id": 153,
        "raw": "[name=\"アリーナ\"]  たとえそんなアーツなんて実在していなかったとしても、あなたは……あの人が体現しようとしたものに……操られちゃうかもしれない。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "たとえそんなアーツなんて実在していなかったとしても、あなたは……あの人が体現しようとしたものに……操られちゃうかもしれない。"
    },
    {
        "id": 154,
        "raw": "[name=\"アリーナ\"]  あなたが自分で言ったことよ。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あなたが自分で言ったことよ。"
    },
    {
        "id": 155,
        "raw": "[name=\"タルラ\"]  そう……そうだ。でも……でも奴らは……奴ら……",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "そう……そうだ。でも……でも奴らは……奴ら……"
    },
    {
        "id": 156,
        "raw": "[name=\"アリーナ\"]  ……彼らがどこから来て……どうしてこんなことをしたか、あなたにもわかってるでしょ？",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "……彼らがどこから来て……どうしてこんなことをしたか、あなたにもわかってるでしょ？"
    },
    {
        "id": 157,
        "raw": "[name=\"アリーナ\"]  あなたが言ったのよ……あなたが直面している敵はそんなものじゃないって――",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あなたが言ったのよ……あなたが直面している敵はそんなものじゃないって――"
    },
    {
        "id": 158,
        "raw": "[name=\"タルラ\"]  もういい、喋るな……アリーナ……無理して喋らないでいい！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "もういい、喋るな……アリーナ……無理して喋らないでいい！"
    },
    {
        "id": 159,
        "raw": "[name=\"アリーナ\"]  いいえ……タルラ……あなたが言ったこと……私は全部覚えてる……だからあなたも……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "いいえ……タルラ……あなたが言ったこと……私は全部覚えてる……だからあなたも……"
    },
    {
        "id": 160,
        "raw": "[name=\"アリーナ\"]  あなたが打ち砕こうとしているものは……彼らじゃない……彼らをここまで追い込んだ……そう仕向けた……ウルサス……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あなたが打ち砕こうとしているものは……彼らじゃない……彼らをここまで追い込んだ……そう仕向けた……ウルサス……"
    },
    {
        "id": 161,
        "raw": "[name=\"アリーナ\"]  こんなウルサス……こんな……大地が……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "こんなウルサス……こんな……大地が……"
    },
    {
        "id": 162,
        "raw": "[name=\"タルラ\"]  もういい！　わかったから、アリーナ……もういいんだ！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "もういい！　わかったから、アリーナ……もういいんだ！"
    },
    {
        "id": 163,
        "raw": "[name=\"アリーナ\"]  タルラ、あなたがしてもいいのは……彼らのやったことそのものを……それ自体を嫌悪し、憎むことだけ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "タルラ、あなたがしてもいいのは……彼らのやったことそのものを……それ自体を嫌悪し、憎むことだけ……"
    },
    {
        "id": 164,
        "raw": "[name=\"アリーナ\"]  でも……誰かを憎んだりしてはダメ。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "でも……誰かを憎んだりしてはダメ。"
    },
    {
        "id": 165,
        "raw": "[name=\"アリーナ\"]  私の言ってること……正しいと思う？　私たちの人生に……意味はあるの？　うっ……私にはわからない。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "私の言ってること……正しいと思う？　私たちの人生に……意味はあるの？　うっ……私にはわからない。"
    },
    {
        "id": 166,
        "raw": "[name=\"アリーナ\"]  私たちは何かを間違えちゃったのかもしれないわね……今の私にわかるのは、あの呪いが……何なのかだけ。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "私たちは何かを間違えちゃったのかもしれないわね……今の私にわかるのは、あの呪いが……何なのかだけ。"
    },
    {
        "id": 167,
        "raw": "[name=\"アリーナ\"]  あなたの怒りは……荒野を焼き尽くせる……でも憎んではダメ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あなたの怒りは……荒野を焼き尽くせる……でも憎んではダメ……"
    },
    {
        "id": 168,
        "raw": "[name=\"アリーナ\"]  ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "……"
    },
    {
        "id": 169,
        "raw": "[name=\"タルラ\"]  アリーナ……",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "アリーナ……"
    },
