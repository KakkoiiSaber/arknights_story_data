    {
        "id": 211,
        "raw": "[name=\"アリーナ\"]  タル……ラ……？",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "タル……ラ……？"
    },
    {
        "id": 212,
        "raw": "[name=\"タルラ\"]  どうした、アリーナ。聞いてるぞ。",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "どうした、アリーナ。聞いてるぞ。"
    },
    {
        "id": 213,
        "raw": "[name=\"アリーナ\"]  ……雪って……思ってたより……暖かいのね。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "……雪って……思ってたより……暖かいのね。"
    },
    {
        "id": 214,
        "raw": "[name=\"アリーナ\"]  ごめんね……約束したあれ……まだ全部書けてない。",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "ごめんね……約束したあれ……まだ全部書けてない。"
    },
    {
        "id": 215,
        "raw": "[name=\"タルラ\"]  気にするな。大丈夫だ、アリーナ。大したことじゃない。",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "気にするな。大丈夫だ、アリーナ。大したことじゃない。"
    },
    {
        "id": 216,
        "raw": "[name=\"アリーナ\"]  あの子たち……特に、イーノは……あなたが……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あの子たち……特に、イーノは……あなたが……"
    },
    {
        "id": 217,
        "raw": "[name=\"タルラ\"]  ああ、どうした？　アリーナ……ちゃんと聞いているから、なんでも言ってくれ！",
        "type": "dialog",
        "speaker": "タルラ",
        "content": "ああ、どうした？　アリーナ……ちゃんと聞いているから、なんでも言ってくれ！"
    },
    {
        "id": 218,
        "raw": "[name=\"アリーナ\"]  あの子には……ただ……言うだけじゃ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "あの子には……ただ……言うだけじゃ……"
    },
    {
        "id": 219,
        "raw": "[name=\"アリーナ\"]  熱いよ……タルラ……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "熱いよ……タルラ……"
    },
    {
        "id": 220,
        "raw": "[name=\"アリーナ\"]  ……死にたくない……私まだ……あなたの妹に……",
        "type": "dialog",
        "speaker": "アリーナ",
        "content": "……死にたくない……私まだ……あなたの妹に……"
    },
