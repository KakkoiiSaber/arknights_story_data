        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 169,
        "raw": "[name=\"アーミヤ\"]   ――では、行きましょう。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――では、行きましょう。"
    },
