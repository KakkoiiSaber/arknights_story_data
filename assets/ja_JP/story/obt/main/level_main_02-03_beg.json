    {
        "id": 6,
        "raw": "[name=\"？？？\"]   早く隠れて！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "早く隠れて！"
    },
    {
        "id": 7,
        "raw": "[name=\"？？？\"]   私は……もう行かなくちゃいけないから。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "私は……もう行かなくちゃいけないから。"
    },
    {
        "id": 8,
        "raw": "[name=\"？？？\"]   ……このお人形さん、君たちにあげるね。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "……このお人形さん、君たちにあげるね。"
    },
    {
        "id": 9,
        "raw": "[name=\"？？？\"]   実はこれ、お守りなんだ。お母さんから作り方を教えてもらったんだけど……",
        "type": "dialog",
        "speaker": "？？？",
        "content": "実はこれ、お守りなんだ。お母さんから作り方を教えてもらったんだけど……"
    },
    {
        "id": 10,
        "raw": "[name=\"？？？\"]   今あげたのは、私の手作りでね。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "今あげたのは、私の手作りでね。"
    },
    {
        "id": 11,
        "raw": "[name=\"？？？\"]   大事な人を守ってくれますように、って願いを込めてあるんだ。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "大事な人を守ってくれますように、って願いを込めてあるんだ。"
    },
