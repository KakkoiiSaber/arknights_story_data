    },
    {
        "id": 39,
        "raw": "[name=\"Ace\"]  ああ。今はとにかく、合流地点へ急いだほうがいい。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "ああ。今はとにかく、合流地点へ急いだほうがいい。"
