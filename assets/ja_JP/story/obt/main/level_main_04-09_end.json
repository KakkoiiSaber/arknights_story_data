    {
        "id": 88,
        "raw": "[name=\"メフィスト\"]   さて、君たちに新しいお友達を紹介してあげよう。",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "さて、君たちに新しいお友達を紹介してあげよう。"
    },
