        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 8,
        "raw": "[name=\"フロストリーフ\"]   無茶は承知の上だ！",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "無茶は承知の上だ！"
