    {
        "id": 142,
        "raw": "[name=\"アーミヤ\"]   フロストリーフさん――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "フロストリーフさん――"
    },
    {
        "id": 143,
        "raw": "[name=\"アーミヤ\"]   下がってください。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "下がってください。"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 145,
        "raw": "[name=\"フロストリーフ\"]   ――",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "――"
    },
    {
        "id": 146,
        "raw": "[name=\"フロストリーフ\"]   アーミヤ、皆を連れて逃げろ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "アーミヤ、皆を連れて逃げろ。"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 148,
        "raw": "[name=\"アーミヤ\"]   できません！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "できません！"
    },
    {
        "id": 149,
        "raw": "[name=\"アーミヤ\"]   あんな人が相手では……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あんな人が相手では……！"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 151,
        "raw": "[name=\"フロストリーフ\"]   そうだな。……奴に追いつかれてしまったら――",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "そうだな。……奴に追いつかれてしまったら――"
    },
    {
        "id": 152,
        "raw": "[name=\"フロストリーフ\"]   私たちに勝ち目はない。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "私たちに勝ち目はない。"
    },
    {
        "id": 153,
        "raw": "[name=\"フロストリーフ\"]   ……ふっ。……まだ、十分に生きたとは言えないが……",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "……ふっ。……まだ、十分に生きたとは言えないが……"
    },
    {
        "id": 154,
        "raw": "[name=\"フロストリーフ\"]   お前たちに出会えて、私は幸せだった。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "お前たちに出会えて、私は幸せだった。"
    },
    {
        "id": 155,
        "raw": "[name=\"フロストリーフ\"]   ――行け。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "――行け。"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6.png"
    },
    {
        "id": 157,
        "raw": "[name=\"アーミヤ\"]   フロストリーフさん！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "フロストリーフさん！？"
    },
