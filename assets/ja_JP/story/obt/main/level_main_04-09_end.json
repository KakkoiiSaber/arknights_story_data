    {
        "id": 40,
        "raw": "[name=\"レユニオン構成員\"]   うわあっ！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "うわあっ！？"
    },
    {
        "id": 41,
        "raw": "[name=\"レユニオン構成員\"]   な、なんだこの黒いアーツ……！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "な、なんだこの黒いアーツ……！"
    },
    {
        "id": 42,
        "raw": "[name=\"レユニオン構成員\"]   っ、撤退だ！　走れ！",
