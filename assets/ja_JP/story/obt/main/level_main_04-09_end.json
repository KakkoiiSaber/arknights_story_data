        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 10,
        "raw": "[name=\"レユニオン構成員\"]   うわあああっ！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "うわあああっ！"
    },
    {
        "id": 11,
        "raw": "[name=\"レユニオン構成員\"]   れ、冷気で盾を裂かれた……！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "れ、冷気で盾を裂かれた……！？"
    },
    {
        "id": 12,
        "raw": "[name=\"レユニオン構成員\"]   そんなこと、あるのか……！？",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "そんなこと、あるのか……！？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 14,
        "raw": "[name=\"フロストリーフ\"]   邪魔だ！",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "邪魔だ！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"メテオリーテ\"]   アーミヤ！　フロストリーフが敵陣に突っ込んで、あの指揮官のほうへ向かってるわ！",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "アーミヤ！　フロストリーフが敵陣に突っ込んで、あの指揮官のほうへ向かってるわ！"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"アーミヤ\"]   ――！　狙撃オペレーターと術師オペレーターで、フロストリーフさんの援護をお願いします！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――！　狙撃オペレーターと術師オペレーターで、フロストリーフさんの援護をお願いします！"
    },
