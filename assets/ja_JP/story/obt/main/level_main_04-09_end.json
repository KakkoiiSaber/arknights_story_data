    {
        "id": 59,
        "raw": "[name=\"フロストリーフ\"]   さあ、観念しろ。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "さあ、観念しろ。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_1507_Mephisto_1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1.png"
    },
    {
        "id": 61,
        "raw": "[name=\"メフィスト\"]   子ギツネさん、少し近すぎやしないかい？",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "子ギツネさん、少し近すぎやしないかい？"
