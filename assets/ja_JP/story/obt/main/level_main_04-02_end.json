        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 11,
        "raw": "[name=\"アーミヤ\"]   きゃっ！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "きゃっ！？"
    },
    {
        "id": 12,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 13,
        "raw": "[name=\"子供\"]   ご、ごめんなさい！　ぶつかるつもりじゃなかったんだけど……！",
        "type": "dialog",
        "speaker": "子供",
        "content": "ご、ごめんなさい！　ぶつかるつもりじゃなかったんだけど……！"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 15,
        "raw": "[name=\"アーミヤ\"]   ううん、大丈夫。そうしてすぐに謝れるなんて、立派だね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ううん、大丈夫。そうしてすぐに謝れるなんて、立派だね。"
    },
    {
        "id": 16,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 17,
        "raw": "[name=\"子供\"]   わわ、そうかな？　えへへ……",
        "type": "dialog",
        "speaker": "子供",
        "content": "わわ、そうかな？　えへへ……"
    },
    {
        "id": 18,
        "raw": "[name=\"子供\"]   ところで、お姉さんはここで何してるの？",
        "type": "dialog",
        "speaker": "子供",
        "content": "ところで、お姉さんはここで何してるの？"
    },
    {
        "id": 19,
        "raw": "[name=\"子供\"]   この辺は雨が降ってるし、雨宿りしたほうがいいんじゃない……？",
        "type": "dialog",
        "speaker": "子供",
        "content": "この辺は雨が降ってるし、雨宿りしたほうがいいんじゃない……？"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 21,
        "raw": "[name=\"アーミヤ\"]   ええっと……ううん、その……少しお散歩してただけだから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ええっと……ううん、その……少しお散歩してただけだから。"
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   それより君、何か手伝ってほしいことがあるんじゃない？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "それより君、何か手伝ってほしいことがあるんじゃない？"
    },
    {
        "id": 23,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 24,
        "raw": "[name=\"子供\"]   えっ！　どうしてわかったの！？",
        "type": "dialog",
        "speaker": "子供",
        "content": "えっ！　どうしてわかったの！？"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 26,
        "raw": "[name=\"アーミヤ\"]   ふふっ、ないしょ。これはお姉さんの秘密だからね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ふふっ、ないしょ。これはお姉さんの秘密だからね。"
    },
    {
        "id": 27,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 28,
        "raw": "[name=\"子供\"]   ええ～？　……んー、まあいっか！",
        "type": "dialog",
        "speaker": "子供",
        "content": "ええ～？　……んー、まあいっか！"
    },
    {
        "id": 29,
        "raw": "[name=\"子供\"]   じゃあさ、お願いがあるんだけど――",
        "type": "dialog",
        "speaker": "子供",
        "content": "じゃあさ、お願いがあるんだけど――"
    },
    {
        "id": 30,
        "raw": "[name=\"子供\"]   うーん……でも、やっぱり無理かなあ……お姉さん、背が小さいし……",
        "type": "dialog",
        "speaker": "子供",
        "content": "うーん……でも、やっぱり無理かなあ……お姉さん、背が小さいし……"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 32,
        "raw": "[name=\"アーミヤ\"]   もう、そんなこと言っちゃダメだよ！　君に比べたら、私のほうが背が高いでしょ！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "もう、そんなこと言っちゃダメだよ！　君に比べたら、私のほうが背が高いでしょ！"
    },
    {
        "id": 33,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 34,
        "raw": "[name=\"子供\"]  わわ、ごめんって！",
        "type": "dialog",
        "speaker": "子供",
        "content": "わわ、ごめんって！"
    },
    {
        "id": 35,
        "raw": "[name=\"子供\"]  それじゃ……とりあえず、やってみる？　えっとね、この板どかすのを手伝ってほしいんだ。",
        "type": "dialog",
        "speaker": "子供",
        "content": "それじゃ……とりあえず、やってみる？　えっとね、この板どかすのを手伝ってほしいんだ。"
    },
    {
        "id": 36,
        "raw": "[name=\"子供\"]  下敷きになってる蓄音機を持って帰りたくてさ。",
        "type": "dialog",
        "speaker": "子供",
        "content": "下敷きになってる蓄音機を持って帰りたくてさ。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 38,
        "raw": "[name=\"アーミヤ\"]   これ？　うん、やってみよっか。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "これ？　うん、やってみよっか。"
    },
    {
        "id": 39,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 40,
        "raw": "[name=\"子供\"]   じゃあいくよ。いち……にの……さん！　えいっ！",
        "type": "dialog",
        "speaker": "子供",
        "content": "じゃあいくよ。いち……にの……さん！　えいっ！"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 42,
        "raw": "[name=\"アーミヤ\"]   ！　できた！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "！　できた！"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 44,
        "raw": "[name=\"アーミヤ\"]   ……っ、これは……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……っ、これは……"
    },
    {
        "id": 45,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 46,
        "raw": "[name=\"子供\"]   わあっ、お姉さん力持ちだね！　ありがとう！",
        "type": "dialog",
        "speaker": "子供",
        "content": "わあっ、お姉さん力持ちだね！　ありがとう！"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 48,
        "raw": "[name=\"アーミヤ\"]   うん、でも……この蓄音機、壊れてるみたいだよ。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "うん、でも……この蓄音機、壊れてるみたいだよ。"
    },
    {
        "id": 49,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 50,
        "raw": "[name=\"子供\"]   大丈夫大丈夫！　見つけた時にはもう壊れてたしね。いつか、これをちゃんと直して使えるようにするつもりなんだ。",
        "type": "dialog",
        "speaker": "子供",
        "content": "大丈夫大丈夫！　見つけた時にはもう壊れてたしね。いつか、これをちゃんと直して使えるようにするつもりなんだ。"
    },
    {
        "id": 51,
        "raw": "[name=\"子供\"]   実は僕、みんなのためにレコードをいっぱい集めててさ。まあ、自分でも、一度も聴いたことないんだけど……",
        "type": "dialog",
        "speaker": "子供",
        "content": "実は僕、みんなのためにレコードをいっぱい集めててさ。まあ、自分でも、一度も聴いたことないんだけど……"
    },
    {
        "id": 52,
        "raw": "[name=\"子供\"]   でも、いつかみんなに聴かせてあげようと思って！",
        "type": "dialog",
        "speaker": "子供",
        "content": "でも、いつかみんなに聴かせてあげようと思って！"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 54,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 55,
        "raw": "[name=\"アーミヤ\"]   ……難しい目標のはずなのに、簡単なことみたいに口に出せるなんて……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……難しい目標のはずなのに、簡単なことみたいに口に出せるなんて……"
    },
    {
        "id": 56,
        "raw": "[name=\"アーミヤ\"]   ……私、何のために行動してるのかな。……私にできることって、何だろう……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……私、何のために行動してるのかな。……私にできることって、何だろう……"
    },
    {
        "id": 57,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 58,
        "raw": "[name=\"子供\"]   ……あのさ、お姉さんは僕のこと、怖くないの？",
        "type": "dialog",
        "speaker": "子供",
        "content": "……あのさ、お姉さんは僕のこと、怖くないの？"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   ううん。……どうして、怖がられると思ったの？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ううん。……どうして、怖がられると思ったの？"
    },
    {
        "id": 61,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 62,
        "raw": "[name=\"子供\"]   だって僕、鉱石病なんだよ！",
        "type": "dialog",
        "speaker": "子供",
        "content": "だって僕、鉱石病なんだよ！"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 64,
        "raw": "[name=\"アーミヤ\"]   あははっ、私もそうだよ。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あははっ、私もそうだよ。"
    },
    {
        "id": 65,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 66,
        "raw": "[name=\"子供\"]   え～っ！　こんなに可愛いのに感染者なんて、もったいない……",
        "type": "dialog",
        "speaker": "子供",
        "content": "え～っ！　こんなに可愛いのに感染者なんて、もったいない……"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 68,
        "raw": "[name=\"アーミヤ\"]   ――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_002_amiya_1#3\")]",
        "type": "character",
        "name": "char_002_amiya_1#3"
    },
    {
        "id": 70,
        "raw": "[name=\"アーミヤ\"]   感染者になったからって、全部台無しになるわけじゃないんだよ。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "感染者になったからって、全部台無しになるわけじゃないんだよ。"
    },
    {
        "id": 71,
        "raw": "[name=\"アーミヤ\"]   だって、たとえ君が感染者でも、そうじゃなくても――いい子でいたなら、その事実までは変わらないでしょう？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "だって、たとえ君が感染者でも、そうじゃなくても――いい子でいたなら、その事実までは変わらないでしょう？"
    },
    {
        "id": 72,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 73,
        "raw": "[name=\"子供\"]   ん～……そうなの？　よくわかんないや……",
        "type": "dialog",
        "speaker": "子供",
        "content": "ん～……そうなの？　よくわかんないや……"
    },
    {
        "id": 74,
        "raw": "[name=\"子供\"]   （ぐう……）",
        "type": "dialog",
        "speaker": "子供",
        "content": "（ぐう……）"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 76,
        "raw": "[name=\"アーミヤ\"]   ……もしかして、お腹ぺこぺこ？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……もしかして、お腹ぺこぺこ？"
    },
    {
        "id": 77,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 78,
        "raw": "[name=\"子供\"]   ……うん……",
        "type": "dialog",
        "speaker": "子供",
        "content": "……うん……"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 80,
        "raw": "[name=\"アーミヤ\"]   ……じゃあ、これあげる。って言っても、これしかないんだけど……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……じゃあ、これあげる。って言っても、これしかないんだけど……"
    },
    {
        "id": 81,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 82,
        "raw": "[name=\"子供\"]   えっ、いいの？　やった、ありがとう！",
        "type": "dialog",
        "speaker": "子供",
        "content": "えっ、いいの？　やった、ありがとう！"
    },
    {
        "id": 83,
        "raw": "[name=\"子供\"]   ……あれ？　そういえば……お姉さんって、なんでここに来たの？",
        "type": "dialog",
        "speaker": "子供",
        "content": "……あれ？　そういえば……お姉さんって、なんでここに来たの？"
    },
