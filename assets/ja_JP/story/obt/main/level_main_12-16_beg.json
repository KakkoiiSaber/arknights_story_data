    {
        "id": 165,
        "raw": "[Subtitle(text=\"「『アッシュワース一族考』が手元にあってほしかった。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「『アッシュワース一族考』が手元にあってほしかった。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 166,
        "raw": "[Subtitle(text=\"「編集者たちには私の仕事の真の意義を理解し、原稿料の値上げに同意してほしかった。」\", x=300, y=370, alignment=\"center\", size=26, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「編集者たちには私の仕事の真の意義を理解し、原稿料の値上げに同意してほしかった。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "26,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 167,
        "raw": "[Subtitle(text=\"「先生には怒らないでほしかった。あれはただの学術論争であり、私は今も先生を尊敬している。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「先生には怒らないでほしかった。あれはただの学術論争であり、私は今も先生を尊敬している。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 168,
        "raw": "[Subtitle(text=\"「まあいい。もし機会があったら、また先生の淹れてくれたお茶を飲みたい。そのためなら学術論争は脇に置いてもいい。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「まあいい。もし機会があったら、また先生の淹れてくれたお茶を飲みたい。そのためなら学術論争は脇に置いてもいい。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 169,
        "raw": "[Subtitle(text=\"「お腹が空いた、街角のあの鱗獣フライが食べたい。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「お腹が空いた、街角のあの鱗獣フライが食べたい。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 170,
        "raw": "[Subtitle(text=\"「ジェーン、私のことを忘れないでいてほしい。君を愛している、別れる前と変わらず愛しているんだ。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「ジェーン、私のことを忘れないでいてほしい。君を愛している、別れる前と変わらず愛しているんだ。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 171,
        "raw": "[Subtitle(text=\"「私はバカだ。ボクシングジムの子たちには無事でいてほしい。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「私はバカだ。ボクシングジムの子たちには無事でいてほしい。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 172,
        "raw": "[Subtitle(text=\"「ウイスキーを樽三百万杯分飲みたい。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「ウイスキーを樽三百万杯分飲みたい。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 173,
        "raw": "[Subtitle(text=\"......\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "......",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 174,
        "raw": "[Subtitle(text=\"サラ叔母さんに会いたい。私は悪い子に育ってしまったよ、ごめんなさい。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "サラ叔母さんに会いたい。私は悪い子に育ってしまったよ、ごめんなさい。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 175,
        "raw": "[Subtitle(text=\"「クソッ。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「クソッ。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 176,
        "raw": "[Subtitle(text=\"「クソッ、誰が願いを叶えてくれるというんだ？　もう祈りも尽き果てた。知ってるものにも知らないものにも祈ったではないか。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「クソッ、誰が願いを叶えてくれるというんだ？　もう祈りも尽き果てた。知ってるものにも知らないものにも祈ったではないか。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 177,
        "raw": "[Subtitle(text=\"「もし今、法を語るリーベリの修道士が目の前に現れたとしたら、思いっきりぶん殴ってやる。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「もし今、法を語るリーベリの修道士が目の前に現れたとしたら、思いっきりぶん殴ってやる。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 178,
        "raw": "[Subtitle(text=\"「もういいさ、そうだな。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「もういいさ、そうだな。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 179,
        "raw": "[Subtitle(text=\"「全ての人の願いが叶いますように。幸せでありますように。健康でありますように。素晴らしい生活を送れますように。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「全ての人の願いが叶いますように。幸せでありますように。健康でありますように。素晴らしい生活を送れますように。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 180,
        "raw": "[Subtitle(text=\"「もう誰も苦しみませんように。痛めつけられませんように。みんなが笑い合って、涙がこの大地から消えますように。飢えも無くなりますように。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「もう誰も苦しみませんように。痛めつけられませんように。みんなが笑い合って、涙がこの大地から消えますように。飢えも無くなりますように。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 181,
        "raw": "[Subtitle(text=\"「何一つ無駄ではありませんように。」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「何一つ無駄ではありませんように。」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 182,
        "raw": "[Subtitle(text=\"「全てが──」\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "「全てが──」",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 183,
        "raw": "[Subtitle(text=\"長い線の後、筆跡はここで途絶えた。\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "長い線の後、筆跡はここで途絶えた。",
