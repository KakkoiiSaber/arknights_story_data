        "focus": "m"
    },
    {
        "id": 140,
        "raw": "[name=\"ベアード\"]こんなとこにいたの、「次期会員」さん。",
        "type": "dialog",
        "speaker": "ベアード",
        "content": "こんなとこにいたの、「次期会員」さん。"
