        "type": "camera_shake",
        "duration": "1.5,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "15,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 64,
        "raw": "[name=\"感染者\"]   俺が何をしたっていうんだ！　頼むよ、通してくれ！！",
        "type": "dialog",
        "speaker": "感染者",
        "content": "俺が何をしたっていうんだ！　頼むよ、通してくれ！！"
    },
    {
        "id": 65,
        "raw": "[name=\"感染者\"]   俺たちは化け物なんかじゃないんだぞ！！",
        "type": "dialog",
        "speaker": "感染者",
        "content": "俺たちは化け物なんかじゃないんだぞ！！"
