        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"近衛局隊員\"]   この感染者たちが、我々の指示に従わないものでして……",
        "type": "dialog",
        "speaker": "近衛局隊員",
        "content": "この感染者たちが、我々の指示に従わないものでして……"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_015_lmg\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"チェン\"]   ……そのくらい、見ればわかる。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……そのくらい、見ればわかる。"
    },
    {
        "id": 70,
        "raw": "[name=\"チェン\"]   もういい。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "もういい。"
    },
