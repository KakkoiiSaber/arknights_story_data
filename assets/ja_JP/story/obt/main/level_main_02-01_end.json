        "name": "char_010_chen_1.png"
    },
    {
        "id": 60,
        "raw": "[name=\"チェン\"]   ――何事だ。状況を報告しろ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――何事だ。状況を報告しろ。"
