        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 53,
        "raw": "[name=\"チェン\"]   狼狽えるな！",
        "type": "dialog",
        "speaker": "チェン",
        "content": "狼狽えるな！"
    },
    {
        "id": 54,
        "raw": "[name=\"チェン\"]   第一部隊、警戒態勢を！　狙撃手は配置につけ！",
        "type": "dialog",
        "speaker": "チェン",
        "content": "第一部隊、警戒態勢を！　狙撃手は配置につけ！"
    },
