    },
    {
        "id": 26,
        "raw": "[name=\"近衛局隊員\"]   ……では、扱い方はわかるか？",
        "type": "dialog",
        "speaker": "近衛局隊員",
        "content": "……では、扱い方はわかるか？"
    },
    {
        "id": 27,
