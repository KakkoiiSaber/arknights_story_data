    },
    {
        "id": 42,
        "raw": "[name=\"アーミヤ\"]   ……何も、怖くなんて……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……何も、怖くなんて……"
    },
    {
        "id": 43,
        "raw": "[name=\"アーミヤ\"]   …………いえ。ドクターの言う通りです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "…………いえ。ドクターの言う通りです。"
    },
    {
        "id": 44,
        "raw": "[name=\"アーミヤ\"]   ……また失うことになったらと思うと、どうしても怖くて……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……また失うことになったらと思うと、どうしても怖くて……"
