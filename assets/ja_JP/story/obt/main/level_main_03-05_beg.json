    },
    {
        "id": 102,
        "raw": "[name=\"ホシグマ\"]   レユニオンが……引き返して来る……！？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "レユニオンが……引き返して来る……！？"
    },
    {
        "id": 103,
        "raw": "[name=\"ホシグマ\"]   一体、何のつもりだ？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "一体、何のつもりだ？"
