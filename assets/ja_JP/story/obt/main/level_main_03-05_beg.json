        "name": "char_002_amiya_1#4"
    },
    {
        "id": 55,
        "raw": "[name=\"アーミヤ\"]   ……はい。後悔は、していません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……はい。後悔は、していません。"
    },
    {
        "id": 56,
        "raw": "[name=\"アーミヤ\"]   ……と、いうより……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……と、いうより……"
    },
    {
        "id": 57,
        "raw": "[name=\"アーミヤ\"]   ドクターのためなら、相手が何を背負っていようと、殺めることに後悔はしません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ドクターのためなら、相手が何を背負っていようと、殺めることに後悔はしません。"
    },
    {
        "id": 58,
        "raw": "[name=\"アーミヤ\"]   ですが……本当は、もっといい方法があったはずだとも思います。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ですが……本当は、もっといい方法があったはずだとも思います。"
    },
    {
        "id": 59,
        "raw": "[name=\"アーミヤ\"]   ……私がそれを見つけ出すことができなかったから、彼の命を奪うことになってしまったんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……私がそれを見つけ出すことができなかったから、彼の命を奪うことになってしまったんです。"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   その一点だけは……悔やまずにいられません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "その一点だけは……悔やまずにいられません。"
    },
