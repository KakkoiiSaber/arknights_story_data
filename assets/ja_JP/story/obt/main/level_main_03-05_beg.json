        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 49,
        "raw": "[name=\"アーミヤ\"]   どう言えばいいのかも、わからないんですが……それでも……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "どう言えばいいのかも、わからないんですが……それでも……"
    },
    {
        "id": 50,
        "raw": "[name=\"アーミヤ\"]   この力は……人を傷つけるためだけのものではないんです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "この力は……人を傷つけるためだけのものではないんです。"
    },
    {
        "id": 51,
        "raw": "[name=\"アーミヤ\"]   だから……ドクターには、見られたくありませんでした……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "だから……ドクターには、見られたくありませんでした……"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]   ……私が、誰かの命を奪うところなんて。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……私が、誰かの命を奪うところなんて。"
