        "type": "character"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 51,
        "raw": "[name=\"メフィスト\"]  わお、いい表情するじゃないか。もっと苦しんで見せてよ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "わお、いい表情するじゃないか。もっと苦しんで見せてよ！"
    },
    {
        "id": 52,
        "raw": "[name=\"メフィスト\"]  ――さあ、今だ！　C7へ！　奴らのルークを蹴散らせ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "――さあ、今だ！　C7へ！　奴らのルークを蹴散らせ！"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 54,
        "raw": "[name=\"アーミヤ\"]  術師！？　一体どこから！？　――まさか、重装兵の背後に隠れて……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "術師！？　一体どこから！？　――まさか、重装兵の背後に隠れて……！"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
