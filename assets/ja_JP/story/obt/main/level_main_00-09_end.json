        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 47,
        "raw": "[name=\"Ace\"]   っ、前衛オペレーター！　奴らを抑えろ！",
        "type": "dialog",
        "speaker": "Ace",
        "content": "っ、前衛オペレーター！　奴らを抑えろ！"
    },
    {
