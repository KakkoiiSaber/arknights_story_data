    },
    {
        "id": 14,
        "raw": "[name=\"医療オペレーター\"]   きゃっ――！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "きゃっ――！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_016_medic\", focus=1)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_016_medic",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"前衛オペレーター\"]  ！　危ない！！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "！　危ない！！"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_013_riop\", name2=\"char_016_medic\", focus=2)]",
        "type": "character",
        "name": "char_013_riop",
        "name2": "char_016_medic",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"医療オペレーター\"]  だ……大丈夫です、このくらい……かすり傷ですから……！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "だ……大丈夫です、このくらい……かすり傷ですから……！"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 20,
        "raw": "[name=\"アーミヤ\"]  包囲網が、少しずつ狭まってきています……早くここから抜け出さないと……！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "包囲網が、少しずつ狭まってきています……早くここから抜け出さないと……！"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"ドーベルマン\"]  そうは言っても、今の人数では守りに入るしかない……！　包囲自体の突破口は見つけたが、増援がなければどうにもならんぞ！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "そうは言っても、今の人数では守りに入るしかない……！　包囲自体の突破口は見つけたが、増援がなければどうにもならんぞ！"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 24,
        "raw": "[name=\"アーミヤ\"]  ……わかりました。であれば、もう少しだけ耐えてください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……わかりました。であれば、もう少しだけ耐えてください！"
    },
    {
        "id": 25,
        "raw": "[name=\"アーミヤ\"]  敵方の先鋒には、我々――術師オペレーターが対応します！　みなさんは、狙撃手を優先的に攻撃してください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "敵方の先鋒には、我々――術師オペレーターが対応します！　みなさんは、狙撃手を優先的に攻撃してください！"
    },
    {
        "id": 26,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 27,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 29,
        "raw": "[name=\"メフィスト\"]  アハハ！　いいねえ、その調子だ！　――F3からE5へ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "アハハ！　いいねえ、その調子だ！　――F3からE5へ！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 31,
        "raw": "[name=\"ドーベルマン\"]   チッ、あのガキ……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "チッ、あのガキ……！"
    },
    {
        "id": 32,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 33,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 35,
        "raw": "[name=\"メフィスト\"]  素晴らしい！　そのまま行くよ！　――次はB4からB5だ！",
        "type": "dialog",
        "speaker": "メフィスト",
        "content": "素晴らしい！　そのまま行くよ！　――次はB4からB5だ！"
    },
    {
        "id": 36,
        "raw": "[character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop"
    },
    {
        "id": 37,
        "raw": "[name=\"前衛オペレーター\"]  ！　敵が後方から回り込んできます！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "！　敵が後方から回り込んできます！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 39,
        "raw": "[name=\"アーミヤ\"]  であれば、牽制を！　重装オペレーターを二人、狙撃オペレーターを一人、対応に回してください！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "であれば、牽制を！　重装オペレーターを二人、狙撃オペレーターを一人、対応に回してください！"
    },
    {
        "id": 40,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 41,
        "raw": "[Character]",
        "type": "character"
    },
    {
