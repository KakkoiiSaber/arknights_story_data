    {
        "id": 71,
        "raw": "[name=\"前衛オペレーター\"]  ぐ、ッ……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "ぐ、ッ……"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
