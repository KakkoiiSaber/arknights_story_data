    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 6,
        "raw": "[name=\"アーミヤ\"]   えっ……もしもし？　フロストリーフさん……！？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "えっ……もしもし？　フロストリーフさん……！？"
    },
    {
        "id": 7,
        "raw": "[name=\"アーミヤ\"]   一体、何が――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "一体、何が――"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 9,
        "raw": "[name=\"前衛オペレーター\"]   ――こちら、第二偵察隊！　アーミヤさん、聞こえますか！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "――こちら、第二偵察隊！　アーミヤさん、聞こえますか！"
    },
    {
        "id": 10,
        "raw": "[name=\"前衛オペレーター\"]   我々は現在、廃都市から撤退中です！　というのも……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "我々は現在、廃都市から撤退中です！　というのも……"
    },
    {
        "id": 11,
        "raw": "[name=\"前衛オペレーター\"]   レユニオン……が……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "レユニオン……が……"
    },
    {
        "id": 12,
        "raw": "[name=\"前衛オペレーター\"]   ……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "……"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 14,
        "raw": "[name=\"アーミヤ\"]   また、通信が……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "また、通信が……"
    },
    {
        "id": 15,
        "raw": "[name=\"アーミヤ\"]   っ、第三偵察隊！　聞こえたら応答してください、第三偵察隊！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "っ、第三偵察隊！　聞こえたら応答してください、第三偵察隊！"
    },
    {
        "id": 16,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_010_chen_1#3\")]",
        "type": "character",
        "name": "char_010_chen_1#3"
    },
    {
        "id": 18,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_010_chen_1#3\", focus=-1)]",
        "type": "character",
        "name": "char_010_chen_1#3",
        "focus": -1
    },
    {
        "id": 20,
        "raw": "[name=\"ケルシー\"]   ――アーミヤ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "――アーミヤ。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   ！　ケルシー先生！　今、どこにいますか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "！　ケルシー先生！　今、どこにいますか？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 24,
        "raw": "[name=\"ケルシー\"]   ロドス本艦のブリッジだ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "ロドス本艦のブリッジだ。"
    },
    {
        "id": 25,
        "raw": "[name=\"ケルシー\"]   君に頼みがあるのだが――",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "君に頼みがあるのだが――"
    },
    {
        "id": 26,
        "raw": "[name=\"ケルシー\"]   隣にいるだろうチェン警司に、一つ聞いてみてくれないか。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "隣にいるだろうチェン警司に、一つ聞いてみてくれないか。"
    },
    {
        "id": 27,
        "raw": "[name=\"ケルシー\"]   「龍門はいつまで下らん意地を張り続けるつもりだ？」と。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "「龍門はいつまで下らん意地を張り続けるつもりだ？」と。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5"
    },
    {
        "id": 29,
        "raw": "[name=\"チェン\"]   ……今の言葉、聞かなかったことにしておこう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……今の言葉、聞かなかったことにしておこう。"
    },
    {
        "id": 30,
        "raw": "[name=\"チェン\"]   とはいえ、確かにこれは一刻を争う状況だな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "とはいえ、確かにこれは一刻を争う状況だな。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 32,
        "raw": "[name=\"ホシグマ\"]   報告書をお持ちしました。……おや、どうかなさいましたか？　お二人とも、随分険しい顔ですね。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "報告書をお持ちしました。……おや、どうかなさいましたか？　お二人とも、随分険しい顔ですね。"
    },
    {
        "id": 33,
        "raw": "[name=\"ホシグマ\"]   ――もしや、緊急の任務でしょうか？",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "――もしや、緊急の任務でしょうか？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 35,
        "raw": "[name=\"チェン\"]   ああ。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ああ。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 37,
        "raw": "[name=\"アーミヤ\"]   みなさん、準備をお願いします。すぐに出発しますので。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "みなさん、準備をお願いします。すぐに出発しますので。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"アーミヤ\"]   ――チェン隊長。この救援任務のため、我々は龍門に対し、近衛局を派遣しての協力を要請します。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――チェン隊長。この救援任務のため、我々は龍門に対し、近衛局を派遣しての協力を要請します。"
    },
    {
        "id": 40,
        "raw": "[name=\"アーミヤ\"]   あの場所には、一時的にレユニオンの司令部もおかれているようですし――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あの場所には、一時的にレユニオンの司令部もおかれているようですし――"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"アーミヤ\"]   通信が途切れた今も、偵察隊のみなさんは、それぞれの場所で抵抗を続けているはずですから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "通信が途切れた今も、偵察隊のみなさんは、それぞれの場所で抵抗を続けているはずですから。"
    },
