    },
    {
        "id": 187,
        "raw": "[name=\"メテオリーテ\"]  また飛び降りてきたっ！？",
        "type": "dialog",
        "speaker": "メテオリーテ",
        "content": "また飛び降りてきたっ！？"
    },
    {
        "id": 188,
        "raw": "[Character(name=\"char_219_meteo_1\",name2=\"char_193_frostl_1#5\",focus=2)]",
        "type": "character",
        "name": "char_219_meteo_1",
        "name2": "char_193_frostl_1#5",
        "focus": 2
    },
    {
        "id": 189,
        "raw": "[name=\"フロストリーフ\"]  ああ、また飛び降りてきたな。",
        "type": "dialog",
        "speaker": "フロストリーフ",
        "content": "ああ、また飛び降りてきたな。"
    },
    {
        "id": 190,
        "raw": "[Character(name=\"char_002_amiya_1#5\")]",
        "type": "character",
        "name": "char_002_amiya_1#5"
    },
    {
        "id": 191,
        "raw": "[name=\"アーミヤ\"]  ……。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……。"
    },
    {
        "id": 192,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 193,
        "raw": "[playsound(key=\"$d_gen_transmissionget\", volume=0.4)]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.4
    },
    {
        "id": 194,
        "raw": "[name=\"ブレイズ\"]  アーミヤちゃん、もしスカイダイビングに興味があれば、今度一緒に飛んであげるからね！",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "アーミヤちゃん、もしスカイダイビングに興味があれば、今度一緒に飛んであげるからね！"
    },
    {
        "id": 195,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 196,
        "raw": "[name=\"アーミヤ\"]  できれば遠慮させてください。ブレイズさん、小隊はどうされたんですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "できれば遠慮させてください。ブレイズさん、小隊はどうされたんですか？"
    },
    {
        "id": 197,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 198,
        "raw": "[playsound(key=\"$d_gen_transmissionget\", volume=0.4)]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.4
    },
    {
        "id": 199,
        "raw": "[name=\"ブレイズ\"]  都市の外で待機させてる。後で出迎えてくれるよ。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "都市の外で待機させてる。後で出迎えてくれるよ。"
    },
    {
        "id": 200,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 201,
        "raw": "[name=\"アーミヤ\"]  風切り音でよく聞こえません……一旦通信を切りますよ。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "風切り音でよく聞こえません……一旦通信を切りますよ。"
    },
    {
        "id": 202,
        "raw": "[name=\"アーミヤ\"]  皆さん……ブレイズさんの支援を行います。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "皆さん……ブレイズさんの支援を行います。"
    },
    {
        "id": 203,
        "raw": "[name=\"アーミヤ\"]  Dr.{@nickname}、この後彼女が何を言っても———",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "Dr.{@nickname}、この後彼女が何を言っても———"
    },
    {
        "id": 204,
        "raw": "[name=\"アーミヤ\"]  ……黙ってうなずいていれば大丈夫です。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……黙ってうなずいていれば大丈夫です。"
    },
