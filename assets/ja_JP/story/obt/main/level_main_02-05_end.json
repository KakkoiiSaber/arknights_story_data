        "name2": "char_012_misa_1#4",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"アーミヤ\"]   ……ええ。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……ええ。"
    },
    {
        "id": 20,
        "raw": "[name=\"アーミヤ\"]   先ほど少しお話しした、レユニオン・ムーブメントという組織……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "先ほど少しお話しした、レユニオン・ムーブメントという組織……"
    },
    {
        "id": 21,
        "raw": "[name=\"アーミヤ\"]   そこに所属する、感染者たちです。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "そこに所属する、感染者たちです。"
