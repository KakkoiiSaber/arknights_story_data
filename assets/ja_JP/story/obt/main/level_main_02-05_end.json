        "name2": "char_1002_nsabr_2",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"スカルシュレッダー\"]   大したことじゃないさ。",
        "type": "dialog",
        "speaker": "スカルシュレッダー",
        "content": "大したことじゃないさ。"
    },
    {
        "id": 37,
