        "type": "character",
        "name": "char_002_amiya_1#5"
    },
    {
        "id": 68,
        "raw": "[name=\"アーミヤ\"]   あ、あはは……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あ、あはは……"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 70,
        "raw": "[name=\"テキサス\"]   階段はこっちだ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "階段はこっちだ。"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 72,
        "raw": "[name=\"フランカ\"]   ねえ、これほんとに大丈夫なの？　包囲してくれって言ってるようなもんじゃない？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "ねえ、これほんとに大丈夫なの？　包囲してくれって言ってるようなもんじゃない？"
    },
    {
        "id": 73,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 74,
        "raw": "[name=\"エクシア\"]   うだうだ言ってないで早く来なって！　グズグズしてると、レユニオンに見つかって、マジで包囲されちゃうよ～？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "うだうだ言ってないで早く来なって！　グズグズしてると、レユニオンに見つかって、マジで包囲されちゃうよ～？"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 76,
        "raw": "[name=\"フランカ\"]   うだうだって、あのねえ……！　はあ、もういいわ。あなたたち、先に行っててくれる？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "うだうだって、あのねえ……！　はあ、もういいわ。あなたたち、先に行っててくれる？"
    },
    {
        "id": 77,
        "raw": "[name=\"フランカ\"]   あたしは入り口を溶接してくるから。そうすれば、少しは時間が稼げるでしょ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "あたしは入り口を溶接してくるから。そうすれば、少しは時間が稼げるでしょ。"
    },
