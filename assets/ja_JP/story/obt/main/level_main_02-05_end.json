        "name": "char_002_amiya_1#6"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   え、エクシアさん……？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "え、エクシアさん……？"
    },
    {
        "id": 61,
        "raw": "[name=\"アーミヤ\"]   上、って……ビルの上へ登るルートなんですか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "上、って……ビルの上へ登るルートなんですか？"
    },
    {
        "id": 62,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 63,
        "raw": "[CharacterCutin(widgetID=\"1\", name=\"char_103_angel_1\", style=\"cutin\", fadestyle= \"horiz_expand_center\", fadetime=0.5, offsetx=0, width=200, block=true)]",
        "type": "character_cutin",
        "widgetID": "1",
        "name": "char_103_angel_1",
        "style": "cutin",
        "fadetime": "0.5,",
        "offsetx": "0,",
        "width": "200,",
        "block": true
    },
    {
        "id": 64,
        "raw": "[name=\"エクシア\"]   うん、そーゆーこと！　ほらほら、あたしを信じてついてきて！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "うん、そーゆーこと！　ほらほら、あたしを信じてついてきて！"
    },
    {
        "id": 65,
        "raw": "[name=\"エクシア\"]   なんたってあたしは、龍門の道のことなら知りすぎなくらい知ってるんだから！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "なんたってあたしは、龍門の道のことなら知りすぎなくらい知ってるんだから！"
    },
    {
        "id": 66,
        "raw": "[CharacterCutin(widgetID=\"1\", fadetime=0.5, block=true)]",
        "type": "character_cutin",
        "widgetID": "1",
        "fadetime": "0.5,",
