    {
        "id": 57,
        "raw": "[name=\"エクシア\"]   ――アーミヤ～！　こっちこっち！　上だよ、上！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "――アーミヤ～！　こっちこっち！　上だよ、上！"
