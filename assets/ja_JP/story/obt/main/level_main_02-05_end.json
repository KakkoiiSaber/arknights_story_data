        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_012_misa_1#4",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"ミーシャ\"]   ……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……"
    },
    {
        "id": 17,
        "raw": "[name=\"ミーシャ\"]   さっきの人たちが、例の……",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "さっきの人たちが、例の……"
    },
    {
