        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 8,
        "raw": "[name=\"アーミヤ\"]   はい！　ミーシャさんも、行きましょう！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "はい！　ミーシャさんも、行きましょう！"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_012_misa_1#4\")]",
        "type": "character",
        "name": "char_012_misa_1#4"
    },
    {
        "id": 10,
        "raw": "[name=\"ミーシャ\"]   ……なんで……どうして、なの……？",
        "type": "dialog",
        "speaker": "ミーシャ",
        "content": "……なんで……どうして、なの……？"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 12,
        "raw": "[name=\"テキサス\"]   こっちだ、早く来い！",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "こっちだ、早く来い！"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 14,
        "raw": "[name=\"フランカ\"]   よし、近辺は問題なしね。追撃には注意して！",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "よし、近辺は問題なしね。追撃には注意して！"
    },
    {
        "id": 15,
