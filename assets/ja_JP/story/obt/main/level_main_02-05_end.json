    },
    {
        "id": 49,
        "raw": "[name=\"フランカ\"]   え？　本気で言ってるの？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "え？　本気で言ってるの？"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_102_texas_1\", name2=\"char_106_franka_1\", focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 51,
        "raw": "[name=\"テキサス\"]   地図上の指定地点はここだからな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "地図上の指定地点はここだからな。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 53,
        "raw": "[name=\"フランカ\"]   でも、これ……上へ行けってことじゃない？",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "でも、これ……上へ行けってことじゃない？"
    },
    {
        "id": 54,
        "raw": "[name=\"フランカ\"]   まあ、上とか言われたところで、意味はわかんないんだけど……",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "まあ、上とか言われたところで、意味はわかんないんだけど……"
    },
    {
