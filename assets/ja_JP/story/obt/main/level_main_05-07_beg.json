        "type": "character"
    },
    {
        "id": 50,
        "raw": "[name=\"レユニオン構成員\"]  ……クソッ、ここまでやってもまだ近衛局を殺れないのか！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "……クソッ、ここまでやってもまだ近衛局を殺れないのか！"
    },
    {
        "id": 51,
        "raw": "[PlayMusic(intro=\"$epic_intro\", key=\"$epic_loop\", volume=0.8, crossfade=1.5, delay=0.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta1_180603/m_bat_epic_intro.mp3",
        "key": "sound_beta_2/music/beta1_180603/m_bat_epic_loop.mp3",
        "volume": "0.8,",
        "crossfade": "1.5,",
        "delay": 0.5
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"チェン\"]  残念ながら、横になるのを私が許しても、敵は許してくれないようだな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "残念ながら、横になるのを私が許しても、敵は許してくれないようだな。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"ホシグマ\"]  仕方ありませんね。もう少しだけ無理をするとしましょうか。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "仕方ありませんね。もう少しだけ無理をするとしましょうか。"
    },
    {
        "id": 56,
        "raw": "[name=\"ホシグマ\"]  隊長、先に離脱して部隊を掌握してください。ここで足止めをされるわけにはいきません、それこそ敵の思うつぼです。",
        "type": "dialog",
        "speaker": "ホシグマ",
        "content": "隊長、先に離脱して部隊を掌握してください。ここで足止めをされるわけにはいきません、それこそ敵の思うつぼです。"
    },
    {
        "id": 57,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5"
