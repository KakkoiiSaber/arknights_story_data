    {
        "id": 3,
        "raw": "[PlayMusic(intro=\"$cherimp_intro\", key=\"$cherimp_loop\", volume=0.8, crossfade=1, delay=0.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta2_180603/m_bat_qiechengimp_intro.mp3",
        "key": "sound_beta_2/music/beta2_180603/m_bat_qiechengimp_loop.mp3",
        "volume": "0.8,",
        "crossfade": "1,",
        "delay": 0.5
    },
    {
        "id": 4,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 6,
        "raw": "[name=\"アーミヤ\"]   ふう……ここでは、観測用に場所を確保するだけでも一苦労ですね……まさか、あんなに大勢のレユニオンに対処することになるなんて……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ふう……ここでは、観測用に場所を確保するだけでも一苦労ですね……まさか、あんなに大勢のレユニオンに対処することになるなんて……"
    },
    {
        "id": 7,
        "raw": "[name=\"アーミヤ\"]   ……あっ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……あっ……"
    },
    {
        "id": 8,
        "raw": "[name=\"アーミヤ\"]   あそこにいるのは――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あそこにいるのは――"
    },
    {
        "id": 9,
        "raw": "[name=\"アーミヤ\"]   チェン隊長！",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "チェン隊長！"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 11,
        "raw": "[name=\"アーミヤ\"]   ――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――"
    },
    {
        "id": 12,
        "raw": "[name=\"アーミヤ\"]   （どうして……？　レユニオンの死体が、こんなに……）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（どうして……？　レユニオンの死体が、こんなに……）"
    },
    {
        "id": 13,
        "raw": "[name=\"アーミヤ\"]   （……まさか、これは全部彼女が……！？）",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "（……まさか、これは全部彼女が……！？）"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5"
    },
    {
        "id": 15,
        "raw": "[name=\"チェン\"]   ――！",
        "type": "dialog",
        "speaker": "チェン",
        "content": "――！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_010_chen_1#3\")]",
        "type": "character",
        "name": "char_010_chen_1#3"
    },
    {
        "id": 17,
        "raw": "[name=\"チェン\"]   キミたちか……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "キミたちか……"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_010_chen_1#6\")]",
        "type": "character",
        "name": "char_010_chen_1#6"
    },
    {
        "id": 19,
        "raw": "[name=\"チェン\"]   すまない。衝動的に動いてしまった。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "すまない。衝動的に動いてしまった。"
    },
    {
        "id": 20,
        "raw": "[name=\"チェン\"]   これが罠だとすれば、まんまとはめられたな……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "これが罠だとすれば、まんまとはめられたな……"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"アーミヤ\"]   いえ、大丈夫です。現状、作戦から大きく逸脱したわけではありませんしね。……ただ、一つお聞きしたいのですが――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "いえ、大丈夫です。現状、作戦から大きく逸脱したわけではありませんしね。……ただ、一つお聞きしたいのですが――"
    },
    {
        "id": 23,
        "raw": "[name=\"アーミヤ\"]   先ほどの人影は……もしかして、タルラだったんでしょうか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "先ほどの人影は……もしかして、タルラだったんでしょうか？"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 26,
        "raw": "[name=\"チェン\"]   ……いいや。気にすることはない。恐らく、私の見間違えだろう。奴がここにいるとは思えんしな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……いいや。気にすることはない。恐らく、私の見間違えだろう。奴がここにいるとは思えんしな。"
    },
    {
        "id": 27,
        "raw": "[name=\"チェン\"]   それに、物事には優先順位というものがある。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "それに、物事には優先順位というものがある。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"チェン\"]   ……私が指揮を務めなければ、近衛局の任務遂行が困難となってしまうだろう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……私が指揮を務めなければ、近衛局の任務遂行が困難となってしまうだろう。"
    },
    {
        "id": 30,
        "raw": "[name=\"チェン\"]   特に、このような状況では……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "特に、このような状況では……"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"チェン\"]   ……しかし、思いのほか事態は複雑だな。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……しかし、思いのほか事態は複雑だな。"
    },
    {
        "id": 33,
        "raw": "[name=\"チェン\"]   この様子を見るに、一人で深入りするにはリスクが高すぎる。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "この様子を見るに、一人で深入りするにはリスクが高すぎる。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"アーミヤ\"]   私もそう思います。ロドスとしても、チェン隊長には一度、近衛局のみなさんの元へ戻っていただけたらと。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私もそう思います。ロドスとしても、チェン隊長には一度、近衛局のみなさんの元へ戻っていただけたらと。"
    },
    {
        "id": 36,
        "raw": "[name=\"アーミヤ\"]   この場所には、天災で残された源石が無数に広がっていますから……健康体の方には、よりリスクが高い場所ですし。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "この場所には、天災で残された源石が無数に広がっていますから……健康体の方には、よりリスクが高い場所ですし。"
    },
    {
        "id": 37,
        "raw": "[name=\"アーミヤ\"]   感染防護用の道具は持ってきていますが、どれだけ持つかはわかりませんしね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "感染防護用の道具は持ってきていますが、どれだけ持つかはわかりませんしね……"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"チェン\"]   ならば、キミたちはどうするんだ？",
        "type": "dialog",
        "speaker": "チェン",
        "content": "ならば、キミたちはどうするんだ？"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"アーミヤ\"]   ロドスの作戦方針は変わりません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ロドスの作戦方針は変わりません。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"アーミヤ\"]   確かに、龍門を守り、脅威を排除することも私たちの任務ではありますが――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "確かに、龍門を守り、脅威を排除することも私たちの任務ではありますが――"
    },
    {
        "id": 44,
        "raw": "[name=\"アーミヤ\"]   我々がここを訪れた一番の目的は、ロドスの仲間を救出することですので。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "我々がここを訪れた一番の目的は、ロドスの仲間を救出することですので。"
    },
    {
        "id": 45,
        "raw": "[name=\"アーミヤ\"]   私たちロドスは、誰のことも諦めません。……諦めたく、ありませんから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "私たちロドスは、誰のことも諦めません。……諦めたく、ありませんから。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"チェン\"]   ……",
        "type": "dialog",
        "speaker": "チェン",
        "content": "……"
    },
    {
        "id": 48,
        "raw": "[name=\"チェン\"]   では、私は一度隊員たちのもとへ戻り――状況が許せば、またキミたちと合流するとしよう。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "では、私は一度隊員たちのもとへ戻り――状況が許せば、またキミたちと合流するとしよう。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"アーミヤ\"]   わかりました。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "わかりました。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 52,
        "raw": "[name=\"アーミヤ\"]   あっ、チェン隊長！　警護のために、何人かオペレーターを――",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あっ、チェン隊長！　警護のために、何人かオペレーターを――"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 54,
        "raw": "[name=\"チェン\"]   いいや、必要ない。",
        "type": "dialog",
        "speaker": "チェン",
        "content": "いいや、必要ない。"
    },
    {
        "id": 55,
        "raw": "[Dialog(fadetime=0.6)]",
        "type": "dialog_marker",
        "fadetime": 0.6
    },
    {
        "id": 56,
        "raw": "[Character(fadetime=0.6)]",
        "type": "character",
        "fadetime": 0.6
    },
    {
        "id": 57,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 59,
        "raw": "[name=\"アーミヤ\"]   ……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……"
    },
    {
        "id": 60,
        "raw": "[name=\"アーミヤ\"]   あの人は、本当に強い人なんですね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "あの人は、本当に強い人なんですね……"
    },
    {
        "id": 61,
        "raw": "[name=\"アーミヤ\"]   ――ドクター？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "――ドクター？"
    },
    {
        "id": 62,
        "raw": "[name=\"アーミヤ\"]   ……大丈夫ですよ。問題はありません。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……大丈夫ですよ。問題はありません。"
    },
    {
        "id": 63,
        "raw": "[name=\"アーミヤ\"]   確かに、またロドスだけで行動することにはなってしまいましたが……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "確かに、またロドスだけで行動することにはなってしまいましたが……"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 65,
        "raw": "[name=\"アーミヤ\"]   うつむいている場合ではありませんしね。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "うつむいている場合ではありませんしね。"
    },
    {
        "id": 66,
        "raw": "[name=\"アーミヤ\"]   何しろ、ジェシカさんたちは今も、助けを待っているんですから。",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "何しろ、ジェシカさんたちは今も、助けを待っているんですから。"
    },
