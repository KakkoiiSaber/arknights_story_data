    {
        "id": 35,
        "raw": "[Character(name=\"char_016_medic\")]",
        "type": "character",
        "name": "char_016_medic.png"
    },
    {
        "id": 36,
        "raw": "[name=\"医療オペレーター\"]   ……あ……！",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "……あ……！"
    },
    {
        "id": 37,
        "raw": "[name=\"医療オペレーター\"]   れ、レユニオンが……あんなに、たくさん……",
        "type": "dialog",
        "speaker": "医療オペレーター",
        "content": "れ、レユニオンが……あんなに、たくさん……"
    },
    {
        "id": 38,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 39,
        "raw": "[PlaySound(key=\"$d_gen_soldiersrun\",volume=1)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_soldiersrun.mp3",
        "volume": 1
    },
    {
        "id": 40,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 41,
        "raw": "[Delay(time=2)]",
        "type": "delay",
        "time": 2
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 43,
        "raw": "[name=\"ドーベルマン\"]   ……「追いついてきた」わけではない。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……「追いついてきた」わけではない。"
    },
    {
        "id": 44,
        "raw": "[name=\"ドーベルマン\"]   あの連中は――",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "あの連中は――"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 46,
        "raw": "[name=\"ニアール\"]   ――至る所に潜んでいたんだ。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "――至る所に潜んでいたんだ。"
    },
    {
        "id": 47,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 48,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 49,
        "raw": "[PlaySound(key=\"$d_gen_soldiersrun\",volume=1)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_soldiersrun.mp3",
        "volume": 1
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_1002_nsabr_2\",name2=\"char_1002_nsabr_2\",fadetime=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1002_nsabr_2",
        "fadetime": 1
    },
    {
        "id": 51,
        "raw": "[Delay(time=2)]",
        "type": "delay",
        "time": 2
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 53,
        "raw": "[name=\"ドーベルマン\"]   見ろ、そこら中の廃墟から這い出してくるぞ……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "見ろ、そこら中の廃墟から這い出してくるぞ……！"
    },
    {
        "id": 54,
        "raw": "[name=\"ドーベルマン\"]   クソッ、なんて数だ……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "クソッ、なんて数だ……"
    },
    {
        "id": 55,
        "raw": "[name=\"ドーベルマン\"]   しかし、これを見るに、あの連中が、実際に死の危険に晒されるまで天災を恐れなかったのも頷ける……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "しかし、これを見るに、あの連中が、実際に死の危険に晒されるまで天災を恐れなかったのも頷ける……！"
    },
    {
        "id": 56,
        "raw": "[name=\"ドーベルマン\"]   仮に、この天災が……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "仮に、この天災が……"
    },
    {
        "id": 57,
        "raw": "[name=\"ドーベルマン\"]   奴らの半数以上の命を奪ったのだとしても――",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "奴らの半数以上の命を奪ったのだとしても――"
    },
    {
        "id": 58,
        "raw": "[name=\"ドーベルマン\"]   ここにはまだ、我々を十数回は討ち果たせるほどの戦力が残っているのだから……！",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "ここにはまだ、我々を十数回は討ち果たせるほどの戦力が残っているのだから……！"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 60,
        "raw": "[name=\"ニアール\"]   ――だが――",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "――だが――"
    },
    {
        "id": 61,
        "raw": "[name=\"ニアール\"]   足を止めてはならない！　撤退ルート通りに進むんだ！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "足を止めてはならない！　撤退ルート通りに進むんだ！"
    },
    {
        "id": 62,
        "raw": "[name=\"ニアール\"]   開けた場所で立ち止まっては、いい的になる！　隊形を整えるにしても、広場の出口まで到達したあとにするんだ！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "開けた場所で立ち止まっては、いい的になる！　隊形を整えるにしても、広場の出口まで到達したあとにするんだ！"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_148_nearl_1#3\",name2=\"char_002_amiya_1#7\",focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1#3.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"アーミヤ\"]   ニアールさん……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "ニアールさん……"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_148_nearl_1#3\",name2=\"char_002_amiya_1#7\",focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#3.png",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 66,
        "raw": "[name=\"ニアール\"]   ――こうなれば、戦闘は避けられん。突破口を開き、混乱に乗じて脱出するしかないだろう。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "――こうなれば、戦闘は避けられん。突破口を開き、混乱に乗じて脱出するしかないだろう。"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_148_nearl_1#3\",name2=\"char_002_amiya_1#7\",focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1#3.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"アーミヤ\"]   本当に、うまくいくんでしょうか？",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "本当に、うまくいくんでしょうか？"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_148_nearl_1#3\",name2=\"char_002_amiya_1#7\",focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#3.png",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"ニアール\"]   望みは薄いかもしれないが、ほかに方法はない。それに……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "望みは薄いかもしれないが、ほかに方法はない。それに……"
    },
    {
        "id": 71,
        "raw": "[name=\"ニアール\"]   多勢に無勢の状況ながら、個々の力量でいえばその差は歴然だ。――我々ロドスにも、勝機はある！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "多勢に無勢の状況ながら、個々の力量でいえばその差は歴然だ。――我々ロドスにも、勝機はある！"
    },
    {
        "id": 72,
        "raw": "[name=\"ニアール\"]   総員、慌てず戦闘に備えよ！　防御陣形に移れ！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "総員、慌てず戦闘に備えよ！　防御陣形に移れ！"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 74,
        "raw": "[name=\"ドーベルマン\"]   ……それにしても……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……それにしても……"
    },
    {
        "id": 75,
        "raw": "[name=\"ドーベルマン\"]   この人数を前にすると……チェルノボーグを落とすことも、確かに不可能ではないと思わされる。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "この人数を前にすると……チェルノボーグを落とすことも、確かに不可能ではないと思わされる。"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 77,
        "raw": "[name=\"ニアール\"]   ……本当に……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "……本当に……"
    },
    {
        "id": 78,
        "raw": "[name=\"ニアール\"]   とてつもない数だ。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "とてつもない数だ。"
    },
    {
        "id": 79,
        "raw": "[name=\"ニアール\"]   レユニオンは……一体どこから、こうも大勢の感染者たちを集めてきたのだろうか？",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "レユニオンは……一体どこから、こうも大勢の感染者たちを集めてきたのだろうか？"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 81,
        "raw": "[name=\"ドーベルマン\"]   しかし、ここへ来てこの包囲網とは……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "しかし、ここへ来てこの包囲網とは……"
    },
    {
        "id": 82,
        "raw": "[name=\"ドーベルマン\"]   どうやら連中は、我々の実力を相当買っているらしいな。",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "どうやら連中は、我々の実力を相当買っているらしいな。"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop.png"
    },
    {
        "id": 84,
        "raw": "[name=\"前衛オペレーター\"]   ッ、報告！　レユニオンの大軍勢に……広場を包囲されました！",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "ッ、報告！　レユニオンの大軍勢に……広場を包囲されました！"
    },
    {
        "id": 85,
        "raw": "[name=\"前衛オペレーター\"]   ……って、あれ……？　敵の動きが止まって……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "……って、あれ……？　敵の動きが止まって……"
    },
    {
        "id": 86,
        "raw": "[name=\"前衛オペレーター\"]   ……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "……"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 88,
        "raw": "[name=\"アーミヤ\"]   ！　あっ……",
