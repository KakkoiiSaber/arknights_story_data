    {
        "id": 9,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 10,
        "raw": "[name=\"ドーベルマン\"]   はぁ、はぁっ……はぁ……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "はぁ、はぁっ……はぁ……"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_148_nearl_1#3\")]",
        "type": "character",
        "name": "char_148_nearl_1#3.png"
    },
    {
        "id": 12,
        "raw": "[name=\"ニアール\"]   よし……！　今のところ、順調に進んでいるな。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "よし……！　今のところ、順調に進んでいるな。"
    },
    {
        "id": 13,
        "raw": "[name=\"ニアール\"]   我々はレユニオンを退けることに成功し……",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "我々はレユニオンを退けることに成功し……"
    },
    {
        "id": 14,
        "raw": "[name=\"ニアール\"]   この天災も、収束傾向にあるようだ。",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "この天災も、収束傾向にあるようだ。"
    },
    {
        "id": 15,
        "raw": "[name=\"ニアール\"]   とはいえ、状況の悪さに変わりはない。……皆、改めて気を引き締めてくれ！",
        "type": "dialog",
        "speaker": "ニアール",
        "content": "とはいえ、状況の悪さに変わりはない。……皆、改めて気を引き締めてくれ！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#5\")]",
        "type": "character",
        "name": "char_002_amiya_1#5.png"
    },
    {
        "id": 17,
        "raw": "[name=\"アーミヤ\"]   ……それにしても、天災のせいで街中瓦礫だらけですね……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "……それにしても、天災のせいで街中瓦礫だらけですね……"
    },
    {
        "id": 18,
        "raw": "[name=\"アーミヤ\"]   建物が崩れて、道を塞いでしまっていますし……",
        "type": "dialog",
        "speaker": "アーミヤ",
        "content": "建物が崩れて、道を塞いでしまっていますし……"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 20,
        "raw": "[name=\"ドーベルマン\"]   その上、源石の増殖も見受けられるな……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "その上、源石の増殖も見受けられるな……"
    },
    {
        "id": 21,
        "raw": "[name=\"ドーベルマン\"]   脱出まであと一息だというのに、ここに来て邪魔ばかり入ってくるとは……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "脱出まであと一息だというのに、ここに来て邪魔ばかり入ってくるとは……"
    },
    {
        "id": 22,
        "raw": "[name=\"ドーベルマン\"]   もし、我々に――",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "もし、我々に――"
    },
    {
        "id": 23,
        "raw": "[name=\"ドーベルマン\"]   ……待て、これは……",
        "type": "dialog",
        "speaker": "ドーベルマン",
        "content": "……待て、これは……"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_014_riope\")]",
        "type": "character",
        "name": "char_014_riope.png"
    },
    {
        "id": 25,
        "raw": "[name=\"Ace\"]  ——",
        "type": "dialog",
        "speaker": "Ace",
        "content": "——"
    },
    {
        "id": 26,
        "raw": "[name=\"Ace\"]  来ているな……",
        "type": "dialog",
        "speaker": "Ace",
        "content": "来ているな……"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_013_riop\",focus=2)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"前衛オペレーター\"]   えっ……？　来てる、って……",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "えっ……？　来てる、って……"
    },
    {
        "id": 29,
        "raw": "[name=\"前衛オペレーター\"]   レユニオンですか？　まさか、もう追いついてきたとか！？",
        "type": "dialog",
        "speaker": "前衛オペレーター",
        "content": "レユニオンですか？　まさか、もう追いついてきたとか！？"
    },
    {
        "id": 30,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
