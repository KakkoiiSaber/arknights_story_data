    {
        "id": 13,
        "raw": "[name=\"グラニ\"]   なんとか突破した！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "なんとか突破した！"
    },
    {
        "id": 14,
        "raw": "[name=\"グラニ\"]   ボブおじさん、大丈――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "ボブおじさん、大丈――"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_220_grani#4\")]",
        "type": "character",
        "name": "char_220_grani#4"
    },
    {
        "id": 16,
        "raw": "[name=\"グラニ\"]   えっ？　脚の傷口のそれは――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "えっ？　脚の傷口のそれは――"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"avg_npc_008\")]",
        "type": "character",
        "name": "avg_npc_008"
    },
    {
        "id": 18,
        "raw": "[name=\"賞金稼ぎ\"]   あそこに討ち漏らした連中が居るぞ！　ワグニスク団の奴らかもしれん！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "あそこに討ち漏らした連中が居るぞ！　ワグニスク団の奴らかもしれん！"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010"
    },
    {
        "id": 20,
        "raw": "[name=\"ビッグ・ボブ\"]   これぐらい自分でなんとかなる。まずは敵を片付けよう！",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "これぐらい自分でなんとかなる。まずは敵を片付けよう！"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_220_grani#5\")]",
        "type": "character",
        "name": "char_220_grani#5"
    },
    {
        "id": 22,
        "raw": "[name=\"グラニ\"]   わかった。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "わかった。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
        "id": 24,
        "raw": "[name=\"賞金稼ぎ\"]   うん？",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "うん？"
    },
    {
        "id": 25,
        "raw": "[name=\"賞金稼ぎ\"]   このチビ……。",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "このチビ……。"
    },
    {
        "id": 26,
        "raw": "[name=\"賞金稼ぎ\"]   お、おい、なんだその顔は……。",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "お、おい、なんだその顔は……。"
    },
    {
        "id": 27,
        "raw": "[name=\"賞金稼ぎ\"]   く、来るな。蜂の巣にされてぇのか！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "く、来るな。蜂の巣にされてぇのか！"
    },
    {
