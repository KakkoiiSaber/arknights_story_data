    {
        "id": 77,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"グラニ\"]   よし、血は止まったよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "よし、血は止まったよ。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"ビッグ・ボブ\"]   いつも感染者をこうやって助けているのか？",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "いつも感染者をこうやって助けているのか？"
    },
    {
        "id": 81,
        "raw": "[name=\"ビッグ・ボブ\"]   怖くないのか……？",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "怖くないのか……？"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"グラニ\"]   あたしの仲間にも、感染者はたくさんいるけど、感染者かどうかなんて、普段はよく見ないと分からないし、誰が感染してるかなんて考えたことないよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "あたしの仲間にも、感染者はたくさんいるけど、感染者かどうかなんて、普段はよく見ないと分からないし、誰が感染してるかなんて考えたことないよ。"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"ビッグ・ボブ\"]   ほう？",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "ほう？"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#2",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"グラニ\"]   まぁ、お風呂の時には、さすがにわかるけどね。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "まぁ、お風呂の時には、さすがにわかるけどね。"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#2",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"ビッグ・ボブ\"]   ――フッ。そうか…。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "――フッ。そうか…。"
    },
    {
        "id": 90,
