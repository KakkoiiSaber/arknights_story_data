    },
    {
        "id": 40,
        "raw": "[name=\"ビッグ・ボブ\"]   これは……君一人で片づけたのか？",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "これは……君一人で片づけたのか？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"グラニ\"]   うん。そうだよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うん。そうだよ。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"ビッグ・ボブ\"]   驚いたな。その小さい体でよくここまで。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "驚いたな。その小さい体でよくここまで。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"グラニ\"]   そこに座ってじっとしてて。包帯巻くから。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "そこに座ってじっとしてて。包帯巻くから。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"ビッグ・ボブ\"]   なんてことないさ。起こしてもらえるか。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "なんてことないさ。起こしてもらえるか。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"グラニ\"]   ダメだよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "ダメだよ。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"ビッグ・ボブ\"]   ……さっき、見たんだろう。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "……さっき、見たんだろう。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"グラニ\"]   うん。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うん。"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=30, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 57,
        "raw": "[name=\"ビッグ・ボブ\"]   私の身体の結晶を見たなら分かっているはずだ！　君も感染したいのか！？",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "私の身体の結晶を見たなら分かっているはずだ！　君も感染したいのか！？"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"グラニ\"]   感染者を救うのが、あたしたちロドスの仕事だから。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "感染者を救うのが、あたしたちロドスの仕事だから。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#4",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"ビッグ・ボブ\"]   ロドス……。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "ロドス……。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_220_grani#4\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_220_grani#4",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 63,
        "raw": "[name=\"キャロル\"]   ロドスって……？　ヴィクトリアじゃないの……？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "ロドスって……？　ヴィクトリアじゃないの……？"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_220_grani#3\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_220_grani#3",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 65,
        "raw": "[name=\"グラニ\"]   元々はヴィクトリアの騎馬警官だったけど、今はロドスってところのオペレーターなんだ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "元々はヴィクトリアの騎馬警官だったけど、今はロドスってところのオペレーターなんだ。"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010"
    },
    {
        "id": 67,
        "raw": "[name=\"ビッグ・ボブ\"]   キャロル嬢ちゃんも離れた方がいい。私は感染者なんだ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "キャロル嬢ちゃんも離れた方がいい。私は感染者なんだ。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 69,
        "raw": "[name=\"キャロル\"]   私……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "私……。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"グラニ\"]   キャロル、少なくとも血は見ないほうがいいよ、下がってて。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "キャロル、少なくとも血は見ないほうがいいよ、下がってて。"
    },
