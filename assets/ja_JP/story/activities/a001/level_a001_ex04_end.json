        "fadetime": "1,focus=1"
    },
    {
        "id": 8,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 9,
        "raw": "[name=\"キャロル\"]   グラニ、もう行っちゃうの？　スカジさんは？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "グラニ、もう行っちゃうの？　スカジさんは？"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"グラニ\"]   うん、そろそろロドスに戻らないと。でもまた会いに来るよ。スカジは一人がいいって言って先に行っちゃった。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うん、そろそろロドスに戻らないと。でもまた会いに来るよ。スカジは一人がいいって言って先に行っちゃった。"
    },
    {
        "id": 12,
        "raw": "[name=\"グラニ\"]   スカジの破壊伝説が広まったから、賞金稼ぎはもうこの村に来ることはないと思う。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "スカジの破壊伝説が広まったから、賞金稼ぎはもうこの村に来ることはないと思う。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"キャロル\"]   えへへ、そうだね。村の設備や生産が生き返るにはまだ時間がかかりそうだけど……新しい生活がスタートできそう。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "えへへ、そうだね。村の設備や生産が生き返るにはまだ時間がかかりそうだけど……新しい生活がスタートできそう。"
    },
    {
        "id": 15,
        "raw": "[name=\"キャロル\"]   どうか気をつけてね。次は収穫の季節に遊びに来て！　バッチリおもてなしするから。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "どうか気をつけてね。次は収穫の季節に遊びに来て！　バッチリおもてなしするから。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#2",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"グラニ\"]   へへ、じゃあ約束だね！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "へへ、じゃあ約束だね！"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#2",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"キャロル\"]   そうだ、さっき郵便が届いたの。滴水村宛になっているけど受取人はグラニって書いてある。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "そうだ、さっき郵便が届いたの。滴水村宛になっているけど受取人はグラニって書いてある。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"グラニ\"]   あ、これはロドスの封筒だね。連絡所に入った通信を転記したものだと思う。ここじゃ通信も届かないからね。迷惑かけてごめんよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "あ、これはロドスの封筒だね。連絡所に入った通信を転記したものだと思う。ここじゃ通信も届かないからね。迷惑かけてごめんよ。"
    },
    {
        "id": 22,
        "raw": "[name=\"グラニ\"]   えーっと、内容は……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "えーっと、内容は……。"
    },
    {
        "id": 23,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "「グラニへ。スカジが我々に無断で滴水村へ向かった。ロドスから正式な任務は受けていない。出会ったら気をつけるように。",
        "type": "narration",
        "content": "「グラニへ。スカジが我々に無断で滴水村へ向かった。ロドスから正式な任務は受けていない。出会ったら気をつけるように。"
    },
    {
        "id": 25,
        "raw": "全てうまくいくように、祈っている。ニアール」",
        "type": "narration",
        "content": "全てうまくいくように、祈っている。ニアール」"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#2",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"グラニ\"]   やっぱりね…。そんなことだろうと思ったよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "やっぱりね…。そんなことだろうと思ったよ。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#2",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"キャロル\"]   グラニ、何してるの？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "グラニ、何してるの？"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3.png"
    },
    {
        "id": 31,
        "raw": "[name=\"グラニ\"]   紙飛行機だよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "紙飛行機だよ。"
    },
    {
        "id": 32,
        "raw": "[name=\"グラニ\"]   ロドスの紙は紙質がいいから、遠くまでよく飛ぶんだ――――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "ロドスの紙は紙質がいいから、遠くまでよく飛ぶんだ――――"
    },
