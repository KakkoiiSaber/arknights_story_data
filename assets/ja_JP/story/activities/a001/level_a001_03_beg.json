    {
        "id": 66,
        "raw": "[name=\"ビッグ・ボブ\"]   ん？　止まれ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "ん？　止まれ。"
    },
    {
        "id": 67,
        "raw": "[name=\"ビッグ・ボブ\"]   何か変だ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "何か変だ。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"グラニ\"]   また罠？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "また罠？"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"ビッグ・ボブ\"]   いや。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "いや。"
    },
    {
        "id": 72,
        "raw": "[name=\"ビッグ・ボブ\"]   血の暗号だ……。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "血の暗号だ……。"
    },
    {
        "id": 73,
        "raw": "[name=\"ビッグ・ボブ\"]   「――怪物？　」",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "「――怪物？　」"
    },
    {
        "id": 74,
        "raw": "[name=\"ビッグ・ボブ\"]   どういう意味だ？　こんな暗号を使う賞金稼ぎは知らない。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "どういう意味だ？　こんな暗号を使う賞金稼ぎは知らない。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"グラニ\"]   ……あ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……あ。"
    },
    {
        "id": 77,
        "raw": "[name=\"グラニ\"]   まさか……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "まさか……。"
    },
    {
        "id": 78,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 79,
        "raw": "[name=\"賞金稼ぎ\"]   か、怪物だ！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "か、怪物だ！"
    },
    {
        "id": 80,
        "raw": "[name=\"賞金稼ぎ\"]   来るな！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "来るな！"
