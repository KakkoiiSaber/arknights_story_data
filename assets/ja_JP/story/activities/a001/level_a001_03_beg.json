        "raw": "[PlayMusic(intro=\"$m_dia_street_intro\", key=\"$m_dia_street_loop\", volume=0.6,crossfade=1)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta3_181101/m_dia_street_intro.mp3",
        "key": "audio/sound_beta_2/music/beta3_181101/m_dia_street_loop.mp3",
        "volume": "0.6,crossfade=1"
