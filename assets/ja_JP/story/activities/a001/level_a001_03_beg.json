        "content": "やっぱり君だったんだね！"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"グラニ\"]   スカジ……スカジでしょ？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "スカジ……スカジでしょ？"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 95,
        "raw": "[name=\"スカジ\"]   ――あなたが滴水村の村長を連れていたのね。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "――あなたが滴水村の村長を連れていたのね。"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#1\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 97,
        "raw": "[name=\"グラニ\"]   え、なんで？　キャロルを知ってるの……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "え、なんで？　キャロルを知ってるの……。"
    },
    {
