        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 99,
        "raw": "[name=\"スカジ\"]   彼女を渡しなさい。今すぐに。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "彼女を渡しなさい。今すぐに。"
