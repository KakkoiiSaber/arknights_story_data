    {
        "id": 7,
        "raw": "[name=\"賞金稼ぎ\"]   ぐ……。",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "ぐ……。"
    },
    {
        "id": 8,
        "raw": "[name=\"賞金稼ぎ\"]   お、お前が俺たちの仲間を……全部やっちまったのか？",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "お、お前が俺たちの仲間を……全部やっちまったのか？"
    },
    {
        "id": 9,
        "raw": "[Delay=1]",
        "type": "delay",
        "time": 1.0
    },
    {
        "id": 10,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 11,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 12,
        "raw": "[name=\"賞金稼ぎ\"]   ……く、来るな！　頼む！　来ないでくれ！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "……く、来るな！　頼む！　来ないでくれ！"
    },
    {
        "id": 13,
        "raw": "[name=\"賞金稼ぎ\"]   お、俺の金貨は全部やる！　武器も全部やる！　お前が欲しいものは全部――",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "お、俺の金貨は全部やる！　武器も全部やる！　お前が欲しいものは全部――"
    },
    {
        "id": 14,
        "raw": "[name=\"？？？\"]    あの子はどこいるの。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "あの子はどこいるの。"
    },
    {
        "id": 15,
        "raw": "[name=\"賞金稼ぎ\"]   何のことだ――？？",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "何のことだ――？？"
    },
    {
        "id": 16,
        "raw": "[name=\"賞金稼ぎ\"]   近づくな――！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "近づくな――！"
    },
    {
        "id": 17,
        "raw": "[name=\"賞金稼ぎ\"]   この化け――",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "この化け――"
    },
