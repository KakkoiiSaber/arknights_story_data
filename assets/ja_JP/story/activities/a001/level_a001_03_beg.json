    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_010\",fadetime=1)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "fadetime": 1
    },
    {
        "id": 26,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 27,
        "raw": "[name=\"ビッグ・ボブ\"]   ……この岩は……。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "……この岩は……。"
    },
    {
        "id": 28,
        "raw": "[name=\"ビッグ・ボブ\"]   君たち、そのまま私についてきてくれ。足元には気をつけて。私の足跡を踏むんだ。どこにも触れないように。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "君たち、そのまま私についてきてくれ。足元には気をつけて。私の足跡を踏むんだ。どこにも触れないように。"
    },
    {
        "id": 29,
        "raw": "[name=\"ビッグ・ボブ\"]   この森、私が想像していたよりずっと危険だ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "この森、私が想像していたよりずっと危険だ。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3.png"
    },
    {
        "id": 31,
        "raw": "[name=\"グラニ\"]   あの岩に何か書いてあったの？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "あの岩に何か書いてあったの？"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"ビッグ・ボブ\"]   これは賞金稼ぎが残した暗号だ。ここに示してある通りに動かなければ、罠にかかるというものだ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "これは賞金稼ぎが残した暗号だ。ここに示してある通りに動かなければ、罠にかかるというものだ。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"グラニ\"]   じゃあトラップを避けながら進んでいるの？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "じゃあトラップを避けながら進んでいるの？"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010.png"
    },
    {
        "id": 37,
        "raw": "[name=\"ビッグ・ボブ\"]   ああ、私の動きを見ていろ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "ああ、私の動きを見ていろ。"
    },
    {
        "id": 38,
        "raw": "[name=\"ビッグ・ボブ\"]   ――縄とベアートラップを組み合わせたものだな、なんとも古臭いおもちゃだ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "――縄とベアートラップを組み合わせたものだな、なんとも古臭いおもちゃだ。"
    },
    {
        "id": 39,
        "raw": "[Blocker(a=1, r=0,g=0, b=0, fadetime=1.5, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,g=0,",
        "b": "0,",
        "fadetime": "1.5,",
        "block": true
    },
    {
        "id": 40,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 41,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 42,
        "raw": "[Blocker(a=0, fadetime=1.5, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "1.5,",
        "block": true
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010.png"
    },
    {
        "id": 44,
        "raw": "[name=\"ビッグ・ボブ\"]   さらにここは木の裏にハンマーが隠されている。何も知らずに進めば直撃だろうな。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "さらにここは木の裏にハンマーが隠されている。何も知らずに進めば直撃だろうな。"
    },
    {
        "id": 45,
        "raw": "[name=\"ビッグ・ボブ\"]   そこだ、キャロルお嬢ちゃん、気をつけろ！",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "そこだ、キャロルお嬢ちゃん、気をつけろ！"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"キャロル\"]   は、はい？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "は、はい？"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"ビッグ・ボブ\"]   そこから一歩でも外れると、中が針山になっている落とし穴に落ちることになる。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "そこから一歩でも外れると、中が針山になっている落とし穴に落ちることになる。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"キャロル\"]   あっ……！",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "あっ……！"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3.png"
    },
    {
        "id": 53,
        "raw": "[name=\"グラニ\"]   さすが賞金稼ぎ、同業者の罠はお手の物って感じだね。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "さすが賞金稼ぎ、同業者の罠はお手の物って感じだね。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010.png"
    },
    {
        "id": 55,
        "raw": "[name=\"ビッグ・ボブ\"]   もちろんだ。私はかつて――",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "もちろんだ。私はかつて――"
    },
    {
        "id": 56,
        "raw": "[name=\"ビッグ・ボブ\"]   ……。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "……。"
    },
    {
        "id": 57,
        "raw": "[name=\"ビッグ・ボブ\"]   罠を全て避けて進むのは現実的じゃないな。やはり全て解除しながら進むのが効率がいい。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "罠を全て避けて進むのは現実的じゃないな。やはり全て解除しながら進むのが効率がいい。"
    },
    {
        "id": 58,
        "raw": "[name=\"ビッグ・ボブ\"]   わざわざ罠まみれの道を進むなんて、これを仕掛けた連中なら考えないだろう。だからこそこのルートは我々にとって奴らの裏をかいた最も安全なルートというわけだ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "わざわざ罠まみれの道を進むなんて、これを仕掛けた連中なら考えないだろう。だからこそこのルートは我々にとって奴らの裏をかいた最も安全なルートというわけだ。"
    },
    {
        "id": 59,
        "raw": "[name=\"ビッグ・ボブ\"]   行こう。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "行こう。"
    },
