    },
    {
        "id": 256,
        "raw": "[name=\"賞金稼ぎ\"]   ダメだ、見つからねぇ。もう一度すべての場所を洗いなおせ！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "ダメだ、見つからねぇ。もう一度すべての場所を洗いなおせ！"
    },
    {
        "id": 257,
        "raw": "[PlayMusic(intro=\"$indust_intro\", key=\"$indust_loop\", volume=0.6, crossfade=1.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta1_180603/m_bat_indust_intro.mp3",
        "key": "audio/sound_beta_2/music/beta1_180603/m_bat_indust_loop.mp3",
        "volume": "0.6,",
        "crossfade": 1.5
    },
    {
        "id": 258,
        "raw": "[Character(name=\"char_220_grani#5\")]",
        "type": "character",
        "name": "char_220_grani#5"
    },
    {
        "id": 259,
        "raw": "[name=\"グラニ\"]   ここに留まると危険だね。おじさんにも迷惑かけちゃいそうだし。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "ここに留まると危険だね。おじさんにも迷惑かけちゃいそうだし。"
    },
    {
        "id": 260,
        "raw": "[name=\"グラニ\"]   とにかく、ひとまずここを離れよう。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "とにかく、ひとまずここを離れよう。"
    },
    {
        "id": 261,
        "raw": "[Character(name=\"avg_npc_005\")]",
        "type": "character",
        "name": "avg_npc_005"
    },
    {
        "id": 262,
        "raw": "[name=\"村人\"]   くれぐれも気をつけてな、騎士……いや、騎馬警官のお嬢ちゃん。ウチの村長は任せたぞ。",
        "type": "dialog",
        "speaker": "村人",
        "content": "くれぐれも気をつけてな、騎士……いや、騎馬警官のお嬢ちゃん。ウチの村長は任せたぞ。"
    },
    {
        "id": 263,
        "raw": "[Character(name=\"char_220_grani#2\")]",
        "type": "character",
        "name": "char_220_grani#2"
    },
    {
        "id": 264,
        "raw": "[name=\"グラニ\"]   おじさん、安心して。あたしが絶対まも――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "おじさん、安心して。あたしが絶対まも――"
    },
    {
        "id": 265,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 266,
        "raw": "[name=\"グラニ\"]   って、そ、村長！？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "って、そ、村長！？"
    },
    {
        "id": 267,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 268,
        "raw": "[name=\"キャロル\"]   ……ええ、私が滴水村の村長です。なってまだ半年ですけど……私にも村長としてのプライドがありますよ。フフッ。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "……ええ、私が滴水村の村長です。なってまだ半年ですけど……私にも村長としてのプライドがありますよ。フフッ。"
    },
