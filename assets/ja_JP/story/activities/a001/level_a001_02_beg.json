        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 151,
        "raw": "[name=\"キャロル\"]   グラニ、もしかしてわざと……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "グラニ、もしかしてわざと……。"
    },
