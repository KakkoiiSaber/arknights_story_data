        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 100,
        "raw": "[name=\"グラニ\"]   うわぁーーーーーー！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うわぁーーーーーー！"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"avg_npc_008\")]",
        "type": "character",
        "name": "avg_npc_008"
    },
    {
        "id": 102,
        "raw": "[name=\"賞金稼ぎ\"]   クソッ、お、俺の鼻が！　なんで扉が勝手に開きやがる――",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "クソッ、お、俺の鼻が！　なんで扉が勝手に開きやがる――"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 104,
        "raw": "[name=\"グラニ\"]   うわっ？　なんでこんなところに人が寝て――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うわっ？　なんでこんなところに人が寝て――"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 106,
        "raw": "[name=\"キャロル\"]   グラニ！　何があったの――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "グラニ！　何があったの――"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"avg_npc_008\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_008",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"粗暴な賞金稼ぎ\"]   てめぇら、静かにしやがれ！　シーッ！",
        "type": "dialog",
        "speaker": "粗暴な賞金稼ぎ",
        "content": "てめぇら、静かにしやがれ！　シーッ！"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"avg_npc_008\",name2=\"char_220_grani#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_008",
        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"グラニ\"]   ……シーッ？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……シーッ？"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"avg_npc_008\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_008",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"賞金稼ぎ\"]   チッ、お前みたいな農民には何にも分かんねぇだろうがな。あそこに「厄星」が居るのが見えねえのかよ！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "チッ、お前みたいな農民には何にも分かんねぇだろうがな。あそこに「厄星」が居るのが見えねえのかよ！"
    },
    {
        "id": 113,
        "raw": "[name=\"賞金稼ぎ\"]   どんな賞金稼ぎだってあの女にゃ会いたくねえ！　あいつの前で啖呵を切るバカがいるとすりゃあ、あいつが街一つぶっ潰すのを見たことがねぇんからだ！",
        "type": "dialog",
        "speaker": "賞金稼ぎ",
        "content": "どんな賞金稼ぎだってあの女にゃ会いたくねえ！　あいつの前で啖呵を切るバカがいるとすりゃあ、あいつが街一つぶっ潰すのを見たことがねぇんからだ！"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"avg_npc_008\",name2=\"char_220_grani#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_008",
        "name2": "char_220_grani#1",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"グラニ\"]   話を盛りすぎだよ！　彼女一人で街一つを潰すなんて――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "話を盛りすぎだよ！　彼女一人で街一つを潰すなんて――"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_220_grani#1\",name2=\"avg_npc_007\",focus=2)]",
        "type": "character",
        "name": "char_220_grani#1",
        "name2": "avg_npc_007",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"粗暴な賞金稼ぎ\"]   静かにしろ。見つかっちまうだろ！",
        "type": "dialog",
        "speaker": "粗暴な賞金稼ぎ",
        "content": "静かにしろ。見つかっちまうだろ！"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"char_220_grani#1\",name2=\"avg_npc_007\",focus=1)]",
        "type": "character",
        "name": "char_220_grani#1",
        "name2": "avg_npc_007",
        "focus": 1
    },
    {
        "id": 119,
        "raw": "[name=\"グラニ\"]   むむむ、あたしはどっちかといえば彼女に会いた――",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "むむむ、あたしはどっちかといえば彼女に会いた――"
    },
    {
        "id": 120,
        "raw": "[Character(name=\"char_220_grani#1\",name2=\"avg_npc_007\",focus=2)]",
        "type": "character",
        "name": "char_220_grani#1",
        "name2": "avg_npc_007",
        "focus": 2
    },
    {
        "id": 121,
        "raw": "[name=\"粗暴な賞金稼ぎ\"]   バカ、静かにしろって言ってるだろ！",
        "type": "dialog",
        "speaker": "粗暴な賞金稼ぎ",
        "content": "バカ、静かにしろって言ってるだろ！"
    },
