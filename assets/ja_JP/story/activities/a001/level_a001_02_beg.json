        "type": "character",
        "name": "char_220_grani#5"
    },
    {
        "id": 123,
        "raw": "[name=\"グラニ\"]   わ、わかったよ……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "わ、わかったよ……。"
    },
    {
        "id": 124,
        "raw": "[name=\"グラニ\"]   うわぁ、彼女の評判、ロドスで流れてる噂より酷いことになってるみたい……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うわぁ、彼女の評判、ロドスで流れてる噂より酷いことになってるみたい……。"
