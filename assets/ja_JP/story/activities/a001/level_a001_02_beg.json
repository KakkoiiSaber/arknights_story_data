        "id": 152,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 153,
        "raw": "[name=\"グラニ\"]   いやいや、この人たちがあまりにも自然に話しかけてくるから、何だか乗せられちゃって！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "いやいや、この人たちがあまりにも自然に話しかけてくるから、何だか乗せられちゃって！"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"avg_npc_007\")]",
        "type": "character",
        "name": "avg_npc_007"
    },
    {
