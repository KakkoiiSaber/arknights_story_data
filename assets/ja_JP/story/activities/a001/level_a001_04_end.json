    {
        "id": 104,
        "raw": "[name=\"キャロル\"]   きゃあ！！　な、なんなのこの音……遠くで何かが爆発した……？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "きゃあ！！　な、なんなのこの音……遠くで何かが爆発した……？"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 106,
        "raw": "[name=\"グラニ\"]   これは……爆発音に叫び声と悲鳴も混ざってる…。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "これは……爆発音に叫び声と悲鳴も混ざってる…。"
    },
    {
        "id": 107,
        "raw": "[name=\"グラニ\"]   誰かが戦っている音だね……。まだ終わってない…。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "誰かが戦っている音だね……。まだ終わってない…。"
    },
    {
        "id": 108,
        "raw": "[name=\"グラニ\"]   ……キャロル、怖い？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……キャロル、怖い？"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"キャロル\"]   私――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "私――"
    },
    {
        "id": 111,
        "raw": "[name=\"キャロル\"]   ……すごく怖い。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "……すごく怖い。"
    },
    {
        "id": 112,
        "raw": "[name=\"キャロル\"]   でも、私はどうしても村の平穏で静かな生活を取り戻したいの。そのために私もやるべきことをやらないと……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "でも、私はどうしても村の平穏で静かな生活を取り戻したいの。そのために私もやるべきことをやらないと……。"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 114,
        "raw": "[name=\"グラニ\"]   そうだよね…。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "そうだよね…。"
    },
    {
        "id": 115,
        "raw": "[name=\"グラニ\"]   ……キャロルは強いんだね。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……キャロルは強いんだね。"
    },
