    },
    {
        "id": 68,
        "raw": "[Blocker(a=1, r=0,g=0, b=0, fadetime=0.6, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,g=0,",
        "b": "0,",
        "fadetime": "0.6,",
        "block": true
    },
    {
        "id": 69,
        "raw": "[name=\"ケルシー\"]   （エーギル語）「深海の狩人の血脈のつながり」",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "（エーギル語）「深海の狩人の血脈のつながり」"
    },
    {
        "id": 70,
        "raw": "[Background(fadetime=0)]",
        "type": "background",
        "fadetime": 0
    },
    {
        "id": 71,
        "raw": "[Blocker(a=0, fadetime=0.6, block=false)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.6,",
        "block": false
    },
    {
        "id": 72,
        "raw": "[name=\"ケルシー\"]   私は全てを知っている。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "私は全てを知っている。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_263_skadi#2\")]",
        "type": "character",
        "name": "char_263_skadi#2.png"
    },
    {
        "id": 74,
        "raw": "[name=\"スカジ\"]   ……教えなさい。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "……教えなさい。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[Background(image=\"bg_infirmary\", fadetime=1)]",
        "type": "background",
        "image": "bg_infirmary.png",
        "fadetime": 1
    },
    {
        "id": 77,
        "raw": "[name=\"ケルシー\"]   ああ。私の命令に従うなら、手を貸してやっていいさ。ただし、命令には絶対に従うことを約束してもらうがな。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "ああ。私の命令に従うなら、手を貸してやっていいさ。ただし、命令には絶対に従うことを約束してもらうがな。"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 79,
        "raw": "[name=\"スカジ\"]   私は信じられる人しか信じない。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "私は信じられる人しか信じない。"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"char_003_kalts_1\")]",
        "type": "character",
        "name": "char_003_kalts_1.png"
    },
    {
        "id": 81,
        "raw": "[name=\"ケルシー\"]   私とて口にしたことは守るさ。",
        "type": "dialog",
        "speaker": "ケルシー",
        "content": "私とて口にしたことは守るさ。"
    },
    {
        "id": 82,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 83,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
