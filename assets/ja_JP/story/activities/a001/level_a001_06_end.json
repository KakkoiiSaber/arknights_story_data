    {
        "id": 5,
        "raw": "[Character(name=\"avg_npc_010#2\")]",
        "type": "character",
        "name": "avg_npc_010#2.png"
    },
    {
        "id": 6,
        "raw": "[name=\"ビッグ・ボブ\"]   ハハ、やはり無理だったか……。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "ハハ、やはり無理だったか……。"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 8,
        "raw": "[name=\"レユニオン構成員\"]   ボブ！　血が…待ってろ、いま止血してやるからな！",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ボブ！　血が…待ってろ、いま止血してやるからな！"
    },
    {
        "id": 9,
        "raw": "[name=\"レユニオン構成員\"]   ボブが流した血をムダにするわけには！　俺はまだ戦え――",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ボブが流した血をムダにするわけには！　俺はまだ戦え――"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"ビッグ・ボブ\"]   もういいさ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "もういいさ。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"レユニオン構成員\"]   ボブ……。",
        "type": "dialog",
        "speaker": "レユニオン構成員",
        "content": "ボブ……。"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"ビッグ・ボブ\"]   お前たちだってこれまでたくさん血を流してきただろう。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "お前たちだってこれまでたくさん血を流してきただろう。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_263_skadi#2\")]",
        "type": "character",
        "name": "char_263_skadi#2.png"
    },
    {
        "id": 17,
        "raw": "[name=\"スカジ\"]   まだやるつもり？",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "まだやるつもり？"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"avg_npc_010#2\")]",
        "type": "character",
        "name": "avg_npc_010#2.png"
    },
    {
        "id": 19,
        "raw": "[name=\"ビッグ・ボブ\"]   フッ、生きるために戦っているのに、ここで命を落とすなんて、それこそ本末転倒だ。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "フッ、生きるために戦っているのに、ここで命を落とすなんて、それこそ本末転倒だ。"
    },
    {
        "id": 20,
        "raw": "[name=\"ビッグ・ボブ\"]   私の弱さでは財宝を手に入れる資格はない。もう、諦めよう。",
        "type": "dialog",
        "speaker": "ビッグ・ボブ",
        "content": "私の弱さでは財宝を手に入れる資格はない。もう、諦めよう。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_220_grani#4\")]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_220_grani#4"
    },
    {
        "id": 22,
        "raw": "[name=\"グラニ\"]   ……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"キャロル\"]   ボブさん、ごめんなさい……この財宝がないと、私たちの村は救えないんです。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "ボブさん、ごめんなさい……この財宝がないと、私たちの村は救えないんです。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"スカジ\"]   その宝箱から離れて。鍵を私に。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "その宝箱から離れて。鍵を私に。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=30, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 29,
        "raw": "[name=\"キャロル\"]   え、えっ？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "え、えっ？"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"スカジ\"]   その鍵を使って宝箱を開けた途端、あなたは自分の命を落とすことになるわ。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "その鍵を使って宝箱を開けた途端、あなたは自分の命を落とすことになるわ。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"キャロル\"]   私の――――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "私の――――"
    },
    {
        "id": 34,
        "raw": "[name=\"キャロル\"]   私の村長としての最も重要な仕事は、代々受け継がれてきたこの鍵を守ること。そう父から言い聞かされてきました――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "私の村長としての最も重要な仕事は、代々受け継がれてきたこの鍵を守ること。そう父から言い聞かされてきました――"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"avg_npc_003\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"スカジ\"]   ――その鍵は、使った人間の手を切り裂き、吸血するような仕掛けになっているの。そしてその血がクランタのものでなければ、鍵は崩れ落ちる。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "――その鍵は、使った人間の手を切り裂き、吸血するような仕掛けになっているの。そしてその血がクランタのものでなければ、鍵は崩れ落ちる。"
    },
    {
        "id": 37,
        "raw": "[name=\"スカジ\"]   もう一度言うわ、その鍵を渡しなさい。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "もう一度言うわ、その鍵を渡しなさい。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 39,
        "raw": "[name=\"キャロル\"]   できません。この鍵にはこの村の未来がかかっているんです。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "できません。この鍵にはこの村の未来がかかっているんです。"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1.png"
    },
    {
        "id": 41,
        "raw": "[name=\"グラニ\"]   うーん。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うーん。"
    },
    {
        "id": 42,
        "raw": "[name=\"グラニ\"]   スカジ、今言ったことは全部本当なの？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "スカジ、今言ったことは全部本当なの？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"スカジ\"]   騎士の財宝を埋葬する者たちは、騎士の秘密を守るためには手段を選ばない。ただ――",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "騎士の財宝を埋葬する者たちは、騎士の秘密を守るためには手段を選ばない。ただ――"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 46,
        "raw": "[name=\"キャロル\"]   ……カジミエーシュの血脈だけが――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "……カジミエーシュの血脈だけが――"
    },
    {
        "id": 47,
        "raw": "[Blocker(a=1, r=255, g=255, b=255, afrom=0, rfrom=0, gfrom=0, bfrom=0, fadetime=0.1, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "255,",
        "g": "255,",
        "b": "255,",
        "afrom": "0,",
        "rfrom": "0,",
        "gfrom": "0,",
