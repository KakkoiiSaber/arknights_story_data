        "raw": "[CameraEffect(effect=\"Grayscale\", amount=0.8, keep=true)]",
        "type": "camera_effect",
        "effect": "Grayscale",
        "amount": "0.8,",
        "keep": true
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003.png",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[Blocker(a=0, fadetime=0.2, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.2,",
        "block": true
    },
    {
        "id": 53,
        "raw": "[name=\"キャロル\"]   「危険を恐れず、犠牲を顧みないカジミエーシュの血脈だけが、すべての障害を取り除くことができる。」",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "「危険を恐れず、犠牲を顧みないカジミエーシュの血脈だけが、すべての障害を取り除くことができる。」"
    },
    {
        "id": 54,
        "raw": "[Blocker(a=1, r=255, g=255, b=255, afrom=0, rfrom=0, gfrom=0, bfrom=0, fadetime=0.1, block=true)]",
        "type": "blocker",
