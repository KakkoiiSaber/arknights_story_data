        "raw": "[PlaySound(key=\"$flashback\", volume=0.1)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/general/g_ui/g_ui_stagepush.mp3",
        "volume": 0.1
    },
    {
        "id": 56,
        "raw": "[CameraEffect(effect=\"Grayscale\", amount=0)]",
        "type": "camera_effect",
        "effect": "Grayscale",
        "amount": 0
    },
    {
        "id": 57,
        "raw": "[Background(image=\"bg_cave_2\")]",
        "type": "background",
        "image": "bg_cave_2.png"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 59,
        "raw": "[Blocker(a=0, fadetime=0.1, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.1,",
        "block": true
    },
    {
        "id": 60,
        "raw": "[name=\"キャロル\"]   この伝説の通りなら、何らかの犠牲を払う必要があるのかなと思っていたけど…まさかそんな仕掛けだったなんて…。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "この伝説の通りなら、何らかの犠牲を払う必要があるのかなと思っていたけど…まさかそんな仕掛けだったなんて…。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1.png"
    },
    {
        "id": 62,
        "raw": "[name=\"グラニ\"]   ……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "……。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 64,
        "raw": "[name=\"キャロル\"]   でも村のために、覚悟はできてます。この宝箱は村長である私が開けます！",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "でも村のために、覚悟はできてます。この宝箱は村長である私が開けます！"
    },
    {
        "id": 65,
        "raw": "[name=\"キャロル\"]   グラニ、もし私に何かあったら、この財宝で手に入ったお金を村のみんなに渡してあげて！",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "グラニ、もし私に何かあったら、この財宝で手に入ったお金を村のみんなに渡してあげて！"
    },
    {
        "id": 66,
        "raw": "[StopMusic(fadetime=2)]",
        "type": "stop_music",
        "fadetime": 2
    },
    {
        "id": 67,
        "raw": "[Blocker(a=1, r=0,g=0, b=0, fadetime=1, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,g=0,",
        "b": "0,",
        "fadetime": "1,",
        "block": true
    },
    {
        "id": 68,
        "raw": "[name=\"キャロル\"]   ごめんなさい、お父さん……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "ごめんなさい、お父さん……。"
    },
    {
        "id": 69,
        "raw": "[name=\"グラニ\"]   待って！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "待って！"
    },
    {
        "id": 70,
        "raw": "[Blocker(a=0, fadetime=0.5, block=true)]",
        "type": "blocker",
        "a": "0,",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 72,
        "raw": "[name=\"キャロル\"]   えっ？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "えっ？"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3.png"
    },
    {
        "id": 74,
        "raw": "[name=\"グラニ\"]   キャロル、その鍵をあたしにも見せてくれる？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "キャロル、その鍵をあたしにも見せてくれる？"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003.png"
    },
    {
        "id": 76,
        "raw": "[name=\"キャロル\"]   うん……はい。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "うん……はい。"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_220_grani#3\")]",
        "type": "character",
        "name": "char_220_grani#3.png"
    },
    {
        "id": 78,
        "raw": "[name=\"グラニ\"]   この鍵、そんなに大きなものじゃないよね？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "この鍵、そんなに大きなものじゃないよね？"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_263_skadi#2\",name2=\"char_220_grani#1\",focus=1)]",
        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"スカジ\"]   その鍵が吸血する量は、言い伝えだと普通の人では保たないっていわれてるわ。それこそが「犠牲」として必要だと——",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "その鍵が吸血する量は、言い伝えだと普通の人では保たないっていわれてるわ。それこそが「犠牲」として必要だと——"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1.png"
    },
    {
        "id": 82,
        "raw": "[name=\"グラニ\"]   だけど限度はあるよね。こんな石ころみたいに小さいし。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "だけど限度はあるよね。こんな石ころみたいに小さいし。"
    },
    {
        "id": 83,
