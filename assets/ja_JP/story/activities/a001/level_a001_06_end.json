    },
    {
        "id": 200,
        "raw": "今はクルビア辺境の地に身を置き、この手紙を書いている。",
        "type": "narration",
        "content": "今はクルビア辺境の地に身を置き、この手紙を書いている。"
    },
    {
        "id": 201,
        "raw": "皆健やかに過ごしている。感染者という身分だと多少の不便さはあるが、太陽の下での生活は、想像していたよりもだいぶ美しいものだ。",
        "type": "narration",
        "content": "皆健やかに過ごしている。感染者という身分だと多少の不便さはあるが、太陽の下での生活は、想像していたよりもだいぶ美しいものだ。"
    },
    {
        "id": 202,
        "raw": "村の修繕が済んだあと、あの少女たちが残りの財宝を我々に与えてくれたおかげで、兄弟たちのための安息の家も滞りなく見つけることができた。",
        "type": "narration",
        "content": "村の修繕が済んだあと、あの少女たちが残りの財宝を我々に与えてくれたおかげで、兄弟たちのための安息の家も滞りなく見つけることができた。"
    },
    {
        "id": 203,
        "raw": "ようやく自給自足の暮らしもできるようになってきた。試しにホップでも育ててみようかと思っている。",
        "type": "narration",
        "content": "ようやく自給自足の暮らしもできるようになってきた。試しにホップでも育ててみようかと思っている。"
    },
    {
        "id": 204,
        "raw": "それも全て、あの滴水村の財宝のおかげだ。",
        "type": "narration",
        "content": "それも全て、あの滴水村の財宝のおかげだ。"
    },
    {
        "id": 205,
        "raw": "あの村での出来事は、私の生涯で忘れられない素晴らしいものだ。それはもうこの手紙に書こうとしても気持ちが溢れて筆が進まないほどだ。",
        "type": "narration",
        "content": "あの村での出来事は、私の生涯で忘れられない素晴らしいものだ。それはもうこの手紙に書こうとしても気持ちが溢れて筆が進まないほどだ。"
    },
    {
        "id": 206,
        "raw": "私は少しだけ、物事の考え方が変わった。",
        "type": "narration",
        "content": "私は少しだけ、物事の考え方が変わった。"
    },
    {
        "id": 207,
        "raw": "そして君も、とうの昔に自分の結論にたどり着いていると思う。レユニオンは感染者にとってただ一つの拠り所というわけではない。",
        "type": "narration",
        "content": "そして君も、とうの昔に自分の結論にたどり着いていると思う。レユニオンは感染者にとってただ一つの拠り所というわけではない。"
    },
    {
        "id": 208,
        "raw": "君ならば、君なりの選択ができると信じている。",
        "type": "narration",
        "content": "君ならば、君なりの選択ができると信じている。"
    },
