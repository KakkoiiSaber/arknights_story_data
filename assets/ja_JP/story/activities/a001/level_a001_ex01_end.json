        "name": "char_143_ghost"
    },
    {
        "id": 18,
        "raw": "[name=\"スペクター\"]   はっ…！",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "はっ…！"
    },
    {
        "id": 19,
        "raw": "[name=\"スペクター\"]   ……また……この夢……ですか。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "……また……この夢……ですか。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_263_skadi#1\")]",
        "type": "character",
        "name": "char_263_skadi#1"
    },
    {
        "id": 21,
        "raw": "[name=\"？？？\"]   ......",
        "type": "dialog",
        "speaker": "？？？",
        "content": "......"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_143_ghost\")]",
        "type": "character",
        "name": "char_143_ghost"
    },
    {
        "id": 23,
        "raw": "[name=\"スペクター\"]   あら、誰かしら？",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "あら、誰かしら？"
    },
    {
        "id": 24,
        "raw": "[name=\"スペクター\"]   ――あなたですか。でも不思議ですね……どうしてあなたの名前が思い出せないのでしょう。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "――あなたですか。でも不思議ですね……どうしてあなたの名前が思い出せないのでしょう。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_263_skadi#1\")]",
        "type": "character",
        "name": "char_263_skadi#1"
    },
    {
        "id": 26,
        "raw": "[name=\"？？？\"]   別に構わないわ。ロドスのオペレーターの一人とでも思ってくれればいい。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "別に構わないわ。ロドスのオペレーターの一人とでも思ってくれればいい。"
    },
    {
        "id": 27,
        "raw": "[name=\"？？？\"]   苦しそうね。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "苦しそうね。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_143_ghost\")]",
        "type": "character",
        "name": "char_143_ghost"
    },
    {
        "id": 29,
        "raw": "[name=\"スペクター\"]   ウフフ……ただの悪夢ですわ……。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "ウフフ……ただの悪夢ですわ……。"
    },
    {
        "id": 30,
        "raw": "[name=\"スペクター\"]   意識の中をぐるぐる廻る黒い破片が、あのボロボロの教会の影の中に隠れて……。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "意識の中をぐるぐる廻る黒い破片が、あのボロボロの教会の影の中に隠れて……。"
    },
    {
        "id": 31,
        "raw": "[name=\"スペクター\"]   私が近づくと、それは枷と鎖となり、この私を深い深い海の底へ連れ去っていくのです。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "私が近づくと、それは枷と鎖となり、この私を深い深い海の底へ連れ去っていくのです。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_263_skadi#1\")]",
        "type": "character",
        "name": "char_263_skadi#1"
    },
    {
        "id": 33,
        "raw": "[name=\"？？？\"]   ......",
        "type": "dialog",
        "speaker": "？？？",
        "content": "......"
    },
    {
        "id": 34,
        "raw": "[name=\"？？？\"]   もう少しでこの苦しみを終わらせる方法が見つかるわ。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "もう少しでこの苦しみを終わらせる方法が見つかるわ。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_143_ghost\")]",
        "type": "character",
        "name": "char_143_ghost"
    },
    {
        "id": 36,
        "raw": "[name=\"スペクター\"]   そうですか。ウフフ……素晴らしいことですが、あなたを信じても良いのでしょうか？",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "そうですか。ウフフ……素晴らしいことですが、あなたを信じても良いのでしょうか？"
    },
    {
        "id": 37,
        "raw": "[name=\"スペクター\"]   あら。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "あら。"
    },
    {
        "id": 38,
        "raw": "[name=\"スペクター\"]   あなたの纏うこの空気……私は知っています。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "あなたの纏うこの空気……私は知っています。"
    },
    {
        "id": 39,
        "raw": "[name=\"スペクター\"]   いえ……違う、これは香り。濃密な香り、血の香り、彼らの香り。深海の香り。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "いえ……違う、これは香り。濃密な香り、血の香り、彼らの香り。深海の香り。"
    },
    {
        "id": 40,
        "raw": "[name=\"スペクター\"]   懐かしくて、嫌な気持ちになる香り。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "懐かしくて、嫌な気持ちになる香り。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_263_skadi#1\")]",
        "type": "character",
        "name": "char_263_skadi#1"
    },
    {
        "id": 42,
        "raw": "[name=\"？？？\"]   そう？",
        "type": "dialog",
        "speaker": "？？？",
        "content": "そう？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_143_ghost\")]",
        "type": "character",
        "name": "char_143_ghost"
    },
    {
        "id": 44,
        "raw": "[name=\"スペクター\"]   お名前を……教えていただけますか？",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "お名前を……教えていただけますか？"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_263_skadi#1\",fadetime=1)]",
        "type": "character",
        "name": "char_263_skadi#1",
        "fadetime": 1
    },
    {
        "id": 46,
        "raw": "[name=\"スカジ\"]   スカジ。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "スカジ。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_143_ghost\",name2=\"char_263_skadi#1\",focus=1)]",
        "type": "character",
        "name": "char_143_ghost",
        "name2": "char_263_skadi#1",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"スペクター\"]   あなたには何故か興味が尽きませんわ……どうやってここへ来たのですか？",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "あなたには何故か興味が尽きませんわ……どうやってここへ来たのですか？"
    },
    {
        "id": 49,
        "raw": "[name=\"スペクター\"]   ケルシー先生の許可がなければ、この部屋には入れないはず……我を失った私に八つ裂きにされるのを恐れないなら話は別ですが…。",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "ケルシー先生の許可がなければ、この部屋には入れないはず……我を失った私に八つ裂きにされるのを恐れないなら話は別ですが…。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_143_ghost\",name2=\"char_263_skadi#1\",focus=2)]",
        "type": "character",
        "name": "char_143_ghost",
        "name2": "char_263_skadi#1",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"スカジ\"]   恐れ……皆恐れているわ。私はそれに慣れているだけ。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "恐れ……皆恐れているわ。私はそれに慣れているだけ。"
    },
    {
        "id": 52,
        "raw": "[name=\"スカジ\"]   そろそろ行く時間ね、戻ってくる頃には状況に進展があるかもしれない。でも、これまで通り私を忘れてくれていいわ。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "そろそろ行く時間ね、戻ってくる頃には状況に進展があるかもしれない。でも、これまで通り私を忘れてくれていいわ。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_143_ghost\",name2=\"char_263_skadi#1\",focus=1)]",
        "type": "character",
        "name": "char_143_ghost",
        "name2": "char_263_skadi#1",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"スペクター\"]   どこへ……向かわれるの？",
        "type": "dialog",
        "speaker": "スペクター",
        "content": "どこへ……向かわれるの？"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_143_ghost\",name2=\"char_263_skadi#1\",focus=2)]",
        "type": "character",
        "name": "char_143_ghost",
        "name2": "char_263_skadi#1",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"スカジ\"]   秘密が眠っているところ。",
        "type": "dialog",
        "speaker": "スカジ",
        "content": "秘密が眠っているところ。"
