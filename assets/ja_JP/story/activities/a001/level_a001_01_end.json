        "type": "character",
        "name": "char_220_grani#3"
    },
    {
        "id": 61,
        "raw": "[name=\"グラニ\"]   よいしょっ！　どう？　見える？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "よいしょっ！　どう？　見える？"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 63,
        "raw": "[name=\"キャロル\"]   うん、見え――",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "うん、見え――"
    },
    {
        "id": 64,
        "raw": "[CameraShake(duration=0.5, xstrength=10, ystrength=12, vibrato=30, randomness=20, block=false)]",
        "type": "camera_shake",
        "duration": "0.5,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "20,",
        "block": false
    },
    {
        "id": 65,
        "raw": "[name=\"キャロル\"]   えっ！？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "えっ！？"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_220_grani#1\")]",
        "type": "character",
        "name": "char_220_grani#1"
    },
    {
        "id": 67,
        "raw": "[CameraShake(duration=0.5, xstrength=10, ystrength=12, vibrato=30, randomness=20, block=false)]",
        "type": "camera_shake",
        "duration": "0.5,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "20,",
        "block": false
    },
    {
        "id": 68,
        "raw": "[name=\"グラニ\"]   キャロル！　バタバタしないでよ！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "キャロル！　バタバタしないでよ！"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 70,
        "raw": "[name=\"キャロル\"]   で、でも、今のは一体何……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "で、でも、今のは一体何……。"
    },
    {
        "id": 71,
        "raw": "[name=\"キャロル\"]   いま、目の前を誰か横切って…。まさか飛ばされたの……？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "いま、目の前を誰か横切って…。まさか飛ばされたの……？"
    },
