    {
        "id": 16,
        "raw": "[Background(image=\"bg_towerinside\",fadetime=2,block=true)]",
        "type": "background",
        "image": "bg_towerinside.png",
        "fadetime": "2,block=true"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1,fadetime=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": "1,fadetime=1"
    },
    {
        "id": 18,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 19,
        "raw": "[name=\"キャロル\"]   じゃあ、グラニ……改めて…私たちが依頼した「騎士の財宝を手に入れて欲しい」っていうのは見てくれたんだよね？",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "じゃあ、グラニ……改めて…私たちが依頼した「騎士の財宝を手に入れて欲しい」っていうのは見てくれたんだよね？"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"グラニ\"]   うん見たよ。依頼書によれば、もうお宝の情報は完全にわかってるんだよね？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "うん見たよ。依頼書によれば、もうお宝の情報は完全にわかってるんだよね？"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"キャロル\"]   ええ、財宝を開けるための鍵と財宝の場所は、歴代の村長に伝わる秘密なの。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "ええ、財宝を開けるための鍵と財宝の場所は、歴代の村長に伝わる秘密なの。"
    },
    {
        "id": 24,
        "raw": "[name=\"キャロル\"]   でも具体的な情報は今は明かせない……ごめんなさい、ずっと隠しておくつもりではないんだけど。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "でも具体的な情報は今は明かせない……ごめんなさい、ずっと隠しておくつもりではないんだけど。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"グラニ\"]   大丈夫。あたしのことを完全に信頼できたと思ったら教えてくれればいいよ。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "大丈夫。あたしのことを完全に信頼できたと思ったら教えてくれればいいよ。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"キャロル\"]   あの賞金稼ぎたちはそんな情報をどこからか知って、村民たちを脅しているの。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "あの賞金稼ぎたちはそんな情報をどこからか知って、村民たちを脅しているの。"
    },
    {
        "id": 29,
        "raw": "[name=\"キャロル\"]   田畑を荒らして冬のための蓄えまで奪って……。さんざん村人たちを痛めつけた――あの時、私が名乗り出なければ、村はもう今頃……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "田畑を荒らして冬のための蓄えまで奪って……。さんざん村人たちを痛めつけた――あの時、私が名乗り出なければ、村はもう今頃……。"
    },
    {
        "id": 30,
        "raw": "[name=\"キャロル\"]   そう、私は財宝の情報を知っていると名乗り出た。そうすれば、もう村人たちが傷つけられずに済むと思ったから。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "そう、私は財宝の情報を知っていると名乗り出た。そうすれば、もう村人たちが傷つけられずに済むと思ったから。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"グラニ\"]   でも君が身代わりになるなんで……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "でも君が身代わりになるなんで……。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"キャロル\"]   ……うん、わかってる。無謀なことなのは…。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "……うん、わかってる。無謀なことなのは…。"
    },
    {
        "id": 35,
        "raw": "[name=\"キャロル\"]   でも、あなたが来てくれた。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "でも、あなたが来てくれた。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_220_grani#4\")]",
        "type": "character",
        "name": "char_220_grani#4"
    },
    {
        "id": 37,
        "raw": "[name=\"グラニ\"]   そっか、辛かったね……キャロル……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "そっか、辛かったね……キャロル……。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_003\")]",
        "type": "character",
        "name": "avg_npc_003"
    },
    {
        "id": 39,
        "raw": "[name=\"キャロル\"]   依頼の内容は財宝を手に入れることだけど、本当の目的は賞金稼ぎたちを追い払って、村に平穏を取り戻したいの。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "依頼の内容は財宝を手に入れることだけど、本当の目的は賞金稼ぎたちを追い払って、村に平穏を取り戻したいの。"
    },
    {
        "id": 40,
        "raw": "[name=\"キャロル\"]   財宝が起こした問題だから、財宝で解決しようと思って。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "財宝が起こした問題だから、財宝で解決しようと思って。"
    },
    {
        "id": 41,
        "raw": "[name=\"キャロル\"]   金貨なんて手に入れたところで、いつかは使って無くなってしまうでしょ。でも私たちの故郷はここしかないの。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "金貨なんて手に入れたところで、いつかは使って無くなってしまうでしょ。でも私たちの故郷はここしかないの。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"グラニ\"]   そっか先に財宝を手に入れて、それを元手に人を雇って賞金稼ぎを追い払ってもらう。確かにその方法なら……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "そっか先に財宝を手に入れて、それを元手に人を雇って賞金稼ぎを追い払ってもらう。確かにその方法なら……。"
    },
    {
        "id": 44,
        "raw": "[name=\"グラニ\"]   財宝がある程度の資金になれば、小さな傭兵軍ぐらいならまるまる雇えるはずだよ！",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "財宝がある程度の資金になれば、小さな傭兵軍ぐらいならまるまる雇えるはずだよ！"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"キャロル\"]   うん。そのつもり。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "うん。そのつもり。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 48,
        "raw": "[name=\"グラニ\"]   目的がはっきりしているなら、善は急げだね。まずは賞金稼ぎがウロウロしてるこの場所を離れないと……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "目的がはっきりしているなら、善は急げだね。まずは賞金稼ぎがウロウロしてるこの場所を離れないと……。"
    },
    {
        "id": 49,
        "raw": "[name=\"グラニ\"]   あの窓から外の様子を――うーん、ちょっと高すぎるかな。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "あの窓から外の様子を――うーん、ちょっと高すぎるかな。"
    },
    {
        "id": 50,
        "raw": "[name=\"グラニ\"]   キャロルは届く？　賞金稼ぎたちの姿は見える？",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "キャロルは届く？　賞金稼ぎたちの姿は見える？"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"キャロル\"]   わ、私も届かないよ、窓が高すぎて……。",
        "type": "dialog",
        "speaker": "キャロル",
        "content": "わ、私も届かないよ、窓が高すぎて……。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_003\",name2=\"char_220_grani#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_003",
        "name2": "char_220_grani#2",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"グラニ\"]   じゃあ抱き上げるから……。",
        "type": "dialog",
        "speaker": "グラニ",
        "content": "じゃあ抱き上げるから……。"
    },
