    {
        "id": 27,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_201_moeshd\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_201_moeshd",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"エクシア\"]   おっと、危ない危ない。サンキュ、クロワッサン。",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "おっと、危ない危ない。サンキュ、クロワッサン。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"バイソン\"]   こんなに粘られたらキリがありません！　テキサスさん！",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "こんなに粘られたらキリがありません！　テキサスさん！"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4.png",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"テキサス\"]   ふむ……ソラと私、エクシアとクロワッサンで二手に分かれて「大地の果て」に行く。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "ふむ……ソラと私、エクシアとクロワッサンで二手に分かれて「大地の果て」に行く。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"バイソン\"]   ……えっ、なんて？　大地の……？",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "……えっ、なんて？　大地の……？"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_101_sora_1\")]",
        "type": "character",
        "name": "char_101_sora_1.png"
    },
    {
        "id": 36,
        "raw": "[name=\"ソラ\"]   やった……いえ、わかりました。",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "やった……いえ、わかりました。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_201_moeshd#2\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_201_moeshd#2",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"エクシア\"]   おぉー、手分けして敵を分断するんだね？　オッケー、あたしが一番得意なやつ！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "おぉー、手分けして敵を分断するんだね？　オッケー、あたしが一番得意なやつ！"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_201_moeshd#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_201_moeshd#2",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"クロワッサン\"]   エクシアはん、街中行くときは、ホンマ気ぃつけぇや。賠償リストがヤバいでぇ……。",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "エクシアはん、街中行くときは、ホンマ気ぃつけぇや。賠償リストがヤバいでぇ……。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 42,
        "raw": "[name=\"バイソン\"]   待ってください、いまの「大地の果て」ってどういう意味ですか？",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "待ってください、いまの「大地の果て」ってどういう意味ですか？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 44,
        "raw": "[name=\"テキサス\"]   集合は一時間後。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "集合は一時間後。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"バイソン\"]   だからどういう意味なんですか！？",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "だからどういう意味なんですか！？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_101_sora_1#3\")]",
        "type": "character",
        "name": "char_101_sora_1#3.png"
    },
    {
        "id": 48,
        "raw": "[name=\"ソラ\"]   でもどうやって突破するの？",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "でもどうやって突破するの？"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_103_angel_1#5\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#5.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"エクシア\"]   ま、手はあるから……。",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "ま、手はあるから……。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_103_angel_1#5\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#5.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"マフィア\"]   て、テメエ何考えてやがる！？　このサンクタめ——俺は退かねぇぞ——",
        "type": "dialog",
        "speaker": "マフィア",
        "content": "て、テメエ何考えてやがる！？　このサンクタめ——俺は退かねぇぞ——"
    },
