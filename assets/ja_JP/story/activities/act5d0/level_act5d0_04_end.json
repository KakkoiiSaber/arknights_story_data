    {
        "id": 74,
        "raw": "[name=\"テキサス\"]   よし、ソラ、早く乗れ。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "よし、ソラ、早く乗れ。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#3\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_101_sora_1#3",
        "focus": 2
    },
    {
        "id": 76,
        "raw": "[name=\"ソラ\"]   わ、わかりました！",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "わ、わかりました！"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#3\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_101_sora_1#3",
        "focus": 1
    },
    {
        "id": 78,
        "raw": "[name=\"テキサス\"]   しっかり掴まっていろ。エクシアたちに後れを取るな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "しっかり掴まっていろ。エクシアたちに後れを取るな。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_101_sora_1#4",
        "focus": 2
    },
    {
        "id": 80,
        "raw": "[name=\"ソラ\"]   も、もう少しゆっくりだと——",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "も、もう少しゆっくりだと——"
    },
