    {
        "id": 60,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_201_moeshd\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_201_moeshd",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"クロワッサン\"]   おっしゃ、ほな行こか！",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "おっしゃ、ほな行こか！"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 63,
        "raw": "[name=\"テキサス\"]   バイクを奪うのか？　良いアイデアだ……。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "バイクを奪うのか？　良いアイデアだ……。"
    },
    {
        "id": 64,
        "raw": "[name=\"テキサス\"]   ふむ、となるとお前か。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "ふむ、となるとお前か。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_031\")]",
        "type": "character",
        "name": "avg_npc_031.png"
    },
    {
        "id": 66,
        "raw": "[name=\"マフィア\"]   こっちに来るなっ、このクソ狼が——テメェ——ひぃっ——。わ、分かった。ば、バイクはやる！　顔を殴るのはやめてくれ！",
        "type": "dialog",
        "speaker": "マフィア",
        "content": "こっちに来るなっ、このクソ狼が——テメェ——ひぃっ——。わ、分かった。ば、バイクはやる！　顔を殴るのはやめてくれ！"
    },
