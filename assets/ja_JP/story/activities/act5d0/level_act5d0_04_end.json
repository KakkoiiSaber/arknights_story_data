    {
        "id": 7,
        "raw": "[name=\"通りすがりの野次馬A\"]  ねぇ、これ映画の撮影？",
        "type": "dialog",
        "speaker": "通りすがりの野次馬A",
        "content": "ねぇ、これ映画の撮影？"
    },
    {
        "id": 8,
        "raw": "[name=\"通りすがりの野次馬B\"]  あれペンギン急便の連中じゃないか？　また喧嘩？",
        "type": "dialog",
        "speaker": "通りすがりの野次馬B",
        "content": "あれペンギン急便の連中じゃないか？　また喧嘩？"
    },
    {
        "id": 9,
        "raw": "[name=\"通りすがりの野次馬B\"]  そうだ！　左フック！　そこだ！　かっけーぞ！",
        "type": "dialog",
        "speaker": "通りすがりの野次馬B",
        "content": "そうだ！　左フック！　そこだ！　かっけーぞ！"
    },
    {
        "id": 10,
        "raw": "[name=\"通りすがりの野次馬A\"]  いつもペンギン急便が勝つんだもん、つまんない。",
        "type": "dialog",
        "speaker": "通りすがりの野次馬A",
        "content": "いつもペンギン急便が勝つんだもん、つまんない。"
    },
    {
        "id": 11,
        "raw": "[name=\"通りすがりの野次馬B\"]  そりゃそうだな。おい、どこから出てきた悪党かは知らないけど、無様な負け方すんなよ！",
        "type": "dialog",
        "speaker": "通りすがりの野次馬B",
        "content": "そりゃそうだな。おい、どこから出てきた悪党かは知らないけど、無様な負け方すんなよ！"
    },
