    {
        "id": 58,
        "raw": "[name=\"エクシア\"]   クロワッサン、乗って！　このバイク、超イケてるっしょ！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "クロワッサン、乗って！　このバイク、超イケてるっしょ！"
    },
    {
        "id": 59,
        "raw": "[PlaySound(key=\"$motorbikestart\")]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_motorbikestart.mp3"
