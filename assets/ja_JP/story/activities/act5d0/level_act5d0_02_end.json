        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 209,
        "raw": "[name=\"マフィアA\"]   ……おい、達者でな。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "……おい、達者でな。"
    },
