        "time": 2
    },
    {
        "id": 12,
        "raw": "[name=\"ジェイ\"]   はい、お待ちどお。魚団子スープでございやす。",
        "type": "dialog",
        "speaker": "ジェイ",
        "content": "はい、お待ちどお。魚団子スープでございやす。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"avg_npc_032\")]",
        "type": "character",
        "name": "avg_npc_032.png"
    },
    {
        "id": 14,
        "raw": "[name=\"女性旅行客\"]   ううーん、この口当たりといい、弾力のある食感といい、本当に美味しいわ。",
        "type": "dialog",
        "speaker": "女性旅行客",
        "content": "ううーん、この口当たりといい、弾力のある食感といい、本当に美味しいわ。"
    },
    {
        "id": 15,
        "raw": "[name=\"女性旅行客\"]   さすがB級グルメのベスト100に入るお店ね！",
        "type": "dialog",
        "speaker": "女性旅行客",
        "content": "さすがB級グルメのベスト100に入るお店ね！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_272_strong_1#3\")]",
        "type": "character",
        "name": "char_272_strong_1#3.png"
    },
    {
        "id": 17,
        "raw": "[name=\"ジェイ\"]   お口に合いやしたか？　それは何より。",
        "type": "dialog",
        "speaker": "ジェイ",
        "content": "お口に合いやしたか？　それは何より。"
    },
