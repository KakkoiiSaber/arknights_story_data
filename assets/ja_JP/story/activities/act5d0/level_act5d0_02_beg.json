    },
    {
        "id": 12,
        "raw": "[name=\"クロワッサン\"]   ゲホゲホッ、みんな生きとるん？",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "ゲホゲホッ、みんな生きとるん？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_201_moeshd#5\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4",
        "name2": "char_201_moeshd#5",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"バイソン\"]   なんとか、防ぎました——",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "なんとか、防ぎました——"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 16,
        "raw": "[name=\"テキサス\"]   良い反応だった。二人とも。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "良い反応だった。二人とも。"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_103_angel_1#4\")]",
        "type": "character",
        "name": "char_103_angel_1#4"
    },
    {
        "id": 18,
        "raw": "[name=\"エクシア\"]   やれやれ、もうみんな爆弾好きすぎでしょ。ん？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "やれやれ、もうみんな爆弾好きすぎでしょ。ん？"
