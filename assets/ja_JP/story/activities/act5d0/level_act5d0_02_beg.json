    {
        "id": 105,
        "raw": "[name=\"運転手のマフィア\"]   奴ら撃ってきたぞ！　おい、迎撃だ！",
        "type": "dialog",
        "speaker": "運転手のマフィア",
        "content": "奴ら撃ってきたぞ！　おい、迎撃だ！"
    },
    {
        "id": 106,
        "raw": "[name=\"後部座席のマフィア\"]   冗談言ってんじゃねぇぞ。こんな雑な運転でどうやって狙えってんだよ！",
        "type": "dialog",
        "speaker": "後部座席のマフィア",
        "content": "冗談言ってんじゃねぇぞ。こんな雑な運転でどうやって狙えってんだよ！"
    },
    {
        "id": 107,
        "raw": "[PlaySound(key=\"$pistol\", volume=0.9)]",
        "type": "play_sound",
        "key": "sound_beta_2/avg/d_gen_pistol.mp3",
        "volume": 0.9
    },
    {
        "id": 108,
        "raw": "[CameraShake(duration=0.1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=true)]",
