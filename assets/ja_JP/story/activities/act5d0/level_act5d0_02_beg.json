    {
        "id": 23,
        "raw": "[name=\"エンペラー\"]   ——*言葉になってないペンギンの呻き声*——",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "——*言葉になってないペンギンの呻き声*——"
