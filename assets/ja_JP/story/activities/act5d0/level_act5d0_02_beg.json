        "duration": "0.1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 109,
        "raw": "[name=\"運転手のマフィア\"]   お、お前撃たれたのか！？",
        "type": "dialog",
        "speaker": "運転手のマフィア",
        "content": "お、お前撃たれたのか！？"
    },
    {
        "id": 110,
        "raw": "[name=\"後部座席のマフィア\"]   血がっ、血が出てる！　早く包帯を寄越せ——いや待て、これはなんだ、ゴム？",
        "type": "dialog",
        "speaker": "後部座席のマフィア",
        "content": "血がっ、血が出てる！　早く包帯を寄越せ——いや待て、これはなんだ、ゴム？"
    },
    {
        "id": 111,
        "raw": "[name=\"運転手のマフィア\"]   ただのゴムだと！？",
        "type": "dialog",
        "speaker": "運転手のマフィア",
        "content": "ただのゴムだと！？"
    },
    {
        "id": 112,
        "raw": "[name=\"後部座席のマフィア\"]   こんなゴム弾でガラスを突き破ってきたのかよ！　いいから早く奴らを振り切れ。あっ、痛ってぇ！",
        "type": "dialog",
        "speaker": "後部座席のマフィア",
        "content": "こんなゴム弾でガラスを突き破ってきたのかよ！　いいから早く奴らを振り切れ。あっ、痛ってぇ！"
    },
