    },
    {
        "id": 65,
        "raw": "[PlaySound(key=\"$d_gen_walk_n\")]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_walk_n.mp3"
    },
    {
        "id": 66,
        "raw": "[name=\"？？？\"]   はは、ファミリー、ファミリーねぇ。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "はは、ファミリー、ファミリーねぇ。"
    },
    {
        "id": 67,
        "raw": "[name=\"？？？\"]   本当に懐かしい響きだね。うーん、ところで、キミたちテキサスには会ったかい？",
        "type": "dialog",
        "speaker": "？？？",
        "content": "本当に懐かしい響きだね。うーん、ところで、キミたちテキサスには会ったかい？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_027#2\")]",
        "type": "character",
        "name": "avg_npc_027#2"
    },
    {
        "id": 69,
        "raw": "[name=\"カポネ\"]   こ、この匂いは……！",
        "type": "dialog",
        "speaker": "カポネ",
        "content": "こ、この匂いは……！"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_028#3\")]",
        "type": "character",
        "name": "avg_npc_028#3"
    },
    {
        "id": 71,
        "raw": "[name=\"ガンビーノ\"]   ……落ちぶれ狼。なぜ龍門にいやがる？",
        "type": "dialog",
        "speaker": "ガンビーノ",
        "content": "……落ちぶれ狼。なぜ龍門にいやがる？"
    },
    {
