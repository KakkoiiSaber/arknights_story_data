    {
        "id": 44,
        "raw": "[name=\"ガンビーノ\"]   ……ハァ、ハァッ。",
        "type": "dialog",
        "speaker": "ガンビーノ",
        "content": "……ハァ、ハァッ。"
    },
    {
        "id": 45,
