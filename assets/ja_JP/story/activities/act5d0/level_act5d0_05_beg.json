    },
    {
        "id": 10,
        "raw": "[name=\"エクシア\"]   やっほ～！",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "やっほ～！"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_201_moeshd#2\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_201_moeshd#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"クロワッサン\"]   ちょエクシアはん、ちゃんと前見てや。て、片手運転すんなや！",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "ちょエクシアはん、ちゃんと前見てや。て、片手運転すんなや！"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 14,
        "raw": "[name=\"テキサス\"]   やっと追いついた。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "やっと追いついた。"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_101_sora_1#4",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"ソラ\"]   テキサスさん……次は……も、もう少しゆっくりでお願いしてもいいですか……。",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "テキサスさん……次は……も、もう少しゆっくりでお願いしてもいいですか……。"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_101_sora_1#4\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_101_sora_1#4",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"テキサス\"]   す、すまない。これでも極力抑えたのだが。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "す、すまない。これでも極力抑えたのだが。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_103_angel_1#3\")]",
        "type": "character",
        "name": "char_103_angel_1#3.png"
    },
    {
        "id": 20,
        "raw": "[name=\"エクシア\"]   オッケー！　もう合流できたし、次はボスを探しに行こうか——。",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "オッケー！　もう合流できたし、次はボスを探しに行こうか——。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_103_angel_1#7\")]",
        "type": "character",
        "name": "char_103_angel_1#7.png"
    },
    {
        "id": 22,
        "raw": "[name=\"エクシア\"]   あれ～？　なにか足りない気がしない？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "あれ～？　なにか足りない気がしない？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 24,
        "raw": "[name=\"テキサス\"]   ん？",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "ん？"
    },
    {
        "id": 25,
        "raw": "[name=\"テキサス\"]   ……バイソンは？",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……バイソンは？"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"エクシア\"]   え？　テキサスたちが連れてくるんじゃなかった？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "え？　テキサスたちが連れてくるんじゃなかった？"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_102_texas_1\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"テキサス\"]   ……。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_101_sora_1#3\")]",
        "type": "character",
        "name": "char_101_sora_1#3.png"
    },
    {
        "id": 31,
        "raw": "[name=\"ソラ\"]   ……もしかしてあたしたち、バイソンくんを置いてきちゃった？",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "……もしかしてあたしたち、バイソンくんを置いてきちゃった？"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1#2.png",
        "name2": "char_101_sora_1#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"テキサス\"]   ……自分たちのペースに慣れてしまっているからか、突然一人増えると感覚が狂うな。",
        "type": "dialog",
        "speaker": "テキサス",
        "content": "……自分たちのペースに慣れてしまっているからか、突然一人増えると感覚が狂うな。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_102_texas_1#2\",name2=\"char_101_sora_1#3\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1#2.png",
        "name2": "char_101_sora_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"ソラ\"]   じゃあ、すぐに助けに戻った方がいいかも？",
        "type": "dialog",
        "speaker": "ソラ",
        "content": "じゃあ、すぐに助けに戻った方がいいかも？"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_103_angel_1#4\")]",
        "type": "character",
        "name": "char_103_angel_1#4.png"
    },
    {
        "id": 37,
        "raw": "[name=\"エクシア\"]   モスティマがそこら辺にいるんでしょ？　問題ないんじゃない？",
        "type": "dialog",
        "speaker": "エクシア",
        "content": "モスティマがそこら辺にいるんでしょ？　問題ないんじゃない？"
    },
