    },
    {
        "id": 15,
        "raw": "[name=\"バイソン\"]   ぷはっ！",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "ぷはっ！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "id": 17,
        "raw": "[name=\"バイソン\"]   た、助かった。これは……？　うわ、べたべたする。",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "た、助かった。これは……？　うわ、べたべたする。"
    },
    {
        "id": 18,
        "raw": "[name=\"バイソン\"]   これは安魂夜用のキャンドル？　助かった。こんな所に積んであるなんて。",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "これは安魂夜用のキャンドル？　助かった。こんな所に積んであるなんて。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_213_mostma_1\")]",
        "type": "character",
        "name": "char_213_mostma_1"
    },
    {
        "id": 20,
        "raw": "[name=\"？？？\"]   ねぇ、角にも一本引っかかってるよ。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "ねぇ、角にも一本引っかかってるよ。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"バイソン\"]   え？　あ、ありがとうございます。抜かなきゃ、ん——！",
        "type": "dialog",
        "speaker": "バイソン",
        "content": "え？　あ、ありがとうございます。抜かなきゃ、ん——！"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"？？？\"]   えっとロウソクくん、まずはじっとして。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "えっとロウソクくん、まずはじっとして。"
    },
    {
        "id": 25,
