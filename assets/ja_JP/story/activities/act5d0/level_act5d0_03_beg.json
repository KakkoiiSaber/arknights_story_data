    },
    {
        "id": 161,
        "raw": "[name=\"マフィア\"]   おい！　まだターゲットは見つからないのか？",
        "type": "dialog",
        "speaker": "マフィア",
        "content": "おい！　まだターゲットは見つからないのか？"
    },
    {
        "id": 162,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 163,
        "raw": "[name=\"マフィア\"]   畜生、ここは人が多すぎるんだよ。何やってんだ！",
        "type": "dialog",
        "speaker": "マフィア",
        "content": "畜生、ここは人が多すぎるんだよ。何やってんだ！"
    },
    {
        "id": 164,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 165,
        "raw": "[name=\"マフィア\"]   行くぞ、俺たちは別の場所に向かう！",
        "type": "dialog",
        "speaker": "マフィア",
        "content": "行くぞ、俺たちは別の場所に向かう！"
    },
    {
        "id": 166,
        "raw": "[Dialog]",
