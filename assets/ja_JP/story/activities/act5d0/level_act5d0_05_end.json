    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_243_waaifu_1#2\")]",
        "type": "character",
        "name": "char_243_waaifu_1#2.png"
    },
    {
        "id": 41,
        "raw": "[name=\"ワイフー\"]   ……何かご用ですか？",
        "type": "dialog",
        "speaker": "ワイフー",
        "content": "……何かご用ですか？"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"マフィアB\"]   （待て、隣の男に気をつけろ。一筋縄ではいかねぇかもな。）",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "（待て、隣の男に気をつけろ。一筋縄ではいかねぇかもな。）"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"マフィアA\"]   （地元のマフィアか？　まぁ安心しろ、カポネさんからの情報によれば、みんな雑魚だってよ。）",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "（地元のマフィアか？　まぁ安心しろ、カポネさんからの情報によれば、みんな雑魚だってよ。）"
    },
    {
        "id": 46,
        "raw": "[name=\"マフィアA\"]   おい、ちょっと聞きたいことがあってな。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "おい、ちょっと聞きたいことがあってな。"
    },
    {
        "id": 47,
        "raw": "[name=\"マフィアA\"]   誰も面倒事にはなりたくない、そうだろ？　素直に俺らの質問に答えてくれさえすりゃ、俺らは大人しく帰るさ。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "誰も面倒事にはなりたくない、そうだろ？　素直に俺らの質問に答えてくれさえすりゃ、俺らは大人しく帰るさ。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"ジェイ\"]   ……アンタの手、血がついてやすが。",
        "type": "dialog",
        "speaker": "ジェイ",
        "content": "……アンタの手、血がついてやすが。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"マフィアA\"]   なに大したことじゃない、話を聞かねぇゴミがね。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "なに大したことじゃない、話を聞かねぇゴミがね。"
    },
    {
        "id": 52,
        "raw": "[name=\"マフィアA\"]   でもお前らみたいな善良な市民なら、当然協力してくれるよな？",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "でもお前らみたいな善良な市民なら、当然協力してくれるよな？"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#2",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"ワイフー\"]   脅しですか？",
        "type": "dialog",
        "speaker": "ワイフー",
        "content": "脅しですか？"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#2",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"マフィアA\"]   わかってるだろ。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "わかってるだろ。"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"ワイフー\"]   ならお断りします。",
        "type": "dialog",
        "speaker": "ワイフー",
        "content": "ならお断りします。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"マフィアB\"]   ……お断りだとぉ？",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "……お断りだとぉ？"
    },
    {
        "id": 61,
        "raw": "[name=\"マフィアB\"]   お嬢ちゃん、なにか勘違いしてるみたいだな。",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "お嬢ちゃん、なにか勘違いしてるみたいだな。"
    },
    {
        "id": 62,
        "raw": "[name=\"マフィアB\"]   それとも、お前もあそこの路地裏のゴミみたいに半殺しにされてぇのか？",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "それとも、お前もあそこの路地裏のゴミみたいに半殺しにされてぇのか？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_272_strong_1\")]",
        "type": "character",
        "name": "char_272_strong_1.png"
    },
    {
        "id": 64,
        "raw": "[name=\"ジェイ\"]   ワイフー、さっき聞こえた悲鳴は……。",
        "type": "dialog",
        "speaker": "ジェイ",
        "content": "ワイフー、さっき聞こえた悲鳴は……。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"ワイフー\"]   あなたたち、今、「ゴミ」って言いましたね？",
        "type": "dialog",
        "speaker": "ワイフー",
        "content": "あなたたち、今、「ゴミ」って言いましたね？"
    },
    {
        "id": 67,
        "raw": "[name=\"ワイフー\"]   念の為に重ねて質問しますが、それはここの住民のことを言ったのですか？",
        "type": "dialog",
        "speaker": "ワイフー",
        "content": "念の為に重ねて質問しますが、それはここの住民のことを言ったのですか？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "char_243_waaifu_1#3",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"マフィアA\"]   お前の無駄話に付き合ってる暇はねぇんだよ、さっさと——。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "お前の無駄話に付き合ってる暇はねぇんだよ、さっさと——。"
    },
