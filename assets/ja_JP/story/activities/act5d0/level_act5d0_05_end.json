        "name": "avg_npc_031.png"
    },
    {
        "id": 103,
        "raw": "[name=\"マフィアA\"]   ならクロスボウを——。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "ならクロスボウを——。"
