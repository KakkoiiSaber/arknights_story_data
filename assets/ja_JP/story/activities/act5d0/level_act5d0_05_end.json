    },
    {
        "id": 10,
        "raw": "龍門スラム街",
        "type": "narration",
        "content": "龍門スラム街"
    },
    {
        "id": 11,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 12,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 13,
        "raw": "[name=\"マフィアA\"]   チッ！　命が惜しいなら吐け！　鼠王はどこにいる！？",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "チッ！　命が惜しいなら吐け！　鼠王はどこにいる！？"
    },
    {
        "id": 14,
        "raw": "[name=\"スラム街の住民\"]   し、知らない！　鼠王ってなんだよ……。本当に聞いたこともないんだ！",
        "type": "dialog",
        "speaker": "スラム街の住民",
        "content": "し、知らない！　鼠王ってなんだよ……。本当に聞いたこともないんだ！"
    },
    {
        "id": 15,
        "raw": "[name=\"マフィアA\"]   テメェ、逆らうと痛い目見るぞ——！",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "テメェ、逆らうと痛い目見るぞ——！"
    },
    {
        "id": 16,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 17,
        "raw": "[name=\"マフィアB\"]   おい、カポネさんはカタギには手を出すなと……。",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "おい、カポネさんはカタギには手を出すなと……。"
    },
    {
        "id": 18,
        "raw": "[name=\"マフィアA\"]   こんな汚ぇ奴がカタギだと？　コソコソしやがって、ゴミみたいな感染者に決まってる！　その化けの皮をはがしてやろうか！？",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "こんな汚ぇ奴がカタギだと？　コソコソしやがって、ゴミみたいな感染者に決まってる！　その化けの皮をはがしてやろうか！？"
    },
    {
        "id": 19,
        "raw": "[name=\"スラム街の住民\"]   ま、待って！　殴らないでくれ！　本当に何も知らないんだ！",
        "type": "dialog",
        "speaker": "スラム街の住民",
        "content": "ま、待って！　殴らないでくれ！　本当に何も知らないんだ！"
    },
    {
        "id": 20,
        "raw": "[name=\"マフィアA\"]   なんだよ口がかてぇ奴だな！？",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "なんだよ口がかてぇ奴だな！？"
    },
    {
        "id": 21,
        "raw": "[name=\"スラム街の住民\"]   うぐっ——ゲホッ、うぅ——。",
        "type": "dialog",
        "speaker": "スラム街の住民",
        "content": "うぐっ——ゲホッ、うぅ——。"
    },
    {
        "id": 22,
        "raw": "[name=\"マフィアB\"]   行くぞ、こいつはもう放っておけ。胸糞悪ぃ。",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "行くぞ、こいつはもう放っておけ。胸糞悪ぃ。"
    },
    {
        "id": 23,
        "raw": "[name=\"マフィアB\"]   名簿だと、次のジジィがいるところはそう遠くない。魚団子を売ってやがるってよ。生鮮売り場の向かいだとさ。",
        "type": "dialog",
        "speaker": "マフィアB",
        "content": "名簿だと、次のジジィがいるところはそう遠くない。魚団子を売ってやがるってよ。生鮮売り場の向かいだとさ。"
    },
    {
        "id": 24,
        "raw": "[name=\"マフィアA\"]   チッ、時間の無駄だった。",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "チッ、時間の無駄だった。"
    },
    {
        "id": 25,
        "raw": "[name=\"スラム街の住民\"]   ぐ、はぁ——骨まで折れちまったじゃないか。あの——クソが——容赦なくやりやがって、がはっ！",
        "type": "dialog",
        "speaker": "スラム街の住民",
        "content": "ぐ、はぁ——骨まで折れちまったじゃないか。あの——クソが——容赦なくやりやがって、がはっ！"
    },
    {
        "id": 26,
        "raw": "[name=\"スラム街の住民\"]   絶対に……彼らに伝えなければ……。",
        "type": "dialog",
        "speaker": "スラム街の住民",
        "content": "絶対に……彼らに伝えなければ……。"
    },
