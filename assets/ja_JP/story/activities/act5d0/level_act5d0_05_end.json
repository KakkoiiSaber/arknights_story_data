        "name": "char_272_strong_1#4.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"マフィアA\"]   わ、わかったから、手を放せ！",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "わ、わかったから、手を放せ！"
