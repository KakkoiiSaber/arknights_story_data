        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 120,
        "raw": "[name=\"ジェイ\"]   おう、武器捨てて、ここから失せやがれ。",
        "type": "dialog",
        "speaker": "ジェイ",
        "content": "おう、武器捨てて、ここから失せやがれ。"
