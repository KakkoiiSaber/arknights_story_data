        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 108,
        "raw": "[name=\"マフィアA\"]   ぐっ！　手を放せ！　このクソ野郎！",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "ぐっ！　手を放せ！　このクソ野郎！"
