        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 118,
        "raw": "[name=\"マフィアA\"]   ち、力、強っ。待て！　待ってくれ！　ちぎれる！　ちぎれる！",
        "type": "dialog",
        "speaker": "マフィアA",
        "content": "ち、力、強っ。待て！　待ってくれ！　ちぎれる！　ちぎれる！"
