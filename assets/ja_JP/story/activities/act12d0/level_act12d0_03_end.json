    {
        "id": 93,
        "raw": "[name=\"ガヴィル\"]  試すってなにを？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "試すってなにを？"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_187_ccheal_1\",name2=\"char_416_zumama_1#2\",focus=2)]",
