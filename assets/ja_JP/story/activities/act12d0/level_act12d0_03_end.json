        "name2": "char_416_zumama_1#2",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"ズゥママ\"]  黙れ。今日は絶対負けないぞ、ガヴィル。",
        "type": "dialog",
        "speaker": "ズゥママ",
        "content": "黙れ。今日は絶対負けないぞ、ガヴィル。"
