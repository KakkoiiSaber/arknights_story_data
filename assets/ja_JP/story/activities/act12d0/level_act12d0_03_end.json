        "name2": "char_416_zumama_1#2",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"ガヴィル\"]  なに遺言みたいなこと言ってんだよ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "なに遺言みたいなこと言ってんだよ。"
