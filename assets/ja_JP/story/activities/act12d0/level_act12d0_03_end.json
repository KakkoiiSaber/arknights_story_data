        "name2": "char_416_zumama_1#2",
        "focus": 2
    },
    {
        "id": 95,
        "raw": "[name=\"ズゥママ\"]  私の拳で、お前を倒せるかどうかを。",
        "type": "dialog",
        "speaker": "ズゥママ",
        "content": "私の拳で、お前を倒せるかどうかを。"
