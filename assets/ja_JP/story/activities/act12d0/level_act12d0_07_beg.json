    {
        "id": 64,
        "raw": "[name=\"アダクリス人A\"]  おお！　大族長、やっと動いたぞ！",
        "type": "dialog",
        "speaker": "アダクリス人A",
        "content": "おお！　大族長、やっと動いたぞ！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"アダクリス人B\"]  なんて綺麗なエンジン音なんだ！　こんなに素晴らしい音は初めて聞いたぜ！",
        "type": "dialog",
        "speaker": "アダクリス人B",
        "content": "なんて綺麗なエンジン音なんだ！　こんなに素晴らしい音は初めて聞いたぜ！"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"avg_npc_070\", name2=\"avg_npc_072\", focus=2)]",
        "type": "character",
        "name": "avg_npc_070",
        "name2": "avg_npc_072",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"アダクリス人C\"]  ふふーん、やっぱりアタシのおかげね！",
        "type": "dialog",
        "speaker": "アダクリス人C",
        "content": "ふふーん、やっぱりアタシのおかげね！"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"avg_npc_072\", name2=\"char_416_zumama_1#6\", focus=2)]",
        "type": "character",
        "name": "avg_npc_072",
        "name2": "char_416_zumama_1#6",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"ユーネクテス\"]  お前たち、一体どうやったんだ？",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "お前たち、一体どうやったんだ？"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"char_416_zumama_1#6\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071",
        "name2": "char_416_zumama_1#6",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"アダクリス人A\"]  見ての通りだ大族長！　あれで試してみたら動いたんだ！",
        "type": "dialog",
        "speaker": "アダクリス人A",
        "content": "見ての通りだ大族長！　あれで試してみたら動いたんだ！"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_416_zumama_1#6\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "char_416_zumama_1#6",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"アダクリス人B\"]  このパイプをここに、あのパイプをあそこに挿してみたんだ！",
        "type": "dialog",
        "speaker": "アダクリス人B",
        "content": "このパイプをここに、あのパイプをあそこに挿してみたんだ！"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_072\", name2=\"char_416_zumama_1#6\", focus=1)]",
        "type": "character",
        "name": "avg_npc_072",
        "name2": "char_416_zumama_1#6",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"アダクリス人C\"]  ええ、ビッグ・アグリーを作り出したときのように！",
        "type": "dialog",
        "speaker": "アダクリス人C",
        "content": "ええ、ビッグ・アグリーを作り出したときのように！"
    },
