        "name": "char_337_utage_1"
    },
    {
        "id": 67,
        "raw": "[name=\"ウタゲ\"]  ううう、ドクターの薄情者！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "ううう、ドクターの薄情者！"
    },
    {
        "id": 68,
        "raw": "[Predicate(references=\"2\")]",
        "type": "predicate",
        "references": "2"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_337_utage_1\")]",
        "type": "character",
        "name": "char_337_utage_1"
    },
    {
        "id": 70,
        "raw": "[name=\"ウタゲ\"]  うう、そんな目で見ないでよ、ドクター。",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "うう、そんな目で見ないでよ、ドクター。"
    },
    {
