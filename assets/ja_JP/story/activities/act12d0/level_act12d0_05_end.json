    {
        "id": 136,
        "raw": "[Character(name=\"avg_npc_075\")]",
        "type": "character",
        "name": "avg_npc_075"
    },
    {
        "id": 137,
        "raw": "[name=\"イナム\"]  仲間が見つかってよかったわね。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "仲間が見つかってよかったわね。"
    },
    {
        "id": 138,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 139,
        "raw": "[name=\"ガヴィル\"]  お前のおかげだ、イナム。ありがとな。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "お前のおかげだ、イナム。ありがとな。"
    },
    {
        "id": 140,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 141,
        "raw": "[name=\"イナム\"]  お安い御用だわ。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "お安い御用だわ。"
    },
    {
        "id": 142,
        "raw": "[name=\"イナム\"]  ああそういえば、トミミは？　あんたたちと一緒にいるはずじゃないの？",
        "type": "dialog",
        "speaker": "イナム",
        "content": "ああそういえば、トミミは？　あんたたちと一緒にいるはずじゃないの？"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 144,
        "raw": "[name=\"ガヴィル\"]  やることがあるんだってさ。あとで落ち合う予定だ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "やることがあるんだってさ。あとで落ち合う予定だ。"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 146,
        "raw": "[name=\"イナム\"]  そう。じゃ、この本を渡しといてちょうだい。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "そう。じゃ、この本を渡しといてちょうだい。"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 148,
        "raw": "[name=\"ガヴィル\"]  ああ、わかった。どれどれ……『シティーレディ』、『100日で学ぶ企業管理』、『ファッション通になるには？』……",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ああ、わかった。どれどれ……『シティーレディ』、『100日で学ぶ企業管理』、『ファッション通になるには？』……"
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 150,
        "raw": "[CameraShake(duration=0.3, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true, block=true)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 151,
        "raw": "[name=\"ガヴィル\"]  何だよこのわけわかんねぇ本は！",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "何だよこのわけわかんねぇ本は！"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"イナム\"]  トミミはこういう本で、サルゴン語や外の知識を勉強してるのよ。基礎を教えたのは私だけどね。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "トミミはこういう本で、サルゴン語や外の知識を勉強してるのよ。基礎を教えたのは私だけどね。"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"char_337_utage_1\", name2=\"avg_npc_075\", focus=1)]",
        "type": "character",
        "name": "char_337_utage_1",
        "name2": "avg_npc_075",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"ウタゲ\"]  うえー、そんなやり方でサルゴン語を覚えるなんて大変でしょ？",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "うえー、そんなやり方でサルゴン語を覚えるなんて大変でしょ？"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_337_utage_1\", name2=\"avg_npc_075\", focus=2)]",
        "type": "character",
        "name": "char_337_utage_1",
        "name2": "avg_npc_075",
        "focus": 2
    },
    {
        "id": 157,
        "raw": "[name=\"イナム\"]  そうね。でもあの子はそうやって地道に学んだのよ。文字や単語を一つずつ覚えながらね。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "そうね。でもあの子はそうやって地道に学んだのよ。文字や単語を一つずつ覚えながらね。"
    },
    {
        "id": 158,
        "raw": "[name=\"イナム\"]  あの子にとっては、勉強の大変さよりも、外について学びたいのにやり方がわからないことのほうが辛かったみたい……",
        "type": "dialog",
        "speaker": "イナム",
        "content": "あの子にとっては、勉強の大変さよりも、外について学びたいのにやり方がわからないことのほうが辛かったみたい……"
    },
    {
        "id": 159,
        "raw": "[name=\"イナム\"]  あの頃は本当に見ていて痛々しくて……だから私もサルゴン語を教えてあげたくなったのよ。",
        "type": "dialog",
        "speaker": "イナム",
        "content": "あの頃は本当に見ていて痛々しくて……だから私もサルゴン語を教えてあげたくなったのよ。"
    },
    {
        "id": 160,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"avg_npc_075\", focus=2)]",
