        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 33,
        "raw": "[name=\"ウタゲ\"]  だいたいバカンスの名所って言われたから来たのに、ここのどこが名所だっつーの！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "だいたいバカンスの名所って言われたから来たのに、ここのどこが名所だっつーの！"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_337_utage_1\")]",
