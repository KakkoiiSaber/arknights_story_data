        "type": "character",
        "name": "char_201_moeshd"
    },
    {
        "id": 98,
        "raw": "[name=\"クロワッサン\"]  なるほどなぁ、つまり今はズゥママっちゅー人からエンジンを返してもらおうっちゅー話やな。",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "なるほどなぁ、つまり今はズゥママっちゅー人からエンジンを返してもらおうっちゅー話やな。"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_201_moeshd\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_201_moeshd",
        "focus": 1
    },
    {
        "id": 100,
        "raw": "[name=\"ガヴィル\"]  そうだ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "そうだ。"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 102,
        "raw": "[name=\"ウタゲ\"]  えっ？　じゃあ祭典はもう終わっちゃったってこと？",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "えっ？　じゃあ祭典はもう終わっちゃったってこと？"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_337_utage_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_337_utage_1",
        "focus": 1
    },
    {
        "id": 104,
        "raw": "[name=\"ガヴィル\"]  ああ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ああ。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 106,
        "raw": "[name=\"ウタゲ\"]  じゃああたしがわざわざ来た意味ないじゃん！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "じゃああたしがわざわざ来た意味ないじゃん！"
    },
    {
        "id": 107,
        "raw": "[name=\"ウタゲ\"]  はぁ……まーいいや。なんか聞いた感じ、つまんなそーだったし。",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "はぁ……まーいいや。なんか聞いた感じ、つまんなそーだったし。"
    },
    {
        "id": 108,
        "raw": "[name=\"ウタゲ\"]  それよりガヴィル、最初に言ってたバカンスの名所ってどこ？",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "それよりガヴィル、最初に言ってたバカンスの名所ってどこ？"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_337_utage_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_337_utage_1",
        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"ガヴィル\"]  あ？　ここいらって悪くないとこだと思わねぇか？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "あ？　ここいらって悪くないとこだと思わねぇか？"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 112,
        "raw": "[name=\"ウタゲ\"]  それは、確かに……そうだけど！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "それは、確かに……そうだけど！"
    },
    {
        "id": 113,
        "raw": "[name=\"ウタゲ\"]  でも、バカンスっぽい要素なんて一個もないじゃん！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "でも、バカンスっぽい要素なんて一個もないじゃん！"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_337_utage_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_337_utage_1",
        "focus": 1
    },
    {
        "id": 115,
        "raw": "[name=\"ガヴィル\"]  バカンスっぽい要素ってなんだよ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "バカンスっぽい要素ってなんだよ。"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"ウタゲ\"]  そりゃもちろん、海、砂浜、パラソル、アイスクリームに決まってるでしょ！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "そりゃもちろん、海、砂浜、パラソル、アイスクリームに決まってるでしょ！"
    },
    {
        "id": 118,
        "raw": "[name=\"ウタゲ\"]  そのためにわざわざ新しい水着まで買って、服の下に着て来てんだから！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "そのためにわざわざ新しい水着まで買って、服の下に着て来てんだから！"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_337_utage_1\", name2=\"char_201_moeshd\", focus=2)]",
        "type": "character",
        "name": "char_337_utage_1",
        "name2": "char_201_moeshd",
        "focus": 2
    },
    {
        "id": 120,
        "raw": "[name=\"クロワッサン\"]  えっ、水着まで用意してたんか？　ウチは単純に暇やからついてきただけなんやけど……",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "えっ、水着まで用意してたんか？　ウチは単純に暇やからついてきただけなんやけど……"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_201_moeshd#3\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_201_moeshd#3",
        "focus": 1
    },
    {
        "id": 122,
        "raw": "[name=\"ガヴィル\"]  そんなもんがあるなんて、最初から言ってねぇだろ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "そんなもんがあるなんて、最初から言ってねぇだろ。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 124,
        "raw": "[name=\"ウタゲ\"]  水遊びできるって言ってたじゃん！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "水遊びできるって言ってたじゃん！"
    },
    {
        "id": 125,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_337_utage_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_337_utage_1",
        "focus": 1
    },
    {
        "id": 126,
        "raw": "[name=\"ガヴィル\"]  ああ、それならジャングルの奥にでかい滝があるから、そこで遊べるぜ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ああ、それならジャングルの奥にでかい滝があるから、そこで遊べるぜ。"
    },
    {
        "id": 127,
        "raw": "[name=\"ガヴィル\"]  どうせ、ズゥママの部族に向かう途中に通るしな。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "どうせ、ズゥママの部族に向かう途中に通るしな。"
    },
    {
        "id": 128,
        "raw": "[name=\"ガヴィル\"]  それに、水着ならアタシも持ってきてるぜ。まだ出してねぇけど。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "それに、水着ならアタシも持ってきてるぜ。まだ出してねぇけど。"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_337_utage_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_337_utage_1",
        "focus": 2
    },
    {
        "id": 130,
        "raw": "[name=\"ウタゲ\"]  マジ？　よっしゃー！",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "マジ？　よっしゃー！"
    },
