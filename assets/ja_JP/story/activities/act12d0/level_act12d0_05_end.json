        "id": 64,
        "raw": "[Decision(options=\"自分でなんとかして。;……;ここに残って族長をやるのは？\",values=\"1;2;3\")]",
        "type": "decision",
        "options": "自分でなんとかして。;……;ここに残って族長をやるのは？",
        "values": "1;2;3"
