        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 135,
        "raw": "[name=\"ヨギ\"]  聞かれてねぇんだからわざわざ言わないだろ……",
        "type": "dialog",
        "speaker": "ヨギ",
        "content": "聞かれてねぇんだからわざわざ言わないだろ……"
    },
