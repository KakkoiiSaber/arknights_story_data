    {
        "id": 210,
        "raw": "[name=\"ユーネクテス\"]  ……じいや、なぜ今ビッグ・アグリーを出す？",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "……じいや、なぜ今ビッグ・アグリーを出す？"
    },
    {
        "id": 211,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 212,
        "raw": "[name=\"大祭司\"]  なんじゃ、使わんのか？　使わんなら戻しとくぞい。エンジンのテストもまだじゃからのう。",
        "type": "dialog",
        "speaker": "大祭司",
        "content": "なんじゃ、使わんのか？　使わんなら戻しとくぞい。エンジンのテストもまだじゃからのう。"
