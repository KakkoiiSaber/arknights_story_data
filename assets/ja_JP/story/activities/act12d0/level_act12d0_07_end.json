    {
        "id": 213,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1"
    },
    {
        "id": 214,
        "raw": "[name=\"ユーネクテス\"]  ……使う。だが、今ではない。まだ話が終わっていない。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "……使う。だが、今ではない。まだ話が終わっていない。"
