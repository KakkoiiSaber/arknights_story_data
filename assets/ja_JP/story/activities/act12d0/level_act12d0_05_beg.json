        "focus": 2
    },
    {
        "id": 175,
        "raw": "[name=\"クロワッサン\"]  会ってへんなあ。イナムはんにも聞いたんやけど、それらしい情報はないって。",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "会ってへんなあ。イナムはんにも聞いたんやけど、それらしい情報はないって。"
    },
