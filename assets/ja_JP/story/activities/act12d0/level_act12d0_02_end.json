        "name2": "char_411_tomimi_1#3",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"トミミ\"]  えへへ……ガヴィルさんに褒められました。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "えへへ……ガヴィルさんに褒められました。"
