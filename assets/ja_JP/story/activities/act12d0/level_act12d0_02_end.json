    {
        "id": 30,
        "raw": "[name=\"トミミ\"]  ガヴィルさん、どうして見逃してあげたんですか？",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "ガヴィルさん、どうして見逃してあげたんですか？"
    },
    {
        "id": 31,
        "raw": "[name=\"トミミ\"]  昔のガヴィルさんなら、全員気を失うまでボコボコにしてたはずなのに。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "昔のガヴィルさんなら、全員気を失うまでボコボコにしてたはずなのに。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"ガヴィル\"]  ああ、昔のアタシならな。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ああ、昔のアタシならな。"
    },
    {
        "id": 34,
        "raw": "[name=\"ガヴィル\"]  だけど今は、あいつらにもどっか可愛げがあるように見えてな……そうだろ、ドクター。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "だけど今は、あいつらにもどっか可愛げがあるように見えてな……そうだろ、ドクター。"
    },
    {
        "id": 35,
        "raw": "[Decision(options=\"よく理解できないが、そうだな。;……;じゃあ殴らなくても良かったんじゃ……\",values=\"1;2;3\")]",
        "type": "decision",
        "options": "よく理解できないが、そうだな。;……;じゃあ殴らなくても良かったんじゃ……",
        "values": "1;2;3"
    },
    {
