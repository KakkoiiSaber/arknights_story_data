    },
    {
        "id": 203,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 204,
        "raw": "[name=\"トミミ\"]  あ、確かにAUSの歌ですね。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "あ、確かにAUSの歌ですね。"
    },
    {
        "id": 205,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 206,
        "raw": "[name=\"ガヴィル\"]  お前も知ってるのか！？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "お前も知ってるのか！？"
    },
    {
        "id": 207,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 208,
        "raw": "[name=\"トミミ\"]  はい。たしか去年のことです、「AUS」を自称する風変わりな来訪者がここに来たんですよ。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "はい。たしか去年のことです、「AUS」を自称する風変わりな来訪者がここに来たんですよ。"
    },
    {
        "id": 209,
        "raw": "[name=\"トミミ\"]  彼女たちはイナムの部族でライブをしたんですが、それが受けて、多くのティアカウが彼女たちのことを「マヒゾッティア」の使者と呼ぶようになったんです。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "彼女たちはイナムの部族でライブをしたんですが、それが受けて、多くのティアカウが彼女たちのことを「マヒゾッティア」の使者と呼ぶようになったんです。"
    },
    {
        "id": 210,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 211,
        "raw": "[name=\"ガヴィル\"]  は？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "は？"
    },
    {
        "id": 212,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 213,
        "raw": "[name=\"トミミ\"]  それから、ティアカウたちの熱い歓迎と誘いを受けて、彼女たちはかなりの間滞在してくれたんです。霊殿はいつもライブで賑わっていました。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "それから、ティアカウたちの熱い歓迎と誘いを受けて、彼女たちはかなりの間滞在してくれたんです。霊殿はいつもライブで賑わっていました。"
    },
    {
        "id": 214,
        "raw": "[name=\"トミミ\"]  私も聴きに行きましたが、本当にいい音楽でした……それにアーツの技量もかなりのものに見えました。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "私も聴きに行きましたが、本当にいい音楽でした……それにアーツの技量もかなりのものに見えました。"
    },
    {
        "id": 215,
        "raw": "[name=\"トミミ\"]  それで、それからというもの、かなり多くのティアカウたちがあの音楽にハマってしまったんです。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "それで、それからというもの、かなり多くのティアカウたちがあの音楽にハマってしまったんです。"
    },
    {
        "id": 216,
        "raw": "[name=\"トミミ\"]  でもある日、彼女たちはこつ然と姿を消しました。みんなは先祖の懐に帰ったんだって言ってますが……",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "でもある日、彼女たちはこつ然と姿を消しました。みんなは先祖の懐に帰ったんだって言ってますが……"
    },
    {
        "id": 217,
        "raw": "[name=\"トミミ\"]  彼女たちはただ出て行っただけなんだと思います。ガヴィルさんと同じように。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "彼女たちはただ出て行っただけなんだと思います。ガヴィルさんと同じように。"
    },
    {
        "id": 218,
        "raw": "[name=\"トミミ\"]  今聴こえてくる音楽は、彼女たちが去り際に残した「すぴーかー」というもので流してるんだと思います。彼女たちは「すぴーかー」だけじゃなく、「あるばむ」もたくさん残していきましたから。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "今聴こえてくる音楽は、彼女たちが去り際に残した「すぴーかー」というもので流してるんだと思います。彼女たちは「すぴーかー」だけじゃなく、「あるばむ」もたくさん残していきましたから。"
    },
    {
        "id": 219,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 220,
        "raw": "[name=\"ガヴィル\"]  スピーカー？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "スピーカー？"
    },
    {
        "id": 221,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 222,
        "raw": "[name=\"トミミ\"]  はい、アーツでしか起動しないものなので、司祭と呪術医たちしか使えませんが。普段はイナムの部族が保管してるはずです。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "はい、アーツでしか起動しないものなので、司祭と呪術医たちしか使えませんが。普段はイナムの部族が保管してるはずです。"
    },
    {
        "id": 223,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#5",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 224,
        "raw": "[name=\"ガヴィル\"]  ハハハ、来るも去るも気分次第ってか。フリーダムなバンドだな。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ハハハ、来るも去るも気分次第ってか。フリーダムなバンドだな。"
    },
    {
        "id": 225,
        "raw": "[name=\"ガヴィル\"]  確かに刺激的な音楽だな。まだ霊殿に入ってないのに血が滾ってきたぜ。アタシもファンになりそうだ！",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "確かに刺激的な音楽だな。まだ霊殿に入ってないのに血が滾ってきたぜ。アタシもファンになりそうだ！"
    },
    {
        "id": 226,
        "raw": "[name=\"ガヴィル\"]  行こうぜ、ドクター。中で曲を聴きながら、祭典を楽しもうぜ！",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "行こうぜ、ドクター。中で曲を聴きながら、祭典を楽しもうぜ！"
    },
