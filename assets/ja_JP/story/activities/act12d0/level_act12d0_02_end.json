        "name2": "char_411_tomimi_1#3",
        "focus": 2
    },
    {
        "id": 174,
        "raw": "[name=\"トミミ\"]  そんなふうに言わないでください。みんな祭典が楽しみで、ガヴィルさんのことも大好きなんですから！",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "そんなふうに言わないでください。みんな祭典が楽しみで、ガヴィルさんのことも大好きなんですから！"
    },
    {
        "id": 175,
        "raw": "[name=\"トミミ\"]  あ、ガヴィルさん。あの看板を見てください。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "あ、ガヴィルさん。あの看板を見てください。"
