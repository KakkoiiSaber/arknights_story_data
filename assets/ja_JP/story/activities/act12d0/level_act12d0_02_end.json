        "name": "char_411_tomimi_1"
    },
    {
        "id": 50,
        "raw": "[name=\"トミミ\"]  ガヴィルさん……やっぱり変わってしまいました。",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "ガヴィルさん……やっぱり変わってしまいました。"
