        "name2": "char_411_tomimi_1#2",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"トミミ\"]  あっ……えっと、つまり、ガヴィルさんが帰って来たら役に立てるように、です！　さっきみたいに！",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "あっ……えっと、つまり、ガヴィルさんが帰って来たら役に立てるように、です！　さっきみたいに！"
    },
