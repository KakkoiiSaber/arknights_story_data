    {
        "id": 21,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 22,
        "raw": "[name=\"ガヴィル\"]  おい、あいつは大丈夫なのかよ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "おい、あいつは大丈夫なのかよ。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"ユーネクテス\"]  心配ない、じきに戻る。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "心配ない、じきに戻る。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"ガヴィル\"]  じゃあいいけどよ。つーかあれって本当に普通のヤツなのか？　あんなヤツがいるなんて聞いたことねぇんだけど。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "じゃあいいけどよ。つーかあれって本当に普通のヤツなのか？　あんなヤツがいるなんて聞いたことねぇんだけど。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"ユーネクテス\"]  私にもわからない。本人からは、ずいぶん長くここで生活していたという話しか聞いていない。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "私にもわからない。本人からは、ずいぶん長くここで生活していたという話しか聞いていない。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"ガヴィル\"]  ふぅん。それよりも……",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ふぅん。それよりも……"
    },
    {
        "id": 31,
        "raw": "[name=\"ガヴィル\"]  本当に大したデカブツだったな。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "本当に大したデカブツだったな。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer"
    },
    {
        "id": 33,
        "raw": "[name=\"ブレイズ\"]  ガヴィル、頭から血が出てるよ！　大丈夫？",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "ガヴィル、頭から血が出てるよ！　大丈夫？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 35,
        "raw": "[name=\"ガヴィル\"]  平気平気、こんくらい掠り傷だよ。トミミ、アタシの救急箱を持ってきてくれ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "平気平気、こんくらい掠り傷だよ。トミミ、アタシの救急箱を持ってきてくれ。"
    },
    {
        "id": 36,
        "raw": "[name=\"ガヴィル\"]  ん？　トミミのガキンチョはどこ行ったんだ？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ん？　トミミのガキンチョはどこ行ったんだ？"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_337_utage_summer_1\")]",
        "type": "character",
        "name": "char_337_utage_summer_1"
    },
    {
        "id": 38,
        "raw": "[name=\"ウタゲ\"]  ほい、救急箱だよ。トミミなら、あいつを倒す寸前に慌ててどっかに走ってったけど……",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "ほい、救急箱だよ。トミミなら、あいつを倒す寸前に慌ててどっかに走ってったけど……"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 40,
        "raw": "[name=\"ガヴィル\"]  サンキュー。まさかあいつ、ちびったんじゃねぇだろうな。まあいいや、先に手当しとくか。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "サンキュー。まさかあいつ、ちびったんじゃねぇだろうな。まあいいや、先に手当しとくか。"
    },
    {
        "id": 41,
        "raw": "[name=\"ガヴィル\"]  そうだ、お前らはほかにケガ人がいないか見てきてくれねぇか。いたら全員ここに連れてきてくれ。アタシが診るから。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "そうだ、お前らはほかにケガ人がいないか見てきてくれねぇか。いたら全員ここに連れてきてくれ。アタシが診るから。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_2013_cerber_1\")]",
        "type": "character",
        "name": "char_2013_cerber_1"
    },
    {
        "id": 43,
        "raw": "[name=\"ケオベ\"]  おー、おいらにまかせろ！",
        "type": "dialog",
        "speaker": "ケオベ",
        "content": "おー、おいらにまかせろ！"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer"
    },
    {
        "id": 45,
        "raw": "[name=\"ブレイズ\"]  ハハッ、了解。",
        "type": "dialog",
        "speaker": "ブレイズ",
        "content": "ハハッ、了解。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_337_utage_summer_1#3\")]",
        "type": "character",
        "name": "char_337_utage_summer_1#3"
    },
    {
        "id": 47,
        "raw": "[name=\"ウタゲ\"]  えー、めんど。",
        "type": "dialog",
        "speaker": "ウタゲ",
        "content": "えー、めんど。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_201_moeshd_summer\")]",
        "type": "character",
        "name": "char_201_moeshd_summer"
    },
    {
        "id": 49,
        "raw": "[name=\"クロワッサン\"]  ほらほら、文句はその辺にしときや。",
        "type": "dialog",
        "speaker": "クロワッサン",
        "content": "ほらほら、文句はその辺にしときや。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1"
    },
    {
        "id": 51,
        "raw": "[name=\"ガヴィル\"]  ドクター……ん？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ドクター……ん？"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1"
    },
    {
        "id": 53,
        "raw": "[name=\"ユーネクテス\"]  ビッグ……アグリー……",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "ビッグ……アグリー……"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"ガヴィル\"]  ズゥママ、わりぃな。バラバラにブッ壊すしかなかった。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ズゥママ、わりぃな。バラバラにブッ壊すしかなかった。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"ユーネクテス\"]  わかっている。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "わかっている。"
    },
    {
        "id": 58,
        "raw": "[name=\"ユーネクテス\"]  確認した限り、お前のエンジンは無事のようだ。あとで返そう。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "確認した限り、お前のエンジンは無事のようだ。あとで返そう。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"ガヴィル\"]  そうか、そりゃあ助かるぜ！",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "そうか、そりゃあ助かるぜ！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"ユーネクテス\"]  ガヴィル、ここに残るつもりはないのか？",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "ガヴィル、ここに残るつもりはないのか？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"ガヴィル\"]  お前と同じように、アタシにもやりたいことが見つかったんだ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "お前と同じように、アタシにもやりたいことが見つかったんだ。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"ユーネクテス\"]  医者か？",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "医者か？"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"ガヴィル\"]  ああ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ああ。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"ユーネクテス\"]  医者をやるのは楽しいか？",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "医者をやるのは楽しいか？"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"ガヴィル\"]  うーん、機械を作るのは楽しいか？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "うーん、機械を作るのは楽しいか？"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"ユーネクテス\"]  楽しい。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "楽しい。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1#5\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#5",
        "name2": "char_416_zumama_1#5",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"ガヴィル\"]  そういうことだ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "そういうことだ。"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#5",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"ユーネクテス\"]  だが、やはり大族長はお前しかいない。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "だが、やはり大族長はお前しかいない。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"ガヴィル\"]  ハァ？　なんでだよ？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ハァ？　なんでだよ？"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"ユーネクテス\"]  ビッグ・アグリーを倒したからだ。ガヴィル、お前の勝利だ。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "ビッグ・アグリーを倒したからだ。ガヴィル、お前の勝利だ。"
    },
    {
        "id": 83,
