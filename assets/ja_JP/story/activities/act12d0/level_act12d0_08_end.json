        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"ガヴィル\"]  ん？　ああ大丈夫だ。どこに行ってたんだ？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ん？　ああ大丈夫だ。どこに行ってたんだ？"
