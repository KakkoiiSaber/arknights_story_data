    },
    {
        "id": 108,
        "raw": "[name=\"ガヴィル\"]  ハハハ、残念だがドクターじゃ無理だ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ハハハ、残念だがドクターじゃ無理だ。"
