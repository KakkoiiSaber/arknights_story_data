    {
        "id": 13,
        "raw": "[name=\"アダクリス人A\"]  ユーネクテス！　ユーネクテス！",
        "type": "dialog",
        "speaker": "アダクリス人A",
        "content": "ユーネクテス！　ユーネクテス！"
    },
    {
        "id": 14,
