    {
        "id": 64,
        "raw": "[name=\"トミミ\"]  こ、ここはどこ……",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "こ、ここはどこ……"
    },
    {
        "id": 65,
        "raw": "[name=\"トミミ\"]  ううう、おうちに帰りたいよ……",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "ううう、おうちに帰りたいよ……"
    },
    {
        "id": 66,
        "raw": "[name=\"トミミ\"]  きゃああ！",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "きゃああ！"
    },
    {
        "id": 67,
        "raw": "[name=\"ガヴィル\"]  おい、大丈夫か、トミミ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "おい、大丈夫か、トミミ。"
    },
    {
        "id": 68,
        "raw": "[name=\"トミミ\"]  ガヴィルさん……",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "ガヴィルさん……"
    },
    {
        "id": 69,
        "raw": "[name=\"ガヴィル\"]  ったくこのガキンチョは、少し目を離したスキこんなとこまで……死ぬほど探したぞ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "ったくこのガキンチョは、少し目を離したスキこんなとこまで……死ぬほど探したぞ。"
    },
    {
        "id": 70,
        "raw": "[name=\"トミミ\"]  ガヴィルさん、血が出てます！",
        "type": "dialog",
        "speaker": "トミミ",
        "content": "ガヴィルさん、血が出てます！"
    },
    {
        "id": 71,
        "raw": "[name=\"ガヴィル\"]  あぁ？　平気平気、これくらいどうってことねぇよ。",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "あぁ？　平気平気、これくらいどうってことねぇよ。"
    },
    {
        "id": 72,
