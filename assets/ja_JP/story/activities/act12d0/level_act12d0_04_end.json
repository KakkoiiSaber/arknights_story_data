    {
        "id": 68,
        "raw": "[name=\"ユーネクテス\"]  ガヴィル、まさか戻ってくるとはな。",
        "type": "dialog",
        "speaker": "ユーネクテス",
        "content": "ガヴィル、まさか戻ってくるとはな。"
