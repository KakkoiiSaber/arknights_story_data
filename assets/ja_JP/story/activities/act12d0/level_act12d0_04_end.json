        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 150,
        "raw": "[name=\"ガヴィル\"]  なにわけわかんねぇこと言ってんだ？",
        "type": "dialog",
        "speaker": "ガヴィル",
        "content": "なにわけわかんねぇこと言ってんだ？"
