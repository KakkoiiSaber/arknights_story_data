    {
        "id": 54,
        "raw": "ある日、ここに来てからずっと私たちの面倒を見てくれていた女性が姿を消した。",
        "type": "narration",
        "content": "ある日、ここに来てからずっと私たちの面倒を見てくれていた女性が姿を消した。"
    },
    {
        "id": 55,
        "raw": "彼女がいなくなってから、私たちとは別の場所に住んでいて、食事を届けてくれる人たちが喧嘩するようになった。",
        "type": "narration",
        "content": "彼女がいなくなってから、私たちとは別の場所に住んでいて、食事を届けてくれる人たちが喧嘩するようになった。"
    },
    {
        "id": 56,
        "raw": "その人たちが何について言い争っているのかはわからない。ただ、よく歌を歌ってくれていたあのお姉さんが、もう戻ってこないことは理解した。",
        "type": "narration",
        "content": "その人たちが何について言い争っているのかはわからない。ただ、よく歌を歌ってくれていたあのお姉さんが、もう戻ってこないことは理解した。"
    },
    {
        "id": 57,
        "raw": "あれは確か、こんな歌だった。",
        "type": "narration",
        "content": "あれは確か、こんな歌だった。"
    },
    {
        "id": 58,
        "raw": "澄み渡る空は青を湛え",
        "type": "narration",
        "content": "澄み渡る空は青を湛え"
    },
    {
        "id": 59,
        "raw": "そよ風はたおやかに歌う",
        "type": "narration",
        "content": "そよ風はたおやかに歌う"
    },
    {
        "id": 60,
        "raw": "川の水面は絶えず姿を変えて",
        "type": "narration",
        "content": "川の水面は絶えず姿を変えて"
    },
    {
        "id": 61,
        "raw": "我が心は希望に満ちる――",
        "type": "narration",
        "content": "我が心は希望に満ちる――"
    },
    {
        "id": 62,
        "raw": "歌には続きがあるようだったが、彼女が歌ってくれたことはない。",
        "type": "narration",
        "content": "歌には続きがあるようだったが、彼女が歌ってくれたことはない。"
    },
