    {
        "id": 72,
        "raw": "[name=\"心配性な貴族\"]死にました……",
        "type": "dialog",
        "speaker": "心配性な貴族",
        "content": "死にました……"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_491_1#1$1\")]",
        "type": "character",
        "name": "avg_npc_491_1#1$1.png"
    },
    {
        "id": 74,
        "raw": "[name=\"自分勝手な術師\"]死んだから何？　進歩はあったでしょう！",
        "type": "dialog",
        "speaker": "自分勝手な術師",
        "content": "死んだから何？　進歩はあったでしょう！"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_491_1#1$1\")]",
