    {
        "id": 111,
        "raw": "それからまた一年が過ぎた。あるいは二年だったか……私にはもうわからなくなっていた。",
        "type": "narration",
        "content": "それからまた一年が過ぎた。あるいは二年だったか……私にはもうわからなくなっていた。"
    },
    {
        "id": 112,
        "raw": "残ったのは私とあの子だけだった。",
        "type": "narration",
        "content": "残ったのは私とあの子だけだった。"
    },
    {
        "id": 113,
        "raw": "あの人たちが部屋に来るたび、私は恐怖で震えていた。",
        "type": "narration",
        "content": "あの人たちが部屋に来るたび、私は恐怖で震えていた。"
    },
    {
        "id": 114,
        "raw": "そんな時、あの子はいつも大丈夫だと私を慰め、連中から私を庇っていた。",
        "type": "narration",
        "content": "そんな時、あの子はいつも大丈夫だと私を慰め、連中から私を庇っていた。"
    },
    {
        "id": 115,
        "raw": "あの人たちが去ると、彼は歌を歌ってくれる。",
