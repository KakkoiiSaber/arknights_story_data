        "block": true
    },
    {
        "id": 111,
        "raw": "[name=\"フォリニック\"]  リサちゃん？",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "リサちゃん？"
    },
    {
        "id": 112,
        "raw": "[name=\"スズラン\"]  このプレートは……",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "このプレートは……"
    },
    {
        "id": 113,
        "raw": "[name=\"フォリニック\"]  ……アントのIDカードね、焼けずに残ってるなんて……",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……アントのIDカードね、焼けずに残ってるなんて……"
    },
    {
        "id": 114,
        "raw": "[name=\"フォリニック\"]  ……そうだ。そういえば……",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……そうだ。そういえば……"
    },
    {
        "id": 115,
        "raw": "[name=\"フォリニック\"]  あの子、仕事のときにIDカードが邪魔だってよく言ってたわね。胸の前に下げてるだけで、どこが邪魔なんだか……",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "あの子、仕事のときにIDカードが邪魔だってよく言ってたわね。胸の前に下げてるだけで、どこが邪魔なんだか……"
    },
    {
        "id": 116,
        "raw": "[name=\"フォリニック\"]  ああ……行きましょう。早く、あの子に会いたい。",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "ああ……行きましょう。早く、あの子に会いたい。"
    },
