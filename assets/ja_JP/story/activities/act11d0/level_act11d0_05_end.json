        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 224,
        "raw": "[name=\"エアースカーペ\"]  現地の住民も多いようだが、いいのか？",
        "type": "dialog",
        "speaker": "エアースカーペ",
        "content": "現地の住民も多いようだが、いいのか？"
    },
    {
        "id": 225,
