        "type": "character",
        "name": "char_294_ayer",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 226,
        "raw": "[name=\"グレースロート\"]  極力急所は狙わないで。行くよ。",
        "type": "dialog",
