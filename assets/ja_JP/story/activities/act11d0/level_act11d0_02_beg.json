        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"スズラン\"]  フォリニックお姉さん……怒ってるんですか？",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "フォリニックお姉さん……怒ってるんですか？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"フォリニック\"]  彼らの態度が何を意味するか、はっきりとわかったから……",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "彼らの態度が何を意味するか、はっきりとわかったから……"
    },
    {
        "id": 19,
        "raw": "[name=\"フォリニック\"]  でも、ううん、アントはきっと無事よ。あの子は私たちの誰よりもリターニアに詳しいんだから！",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "でも、ううん、アントはきっと無事よ。あの子は私たちの誰よりもリターニアに詳しいんだから！"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_358_lisa_1#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"スズラン\"]  はい！　アントお姉さんはきっと無事です。",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "はい！　アントお姉さんはきっと無事です。"
    },
    {
        "id": 22,
        "raw": "[name=\"スズラン\"]  無事だと……いいです……",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "無事だと……いいです……"
    },
