        "focus": 2
    },
    {
        "id": 130,
        "raw": "[name=\"フォリニック\"]  アントはここで、医者として働いていたんですか？",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "アントはここで、医者として働いていたんですか？"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 132,
        "raw": "[name=\"タチヤナ\"]  ええっと、そうです……感染者の治療とカウンセリングなどを行っていました。",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "ええっと、そうです……感染者の治療とカウンセリングなどを行っていました。"
    },
    {
        "id": 133,
        "raw": "[name=\"タチヤナ\"]  天災トランスポーターが、大裂溝の発生を予測できず……避難が遅れたウォルモンドは、大きな被害を受けました。",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "天災トランスポーターが、大裂溝の発生を予測できず……避難が遅れたウォルモンドは、大きな被害を受けました。"
    },
    {
        "id": 134,
        "raw": "[name=\"タチヤナ\"]  アント先生は、ここを離れる選択もできたはずなのに、残ってくださいました。ウォルモンドが現在の位置に停泊してからは、感染者たちがより安心できるようにと、臨時の医療拠点まで建てられて。",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "アント先生は、ここを離れる選択もできたはずなのに、残ってくださいました。ウォルモンドが現在の位置に停泊してからは、感染者たちがより安心できるようにと、臨時の医療拠点まで建てられて。"
    },
    {
        "id": 135,
        "raw": "[name=\"タチヤナ\"]  アント先生は……感染者たちの英雄だったんです。",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "アント先生は……感染者たちの英雄だったんです。"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#2",
        "focus": 2
    },
    {
        "id": 137,
        "raw": "[name=\"フォリニック\"]  ……それが、感染者を救うのが、あの子の仕事ですから。",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……それが、感染者を救うのが、あの子の仕事ですから。"
    },
    {
        "id": 138,
        "raw": "[name=\"フォリニック\"]  それに、本とにらめっこして勉強するよりも、身体を動かす方が好きだったんですよ、あの子。",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "それに、本とにらめっこして勉強するよりも、身体を動かす方が好きだったんですよ、あの子。"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#2",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"タチヤナ\"]  ……",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "……"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"フォリニック\"]  ……フフ、医師なんて……本当にあの子にピッタリの仕事です。得意げな顔が目に浮かびます。",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……フフ、医師なんて……本当にあの子にピッタリの仕事です。得意げな顔が目に浮かびます。"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1",
        "focus": 1
    },
    {
        "id": 144,
        "raw": "[name=\"タチヤナ\"]  フォリニックさん、ウォルモンドにいらっしゃってから、初めて笑顔を見た気がします。",
        "type": "dialog",
        "speaker": "タチヤナ",
        "content": "フォリニックさん、ウォルモンドにいらっしゃってから、初めて笑顔を見た気がします。"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"avg_npc_069\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 146,
        "raw": "[name=\"フォリニック\"]  ……えっ、そうですか？",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……えっ、そうですか？"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 148,
        "raw": "[name=\"スズラン\"]  はい、今日フォリニックお姉さんはずっと怖い顔をしていました。",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "はい、今日フォリニックお姉さんはずっと怖い顔をしていました。"
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 150,
        "raw": "[name=\"フォリニック\"]  そう……",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "そう……"
    },
