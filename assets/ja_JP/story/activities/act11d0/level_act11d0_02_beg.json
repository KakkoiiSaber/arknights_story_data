        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"スズラン\"]  さっきから、お姉さんはすごく怖い顔をしてますよ。きっと大丈夫ですから。",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "さっきから、お姉さんはすごく怖い顔をしてますよ。きっと大丈夫ですから。"
    },
    {
        "id": 84,
        "raw": "[name=\"スズラン\"]  私たちが頑張れば、うまく解決できるはずです。先輩オペレーターさんたちみたいに！",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "私たちが頑張れば、うまく解決できるはずです。先輩オペレーターさんたちみたいに！"
    },
    {
        "id": 85,
        "raw": "[name=\"スズラン\"]  だからどうかリラックスしてくださいね？",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "だからどうかリラックスしてくださいね？"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_358_lisa_1\", name2=\"char_345_folnic_1#2\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1.png",
        "name2": "char_345_folnic_1#2",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"フォリニック\"]  ……はぁ、またリサちゃんに励まされちゃったわね。私はいったいどうしちゃったのかしら。",
        "type": "dialog",
        "speaker": "フォリニック",
        "content": "……はぁ、またリサちゃんに励まされちゃったわね。私はいったいどうしちゃったのかしら。"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_358_lisa_1\", name2=\"char_345_folnic_1#2\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1.png",
        "name2": "char_345_folnic_1#2",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"スズラン\"]  えへへ、悩み事に大人も子供もないですよ。",
        "type": "dialog",
        "speaker": "スズラン",
        "content": "えへへ、悩み事に大人も子供もないですよ。"
    },
