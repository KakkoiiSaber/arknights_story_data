        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"看守\"]私はジェッセルトンと申します、ミス・ロビン。",
        "type": "dialog",
        "speaker": "看守",
        "content": "私はジェッセルトンと申します、ミス・ロビン。"
