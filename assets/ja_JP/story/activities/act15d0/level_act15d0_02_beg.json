        "type": "character",
        "name": "char_242_mayer#2",
        "name2": "char_249_muesys_1#6",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"ミュルジス\"]作る前に食材のチェックしてね。食材に何か小細工しただろなんて後で言われたくないから。",
        "type": "dialog",
        "speaker": "ミュルジス",
