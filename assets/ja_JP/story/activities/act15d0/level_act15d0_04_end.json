    {
        "id": 72,
        "raw": "[name=\"メイヤー\"]……ごめんサイレンス。どうやって慰めればいいかわからないよ。",
        "type": "dialog",
        "speaker": "メイヤー",
        "content": "……ごめんサイレンス。どうやって慰めればいいかわからないよ。"
