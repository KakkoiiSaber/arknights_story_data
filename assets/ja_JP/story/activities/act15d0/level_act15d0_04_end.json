        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"メイヤー\"]さっすがサイレンスだね、こんなに早く立ち直るなんて。",
        "type": "dialog",
        "speaker": "メイヤー",
        "content": "さっすがサイレンスだね、こんなに早く立ち直るなんて。"
    },
