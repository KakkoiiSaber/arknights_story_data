        "fadetime": "1,block=true"
    },
    {
        "id": 18,
        "raw": "[CharacterCutin(widgetID=\"1\", name=\"avg_npc_192_1#1\", style=\"cutin\", fadestyle= \"horiz_expand_center\", fadetime=0.5, offsetx=-300, width=200, block=true)]",
