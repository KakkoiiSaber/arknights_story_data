    },
    {
        "id": 130,
        "raw": "[name=\"D.D.D.\"]トップを行くのは依然として、チーム『甘い夏』だ！　ジャーヴァン選手が破竹の勢いでゴールラインに向かっているぞ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "トップを行くのは依然として、チーム『甘い夏』だ！　ジャーヴァン選手が破竹の勢いでゴールラインに向かっているぞ！"
    },
    {
        "id": 131,
        "raw": "[name=\"D.D.D.\"]ほかのチームも彼の後ろにぴったりつけて追い上げるーっ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "ほかのチームも彼の後ろにぴったりつけて追い上げるーっ！"
    },
    {
        "id": 132,
        "raw": "[name=\"D.D.D.\"]しかーし！　そんな彼らを予想もしない事態が襲う！　彼らの後ろに……見えたっ！　海を飛び越えるリン選手だーーっ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "しかーし！　そんな彼らを予想もしない事態が襲う！　彼らの後ろに……見えたっ！　海を飛び越えるリン選手だーーっ！"
    },
    {
        "id": 133,
        "raw": "[name=\"D.D.D.\"]彼女の足が、三位の選手の頭上を軽やかに越えていくーっ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "彼女の足が、三位の選手の頭上を軽やかに越えていくーっ！"
    },
    {
        "id": 134,
        "raw": "[name=\"D.D.D.\"]二位の選手の頭はもはや、彼女の踏み台にすぎないぞ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "二位の選手の頭はもはや、彼女の踏み台にすぎないぞ！"
    },
    {
        "id": 135,
        "raw": "[name=\"D.D.D.\"]ジャーヴァン選手、彼女に気付いた！　だけど残念！　気付いたところでこれはどうしようもないーっ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "ジャーヴァン選手、彼女に気付いた！　だけど残念！　気付いたところでこれはどうしようもないーっ！"
    },
    {
        "id": 136,
        "raw": "[name=\"D.D.D.\"]無情！　非情！　彼の頭上をリン選手があまりにも軽やかに飛びすぎていくーっ！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "無情！　非情！　彼の頭上をリン選手があまりにも軽やかに飛びすぎていくーっ！"
    },
    {
        "id": 137,
        "raw": "[name=\"D.D.D.\"]第二ラウンド、一位獲得はリン選手！　試合の栄えある第一位は、またしても『龍威鼠心』に決定だー！！！！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "第二ラウンド、一位獲得はリン選手！　試合の栄えある第一位は、またしても『龍威鼠心』に決定だー！！！！"
    },
    {
        "id": 138,
        "raw": "[name=\"D.D.D.\"]まさに全身の血潮が沸き立つ大逆転！　感動をありがとうーっ！！",
        "type": "dialog",
        "speaker": "D.D.D.",
        "content": "まさに全身の血潮が沸き立つ大逆転！　感動をありがとうーっ！！"
    },
