    {
        "id": 13,
        "raw": "[name=\"ラヴァ\"]これは……なんだ？　感染生物か？",
        "type": "dialog",
        "speaker": "ラヴァ",
        "content": "これは……なんだ？　感染生物か？"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"avg_npc_144#5\",name2=\"char_1011_purgatory_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_144#5",
        "name2": "char_1011_purgatory_1#4",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"クルース\"]感染の痕跡はないみたいだよぉ、それに生物かだって怪しいねぇ。射抜いたら黒い水たまりになって消えちゃったしぃ。",
        "type": "dialog",
        "speaker": "クルース",
        "content": "感染の痕跡はないみたいだよぉ、それに生物かだって怪しいねぇ。射抜いたら黒い水たまりになって消えちゃったしぃ。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_144#5\",name2=\"char_1011_purgatory_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_144#5",
        "name2": "char_1011_purgatory_1#4",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"ラヴァ\"]……アーツの類いか？",
        "type": "dialog",
        "speaker": "ラヴァ",
        "content": "……アーツの類いか？"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"avg_npc_144#5\",name2=\"char_1011_purgatory_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_144#5",
        "name2": "char_1011_purgatory_1#4",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"クルース\"]そうかもねぇ。",
        "type": "dialog",
        "speaker": "クルース",
        "content": "そうかもねぇ。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"avg_npc_144#5\",name2=\"char_1011_purgatory_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_144#5",
        "name2": "char_1011_purgatory_1#4",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"ラヴァ\"]このままじゃまずい、数が多すぎる……化け物の発生源を探して手を打たないと。",
        "type": "dialog",
        "speaker": "ラヴァ",
        "content": "このままじゃまずい、数が多すぎる……化け物の発生源を探して手を打たないと。"
    },
    {
        "id": 22,
        "raw": "[name=\"ラヴァ\"]こいつらはどの方角から町に入ってきてる？",
        "type": "dialog",
        "speaker": "ラヴァ",
        "content": "こいつらはどの方角から町に入ってきてる？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_144#4\",name2=\"char_1011_purgatory_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_144#4",
        "name2": "char_1011_purgatory_1#4",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"クルース\"]暗くなってきたよ、ラヴァちゃん。",
        "type": "dialog",
        "speaker": "クルース",
        "content": "暗くなってきたよ、ラヴァちゃん。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_144#4\",name2=\"char_1011_purgatory_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_144#4",
        "name2": "char_1011_purgatory_1#4",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"ラヴァ\"]……分かってる。",
        "type": "dialog",
        "speaker": "ラヴァ",
        "content": "……分かってる。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"avg_npc_144#1\",name2=\"char_1011_purgatory_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_144#1",
        "name2": "char_1011_purgatory_1#4",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"クルース\"]まだ追うのぉ？",
        "type": "dialog",
        "speaker": "クルース",
        "content": "まだ追うのぉ？"
    },
    {
        "id": 29,
        "raw": "[name=\"クルース\"]私たちがどうやってここに来たのかだって、まだはっきりしてないのに……今ここで深入りしすぎるのは危ないと思うよぉ。",
        "type": "dialog",
        "speaker": "クルース",
        "content": "私たちがどうやってここに来たのかだって、まだはっきりしてないのに……今ここで深入りしすぎるのは危ないと思うよぉ。"
    },
    {
        "id": 30,
        "raw": "[name=\"クルース\"]手がかりが掴めるかもしれないけど、そんなに急がなくてもぉ。",
        "type": "dialog",
        "speaker": "クルース",
        "content": "手がかりが掴めるかもしれないけど、そんなに急がなくてもぉ。"
    },
