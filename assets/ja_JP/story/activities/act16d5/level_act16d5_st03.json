        "block": true
    },
    {
        "id": 87,
        "raw": "[name=\"レイ\"]ねぇ、シー。",
        "type": "dialog",
        "speaker": "レイ",
        "content": "ねぇ、シー。"
    },
    {
        "id": 88,
        "raw": "[name=\"シー\"]ええ。",
        "type": "dialog",
        "speaker": "シー",
        "content": "ええ。"
    },
    {
        "id": 89,
        "raw": "[name=\"レイ\"]あなたは多くの変わった出来事や人、それに世の中の移り変わりを見てきたでしょう……？",
        "type": "dialog",
        "speaker": "レイ",
        "content": "あなたは多くの変わった出来事や人、それに世の中の移り変わりを見てきたでしょう……？"
    },
    {
        "id": 90,
        "raw": "[name=\"レイ\"]あなたのその目で見てほしいの。私の……ゴホゴホッ！",
        "type": "dialog",
        "speaker": "レイ",
        "content": "あなたのその目で見てほしいの。私の……ゴホゴホッ！"
    },
    {
        "id": 91,
        "raw": "[name=\"レイ\"]――私の一生は……幸せだったかしら？",
        "type": "dialog",
