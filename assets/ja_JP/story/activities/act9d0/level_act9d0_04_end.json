        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"W\"]  こいつがあたしの邪魔をしてきたのよ。",
        "type": "dialog",
        "speaker": "W",
        "content": "こいつがあたしの邪魔をしてきたのよ。"
    },
    {
