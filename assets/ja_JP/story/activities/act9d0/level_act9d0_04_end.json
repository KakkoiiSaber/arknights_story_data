    },
    {
        "id": 87,
        "raw": "[name=\"W\"]  えぇ？　何言ってるの？　きーこーえーなーいー！",
        "type": "dialog",
        "speaker": "W",
        "content": "えぇ？　何言ってるの？　きーこーえーなーいー！"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"イネス\"]  チッ、最初から気が狂ってるんだったわね、Wは。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "チッ、最初から気が狂ってるんだったわね、Wは。"
    },
    {
        "id": 90,
        "raw": "[name=\"イネス\"]  天災であなたが死ぬのは自由だけど、部下まで死なせないで！",
        "type": "dialog",
        "speaker": "イネス",
        "content": "天災であなたが死ぬのは自由だけど、部下まで死なせないで！"
    },
    {
        "id": 91,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"W\"]  大丈夫、もうヘドリーと一緒に撤退させてるわ！　あたしだって馬鹿じゃないんだから――あっ。",
        "type": "dialog",
        "speaker": "W",
        "content": "大丈夫、もうヘドリーと一緒に撤退させてるわ！　あたしだって馬鹿じゃないんだから――あっ。"
    },
    {
        "id": 93,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 94,
        "raw": "[name=\"イネス\"]  チッ！　W！　気をつけなさい！",
        "type": "dialog",
        "speaker": "イネス",
        "content": "チッ！　W！　気をつけなさい！"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 96,
        "raw": "[name=\"W\"]  あんたこそ近づかないでよ。ここから落ちたらあんたじゃひとたまりも――",
        "type": "dialog",
        "speaker": "W",
        "content": "あんたこそ近づかないでよ。ここから落ちたらあんたじゃひとたまりも――"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"イネス\"]  じゃああなたは大丈夫とでも言うわけ？　死にたくないならさっさと戻ってきなさい――！",
        "type": "dialog",
        "speaker": "イネス",
        "content": "じゃああなたは大丈夫とでも言うわけ？　死にたくないならさっさと戻ってきなさい――！"
    },
