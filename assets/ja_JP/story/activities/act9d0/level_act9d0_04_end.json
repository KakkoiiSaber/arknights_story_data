    {
        "id": 106,
        "raw": "[name=\"ヘドリー\"]  ……お前たち、一体何をしていたんだ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……お前たち、一体何をしていたんだ。"
    },
