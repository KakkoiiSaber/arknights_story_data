        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"イネス\"]  彼女に聞いて。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "彼女に聞いて。"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"avg_npc_046#2\", name2=\"avg_npc_047\",focus=1)]",
