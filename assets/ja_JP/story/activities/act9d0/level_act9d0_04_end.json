    },
    {
        "id": 78,
        "raw": "[name=\"W\"]  ――わぁー！",
        "type": "dialog",
        "speaker": "W",
        "content": "――わぁー！"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"イネス\"]  W！　何してるの――！",
        "type": "dialog",
        "speaker": "イネス",
        "content": "W！　何してるの――！"
    },
    {
        "id": 81,
        "raw": "[name=\"イネス\"]  こんな、風の強いところで！",
        "type": "dialog",
        "speaker": "イネス",
        "content": "こんな、風の強いところで！"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"W\"]  決まってるでしょ、天災を楽しんでるのよ！",
        "type": "dialog",
        "speaker": "W",
        "content": "決まってるでしょ、天災を楽しんでるのよ！"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"イネス\"]  あなた、気でも狂ったの――",
        "type": "dialog",
        "speaker": "イネス",
        "content": "あなた、気でも狂ったの――"
    },
    {
        "id": 86,
