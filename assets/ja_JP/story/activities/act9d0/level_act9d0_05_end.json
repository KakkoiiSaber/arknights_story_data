    {
        "id": 89,
        "raw": "[name=\"イネス\"]  ……",
        "type": "dialog",
        "speaker": "イネス",
        "content": "……"
    },
    {
        "id": 90,
        "raw": "[name=\"イネス\"]  （この通りを抜ければ、Wがいるはず……）",
        "type": "dialog",
        "speaker": "イネス",
        "content": "（この通りを抜ければ、Wがいるはず……）"
    },
    {
        "id": 91,
        "raw": "[name=\"イネス\"]  （あれは……拠点だったはず……一体何が……）",
        "type": "dialog",
        "speaker": "イネス",
        "content": "（あれは……拠点だったはず……一体何が……）"
    },
    {
        "id": 92,
        "raw": "[name=\"イネス\"]  （ううん、今はとにかく急がないと――）",
        "type": "dialog",
        "speaker": "イネス",
        "content": "（ううん、今はとにかく急がないと――）"
    },
    {
        "id": 93,
        "raw": "[name=\"イネス\"]  ――",
        "type": "dialog",
        "speaker": "イネス",
        "content": "――"
    },
    {
        "id": 94,
        "raw": "[name=\"イネス\"]  ――誰？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "――誰？"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 96,
        "raw": "[name=\"レユニオン兵士\"]  ……",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "……"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 98,
        "raw": "[name=\"イネス\"]  感染者……？　何か用？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "感染者……？　何か用？"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 100,
        "raw": "[name=\"レユニオン兵士\"]  言葉には気をつけろ、魔族。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "言葉には気をつけろ、魔族。"
    },
    {
        "id": 101,
        "raw": "[name=\"レユニオン兵士\"]  いくつかの傭兵部隊が逃げ出してから、敵が市内にまで出現するようになった。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "いくつかの傭兵部隊が逃げ出してから、敵が市内にまで出現するようになった。"
    },
    {
        "id": 102,
        "raw": "[name=\"レユニオン兵士\"]  お前たちはあまりにも多くのミスを犯した。リーダーがそれに気づいていないと思うか？",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "お前たちはあまりにも多くのミスを犯した。リーダーがそれに気づいていないと思うか？"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 104,
        "raw": "[name=\"イネス\"]  そんなこと、上司でもないあなたに言われる筋合いはないわ。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "そんなこと、上司でもないあなたに言われる筋合いはないわ。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 106,
        "raw": "[name=\"レユニオン兵士\"]  お前にはタルラに向けて、責任を償う義務がある。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "お前にはタルラに向けて、責任を償う義務がある。"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 108,
        "raw": "[name=\"イネス\"]  ――タルラに……。わかったわ。じゃあWに報告してから、タルラにも報告する。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "――タルラに……。わかったわ。じゃあWに報告してから、タルラにも報告する。"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 110,
        "raw": "[name=\"レユニオン兵士\"]  必要ない。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "必要ない。"
    },
    {
        "id": 111,
        "raw": "[name=\"レユニオン兵士\"]  そんな「償い」は求めていない。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "そんな「償い」は求めていない。"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 113,
        "raw": "[name=\"イネス\"]  それじゃ何を……",
        "type": "dialog",
        "speaker": "イネス",
        "content": "それじゃ何を……"
    },
