    },
    {
        "id": 136,
        "raw": "[name=\"レユニオン兵士\"]  先程の襲撃がこちらにまで波及し、サルカズ傭兵小隊長の一人、イネスが死亡した。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "先程の襲撃がこちらにまで波及し、サルカズ傭兵小隊長の一人、イネスが死亡した。"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"毅然としたレユニオン術師\"]  死体の確認は？",
        "type": "dialog",
        "speaker": "毅然としたレユニオン術師",
        "content": "死体の確認は？"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"レユニオン兵士\"]  ……戦闘は大きな騒ぎだった。今すぐこの通りを破壊しろ。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "……戦闘は大きな騒ぎだった。今すぐこの通りを破壊しろ。"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"毅然としたレユニオン術師\"]  ……わかった。",
        "type": "dialog",
        "speaker": "毅然としたレユニオン術師",
        "content": "……わかった。"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 144,
        "raw": "[name=\"レユニオン兵士\"]  ――ああ、待て。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "――ああ、待て。"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 1
    },
    {
        "id": 146,
        "raw": "[name=\"レユニオン兵士\"]  レユニオン側にも、最後まで彼女と戦った者がいたはずだ。たしか……術師だった。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "レユニオン側にも、最後まで彼女と戦った者がいたはずだ。たしか……術師だった。"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 2
    },
    {
        "id": 148,
        "raw": "[name=\"毅然としたレユニオン術師\"]  ……わかった。",
        "type": "dialog",
        "speaker": "毅然としたレユニオン術師",
        "content": "……わかった。"
    },
    {
        "id": 149,
        "raw": "[name=\"毅然としたレユニオン術師\"]  家族の面倒をお願い、みんなまだ街にいるから。",
        "type": "dialog",
        "speaker": "毅然としたレユニオン術師",
        "content": "家族の面倒をお願い、みんなまだ街にいるから。"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"レユニオン兵士\"]  ああ、誓おう。",
        "type": "dialog",
        "speaker": "レユニオン兵士",
        "content": "ああ、誓おう。"
    },
