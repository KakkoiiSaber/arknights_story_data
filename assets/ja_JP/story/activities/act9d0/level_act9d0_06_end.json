    {
        "id": 228,
        "raw": "[name=\"W\"]  ......",
        "type": "dialog",
        "speaker": "W",
        "content": "......"
    },
    {
        "id": 229,
        "raw": "[name=\"W\"]  はぁ……面倒くさ……",
        "type": "dialog",
        "speaker": "W",
        "content": "はぁ……面倒くさ……"
    },
    {
        "id": 230,
        "raw": "[name=\"W\"]  やっとあの龍女に会いに行くって決めたのに……ホンット、タイミング悪いわね。",
        "type": "dialog",
        "speaker": "W",
        "content": "やっとあの龍女に会いに行くって決めたのに……ホンット、タイミング悪いわね。"
    },
    {
        "id": 231,
        "raw": "[name=\"W\"]  出てきなさい。",
        "type": "dialog",
        "speaker": "W",
        "content": "出てきなさい。"
    },
    {
        "id": 232,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 233,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 234,
        "raw": "チェルノボーグの廃墟は、カズデルのものとは少し違っていた。",
        "type": "narration",
        "content": "チェルノボーグの廃墟は、カズデルのものとは少し違っていた。"
    },
    {
        "id": 235,
        "raw": "荒れ果てているとは言え、徹底的に破壊されつくしているわけでもなかった。",
        "type": "narration",
        "content": "荒れ果てているとは言え、徹底的に破壊されつくしているわけでもなかった。"
    },
    {
        "id": 236,
        "raw": "通りの端に落ちた泥まみれの洗濯物に、割れた窓の向こうの壊れた家具に、過去の営みが見て取れる。",
        "type": "narration",
        "content": "通りの端に落ちた泥まみれの洗濯物に、割れた窓の向こうの壊れた家具に、過去の営みが見て取れる。"
    },
    {
        "id": 237,
        "raw": "そしてなにより異なるのは――",
        "type": "narration",
        "content": "そしてなにより異なるのは――"
    },
    {
        "id": 238,
        "raw": "この二人の子供だ。必死に武器を構えている子供。",
        "type": "narration",
        "content": "この二人の子供だ。必死に武器を構えている子供。"
    },
    {
        "id": 239,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 240,
        "raw": "[name=\"たくましい子供\"] ――魔族め、何するつもりだ！",
        "type": "dialog",
        "speaker": "たくましい子供",
        "content": "――魔族め、何するつもりだ！"
    },
    {
        "id": 241,
        "raw": "[name=\"弱々しい子供\"] ちょ、挑発しちゃダメだよ……",
        "type": "dialog",
        "speaker": "弱々しい子供",
        "content": "ちょ、挑発しちゃダメだよ……"
    },
    {
        "id": 242,
        "raw": "[name=\"弱々しい子供\"] あっ、あの……ご、ごめんなさい。すぐどこかに行くから……",
        "type": "dialog",
        "speaker": "弱々しい子供",
        "content": "あっ、あの……ご、ごめんなさい。すぐどこかに行くから……"
    },
    {
        "id": 243,
        "raw": "[Character(name=\"avg_npc_046#2\")]",
        "type": "character",
        "name": "avg_npc_046#2.png"
    },
    {
        "id": 244,
        "raw": "[name=\"W\"]  ふーん――",
        "type": "dialog",
        "speaker": "W",
        "content": "ふーん――"
    },
    {
        "id": 245,
        "raw": "[name=\"W\"]  あんたが持ってるのは、制式の軍刀？",
        "type": "dialog",
        "speaker": "W",
        "content": "あんたが持ってるのは、制式の軍刀？"
    },
    {
        "id": 246,
        "raw": "[name=\"W\"]  ……そうみたいね、サルカズの刀だわ。構えられもしないのに、そんなお荷物引きずってどうするの？",
        "type": "dialog",
        "speaker": "W",
        "content": "……そうみたいね、サルカズの刀だわ。構えられもしないのに、そんなお荷物引きずってどうするの？"
    },
    {
        "id": 247,
        "raw": "[name=\"W\"]  あたしに歯向かうつもり？　あたしを殺したい？",
        "type": "dialog",
        "speaker": "W",
        "content": "あたしに歯向かうつもり？　あたしを殺したい？"
    },
    {
        "id": 248,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 249,
        "raw": "[name=\"弱々しい子供\"] えっ――",
        "type": "dialog",
        "speaker": "弱々しい子供",
        "content": "えっ――"
    },
    {
        "id": 250,
        "raw": "[name=\"たくましい子供\"] く、来るな！　――ううっ！",
        "type": "dialog",
        "speaker": "たくましい子供",
        "content": "く、来るな！　――ううっ！"
    },
    {
        "id": 251,
        "raw": "[name=\"弱々しい子供\"] ルブレフ君……足が！",
        "type": "dialog",
        "speaker": "弱々しい子供",
        "content": "ルブレフ君……足が！"
    },
    {
        "id": 252,
        "raw": "[Character(name=\"avg_npc_046#2\")]",
        "type": "character",
        "name": "avg_npc_046#2.png"
    },
    {
        "id": 253,
        "raw": "[name=\"W\"]  あら、怪我してるのね。",
        "type": "dialog",
        "speaker": "W",
        "content": "あら、怪我してるのね。"
    },
    {
        "id": 254,
        "raw": "[name=\"W\"]  天災が直撃した後は危険よ。このままじゃあんたも感染するわ。",
