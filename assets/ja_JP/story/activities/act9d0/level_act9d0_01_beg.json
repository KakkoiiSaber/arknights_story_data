    {
        "id": 9,
        "raw": "俺だ。",
        "type": "narration",
        "content": "俺だ。"
    },
    {
        "id": 10,
        "raw": "目標地点にて、信号煙を確認した。",
        "type": "narration",
        "content": "目標地点にて、信号煙を確認した。"
    },
    {
        "id": 11,
        "raw": "……久しぶりに同業者を相手にして、こちらもそれなりに被害を受けた。",
        "type": "narration",
        "content": "……久しぶりに同業者を相手にして、こちらもそれなりに被害を受けた。"
    },
    {
        "id": 12,
        "raw": "だが彼らが地下の発信局に蓄えていた物資を奪えば、多少は取り戻せるだろう。",
        "type": "narration",
        "content": "だが彼らが地下の発信局に蓄えていた物資を奪えば、多少は取り戻せるだろう。"
    },
    {
        "id": 13,
        "raw": "偵察チームを先に行かせてくれ。",
        "type": "narration",
        "content": "偵察チームを先に行かせてくれ。"
    },
    {
        "id": 14,
        "raw": "俺も急いで戻る。",
        "type": "narration",
        "content": "俺も急いで戻る。"
    },
    {
        "id": 15,
        "raw": "……そうだ、想定外のことが一つ。",
        "type": "narration",
        "content": "……そうだ、想定外のことが一つ。"
    },
    {
        "id": 16,
        "raw": "Wが死んだ。",
        "type": "narration",
        "content": "Wが死んだ。"
    },
