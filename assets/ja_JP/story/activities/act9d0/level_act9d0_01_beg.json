    {
        "id": 24,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",fadetime=1.5,block=true)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "fadetime": "1.5,block=true"
    },
    {
        "id": 25,
        "raw": "[delay(time=1.5)]",
        "type": "delay",
        "time": 1.5
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"イネス\"]  ……",
        "type": "dialog",
        "speaker": "イネス",
        "content": "……"
    },
    {
        "id": 28,
        "raw": "[name=\"イネス\"]  さっきの報告じゃ、五体満足で帰ってくるなんてとても思えなかったけど。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "さっきの報告じゃ、五体満足で帰ってくるなんてとても思えなかったけど。"
    },
    {
        "id": 29,
        "raw": "[name=\"イネス\"]  ……苦戦したと装って、手柄をアピールしたかったの？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "……苦戦したと装って、手柄をアピールしたかったの？"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"ヘドリー\"]  わざわざ拠点を離れて迎えに来たのは、心配してくれたからじゃないのか。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "わざわざ拠点を離れて迎えに来たのは、心配してくれたからじゃないのか。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"イネス\"]  私は誰の心配もしないわ。自惚れないで。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "私は誰の心配もしないわ。自惚れないで。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"ヘドリー\"]  ……無事に帰ってこれたのは、Wがいたからだ。奴が殿を務めてくれたおかげで、我々は全滅を免れた。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……無事に帰ってこれたのは、Wがいたからだ。奴が殿を務めてくれたおかげで、我々は全滅を免れた。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"イネス\"]  ……",
        "type": "dialog",
        "speaker": "イネス",
        "content": "……"
    },
    {
        "id": 38,
        "raw": "[name=\"イネス\"]  ……それはいつのこと？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "……それはいつのこと？"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"ヘドリー\"]  二時間前、通信が切断されたときだ。我々のチームは伏兵に奇襲を受けた。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "二時間前、通信が切断されたときだ。我々のチームは伏兵に奇襲を受けた。"
    },
    {
        "id": 41,
        "raw": "[name=\"ヘドリー\"]  すぐにWが我々のいた廃墟もろとも爆破し、その混乱に乗じて我々は逃げられたが、奴は……",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "すぐにWが我々のいた廃墟もろとも爆破し、その混乱に乗じて我々は逃げられたが、奴は……"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"イネス\"]  それは……惜しいことをしたわね。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "それは……惜しいことをしたわね。"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"ヘドリー\"]  ……そうだな。もしWが生きて帰れば、その価値は俺を超え、最も値の張る傭兵と呼ばれることになっただろうに……",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……そうだな。もしWが生きて帰れば、その価値は俺を超え、最も値の張る傭兵と呼ばれることになっただろうに……"
    },
    {
        "id": 46,
        "raw": "[name=\"ヘドリー\"]  いや、やめよう。Wは戦争から解放されたんだ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "いや、やめよう。Wは戦争から解放されたんだ。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"イネス\"]  敵はもう撤退した頃でしょ。回収に向かう？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "敵はもう撤退した頃でしょ。回収に向かう？"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"ヘドリー\"]  いや。そこまでリスクは冒せない。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "いや。そこまでリスクは冒せない。"
    },
    {
        "id": 51,
        "raw": "[name=\"ヘドリー\"]  それにしても、まさかお前が回収を提案するとはな。Wと親しかったのか？　とてもそうは見えなかったが。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "それにしても、まさかお前が回収を提案するとはな。Wと親しかったのか？　とてもそうは見えなかったが。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"イネス\"]  私はあの人が持っていた戦利品が惜しいだけよ。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "私はあの人が持っていた戦利品が惜しいだけよ。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"ヘドリー\"]  ……特別な物は何もないさ。W以上のコレクションを持つ者も多いだろう。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……特別な物は何もないさ。W以上のコレクションを持つ者も多いだろう。"
    },
    {
        "id": 56,
        "raw": "[name=\"ヘドリー\"]  この戦争が終われば、昔の仕事に戻る機会はいくらでもある。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "この戦争が終われば、昔の仕事に戻る機会はいくらでもある。"
    },
    {
        "id": 57,
        "raw": "[name=\"ヘドリー\"]  ……もし本当に、終わるのならな。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……もし本当に、終わるのならな。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"イネス\"]  フンッ……",
        "type": "dialog",
        "speaker": "イネス",
        "content": "フンッ……"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"ヘドリー\"]  このままここにいれば、敵の的になるだけだ。日没前にここを脱出する。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "このままここにいれば、敵の的になるだけだ。日没前にここを脱出する。"
    },
    {
        "id": 62,
        "raw": "[name=\"ヘドリー\"]  拠点に戻り、すぐに部隊を整えるぞ。準備ができ次第出発だ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "拠点に戻り、すぐに部隊を整えるぞ。準備ができ次第出発だ。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"イネス\"]  へぇ――？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "へぇ――？"
    },
    {
        "id": 65,
        "raw": "[name=\"イネス\"]  いつから私に命令するほど偉くなったの？　ヘドリー「副」隊長？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "いつから私に命令するほど偉くなったの？　ヘドリー「副」隊長？"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"ヘドリー\"]  ……他のチームとの連絡が途絶えた今、総指揮権は俺にある。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……他のチームとの連絡が途絶えた今、総指揮権は俺にある。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"イネス\"]  でも、私たちは平等な立場でしょう？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "でも、私たちは平等な立場でしょう？"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"ヘドリー\"]  はぁ……",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "はぁ……"
    },
    {
        "id": 72,
        "raw": "[name=\"ヘドリー\"]  ……イネス、急ぎここを離れ拠点に戻ろう。それから雇い主と連絡をとって報酬の再交渉だ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "……イネス、急ぎここを離れ拠点に戻ろう。それから雇い主と連絡をとって報酬の再交渉だ。"
    },
    {
        "id": 73,
        "raw": "[name=\"ヘドリー\"]  もちろんこれは、提案であって命令ではない。どうだ？",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "もちろんこれは、提案であって命令ではない。どうだ？"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"イネス\"]  フンッ……まあいいわ。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "フンッ……まあいいわ。"
    },
    {
        "id": 76,
        "raw": "[name=\"イネス\"]  Wが死んだことで、どれだけチップを上乗せしてもらえるかしら？",
        "type": "dialog",
        "speaker": "イネス",
        "content": "Wが死んだことで、どれだけチップを上乗せしてもらえるかしら？"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"ヘドリー\"]  山程だ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "山程だ。"
    },
    {
        "id": 79,
        "raw": "[name=\"ヘドリー\"]  奴は優秀な傭兵だった。その優秀さは十分に値のつくものだ。",
        "type": "dialog",
        "speaker": "ヘドリー",
        "content": "奴は優秀な傭兵だった。その優秀さは十分に値のつくものだ。"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 81,
        "raw": "[name=\"イネス\"]  じゃあ少なくとも……無駄死ににはならないってことね。",
        "type": "dialog",
        "speaker": "イネス",
        "content": "じゃあ少なくとも……無駄死ににはならないってことね。"
    },
    {
        "id": 82,
        "raw": "[name=\"イネス\"]  Wは死に際に何か残して――",
        "type": "dialog",
        "speaker": "イネス",
        "content": "Wは死に際に何か残して――"
    },
    {
        "id": 83,
        "raw": "[dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 84,
        "raw": "[stopmusic(fadetime=1)]",
        "type": "stop_music",
        "fadetime": 1
    },
    {
        "id": 85,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 86,
        "raw": "[name=\"イネス\"]  ――静かに。",
        "type": "dialog",
