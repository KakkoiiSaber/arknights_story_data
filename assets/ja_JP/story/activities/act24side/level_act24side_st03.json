        "name": "avg_npc_753_1#3$1"
    },
    {
        "id": 87,
        "raw": "[name=\"滝居應\"]では、聞こうか。",
        "type": "dialog",
        "speaker": "滝居應",
        "content": "では、聞こうか。"
    },
    {
