    {
        "id": 10,
        "raw": "物語の最後――結局、狩人は怪物を倒せはしなかった。",
        "type": "narration",
        "content": "物語の最後――結局、狩人は怪物を倒せはしなかった。"
    },
    {
        "id": 11,
        "raw": "けれど村人たちは無事に避難し、炎の中には燃える廃墟だけが残された。",
        "type": "narration",
        "content": "けれど村人たちは無事に避難し、炎の中には燃える廃墟だけが残された。"
    },
    {
        "id": 12,
        "raw": "標的を失い、深手を負った怪物が森へ帰っていくその姿は――",
        "type": "narration",
        "content": "標的を失い、深手を負った怪物が森へ帰っていくその姿は――"
    },
    {
        "id": 13,
        "raw": "狩人にこう言い残すかのようだった。",
        "type": "narration",
        "content": "狩人にこう言い残すかのようだった。"
    },
    {
        "id": 14,
        "raw": "「いずれ私は戻ってくる。」",
        "type": "narration",
        "content": "「いずれ私は戻ってくる。」"
    },
    {
        "id": 15,
        "raw": "狩人は森と向かい合ったまま、無言で立っていた。長い沈黙の後、彼は返事を口にした。",
        "type": "narration",
        "content": "狩人は森と向かい合ったまま、無言で立っていた。長い沈黙の後、彼は返事を口にした。"
