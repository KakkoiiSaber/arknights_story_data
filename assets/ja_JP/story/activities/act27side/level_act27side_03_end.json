    },
    {
        "id": 148,
        "raw": "[name=\"アデル\"]ちびめーちゃん……あなたはドリーさんですか？",
        "type": "dialog",
        "speaker": "アデル",
        "content": "ちびめーちゃん……あなたはドリーさんですか？"
    },
    {
        "id": 149,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 150,
        "raw": "[name=\"穏やかな生物\"]私はドリーであり、ドリーではないわ。",
        "type": "dialog",
        "speaker": "穏やかな生物",
        "content": "私はドリーであり、ドリーではないわ。"
    },
    {
        "id": 151,
        "raw": "[name=\"穏やかな生物\"]私が誰かであるかは、あなたの心の中にある私の姿によるのよ。",
        "type": "dialog",
        "speaker": "穏やかな生物",
        "content": "私が誰かであるかは、あなたの心の中にある私の姿によるのよ。"
    },
    {
        "id": 152,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#9$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#9$2.png"
    },
    {
        "id": 153,
        "raw": "[name=\"アデル\"]あなたはドリーさんと、どこか違います。",
        "type": "dialog",
        "speaker": "アデル",
        "content": "あなたはドリーさんと、どこか違います。"
    },
    {
        "id": 154,
        "raw": "[name=\"アデル\"]ではこの子たち……みんなちびめーちゃんなんですか？",
        "type": "dialog",
        "speaker": "アデル",
        "content": "ではこの子たち……みんなちびめーちゃんなんですか？"
    },
    {
        "id": 155,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 156,
        "raw": "[name=\"穏やかな生物\"]いいえ、「みんな」とは言えないわ。それぞれが唯一無二で、この世界との絆も同じく一つきりしかないの。",
        "type": "dialog",
        "speaker": "穏やかな生物",
        "content": "いいえ、「みんな」とは言えないわ。それぞれが唯一無二で、この世界との絆も同じく一つきりしかないの。"
    },
    {
        "id": 157,
        "raw": "[name=\"穏やかな生物\"]私たちがあなたたちを呼ぶ時、全員を「アデル」とは呼ばないのと同じようにね。",
        "type": "dialog",
        "speaker": "穏やかな生物",
        "content": "私たちがあなたたちを呼ぶ時、全員を「アデル」とは呼ばないのと同じようにね。"
    },
    {
        "id": 158,
        "raw": "[name=\"穏やかな生物\"]一人一人の「アデル」が、唯一無二なのよ。",
        "type": "dialog",
        "speaker": "穏やかな生物",
        "content": "一人一人の「アデル」が、唯一無二なのよ。"
    },
    {
        "id": 159,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#2$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#2$2.png"
    },
    {
        "id": 160,
        "raw": "[name=\"アデル\"]分かりました。",
        "type": "dialog",
        "speaker": "アデル",
        "content": "分かりました。"
    },
    {
        "id": 161,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#11$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#11$2.png"
    },
    {
        "id": 162,
        "raw": "[name=\"アデル\"]ならあなたたちは、どうして私をここに招待したんですか？",
        "type": "dialog",
        "speaker": "アデル",
        "content": "ならあなたたちは、どうして私をここに招待したんですか？"
    },
