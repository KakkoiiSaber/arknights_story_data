        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"スカイフレア\"]   しっぽ！！",
        "type": "dialog",
        "speaker": "スカイフレア",
        "content": "しっぽ！！"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_166_skfire_3#1\",name2=\"char_145_prove_1\",focus=2)]",
