        "name2": "char_145_prove_1",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"プロヴァンス\"]  溶岩の隙間に見える弱点っぽいところを狙えそうだけど、あの大きさだから効果があるかは……でもやるしかない！！",
        "type": "dialog",
