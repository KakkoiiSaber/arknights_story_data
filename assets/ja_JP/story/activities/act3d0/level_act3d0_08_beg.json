    },
    {
        "id": 63,
        "raw": "[name=\"セイロン\"]   ますます暑くなってきましたわ……。",
        "type": "dialog",
        "speaker": "セイロン",
        "content": "ますます暑くなってきましたわ……。"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_145_prove_1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#7",
        "name2": "char_145_prove_1",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"プロヴァンス\"]   もうすぐ着くはずだよ……。",
        "type": "dialog",
        "speaker": "プロヴァンス",
        "content": "もうすぐ着くはずだよ……。"
    },
    {
        "id": 66,
        "raw": "[name=\"プロヴァンス\"]   みんな気をつけて！",
        "type": "dialog",
        "speaker": "プロヴァンス",
        "content": "みんな気をつけて！"
    },
    {
        "id": 67,
