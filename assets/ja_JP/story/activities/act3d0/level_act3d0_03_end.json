    },
    {
        "id": 39,
        "raw": "[name=\"イフリータ\"]   あ！肉を焼いてる途中だった！　悪ぃがオレサマはもう行くぜ！",
        "type": "dialog",
        "speaker": "イフリータ",
        "content": "あ！肉を焼いてる途中だった！　悪ぃがオレサマはもう行くぜ！"
    },
