        "type": "predicate",
        "references": "1"
    },
    {
        "id": 21,
        "raw": "[name=\"イフリータ\"]   ヘヘ、やっぱドクターはいいヤツだな！",
        "type": "dialog",
        "speaker": "イフリータ",
        "content": "ヘヘ、やっぱドクターはいいヤツだな！"
