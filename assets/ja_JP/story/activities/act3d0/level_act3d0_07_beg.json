        "name": "avg_npc_020"
    },
    {
        "id": 20,
        "raw": "[name=\"スタッフ\"]   ゲストは揃った。あと2分半でスタートだ。",
        "type": "dialog",
        "speaker": "スタッフ",
        "content": "ゲストは揃った。あと2分半でスタートだ。"
    },
    {
        "id": 21,
        "raw": "[name=\"スタッフ\"]   急げ！　さっさと外の騒ぎを鎮めろ！",
        "type": "dialog",
        "speaker": "スタッフ",
        "content": "急げ！　さっさと外の騒ぎを鎮めろ！"
    },
