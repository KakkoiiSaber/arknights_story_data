    },
    {
        "id": 10,
        "raw": "[name=\"スタッフ\"]   何があった？　おい？",
        "type": "dialog",
        "speaker": "スタッフ",
        "content": "何があった？　おい？"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"avg_npc_020\",name2=\"npc_2004_Alty\",focus=2)]",
        "type": "character",
        "name": "avg_npc_020",
        "name2": "npc_2004_Alty",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"Alty\"]    ちょっと、どうしたのよ？　外でなにかあったの？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "ちょっと、どうしたのよ？　外でなにかあったの？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"avg_npc_020\",name2=\"npc_2004_Alty\",focus=1)]",
        "type": "character",
        "name": "avg_npc_020",
        "name2": "npc_2004_Alty",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"スタッフ\"]   ご心配には及びません。何でもありません。こちらへどうぞ。",
        "type": "dialog",
        "speaker": "スタッフ",
        "content": "ご心配には及びません。何でもありません。こちらへどうぞ。"
    },
