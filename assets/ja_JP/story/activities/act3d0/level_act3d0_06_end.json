    },
    {
        "id": 46,
        "raw": "[name=\"クローニン\"]   この穀潰し共め、こんな小娘一人止められないのか！？",
        "type": "dialog",
        "speaker": "クローニン",
        "content": "この穀潰し共め、こんな小娘一人止められないのか！？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_023_2#2\",name2=\"avg_npc_020\",focus=2)]",
        "type": "character",
        "name": "avg_npc_023_2#2",
        "name2": "avg_npc_020",
        "focus": 2
    },
    {
        "id": 48,
        "raw": "[name=\"クローニンの護衛\"]   ですがあれはサルカズです！　それに相手は他に何人もいます！",
        "type": "dialog",
        "speaker": "クローニンの護衛",
        "content": "ですがあれはサルカズです！　それに相手は他に何人もいます！"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_023_2#2\")]",
        "type": "character",
        "name": "avg_npc_023_2#2"
    },
    {
        "id": 50,
        "raw": "[name=\"クローニン\"]     「何人もいる」じゃない、「何人かしかいない」だ！",
        "type": "dialog",
        "speaker": "クローニン",
        "content": "「何人もいる」じゃない、「何人かしかいない」だ！"
    },
    {
        "id": 51,
        "raw": "[name=\"クローニン\"]   鬱陶しいロドスの連中め、何だってここに！",
        "type": "dialog",
        "speaker": "クローニン",
        "content": "鬱陶しいロドスの連中め、何だってここに！"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_290_vigna\")]",
        "type": "character",
        "name": "char_290_vigna"
    },
    {
        "id": 53,
        "raw": "[name=\"ヴィグナ\"]     なーんだ、こいつらオリジムシよりも弱っちいみたいだね……。",
        "type": "dialog",
        "speaker": "ヴィグナ",
        "content": "なーんだ、こいつらオリジムシよりも弱っちいみたいだね……。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"avg_npc_023_2#2\")]",
        "type": "character",
        "name": "avg_npc_023_2#2"
    },
    {
        "id": 55,
        "raw": "[name=\"クローニン\"]   早く増援を集めろ！",
        "type": "dialog",
        "speaker": "クローニン",
        "content": "早く増援を集めろ！"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 57,
        "raw": "[name=\"クローニンの護衛\"]   ですが、クローニン様……。",
        "type": "dialog",
        "speaker": "クローニンの護衛",
        "content": "ですが、クローニン様……。"
    },
    {
        "id": 58,
        "raw": "[name=\"クローニンの護衛\"]   無理ですよ。勝てません、集めたところで絶対に勝てません！",
        "type": "dialog",
        "speaker": "クローニンの護衛",
        "content": "無理ですよ。勝てません、集めたところで絶対に勝てません！"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_023_2#2\")]",
        "type": "character",
        "name": "avg_npc_023_2#2"
    },
    {
        "id": 60,
        "raw": "[name=\"クローニン\"]   「ですが」などない！　下がるな！",
        "type": "dialog",
        "speaker": "クローニン",
        "content": "「ですが」などない！　下がるな！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_290_vigna\")]",
        "type": "character",
        "name": "char_290_vigna"
    },
    {
        "id": 62,
        "raw": "[name=\"ヴィグナ\"]     ふぁーあ……ドクター、まだ見つからないの？　ライブに間に合わなかったら一生後悔しちゃうじゃない！",
        "type": "dialog",
        "speaker": "ヴィグナ",
        "content": "ふぁーあ……ドクター、まだ見つからないの？　ライブに間に合わなかったら一生後悔しちゃうじゃない！"
    },
    {
        "id": 63,
        "raw": "[Decision(options=\"見つけた！;……;ああ、帳簿と債券を見つけたぞ。\",values=\"1;2;3\")]",
        "type": "decision",
        "options": "見つけた！;……;ああ、帳簿と債券を見つけたぞ。",
        "values": "1;2;3"
    },
