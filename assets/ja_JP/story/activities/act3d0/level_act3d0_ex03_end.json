        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"護衛\"]   ですがエンペラーさん、この後ステージもありますし、万が一のことがあれば……。",
        "type": "dialog",
        "speaker": "護衛",
        "content": "ですがエンペラーさん、この後ステージもありますし、万が一のことがあれば……。"
    },
    {
        "id": 73,
