        "id": 58,
        "raw": "[Character(name=\"avg_npc_022\",name2=\"avg_npc_021\",focus=1)]",
        "type": "character",
        "name": "avg_npc_022",
        "name2": "avg_npc_021",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"観光客の女性\"]   ちが……ただ、本物のエンペラーを見て、待って、少し、興奮して息が……。",
