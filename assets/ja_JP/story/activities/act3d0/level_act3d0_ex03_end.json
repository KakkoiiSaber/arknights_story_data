        "name": "char_105_emper"
    },
    {
        "id": 69,
        "raw": "[name=\"エンペラー\"]   おい、そこのサヴラの若者。",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "おい、そこのサヴラの若者。"
    },
    {
        "id": 70,
        "raw": "[name=\"エンペラー\"]   大丈夫さ、近づけていい。",
        "type": "dialog",
        "speaker": "エンペラー",
