        "fadetime": 1
    },
    {
        "id": 89,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 90,
        "raw": "[name=\"怪しげな表情の観光客\"]   ……。",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "……。"
    },
    {
        "id": 91,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 92,
        "raw": "[name=\"エンペラー\"]   よーし、来たな。さあ早く、緊張するな、リラックス、大胆に、自分を信じて。",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "よーし、来たな。さあ早く、緊張するな、リラックス、大胆に、自分を信じて。"
    },
    {
        "id": 93,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 94,
        "raw": "[name=\"怪しげな表情の観光客\"]   何が西クルビアが誇るラップの神だ。お、お前はただのチンピラだろう、運が良かっただけの……。",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "何が西クルビアが誇るラップの神だ。お、お前はただのチンピラだろう、運が良かっただけの……。"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 96,
        "raw": "[name=\"エンペラー\"]   大きな声で、カモン、もっと大きな声で！　おい、サヴラの君、そいつにマイクを渡しな。追い払わなくていい。慌てるな、俺の言う通りにすればいい。",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "大きな声で、カモン、もっと大きな声で！　おい、サヴラの君、そいつにマイクを渡しな。追い払わなくていい。慌てるな、俺の言う通りにすればいい。"
    },
    {
        "id": 97,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 98,
        "raw": "[name=\"怪しげな表情の観光客\"]   俺たちの生活をめちゃくちゃにしといて、お前は大成功してふんぞり返りやがって、し……死ね！！",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "俺たちの生活をめちゃくちゃにしといて、お前は大成功してふんぞり返りやがって、し……死ね！！"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"avg_npc_022\")]",
        "type": "character",
        "name": "avg_npc_022"
    },
    {
        "id": 100,
        "raw": "[name=\"観光客の女性\"]   ぎゃああ――ボウガンだ！　早く逃げて！",
        "type": "dialog",
        "speaker": "観光客の女性",
        "content": "ぎゃああ――ボウガンだ！　早く逃げて！"
    },
    {
        "id": 101,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 102,
        "raw": "[name=\"怪しげな表情の観光客\"]   俺は悪くねぇ、そうだ、全部お前が悪いんだ。お前の作った「ラップ帝国」のせいでどれだけの歌手が犠牲になったと思ってやがる――",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "俺は悪くねぇ、そうだ、全部お前が悪いんだ。お前の作った「ラップ帝国」のせいでどれだけの歌手が犠牲になったと思ってやがる――"
    },
    {
        "id": 103,
        "raw": "[name=\"怪しげな表情の観光客\"]   何がエンペラーだ、クソ食らえだ、卑怯者のペンギン風情が！",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "何がエンペラーだ、クソ食らえだ、卑怯者のペンギン風情が！"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 105,
        "raw": "[name=\"エンペラー\"]   フハハハ、卑怯者か。コイツはいい。卑怯な手段を使っているのは一体誰かな？　メディア買収に世論操作、誹謗中傷、そして最後は射殺か、なぁ、ブラザー？",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "フハハハ、卑怯者か。コイツはいい。卑怯な手段を使っているのは一体誰かな？　メディア買収に世論操作、誹謗中傷、そして最後は射殺か、なぁ、ブラザー？"
    },
    {
        "id": 106,
        "raw": "[name=\"エンペラー\"]   アンダーグラウンドのゴミ溜めに沈めば、お前が誰かわからなくなるとでも思ったか？　あんな若者たちを手にかけて満足かな、「歌手」さん？",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "アンダーグラウンドのゴミ溜めに沈めば、お前が誰かわからなくなるとでも思ったか？　あんな若者たちを手にかけて満足かな、「歌手」さん？"
    },
    {
        "id": 107,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 108,
        "raw": "[name=\"怪しげな表情の観光客\"]   テメェ――！",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "テメェ――！"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 110,
        "raw": "[name=\"エンペラー\"]   もし俺がお前たちを見過ごしてたら、きっと気に入らない新星たちをどんどん「排除」していってたんだろうな。",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "もし俺がお前たちを見過ごしてたら、きっと気に入らない新星たちをどんどん「排除」していってたんだろうな。"
    },
    {
        "id": 111,
        "raw": "[name=\"エンペラー\"]   それで集まった金をぜーんぶ自分たちの取り分にして、クルビアの全部を踏み台にするんだろう？",
        "type": "dialog",
        "speaker": "エンペラー",
        "content": "それで集まった金をぜーんぶ自分たちの取り分にして、クルビアの全部を踏み台にするんだろう？"
    },
    {
        "id": 112,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 113,
        "raw": "[name=\"怪しげな表情の観光客\"]   黙れ！　死ね！",
        "type": "dialog",
        "speaker": "怪しげな表情の観光客",
        "content": "黙れ！　死ね！"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"avg_npc_020\")]",
        "type": "character",
        "name": "avg_npc_020"
    },
    {
        "id": 115,
        "raw": "[name=\"護衛\"]   エンペラーさんを守れ！",
        "type": "dialog",
        "speaker": "護衛",
        "content": "エンペラーさんを守れ！"
    },
