    {
        "id": 66,
        "raw": "[name=\"護衛\"]   エンペラーさん、こちらへ。",
        "type": "dialog",
        "speaker": "護衛",
        "content": "エンペラーさん、こちらへ。"
    },
    {
        "id": 67,
        "raw": "[name=\"護衛\"]   観客の皆様！　どうかお下がりください！　線の内側までお下がりください！",
        "type": "dialog",
        "speaker": "護衛",
        "content": "観客の皆様！　どうかお下がりください！　線の内側までお下がりください！"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_105_emper\")]",
