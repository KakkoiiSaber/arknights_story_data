    {
        "id": 67,
        "raw": "視界の端に、彼女は地面に倒れる黒ずくめの影たちからにじみ出すどす黒い赤色を捉えた。",
        "type": "narration",
        "content": "視界の端に、彼女は地面に倒れる黒ずくめの影たちからにじみ出すどす黒い赤色を捉えた。"
    },
    {
        "id": 68,
        "raw": "この人たちは……誰？　一体いつここに来たの？　どうして倒れてるの？",
        "type": "narration",
        "content": "この人たちは……誰？　一体いつここに来たの？　どうして倒れてるの？"
    },
    {
        "id": 69,
        "raw": "アーミヤはテレジアに聞きたいことがたくさんあった。そして彼女は精いっぱい目を見開く……",
        "type": "narration",
        "content": "アーミヤはテレジアに聞きたいことがたくさんあった。そして彼女は精いっぱい目を見開く……"
    },
    {
        "id": 70,
        "raw": "彼女は白い服に付いたどす黒い赤色を見た。そして……テレジアの赤くなった目尻を見た。",
        "type": "narration",
        "content": "彼女は白い服に付いたどす黒い赤色を見た。そして……テレジアの赤くなった目尻を見た。"
    },
    {
        "id": 71,
        "raw": "テレジアさん、大丈夫？",
        "type": "narration",
        "content": "テレジアさん、大丈夫？"
    },
    {
        "id": 72,
        "raw": "アーミヤはテレジアの怪我の具合を聞こうとした。",
        "type": "narration",
        "content": "アーミヤはテレジアの怪我の具合を聞こうとした。"
    },
    {
        "id": 73,
        "raw": "しかし声が出ない。",
        "type": "narration",
        "content": "しかし声が出ない。"
