    {
        "id": 120,
        "raw": "アーミヤは叫ぼうとしたが、口を開くことも、手足を動かすこともできない。",
        "type": "narration",
        "content": "アーミヤは叫ぼうとしたが、口を開くことも、手足を動かすこともできない。"
    },
    {
        "id": 121,
        "raw": "黒い剣の刃が、自分の胸を貫いたようだ。",
        "type": "narration",
        "content": "黒い剣の刃が、自分の胸を貫いたようだ。"
    },
    {
        "id": 122,
        "raw": "苦痛を感じて然るべきだったが、その剣が残したのは――",
        "type": "narration",
        "content": "苦痛を感じて然るべきだったが、その剣が残したのは――"
    },
    {
        "id": 123,
        "raw": "温かさのみ。それは期待に満ちた温かさだった。",
        "type": "narration",
        "content": "温かさのみ。それは期待に満ちた温かさだった。"
    },
    {
        "id": 124,
        "raw": "[name=\"テレジア\"]アーミヤ、これは希望であり、苦しみでもあるわ。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "アーミヤ、これは希望であり、苦しみでもあるわ。"
    },
    {
        "id": 125,
        "raw": "[name=\"テレジア\"]あなたは戸惑い、ためらうでしょう。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "あなたは戸惑い、ためらうでしょう。"
    },
    {
        "id": 126,
        "raw": "[name=\"テレジア\"]でもどうか信じて、ケルシーがいつまでもあなたのそばにいてくれる。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "でもどうか信じて、ケルシーがいつまでもあなたのそばにいてくれる。"
    },
    {
        "id": 127,
        "raw": "[name=\"テレジア\"]彼女はあなたが存続の秘密を探求し、再びそれに迫るための手助けをしてくれるわ。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "彼女はあなたが存続の秘密を探求し、再びそれに迫るための手助けをしてくれるわ。"
    },
    {
        "id": 128,
        "raw": "[name=\"テレジア\"]きっと乗り越えられるわよね、アーミヤ……",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "きっと乗り越えられるわよね、アーミヤ……"
    },
    {
        "id": 129,
        "raw": "[name=\"テレジア\"]だってあなたは、いつも私を驚かせる強い子だもの。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "だってあなたは、いつも私を驚かせる強い子だもの。"
    },
    {
        "id": 130,
        "raw": "[name=\"テレジア\"]ふぅ……",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "ふぅ……"
    },
    {
        "id": 131,
        "raw": "[name=\"テレジア\"]もう疲れちゃったの。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "もう疲れちゃったの。"
    },
    {
        "id": 132,
        "raw": "[name=\"テレジア\"]ありがとう、アーミヤ。あなたと出会ってからの日々は、おかげ様でとっても楽しかったわ。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "ありがとう、アーミヤ。あなたと出会ってからの日々は、おかげ様でとっても楽しかったわ。"
    },
    {
        "id": 133,
        "raw": "[name=\"テレジア\"]今は、少し休んでいてちょうだい。おやすみなさい……",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "今は、少し休んでいてちょうだい。おやすみなさい……"
    },
