        "id": 52,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 53,
        "raw": "[name=\"ドクター\"]……すまない。結末は変えられないからこそだ。",
        "type": "dialog",
        "speaker": "ドクター",
        "content": "……すまない。結末は変えられないからこそだ。"
