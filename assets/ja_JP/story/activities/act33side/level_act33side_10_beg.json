    {
        "id": 21,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\", duration=1.5, isblock=true)]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png",
        "duration": "1.5,",
        "isblock": true
    },
    {
        "id": 22,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
    {
        "id": 23,
        "raw": "[name=\"ドクター\"]……",
        "type": "dialog",
        "speaker": "ドクター",
        "content": "……"
    },
    {
        "id": 24,
        "raw": "[name=\"ドクター\"]テレジア。想像を絶するほど莫大な生命と時間を費やしてやっと手に入れたこのチャンスを放棄することなど、自分にはできない。",
        "type": "dialog",
        "speaker": "ドクター",
        "content": "テレジア。想像を絶するほど莫大な生命と時間を費やしてやっと手に入れたこのチャンスを放棄することなど、自分にはできない。"
    },
    {
        "id": 25,
        "raw": "[name=\"ドクター\"]君たちの望み通りに源石の計画を失敗に終わらせることなどできやしない。君が……この大地を、美しくもはかない夢にしてしまうことを容認できないんだ。",
        "type": "dialog",
        "speaker": "ドクター",
        "content": "君たちの望み通りに源石の計画を失敗に終わらせることなどできやしない。君が……この大地を、美しくもはかない夢にしてしまうことを容認できないんだ。"
    },
    {
        "id": 26,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#4$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1296_1#4$1.png"
    },
