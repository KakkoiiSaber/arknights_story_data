        "slot": "m",
        "name": "avg_npc_1296_1#9$1.png"
    },
    {
        "id": 63,
        "raw": "[name=\"テレジア\"]実は私……よかったって思ったの、ドクター。",
        "type": "dialog",
        "speaker": "テレジア",
        "content": "実は私……よかったって思ったの、ドクター。"
    },
    {
        "id": 64,
        "raw": "[name=\"テレジア\"]ケルシーの信じたあなたが、私たちを信じてくれたあなたが、本当に存在していたことが嬉しくて。",
        "type": "dialog",
