    {
        "id": 180,
        "raw": "[Subtitle(text=\"大審問官の姿が、海辺の岩礁の如くそこに佇む。\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "大審問官の姿が、海辺の岩礁の如くそこに佇む。",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 181,
        "raw": "[Subtitle(text=\"疑うことを知った時、審問官は初めて、その答えを探求する機会に恵まれる。しかし、醜い悪意や幻惑をほとんど経験してこなかったうら若き少女には、すべてが未だ時期尚早だった。\", x=300, y=370, alignment=\"left\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "疑うことを知った時、審問官は初めて、その答えを探求する機会に恵まれる。しかし、醜い悪意や幻惑をほとんど経験してこなかったうら若き少女には、すべてが未だ時期尚早だった。",
        "x": "300,",
        "y": "370,",
        "alignment": "left",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 182,
        "raw": "[Subtitle(text=\"彼女は現実に打ちのめされ、その中で鍛えられる必要がある。失敗と挫折を経験しなければならないのだ。\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
        "type": "subtitle",
        "text": "彼女は現実に打ちのめされ、その中で鍛えられる必要がある。失敗と挫折を経験しなければならないのだ。",
        "x": "300,",
        "y": "370,",
        "alignment": "center",
        "size": "24,",
        "delay": "0.04,",
        "width": 700
    },
    {
        "id": 183,
        "raw": "[Subtitle(text=\"苦しみを知り、現実離れした理想を捨て去ってこそ、彼女は忍耐を学ぶことができるのだから――\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
