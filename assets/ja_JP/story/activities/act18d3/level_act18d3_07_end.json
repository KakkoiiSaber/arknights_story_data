        "id": 143,
        "raw": "[Character(name=\"avg_npc_182#2\")]",
        "type": "character",
        "name": "avg_npc_182#2"
    },
    {
        "id": 144,
        "raw": "[name=\"審問官アイリーニ\"]……",
        "type": "dialog",
        "speaker": "審問官アイリーニ",
        "content": "……"
