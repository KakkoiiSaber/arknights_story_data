    {
        "id": 14,
        "raw": "[character(name=\"avg_npc_159_1#1\")]",
        "type": "character",
        "name": "avg_npc_159_1#1.png"
    },
    {
        "id": 15,
        "raw": "[name=\"ピカール\"]あなたたちの尽力に感謝いたします。コーエン殿、ケッツ殿、ティナ殿、アレクサンドル殿。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "あなたたちの尽力に感謝いたします。コーエン殿、ケッツ殿、ティナ殿、アレクサンドル殿。"
    },
    {
        "id": 16,
        "raw": "[name=\"ピカール\"]私が謹んで……ロングスプリングの……ええと……",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "私が謹んで……ロングスプリングの……ええと……"
    },
    {
        "id": 17,
        "raw": "[name=\"ピカール\"]申し訳ない……こうした言葉遣いで人と話すのは、慣れなくてな。やはり今まで通りでいかせてもらう。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "申し訳ない……こうした言葉遣いで人と話すのは、慣れなくてな。やはり今まで通りでいかせてもらう。"
    },
    {
        "id": 18,
        "raw": "[name=\"ピカール\"]お前たちのおかげで私は弟の手から生き延びることができたし、私の領民も再び自分たちの土地で暮らすことができる。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "お前たちのおかげで私は弟の手から生き延びることができたし、私の領民も再び自分たちの土地で暮らすことができる。"
    },
    {
        "id": 19,
        "raw": "[name=\"ピカール\"]恩に着る。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "恩に着る。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_456_ash_1#5\")]",
        "type": "character",
        "name": "char_456_ash_1#5.png"
    },
    {
        "id": 21,
        "raw": "[name=\"Ash\"]当然のことをしたまでよ。",
        "type": "dialog",
        "speaker": "Ash",
        "content": "当然のことをしたまでよ。"
    },
    {
        "id": 22,
        "raw": "[name=\"Ash\"]今回の危機はあたしたちが引き起こしたようなもの。だからあたしたちで終わらせる義務があった。",
        "type": "dialog",
        "speaker": "Ash",
        "content": "今回の危機はあたしたちが引き起こしたようなもの。だからあたしたちで終わらせる義務があった。"
    },
    {
        "id": 23,
        "raw": "[character(name=\"avg_npc_159_1#1\")]",
        "type": "character",
        "name": "avg_npc_159_1#1.png"
    },
    {
        "id": 24,
        "raw": "[name=\"ピカール\"]いや、もしあの救いようのない愚かな弟がいなければ、何も起こることはなかった。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "いや、もしあの救いようのない愚かな弟がいなければ、何も起こることはなかった。"
    },
    {
        "id": 25,
        "raw": "[name=\"ピカール\"]本当はお前たちに報酬を渡したいのだが……",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "本当はお前たちに報酬を渡したいのだが……"
    },
    {
        "id": 26,
        "raw": "[name=\"ピカール\"]見ての通り、ロングスプリングは壊滅状態だ。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "見ての通り、ロングスプリングは壊滅状態だ。"
    },
    {
        "id": 27,
        "raw": "[name=\"ピカール\"]残った財産は、すべて町の復興に充てたいと思っている。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "残った財産は、すべて町の復興に充てたいと思っている。"
    },
    {
        "id": 28,
        "raw": "[name=\"ピカール\"]現金による報酬は……申し訳ないが、支払ってやれない。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "現金による報酬は……申し訳ないが、支払ってやれない。"
    },
    {
        "id": 29,
        "raw": "[character(name=\"avg_npc_159_1#3\")]",
        "type": "character",
        "name": "avg_npc_159_1#3.png"
    },
    {
        "id": 30,
        "raw": "[name=\"ピカール\"]だがこの屋敷にある物で、気に入った物があるならそれを渡そう。遠慮なく持って行ってくれ。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "だがこの屋敷にある物で、気に入った物があるならそれを渡そう。遠慮なく持って行ってくれ。"
    },
    {
        "id": 31,
        "raw": "[name=\"ピカール\"]屋敷を取り壊して全て持っていってくれると尚良い。新たなロングスプリングを作り上げるには、無用のものだからな。",
        "type": "dialog",
        "speaker": "ピカール",
        "content": "屋敷を取り壊して全て持っていってくれると尚良い。新たなロングスプリングを作り上げるには、無用のものだからな。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_456_ash_1#5\")]",
        "type": "character",
        "name": "char_456_ash_1#5.png"
    },
    {
        "id": 33,
        "raw": "[name=\"Ash\"]その点についてだけど――",
        "type": "dialog",
        "speaker": "Ash",
        "content": "その点についてだけど――"
    },
    {
        "id": 34,
        "raw": "[name=\"Ash\"]アレクサンドル？",
        "type": "dialog",
        "speaker": "Ash",
        "content": "アレクサンドル？"
    },
