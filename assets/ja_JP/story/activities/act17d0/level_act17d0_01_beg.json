    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_155_1#2\",name2=\"avg_npc_156_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_155_1#2",
        "name2": "avg_npc_156_1#1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"フランカ\"]よかったー！　やーっと徒歩での旅が終わるのね。靴がすり減ってなくなるところだったわ。",
        "type": "dialog",
        "speaker": "フランカ",
        "content": "よかったー！　やーっと徒歩での旅が終わるのね。靴がすり減ってなくなるところだったわ。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_155_1#2\",name2=\"avg_npc_156_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_155_1#2",
        "name2": "avg_npc_156_1#1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"リスカム\"]たくさん外を歩けば身体にも良いし、フランカのダイエットにも役立つよ。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "たくさん外を歩けば身体にも良いし、フランカのダイエットにも役立つよ。"
    },
