        "name": "avg_npc_155_1#1",
        "name2": "avg_npc_156_1#1",
        "focus": 2
    },
    {
        "id": 167,
        "raw": "[name=\"リスカム\"]昨日の夜の時点でもうサルゴン領に入ってるよ……しっかり気を引き締めておかないと、何かあってもフォローしないよ。",
        "type": "dialog",
        "speaker": "リスカム",
        "content": "昨日の夜の時点でもうサルゴン領に入ってるよ……しっかり気を引き締めておかないと、何かあってもフォローしないよ。"
    },
