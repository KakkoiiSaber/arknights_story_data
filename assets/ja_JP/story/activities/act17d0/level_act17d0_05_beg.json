        "raw": "[character(name=\"avg_npc_156_1#1\",name2=\"char_457_blitz_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_npc_156_1#1",
        "name2": "char_457_blitz_1#1",
        "focus": 2
    },
    {
