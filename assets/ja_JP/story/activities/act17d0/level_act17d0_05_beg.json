        "name": "char_458_rfrost_1#3",
        "name2": "char_456_ash_1#5",
        "focus": 1
    },
    {
        "id": 218,
        "raw": "[name=\"Frost\"]先生は休んでる。もう何日もろくに寝てなかったから。",
        "type": "dialog",
        "speaker": "Frost",
        "content": "先生は休んでる。もう何日もろくに寝てなかったから。"
    },
