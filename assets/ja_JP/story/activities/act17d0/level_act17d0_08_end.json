    {
        "id": 108,
        "raw": "[name=\"レンジャー\"]何をしておる？",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "何をしておる？"
    },
    {
        "id": 109,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
        "type": "character",
        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"Tachanka\"]即席で盾を作ってみた。実は前から試してみたかったんだ。",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "即席で盾を作ってみた。実は前から試してみたかったんだ。"
    },
    {
        "id": 111,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=1)]",
        "type": "character",
        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"レンジャー\"]ハハハッ……",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "ハハハッ……"
    },
    {
        "id": 113,
        "raw": "[character(name=\"char_503_rang\")]",
        "type": "character",
        "name": "char_503_rang.png"
    },
    {
        "id": 114,
        "raw": "[name=\"レンジャー\"]昔に戻ったようじゃ……あの栄光の時代に、な。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "昔に戻ったようじゃ……あの栄光の時代に、な。"
    },
    {
        "id": 115,
        "raw": "[name=\"レンジャー\"]ある日、若いレンジャーたちが町の入り口に集結してのう。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "ある日、若いレンジャーたちが町の入り口に集結してのう。"
    },
    {
        "id": 116,
        "raw": "[name=\"レンジャー\"]大軍が押し寄せつつあることも、間もなく荒野が皆の血で染まることもわかっておった。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "大軍が押し寄せつつあることも、間もなく荒野が皆の血で染まることもわかっておった。"
    },
    {
        "id": 117,
        "raw": "[name=\"レンジャー\"]しかし彼らは共に笑い合い、軍歌を高らかに歌った。死を恐れる必要など無いかのごとく、迫っている敵など陳腐な虫けらに過ぎないかのごとく。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "しかし彼らは共に笑い合い、軍歌を高らかに歌った。死を恐れる必要など無いかのごとく、迫っている敵など陳腐な虫けらに過ぎないかのごとく。"
    },
    {
        "id": 118,
        "raw": "[name=\"レンジャー\"]戦争とは残酷で無慈悲じゃ。おじけづいた者もおったが、ほとんどの者が命を賭けて町を守り抜こうと決意したんじゃ。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "戦争とは残酷で無慈悲じゃ。おじけづいた者もおったが、ほとんどの者が命を賭けて町を守り抜こうと決意したんじゃ。"
    },
    {
        "id": 119,
        "raw": "[name=\"レンジャー\"]倒れた者は伝説となり、立っている者は彼らの伝説を刻み語る責任を負った。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "倒れた者は伝説となり、立っている者は彼らの伝説を刻み語る責任を負った。"
    },
    {
        "id": 120,
        "raw": "[name=\"レンジャー\"]そして最後まで立っておった者は、やがて死を恐れ始めた。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "そして最後まで立っておった者は、やがて死を恐れ始めた。"
    },
    {
        "id": 121,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
        "type": "character",
        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"Tachanka\"]倒れていった人たちを忘れたくなかったからか？",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "倒れていった人たちを忘れたくなかったからか？"
    },
    {
        "id": 123,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=1)]",
        "type": "character",
        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"レンジャー\"]ハハハッ……そうかもしれぬな。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "ハハハッ……そうかもしれぬな。"
    },
    {
        "id": 125,
        "raw": "[name=\"レンジャー\"]アレクサンドル……おぬしと肩を並べて戦えて光栄じゃった。",
        "type": "dialog",
        "speaker": "レンジャー",
        "content": "アレクサンドル……おぬしと肩を並べて戦えて光栄じゃった。"
    },
    {
        "id": 126,
        "raw": "[character(name=\"char_503_rang\",name2=\"char_459_tachak_1#2\",focus=2)]",
        "type": "character",
        "name": "char_503_rang.png",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "id": 127,
        "raw": "[name=\"Tachanka\"]俺も光栄だったよ、レンジャー。",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "俺も光栄だったよ、レンジャー。"
    },
    {
        "id": 128,
        "raw": "[name=\"Tachanka\"]だがそんなに悲観的になるな。俺はまだ諦めてない。",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "だがそんなに悲観的になるな。俺はまだ諦めてない。"
    },
    {
        "id": 129,
        "raw": "[name=\"Tachanka\"]弾なんてなくても、ぶん殴ってあいつらを殺してやるさ。",
        "type": "dialog",
        "speaker": "Tachanka",
        "content": "弾なんてなくても、ぶん殴ってあいつらを殺してやるさ。"
    },
