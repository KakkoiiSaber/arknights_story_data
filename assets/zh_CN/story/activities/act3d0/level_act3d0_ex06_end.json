[
    {
        "id": 1,
        "raw": "[HEADER(key=\"title_test\", is_skippable=true, fit_mode=\"BLACK_MASK\")] 第二关（前）",
        "type": "header",
        "key": "title_test",
        "is_skippable": "true,",
        "fit_mode": "BLACK_MASK",
        "content": "第二关（前）"
    },
    {
        "id": 2,
        "raw": "[PlayMusic(intro=\"$lab_intro\", key=\"$lab_loop\", volume=0.8, crossfade=1.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta3_181101/m_sys_lab_intro.mp3",
        "key": "audio/sound_beta_2/music/beta3_181101/m_sys_lab_loop.mp3",
        "volume": "0.8,",
        "crossfade": 1.5
    },
    {
        "id": 3,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 4,
        "raw": "[name=\"Alty\"]  唔嗯。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "唔嗯。"
    },
    {
        "id": 5,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 6,
        "raw": "[name=\"Alty\"]  这就是传闻中的罗德岛啊，感觉确实是个充满了谜团的地方。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "这就是传闻中的罗德岛啊，感觉确实是个充满了谜团的地方。"
    },
    {
        "id": 7,
        "raw": "[Background(image=\"bg_infirmary\", fadetime=1,block=true)]",
        "type": "background",
        "image": "bg_infirmary.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 8,
        "raw": "[name=\"Alty\"]  空气中还夹杂着一股非常熟悉的气息。嗯……",
        "type": "dialog",
        "speaker": "Alty",
        "content": "空气中还夹杂着一股非常熟悉的气息。嗯……"
    },
    {
        "id": 9,
        "raw": "[name=\"Alty\"]  要不是真的登上这艘载具，我还以为自己依然呆在海边呢。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "要不是真的登上这艘载具，我还以为自己依然呆在海边呢。"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 11,
        "raw": "[name=\"凯尔希\"]  这里近期确实接待过几个阿戈尔人。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这里近期确实接待过几个阿戈尔人。"
    },
    {
        "id": 12,
        "raw": "[name=\"凯尔希\"]  你也是阿戈尔的访客，但我没在访客名单上看到你的名字。我也许没法接待你。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "你也是阿戈尔的访客，但我没在访客名单上看到你的名字。我也许没法接待你。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"Alty\"]  啊啊，抱歉抱歉，不过不劳烦你了，我说点事就走，不会在这里呆太久的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "啊啊，抱歉抱歉，不过不劳烦你了，我说点事就走，不会在这里呆太久的。"
    },
    {
        "id": 15,
        "raw": "[name=\"Alty\"]  咦，你居然还知道我的名字？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "咦，你居然还知道我的名字？"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"凯尔希\"]  这几天会待在汐斯塔一带的人，没有人不知道你的名字。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这几天会待在汐斯塔一带的人，没有人不知道你的名字。"
    },
    {
        "id": 18,
        "raw": "[name=\"凯尔希\"]  虽然我并没有去，但我也早有耳闻。日落即逝的贝斯手Alty女士，罗德岛不是个可以随意进出的地方。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "虽然我并没有去，但我也早有耳闻。日落即逝的贝斯手Alty女士，罗德岛不是个可以随意进出的地方。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"Alty\"]   啊呀，唉，不要那么有敌意啊。毕竟我们有很多共同话题，对吧，比如说还能看到星星的时候？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "啊呀，唉，不要那么有敌意啊。毕竟我们有很多共同话题，对吧，比如说还能看到星星的时候？"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_003_kalts_1\")]",
        "type": "character",
        "name": "char_003_kalts_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"凯尔希\"]  ——请坐。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "——请坐。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"Alty\"]   谢谢。你肯定会好奇我是怎么进来的吧？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "谢谢。你肯定会好奇我是怎么进来的吧？"
    },
    {
        "id": 25,
        "raw": "[name=\"Alty\"]  这不重要的，你不用担心罗德岛的安保设施有什么漏洞，单纯是我运气好罢了。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "这不重要的，你不用担心罗德岛的安保设施有什么漏洞，单纯是我运气好罢了。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"凯尔希\"]  话语掩盖不了你的实力。请放心，我不怎么担忧，至少它只会对重要的访客网开一面。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "话语掩盖不了你的实力。请放心，我不怎么担忧，至少它只会对重要的访客网开一面。"
    },
    {
        "id": 28,
        "raw": "[name=\"凯尔希\"]  不过，一位音乐巨星是怎么对这狭小的病房产生兴趣的？",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "不过，一位音乐巨星是怎么对这狭小的病房产生兴趣的？"
    },
    {
        "id": 29,
        "raw": "[name=\"凯尔希\"]  如果是想和你的阿戈尔朋友叙旧，你可能走错房间了。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "如果是想和你的阿戈尔朋友叙旧，你可能走错房间了。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"Alty\"]   朋友？嗯……谈不上吧？不，该说，离朋友有点远呢……",
        "type": "dialog",
        "speaker": "Alty",
        "content": "朋友？嗯……谈不上吧？不，该说，离朋友有点远呢……"
    },
    {
        "id": 32,
        "raw": "[name=\"Alty\"]   其实我是来找你的。或者说，是来看看你的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "其实我是来找你的。或者说，是来看看你的。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_003_kalts_1#2\")]",
        "type": "character",
        "name": "char_003_kalts_1#2.png"
    },
    {
        "id": 34,
        "raw": "[name=\"凯尔希\"]  很抱歉，我不认识你，我也不是动物园的展品。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "很抱歉，我不认识你，我也不是动物园的展品。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1#2\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1#2",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"Alty\"]   阿戈尔人的传闻，我从Frost那里听说了很多。她很少讲故事的，但那次她说了很多。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "阿戈尔人的传闻，我从Frost那里听说了很多。她很少讲故事的，但那次她说了很多。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"凯尔希\"]  我没兴趣听你说些你朋友的奇异冒险故事……",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我没兴趣听你说些你朋友的奇异冒险故事……"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"Alty\"]   那唱出来怎么样？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "那唱出来怎么样？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"凯尔希\"]  ……或是面目全非的有关我的逸闻。我希望你能更直接一点。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "……或是面目全非的有关我的逸闻。我希望你能更直接一点。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"Alty\"]   有人告诉过我闲聊可以缓和气氛，我做的似乎不太成功……",
        "type": "dialog",
        "speaker": "Alty",
        "content": "有人告诉过我闲聊可以缓和气氛，我做的似乎不太成功……"
    },
    {
        "id": 45,
        "raw": "[name=\"Alty\"]   那就开始吧。我其实有些讨厌他们阿戈尔人。当然我也知道，他们确实挺可怜的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "那就开始吧。我其实有些讨厌他们阿戈尔人。当然我也知道，他们确实挺可怜的。"
    },
    {
        "id": 46,
        "raw": "[name=\"Alty\"]   只是，如果没有你出现的话，这几个阿戈尔人可能都会沉入海底，被幽暗的海洋吞噬。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "只是，如果没有你出现的话，这几个阿戈尔人可能都会沉入海底，被幽暗的海洋吞噬。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 48,
        "raw": "[name=\"凯尔希\"]  我并没有做什么重要的事情。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我并没有做什么重要的事情。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 50,
        "raw": "[name=\"Alty\"]   你救了他们，而且这里就有好几个。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "你救了他们，而且这里就有好几个。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_003_kalts_1#3\")]",
        "type": "character",
        "name": "char_003_kalts_1#3.png"
    },
    {
        "id": 52,
        "raw": "[name=\"凯尔希\"]  ……",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "……"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 54,
        "raw": "[name=\"Alty\"]   这些特别的阿戈尔人，他们一点都不尊敬你，明明你为他们做了这么多。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "这些特别的阿戈尔人，他们一点都不尊敬你，明明你为他们做了这么多。"
    },
    {
        "id": 55,
        "raw": "[name=\"Alty\"]   你平时是不是对他们太凶了？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "你平时是不是对他们太凶了？"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1#3\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1#3",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"凯尔希\"]  我只是在阻止他们自取灭亡。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我只是在阻止他们自取灭亡。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1#3\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1#3",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"Alty\"]   那也是种慈悲心的体现，医生。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "那也是种慈悲心的体现，医生。"
    },
    {
        "id": 60,
        "raw": "[name=\"Alty\"]   只不过，我的问题也就在这里。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "只不过，我的问题也就在这里。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"凯尔希\"]  请说。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "请说。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 64,
        "raw": "[name=\"Alty\"]   你知道阿戈尔人的敌人是什么吗？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "你知道阿戈尔人的敌人是什么吗？"
    },
    {
        "id": 65,
        "raw": "[name=\"Alty\"]   或者，你其实知道我的身份吧？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "或者，你其实知道我的身份吧？"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_003_kalts_1#2\",name2=\"npc_10002\",focus=2)]",
        "type": "character",
        "name": "char_003_kalts_1#2.png",
        "name2": "npc_10002",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"Mon3tr\"]  ！！",
        "type": "dialog",
        "speaker": "Mon3tr",
        "content": "！！"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_003_kalts_1#2\",name2=\"npc_10002\",focus=1)]",
        "type": "character",
        "name": "char_003_kalts_1#2.png",
        "name2": "npc_10002",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"凯尔希\"]   Mon3tr，停下！",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "Mon3tr，停下！"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_003_kalts_1#2\",name2=\"npc_10002\",focus=1)]",
        "type": "character",
        "name": "char_003_kalts_1#2.png",
        "name2": "npc_10002",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"凯尔希\"]  你很年轻。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "你很年轻。"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 73,
        "raw": "[name=\"Alty\"]   是的，我们很年轻，我们没有经历过那些悲伤的事情，所以我们还在这，还可以说话，还可以唱歌。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "是的，我们很年轻，我们没有经历过那些悲伤的事情，所以我们还在这，还可以说话，还可以唱歌。"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_003_kalts_1#2\",name2=\"npc_10002\",focus=1)]",
        "type": "character",
        "name": "char_003_kalts_1#2.png",
        "name2": "npc_10002",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"凯尔希\"]  深海猎人们在做他们应该做的事情。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "深海猎人们在做他们应该做的事情。"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 77,
        "raw": "[name=\"Alty\"]   我明白，这些我都明白。只不过，我们也想知道答案。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "我明白，这些我都明白。只不过，我们也想知道答案。"
    },
    {
        "id": 78,
        "raw": "[name=\"Alty\"]   我们一点也不想和这些小家伙敌对。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "我们一点也不想和这些小家伙敌对。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 80,
        "raw": "[name=\"Alty\"]   Frost她啊，从小就只对音乐和食物这两样东西感兴趣。就连休息对她来说都是浪费时间。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "Frost她啊，从小就只对音乐和食物这两样东西感兴趣。就连休息对她来说都是浪费时间。"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"凯尔希\"]  这位朋友你可以等到我们真正会面了再介绍给我。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这位朋友你可以等到我们真正会面了再介绍给我。"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 84,
        "raw": "[name=\"Alty\"]   对不起，我的老毛病又犯了……",
        "type": "dialog",
        "speaker": "Alty",
        "content": "对不起，我的老毛病又犯了……"
    },
    {
        "id": 85,
        "raw": "[name=\"Alty\"]   我信任医生你，以及你掌握着的真相。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "我信任医生你，以及你掌握着的真相。"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"凯尔希\"]  我不认为你对真相的了解比我少。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我不认为你对真相的了解比我少。"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"Alty\"]   不，只是我们有各自擅长的事情而已，比如说，我觉得你唱歌也许不会那么动听。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "不，只是我们有各自擅长的事情而已，比如说，我觉得你唱歌也许不会那么动听。"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 91,
        "raw": "[name=\"凯尔希\"]  ……",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "……"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 93,
        "raw": "[name=\"Alty\"]   啊，嗯，只是举个例子！没有要冒犯你的意思。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "啊，嗯，只是举个例子！没有要冒犯你的意思。"
    },
    {
        "id": 94,
        "raw": "[name=\"Alty\"]   但阿戈尔的平静，就像你知道的那样，只是个表面现象。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "但阿戈尔的平静，就像你知道的那样，只是个表面现象。"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 96,
        "raw": "[name=\"凯尔希\"]  大多数人对大海一无所知。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "大多数人对大海一无所知。"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"Alty\"]   大地的孩子又怎么会知道这些呢？对他们要求太高也不好。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "大地的孩子又怎么会知道这些呢？对他们要求太高也不好。"
    },
    {
        "id": 99,
        "raw": "[name=\"Alty\"]   只是，哪怕是这表面上的平静，可能也没法坚持太久了。欲望果然是可怕的东西。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "只是，哪怕是这表面上的平静，可能也没法坚持太久了。欲望果然是可怕的东西。"
    },
    {
        "id": 100,
        "raw": "[name=\"Alty\"]   所以，我需要一些，嗯，信息。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "所以，我需要一些，嗯，信息。"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 102,
        "raw": "[name=\"凯尔希\"]  又是信息？",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "又是信息？"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 104,
        "raw": "[name=\"Alty\"]   是的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "是的。"
    },
    {
        "id": 105,
        "raw": "[name=\"Alty\"]   这么说……哦哦，原来对这些感兴趣的不止我一个啊，哈哈。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "这么说……哦哦，原来对这些感兴趣的不止我一个啊，哈哈。"
    },
    {
        "id": 106,
        "raw": "[name=\"Alty\"]   我有些好奇，上一个人是谁呢？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "我有些好奇，上一个人是谁呢？"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"凯尔希\"]  是个阿戈尔人，也是个深海猎人。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "是个阿戈尔人，也是个深海猎人。"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"Alty\"]   那我们也许真的能做朋友呢，呼呼。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "那我们也许真的能做朋友呢，呼呼。"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 112,
        "raw": "[name=\"凯尔希\"]  当然。我能理解你为什么来找我。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "当然。我能理解你为什么来找我。"
    },
    {
        "id": 113,
        "raw": "[name=\"凯尔希\"]  活得越久，故事越多，伤痕越疼，脾气越差。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "活得越久，故事越多，伤痕越疼，脾气越差。"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 115,
        "raw": "[name=\"Alty\"]   抱歉，我不是想揭你的伤疤……",
        "type": "dialog",
        "speaker": "Alty",
        "content": "抱歉，我不是想揭你的伤疤……"
    },
    {
        "id": 116,
        "raw": "[Background(fadetime=3, block=false)]",
        "type": "background",
        "fadetime": "3,",
        "block": false
    },
    {
        "id": 117,
        "raw": "[Character(name=\"npc_2004_Alty\")]",
        "type": "character",
        "name": "npc_2004_Alty.png"
    },
    {
        "id": 118,
        "raw": "[name=\"Alty\"]   只是你确实不像其他人。他们会被过多的感情束缚、被言论利用，甚至变成某种灾难。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "只是你确实不像其他人。他们会被过多的感情束缚、被言论利用，甚至变成某种灾难。"
    },
    {
        "id": 119,
        "raw": "[name=\"Alty\"]   也难怪那个人让你作为最后的底牌来帮助小兔子和Dr.{@nickname}。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "也难怪那个人让你作为最后的底牌来帮助小兔子和Dr.{@nickname}。"
    },
    {
        "id": 120,
        "raw": "[name=\"Alty\"]   你其实是台X光机对吧？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "你其实是台X光机对吧？"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"凯尔希\"]  我也希望自己是台单纯的机器。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我也希望自己是台单纯的机器。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"Alty\"]   唔，不好意思，我其实只是想说，虽然你不会选择告知别人，但里面的东西，你其实已经全看到了吧？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "唔，不好意思，我其实只是想说，虽然你不会选择告知别人，但里面的东西，你其实已经全看到了吧？"
    },
    {
        "id": 125,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 126,
        "raw": "[name=\"凯尔希\"]  这个问题，我不能回答你。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这个问题，我不能回答你。"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 128,
        "raw": "[name=\"Alty\"]   那就让我切入主题吧。这个问题你是可以回答的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "那就让我切入主题吧。这个问题你是可以回答的。"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 130,
        "raw": "[name=\"凯尔希\"]  说吧，年轻的巨星。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "说吧，年轻的巨星。"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 132,
        "raw": "[name=\"Alty\"]   啊，谢谢。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "啊，谢谢。"
    },
    {
        "id": 133,
        "raw": "[Blocker(a=1, r=0,g=0, b=0, fadetime=2, block=true)]",
        "type": "blocker",
        "a": "1,",
        "r": "0,g=0,",
        "b": "0,",
        "fadetime": "2,",
        "block": true
    },
    {
        "id": 134,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 135,
        "raw": "[Background]",
        "type": "background"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 137,
        "raw": "[name=\"Alty\"]   请告诉我，你所知道的，关于那片海洋下发生的一切。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "请告诉我，你所知道的，关于那片海洋下发生的一切。"
    },
    {
        "id": 138,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 139,
        "raw": "[name=\"凯尔希\"]  这不是一种信息。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这不是一种信息。"
    },
    {
        "id": 140,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 141,
        "raw": "[name=\"Alty\"]   不，我说的是，“那片海洋”。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "不，我说的是，“那片海洋”。"
    },
    {
        "id": 142,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=2)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "id": 143,
        "raw": "[name=\"凯尔希\"]  ——",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "——"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"npc_2004_Alty\",name2=\"char_003_kalts_1\",focus=1)]",
        "type": "character",
        "name": "npc_2004_Alty.png",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 145,
        "raw": "[name=\"Alty\"]   Frost是我们中最年轻的。只有我们四个是年轻的。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "Frost是我们中最年轻的。只有我们四个是年轻的。"
    },
    {
        "id": 146,
        "raw": "[name=\"Alty\"]   她嗅到那几个阿戈尔人的味道。那不是阿戈尔人应该有的味道。",
        "type": "dialog",
        "speaker": "Alty",
        "content": "她嗅到那几个阿戈尔人的味道。那不是阿戈尔人应该有的味道。"
    },
    {
        "id": 147,
        "raw": "[name=\"Alty\"]   “它们不能再歌唱。它们不能再说话。它们离我们越来越远。它们饥渴难当。”",
        "type": "dialog",
        "speaker": "Alty",
        "content": "“它们不能再歌唱。它们不能再说话。它们离我们越来越远。它们饥渴难当。”"
    },
    {
        "id": 148,
        "raw": "[name=\"Alty\"]   AMa-10凯尔希医生，请你告诉我——这些特别的阿戈尔人，他们是怎么诞生的？",
        "type": "dialog",
        "speaker": "Alty",
        "content": "AMa-10凯尔希医生，请你告诉我——这些特别的阿戈尔人，他们是怎么诞生的？"
    },
    {
        "id": 149,
        "raw": "[dialog]",
        "type": "dialog_marker"
    }
