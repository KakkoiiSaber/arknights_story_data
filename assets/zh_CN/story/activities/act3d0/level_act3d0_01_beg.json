        "randomness": "90,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 47,
        "raw": "[name=\"天火\"]   我说，大尾巴！",
        "type": "dialog",
        "speaker": "天火",
        "content": "我说，大尾巴！"
    },
    {
        "id": 48,
