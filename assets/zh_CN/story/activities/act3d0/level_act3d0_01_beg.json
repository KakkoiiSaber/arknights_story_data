        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"普罗旺斯\"]   嗯？欸，你是在叫我？",
        "type": "dialog",
        "speaker": "普罗旺斯",
        "content": "嗯？欸，你是在叫我？"
