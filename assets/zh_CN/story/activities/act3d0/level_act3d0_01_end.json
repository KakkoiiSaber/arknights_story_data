    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_348_ceylon_4#4\")]",
        "type": "character",
        "name": "char_348_ceylon_4#4.png"
    },
    {
        "id": 24,
        "raw": "[name=\"锡兰\"]   嗯，那么，虽然比较晚了，请容我正式自我介绍一下。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "嗯，那么，虽然比较晚了，请容我正式自我介绍一下。"
    },
    {
        "id": 25,
        "raw": "[name=\"锡兰\"]   我的名字是锡兰·道尔科斯，维多利亚国立大学毕业，专攻方向是源石研究，也是这座城市市长的女儿。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "我的名字是锡兰·道尔科斯，维多利亚国立大学毕业，专攻方向是源石研究，也是这座城市市长的女儿。"
    },
    {
        "id": 26,
        "raw": "[Decision(options=\"市长的女儿？！\",values=\"1\")]",
        "type": "decision",
        "options": "市长的女儿？！",
        "values": "1"
    },
    {
        "id": 27,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
        "references": "1"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_145_prove_1\",name2=\"char_166_skfire_3#2\",focus=2)]",
        "type": "character",
        "name": "char_145_prove_1.png",
        "name2": "char_166_skfire_3#2",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"天火\"]   谁会想到市长的女儿会独自去未开发的火山林地呢。",
        "type": "dialog",
        "speaker": "天火",
        "content": "谁会想到市长的女儿会独自去未开发的火山林地呢。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_348_ceylon_4#4\")]",
        "type": "character",
        "name": "char_348_ceylon_4#4.png"
    },
    {
        "id": 31,
        "raw": "[name=\"锡兰\"]    那也是因为不得不做一些学者必须要去尝试的冒险……",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "那也是因为不得不做一些学者必须要去尝试的冒险……"
    },
