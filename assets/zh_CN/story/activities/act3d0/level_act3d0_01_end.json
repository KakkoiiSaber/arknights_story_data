    {
        "id": 10,
        "raw": "[name=\"普罗旺斯\"]   就是如此，我们在火山脚下的森林里，碰到了锡兰小姐。",
        "type": "dialog",
        "speaker": "普罗旺斯",
        "content": "就是如此，我们在火山脚下的森林里，碰到了锡兰小姐。"
    },
    {
        "id": 11,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 12,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",fadetime=1,block=true)]",
        "type": "character",
        "name": "char_348_ceylon_4#7.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 14,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 15,
        "raw": "[name=\"锡兰\"]   我有一个问题。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "我有一个问题。"
    },
    {
        "id": 16,
        "raw": "[name=\"锡兰\"]   有必要把你们解救我之前的过程描述得这么详细吗？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "有必要把你们解救我之前的过程描述得这么详细吗？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_166_skfire_3#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#7.png",
        "name2": "char_166_skfire_3#1",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"天火\"]   我觉得这位大小姐说得对，而且大尾巴你是不是还提到了你觉得我很麻烦？",
        "type": "dialog",
        "speaker": "天火",
        "content": "我觉得这位大小姐说得对，而且大尾巴你是不是还提到了你觉得我很麻烦？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_145_prove_1\")]",
        "type": "character",
        "name": "char_145_prove_1.png"
    },
    {
        "id": 20,
        "raw": "[name=\"普罗旺斯\"]   欸，啊，是你的错觉！",
        "type": "dialog",
        "speaker": "普罗旺斯",
        "content": "欸，啊，是你的错觉！"
    },
    {
        "id": 21,
        "raw": "[Decision(options=\"不管怎么说，大家平安无事就好。\",values=\"1\")]",
        "type": "decision",
        "options": "不管怎么说，大家平安无事就好。",
        "values": "1"
    },
    {
        "id": 22,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
