        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 147,
        "raw": "[name=\"锡兰\"]   ......黑......",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "......黑......"
    },
    {
        "id": 148,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#4",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 149,
        "raw": "[name=\"黑\"]   小姐，你需要我保护你吗？",
        "type": "dialog",
        "speaker": "黑",
        "content": "小姐，你需要我保护你吗？"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#2\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#2",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"锡兰\"]   嗯，需要。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "嗯，需要。"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#2\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"黑\"]   那就请小姐躲好了。很快就会结束。",
        "type": "dialog",
        "speaker": "黑",
        "content": "那就请小姐躲好了。很快就会结束。"
    },
    {
