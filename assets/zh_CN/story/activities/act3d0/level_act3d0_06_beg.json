        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"黑\"]   小姐，我不想你知道这些！",
        "type": "dialog",
        "speaker": "黑",
        "content": "小姐，我不想你知道这些！"
