        "type": "character",
        "name": "char_348_ceylon_4#2",
        "name2": "char_340_shwaz_2#2",
        "focus": 2
    },
    {
        "id": 135,
        "raw": "[name=\"黑\"]   小姐，请说，你接下来的安排是什么？",
        "type": "dialog",
        "speaker": "黑",
        "content": "小姐，请说，你接下来的安排是什么？"
