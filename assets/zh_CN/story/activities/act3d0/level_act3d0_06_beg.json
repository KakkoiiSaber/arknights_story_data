        "raw": "[Character(name=\"char_348_ceylon_4#5\",name2=\"char_340_shwaz_2#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#5",
        "name2": "char_340_shwaz_2#1",
        "focus": 2
    },
    {
