    {
        "id": 10,
        "raw": "[name=\"锡兰\"]   ......可以陪我逛逛吗，博士。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "......可以陪我逛逛吗，博士。"
    },
    {
        "id": 11,
        "raw": "[Decision(options=\"我有些担心你。\",values=\"1\")]",
        "type": "decision",
        "options": "我有些担心你。",
        "values": "1"
    },
    {
