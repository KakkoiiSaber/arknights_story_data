        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"锡兰\"]   黑，我要出门去观察海边的生态！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "黑，我要出门去观察海边的生态！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#1\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#1",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"黑\"]   不行，小姐，老爷吩咐过，不能随便出门的。",
        "type": "dialog",
        "speaker": "黑",
        "content": "不行，小姐，老爷吩咐过，不能随便出门的。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_348_ceylon_4#1\",name2=\"char_340_shwaz_2#1\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#1.png",
        "name2": "char_340_shwaz_2#1",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"锡兰\"]   可家里的书我已经看腻了！黑你又一点也不好玩。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "可家里的书我已经看腻了！黑你又一点也不好玩。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_348_ceylon_4#1\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#1.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"黑\"]   对不起，小姐。这也是为了您的安全着想，外面是很危险的。",
        "type": "dialog",
        "speaker": "黑",
        "content": "对不起，小姐。这也是为了您的安全着想，外面是很危险的。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#4.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"锡兰\"]   不是有你在吗，难道你会让我身处危险吗？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "不是有你在吗，难道你会让我身处危险吗？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_348_ceylon_4#4\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#4.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"黑\"]   ......那自然是肯定不会的。",
        "type": "dialog",
        "speaker": "黑",
        "content": "......那自然是肯定不会的。"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"锡兰\"]   那还有什么问题？我们走！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "那还有什么问题？我们走！"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"黑\"]   ......那么，请您绝对不要离开我的视线。",
        "type": "dialog",
        "speaker": "黑",
        "content": "......那么，请您绝对不要离开我的视线。"
    },
