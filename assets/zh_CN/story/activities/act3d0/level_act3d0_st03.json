    {
        "id": 75,
        "raw": "[name=\"锡兰\"]   为什么？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "为什么？"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_348_ceylon_4#7\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#7.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"黑\"]   因为我得了矿石病，小姐。",
        "type": "dialog",
        "speaker": "黑",
        "content": "因为我得了矿石病，小姐。"
    },
    {
        "id": 78,
        "raw": "[name=\"黑\"]   靠近我对您的身体不好，您只要在需要的时候叫我就好。",
        "type": "dialog",
        "speaker": "黑",
        "content": "靠近我对您的身体不好，您只要在需要的时候叫我就好。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#8.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"锡兰\"]   那是什么，很痛吗？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "那是什么，很痛吗？"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_348_ceylon_4#8\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#8.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"黑\"]   ......不会很痛，但是，会死。",
        "type": "dialog",
        "speaker": "黑",
        "content": "......不会很痛，但是，会死。"
    },
    {
        "id": 83,
        "raw": "[name=\"黑\"]   这种病是治不了的，小姐。",
        "type": "dialog",
        "speaker": "黑",
        "content": "这种病是治不了的，小姐。"
    },
    {
        "id": 84,
        "raw": "[name=\"黑\"]   而且......",
        "type": "dialog",
        "speaker": "黑",
        "content": "而且......"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_348_ceylon_4#3\",name2=\"char_340_shwaz_2#3\",focus=1)]",
