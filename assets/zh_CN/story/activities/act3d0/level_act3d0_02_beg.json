        "name": "avg_npc_023_2#3.png",
        "name2": "char_348_ceylon_4#2",
        "focus": 2
    },
    {
        "id": 121,
        "raw": "[name=\"锡兰\"]   你在说什么？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "你在说什么？"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"avg_npc_023_2#3\",name2=\"char_348_ceylon_4#2\",focus=1)]",
