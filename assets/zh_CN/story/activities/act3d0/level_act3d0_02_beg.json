        "name2": "char_348_ceylon_4#2",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"克洛宁\"]   原来如此，原来如此。",
        "type": "dialog",
        "speaker": "克洛宁",
        "content": "原来如此，原来如此。"
    },
    {
        "id": 118,
        "raw": "[name=\"克洛宁\"]   ......呵呵，我懂了。",
