        "name": "avg_npc_023_2#3.png",
        "name2": "char_348_ceylon_4#2",
        "focus": 2
    },
    {
        "id": 114,
        "raw": "[name=\"锡兰\"]   {@nickname}博士是专门机构的研究人员，他和他的其他同事们都有专门的火山知识。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "{@nickname}博士是专门机构的研究人员，他和他的其他同事们都有专门的火山知识。"
    },
    {
        "id": 115,
        "raw": "[name=\"锡兰\"]   这些参数也都是他们的专业部门给了我帮助并且进行验证的结果。",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "这些参数也都是他们的专业部门给了我帮助并且进行验证的结果。"
