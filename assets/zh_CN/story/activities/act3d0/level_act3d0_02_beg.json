        "focus": 2
    },
    {
        "id": 156,
        "raw": "[name=\"锡兰\"]   克洛宁！你是连我说的话都无视了吗？",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "克洛宁！你是连我说的话都无视了吗？"
