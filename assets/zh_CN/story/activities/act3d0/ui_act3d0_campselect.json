    {
        "id": 35,
        "raw": "[name=\"主持人\"]   所以，请不要犹豫，为你最喜欢的艺人投上宝贵的一票吧！",
        "type": "dialog",
        "speaker": "主持人",
        "content": "所以，请不要犹豫，为你最喜欢的艺人投上宝贵的一票吧！"
    },
