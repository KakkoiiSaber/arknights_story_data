        "type": "character",
        "name": "avg_npc_017_3#4",
        "fadetime": "1,",
        "block": true
    },
    {
        "id": 17,
        "raw": "[name=\"主持人\"]   无论你是什么种族，从哪个城市来，从今天开始，抛弃自己的身份，忘掉所有的烦恼！",
        "type": "dialog",
        "speaker": "主持人",
        "content": "无论你是什么种族，从哪个城市来，从今天开始，抛弃自己的身份，忘掉所有的烦恼！"
    },
    {
        "id": 18,
        "raw": "[name=\"主持人\"]   黑曜石节日需要的是每一个人的参与！！融入！！",
        "type": "dialog",
        "speaker": "主持人",
        "content": "黑曜石节日需要的是每一个人的参与！！融入！！"
    },
    {
        "id": 19,
        "raw": "[name=\"主持人\"]   把你们每个人的手都举到最高，让我能看到你们每一个人！",
        "type": "dialog",
        "speaker": "主持人",
        "content": "把你们每个人的手都举到最高，让我能看到你们每一个人！"
