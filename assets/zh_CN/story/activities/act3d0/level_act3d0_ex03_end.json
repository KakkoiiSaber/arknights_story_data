    },
    {
        "id": 135,
        "raw": "[name=\"表情古怪的游客\"]   咕——呃——你随身带着铳械......",
        "type": "dialog",
        "speaker": "表情古怪的游客",
        "content": "咕——呃——你随身带着铳械......"
