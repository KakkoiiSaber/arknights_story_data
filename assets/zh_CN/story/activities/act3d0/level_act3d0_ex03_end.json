    {
        "id": 69,
        "raw": "[name=\"大帝\"]   喂，那个萨弗拉年轻人。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "喂，那个萨弗拉年轻人。"
    },
    {
        "id": 70,
