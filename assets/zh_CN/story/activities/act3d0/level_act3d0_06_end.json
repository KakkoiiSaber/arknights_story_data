        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"黑\"]     所以我不想让小姐知道。",
        "type": "dialog",
        "speaker": "黑",
        "content": "所以我不想让小姐知道。"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 15,
        "raw": "[name=\"锡兰\"]     但你实在是太厉害了！好帅呀，黑！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "但你实在是太厉害了！好帅呀，黑！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=2)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"黑\"]     唔。",
        "type": "dialog",
        "speaker": "黑",
        "content": "唔。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_348_ceylon_4#6\",name2=\"char_340_shwaz_2#3\",focus=1)]",
        "type": "character",
        "name": "char_348_ceylon_4#6.png",
        "name2": "char_340_shwaz_2#3",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"锡兰\"]     你是怎么跳那么高的！顺着墙窜上去，然后直接翻身跃下！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "你是怎么跳那么高的！顺着墙窜上去，然后直接翻身跃下！"
    },
    {
        "id": 20,
        "raw": "[name=\"锡兰\"]     就在空中这么旋转，所有射击都被你躲过去了！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "就在空中这么旋转，所有射击都被你躲过去了！"
    },
    {
        "id": 21,
        "raw": "[name=\"锡兰\"]     然后扭过身体，啪啪啪，连着把他们全都射倒！天哪！",
        "type": "dialog",
        "speaker": "锡兰",
        "content": "然后扭过身体，啪啪啪，连着把他们全都射倒！天哪！"
    },
