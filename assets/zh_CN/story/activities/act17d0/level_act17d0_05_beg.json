    {
        "id": 58,
        "raw": "[name=\"灰烬\"]这是那位叫雷蛇的罗德岛干员使用的子弹，学名叫“蚀刻子弹”，据说是非常昂贵的产品。",
        "type": "dialog",
        "speaker": "灰烬",
        "content": "这是那位叫雷蛇的罗德岛干员使用的子弹，学名叫“蚀刻子弹”，据说是非常昂贵的产品。"
    },
    {
        "id": 59,
        "raw": "[character(name=\"char_456_ash_1#5\",name2=\"char_459_tachak_1\",focus=2)]",
        "type": "character",
        "name": "char_456_ash_1#5",
        "name2": "char_459_tachak_1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"战车\"]你已经拆开了？",
        "type": "dialog",
        "speaker": "战车",
        "content": "你已经拆开了？"
    },
    {
        "id": 61,
        "raw": "[name=\"战车\"]这子弹是什么结构啊，发射药呢？",
        "type": "dialog",
        "speaker": "战车",
        "content": "这子弹是什么结构啊，发射药呢？"
