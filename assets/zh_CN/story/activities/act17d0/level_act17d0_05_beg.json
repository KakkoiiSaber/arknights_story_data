        "name": "char_456_ash_1#5",
        "name2": "char_459_tachak_1",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"战车\"]看着像是能量源，它是算发射药还是战斗部？",
        "type": "dialog",
        "speaker": "战车",
        "content": "看着像是能量源，它是算发射药还是战斗部？"
