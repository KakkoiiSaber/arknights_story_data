    {
        "id": 30,
        "raw": "[name=\"宝巫迦\"]夸下海口，要是做不到该怎么办？",
        "type": "dialog",
        "speaker": "宝巫迦",
        "content": "夸下海口，要是做不到该怎么办？"
    },
    {
        "id": 31,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_2101_1#10$1\",focus=\"m\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_2101_1#10$1.png",
        "focus": "m"
    },
    {
        "id": 32,
        "raw": "[name=\"月见夜\"]团队最重士气，有信心重于一切。",
        "type": "dialog",
        "speaker": "月见夜",
        "content": "团队最重士气，有信心重于一切。"
    },
    {
        "id": 33,
