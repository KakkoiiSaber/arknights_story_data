        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_2100_1#1$1.png",
        "focus": "m"
    },
    {
        "id": 54,
        "raw": "[name=\"宝巫迦\"]吾知道，眼下的吾等，做不到正面抵挡。",
        "type": "dialog",
        "speaker": "宝巫迦",
        "content": "吾知道，眼下的吾等，做不到正面抵挡。"
