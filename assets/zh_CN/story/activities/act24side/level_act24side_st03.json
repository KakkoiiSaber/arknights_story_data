        "type": "character"
    },
    {
        "id": 25,
        "raw": "[name=\"好奇的幼童\"]但是之前袭击村庄的火龙，好像确实让它飞走了。",
        "type": "dialog",
        "speaker": "好奇的幼童",
        "content": "但是之前袭击村庄的火龙，好像确实让它飞走了。"
    },
