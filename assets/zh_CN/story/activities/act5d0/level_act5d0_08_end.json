        "name2": "avg_npc_035",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"？？？\"]   我没有在担心她。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "我没有在担心她。"
    },
    {
        "id": 31,
