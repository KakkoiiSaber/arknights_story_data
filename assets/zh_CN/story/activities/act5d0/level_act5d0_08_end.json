        "name2": "avg_npc_035",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"伊斯\"]   她不会有事的。",
        "type": "dialog",
        "speaker": "伊斯",
        "content": "她不会有事的。"
