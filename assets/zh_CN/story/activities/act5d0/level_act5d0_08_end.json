        "name": "char_103_angel_1#4.png",
        "name2": "char_325_bison_1#2",
        "focus": 2
    },
    {
        "id": 204,
        "raw": "[name=\"拜松\"]   有可能吗！？贫民窟是这么暴躁的地方吗？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "有可能吗！？贫民窟是这么暴躁的地方吗？"
