        "name": "char_213_mostma_1#2.png",
        "name2": "avg_npc_034#7",
        "focus": 1
    },
    {
        "id": 113,
        "raw": "[name=\"莫斯提马\"]   那该怎么热闹？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "那该怎么热闹？"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_213_mostma_1#2\",name2=\"avg_npc_034#3\",focus=2)]",
        "type": "character",
        "name": "char_213_mostma_1#2.png",
        "name2": "avg_npc_034#3",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"鼠王\"]   就该如此热闹。",
        "type": "dialog",
        "speaker": "鼠王",
        "content": "就该如此热闹。"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_213_mostma_1#2\",name2=\"avg_npc_034#3\",focus=1)]",
        "type": "character",
        "name": "char_213_mostma_1#2.png",
        "name2": "avg_npc_034#3",
        "focus": 1
    },
    {
        "id": 117,
        "raw": "[name=\"莫斯提马\"]   ——啊，原来如此。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "——啊，原来如此。"
    },
    {
        "id": 118,
        "raw": "[name=\"莫斯提马\"]   那这场安魂的花销似乎有点大，嗯，甚至有点浪费。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "那这场安魂的花销似乎有点大，嗯，甚至有点浪费。"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_213_mostma_1#2\",name2=\"avg_npc_034#3\",focus=2)]",
        "type": "character",
        "name": "char_213_mostma_1#2.png",
        "name2": "avg_npc_034#3",
        "focus": 2
    },
    {
        "id": 120,
        "raw": "[name=\"鼠王\"]   你很聪明。",
        "type": "dialog",
        "speaker": "鼠王",
        "content": "你很聪明。"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_213_mostma_1#3\",name2=\"avg_npc_034#3\",focus=1)]",
        "type": "character",
        "name": "char_213_mostma_1#3.png",
        "name2": "avg_npc_034#3",
        "focus": 1
    },
    {
        "id": 122,
        "raw": "[name=\"莫斯提马\"]   也是，否则魏长官早就来找你的麻烦了。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "也是，否则魏长官早就来找你的麻烦了。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_213_mostma_1#3\",name2=\"avg_npc_034#3\",focus=2)]",
        "type": "character",
        "name": "char_213_mostma_1#3.png",
        "name2": "avg_npc_034#3",
        "focus": 2
    },
    {
        "id": 124,
        "raw": "[name=\"鼠王\"]   别说那么吓人的事，我可不想再和近卫局打交道了，太麻烦了。",
        "type": "dialog",
        "speaker": "鼠王",
        "content": "别说那么吓人的事，我可不想再和近卫局打交道了，太麻烦了。"
