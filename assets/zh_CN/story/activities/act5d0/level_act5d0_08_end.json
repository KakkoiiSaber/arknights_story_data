        "type": "character",
        "name": "char_300_phenxi_1#3.png",
        "name2": "avg_npc_035",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"伊斯\"]   怪、怪胎……这就请当做没有看见吧。",
        "type": "dialog",
        "speaker": "伊斯",
        "content": "怪、怪胎……这就请当做没有看见吧。"
