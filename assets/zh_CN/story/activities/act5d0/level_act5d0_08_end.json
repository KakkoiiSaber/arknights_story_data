        "raw": "[Character(name=\"char_103_angel_1#7\",name2=\"char_325_bison_1#4\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_325_bison_1#4",
        "focus": 2
    },
    {
        "id": 149,
        "raw": "[name=\"拜松\"]   莫斯提马小姐说，她是我的考官……",
        "type": "dialog",
        "speaker": "拜松",
        "content": "莫斯提马小姐说，她是我的考官……"
