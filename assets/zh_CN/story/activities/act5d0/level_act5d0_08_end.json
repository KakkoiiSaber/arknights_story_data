        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 187,
        "raw": "[name=\"德克萨斯\"]   你们没事，但是莫斯提马呢？",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "你们没事，但是莫斯提马呢？"
