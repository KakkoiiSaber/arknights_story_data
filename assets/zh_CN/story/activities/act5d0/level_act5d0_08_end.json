        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 191,
        "raw": "[name=\"德克萨斯\"]   好像也是，抱歉。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "好像也是，抱歉。"
    },
    {
        "id": 192,
        "raw": "[Character(name=\"char_103_angel_1\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 193,
        "raw": "[name=\"能天使\"]   ……为什么要抱歉，还有你们看着我干嘛？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "……为什么要抱歉，还有你们看着我干嘛？"
