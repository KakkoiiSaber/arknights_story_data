        "type": "character",
        "name": "char_103_angel_1#7.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 189,
        "raw": "[name=\"能天使\"]   这个问题有什么必要吗，看不就知道了。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "这个问题有什么必要吗，看不就知道了。"
    },
    {
