        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_325_bison_1#4",
        "focus": 1
    },
    {
        "id": 151,
        "raw": "[name=\"能天使\"]   啥？我怎么从来没听说过？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "啥？我怎么从来没听说过？"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_325_bison_1#4\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
