        "type": "character",
        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"黑帮B\"]   那个叫拜松的丰蹄小子落单了，这是个大好机会。",
        "type": "dialog",
        "speaker": "黑帮B",
