        "name": "avg_npc_031.png",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"黑帮A\"]   但这里已经是市区了，我们还能动手吗？",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "但这里已经是市区了，我们还能动手吗？"
