        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"黑帮B\"]   卡彭先生都考虑过了，只要不动明火，做得隐秘一点，龙门是不会管的。",
        "type": "dialog",
        "speaker": "黑帮B",
