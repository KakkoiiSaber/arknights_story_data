        "key": "audio/sound_beta_2/avg/d_gen_walk_n.mp3"
    },
    {
        "id": 66,
        "raw": "[name=\"？？？\"]   哈哈，家族，家族呢。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "哈哈，家族，家族呢。"
    },
    {
        "id": 67,
        "raw": "[name=\"？？？\"]   真是让人怀念的说法，嗯，你们见到德克萨斯了吗？",
        "type": "dialog",
        "speaker": "？？？",
        "content": "真是让人怀念的说法，嗯，你们见到德克萨斯了吗？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_027#2\")]",
        "type": "character",
        "name": "avg_npc_027#2"
    },
    {
        "id": 69,
        "raw": "[name=\"卡彭\"]   这、这个气味......！",
        "type": "dialog",
        "speaker": "卡彭",
        "content": "这、这个气味......！"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_028#3\")]",
        "type": "character",
        "name": "avg_npc_028#3"
    },
    {
        "id": 71,
        "raw": "[name=\"甘比诺\"]   ......落单的狼。你为什么会在龙门？",
        "type": "dialog",
        "speaker": "甘比诺",
        "content": "......落单的狼。你为什么会在龙门？"
    },
