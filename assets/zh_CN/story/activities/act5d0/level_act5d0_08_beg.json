        "type": "character",
        "name": "char_103_angel_1#3",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"莫斯提马\"]   其实你想问的不是这个吧？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "其实你想问的不是这个吧？"
    },
