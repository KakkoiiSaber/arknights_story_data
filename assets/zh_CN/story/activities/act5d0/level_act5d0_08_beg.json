        "id": 86,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "id": 87,
        "raw": "[name=\"拜松\"]   莫斯提马小姐，去过所有国家吗？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "莫斯提马小姐，去过所有国家吗？"
