        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 89,
        "raw": "[name=\"莫斯提马\"]   大部分吧，羡慕吗？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "大部分吧，羡慕吗？"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 91,
        "raw": "[name=\"拜松\"]   ......有一点，一般的信使是不会有这样的机会的。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "......有一点，一般的信使是不会有这样的机会的。"
