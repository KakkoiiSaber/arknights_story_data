        "type": "character",
        "name": "char_103_angel_1#8",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"能天使\"]   这只说明我讲文明懂礼貌。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "这只说明我讲文明懂礼貌。"
