        "id": 106,
        "raw": "[Character(name=\"char_213_mostma_1#3\")]",
        "type": "character",
        "name": "char_213_mostma_1#3"
    },
    {
        "id": 107,
        "raw": "[name=\"莫斯提马\"]   哎呀，我对自己离开的时机拿捏的还是比较好的吧？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "哎呀，我对自己离开的时机拿捏的还是比较好的吧？"
