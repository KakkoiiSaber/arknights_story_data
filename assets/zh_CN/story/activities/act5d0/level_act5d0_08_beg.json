        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"能天使\"]   那个......莫斯提马。我还是有一点小问题要问啦，小小的问题。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "那个......莫斯提马。我还是有一点小问题要问啦，小小的问题。"
