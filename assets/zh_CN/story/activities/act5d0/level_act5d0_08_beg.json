        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"能天使\"]   什么？这是老友聚会互揭伤疤之类的必备项目吗？好嘞，该我了！",
        "type": "dialog",
        "speaker": "能天使",
        "content": "什么？这是老友聚会互揭伤疤之类的必备项目吗？好嘞，该我了！"
    },
