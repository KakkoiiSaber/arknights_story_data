        "name": "char_103_angel_1#7",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 109,
        "raw": "[name=\"能天使\"]   ......你认真的？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "......你认真的？"
    },
