        "id": 110,
        "raw": "[Character(name=\"char_103_angel_1#6\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#6",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 111,
        "raw": "[name=\"能天使\"]   但是对你而言只是几个小时，对我而言可是——",
        "type": "dialog",
        "speaker": "能天使",
        "content": "但是对你而言只是几个小时，对我而言可是——"
