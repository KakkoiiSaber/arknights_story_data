        "name": "char_103_angel_1#7",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"莫斯提马\"]   好孩子不该知道那么多喔。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "好孩子不该知道那么多喔。"
