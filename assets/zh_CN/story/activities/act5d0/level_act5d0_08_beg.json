        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"莫斯提马\"]   会有机会的。不过你可别指望企鹅物流哦，我们是不能用常理来判断的。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "会有机会的。不过你可别指望企鹅物流哦，我们是不能用常理来判断的。"
    },
