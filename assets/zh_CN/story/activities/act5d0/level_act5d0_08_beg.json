        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_325_bison_1#2"
    },
    {
        "id": 105,
        "raw": "[name=\"拜松&能天使\"]   又来？",
        "type": "dialog",
        "speaker": "拜松&能天使",
        "content": "又来？"
