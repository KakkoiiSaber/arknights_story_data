    },
    {
        "id": 37,
        "raw": "[name=\"能天使\"]   不是有莫斯提马在吗？问题不大吧？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "不是有莫斯提马在吗？问题不大吧？"
