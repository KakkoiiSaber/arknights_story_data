        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_201_moeshd",
        "focus": 1
    },
    {
        "id": 90,
        "raw": "[name=\"能天使\"]   本来就是我们把他忘了......",
        "type": "dialog",
        "speaker": "能天使",
        "content": "本来就是我们把他忘了......"
