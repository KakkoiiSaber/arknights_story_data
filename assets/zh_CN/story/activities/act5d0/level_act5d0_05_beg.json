        "type": "character",
        "name": "char_103_angel_1#7",
        "name2": "char_201_moeshd#5",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"可颂\"]   倒、倒也是。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "倒、倒也是。"
    },
    {
        "id": 93,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 94,
        "raw": "[name=\"德克萨斯\"]   你想怎样？",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "你想怎样？"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"avg_npc_028#4\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "avg_npc_028#4",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 96,
        "raw": "[name=\"甘比诺\"]   哼......你们东躲西藏的，实在让人厌烦。动静闹太大，对大家都不好，不是吗？",
