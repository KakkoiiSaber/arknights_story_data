        "type": "character",
        "name": "char_105_emper",
        "name2": "char_201_moeshd",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"可颂\"]   十猜十中哎，不愧是自称龙门第一的品酒师！",
        "type": "dialog",
        "speaker": "可颂",
        "content": "十猜十中哎，不愧是自称龙门第一的品酒师！"
