        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 22,
        "raw": "[name=\"大帝\"]   呸，说了多少遍了，这是储备武器，不是用来喝的！空！",
        "type": "dialog",
        "speaker": "大帝",
        "content": "呸，说了多少遍了，这是储备武器，不是用来喝的！空！"
