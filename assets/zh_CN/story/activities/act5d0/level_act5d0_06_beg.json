    {
        "id": 200,
        "raw": "[Character(name=\"char_201_moeshd#5\")]",
        "type": "character",
        "name": "char_201_moeshd#5"
    },
    {
        "id": 201,
        "raw": "[name=\"可颂\"]   唔啊，这下店里可全毁了。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "唔啊，这下店里可全毁了。"
    },
    {
        "id": 202,
        "raw": "[Character(name=\"char_325_bison_1#4\")]",
        "type": "character",
        "name": "char_325_bison_1#4"
    },
    {
        "id": 203,
        "raw": "[name=\"拜松\"]   大帝先生好像还在外面，没关系吗！？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "大帝先生好像还在外面，没关系吗！？"
    },
    {
        "id": 204,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
    {
        "id": 205,
        "raw": "[name=\"大帝\"]   这些人怎么就这么死缠烂打，在店铺被轰干净之前还击啊！",
        "type": "dialog",
        "speaker": "大帝",
        "content": "这些人怎么就这么死缠烂打，在店铺被轰干净之前还击啊！"
    },
    {
        "id": 206,
        "raw": "[Character(name=\"char_105_emper\",name2=\"char_103_angel_1#7\",focus=2)]",
        "type": "character",
        "name": "char_105_emper",
        "name2": "char_103_angel_1#7",
        "focus": 2
    },
    {
        "id": 207,
        "raw": "[name=\"能天使\"]   抱歉，老板，我的橡皮弹好像用完了，不如咱们抄凳子上？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "抱歉，老板，我的橡皮弹好像用完了，不如咱们抄凳子上？"
    },
    {
        "id": 208,
        "raw": "[Character(name=\"char_105_emper\",name2=\"char_103_angel_1#7\",focus=1)]",
        "type": "character",
        "name": "char_105_emper",
        "name2": "char_103_angel_1#7",
        "focus": 1
    },
    {
        "id": 209,
        "raw": "[name=\"大帝\"]   不是专门买了一批便宜酒放在这儿当武器的吗！?",
        "type": "dialog",
        "speaker": "大帝",
        "content": "不是专门买了一批便宜酒放在这儿当武器的吗！?"
    },
    {
        "id": 210,
        "raw": "[Character(name=\"char_201_moeshd#5\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_201_moeshd#5",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 211,
        "raw": "[name=\"可颂\"]   欸、刚才喝的是最后一瓶了，剩下的都是值钱货哎。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "欸、刚才喝的是最后一瓶了，剩下的都是值钱货哎。"
    },
    {
        "id": 212,
        "raw": "[Character(name=\"char_201_moeshd#5\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_201_moeshd#5",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 213,
        "raw": "[name=\"大帝\"]   不管了，只有迂腐的老东西才会把美酒储存在自己的宫殿里。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "不管了，只有迂腐的老东西才会把美酒储存在自己的宫殿里。"
    },
    {
        "id": 214,
        "raw": "[name=\"大帝\"]   我们应该让这些美妙的酿造物绽放，无论是价值层面，还是物理层面。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "我们应该让这些美妙的酿造物绽放，无论是价值层面，还是物理层面。"
    },
    {
        "id": 215,
        "raw": "[Character(name=\"char_201_moeshd#5\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_201_moeshd#5",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 216,
        "raw": "[name=\"可颂\"]   呃？但是那些藏酒的价格可非常——",
        "type": "dialog",
        "speaker": "可颂",
        "content": "呃？但是那些藏酒的价格可非常——"
    },
    {
        "id": 217,
        "raw": "[Character(name=\"char_201_moeshd#5\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_201_moeshd#5",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 218,
        "raw": "[name=\"大帝\"]   拿着，人手一瓶，记住，只砸头。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "拿着，人手一瓶，记住，只砸头。"
    },
    {
        "id": 219,
        "raw": "[name=\"大帝\"]   保护了我的酒吧，就是保护了这片大地，上吧。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "保护了我的酒吧，就是保护了这片大地，上吧。"
    },
    {
        "id": 220,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_103_angel_1#3\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1#3",
        "focus": 1
    },
    {
        "id": 221,
        "raw": "[name=\"德克萨斯\"]   能天使。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "能天使。"
    },
    {
        "id": 222,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_103_angel_1#8\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1#8",
        "focus": 2
    },
    {
        "id": 223,
        "raw": "[name=\"能天使\"]   好嘞！抄瓶子砸人是吧，我擅长的。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "好嘞！抄瓶子砸人是吧，我擅长的。"
