    },
    {
        "id": 73,
        "raw": "[name=\"德克萨斯\"]   让他跑了。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "让他跑了。"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper"
    },
