        "raw": "[Character(name=\"char_201_moeshd\",name2=\"char_102_texas_1\",focus=1)]",
        "type": "character",
        "name": "char_201_moeshd",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 109,
        "raw": "[name=\"可颂\"]   看到新口味就进货了，没注意，诶嘿。",
        "type": "dialog",
        "speaker": "可颂",
