        "name": "avg_npc_028#3.png",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "id": 139,
        "raw": "[name=\"甘比诺\"]   哈！你怕了？",
        "type": "dialog",
        "speaker": "甘比诺",
        "content": "哈！你怕了？"
    },
    {
        "id": 140,
        "raw": "[Character(name=\"avg_npc_028#3\",name2=\"avg_npc_027#2\",focus=2)]",
