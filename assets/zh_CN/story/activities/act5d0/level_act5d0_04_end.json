        "name": "avg_npc_028#3.png",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "id": 146,
        "raw": "[name=\"卡彭\"]   我们都有各自的事情要做，嘲讽的话一会再说。",
        "type": "dialog",
        "speaker": "卡彭",
        "content": "我们都有各自的事情要做，嘲讽的话一会再说。"
    },
    {
        "id": 147,
