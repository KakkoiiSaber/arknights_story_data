        "type": "character",
        "name": "avg_npc_028.png",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "id": 148,
        "raw": "[name=\"甘比诺\"]   你说的没错。我要用我自己的手段和企鹅物流分个胜负。",
        "type": "dialog",
        "speaker": "甘比诺",
        "content": "你说的没错。我要用我自己的手段和企鹅物流分个胜负。"
    },
    {
        "id": 149,
        "raw": "[name=\"甘比诺\"]   能靠死人解决的问题，就不要让活人互相扯皮，对吧？",
        "type": "dialog",
        "speaker": "甘比诺",
        "content": "能靠死人解决的问题，就不要让活人互相扯皮，对吧？"
    },
