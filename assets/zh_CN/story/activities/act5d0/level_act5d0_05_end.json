        "id": 10,
        "raw": "龙门贫民窟",
        "type": "narration",
        "content": "龙门贫民窟"
    },
    {
        "id": 11,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 12,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 13,
        "raw": "[name=\"黑帮A\"]   啧！想活命就告诉我们，鼠王到底在哪儿！？",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "啧！想活命就告诉我们，鼠王到底在哪儿！？"
    },
    {
        "id": 14,
        "raw": "[name=\"贫民窟居民\"]   我、我不知道啊！什么鼠王......真的没听说过啊！",
        "type": "dialog",
        "speaker": "贫民窟居民",
        "content": "我、我不知道啊！什么鼠王......真的没听说过啊！"
    },
    {
        "id": 15,
        "raw": "[name=\"黑帮A\"]   敬酒不吃吃罚酒——！",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "敬酒不吃吃罚酒——！"
    },
    {
        "id": 16,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 17,
        "raw": "[name=\"黑帮B\"]   喂，卡彭先生说过不要随便对平民动手......",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "喂，卡彭先生说过不要随便对平民动手......"
    },
    {
        "id": 18,
        "raw": "[name=\"黑帮A\"]   这种下三滥的货色能算市民吗？遮遮掩掩的，说不定就是个感染者垃圾！还敢装糊涂！？",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "这种下三滥的货色能算市民吗？遮遮掩掩的，说不定就是个感染者垃圾！还敢装糊涂！？"
    },
    {
        "id": 19,
        "raw": "[name=\"贫民窟居民\"]   等、等等！别打了！我真的不知道啊！！",
        "type": "dialog",
        "speaker": "贫民窟居民",
        "content": "等、等等！别打了！我真的不知道啊！！"
    },
    {
        "id": 20,
        "raw": "[name=\"黑帮A\"]   嘴硬！？",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "嘴硬！？"
    },
    {
        "id": 21,
        "raw": "[name=\"贫民窟居民\"]   唔——呃，呕——",
        "type": "dialog",
        "speaker": "贫民窟居民",
        "content": "唔——呃，呕——"
    },
    {
        "id": 22,
        "raw": "[name=\"黑帮B\"]   走吧，别管这家伙了，恶心。",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "走吧，别管这家伙了，恶心。"
    },
    {
        "id": 23,
        "raw": "[name=\"黑帮B\"]   看名单，下一个老东西似乎就住在这里不远，是个卖鱼丸的，就在生鲜卖场对面。",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "看名单，下一个老东西似乎就住在这里不远，是个卖鱼丸的，就在生鲜卖场对面。"
    },
    {
        "id": 24,
        "raw": "[name=\"黑帮A\"]   嘁，浪费时间。",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "嘁，浪费时间。"
    },
    {
        "id": 25,
        "raw": "[name=\"贫民窟居民\"]   咕，哈啊——骨头都断了，这帮——该死的——下手真重，嘎哈！",
        "type": "dialog",
        "speaker": "贫民窟居民",
        "content": "咕，哈啊——骨头都断了，这帮——该死的——下手真重，嘎哈！"
    },
    {
        "id": 26,
        "raw": "[name=\"贫民窟居民\"]   必须得......告诉他们......",
        "type": "dialog",
        "speaker": "贫民窟居民",
        "content": "必须得......告诉他们......"
    },
