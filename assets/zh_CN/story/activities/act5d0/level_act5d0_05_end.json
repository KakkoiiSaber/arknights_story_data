        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"槐琥\"]   ——你们刚才说了，“垃圾”，对吧？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "——你们刚才说了，“垃圾”，对吧？"
    },
    {
        "id": 67,
        "raw": "[name=\"槐琥\"]   以防万一我多问一句，你是指这里的居民吗？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "以防万一我多问一句，你是指这里的居民吗？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#3",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"黑帮A\"]   我没那么多时间陪你废话，赶紧——",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "我没那么多时间陪你废话，赶紧——"
    },
