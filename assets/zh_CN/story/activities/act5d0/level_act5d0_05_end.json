        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 114,
        "raw": "[name=\"孑\"]   ......算了，我不该学槐琥咬文嚼字的，还是直接点好。",
        "type": "dialog",
        "speaker": "孑",
        "content": "......算了，我不该学槐琥咬文嚼字的，还是直接点好。"
