        "name": "char_272_strong_1",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 110,
        "raw": "[name=\"孑\"]   唉，你这种人，属于冰箱断电馊了三天的海胆，差不多那个感觉吧。",
        "type": "dialog",
        "speaker": "孑",
        "content": "唉，你这种人，属于冰箱断电馊了三天的海胆，差不多那个感觉吧。"
