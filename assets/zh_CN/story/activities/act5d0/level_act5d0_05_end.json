    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_243_waaifu_1#2\")]",
        "type": "character",
        "name": "char_243_waaifu_1#2"
    },
    {
        "id": 41,
        "raw": "[name=\"槐琥\"]   ......你们有什么事吗？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "......你们有什么事吗？"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"黑帮B\"]   （等等，注意旁边那个男的，我总觉得不是什么善茬。）",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "（等等，注意旁边那个男的，我总觉得不是什么善茬。）"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 45,
        "raw": "[name=\"黑帮A\"]   （龙门当地的帮派？不用担心，按照卡彭先生的报告，都是小角色。）",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "（龙门当地的帮派？不用担心，按照卡彭先生的报告，都是小角色。）"
    },
    {
        "id": 46,
        "raw": "[name=\"黑帮A\"]   我有点事情要问。",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "我有点事情要问。"
    },
    {
        "id": 47,
        "raw": "[name=\"黑帮A\"]   谁也不想惹上麻烦，对吧？乖乖回答我们，我们就走。",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "谁也不想惹上麻烦，对吧？乖乖回答我们，我们就走。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "avg_npc_031",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"孑\"]   ......你的拳头上有血。",
        "type": "dialog",
        "speaker": "孑",
        "content": "......你的拳头上有血。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"avg_npc_031\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "avg_npc_031",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"黑帮A\"]   不好意思，只是些不配合的垃圾。",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "不好意思，只是些不配合的垃圾。"
    },
    {
        "id": 52,
        "raw": "[name=\"黑帮A\"]   但是像你们这样的好市民，当然会配合我们的吧？",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "但是像你们这样的好市民，当然会配合我们的吧？"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#2",
        "focus": 2
    },
    {
        "id": 54,
        "raw": "[name=\"槐琥\"]   这是威胁？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "这是威胁？"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#2",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"黑帮A\"]   大家心里清楚。",
        "type": "dialog",
        "speaker": "黑帮A",
        "content": "大家心里清楚。"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"槐琥\"]   那我拒绝。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "那我拒绝。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_031\",name2=\"char_243_waaifu_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_031",
        "name2": "char_243_waaifu_1#3",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"黑帮B\"]   ......拒绝？",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "......拒绝？"
    },
    {
        "id": 61,
        "raw": "[name=\"黑帮B\"]   小姑娘，你好像弄错了什么。",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "小姑娘，你好像弄错了什么。"
    },
    {
        "id": 62,
        "raw": "[name=\"黑帮B\"]   还是说，你也想变成那边巷子里的垃圾，被打得半死不活？",
        "type": "dialog",
        "speaker": "黑帮B",
        "content": "还是说，你也想变成那边巷子里的垃圾，被打得半死不活？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_272_strong_1\")]",
        "type": "character",
        "name": "char_272_strong_1"
    },
    {
        "id": 64,
        "raw": "[name=\"孑\"]   槐琥，我刚才听到的惨叫声......",
        "type": "dialog",
        "speaker": "孑",
        "content": "槐琥，我刚才听到的惨叫声......"
