        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"槐琥\"]   突然干嘛，我可没带多余的零钱。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "突然干嘛，我可没带多余的零钱。"
    },
    {
        "id": 51,
