        "name": "char_272_strong_1.png",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 58,
        "raw": "[name=\"孑\"]   干嘛总是要挑我刺，我会自掏腰包的......",
        "type": "dialog",
        "speaker": "孑",
        "content": "干嘛总是要挑我刺，我会自掏腰包的......"
