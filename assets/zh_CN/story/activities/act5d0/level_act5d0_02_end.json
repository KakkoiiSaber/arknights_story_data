        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"孑\"]   就当是慰问品收下吧，毕竟你们总是照顾我生意。",
        "type": "dialog",
        "speaker": "孑",
        "content": "就当是慰问品收下吧，毕竟你们总是照顾我生意。"
    },
    {
