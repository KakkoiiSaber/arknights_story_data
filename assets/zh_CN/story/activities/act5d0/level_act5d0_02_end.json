        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"槐琥\"]   算是吧。事务所那边说上次在你这儿赊了账，多少来着？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "算是吧。事务所那边说上次在你这儿赊了账，多少来着？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1.png",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"孑\"]   三十二块六，零头抹了吧。要尝尝吗？",
        "type": "dialog",
        "speaker": "孑",
        "content": "三十二块六，零头抹了吧。要尝尝吗？"
    },
