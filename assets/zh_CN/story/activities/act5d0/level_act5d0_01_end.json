    {
        "id": 14,
        "raw": "[Character(name=\"char_325_bison_1\")]",
        "type": "character",
        "name": "char_325_bison_1.png"
    },
    {
        "id": 15,
        "raw": "[name=\"拜松\"]   这里就是企鹅物流的据点......",
        "type": "dialog",
        "speaker": "拜松",
        "content": "这里就是企鹅物流的据点......"
    },
    {
        "id": 16,
        "raw": "[name=\"拜松\"]   （好乱，而且好暗。）",
        "type": "dialog",
        "speaker": "拜松",
        "content": "（好乱，而且好暗。）"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_325_bison_1#2\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_325_bison_1#2",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"德克萨斯\"]   只是我们的据点之一，没怎么好好收拾，随意坐吧。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "只是我们的据点之一，没怎么好好收拾，随意坐吧。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_325_bison_1\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_325_bison_1",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"拜松\"]   啊，谢谢......我好像还没有正式向你们道谢，企鹅物流的各位。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "啊，谢谢......我好像还没有正式向你们道谢，企鹅物流的各位。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_325_bison_1\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_325_bison_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"德克萨斯\"]   只是工作，先做个自我介绍好了。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "只是工作，先做个自我介绍好了。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_325_bison_1#3\")]",
        "type": "character",
        "name": "char_325_bison_1#3.png"
    },
    {
        "id": 24,
        "raw": "[name=\"拜松\"]   ——信使，代号拜松，来自龙门峯驰物流，受家父指教，前来贵司参观学习，请多关照。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "——信使，代号拜松，来自龙门峯驰物流，受家父指教，前来贵司参观学习，请多关照。"
    },
    {
        "id": 25,
        "raw": "[name=\"拜松\"]   关于我与大帝先生的合同内容，虽然之前已经确认过了，但还是......",
        "type": "dialog",
        "speaker": "拜松",
        "content": "关于我与大帝先生的合同内容，虽然之前已经确认过了，但还是......"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 27,
        "raw": "[name=\"大帝\"]   慢着，我有个小问题，你那五大三粗的爹是怎么把你养得这么——",
        "type": "dialog",
        "speaker": "大帝",
        "content": "慢着，我有个小问题，你那五大三粗的爹是怎么把你养得这么——"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_102_texas_1#2\")]",
        "type": "character",
        "name": "char_102_texas_1#2.png"
    },
    {
        "id": 29,
        "raw": "[name=\"德克萨斯\"]   ......老板。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "......老板。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 31,
        "raw": "[name=\"大帝\"]   好，好，你继续。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "好，好，你继续。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_325_bison_1#4\")]",
        "type": "character",
        "name": "char_325_bison_1#4.png"
    },
    {
        "id": 33,
        "raw": "[name=\"拜松\"]   咳，关于刚才的袭击，无疑是对峯驰物流和企鹅物流的挑衅。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "咳，关于刚才的袭击，无疑是对峯驰物流和企鹅物流的挑衅。"
    },
    {
        "id": 34,
        "raw": "[name=\"拜松\"]   这件事情绝不能轻视，如果有必要的话，我会通知家父和近卫局，此事应当被视作一起恶性袭击——",
        "type": "dialog",
        "speaker": "拜松",
        "content": "这件事情绝不能轻视，如果有必要的话，我会通知家父和近卫局，此事应当被视作一起恶性袭击——"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"大帝\"]   喂，德克萨斯。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "喂，德克萨斯。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"德克萨斯\"]   嗯？",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "嗯？"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"大帝\"]   晚上吃什么？",
        "type": "dialog",
        "speaker": "大帝",
        "content": "晚上吃什么？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_103_angel_1#8\")]",
        "type": "character",
        "name": "char_103_angel_1#8.png"
    },
    {
        "id": 42,
        "raw": "[name=\"能天使\"]   欢迎派对！还用问吗？但是空去哪儿了，不是留下看家了吗？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "欢迎派对！还用问吗？但是空去哪儿了，不是留下看家了吗？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_201_moeshd#3\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_201_moeshd#3",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"可颂\"]   反正只要德克萨斯联系她的话，她立刻就能赶回来吧。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "反正只要德克萨斯联系她的话，她立刻就能赶回来吧。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_201_moeshd\")]",
        "type": "character",
        "name": "char_201_moeshd.png"
    },
    {
        "id": 46,
        "raw": "[name=\"可颂\"]   啊，抱歉，你接着说。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "啊，抱歉，你接着说。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 48,
        "raw": "[name=\"拜松\"]   （空？）",
        "type": "dialog",
        "speaker": "拜松",
        "content": "（空？）"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_325_bison_1#4\")]",
        "type": "character",
        "name": "char_325_bison_1#4.png"
    },
    {
        "id": 50,
        "raw": "[name=\"拜松\"]   ......咳，当务之急是调查那些袭击我们的敌人，企鹅物流的各位有什么头绪吗？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "......咳，当务之急是调查那些袭击我们的敌人，企鹅物流的各位有什么头绪吗？"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_103_angel_1#7\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#4.png",
        "name2": "char_103_angel_1#7",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"能天使\"]   头绪？不就是普通的业务纠纷吗？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "头绪？不就是普通的业务纠纷吗？"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_103_angel_1#7\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_103_angel_1#7",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"拜松\"]   呃，业务纠纷......？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "呃，业务纠纷......？"
    },
    {
        "id": 55,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 57,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 58,
        "raw": "[name=\"大帝\"]   德克萨斯！我抽屉里的雪茄呢！？",
        "type": "dialog",
        "speaker": "大帝",
        "content": "德克萨斯！我抽屉里的雪茄呢！？"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_103_angel_1#8\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#8.png",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"能天使\"]   老板，我们已经好久没回过这个据点了，恐怕早就发霉了。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "老板，我们已经好久没回过这个据点了，恐怕早就发霉了。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_102_texas_1\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_102_texas_1.png",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"德克萨斯\"]   空来打扫过，可能那时候扔掉了吧。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "空来打扫过，可能那时候扔掉了吧。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 64,
        "raw": "[name=\"大帝\"]   啊，那我今天晚上会死的，不行，这可不行......",
        "type": "dialog",
        "speaker": "大帝",
        "content": "啊，那我今天晚上会死的，不行，这可不行......"
    },
    {
        "id": 65,
        "raw": "[name=\"大帝\"]   啊，你继续，别在意。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "啊，你继续，别在意。"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_325_bison_1#4\")]",
        "type": "character",
        "name": "char_325_bison_1#4.png"
    },
    {
        "id": 67,
        "raw": "[name=\"拜松\"]   首先我们应该明确敌人的目的——",
        "type": "dialog",
        "speaker": "拜松",
        "content": "首先我们应该明确敌人的目的——"
    },
    {
        "id": 68,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 70,
        "raw": "[CameraShake(duration=1, xstrength=10, ystrength=12, vibrato=30, randomness=90, fadeout=true)]",
        "type": "camera_shake",
        "duration": "1,",
        "xstrength": "10,",
        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": true
    },
    {
        "id": 71,
        "raw": "[name=\"大帝\"]   慢着，音乐！我的黑胶唱片！是不是放了一箱在这里？",
        "type": "dialog",
        "speaker": "大帝",
        "content": "慢着，音乐！我的黑胶唱片！是不是放了一箱在这里？"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_201_moeshd#4\")]",
        "type": "character",
        "name": "char_201_moeshd#4.png"
    },
    {
        "id": 73,
        "raw": "[name=\"可颂\"]   啊，好像是我搬来的。那一箱得有我好几个月薪水。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "啊，好像是我搬来的。那一箱得有我好几个月薪水。"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"能天使\"]   在这儿，要听哪张？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "在这儿，要听哪张？"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_103_angel_1#3\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_103_angel_1#3.png",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"大帝\"]   随便哪张都行，被我选中的只会是宇宙末日级精品。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "随便哪张都行，被我选中的只会是宇宙末日级精品。"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"char_105_emper\")]",
        "type": "character",
        "name": "char_105_emper.png"
    },
    {
        "id": 79,
        "raw": "[name=\"大帝\"]   啊，音乐，有了艺术的人生才不会无聊，赞美音乐，以及我自己！",
        "type": "dialog",
        "speaker": "大帝",
        "content": "啊，音乐，有了艺术的人生才不会无聊，赞美音乐，以及我自己！"
    },
    {
        "id": 80,
        "raw": "[name=\"大帝\"]   拜松，接着说。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "拜松，接着说。"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_325_bison_1#2\")]",
        "type": "character",
        "name": "char_325_bison_1#2.png"
    },
    {
        "id": 82,
        "raw": "[name=\"拜松\"]   ......我、我说到哪了？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "......我、我说到哪了？"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_105_emper\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2.png",
        "name2": "char_105_emper",
        "focus": 2
    },
    {
        "id": 84,
        "raw": "[name=\"大帝\"]   他们的目的。",
        "type": "dialog",
        "speaker": "大帝",
        "content": "他们的目的。"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_105_emper\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1#4.png",
        "name2": "char_105_emper",
        "focus": 1
    },
    {
        "id": 86,
        "raw": "[name=\"拜松\"]   对！他们的目的应该是我，也许，是为了挑拨贵司与我司的关系。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "对！他们的目的应该是我，也许，是为了挑拨贵司与我司的关系。"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_325_bison_1#4\",name2=\"char_105_emper\",focus=2)]",
