        "focus": 1
    },
    {
        "id": 104,
        "raw": "[name=\"拜松\"]   莫斯提马小姐？",
        "type": "dialog",
        "speaker": "拜松",
        "content": "莫斯提马小姐？"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_325_bison_1#2\",name2=\"char_213_mostma_1#4\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1#2",
        "name2": "char_213_mostma_1#4",
        "focus": 2
    },
    {
        "id": 106,
        "raw": "[name=\"莫斯提马\"]   看见那家糖果店了吗？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "看见那家糖果店了吗？"
    },
    {
        "id": 107,
