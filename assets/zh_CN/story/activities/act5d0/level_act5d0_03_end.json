        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 116,
        "raw": "[name=\"莫斯提马\"]   只是单纯的长途跋涉，路上遇到了一点小麻烦。信使都是这样吧。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "只是单纯的长途跋涉，路上遇到了一点小麻烦。信使都是这样吧。"
    },
    {
        "id": 117,
        "raw": "[name=\"莫斯提马\"]   走，我们去看看。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "走，我们去看看。"
    },
