    {
        "id": 185,
        "raw": "[name=\"莫斯提马\"]   狂欢吗，号称是龙门这么多年来最盛大的一次节日活动呢。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "狂欢吗，号称是龙门这么多年来最盛大的一次节日活动呢。"
    },
    {
        "id": 186,
        "raw": "[name=\"莫斯提马\"]   ......拜松？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "......拜松？"
    },
    {
        "id": 187,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 188,
        "raw": "[name=\"拜松\"]   对不起，我在想事情......",
        "type": "dialog",
        "speaker": "拜松",
        "content": "对不起，我在想事情......"
    },
    {
        "id": 189,
