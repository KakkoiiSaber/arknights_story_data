        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1#3\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1#3",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"莫斯提马\"]   什么话，这可是五星推荐，比黑手党厉害多了吧？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "什么话，这可是五星推荐，比黑手党厉害多了吧？"
    },
    {
        "id": 68,
        "raw": "[name=\"莫斯提马\"]   你能联系得到德克萨斯他们吗？",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "你能联系得到德克萨斯他们吗？"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1#3\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1#3",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"拜松\"]   不能，事出突然......",
        "type": "dialog",
        "speaker": "拜松",
        "content": "不能，事出突然......"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1\",focus=2)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
