        "fadeout": true
    },
    {
        "id": 21,
        "raw": "[name=\"槐琥\"]   休想得逞！",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "休想得逞！"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"孑\"]   是我，是我啊，放手！",
        "type": "dialog",
        "speaker": "孑",
        "content": "是我，是我啊，放手！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#2\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#2",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"槐琥\"]   什么嘛，你怎么在这里。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "什么嘛，你怎么在这里。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#2\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#2",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"孑\"]   ......收摊回家的路上。",
        "type": "dialog",
        "speaker": "孑",
        "content": "......收摊回家的路上。"
    },
    {
        "id": 28,
        "raw": "[name=\"孑\"]   倒是你在这里发呆——不对，立刻就能反手擒拿好像也不算在发呆......",
        "type": "dialog",
        "speaker": "孑",
        "content": "倒是你在这里发呆——不对，立刻就能反手擒拿好像也不算在发呆......"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"槐琥\"]   你听说刚才在立交桥上发生的车祸了吗？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "你听说刚才在立交桥上发生的车祸了吗？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"孑\"]   ......你不是应该在复习功课吗？",
        "type": "dialog",
        "speaker": "孑",
        "content": "......你不是应该在复习功课吗？"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"槐琥\"]   劳逸结合，不然明天拿到试卷的时候脑袋一白就完蛋了。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "劳逸结合，不然明天拿到试卷的时候脑袋一白就完蛋了。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"孑\"]   欸，好吧。",
        "type": "dialog",
        "speaker": "孑",
        "content": "欸，好吧。"
    },
    {
        "id": 37,
        "raw": "[name=\"孑\"]   刚才好像听客人提到过，但愿没有伤亡。",
        "type": "dialog",
        "speaker": "孑",
        "content": "刚才好像听客人提到过，但愿没有伤亡。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"槐琥\"]   嗯......但我在事务所听说，这事儿和一群不干不净的家伙有关系......",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "嗯......但我在事务所听说，这事儿和一群不干不净的家伙有关系......"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"孑\"]   先说好，我绝对和什么杀手、帮派之类的没有关系，你知道的对吧？",
        "type": "dialog",
        "speaker": "孑",
        "content": "先说好，我绝对和什么杀手、帮派之类的没有关系，你知道的对吧？"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"槐琥\"]   你的事情大家早就清楚了——不如说你总是这幅态度，不被怀疑才奇怪吧？",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "你的事情大家早就清楚了——不如说你总是这幅态度，不被怀疑才奇怪吧？"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1",
        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"孑\"]   ......是喔，难怪。",
        "type": "dialog",
        "speaker": "孑",
        "content": "......是喔，难怪。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"槐琥\"]   而且两个小时前还在龙门边郊的高速公路上发生了一起瓦斯爆炸。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "而且两个小时前还在龙门边郊的高速公路上发生了一起瓦斯爆炸。"
    },
    {
        "id": 48,
        "raw": "[name=\"槐琥\"]   高速公路上，瓦斯爆炸？这个理由也太滥用了点。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "高速公路上，瓦斯爆炸？这个理由也太滥用了点。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"孑\"]   呃。你该不会想......",
        "type": "dialog",
        "speaker": "孑",
        "content": "呃。你该不会想......"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=2)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"槐琥\"]   我说了嘛，劳逸结合。",
        "type": "dialog",
        "speaker": "槐琥",
        "content": "我说了嘛，劳逸结合。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_272_strong_1\",name2=\"char_243_waaifu_1#4\",focus=1)]",
        "type": "character",
        "name": "char_272_strong_1",
        "name2": "char_243_waaifu_1#4",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"孑\"]   ......哈，就知道。",
        "type": "dialog",
        "speaker": "孑",
        "content": "......哈，就知道。"
    },
    {
        "id": 55,
        "raw": "[name=\"孑\"]   但这算劳还是逸？",
        "type": "dialog",
        "speaker": "孑",
        "content": "但这算劳还是逸？"
    },
