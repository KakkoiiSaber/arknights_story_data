        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1#4",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"拜松\"]   与其说店，更像一个摊铺。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "与其说店，更像一个摊铺。"
