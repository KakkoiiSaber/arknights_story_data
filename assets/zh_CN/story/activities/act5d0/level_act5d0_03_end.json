        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 2
    },
    {
        "id": 86,
        "raw": "[name=\"莫斯提马\"]   呵呵，比起德克萨斯他们，你倒是更像个普通的信使。",
        "type": "dialog",
        "speaker": "莫斯提马",
        "content": "呵呵，比起德克萨斯他们，你倒是更像个普通的信使。"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"char_325_bison_1\",name2=\"char_213_mostma_1\",focus=1)]",
        "type": "character",
        "name": "char_325_bison_1",
        "name2": "char_213_mostma_1",
        "focus": 1
    },
    {
        "id": 88,
        "raw": "[name=\"拜松\"]   啊，抱歉，突然就开始自说自话。",
        "type": "dialog",
        "speaker": "拜松",
        "content": "啊，抱歉，突然就开始自说自话。"
