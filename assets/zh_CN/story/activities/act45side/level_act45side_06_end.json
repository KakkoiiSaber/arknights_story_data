    {
        "id": 202,
        "raw": "逃吧。",
        "type": "narration",
        "content": "逃吧。"
    },
    {
        "id": 203,
        "raw": "一切都是虚假的，一切都不过是莫菲丝创造的梦境。",
        "type": "narration",
        "content": "一切都是虚假的，一切都不过是莫菲丝创造的梦境。"
    },
    {
        "id": 204,
        "raw": "她不是真正的妈妈。",
        "type": "narration",
        "content": "她不是真正的妈妈。"
    },
    {
        "id": 205,
        "raw": "莫菲丝怎么可能了解她的一切？",
        "type": "narration",
        "content": "莫菲丝怎么可能了解她的一切？"
    },
    {
        "id": 206,
        "raw": "她是低劣的伪造品。",
        "type": "narration",
        "content": "她是低劣的伪造品。"
    },
    {
        "id": 207,
        "raw": "可是。",
        "type": "narration",
        "content": "可是。"
    },
    {
        "id": 208,
        "raw": "可是——",
        "type": "narration",
        "content": "可是——"
    },
    {
        "id": 209,
        "raw": "脚步根本没有停下的意思，甚至越来越快。",
        "type": "narration",
        "content": "脚步根本没有停下的意思，甚至越来越快。"
    },
