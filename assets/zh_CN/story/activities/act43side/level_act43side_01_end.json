    {
        "id": 41,
        "raw": "[name=\"格蕾塔\"]按规矩抬价太浪费时间，我只是报出了我心中它值得的价格。",
        "type": "dialog",
        "speaker": "格蕾塔",
        "content": "按规矩抬价太浪费时间，我只是报出了我心中它值得的价格。"
    },
    {
        "id": 42,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1257_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
