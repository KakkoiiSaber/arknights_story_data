        "raw": "[charslot(slot = \"left\",focus=\"l\", name = \"avg_npc_1843_1#4$1\")]",
        "type": "charslot",
        "focus": "l"
    },
    {
        "id": 54,
        "raw": "[name=\"阿布纳\"]你该去当娱乐记者，而不是摄影助理。",
        "type": "dialog",
