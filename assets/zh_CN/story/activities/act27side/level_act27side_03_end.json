    },
    {
        "id": 144,
        "raw": "[name=\"温和的生物\"]怎么了，你在想什么呢？",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "怎么了，你在想什么呢？"
    },
    {
        "id": 145,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#7$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#7$2.png"
    },
    {
        "id": 146,
        "raw": "[name=\"阿黛尔\"]呃……不好意思，我……",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "呃……不好意思，我……"
    },
    {
        "id": 147,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#2$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#2$2.png"
    },
    {
        "id": 148,
        "raw": "[name=\"阿黛尔\"]小黑羊……你是多利先生吗？",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "小黑羊……你是多利先生吗？"
    },
    {
        "id": 149,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 150,
        "raw": "[name=\"温和的生物\"]我是多利，我也不是多利。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "我是多利，我也不是多利。"
    },
    {
        "id": 151,
        "raw": "[name=\"温和的生物\"]我是谁，取决于我在你心中的样子。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "我是谁，取决于我在你心中的样子。"
    },
    {
        "id": 152,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#9$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#9$2.png"
    },
    {
        "id": 153,
        "raw": "[name=\"阿黛尔\"]你和多利先生，有些不一样。",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "你和多利先生，有些不一样。"
    },
    {
        "id": 154,
        "raw": "[name=\"阿黛尔\"]那这些……都是小黑羊吗？",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "那这些……都是小黑羊吗？"
    },
    {
        "id": 155,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 156,
        "raw": "[name=\"温和的生物\"]不不，不能说“都是”。他们每只都是独一无二的，与这世界的联系也是独一无二的。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "不不，不能说“都是”。他们每只都是独一无二的，与这世界的联系也是独一无二的。"
    },
    {
        "id": 157,
        "raw": "[name=\"温和的生物\"]就像我们称呼你们，也不会说这些都是“阿黛尔”。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "就像我们称呼你们，也不会说这些都是“阿黛尔”。"
    },
    {
        "id": 158,
        "raw": "[name=\"温和的生物\"]每一个“阿黛尔”，都是独一无二的。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "每一个“阿黛尔”，都是独一无二的。"
    },
    {
        "id": 159,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#2$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#2$2.png"
    },
    {
        "id": 160,
        "raw": "[name=\"阿黛尔\"]好吧。",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "好吧。"
    },
    {
        "id": 161,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#11$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#11$2.png"
    },
    {
        "id": 162,
        "raw": "[name=\"阿黛尔\"]那你们为什么要邀请我来这里呢？",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "那你们为什么要邀请我来这里呢？"
    },
    {
        "id": 163,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 164,
        "raw": "[name=\"温和的生物\"]因为北风。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "因为北风。"
    },
    {
        "id": 165,
        "raw": "[name=\"温和的生物\"]因为收获的快乐，我们要分享。能参与这个派对的每个成员都是被选择过的。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "因为收获的快乐，我们要分享。能参与这个派对的每个成员都是被选择过的。"
    },
    {
        "id": 166,
        "raw": "[name=\"温和的生物\"]包括你，我的阿黛尔。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "包括你，我的阿黛尔。"
    },
    {
        "id": 167,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#3$2\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_1016_agoat2_1#3$2.png"
    },
    {
        "id": 168,
        "raw": "[name=\"阿黛尔\"]……这几天经历的事情，有些太奇妙了。",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "……这几天经历的事情，有些太奇妙了。"
    },
    {
        "id": 169,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 170,
        "raw": "[name=\"温和的生物\"]奇妙也是生活的一部分。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "奇妙也是生活的一部分。"
    },
    {
        "id": 171,
        "raw": "[name=\"温和的生物\"]小家伙，你现在开心吗？",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "小家伙，你现在开心吗？"
    },
    {
        "id": 172,
        "raw": "[charslot(slot=\"m\",name=\"avg_1016_agoat2_1#9$2\")]",
        "type": "charslot",
        "slot": "m",
