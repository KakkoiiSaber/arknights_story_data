        "raw": "[name=\"阿黛尔\"]我不知道……",
        "type": "dialog",
        "speaker": "阿黛尔",
        "content": "我不知道……"
    },
    {
        "id": 174,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_1007_1#1$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_1007_1#1$1.png"
    },
    {
        "id": 175,
        "raw": "[name=\"温和的生物\"]让我看看，你应该……",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "让我看看，你应该……"
    },
    {
        "id": 176,
        "raw": "[name=\"温和的生物\"]你应该是不太开心的。",
        "type": "dialog",
        "speaker": "温和的生物",
        "content": "你应该是不太开心的。"
    },
    {
        "id": 177,
