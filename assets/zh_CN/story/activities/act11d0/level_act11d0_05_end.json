        "type": "character",
        "name": "avg_npc_067",
        "name2": "avg_npc_067",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"武装的感染者A\"]  *莱塔尼亚粗口*！街上在跑的不都是吗！",
        "type": "dialog",
        "speaker": "武装的感染者A",
