        "id": 170,
        "raw": "[Character(name=\"char_367_swllow_1\", name2=\"avg_npc_066\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1",
        "name2": "avg_npc_066",
        "focus": 2
    },
    {
        "id": 171,
        "raw": "[name=\"塞弗林\"]  其实拖拉机可以做得到......前提是，街道上没有那么多叛军。",
        "type": "dialog",
        "speaker": "塞弗林",
        "content": "其实拖拉机可以做得到......前提是，街道上没有那么多叛军。"
