        "name": "char_345_folnic_1#3.png"
    },
    {
        "id": 16,
        "raw": "[name=\"亚叶\"]  是罗德岛的物资箱没错，有编号，有日期。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "是罗德岛的物资箱没错，有编号，有日期。"
    },
    {
        "id": 17,
        "raw": "[name=\"亚叶\"]  ......是上一次定期联络的时候，是我亲自......",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......是上一次定期联络的时候，是我亲自......"
    },
    {
        "id": 18,
        "raw": "[name=\"亚叶\"]  ......",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_358_lisa_1#3\")]",
        "type": "character",
        "name": "char_358_lisa_1#3.png"
    },
    {
        "id": 20,
        "raw": "[name=\"铃兰\"]  亚叶姐姐......",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "亚叶姐姐......"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_345_folnic_1#3\")]",
        "type": "character",
        "name": "char_345_folnic_1#3.png"
    },
    {
        "id": 22,
        "raw": "[name=\"亚叶\"]  火灾是怎么发生的？",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "火灾是怎么发生的？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"塔佳娜\"]  事故——本来是这样定性的，但是......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "事故——本来是这样定性的，但是......"
    },
    {
        "id": 25,
        "raw": "[name=\"塔佳娜\"]  但是这里有明显的施术痕迹，安托医生是个很认真的人，当然不会留下太危险的易燃物。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "但是这里有明显的施术痕迹，安托医生是个很认真的人，当然不会留下太危险的易燃物。"
    },
    {
        "id": 26,
        "raw": "[name=\"塔佳娜\"]  我们确认不了明显的起火点，帐篷的金属支架都被融化了，而且尸体......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "我们确认不了明显的起火点，帐篷的金属支架都被融化了，而且尸体......"
    },
    {
        "id": 27,
        "raw": "[name=\"塔佳娜\"]  啊......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "啊......"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"亚叶\"]  ......没事的，继续吧。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......没事的，继续吧。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"塔佳娜\"]  根据遗体情况判断，受害者们几乎没能离开帐篷，更不存在挣扎，一瞬间就面目全非。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "根据遗体情况判断，受害者们几乎没能离开帐篷，更不存在挣扎，一瞬间就面目全非。"
    },
    {
        "id": 32,
        "raw": "[name=\"塔佳娜\"]  我不认为普通的火灾能让安托医生和患者们这么简单就被......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "我不认为普通的火灾能让安托医生和患者们这么简单就被......"
    },
    {
        "id": 33,
        "raw": "[name=\"塔佳娜\"]  除非，是源石技艺，而且不像是普通的火焰，是依赖某种手段达成的瞬间高温......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "除非，是源石技艺，而且不像是普通的火焰，是依赖某种手段达成的瞬间高温......"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"亚叶\"]  ——这之中有几个感染者？",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "——这之中有几个感染者？"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"塔佳娜\"]  欸？啊......镇上的感染者有三人，凯文、毕德曼、埃克哈德，他们在这里接受治疗，以及......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "欸？啊......镇上的感染者有三人，凯文、毕德曼、埃克哈德，他们在这里接受治疗，以及......"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"亚叶\"]  ......",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#3",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"塔佳娜\"]  以及......托尔，托尔瓦尔德。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "以及......托尔，托尔瓦尔德。"
    },
    {
        "id": 42,
        "raw": "[name=\"塔佳娜\"]  他是长官的独子，是我的老朋友......他不是感染者，他只是去帮忙的，出于好心。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "他是长官的独子，是我的老朋友......他不是感染者，他只是去帮忙的，出于好心。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_358_lisa_1#3\")]",
        "type": "character",
        "name": "char_358_lisa_1#3.png"
    },
    {
        "id": 44,
        "raw": "[name=\"铃兰\"]  ......塔佳娜小姐，如果你感到难过的话，说出来比较好喔。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "......塔佳娜小姐，如果你感到难过的话，说出来比较好喔。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069#4",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"塔佳娜\"]  欸？",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "欸？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069#4",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"铃兰\"]  我能感觉到，这里充斥着悲伤。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "我能感觉到，这里充斥着悲伤。"
    },
    {
        "id": 49,
        "raw": "[name=\"铃兰\"]  这里......这里有很多不甘心，很多快乐，很多痛苦，但是现在都不存在了。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "这里......这里有很多不甘心，很多快乐，很多痛苦，但是现在都不存在了。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069#2\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069#2",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"塔佳娜\"]  这是......也是某种源石技艺吗？",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "这是......也是某种源石技艺吗？"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069#2\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069#2",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"铃兰\"]  不——只是看多了这样的事情，大家都喜欢把自己的想法藏起来，但这样不好喔。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "不——只是看多了这样的事情，大家都喜欢把自己的想法藏起来，但这样不好喔。"
    },
    {
        "id": 54,
        "raw": "[name=\"铃兰\"]  可能只是我多想了，不过，如果总是勉强自己的话，会让身边的人担心吧？",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "可能只是我多想了，不过，如果总是勉强自己的话，会让身边的人担心吧？"
    },
    {
        "id": 55,
        "raw": "[name=\"铃兰\"]  可以哭一场的，不会有人说什么的啦。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "可以哭一场的，不会有人说什么的啦。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"塔佳娜\"]  嗯，谢谢，其实我也清楚，但是现在我还不能......不能松懈。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "嗯，谢谢，其实我也清楚，但是现在我还不能......不能松懈。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"avg_npc_069\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "avg_npc_069",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"铃兰\"]  嗯——",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "嗯——"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_358_lisa_1#3\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "char_358_lisa_1#3.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 61,
        "raw": "[name=\"亚叶\"]  ......别、别看着我，我知道啦，丽萨你就不用担心了。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......别、别看着我，我知道啦，丽萨你就不用担心了。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_358_lisa_1\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "char_358_lisa_1.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"铃兰\"]  嗯！",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "嗯！"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_345_folnic_1#4\")]",
        "type": "character",
        "name": "char_345_folnic_1#4.png"
    },
    {
        "id": 65,
        "raw": "[name=\"亚叶\"]  唉......那什么，抱歉！",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "唉......那什么，抱歉！"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 67,
        "raw": "[name=\"塔佳娜\"]  欸？怎么突然......？",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "欸？怎么突然......？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_069#4\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#4.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"亚叶\"]  ......我在离开罗德岛本舰的时候已经做好心理准备了，安托她是个很认真的人，所以她向来守时。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......我在离开罗德岛本舰的时候已经做好心理准备了，安托她是个很认真的人，所以她向来守时。"
    },
    {
        "id": 70,
        "raw": "[name=\"亚叶\"]  我怎么会真的不清楚干员失联意味着什么，罗德岛经历过多少次这样的生死离别，我只是不愿意相信罢了。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "我怎么会真的不清楚干员失联意味着什么，罗德岛经历过多少次这样的生死离别，我只是不愿意相信罢了。"
    },
    {
        "id": 71,
        "raw": "[name=\"亚叶\"]  呼......就是，那个，刚才太激动了，我很抱歉。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "呼......就是，那个，刚才太激动了，我很抱歉。"
    },
    {
        "id": 72,
        "raw": "[name=\"亚叶\"]  这场谋杀之中遭受损失的，不止是罗德岛。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "这场谋杀之中遭受损失的，不止是罗德岛。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_069#2\")]",
        "type": "character",
        "name": "avg_npc_069#2.png"
    },
    {
        "id": 74,
        "raw": "[name=\"塔佳娜\"]  ......八具遗体都被塞弗林长官带走了。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "......八具遗体都被塞弗林长官带走了。"
    },
    {
        "id": 75,
        "raw": "[name=\"塔佳娜\"]  因为镇上没有感染者处理专家，所以我们只能草草埋葬他们......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "因为镇上没有感染者处理专家，所以我们只能草草埋葬他们......"
    },
    {
        "id": 76,
        "raw": "[name=\"塔佳娜\"]  他们不能跟着沃伦姆德一起前进，他们会被埋葬在城镇之外的废土上，等沃伦姆德离开这里，他们就永远失去了家乡。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "他们不能跟着沃伦姆德一起前进，他们会被埋葬在城镇之外的废土上，等沃伦姆德离开这里，他们就永远失去了家乡。"
    },
    {
        "id": 77,
        "raw": "[name=\"塔佳娜\"]  本来......按照我们的传统......至少可以不用这样的......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "本来......按照我们的传统......至少可以不用这样的......"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_358_lisa_1#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_358_lisa_1#3",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"铃兰\"]  这种事情......很常见。",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "这种事情......很常见。"
    },
    {
        "id": 80,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 81,
        "raw": "[name=\"亚叶\"]  八具遗体？",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "八具遗体？"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"塔佳娜\"]  八具遗体，除了刚才说的五个人，此外的应该是来这里接受治疗的游荡者......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "八具遗体，除了刚才说的五个人，此外的应该是来这里接受治疗的游荡者......"
    },
    {
        "id": 84,
        "raw": "[name=\"塔佳娜\"]  大裂谷崩裂时，沃伦姆德并没能全身而退，当然也有很多周边的商人、旅行者被卷入了天灾。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "大裂谷崩裂时，沃伦姆德并没能全身而退，当然也有很多周边的商人、旅行者被卷入了天灾。"
    },
    {
        "id": 85,
        "raw": "[name=\"塔佳娜\"]  尽管在那之后，沃伦姆德的处境越发糟糕，但除了追逐着这座仍旧勉强前进在废土上的城镇之外，他们也没有别的办法。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "尽管在那之后，沃伦姆德的处境越发糟糕，但除了追逐着这座仍旧勉强前进在废土上的城镇之外，他们也没有别的办法。"
    },
    {
        "id": 86,
        "raw": "[name=\"塔佳娜\"]  这期间，难民们的队伍也在变化......不过安托医生一视同仁，她也会负责救助一些愿意被救助的感染者。",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "这期间，难民们的队伍也在变化......不过安托医生一视同仁，她也会负责救助一些愿意被救助的感染者。"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 88,
        "raw": "[name=\"亚叶\"]  所以，一位非感染者，七位感染者......",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "所以，一位非感染者，七位感染者......"
    },
    {
        "id": 89,
        "raw": "[name=\"亚叶\"]  感染者的遗体呢？在生命体征停止的数分钟到数小时内，视体内源石融合率，可能会出现二次扩散，如果不进行专门处理的话很危险。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "感染者的遗体呢？在生命体征停止的数分钟到数小时内，视体内源石融合率，可能会出现二次扩散，如果不进行专门处理的话很危险。"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 91,
        "raw": "[name=\"塔佳娜\"]  啊，那个，塞弗林长官判断因为感染程度较轻，而且高温迅速摧毁了身体组织，所以不存在太大风险......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "啊，那个，塞弗林长官判断因为感染程度较轻，而且高温迅速摧毁了身体组织，所以不存在太大风险......"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 93,
        "raw": "[name=\"亚叶\"]  ......不是说没有专业人士吗？",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "......不是说没有专业人士吗？"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 95,
        "raw": "[name=\"塔佳娜\"]  诶，塞弗林长官说自己只是按照经验判断，他也没十足的把握......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "诶，塞弗林长官说自己只是按照经验判断，他也没十足的把握......"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 97,
        "raw": "[name=\"亚叶\"]  经验......什么样的工作才会有处理感染者尸体的经验......",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "经验......什么样的工作才会有处理感染者尸体的经验......"
    },
    {
        "id": 98,
        "raw": "[name=\"亚叶\"]  不过，也是，如果失去了亲生骨肉还能保持冷静，也许他并没有表面上那么轻浮。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "不过，也是，如果失去了亲生骨肉还能保持冷静，也许他并没有表面上那么轻浮。"
    },
    {
        "id": 99,
        "raw": "[name=\"亚叶\"]  我想回去检查一下各位感染者的遗体......我想见安托一眼。",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "我想回去检查一下各位感染者的遗体......我想见安托一眼。"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"塔佳娜\"]  当然可以，我会向长官解释的，不过大部分遗体炭化严重，我们分辨不出来.......",
        "type": "dialog",
        "speaker": "塔佳娜",
        "content": "当然可以，我会向长官解释的，不过大部分遗体炭化严重，我们分辨不出来......."
    },
    {
        "id": 102,
        "raw": "[Character(name=\"avg_npc_069#2\", name2=\"char_345_folnic_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_069#2.png",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "id": 103,
        "raw": "[name=\"亚叶\"]  没关系——",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "没关系——"
    },
    {
        "id": 104,
        "raw": "[Character(name=\"char_358_lisa_1#4\")]",
        "type": "character",
        "name": "char_358_lisa_1#4.png"
    },
