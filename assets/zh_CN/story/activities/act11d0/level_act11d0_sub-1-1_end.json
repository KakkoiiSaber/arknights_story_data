        "raw": "[name=\"毕德曼\"]  这是——",
        "type": "dialog",
        "speaker": "毕德曼",
        "content": "这是——"
    },
    {
        "id": 194,
        "raw": "[name=\"毕德曼\"]  危机合约？",
        "type": "dialog",
        "speaker": "毕德曼",
        "content": "危机合约？"
    },
