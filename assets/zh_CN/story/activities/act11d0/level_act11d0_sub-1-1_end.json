        "type": "character"
    },
    {
        "id": 165,
        "raw": "[name=\"毕德曼\"]  辟谣？",
        "type": "dialog",
        "speaker": "毕德曼",
        "content": "辟谣？"
    },
    {
        "id": 166,
        "raw": "[Character(name=\"avg_npc_066\")]",
