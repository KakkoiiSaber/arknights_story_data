        "name": "avg_npc_066.png"
    },
    {
        "id": 163,
        "raw": "[name=\"塞弗林\"]  你的私人空间在楼上，这里是公共区域。",
        "type": "dialog",
        "speaker": "塞弗林",
        "content": "你的私人空间在楼上，这里是公共区域。"
    },
