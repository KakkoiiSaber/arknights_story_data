    {
        "id": 159,
        "raw": "[name=\"塞弗林\"]  喔，毕德曼，你很努力，这样我们的辟谣工作也能更加顺利。",
        "type": "dialog",
        "speaker": "塞弗林",
        "content": "喔，毕德曼，你很努力，这样我们的辟谣工作也能更加顺利。"
    },
    {
        "id": 160,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 161,
        "raw": "[name=\"毕德曼\"]  ……我说过我对烟过敏吧。",
        "type": "dialog",
        "speaker": "毕德曼",
        "content": "……我说过我对烟过敏吧。"
    },
