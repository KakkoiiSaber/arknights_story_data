        "raw": "[name=\"亚叶\"]  是你？",
        "type": "dialog",
        "speaker": "亚叶",
        "content": "是你？"
    },
    {
        "id": 99,
        "raw": "[name=\"亚叶\"]  我记得我说过我们不需要帮助，只需要权限就......",
        "type": "dialog",
