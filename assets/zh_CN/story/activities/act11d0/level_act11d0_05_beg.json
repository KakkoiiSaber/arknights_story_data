        "id": 187,
        "raw": "[name=\"铃兰\"]  ......",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "......"
    },
    {
        "id": 188,
        "raw": "[name=\"铃兰\"]  亚叶姐姐，你真觉得找到那个凶手，我们就能解决问题吗？",
        "type": "dialog",
        "speaker": "铃兰",
        "content": "亚叶姐姐，你真觉得找到那个凶手，我们就能解决问题吗？"
