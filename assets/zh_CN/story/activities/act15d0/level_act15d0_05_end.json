        "name": "char_451_robin#2",
        "name2": "avg_npc_137#9",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"杰斯顿\"]呵呵，毕竟是我把你们这些昏迷过去的囚犯送过来的。",
        "type": "dialog",
        "speaker": "杰斯顿",
        "content": "呵呵，毕竟是我把你们这些昏迷过去的囚犯送过来的。"
    },
    {
        "id": 65,
        "raw": "[name=\"杰斯顿\"]虽然安东尼先生即使在他的“安全屋”里也压低了音量，不过对于我这样的有心人来说，还是非常容易听到的。",
        "type": "dialog",
        "speaker": "杰斯顿",
        "content": "虽然安东尼先生即使在他的“安全屋”里也压低了音量，不过对于我这样的有心人来说，还是非常容易听到的。"
    },
