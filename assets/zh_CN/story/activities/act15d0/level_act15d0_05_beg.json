        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"缪尔赛思\"]赫默小姐你没事了吗？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "赫默小姐你没事了吗？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#3.png",
        "name2": "char_108_silent_1#1",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"赫默\"]没事，其实或许我要感谢你。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "没事，其实或许我要感谢你。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#3.png",
        "name2": "char_108_silent_1#1",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"缪尔赛思\"]为什么？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "为什么？"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#1\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#3.png",
        "name2": "char_108_silent_1#1",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"赫默\"]没什么。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "没什么。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#1\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#1",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"缪尔赛思\"]好吧，那么，我们继续？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "好吧，那么，我们继续？"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"赫默\"]你们刚才说到哪里了？",
        "type": "dialog",
        "speaker": "赫默",
        "content": "你们刚才说到哪里了？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1.png",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"缪尔赛思\"]说到安东尼对罗宾抛出橄榄枝。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "说到安东尼对罗宾抛出橄榄枝。"
    },
    {
        "id": 29,
        "raw": "[name=\"缪尔赛思\"]我正在和梅尔小姐讨论安东尼的手段高超呢。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "我正在和梅尔小姐讨论安东尼的手段高超呢。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#1.png",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"赫默\"]......我觉得你可能是单纯的想多了。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "......我觉得你可能是单纯的想多了。"
    },
    {
        "id": 32,
        "raw": "[name=\"赫默\"]或许，他当时没有想那么多，只是单纯地想要对罗宾付出善意呢？",
        "type": "dialog",
        "speaker": "赫默",
        "content": "或许，他当时没有想那么多，只是单纯地想要对罗宾付出善意呢？"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1.png",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"缪尔赛思\"]嗯，我确实无法否认这种可能性啦。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "嗯，我确实无法否认这种可能性啦。"
    },
    {
        "id": 35,
        "raw": "[name=\"缪尔赛思\"]不过如果是单纯善良的人，是没有办法在这片大地上活下去的，赫默小姐。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "不过如果是单纯善良的人，是没有办法在这片大地上活下去的，赫默小姐。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#1.png",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"赫默\"]......算了，我不该和你讨论这个，梅尔说到哪里了？",
        "type": "dialog",
        "speaker": "赫默",
        "content": "......算了，我不该和你讨论这个，梅尔说到哪里了？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_249_muesys_1#1\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#1.png",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"缪尔赛思\"]以及卡夫卡和安东尼讨论过后，安东尼终于决定越狱。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "以及卡夫卡和安东尼讨论过后，安东尼终于决定越狱。"
    },
    {
        "id": 40,
        "raw": "[name=\"缪尔赛思\"]说到罗宾在医务室里醒来，被安东尼邀请加入越狱的队伍的部分。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "说到罗宾在医务室里醒来，被安东尼邀请加入越狱的队伍的部分。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"缪尔赛思\"]不得不说，赫默小姐，我确实有些好奇你究竟是从哪里获得安东尼这条线索的情报的了。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "不得不说，赫默小姐，我确实有些好奇你究竟是从哪里获得安东尼这条线索的情报的了。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#5",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"赫默\"]从我的老师那里。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "从我的老师那里。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#5\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#5",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"缪尔赛思\"]嗯？难道帕尔维斯主任也插手了这件事？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "嗯？难道帕尔维斯主任也插手了这件事？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#3\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#3",
        "focus": 2
    },
    {
        "id": 48,
        "raw": "[name=\"赫默\"]......不，我已经很久没有和他直接联络过了。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "......不，我已经很久没有和他直接联络过了。"
    },
    {
        "id": 49,
        "raw": "[name=\"赫默\"]而且他恐怕也不知道这件事。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "而且他恐怕也不知道这件事。"
    },
    {
        "id": 50,
        "raw": "[name=\"赫默\"]自从离开莱茵生命后，我把过去很多从没在意过的情报重新梳理了一遍。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "自从离开莱茵生命后，我把过去很多从没在意过的情报重新梳理了一遍。"
    },
    {
        "id": 51,
        "raw": "[name=\"赫默\"]而在那之中，我抓到了西蒙家族这条尾巴。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "而在那之中，我抓到了西蒙家族这条尾巴。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_249_muesys_1#3\",name2=\"char_108_silent_1#4\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#3.png",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"缪尔赛思\"]哦？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "哦？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#4\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#4",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"赫默\"]这个家族覆灭的时间很短，而且一些数据伪装得很好，所以在很多人看来，这些数据就仿佛没有变化过一样。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "这个家族覆灭的时间很短，而且一些数据伪装得很好，所以在很多人看来，这些数据就仿佛没有变化过一样。"
    },
    {
        "id": 56,
        "raw": "[name=\"赫默\"]但是伪装总是会有痕迹的。一些报表，一些统计数据，只要详细对比一下，就能发现其中的问题。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "但是伪装总是会有痕迹的。一些报表，一些统计数据，只要详细对比一下，就能发现其中的问题。"
    },
    {
        "id": 57,
        "raw": "[name=\"赫默\"]我原本只是抱着试试的心态过了一遍那些数据，却没想到让我发现了这样的事。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "我原本只是抱着试试的心态过了一遍那些数据，却没想到让我发现了这样的事。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#4\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 59,
        "raw": "[name=\"缪尔赛思\"]只是偶然发现......不，其实是必然吗。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "只是偶然发现......不，其实是必然吗。"
    },
    {
        "id": 60,
        "raw": "[name=\"缪尔赛思\"]不过，你为什么会突然去梳理一遍那些数据呢？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "不过，你为什么会突然去梳理一遍那些数据呢？"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#3\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#3",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"赫默\"]因为我开始不信任莱茵生命，也不信任我的老师。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "因为我开始不信任莱茵生命，也不信任我的老师。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#3\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#3",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"缪尔赛思\"]是“炎魔”事件吗？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "是“炎魔”事件吗？"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_249_muesys_1#4\",name2=\"char_108_silent_1#4\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#4.png",
        "name2": "char_108_silent_1#4",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"赫默\"]不，不只是。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "不，不只是。"
    },
    {
        "id": 67,
        "raw": "[name=\"赫默\"]“炎魔”导致了塞雷娅的离开，在那之后发生的一些事情想必缪尔赛思主任你比我更了解。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "“炎魔”导致了塞雷娅的离开，在那之后发生的一些事情想必缪尔赛思主任你比我更了解。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#4\",focus=1)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#4",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"缪尔赛思\"]......原来如此。",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "......原来如此。"
    },
    {
        "id": 70,
        "raw": "[name=\"缪尔赛思\"]哎呀，我只是随口问问，就这么告诉我这些事真的好吗？",
        "type": "dialog",
        "speaker": "缪尔赛思",
        "content": "哎呀，我只是随口问问，就这么告诉我这些事真的好吗？"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_249_muesys_1#5\",name2=\"char_108_silent_1#1\",focus=2)]",
        "type": "character",
        "name": "char_249_muesys_1#5.png",
        "name2": "char_108_silent_1#1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"赫默\"]这不就是你想听到的东西吗？",
        "type": "dialog",
        "speaker": "赫默",
        "content": "这不就是你想听到的东西吗？"
    },
    {
        "id": 73,
        "raw": "[name=\"赫默\"]我不擅长掩饰什么，缪尔赛思主任，所以我思考过后，决定对你坦诚相待。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "我不擅长掩饰什么，缪尔赛思主任，所以我思考过后，决定对你坦诚相待。"
    },
    {
        "id": 74,
        "raw": "[name=\"赫默\"]虽然我并不喜欢我的老师，不过他有一句话我一直记得——",
        "type": "dialog",
        "speaker": "赫默",
        "content": "虽然我并不喜欢我的老师，不过他有一句话我一直记得——"
    },
    {
        "id": 75,
        "raw": "[name=\"赫默\"]“对阴谋家来说，最让他们恐惧的是坦诚。”",
