    {
        "id": 52,
        "raw": "[Character(name=\"char_108_silent_1#3\",name2=\"char_242_mayer#1\",focus=1)]",
        "type": "character",
        "name": "char_108_silent_1#3.png",
        "name2": "char_242_mayer#1",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"赫默\"]我不知道。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "我不知道。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_108_silent_1#3\",name2=\"char_242_mayer#2\",focus=2)]",
        "type": "character",
        "name": "char_108_silent_1#3.png",
        "name2": "char_242_mayer#2",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"梅尔\"]诶？",
        "type": "dialog",
        "speaker": "梅尔",
        "content": "诶？"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_108_silent_1#3\",name2=\"char_242_mayer#2\",focus=1)]",
        "type": "character",
        "name": "char_108_silent_1#3.png",
        "name2": "char_242_mayer#2",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"赫默\"]我一直以为我知道我在做什么，但我现在才发现，我其实不知道。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "我一直以为我知道我在做什么，但我现在才发现，我其实不知道。"
    },
    {
        "id": 58,
        "raw": "[name=\"赫默\"]我只知道，我绝不能让伊芙利特再被那样对待。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "我只知道，我绝不能让伊芙利特再被那样对待。"
    },
    {
        "id": 59,
        "raw": "[name=\"赫默\"]这可能，是我现在唯一能够坚持的事情了。",
        "type": "dialog",
        "speaker": "赫默",
        "content": "这可能，是我现在唯一能够坚持的事情了。"
