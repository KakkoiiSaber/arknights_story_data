        "type": "character",
        "name": "char_108_silent_1#3.png",
        "name2": "char_242_mayer#1",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"梅尔\"]那次实验究竟发生了什么？",
        "type": "dialog",
        "speaker": "梅尔",
        "content": "那次实验究竟发生了什么？"
