        "type": "charslot",
        "slot": "l",
        "name": "avg_npc_2378_1#10$1.png",
        "focus": "l"
    },
    {
        "id": 93,
        "raw": "[name=\"吉阿达\"]如果仪式是“传达”，那么它首要的美德就是诚实。",
        "type": "dialog",
        "speaker": "吉阿达",
        "content": "如果仪式是“传达”，那么它首要的美德就是诚实。"
