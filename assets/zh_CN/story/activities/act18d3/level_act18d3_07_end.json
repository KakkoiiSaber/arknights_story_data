    {
        "id": 75,
        "raw": "[name=\"审判官艾丽妮\"]另一方面，我看见一个人进了教堂。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "另一方面，我看见一个人进了教堂。"
    },
    {
        "id": 76,
        "raw": "[name=\"审判官艾丽妮\"]她看起来和我们之前遇见过的那个外来人......很像。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "她看起来和我们之前遇见过的那个外来人......很像。"
    },
