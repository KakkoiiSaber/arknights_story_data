    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_182#2\")]",
        "type": "character",
        "name": "avg_npc_182#2"
    },
    {
        "id": 80,
        "raw": "[name=\"审判官艾丽妮\"]那，长官，她到底是什么人？",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "那，长官，她到底是什么人？"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 82,
        "raw": "[name=\"大审判官\"]阿戈尔人。",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "阿戈尔人。"
    },
    {
