        "name": "avg_npc_183#3"
    },
    {
        "id": 107,
        "raw": "[name=\"大审判官\"]判官！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "判官！"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"avg_npc_182#5\")]",
        "type": "character",
        "name": "avg_npc_182#5"
    },
    {
        "id": 109,
        "raw": "[name=\"审判官艾丽妮\"]呃......！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "呃......！"
    },
    {
        "id": 110,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
