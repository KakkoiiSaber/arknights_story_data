        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 103,
        "raw": "[name=\"审判官艾丽妮\"]我想去疏散他们。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "我想去疏散他们。"
    },
    {
        "id": 104,
        "raw": "[name=\"审判官艾丽妮\"]哪怕他们在长官你看来是古怪的，有问题的......",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "哪怕他们在长官你看来是古怪的，有问题的......"
    },
    {
        "id": 105,
        "raw": "[name=\"审判官艾丽妮\"]......应该被净化的。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "......应该被净化的。"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
