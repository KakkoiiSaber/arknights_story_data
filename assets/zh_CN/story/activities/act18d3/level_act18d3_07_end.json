        "name": "avg_npc_183#3"
    },
    {
        "id": 111,
        "raw": "[name=\"大审判官\"]说出你的职责！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "说出你的职责！"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"avg_npc_182#4\")]",
        "type": "character",
        "name": "avg_npc_182#4"
    },
    {
        "id": 113,
        "raw": "[name=\"审判官艾丽妮\"]是！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "是！"
    },
    {
        "id": 114,
        "raw": "[name=\"审判官艾丽妮\"]“我是为了伊比利亚的存续，为了同伊比利亚的敌人而战，为了守卫伊比利亚的洁净与德行，提起了剑与灯！”",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "“我是为了伊比利亚的存续，为了同伊比利亚的敌人而战，为了守卫伊比利亚的洁净与德行，提起了剑与灯！”"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 116,
        "raw": "[name=\"大审判官\"]那么你必须对他们做出判决！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "那么你必须对他们做出判决！"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"avg_npc_182#5\")]",
        "type": "character",
        "name": "avg_npc_182#5"
    },
    {
        "id": 118,
        "raw": "[name=\"审判官艾丽妮\"]判决？判处他们......死刑吗？",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "判决？判处他们......死刑吗？"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"avg_npc_182#2\")]",
        "type": "character",
        "name": "avg_npc_182#2"
    },
    {
        "id": 120,
        "raw": "[name=\"审判官艾丽妮\"]长官，你上一次听到过去的歌声，是什么时候？那些唱片，都已经坏了吧？你的机器也落灰很久了吧？",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "长官，你上一次听到过去的歌声，是什么时候？那些唱片，都已经坏了吧？你的机器也落灰很久了吧？"
    },
    {
        "id": 121,
        "raw": "[name=\"审判官艾丽妮\"]我听见那首歌。我听见了这个阿戈尔人给他们唱的歌。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "我听见那首歌。我听见了这个阿戈尔人给他们唱的歌。"
    },
    {
        "id": 122,
        "raw": "[name=\"审判官艾丽妮\"]那样的歌，是伊比利亚原本该有的歌。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "那样的歌，是伊比利亚原本该有的歌。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"avg_npc_182#3\")]",
        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 124,
        "raw": "[name=\"审判官艾丽妮\"]在杀死他们以前，我想知道真相。就像长官你想揪出幕后主使者。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "在杀死他们以前，我想知道真相。就像长官你想揪出幕后主使者。"
    },
    {
        "id": 125,
        "raw": "[name=\"审判官艾丽妮\"]也许他们还是会变异，到那时候，我一定会亲手净化他们，但现在我想让他们先去避难。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "也许他们还是会变异，到那时候，我一定会亲手净化他们，但现在我想让他们先去避难。"
    },
    {
        "id": 126,
        "raw": "[name=\"审判官艾丽妮\"]长官，如果你同意，我立刻就会去进行疏散！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "长官，如果你同意，我立刻就会去进行疏散！"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 128,
        "raw": "[name=\"大审判官\"]这就是你的判决？",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "这就是你的判决？"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"avg_npc_182#3\")]",
        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 130,
        "raw": "[name=\"审判官艾丽妮\"]长官，我不知道！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "长官，我不知道！"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 132,
        "raw": "[name=\"大审判官\"]艾丽妮，你不止在对面前的人下判决。你也在对其他人下判决！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "艾丽妮，你不止在对面前的人下判决。你也在对其他人下判决！"
    },
    {
        "id": 133,
        "raw": "[name=\"大审判官\"]你判决怪物生，就是判决人民死！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "你判决怪物生，就是判决人民死！"
    },
    {
        "id": 134,
        "raw": "[Character(name=\"avg_npc_182#3\")]",
        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 135,
        "raw": "[name=\"审判官艾丽妮\"]我明白！这样的判决，我已经下过许多次！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "我明白！这样的判决，我已经下过许多次！"
    },
    {
        "id": 136,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 137,
        "raw": "[name=\"大审判官\"]你的判决，既可能阻绝灾难，也可能带来噩兆！你可能救一人而杀百人，也可能杀百人而救一人！",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "你的判决，既可能阻绝灾难，也可能带来噩兆！你可能救一人而杀百人，也可能杀百人而救一人！"
    },
    {
        "id": 138,
        "raw": "[Character(name=\"avg_npc_182#3\")]",
        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 139,
        "raw": "[name=\"审判官艾丽妮\"]......我明白，长官！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "......我明白，长官！"
    },
    {
        "id": 140,
        "raw": "[name=\"审判官艾丽妮\"]这里面的利害关系，道德和经文的冲突......我都明白！",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "这里面的利害关系，道德和经文的冲突......我都明白！"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 142,
        "raw": "[name=\"大审判官\"]我问你这个了吗？",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "我问你这个了吗？"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"avg_npc_182#2\")]",
        "type": "character",
        "name": "avg_npc_182#2"
    },
    {
        "id": 144,
        "raw": "[name=\"审判官艾丽妮\"]......",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "......"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"avg_npc_183#3\")]",
        "type": "character",
        "name": "avg_npc_183#3"
    },
    {
        "id": 146,
        "raw": "[name=\"大审判官\"]我问你的是，艾丽妮，这种责任是你能承担得了的吗？",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "我问你的是，艾丽妮，这种责任是你能承担得了的吗？"
    },
    {
        "id": 147,
        "raw": "[name=\"大审判官\"]如果你会带来痛苦，你就必须也遭受痛苦，而且要比你施加给别人的那些罪恶加起来还要多。",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "如果你会带来痛苦，你就必须也遭受痛苦，而且要比你施加给别人的那些罪恶加起来还要多。"
    },
    {
        "id": 148,
        "raw": "[name=\"大审判官\"]你有这种胆识吗？你的信仰会在你遭受内心折磨时动摇吗？如果你失败了，你造成了恶果，你会因此一蹶不振吗？",
        "type": "dialog",
        "speaker": "大审判官",
        "content": "你有这种胆识吗？你的信仰会在你遭受内心折磨时动摇吗？如果你失败了，你造成了恶果，你会因此一蹶不振吗？"
    },
    {
        "id": 149,
        "raw": "[Character(name=\"avg_npc_182#3\")]",
        "type": "character",
        "name": "avg_npc_182#3"
    },
    {
        "id": 150,
        "raw": "[name=\"审判官艾丽妮\"]......我能承担。我不会动摇。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "......我能承担。我不会动摇。"
    },
    {
        "id": 151,
        "raw": "[name=\"审判官艾丽妮\"]在我加入审判庭的时候，我就已经这么做了。我能。如果我做错了，那么就让我遭受责罚。我必须做。",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "在我加入审判庭的时候，我就已经这么做了。我能。如果我做错了，那么就让我遭受责罚。我必须做。"
    },
    {
        "id": 152,
        "raw": "[name=\"审判官艾丽妮\"]长官！我——",
        "type": "dialog",
        "speaker": "审判官艾丽妮",
        "content": "长官！我——"
