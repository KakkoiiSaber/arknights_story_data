        "type": "character"
    },
    {
        "id": 27,
        "raw": "[name=\"主教？\"]......",
        "type": "dialog",
        "speaker": "主教？",
        "content": "......"
    },
    {
        "id": 28,
        "raw": "[name=\"主教？\"]阿戈尔......必定毁灭。你们什么都不剩......什么都......",
        "type": "dialog",
        "speaker": "主教？",
        "content": "阿戈尔......必定毁灭。你们什么都不剩......什么都......"
    },
    {
        "id": 29,
        "raw": "[character(name=\"avg_474_gladiia_1#2\")]",
        "type": "character",
        "name": "avg_474_gladiia_1#2.png"
    },
    {
        "id": 30,
        "raw": "[name=\"歌蕾蒂娅\"]蠢材。我活着，我就是阿戈尔，我活着，阿戈尔就活着。",
        "type": "dialog",
        "speaker": "歌蕾蒂娅",
        "content": "蠢材。我活着，我就是阿戈尔，我活着，阿戈尔就活着。"
    },
    {
        "id": 31,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 32,
        "raw": "[name=\"主教？\"]......你......但......",
        "type": "dialog",
        "speaker": "主教？",
        "content": "......你......但......"
    },
    {
        "id": 33,
        "raw": "[name=\"主教？\"]讽刺......讽刺。",
        "type": "dialog",
        "speaker": "主教？",
        "content": "讽刺......讽刺。"
    },
    {
        "id": 34,
        "raw": "[name=\"主教？\"]你是不一样的。呼......你注定不同......",
        "type": "dialog",
        "speaker": "主教？",
        "content": "你是不一样的。呼......你注定不同......"
    },
    {
        "id": 35,
        "raw": "[name=\"主教？\"]你很清楚。你的命运已定。",
        "type": "dialog",
        "speaker": "主教？",
        "content": "你很清楚。你的命运已定。"
    },
