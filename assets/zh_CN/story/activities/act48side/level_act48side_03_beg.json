        "focus": "m"
    },
    {
        "id": 34,
        "raw": "[name=\"卡珊卓拉\"]......看来你在罗德岛休养的那段时间，过得很好。",
        "type": "dialog",
        "speaker": "卡珊卓拉",
        "content": "......看来你在罗德岛休养的那段时间，过得很好。"
