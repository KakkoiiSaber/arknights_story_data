        "content": "......"
    },
    {
        "id": 49,
        "raw": "[name=\"卡珊卓拉\"]我看你就是馋了，我给你的方子呢？",
        "type": "dialog",
        "speaker": "卡珊卓拉",
        "content": "我看你就是馋了，我给你的方子呢？"
