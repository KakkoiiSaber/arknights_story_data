        "type": "charslot",
        "slot": "l",
        "name": "avg_4056_titi_1#9$2.png",
        "focus": "l"
    },
    {
        "id": 113,
        "raw": "[name=\"缇缇\"]我只是想做一些力所能及的小事。",
        "type": "dialog",
        "speaker": "缇缇",
        "content": "我只是想做一些力所能及的小事。"
    },
    {
        "id": 114,
        "raw": "[name=\"缇缇\"]理事官小姐，使节团的贝赫努先生已经跟您打过照面，我想交换仪式的流程和场地还未完全敲定？",
        "type": "dialog",
        "speaker": "缇缇",
        "content": "理事官小姐，使节团的贝赫努先生已经跟您打过照面，我想交换仪式的流程和场地还未完全敲定？"
    },
