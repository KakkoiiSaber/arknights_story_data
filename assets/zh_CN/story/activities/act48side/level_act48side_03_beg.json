        "raw": "[charslot(slot=\"m\",name=\"avgnew_482_pallas_1#1$1\",focus=\"m\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avgnew_482_pallas_1#1$1.png",
        "focus": "m"
