        "type": "charslot",
        "slot": "m",
        "name": "avg_2027_wang_1#3$1.png"
    },
    {
        "id": 57,
        "raw": "[name=\"望\"]那么，你呢？",
        "type": "dialog",
        "speaker": "望",
        "content": "那么，你呢？"
    },
    {
        "id": 58,
        "raw": "[name=\"望\"]你是否还会害怕，再遭受一次如同千年前一样惨痛的失败......",
        "type": "dialog",
        "speaker": "望",
        "content": "你是否还会害怕，再遭受一次如同千年前一样惨痛的失败......"
    },
    {
        "id": 59,
        "raw": "[name=\"望\"]你又是否会因为害怕，迟疑不前？",
        "type": "dialog",
        "speaker": "望",
        "content": "你又是否会因为害怕，迟疑不前？"
    },
    {
