        "raw": "[charslot(slot=\"m\",name=\"avg_2027_wang_1#11$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_2027_wang_1#11$1.png"
    },
    {
        "id": 55,
        "raw": "[name=\"望\"]你觉得一个输无可输的人，真的会害怕什么吗？",
        "type": "dialog",
        "speaker": "望",
        "content": "你觉得一个输无可输的人，真的会害怕什么吗？"
