        "raw": "[name=\"岁\"]......？",
        "type": "dialog",
        "speaker": "岁",
        "content": "......？"
    },
    {
        "id": 49,
        "raw": "[charslot(slot=\"m\",name=\"avg_2027_wang_1#11$1\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_2027_wang_1#11$1.png"
    },
    {
        "id": 50,
        "raw": "[name=\"望\"]我已经输掉了太多宝贵的东西，满盘皆输。",
        "type": "dialog",
        "speaker": "望",
        "content": "我已经输掉了太多宝贵的东西，满盘皆输。"
    },
    {
        "id": 51,
        "raw": "[charslot(slot = \"m\", focus = \"n\")]",
        "type": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "id": 52,
        "raw": "尊严，荣誉，信任，自由，自我。",
        "type": "narration",
        "content": "尊严，荣誉，信任，自由，自我。"
    },
    {
        "id": 53,
        "raw": "还有，至亲之人。",
        "type": "narration",
        "content": "还有，至亲之人。"
    },
