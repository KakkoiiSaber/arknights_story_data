        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 42,
        "raw": "[name=\"博士\"]比起我所做的事情，愧疚的分量......太轻。",
        "type": "dialog",
        "speaker": "博士",
        "content": "比起我所做的事情，愧疚的分量......太轻。"
    },
    {
        "id": 43,
        "raw": "[name=\"博士\"]在凯尔希都不熟知的年代里，我们做出了太多选择。",
        "type": "dialog",
        "speaker": "博士",
        "content": "在凯尔希都不熟知的年代里，我们做出了太多选择。"
    },
