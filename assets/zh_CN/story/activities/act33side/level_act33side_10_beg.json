    },
    {
        "id": 21,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\", duration=1.5, isblock=true)]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png",
        "duration": "1.5,",
        "isblock": true
    },
    {
        "id": 22,
        "raw": "[Delay(time=0.5)]",
        "type": "delay",
        "time": 0.5
    },
