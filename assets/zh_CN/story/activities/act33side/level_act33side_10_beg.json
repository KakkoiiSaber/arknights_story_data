        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 53,
        "raw": "[name=\"博士\"]......抱歉。这无法改变。",
        "type": "dialog",
        "speaker": "博士",
        "content": "......抱歉。这无法改变。"
    },
    {
        "id": 54,
