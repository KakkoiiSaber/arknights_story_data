        "type": "charslot"
    },
    {
        "id": 46,
        "raw": "[name=\"特蕾西娅\"]等阿米娅长大后，若她还记得我，若她问起我，你是否会如实告知她......我是怎样离去？",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "等阿米娅长大后，若她还记得我，若她问起我，你是否会如实告知她......我是怎样离去？"
    },
    {
        "id": 47,
        "raw": "[charslot(slot=\"m\", name=\"avg_npc_048\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_048.png"
    },
    {
        "id": 48,
        "raw": "[name=\"博士\"]不会。",
        "type": "dialog",
        "speaker": "博士",
        "content": "不会。"
    },
    {
        "id": 49,
        "raw": "[name=\"博士\"]我会帮助他们寻找另一种生活。",
        "type": "dialog",
        "speaker": "博士",
        "content": "我会帮助他们寻找另一种生活。"
    },
    {
        "id": 50,
