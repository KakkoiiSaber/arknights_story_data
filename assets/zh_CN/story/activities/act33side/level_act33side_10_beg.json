    },
    {
        "id": 16,
        "raw": "[name=\"特蕾西娅\"]没事了，阿米娅，没事了......",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "没事了，阿米娅，没事了......"
    },
    {
        "id": 17,
