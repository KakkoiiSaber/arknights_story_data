        "type": "charslot"
    },
    {
        "id": 51,
        "raw": "[name=\"特蕾西娅\"]寻找在源石毁灭泰拉之前最后的安稳？",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "寻找在源石毁灭泰拉之前最后的安稳？"
