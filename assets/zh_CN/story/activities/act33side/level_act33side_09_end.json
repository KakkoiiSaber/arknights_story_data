    {
        "id": 11,
        "raw": "阿米娅最后记得的事，是她睡在黑色的泡泡里。",
        "type": "narration",
        "content": "阿米娅最后记得的事，是她睡在黑色的泡泡里。"
    },
    {
        "id": 12,
        "raw": "特蕾西娅温柔地抱着包裹着她的泡泡。",
        "type": "narration",
        "content": "特蕾西娅温柔地抱着包裹着她的泡泡。"
    },
    {
        "id": 13,
        "raw": "讲述着一个她已经听过许多次的故事......",
        "type": "narration",
        "content": "讲述着一个她已经听过许多次的故事......"
    },
