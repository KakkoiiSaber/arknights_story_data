        "type": "dialog_marker"
    },
    {
        "id": 15,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#1$1\", duration=2, isblock=true)]",
        "type": "charslot",
        "duration": "2,",
        "isblock": true
    },
    {
        "id": 16,
        "raw": "[name=\"特蕾西娅\"]在绝望的沙漠里有很多恐怖的影子，他们追逐着不停寻找希望的小布人。",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "在绝望的沙漠里有很多恐怖的影子，他们追逐着不停寻找希望的小布人。"
    },
    {
        "id": 17,
        "raw": "[name=\"特蕾西娅\"]黑袍的影子是最古老最古老的，绝望和悲哀的回声。",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "黑袍的影子是最古老最古老的，绝望和悲哀的回声。"
    },
    {
        "id": 18,
        "raw": "[name=\"特蕾西娅\"]一旦被他们抓住，就再也逃不开了。",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "一旦被他们抓住，就再也逃不开了。"
    },
    {
        "id": 19,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#8$1\")]",
        "type": "charslot"
    },
    {
        "id": 20,
        "raw": "[name=\"特蕾西娅\"]在沙漠中，小布人遇到了缀满赤金与宝石的国王，他答应小布人只要原路返回，就给他数不尽的财富。",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "在沙漠中，小布人遇到了缀满赤金与宝石的国王，他答应小布人只要原路返回，就给他数不尽的财富。"
    },
    {
        "id": 21,
        "raw": "[name=\"特蕾西娅\"]尽管国王拉扯着他，小布人依旧丢下了诱人的宝石继续前进。",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "尽管国王拉扯着他，小布人依旧丢下了诱人的宝石继续前进。"
    },
    {
        "id": 22,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#1$1\")]",
        "type": "charslot"
    },
    {
        "id": 23,
        "raw": "[name=\"特蕾西娅\"]但很快——",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "但很快——"
    },
    {
        "id": 24,
        "raw": "[name=\"特蕾西娅\"]黑袍的影子追上了他。影子不断向他扑去，无穷无尽......",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "黑袍的影子追上了他。影子不断向他扑去，无穷无尽......"
    },
    {
        "id": 25,
        "raw": "[name=\"特蕾西娅\"]“砰，砰，砰”......",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "“砰，砰，砰”......"
    },
    {
        "id": 26,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1296_1#3$1\")]",
        "type": "charslot"
    },
    {
        "id": 27,
        "raw": "[name=\"特蕾西娅\"]他只能抽出针和线做的长矛与黑色的影子战斗，最终挡开了影子们的利爪继续向前逃去......",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "他只能抽出针和线做的长矛与黑色的影子战斗，最终挡开了影子们的利爪继续向前逃去......"
    },
    {
        "id": 28,
        "raw": "[name=\"特蕾西娅\"]直到逃到一条泪水汇成的大河。没有船只，没有浮萍，小布人只能游过去......",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "直到逃到一条泪水汇成的大河。没有船只，没有浮萍，小布人只能游过去......"
    },
    {
        "id": 29,
        "raw": "[name=\"特蕾西娅\"]可一沾上泪水，他就越来越沉，直至河底——",
        "type": "dialog",
        "speaker": "特蕾西娅",
        "content": "可一沾上泪水，他就越来越沉，直至河底——"
    },
