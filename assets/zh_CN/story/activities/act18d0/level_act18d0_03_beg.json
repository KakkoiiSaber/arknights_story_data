        "type": "character",
        "name": "avg_npc_170_1.png",
        "name2": "avg_npc_169_1",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"文森特伯爵\"]  所以你趁着父母没空管你，偷拿了你母亲的衣服，来我这儿参加宴会？",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "所以你趁着父母没空管你，偷拿了你母亲的衣服，来我这儿参加宴会？"
