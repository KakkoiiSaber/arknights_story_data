        "name2": "avg_npc_169_1",
        "focus": 1
    },
    {
        "id": 131,
        "raw": "[name=\"文森特伯爵\"]  那当然，如果这样的人才能够效忠于文森特家族，一定能为本地的建设多出一份力吧。",
        "type": "dialog",
        "speaker": "文森特伯爵",
