        "name2": "avg_npc_169_1#2",
        "focus": 2
    },
    {
        "id": 135,
        "raw": "[name=\"海蒂\"]  叔叔……那位拉特兰修士，是位绅士吗？是不是位彬彬有礼的萨科塔呀？年纪大吗？",
        "type": "dialog",
        "speaker": "海蒂",
