    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_170_1\",fadetime=1,block=true)]",
        "type": "character",
        "name": "avg_npc_170_1.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 17,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 18,
        "raw": "[name=\"文森特伯爵\"]  多美妙的风雪夜，先生们女士们，欢迎，欢迎，快请进吧，让佣人们为你掸去风雪，去烤炉边取取暖。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "多美妙的风雪夜，先生们女士们，欢迎，欢迎，快请进吧，让佣人们为你掸去风雪，去烤炉边取取暖。"
    },
    {
        "id": 19,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 20,
        "raw": "[name=\"衣着靓丽的商人\"]  伯爵先生，晚上好，真是盛大的晚会。",
        "type": "dialog",
        "speaker": "衣着靓丽的商人",
        "content": "伯爵先生，晚上好，真是盛大的晚会。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_170_1\")]",
        "type": "character",
        "name": "avg_npc_170_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"文森特伯爵\"]  欢迎，欢迎，戴安娜女士，能在新年的前夜见到您，是我的荣幸。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "欢迎，欢迎，戴安娜女士，能在新年的前夜见到您，是我的荣幸。"
    },
    {
        "id": 23,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "[name=\"衣着靓丽的商人\"]  哪里的话。伯爵先生，您看，这是我从卡西米尔为您带来的礼物。",
        "type": "dialog",
        "speaker": "衣着靓丽的商人",
        "content": "哪里的话。伯爵先生，您看，这是我从卡西米尔为您带来的礼物。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_170_1\")]",
        "type": "character",
        "name": "avg_npc_170_1.png"
    },
    {
        "id": 26,
        "raw": "[name=\"文森特伯爵\"]  多美的吊坠！谢谢您，戴安娜女士，代我向您的丈夫问好，现在，请快去屋里吧，可不能让雪花遮掩了您的美貌。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "多美的吊坠！谢谢您，戴安娜女士，代我向您的丈夫问好，现在，请快去屋里吧，可不能让雪花遮掩了您的美貌。"
    },
    {
        "id": 27,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 28,
        "raw": "[name=\"衣着靓丽的商人\"]  哈，您说话还是这么动听。",
        "type": "dialog",
        "speaker": "衣着靓丽的商人",
        "content": "哈，您说话还是这么动听。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"avg_npc_170_1#2\")]",
        "type": "character",
        "name": "avg_npc_170_1#2.png"
    },
    {
        "id": 30,
        "raw": "[name=\"文森特伯爵\"]  哦哦，看看谁来了，这不是“麦田男爵”吗！",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "哦哦，看看谁来了，这不是“麦田男爵”吗！"
    },
    {
        "id": 31,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 32,
        "raw": "[name=\"恭敬的男性贵族\"]  我可担不起伯爵的赏识，但我还是厚着脸皮来啦！",
        "type": "dialog",
        "speaker": "恭敬的男性贵族",
        "content": "我可担不起伯爵的赏识，但我还是厚着脸皮来啦！"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"avg_npc_170_1#3\")]",
        "type": "character",
        "name": "avg_npc_170_1#3.png"
    },
    {
        "id": 34,
        "raw": "[name=\"文森特伯爵\"]  瞧您说的，我们都发自肺腑地尊敬您呀，谁会不尊敬喂饱自己的人呢，哈哈哈！",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "瞧您说的，我们都发自肺腑地尊敬您呀，谁会不尊敬喂饱自己的人呢，哈哈哈！"
    },
    {
        "id": 35,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 36,
        "raw": "[name=\"恭敬的男性贵族\"]  哎，伯爵说的是，等到来年收成的时候，请赏脸光顾寒舍，多伦郡最大的风车和面粉的香气一定让您流连忘返。",
        "type": "dialog",
        "speaker": "恭敬的男性贵族",
        "content": "哎，伯爵说的是，等到来年收成的时候，请赏脸光顾寒舍，多伦郡最大的风车和面粉的香气一定让您流连忘返。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"avg_npc_170_1\")]",
        "type": "character",
        "name": "avg_npc_170_1.png"
    },
    {
        "id": 38,
        "raw": "[name=\"文森特伯爵\"]  没问题，这场风雪过后，来年一定会大丰收的吧。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "没问题，这场风雪过后，来年一定会大丰收的吧。"
    },
    {
        "id": 39,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 40,
        "raw": "[name=\"恭敬的男性贵族\"]  承您吉言。",
        "type": "dialog",
        "speaker": "恭敬的男性贵族",
        "content": "承您吉言。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"avg_npc_170_1\")]",
        "type": "character",
        "name": "avg_npc_170_1.png"
    },
    {
        "id": 42,
        "raw": "[name=\"文森特伯爵\"]  快进去烤火吧，晚上有您最爱的香料面包——当然，最细腻、最香甜的小麦粉，都是出自您的农场。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "快进去烤火吧，晚上有您最爱的香料面包——当然，最细腻、最香甜的小麦粉，都是出自您的农场。"
    },
    {
        "id": 43,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 44,
        "raw": "[name=\"恭敬的男性贵族\"]  那您呢？您不进来吗？时间快到了……剩下的客人，就交给佣人们吧。",
        "type": "dialog",
        "speaker": "恭敬的男性贵族",
        "content": "那您呢？您不进来吗？时间快到了……剩下的客人，就交给佣人们吧。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_170_1\")]",
        "type": "character",
        "name": "avg_npc_170_1.png"
    },
    {
        "id": 46,
        "raw": "[name=\"文森特伯爵\"]  也许您说得对，但是没关系，我喜欢亲自迎接我邀请的人，他们都是可爱的人，无论是贵族还是商人，是修士还是士兵。",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "也许您说得对，但是没关系，我喜欢亲自迎接我邀请的人，他们都是可爱的人，无论是贵族还是商人，是修士还是士兵。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_170_1#3\")]",
        "type": "character",
        "name": "avg_npc_170_1#3.png"
    },
    {
        "id": 48,
        "raw": "[name=\"文森特伯爵\"]  多伦郡真是个好地方，不是吗？",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "多伦郡真是个好地方，不是吗？"
    },
    {
        "id": 49,
        "raw": "[character]",
        "type": "character"
    },
    {
        "id": 50,
        "raw": "[name=\"恭敬的男性贵族\"]  哦，您真是……",
        "type": "dialog",
        "speaker": "恭敬的男性贵族",
        "content": "哦，您真是……"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_170_1#2\")]",
        "type": "character",
        "name": "avg_npc_170_1#2.png"
    },
    {
        "id": 52,
        "raw": "[name=\"文森特伯爵\"]  喔，我看看，还有亚利桑那家的夫妇，那位可敬的灯塔守望者，还有……嗯？",
        "type": "dialog",
        "speaker": "文森特伯爵",
        "content": "喔，我看看，还有亚利桑那家的夫妇，那位可敬的灯塔守望者，还有……嗯？"
    },
