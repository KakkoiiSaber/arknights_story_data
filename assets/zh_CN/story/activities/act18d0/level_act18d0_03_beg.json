        "type": "character",
        "name": "avg_npc_170_1.png",
        "name2": "avg_npc_169_1",
        "focus": 2
    },
    {
        "id": 104,
        "raw": "[name=\"海蒂\"]  老毛病啦，等到冬天过去，又能活蹦乱跳啦。",
        "type": "dialog",
        "speaker": "海蒂",
        "content": "老毛病啦，等到冬天过去，又能活蹦乱跳啦。"
