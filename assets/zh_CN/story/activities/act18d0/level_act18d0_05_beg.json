        "focus": 2
    },
    {
        "id": 73,
        "raw": "[name=\"“沙卒”\"]  呵，看来你还是不愿意信任我，谨慎的小姐，你以前是军人吗，萨尔贡的军人？",
        "type": "dialog",
        "speaker": "“沙卒”",
        "content": "呵，看来你还是不愿意信任我，谨慎的小姐，你以前是军人吗，萨尔贡的军人？"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_304_hvrain\", name2=\"avg_npc_172_1\", focus=1)]",
        "type": "character",
        "name": "char_304_hvrain.png",
        "name2": "avg_npc_172_1",
        "focus": 1
    },
    {
        "id": 75,
        "raw": "[name=\"暴雨\"]  ——与你无关。",
        "type": "dialog",
        "speaker": "暴雨",
        "content": "——与你无关。"
    },
    {
