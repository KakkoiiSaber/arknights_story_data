        "name2": "char_379_sesa_1#2",
        "focus": 2
    },
    {
        "id": 216,
        "raw": "[name=\"慑砂\"]  ——为了确保你不是一个真的疯子或是战争狂什么的。",
        "type": "dialog",
        "speaker": "慑砂",
        "content": "——为了确保你不是一个真的疯子或是战争狂什么的。"
