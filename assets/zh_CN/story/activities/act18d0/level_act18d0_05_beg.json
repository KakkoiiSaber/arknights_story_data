    {
        "id": 190,
        "raw": "[name=\"暴雨\"]  ——是你的人？",
        "type": "dialog",
        "speaker": "暴雨",
        "content": "——是你的人？"
    },
    {
        "id": 191,
        "raw": "[Character(name=\"char_304_hvrain#4\", name2=\"avg_npc_172_1#3\", focus=2)]",
        "type": "character",
        "name": "char_304_hvrain#4.png",
        "name2": "avg_npc_172_1#3",
        "focus": 2
    },
    {
        "id": 192,
        "raw": "[name=\"“沙卒”\"]  怎么会呢，我如今可是孤家寡人了。人可没有机械值得信赖。",
        "type": "dialog",
        "speaker": "“沙卒”",
        "content": "怎么会呢，我如今可是孤家寡人了。人可没有机械值得信赖。"
    },
    {
        "id": 193,
        "raw": "[name=\"“沙卒”\"]  不过，他们大概都是冲着我来的。",
        "type": "dialog",
        "speaker": "“沙卒”",
        "content": "不过，他们大概都是冲着我来的。"
