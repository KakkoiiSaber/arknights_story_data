    },
    {
        "id": 49,
        "raw": "[name=\"暴雨\"]  ——你、你杀死了一位王酋......？",
        "type": "dialog",
        "speaker": "暴雨",
        "content": "——你、你杀死了一位王酋......？"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"avg_npc_172_1#3\", name2=\"char_379_sesa_1#3\", focus=2)]",
        "type": "character",
        "name": "avg_npc_172_1#3.png",
        "name2": "char_379_sesa_1#3",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"慑砂\"]  萨尔贡的军队会找上你——",
        "type": "dialog",
        "speaker": "慑砂",
        "content": "萨尔贡的军队会找上你——"
    },
