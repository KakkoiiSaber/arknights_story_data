    {
        "id": 239,
        "raw": "[name=\"格拉尼\"]   是这种印着卡西米尔徽章的金币吧？",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "是这种印着卡西米尔徽章的金币吧？"
    },
    {
        "id": 240,
