        "name": "avg_npc_005"
    },
    {
        "id": 161,
        "raw": "[name=\"村民\"]   可萝尔你没事吧？真是苦了你了。",
        "type": "dialog",
        "speaker": "村民",
        "content": "可萝尔你没事吧？真是苦了你了。"
    },
    {
