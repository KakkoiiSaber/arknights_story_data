        "name2": "avg_npc_005",
        "focus": 1
    },
    {
        "id": 163,
        "raw": "[name=\"可萝尔\"]   卢克大叔，多谢你，我现在好多了。",
        "type": "dialog",
        "speaker": "可萝尔",
        "content": "卢克大叔，多谢你，我现在好多了。"
    },
    {
        "id": 164,
