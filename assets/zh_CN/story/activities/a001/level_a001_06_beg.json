        "focus": 1
    },
    {
        "id": 156,
        "raw": "[name=\"斯卡蒂\"]   你为什么要用这种没有威力的爆破物？",
        "type": "dialog",
        "speaker": "斯卡蒂",
        "content": "你为什么要用这种没有威力的爆破物？"
    },
    {
        "id": 157,
        "raw": "[Character(name=\"avg_npc_010#2\")]",
        "type": "character",
        "name": "avg_npc_010#2.png"
    },
    {
        "id": 158,
        "raw": "[name=\"大鲍勃\"]   还给她的人情。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "还给她的人情。"
    },
    {
        "id": 159,
        "raw": "[name=\"大鲍勃\"]   接下来，就要用真的了。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "接下来，就要用真的了。"
    },
    {
