        "type": "character",
        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 161,
        "raw": "[name=\"格拉尼\"]   斯卡蒂。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "斯卡蒂。"
    },
    {
        "id": 162,
        "raw": "[name=\"格拉尼\"]   你不关心宝藏。而且，你也不想伤害可萝尔小姐。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "你不关心宝藏。而且，你也不想伤害可萝尔小姐。"
    },
    {
