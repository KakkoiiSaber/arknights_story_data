        "name": "avg_npc_010#2.png",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"格拉尼\"]   抱歉大鲍勃，我已经接下委托了。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "抱歉大鲍勃，我已经接下委托了。"
    },
    {
        "id": 57,
        "raw": "[name=\"格拉尼\"]   我只有一个任务，就是把这份宝藏交给可萝尔，帮助她让村子恢复平静。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "我只有一个任务，就是把这份宝藏交给可萝尔，帮助她让村子恢复平静。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_263_skadi#2\")]",
        "type": "character",
        "name": "char_263_skadi#2.png"
    },
    {
        "id": 59,
        "raw": "[name=\"斯卡蒂\"]   别的与我无关，把可萝尔交给我。",
        "type": "dialog",
        "speaker": "斯卡蒂",
        "content": "别的与我无关，把可萝尔交给我。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_263_skadi#2\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_263_skadi#2",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"大鲍勃\"]   那你要那个女孩干什么，怪物？",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "那你要那个女孩干什么，怪物？"
    },
    {
        "id": 62,
        "raw": "[name=\"大鲍勃\"]   你难道想要剥掉她的皮，喝掉她的血吗？",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "你难道想要剥掉她的皮，喝掉她的血吗？"
    },
    {
        "id": 63,
        "raw": "[name=\"大鲍勃\"]   在这之前，你也听这个小个子说过了，不管怎么样，她都不会把村长交给你的！",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "在这之前，你也听这个小个子说过了，不管怎么样，她都不会把村长交给你的！"
    },
    {
        "id": 64,
        "raw": "[name=\"大鲍勃\"]   但我不一样，我只要宝藏。我根本不会伤害她！",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "但我不一样，我只要宝藏。我根本不会伤害她！"
    },
