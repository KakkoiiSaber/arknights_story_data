        "id": 100,
        "raw": "[Character(name=\"char_220_grani#5\")]",
        "type": "character",
        "name": "char_220_grani#5.png"
    },
    {
        "id": 101,
        "raw": "[name=\"格拉尼\"]   虽然没什么自信，但如果要同时和你们开战，我能做到。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "虽然没什么自信，但如果要同时和你们开战，我能做到。"
    },
    {
