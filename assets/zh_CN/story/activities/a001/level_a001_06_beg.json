        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 105,
        "raw": "[name=\"格拉尼\"]   不。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "不。"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"avg_npc_010#2\",name2=\"char_220_grani#5\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010#2.png",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
