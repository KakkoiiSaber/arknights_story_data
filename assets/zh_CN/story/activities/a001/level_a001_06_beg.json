        "type": "character",
        "name": "char_263_skadi#2.png"
    },
    {
        "id": 109,
        "raw": "[name=\"斯卡蒂\"]   说完了没？",
        "type": "dialog",
        "speaker": "斯卡蒂",
        "content": "说完了没？"
