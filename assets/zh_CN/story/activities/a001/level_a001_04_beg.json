        "id": 83,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010.png"
    },
    {
        "id": 84,
        "raw": "[name=\"大鲍勃\"]   哼，哈哈哈哈。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "哼，哈哈哈哈。"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"avg_npc_003\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "avg_npc_003",
        "focus": 2
    },
    {
        "id": 86,
        "raw": "[name=\"可萝尔\"]   鲍勃先生，我没有嫌恶你的意思，只是我刚才……还是有些害怕。",
        "type": "dialog",
        "speaker": "可萝尔",
        "content": "鲍勃先生，我没有嫌恶你的意思，只是我刚才……还是有些害怕。"
    },
    {
        "id": 87,
        "raw": "[name=\"可萝尔\"]   我是个乡下人，没有亲眼见过感染者，但我多少还是能看出来……你是有苦衷的人。",
        "type": "dialog",
        "speaker": "可萝尔",
        "content": "我是个乡下人，没有亲眼见过感染者，但我多少还是能看出来……你是有苦衷的人。"
    },
    {
        "id": 88,
        "raw": "[name=\"可萝尔\"]   如果我之前有什么冒犯的地方，请见谅。",
        "type": "dialog",
        "speaker": "可萝尔",
        "content": "如果我之前有什么冒犯的地方，请见谅。"
    },
