        "name2": "avg_npc_003",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"大鲍勃\"]   你再向前走一步，大概就会掉进满是尖头的深坑了。",
        "type": "dialog",
        "speaker": "大鲍勃",
