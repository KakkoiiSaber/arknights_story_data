    {
        "id": 13,
        "raw": "[name=\"赏金猎人\"]   我、我把金币都给你！我把我的武器给你！你要什么我都——",
        "type": "dialog",
        "speaker": "赏金猎人",
        "content": "我、我把金币都给你！我把我的武器给你！你要什么我都——"
    },
    {
        "id": 14,
        "raw": "[name=\"？？？\"]    那个女孩子在哪里。",
