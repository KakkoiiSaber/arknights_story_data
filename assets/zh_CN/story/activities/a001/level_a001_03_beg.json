        "type": "character",
        "name": "char_220_grani#3"
    },
    {
        "id": 31,
        "raw": "[name=\"格拉尼\"]   石头上是不是刻了什么？",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "石头上是不是刻了什么？"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=1)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"大鲍勃\"]   这是赏金猎人留下的符号。不按照符号指示行动的话，就会踩进设置好的陷阱。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "这是赏金猎人留下的符号。不按照符号指示行动的话，就会踩进设置好的陷阱。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#3\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010",
        "name2": "char_220_grani#3",
        "focus": 2
    },
    {
        "id": 35,
        "raw": "[name=\"格拉尼\"]   我们要直接躲开陷阱吗？",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "我们要直接躲开陷阱吗？"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_010\")]",
        "type": "character",
        "name": "avg_npc_010"
    },
    {
        "id": 37,
        "raw": "[name=\"大鲍勃\"]   看我的吧。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "看我的吧。"
    },
    {
        "id": 38,
        "raw": "[name=\"大鲍勃\"]   ——绊索加捕兽夹，老土的小把戏。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "——绊索加捕兽夹，老土的小把戏。"
    },
