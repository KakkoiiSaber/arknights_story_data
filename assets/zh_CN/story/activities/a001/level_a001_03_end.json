        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"大鲍勃\"]   你看到了吧。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "你看到了吧。"
    },
    {
