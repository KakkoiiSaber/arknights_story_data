        "name": "avg_npc_010.png",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"大鲍勃\"]   真厉害。这么小的个子，本事倒是不小。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "真厉害。这么小的个子，本事倒是不小。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"格拉尼\"]   坐在那里别动。我来给你包扎。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "坐在那里别动。我来给你包扎。"
