        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#4",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"格拉尼\"]   感染者，本来就是我们罗德岛的救助对象。",
        "type": "dialog",
        "speaker": "格拉尼",
