        "type": "character",
        "name": "avg_npc_010.png",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"大鲍勃\"]   不碍事，让我起来。",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "不碍事，让我起来。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"avg_npc_010\",name2=\"char_220_grani#5\",focus=2)]",
