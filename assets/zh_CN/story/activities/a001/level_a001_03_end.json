    },
    {
        "id": 20,
        "raw": "[name=\"大鲍勃\"]   这个我自己能处理！先击退敌人！",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "这个我自己能处理！先击退敌人！"
