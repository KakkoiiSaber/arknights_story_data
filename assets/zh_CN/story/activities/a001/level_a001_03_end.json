        "ystrength": "12,",
        "vibrato": "30,",
        "randomness": "30,",
        "fadeout": "true,",
        "block": true
    },
    {
        "id": 57,
        "raw": "[name=\"大鲍勃\"]   你看到我身上的结晶了吧？你难道想被感染吗？！",
        "type": "dialog",
        "speaker": "大鲍勃",
        "content": "你看到我身上的结晶了吧？你难道想被感染吗？！"
