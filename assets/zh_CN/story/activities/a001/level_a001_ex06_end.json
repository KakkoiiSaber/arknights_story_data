        "block": true
    },
    {
        "id": 69,
        "raw": "[name=\"凯尔希\"]   （阿戈尔语）“深海猎人血脉相连”。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "（阿戈尔语）“深海猎人血脉相连”。"
    },
