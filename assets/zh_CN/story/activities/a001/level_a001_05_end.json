    {
        "id": 93,
        "raw": "[name=\"斯卡蒂\"]   那个女孩在哪？",
        "type": "dialog",
        "speaker": "斯卡蒂",
        "content": "那个女孩在哪？"
    },
    {
        "id": 94,
