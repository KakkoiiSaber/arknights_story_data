        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#5",
        "focus": 1
    },
    {
        "id": 97,
        "raw": "[name=\"斯卡蒂\"]   盯上那东西的人不止我一个。",
        "type": "dialog",
