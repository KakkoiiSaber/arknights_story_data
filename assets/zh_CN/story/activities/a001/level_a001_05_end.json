        "name": "char_263_skadi#2.png",
        "name2": "char_220_grani#5",
        "focus": 2
    },
    {
        "id": 95,
        "raw": "[name=\"格拉尼\"]   我不能告诉你。",
        "type": "dialog",
        "speaker": "格拉尼",
        "content": "我不能告诉你。"
    },
    {
        "id": 96,
