        "name": "avg_npc_120#4.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 92,
        "raw": "[name=\"老工匠\"]  听见没！听见没！听——见——没！",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "听见没！听见没！听——见——没！"
    },
    {
        "id": 93,
