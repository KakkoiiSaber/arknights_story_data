        "name2": "avg_npc_101",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"老骑士\"]  慢不下来！我说了我没踩油门！",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "慢不下来！我说了我没踩油门！"
