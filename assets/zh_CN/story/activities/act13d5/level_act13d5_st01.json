    {
        "id": 65,
        "raw": "[name=\"玛莉娅\"]  ……是这样吧？",
        "type": "dialog",
        "speaker": "玛莉娅",
        "content": "……是这样吧？"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_120\", name2=\"avg_npc_101\", focus=2)]",
