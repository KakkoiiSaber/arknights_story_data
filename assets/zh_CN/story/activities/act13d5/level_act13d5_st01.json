        "id": 121,
        "raw": "[Character(name=\"avg_npc_120\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 122,
        "raw": "[name=\"老工匠\"]  呃？等等，七十迈了，慢——慢点啊，喂，八十迈了！超速了！超速了！",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "呃？等等，七十迈了，慢——慢点啊，喂，八十迈了！超速了！超速了！"
