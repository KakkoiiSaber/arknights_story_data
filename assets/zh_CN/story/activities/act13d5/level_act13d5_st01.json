        "name": "avg_npc_061#2.png",
        "name2": "avg_npc_101",
        "focus": 1
    },
    {
        "id": 98,
        "raw": "[name=\"玛莉娅\"]  我？",
        "type": "dialog",
        "speaker": "玛莉娅",
        "content": "我？"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"avg_npc_061#2\", name2=\"avg_npc_101\", focus=1)]",
        "type": "character",
        "name": "avg_npc_061#2.png",
        "name2": "avg_npc_101",
        "focus": 1
    },
    {
        "id": 100,
        "raw": "[name=\"玛莉娅\"]  我……我接下来有别的事情啦。",
        "type": "dialog",
        "speaker": "玛莉娅",
        "content": "我……我接下来有别的事情啦。"
