        "name": "avg_npc_120.png",
        "name2": "avg_npc_101",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"老工匠\"]  啧啧，每次看丫头捏着光的样子，都会让人想起她爷爷。",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "啧啧，每次看丫头捏着光的样子，都会让人想起她爷爷。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_120#4\", name2=\"avg_npc_101\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#4.png",
        "name2": "avg_npc_101",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"老骑士\"]  就是！瞅瞅人家玛莉娅！你怎么就屁点源石技艺不懂呢。",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "就是！瞅瞅人家玛莉娅！你怎么就屁点源石技艺不懂呢。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_120#4\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#4.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"老工匠\"]  谁说我不会修源石装置的！？",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "谁说我不会修源石装置的！？"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"avg_npc_120\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 73,
        "raw": "[name=\"老骑士\"]  我说的是——",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "我说的是——"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"avg_npc_061#2\", name2=\"avg_npc_101#4\", focus=2)]",
        "type": "character",
        "name": "avg_npc_061#2.png",
        "name2": "avg_npc_101#4",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"老工匠\"]  玛莉娅！让让！今天我要让这个老家伙开开眼！",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "玛莉娅！让让！今天我要让这个老家伙开开眼！"
    },
    {
