        "type": "character",
        "name": "avg_npc_120.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 94,
        "raw": "[name=\"老骑士\"]  嘁，别啰嗦，上车。",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "嘁，别啰嗦，上车。"
