    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_120\",fadetime=1,block=true)]",
        "type": "character",
        "name": "avg_npc_120.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 17,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 18,
        "raw": "[name=\"老骑士\"]  啊……我们还赶得上晚上的酒会不？",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "啊……我们还赶得上晚上的酒会不？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_120\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"老工匠\"]  赶不上也是你的错，老弗。",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "赶不上也是你的错，老弗。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"老骑士\"]  我的错？哈！我的错？",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "我的错？哈！我的错？"
    },
    {
        "id": 23,
        "raw": "[name=\"老骑士\"]  你非要带着你的破箱子，足足三十公斤！你是嫌自己不够胖吗？",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "你非要带着你的破箱子，足足三十公斤！你是嫌自己不够胖吗？"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"老工匠\"]  这是帮马丁修东西的工具！好，所以这就是你撞在树上的借口？",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "这是帮马丁修东西的工具！好，所以这就是你撞在树上的借口？"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"老骑士\"]  不要质疑我的方向感！",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "不要质疑我的方向感！"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"老工匠\"]  我说的是你老眼昏花……",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "我说的是你老眼昏花……"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_120#3\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#3.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"老骑士\"]  你忘了上星期我是怎么夺得酒吧飞镖冠军的吗？你瞎了我都不会眼花的。",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "你忘了上星期我是怎么夺得酒吧飞镖冠军的吗？你瞎了我都不会眼花的。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_120#3\", name2=\"avg_npc_101#4\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#3.png",
        "name2": "avg_npc_101#4",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"老工匠\"]  我瞎不了，所以我清清楚楚提醒过你，“前面那有棵树”。",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "我瞎不了，所以我清清楚楚提醒过你，“前面那有棵树”。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_120#3\", name2=\"avg_npc_101#4\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#3.png",
        "name2": "avg_npc_101#4",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"老骑士\"]  我怎么不记得？",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "我怎么不记得？"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_120#3\", name2=\"avg_npc_101#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#3.png",
        "name2": "avg_npc_101#2",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"老工匠\"]  因为音响的声音太大了！",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "因为音响的声音太大了！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"老骑士\"]  那是谁把塞壬的新碟放进去的？",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "那是谁把塞壬的新碟放进去的？"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"avg_npc_120#2\", name2=\"avg_npc_101\", focus=2)]",
        "type": "character",
        "name": "avg_npc_120#2.png",
        "name2": "avg_npc_101",
        "focus": 2
    },
    {
        "id": 41,
        "raw": "[name=\"老工匠\"]  ……别嚷嚷，让丫头专心检查！",
        "type": "dialog",
        "speaker": "老工匠",
        "content": "……别嚷嚷，让丫头专心检查！"
    },
    {
        "id": 42,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 43,
        "raw": "[Character]",
        "type": "character"
