        "name2": "avg_npc_101#2",
        "focus": 1
    },
    {
        "id": 120,
        "raw": "[name=\"老骑士\"]  我年轻时候的冲刺可比这还快！而且其实我没踩油门！",
        "type": "dialog",
        "speaker": "老骑士",
        "content": "我年轻时候的冲刺可比这还快！而且其实我没踩油门！"
    },
