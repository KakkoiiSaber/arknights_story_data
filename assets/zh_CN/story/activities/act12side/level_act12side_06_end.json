        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"陈\"]什么问题？",
        "type": "dialog",
        "speaker": "陈",
        "content": "什么问题？"
    },
    {
        "id": 28,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=2)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"林雨霞\"]既然我们认为埃内斯托有问题，而他又在我们后面，其实我们应该以他为优先。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "既然我们认为埃内斯托有问题，而他又在我们后面，其实我们应该以他为优先。"
    },
    {
        "id": 30,
        "raw": "[character(name=\"avg_1013_spchen_1#2\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#2",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"陈\"]有一定道理。",
        "type": "dialog",
        "speaker": "陈",
        "content": "有一定道理。"
    },
    {
        "id": 32,
        "raw": "[character(name=\"avg_1013_spchen_1#1\",name2=\"avg_npc_196_1#1\",focus=1)]",
        "type": "character",
        "name": "avg_1013_spchen_1#1",
        "name2": "avg_npc_196_1#1",
        "focus": 1
    },
    {
        "id": 33,
        "raw": "[name=\"陈\"]但我们依然不能确定他就有问题。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但我们依然不能确定他就有问题。"
    },
    {
        "id": 34,
        "raw": "[name=\"陈\"]而且，无论这背后是谁，很明显，对方都不希望我们赢得比赛。",
        "type": "dialog",
        "speaker": "陈",
        "content": "而且，无论这背后是谁，很明显，对方都不希望我们赢得比赛。"
    },
    {
        "id": 35,
        "raw": "[name=\"陈\"]但赢得比赛这个目的太宽泛了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但赢得比赛这个目的太宽泛了。"
    },
