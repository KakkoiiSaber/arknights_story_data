    {
        "id": 23,
        "raw": "[name=\"黎\"]......夕？",
        "type": "dialog",
        "speaker": "黎",
        "content": "......夕？"
    },
    {
        "id": 24,
        "raw": "[name=\"黎\"]你怎么来了......",
        "type": "dialog",
        "speaker": "黎",
        "content": "你怎么来了......"
    },
    {
        "id": 25,
        "raw": "[name=\"夕\"]你好像一点都不吃惊。",
        "type": "dialog",
        "speaker": "夕",
        "content": "你好像一点都不吃惊。"
    },
    {
        "id": 26,
        "raw": "[name=\"黎\"]活到这把岁数，吃惊的情况，就少多啦......咳咳，不过和你说这个，还是小巫见大巫咯。",
        "type": "dialog",
        "speaker": "黎",
        "content": "活到这把岁数，吃惊的情况，就少多啦......咳咳，不过和你说这个，还是小巫见大巫咯。"
    },
    {
        "id": 27,
        "raw": "[name=\"黎\"]我们......有多少年没见过了？",
        "type": "dialog",
        "speaker": "黎",
        "content": "我们......有多少年没见过了？"
    },
    {
        "id": 28,
        "raw": "[name=\"夕\"]记不得了，几十年吧。",
        "type": "dialog",
        "speaker": "夕",
        "content": "记不得了，几十年吧。"
    },
    {
        "id": 29,
        "raw": "[name=\"黎\"]......你可是夕。",
        "type": "dialog",
        "speaker": "黎",
        "content": "......你可是夕。"
    },
    {
        "id": 30,
        "raw": "[name=\"黎\"]你竟然还记得我。",
        "type": "dialog",
        "speaker": "黎",
        "content": "你竟然还记得我。"
    },
    {
        "id": 31,
        "raw": "[name=\"夕\"]你怎么知道你不是在我的画里，度过了你这一生？",
        "type": "dialog",
        "speaker": "夕",
        "content": "你怎么知道你不是在我的画里，度过了你这一生？"
    },
    {
        "id": 32,
        "raw": "[name=\"黎\"]不会的。",
        "type": "dialog",
        "speaker": "黎",
        "content": "不会的。"
    },
    {
        "id": 33,
        "raw": "[name=\"夕\"]你很自信嘛。",
        "type": "dialog",
        "speaker": "夕",
        "content": "你很自信嘛。"
    },
    {
        "id": 34,
        "raw": "[name=\"黎\"]夕，你救过我，我在你的画里生活过那么长的时间......我分得清。",
        "type": "dialog",
        "speaker": "黎",
        "content": "夕，你救过我，我在你的画里生活过那么长的时间......我分得清。"
    },
