        "name2": "char_201_moeshd#3",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"可颂\"]  ......该说不愧是你吗，一旦涉及到战斗，就完全变了个人呢。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "......该说不愧是你吗，一旦涉及到战斗，就完全变了个人呢。"
