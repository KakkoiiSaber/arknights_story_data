    {
        "id": 35,
        "raw": "[name=\"？？？\"]  不要忘了，我们是为了什么才成立的“嘉维尔意志”！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "不要忘了，我们是为了什么才成立的“嘉维尔意志”！"
    },
    {
        "id": 36,
        "raw": "[name=\"？？？\"]  “嘉维尔意志”不只是一个部族，是我们所有希望嘉维尔成为大酋长的人的联盟！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "“嘉维尔意志”不只是一个部族，是我们所有希望嘉维尔成为大酋长的人的联盟！"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"avg_npc_070\")]",
        "type": "character",
        "name": "avg_npc_070.png"
    },
    {
        "id": 38,
        "raw": "[name=\"族长B\"]  我支持特米米，我只认嘉维尔做大酋长。",
        "type": "dialog",
        "speaker": "族长B",
        "content": "我支持特米米，我只认嘉维尔做大酋长。"
