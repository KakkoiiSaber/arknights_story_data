        "type": "character",
        "name": "avg_npc_071.png"
    },
    {
        "id": 40,
        "raw": "[name=\"族长A\"]  没错，嘉维尔才是应该领导我们的人！",
        "type": "dialog",
        "speaker": "族长A",
        "content": "没错，嘉维尔才是应该领导我们的人！"
