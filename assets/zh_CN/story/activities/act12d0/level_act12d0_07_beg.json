    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071.png",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"阿达克利斯人B\"]  飞哪儿去了？",
        "type": "dialog",
        "speaker": "阿达克利斯人B",
        "content": "飞哪儿去了？"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=1)]",
        "type": "character",
        "name": "avg_npc_071.png",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"阿达克利斯人A\"]  不知道，反正待会儿就跑回来了吧，我们继续。",
        "type": "dialog",
        "speaker": "阿达克利斯人A",
        "content": "不知道，反正待会儿就跑回来了吧，我们继续。"
    },
    {
        "id": 23,
        "raw": "[name=\"阿达克利斯人A\"]  那么，这根管子该接哪里呢——",
        "type": "dialog",
        "speaker": "阿达克利斯人A",
        "content": "那么，这根管子该接哪里呢——"
    },
    {
        "id": 24,
        "raw": "[name=\"阿达克利斯人A\"]  哈哈，这个接口长的很正点啊，就插你了！",
        "type": "dialog",
        "speaker": "阿达克利斯人A",
        "content": "哈哈，这个接口长的很正点啊，就插你了！"
    },
    {
        "id": 25,
        "raw": "[name=\"阿达克利斯人A\"]  喂，能发动吗？",
        "type": "dialog",
        "speaker": "阿达克利斯人A",
        "content": "喂，能发动吗？"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_071\", name2=\"avg_npc_070\", focus=2)]",
        "type": "character",
        "name": "avg_npc_071.png",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"阿达克利斯人B\"]  不行啊，你到底会不会啊！",
        "type": "dialog",
        "speaker": "阿达克利斯人B",
        "content": "不行啊，你到底会不会啊！"
    },
    {
        "id": 28,
