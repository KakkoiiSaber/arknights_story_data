    {
        "id": 19,
        "raw": "[name=\"特米米\"]  啊，是佩塔赢了。",
        "type": "dialog",
        "speaker": "特米米",
        "content": "啊，是佩塔赢了。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"嘉维尔\"]  这个叫佩塔的家伙挺能干啊，我都想和他打一架了。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "这个叫佩塔的家伙挺能干啊，我都想和他打一架了。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_411_tomimi_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1",
        "name2": "char_411_tomimi_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"特米米\"]  嗯，他是我的部族的勇士。",
        "type": "dialog",
        "speaker": "特米米",
        "content": "嗯，他是我的部族的勇士。"
    },
    {
        "id": 24,
        "raw": "[name=\"特米米\"]  但是，他肯定没有嘉维尔厉害。",
        "type": "dialog",
        "speaker": "特米米",
        "content": "但是，他肯定没有嘉维尔厉害。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_411_tomimi_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3",
        "name2": "char_411_tomimi_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"嘉维尔\"]  哈哈，那可说不好呢。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "哈哈，那可说不好呢。"
    },
    {
        "id": 27,
