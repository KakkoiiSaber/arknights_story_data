    {
        "id": 21,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 22,
        "raw": "[name=\"嘉维尔\"]  喂，他没事吧。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "喂，他没事吧。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"森蚺\"]  不用担心，等一会儿他就会回来了。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "不用担心，等一会儿他就会回来了。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"嘉维尔\"]  好吧，不过那真的是普通人吗？我没听说有这样的啊。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "好吧，不过那真的是普通人吗？我没听说有这样的啊。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"森蚺\"]  不知道，大祭司只说过他在这里生活了很久很久。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "不知道，大祭司只说过他在这里生活了很久很久。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"嘉维尔\"]  好吧，比起这个......",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "好吧，比起这个......"
    },
    {
        "id": 31,
        "raw": "[name=\"嘉维尔\"]  呼，真是个了不得的大家伙啊。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "呼，真是个了不得的大家伙啊。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer.png"
    },
    {
        "id": 33,
        "raw": "[name=\"煌\"]  嘉维尔，你头上在流血啊，没事吧。",
        "type": "dialog",
        "speaker": "煌",
        "content": "嘉维尔，你头上在流血啊，没事吧。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 35,
        "raw": "[name=\"嘉维尔\"]  没事没事，这点小伤，特米米，把我的医疗包拿过来。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "没事没事，这点小伤，特米米，把我的医疗包拿过来。"
    },
    {
        "id": 36,
        "raw": "[name=\"嘉维尔\"]  嗯？特米米这丫头人呢？",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "嗯？特米米这丫头人呢？"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_337_utage_summer_1\")]",
        "type": "character",
        "name": "char_337_utage_summer_1.png"
    },
    {
        "id": 38,
        "raw": "[name=\"宴\"]  给，你的医疗包。至于特米米，刚才快要赢的时候我好像看到她慌慌张张地往其他地方跑去了。",
        "type": "dialog",
        "speaker": "宴",
        "content": "给，你的医疗包。至于特米米，刚才快要赢的时候我好像看到她慌慌张张地往其他地方跑去了。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 40,
        "raw": "[name=\"嘉维尔\"]  谢了。她不会被吓破胆了吧，算了，先包扎再说。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "谢了。她不会被吓破胆了吧，算了，先包扎再说。"
    },
    {
        "id": 41,
        "raw": "[name=\"嘉维尔\"]  对了，你们去看看有没有受伤的家伙，全部带到我这来，我来给他们治疗。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "对了，你们去看看有没有受伤的家伙，全部带到我这来，我来给他们治疗。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_2013_cerber_1\")]",
        "type": "character",
        "name": "char_2013_cerber_1.png"
    },
    {
        "id": 43,
        "raw": "[name=\"刻俄柏\"]  噢，交给我吧！",
        "type": "dialog",
        "speaker": "刻俄柏",
        "content": "噢，交给我吧！"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_017_homura_summer\")]",
        "type": "character",
        "name": "char_017_homura_summer.png"
    },
    {
        "id": 45,
        "raw": "[name=\"煌\"]  哈哈，没问题。",
        "type": "dialog",
        "speaker": "煌",
        "content": "哈哈，没问题。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_337_utage_summer_1#3\")]",
        "type": "character",
        "name": "char_337_utage_summer_1#3.png"
    },
    {
        "id": 47,
        "raw": "[name=\"宴\"]  诶，好麻烦啊。",
        "type": "dialog",
        "speaker": "宴",
        "content": "诶，好麻烦啊。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_201_moeshd_summer\")]",
        "type": "character",
        "name": "char_201_moeshd_summer.png"
    },
    {
        "id": 49,
        "raw": "[name=\"可颂\"]  别抱怨啦。",
        "type": "dialog",
        "speaker": "可颂",
        "content": "别抱怨啦。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_187_ccheal_1\")]",
        "type": "character",
        "name": "char_187_ccheal_1.png"
    },
    {
        "id": 51,
        "raw": "[name=\"嘉维尔\"]  博士......嗯？",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "博士......嗯？"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_416_zumama_1\")]",
        "type": "character",
        "name": "char_416_zumama_1.png"
    },
    {
        "id": 53,
        "raw": "[name=\"森蚺\"]  大丑......",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "大丑......"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"嘉维尔\"]  祖玛玛，抱歉啊，只能把它拆掉了。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "祖玛玛，抱歉啊，只能把它拆掉了。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"森蚺\"]  我知道。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "我知道。"
    },
    {
        "id": 58,
        "raw": "[name=\"森蚺\"]  我检查了一下，你的引擎还能用，我会把它还给你。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "我检查了一下，你的引擎还能用，我会把它还给你。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"嘉维尔\"]  是吗，太好了！",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "是吗，太好了！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_187_ccheal_1\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 62,
        "raw": "[name=\"森蚺\"]  嘉维尔，你不打算留下来吗？",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "嘉维尔，你不打算留下来吗？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"嘉维尔\"]  嗯，我和你一样，找到了要做的事。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "嗯，我和你一样，找到了要做的事。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"森蚺\"]  是医生吗？",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "是医生吗？"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 68,
        "raw": "[name=\"嘉维尔\"]  是啊。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "是啊。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 70,
        "raw": "[name=\"森蚺\"]  做医生很开心吗？",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "做医生很开心吗？"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 72,
        "raw": "[name=\"嘉维尔\"]  造机器很开心吗？",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "造机器很开心吗？"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_187_ccheal_1#3\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#3.png",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"森蚺\"]  开心。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "开心。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1#5\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#5.png",
        "name2": "char_416_zumama_1#5",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"嘉维尔\"]  那就是了。",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "那就是了。"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_187_ccheal_1#5\", name2=\"char_416_zumama_1\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#5.png",
        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 78,
        "raw": "[name=\"森蚺\"]  但是，大酋长依然需要你来做。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "但是，大酋长依然需要你来做。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1\", focus=1)]",
        "type": "character",
        "name": "char_187_ccheal_1#2.png",
        "name2": "char_416_zumama_1",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"嘉维尔\"]  哈？",
        "type": "dialog",
        "speaker": "嘉维尔",
        "content": "哈？"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_187_ccheal_1#2\", name2=\"char_416_zumama_1#5\", focus=2)]",
        "type": "character",
        "name": "char_187_ccheal_1#2.png",
        "name2": "char_416_zumama_1#5",
        "focus": 2
    },
    {
        "id": 82,
        "raw": "[name=\"森蚺\"]  无论如何，大丑倒下了是事实，你赢了，嘉维尔。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "无论如何，大丑倒下了是事实，你赢了，嘉维尔。"
    },
    {
        "id": 83,
        "raw": "[name=\"森蚺\"]  看，人群重新聚集了起来，大家都在看着你。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "看，人群重新聚集了起来，大家都在看着你。"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_187_ccheal_1#2\")]",
        "type": "character",
        "name": "char_187_ccheal_1#2.png"
    },
