        "name2": "char_416_zumama_1",
        "focus": 2
    },
    {
        "id": 125,
        "raw": "[name=\"森蚺\"]  我告诉过他们很多次不要靠近矿区深处。",
        "type": "dialog",
        "speaker": "森蚺",
        "content": "我告诉过他们很多次不要靠近矿区深处。"
