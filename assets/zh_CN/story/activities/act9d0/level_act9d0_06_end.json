        "time": 1
    },
    {
        "id": 16,
        "raw": "[name=\"赦罪师\"]  报告，我看过了。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "报告，我看过了。"
    },
    {
        "id": 17,
        "raw": "[name=\"赦罪师\"]  你们在整合运动那里取得的成果，实在令人难以恭维。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "你们在整合运动那里取得的成果，实在令人难以恭维。"
    },
    {
        "id": 18,
        "raw": "[name=\"赦罪师\"]  但，即使如此，你们也的确找到了一些预料之外的收获。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "但，即使如此，你们也的确找到了一些预料之外的收获。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"赫德雷\"]  感谢——",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "感谢——"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 22,
        "raw": "[name=\"赦罪师\"]  啊啊，不用道谢，至少这次还不用。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "啊啊，不用道谢，至少这次还不用。"
    },
    {
        "id": 23,
        "raw": "[name=\"赦罪师\"]  你们也都是优秀的战士，在死前，你们任何的奖赏都是你们的血与火所夺来的。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "你们也都是优秀的战士，在死前，你们任何的奖赏都是你们的血与火所夺来的。"
    },
    {
        "id": 24,
        "raw": "[name=\"赦罪师\"]  摄政王殿下熟知每一个微不足道的萨卡兹所践行的轨迹，即使你们太过微不足道。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "摄政王殿下熟知每一个微不足道的萨卡兹所践行的轨迹，即使你们太过微不足道。"
    },
    {
        "id": 25,
        "raw": "[name=\"赦罪师\"]  在这座殿堂里逐渐失去价值的，不光是那些感染者，你明白吗？",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "在这座殿堂里逐渐失去价值的，不光是那些感染者，你明白吗？"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"赫德雷\"]  ......我明白。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "......我明白。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 29,
        "raw": "[name=\"赦罪师\"]  嗯。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "嗯。"
    },
    {
        "id": 30,
        "raw": "[name=\"赦罪师\"]  如果我所猜没错，罗德岛如今已经迎回了那个让人不快的人。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "如果我所猜没错，罗德岛如今已经迎回了那个让人不快的人。"
    },
    {
        "id": 31,
        "raw": "[name=\"赦罪师\"]  至于你们......你们应该有所接触。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "至于你们......你们应该有所接触。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_047\")]",
        "type": "character",
        "name": "avg_npc_047.png"
    },
    {
        "id": 33,
        "raw": "[name=\"赫德雷\"]  ——！",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "——！"
    },
    {
        "id": 34,
        "raw": "[name=\"赫德雷\"]  （摄政王比W还更快一步？在这么遥远的伦蒂尼姆——？）",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "（摄政王比W还更快一步？在这么遥远的伦蒂尼姆——？）"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 36,
        "raw": "[name=\"赦罪师\"]  雇佣兵仅仅效忠于利益。这种出发点，未必是什么坏事。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "雇佣兵仅仅效忠于利益。这种出发点，未必是什么坏事。"
    },
    {
        "id": 37,
        "raw": "[name=\"赦罪师\"]  等到尘埃落定，回到殿下的座前——",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "等到尘埃落定，回到殿下的座前——"
    },
    {
        "id": 38,
        "raw": "[name=\"赦罪师\"]  ——你就可以赢得你的奖赏。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "——你就可以赢得你的奖赏。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"赫德雷\"]  ......那其他的战士们？",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "......那其他的战士们？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 42,
        "raw": "[name=\"赦罪师\"]  那位感染者青年有她自己的手腕，你们还没有发觉吗？",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "那位感染者青年有她自己的手腕，你们还没有发觉吗？"
    },
    {
        "id": 43,
        "raw": "[name=\"赦罪师\"]  但殿下已无心深入这场闹剧，殿下与我自有判断，维多利亚将持续观望整合运动。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "但殿下已无心深入这场闹剧，殿下与我自有判断，维多利亚将持续观望整合运动。"
    },
    {
        "id": 44,
        "raw": "[name=\"赦罪师\"]  我们缺乏从W手里夺回那支队伍控制权的......“高效手段”。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "我们缺乏从W手里夺回那支队伍控制权的......“高效手段”。"
    },
    {
        "id": 45,
        "raw": "[name=\"赦罪师\"]  况且，我们依旧需要以支持者的名义，去煽动在大地各处活动的感染者们。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "况且，我们依旧需要以支持者的名义，去煽动在大地各处活动的感染者们。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"赫德雷\"]  我们仍旧要利用整合运动？我以为这样的发展会让殿下......",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "我们仍旧要利用整合运动？我以为这样的发展会让殿下......"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 49,
        "raw": "[name=\"赦罪师\"]  放弃？不不不，年轻的雇佣兵。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "放弃？不不不，年轻的雇佣兵。"
    },
    {
        "id": 50,
        "raw": "[name=\"赦罪师\"]  还不够混乱，远远不够。哪怕是远离了领袖的整合运动，也依旧能成为祸乱的根源——",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "还不够混乱，远远不够。哪怕是远离了领袖的整合运动，也依旧能成为祸乱的根源——"
    },
    {
        "id": 51,
        "raw": "[name=\"赦罪师\"]  ——以及，刚才的言论，是否可以认作是对殿下的质询？",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "——以及，刚才的言论，是否可以认作是对殿下的质询？"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"赫德雷\"]  不，不敢。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "不，不敢。"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=1)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"赦罪师\"]  无妨，抬起头来......",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "无妨，抬起头来......"
    },
    {
        "id": 56,
        "raw": "[name=\"赦罪师\"]  对了，对了。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "对了，对了。"
    },
    {
        "id": 57,
        "raw": "[name=\"赦罪师\"]  你暂时先不用回去了。漫长的路程会耽误太多时间，而那里发生的一切正在加速。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "你暂时先不用回去了。漫长的路程会耽误太多时间，而那里发生的一切正在加速。"
    },
    {
        "id": 58,
        "raw": "[name=\"赦罪师\"]  就暂且留在这里，享受你为数不多的清闲时间吧。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "就暂且留在这里，享受你为数不多的清闲时间吧。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_055\", name2=\"avg_npc_047\", focus=2)]",
        "type": "character",
        "name": "avg_npc_055.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"赫德雷\"]  ......感激不尽。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "......感激不尽。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_055\")]",
        "type": "character",
        "name": "avg_npc_055.png"
    },
    {
        "id": 62,
        "raw": "[name=\"赦罪师\"]  那么，殿下还在等我，原地解散吧。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "那么，殿下还在等我，原地解散吧。"
    },
    {
        "id": 63,
        "raw": "[name=\"赦罪师\"]  记住，先做好自己的事情，赫德雷。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "记住，先做好自己的事情，赫德雷。"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"avg_npc_047\")]",
        "type": "character",
        "name": "avg_npc_047.png"
    },
    {
        "id": 65,
        "raw": "[name=\"赫德雷\"]  明白。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "明白。"
    },
