        "id": 202,
        "raw": "[Character(name=\"avg_npc_047\")]",
        "type": "character",
        "name": "avg_npc_047.png"
    },
    {
        "id": 203,
        "raw": "[name=\"赫德雷\"]  委员会不会乐意看到这种情况发生的。他们付了不少钱，他们花了不少心思。",
        "type": "dialog",
        "speaker": "赫德雷",
