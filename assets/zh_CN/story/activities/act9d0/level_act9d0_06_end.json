        "id": 204,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 205,
        "raw": "[name=\"萨卡兹信使\"]  他们也杀了不少人。",
        "type": "dialog",
        "speaker": "萨卡兹信使",
        "content": "他们也杀了不少人。"
