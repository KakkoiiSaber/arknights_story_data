        "raw": "[name=\"孱弱的孩子\"] 噫——",
        "type": "dialog",
        "speaker": "孱弱的孩子",
        "content": "噫——"
    },
    {
        "id": 250,
        "raw": "[name=\"坚强的孩子\"] 别、别过——唔！",
        "type": "dialog",
        "speaker": "坚强的孩子",
        "content": "别、别过——唔！"
    },
    {
        "id": 251,
        "raw": "[name=\"孱弱的孩子\"] 卢布廖夫......你的腿！",
        "type": "dialog",
        "speaker": "孱弱的孩子",
        "content": "卢布廖夫......你的腿！"
