    },
    {
        "id": 78,
        "raw": "[name=\"W\"]  ——啊啊。",
        "type": "dialog",
        "speaker": "W",
        "content": "——啊啊。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 80,
        "raw": "[name=\"伊内丝\"]  W！你在干什么——！",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "W！你在干什么——！"
    },
    {
        "id": 81,
        "raw": "[name=\"伊内丝\"]  这里——风好大！",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "这里——风好大！"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 83,
        "raw": "[name=\"W\"]  还能干什么，欣赏天灾啊！",
        "type": "dialog",
        "speaker": "W",
        "content": "还能干什么，欣赏天灾啊！"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 85,
        "raw": "[name=\"伊内丝\"]  你疯了吗——",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "你疯了吗——"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_046#2",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"W\"]  你说什么？听——不——清——",
        "type": "dialog",
        "speaker": "W",
        "content": "你说什么？听——不——清——"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"avg_npc_052\", name2=\"avg_npc_046#2\", focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_046#2",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"伊内丝\"]  啧，忘了你本来就是个疯子。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "啧，忘了你本来就是个疯子。"
    },
    {
