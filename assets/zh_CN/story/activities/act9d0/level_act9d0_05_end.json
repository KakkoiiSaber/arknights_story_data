    {
        "id": 24,
        "raw": "[Character(name=\"avg_npc_047\",fadetime=1,block=true)]",
        "type": "character",
        "name": "avg_npc_047.png",
        "fadetime": "1,block=true"
    },
    {
        "id": 25,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 26,
        "raw": "[name=\"赫德雷\"]  她没有追上来。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "她没有追上来。"
    },
    {
        "id": 27,
        "raw": "[name=\"赫德雷\"]  ……如果我们真的和她正面碰上，事情就麻烦了。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "……如果我们真的和她正面碰上，事情就麻烦了。"
    },
    {
        "id": 28,
        "raw": "[name=\"赫德雷\"]  你不该对塔露拉使用法术，这也不是第一次了，我们要时常小心自己看见的东西。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "你不该对塔露拉使用法术，这也不是第一次了，我们要时常小心自己看见的东西。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"伊内丝\"]  ……塔露拉的身上一定发生了什么，这件事必须告诉W。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "……塔露拉的身上一定发生了什么，这件事必须告诉W。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"赫德雷\"]  多亏了W几次的小动作，我们已经遭到那些暴徒的猜忌了，这还不够吗？",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "多亏了W几次的小动作，我们已经遭到那些暴徒的猜忌了，这还不够吗？"
    },
    {
        "id": 33,
        "raw": "[name=\"赫德雷\"]  你到底看到了什么？",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "你到底看到了什么？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"伊内丝\"]  过去的塔露拉只是个反抗者。她把反抗的机会带给那些被解放的感染者。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "过去的塔露拉只是个反抗者。她把反抗的机会带给那些被解放的感染者。"
    },
    {
        "id": 36,
        "raw": "[name=\"伊内丝\"]  现在呢？他们几乎毫不收敛自己的欲望，单纯的破坏，滥杀。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "现在呢？他们几乎毫不收敛自己的欲望，单纯的破坏，滥杀。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"赫德雷\"]  这不足以说明什么，萨卡兹之外的种族对感染者素来如此。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "这不足以说明什么，萨卡兹之外的种族对感染者素来如此。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"伊内丝\"]  ……你不明白。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "……你不明白。"
    },
    {
        "id": 41,
        "raw": "[name=\"伊内丝\"]  我不是在说这种行为本身怎么了，我是在说这样的行为会招致什么后果……",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "我不是在说这种行为本身怎么了，我是在说这样的行为会招致什么后果……"
    },
    {
        "id": 42,
        "raw": "[name=\"伊内丝\"]  塔露拉她……在葬送整合运动，刻意的。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "塔露拉她……在葬送整合运动，刻意的。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"赫德雷\"]  ……为什么？",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "……为什么？"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"伊内丝\"]  你不觉得这个情况似曾相识吗？",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "你不觉得这个情况似曾相识吗？"
    },
    {
        "id": 47,
        "raw": "[name=\"伊内丝\"]  她是个优秀的领袖，能将这些普通的感染者卷入战争，甚至带给他们胜利。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "她是个优秀的领袖，能将这些普通的感染者卷入战争，甚至带给他们胜利。"
    },
    {
        "id": 48,
        "raw": "[name=\"伊内丝\"]  但她，也只有她才能用最神不知鬼不觉的方法，一步步毁掉自己一手搭建起来的高塔。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "但她，也只有她才能用最神不知鬼不觉的方法，一步步毁掉自己一手搭建起来的高塔。"
    },
    {
        "id": 49,
        "raw": "[name=\"伊内丝\"]  甚至……",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "甚至……"
    },
    {
        "id": 50,
        "raw": "[name=\"伊内丝\"]  甚至塔露拉她自己，都只是其中一块比较精美的砖瓦，随时可以被粉碎。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "甚至塔露拉她自己，都只是其中一块比较精美的砖瓦，随时可以被粉碎。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"赫德雷\"]  你是在说……",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "你是在说……"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"伊内丝\"]  和三年前给我的感觉一样。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "和三年前给我的感觉一样。"
    },
    {
        "id": 55,
        "raw": "[name=\"伊内丝\"]  但他……他或许素来如此，他可以毫不犹豫地做到这一切……只是藏的很好罢了。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "但他……他或许素来如此，他可以毫不犹豫地做到这一切……只是藏的很好罢了。"
    },
    {
        "id": 56,
        "raw": "[name=\"伊内丝\"]  塔露拉不同，她的变化太突然了。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "塔露拉不同，她的变化太突然了。"
    },
    {
        "id": 57,
        "raw": "[name=\"伊内丝\"]  她的影子……她甚至有两个影子，不像是法术的痕迹，倒像是……",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "她的影子……她甚至有两个影子，不像是法术的痕迹，倒像是……"
    },
    {
        "id": 58,
        "raw": "[name=\"伊内丝\"]  一座废墟，古老，强盛，满是那种力量的残留……",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "一座废墟，古老，强盛，满是那种力量的残留……"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"赫德雷\"]  你的法术性质很特殊，尽管如此，你这次的感觉也太模糊了，这还是不构成行动的理由。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "你的法术性质很特殊，尽管如此，你这次的感觉也太模糊了，这还是不构成行动的理由。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"伊内丝\"]  但这件事W必须知道！",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "但这件事W必须知道！"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"赫德雷\"]  小声点，我们已经被注意到了。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "小声点，我们已经被注意到了。"
    },
    {
        "id": 65,
        "raw": "[name=\"赫德雷\"]  任何动作都会成为别人的把柄，你明白的。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "任何动作都会成为别人的把柄，你明白的。"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 67,
        "raw": "[name=\"伊内丝\"]  那你觉得我们还能经受住第二次巴别塔那样的变故吗？",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "那你觉得我们还能经受住第二次巴别塔那样的变故吗？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 69,
        "raw": "[name=\"赫德雷\"]  我不确定……",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "我不确定……"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"伊内丝\"]  ……至少W不能。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "……至少W不能。"
    },
    {
        "id": 72,
        "raw": "[name=\"伊内丝\"]  我去找她，既然加尔森已经死了，她就是新的领导人。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "我去找她，既然加尔森已经死了，她就是新的领导人。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=2)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 74,
        "raw": "[name=\"赫德雷\"]  等等！如果塔露拉真的已经注意到了，你这样会——",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "等等！如果塔露拉真的已经注意到了，你这样会——"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_052\",name2=\"avg_npc_047\",focus=1)]",
        "type": "character",
        "name": "avg_npc_052.png",
        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 76,
        "raw": "[name=\"伊内丝\"]  等不了，别想命令我，现在我们还是平起平坐。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "等不了，别想命令我，现在我们还是平起平坐。"
    },
    {
        "id": 77,
        "raw": "[name=\"伊内丝\"]  ……哼。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "……哼。"
    },
    {
        "id": 78,
        "raw": "[name=\"伊内丝\"]  话是这么说，这好像是我第一次抗命。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "话是这么说，这好像是我第一次抗命。"
    },
    {
        "id": 79,
        "raw": "[name=\"伊内丝\"]  你不该总是想这么多的，赫德雷。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "你不该总是想这么多的，赫德雷。"
    },
    {
        "id": 80,
        "raw": "[stopmusic(fadetime=1)]",
        "type": "stop_music",
        "fadetime": 1
    },
    {
        "id": 81,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
