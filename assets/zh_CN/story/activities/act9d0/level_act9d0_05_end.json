    },
    {
        "id": 90,
        "raw": "[name=\"伊内丝\"]  （W，就在前面，穿过这条巷子就……）",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "（W，就在前面，穿过这条巷子就……）"
    },
    {
        "id": 91,
        "raw": "[name=\"伊内丝\"]  （那里不是营地？她在做什么？）",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "（那里不是营地？她在做什么？）"
    },
    {
        "id": 92,
        "raw": "[name=\"伊内丝\"]  （总之得快一点——）",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "（总之得快一点——）"
    },
    {
        "id": 93,
        "raw": "[name=\"伊内丝\"]  ——",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "——"
    },
    {
        "id": 94,
        "raw": "[name=\"伊内丝\"]  ——谁？",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "——谁？"
    },
    {
        "id": 95,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 96,
        "raw": "[name=\"整合运动士兵\"]  ……",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "……"
    },
    {
        "id": 97,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 98,
        "raw": "[name=\"伊内丝\"]  感染者……？有什么事吗？",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "感染者……？有什么事吗？"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 100,
        "raw": "[name=\"整合运动士兵\"]  注意你的语气，魔族。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "注意你的语气，魔族。"
    },
    {
        "id": 101,
        "raw": "[name=\"整合运动士兵\"]  先是有几支佣兵队伍叛逃，接着又让敌人出现在了城内。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "先是有几支佣兵队伍叛逃，接着又让敌人出现在了城内。"
    },
    {
        "id": 102,
        "raw": "[name=\"整合运动士兵\"]  你们犯下的错误太多，你该不会以为领袖没有看在眼里吧？",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "你们犯下的错误太多，你该不会以为领袖没有看在眼里吧？"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 104,
        "raw": "[name=\"伊内丝\"]  让开，我没有义务听你抱怨。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "让开，我没有义务听你抱怨。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 106,
        "raw": "[name=\"整合运动士兵\"]  你有这个义务对塔露拉负责。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "你有这个义务对塔露拉负责。"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"avg_npc_052\")]",
        "type": "character",
        "name": "avg_npc_052.png"
    },
    {
        "id": 108,
        "raw": "[name=\"伊内丝\"]  ——我明白了，等我向W汇报完之后，我会去向塔露拉报到。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "——我明白了，等我向W汇报完之后，我会去向塔露拉报到。"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 110,
        "raw": "[name=\"整合运动士兵\"]  不必了。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "不必了。"
    },
    {
        "id": 111,
        "raw": "[name=\"整合运动士兵\"]  我们需要的不是这种“负责”。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "我们需要的不是这种“负责”。"
    },
