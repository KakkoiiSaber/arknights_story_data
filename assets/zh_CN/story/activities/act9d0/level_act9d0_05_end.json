    {
        "id": 8,
        "raw": "[Dialog(fadetime=2,block=true)]",
        "type": "dialog_marker",
        "fadetime": "2,block=true"
    },
    {
        "id": 9,
        "raw": "塔露拉变了。",
        "type": "narration",
        "content": "塔露拉变了。"
    },
    {
        "id": 10,
        "raw": "第一次见到塔露拉的时候，她给我的感觉，和特蕾西娅殿下很像。",
        "type": "narration",
        "content": "第一次见到塔露拉的时候，她给我的感觉，和特蕾西娅殿下很像。"
    },
    {
        "id": 11,
        "raw": "但殿下一直非常的悲伤，她背负着……也知晓着这片大地的更多秘密。",
        "type": "narration",
        "content": "但殿下一直非常的悲伤，她背负着……也知晓着这片大地的更多秘密。"
    },
    {
        "id": 12,
        "raw": "塔露拉不同，她很愤怒，足够冷静的，却又充满热情的愤怒。",
        "type": "narration",
        "content": "塔露拉不同，她很愤怒，足够冷静的，却又充满热情的愤怒。"
    },
    {
        "id": 13,
        "raw": "虽然细小很多，却同样强盛。也许他们这样的人无论力量大小，都拥有着近似的部分。",
        "type": "narration",
        "content": "虽然细小很多，却同样强盛。也许他们这样的人无论力量大小，都拥有着近似的部分。"
    },
    {
        "id": 14,
        "raw": "这股愤怒催生了整合运动，让无数追随者趋之若鹜。",
        "type": "narration",
        "content": "这股愤怒催生了整合运动，让无数追随者趋之若鹜。"
    },
    {
        "id": 15,
        "raw": "但很快……就改变了。",
        "type": "narration",
        "content": "但很快……就改变了。"
    },
    {
        "id": 16,
        "raw": "我们每天的工作，变成了煽动、加害和挑拨。",
        "type": "narration",
        "content": "我们每天的工作，变成了煽动、加害和挑拨。"
    },
    {
        "id": 17,
        "raw": "这不再是一场感染者的革命——",
        "type": "narration",
        "content": "这不再是一场感染者的革命——"
    },
    {
        "id": 18,
        "raw": "——而是我们在卡兹戴尔目睹过无数次的，被过度操纵的战争阴谋。",
        "type": "narration",
        "content": "——而是我们在卡兹戴尔目睹过无数次的，被过度操纵的战争阴谋。"
    },
    {
