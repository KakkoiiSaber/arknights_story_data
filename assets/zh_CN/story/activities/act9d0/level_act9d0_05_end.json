        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"坚毅的整合运动术师\"]  不去确认她的尸体？",
        "type": "dialog",
        "speaker": "坚毅的整合运动术师",
        "content": "不去确认她的尸体？"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"整合运动士兵\"]  ……刚才的战斗动静太大，已经有人被吸引过来了，立刻炸毁这条街道。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "……刚才的战斗动静太大，已经有人被吸引过来了，立刻炸毁这条街道。"
    },
    {
        "id": 141,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"坚毅的整合运动术师\"]  是。",
        "type": "dialog",
        "speaker": "坚毅的整合运动术师",
        "content": "是。"
    },
    {
        "id": 143,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 144,
        "raw": "[name=\"整合运动士兵\"]  等等。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "等等。"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=1)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 1
    },
    {
        "id": 146,
        "raw": "[name=\"整合运动士兵\"]  整合运动也要有人……和她一并奋战到了最后。",
        "type": "dialog",
        "speaker": "整合运动士兵",
        "content": "整合运动也要有人……和她一并奋战到了最后。"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_1002_nsabr_2\", name2=\"char_1011_wizard_1\", focus=2)]",
        "type": "character",
        "name": "char_1002_nsabr_2.png",
        "name2": "char_1011_wizard_1",
        "focus": 2
    },
    {
        "id": 148,
        "raw": "[name=\"坚毅的整合运动术师\"]  ……我明白了。",
        "type": "dialog",
        "speaker": "坚毅的整合运动术师",
        "content": "……我明白了。"
    },
    {
        "id": 149,
        "raw": "[name=\"坚毅的整合运动术师\"]  照顾好我的家人，他们还在城里。",
        "type": "dialog",
        "speaker": "坚毅的整合运动术师",
        "content": "照顾好我的家人，他们还在城里。"
    },
