        "name2": "avg_npc_026",
        "focus": 1
    },
    {
        "id": 103,
        "raw": "[name=\"伊内丝\"]  彼此，你不是也接受了这种W才能想出来的疯狂交易。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "彼此，你不是也接受了这种W才能想出来的疯狂交易。"
