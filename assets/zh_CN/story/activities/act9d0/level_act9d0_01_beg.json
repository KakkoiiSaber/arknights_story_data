    },
    {
        "id": 105,
        "raw": "[name=\"伊内丝\"]  不说话？那么，死吧。",
        "type": "dialog",
        "speaker": "伊内丝",
        "content": "不说话？那么，死吧。"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"avg_npc_047\")]",
        "type": "character",
        "name": "avg_npc_047"
    },
    {
        "id": 107,
        "raw": "[name=\"赫德雷\"]  等等。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "等等。"
    },
    {
        "id": 108,
        "raw": "[name=\"赫德雷\"]  她是跟着我们来的。",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "她是跟着我们来的。"
    },
    {
        "id": 109,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 110,
        "raw": "[name=\"衣衫褴褛的萨卡兹女性\"]  ......",
        "type": "dialog",
        "speaker": "衣衫褴褛的萨卡兹女性",
        "content": "......"
