        "name2": "avg_npc_047",
        "focus": 1
    },
    {
        "id": 134,
        "raw": "[name=\"伊内丝\"]  ......脑子正常的人都不会突然接受一个来路不明的萨卡兹。",
        "type": "dialog",
        "speaker": "伊内丝",
