        "type": "character",
        "name": "avg_npc_052",
        "name2": "avg_npc_047",
        "focus": 2
    },
    {
        "id": 125,
        "raw": "[name=\"赫德雷\"]  喔，有多少？",
        "type": "dialog",
        "speaker": "赫德雷",
        "content": "喔，有多少？"
    },
