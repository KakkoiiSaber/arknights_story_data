        "block": false
    },
    {
        "id": 15,
        "raw": "[name=\"感染者纠察队\"]  啊啊……啊啊啊啊！！",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "啊啊……啊啊啊啊！！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"avg_npc_078#4\")]",
        "type": "character",
        "name": "avg_npc_078#4.png"
    },
    {
        "id": 17,
        "raw": "[name=\"塔露拉\"] ……",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "……"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 19,
        "raw": "[name=\"阿丽娜\"] 塔露拉……！你……唔……！",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "塔露拉……！你……唔……！"
    },
    {
        "id": 20,
        "raw": "[name=\"阿丽娜\"] 这把火是你放的吗！他们是你烧……呃！",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "这把火是你放的吗！他们是你烧……呃！"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_078#4\")]",
        "type": "character",
        "name": "avg_npc_078#4.png"
    },
    {
        "id": 22,
        "raw": "[name=\"塔露拉\"] 阿丽娜，抱歉。这一定会给村子带来很大的灾难。但是我无法忍受。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "阿丽娜，抱歉。这一定会给村子带来很大的灾难。但是我无法忍受。"
    },
    {
        "id": 23,
        "raw": "[name=\"塔露拉\"] 我无法忍受这种事……",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我无法忍受这种事……"
    },
    {
        "id": 24,
        "raw": "[name=\"塔露拉\"] ……阿丽娜？",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "……阿丽娜？"
    },
    {
        "id": 25,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 26,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 27,
        "raw": "塔露拉惊讶地看着阿丽娜。阿丽娜用塔露拉从没见过的眼神望着她。",
        "type": "narration",
        "content": "塔露拉惊讶地看着阿丽娜。阿丽娜用塔露拉从没见过的眼神望着她。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 29,
        "raw": "[name=\"阿丽娜\"] 你眼里有一团火。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "你眼里有一团火。"
    },
    {
        "id": 30,
        "raw": "[name=\"阿丽娜\"] 从你来这个村子的时候我就知道，你不会甘心在这个村子里呆下去的。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "从你来这个村子的时候我就知道，你不会甘心在这个村子里呆下去的。"
    },
    {
        "id": 31,
        "raw": "[name=\"阿丽娜\"] 你有你的来处，你从哪里来就要回到哪里去，这个村子容不下你。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "你有你的来处，你从哪里来就要回到哪里去，这个村子容不下你。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"avg_npc_078#4\")]",
        "type": "character",
        "name": "avg_npc_078#4.png"
    },
    {
        "id": 33,
        "raw": "[name=\"塔露拉\"] 我不会回去。别这么看着我……",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我不会回去。别这么看着我……"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 35,
        "raw": "[name=\"阿丽娜\"] 但你眼里确实有那一团火。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "但你眼里确实有那一团火。"
    },
    {
        "id": 36,
        "raw": "[name=\"阿丽娜\"] 你想要点燃什么，你想烧掉什么，你觉得这一切都不对，你在忍受，你忍到了极限……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "你想要点燃什么，你想烧掉什么，你觉得这一切都不对，你在忍受，你忍到了极限……"
    },
    {
        "id": 37,
        "raw": "[name=\"阿丽娜\"] 不该是现在，塔露拉。不该是现在。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "不该是现在，塔露拉。不该是现在。"
    },
    {
        "id": 38,
        "raw": "[name=\"阿丽娜\"] 村民是无辜的。你一时的怒火只会害了他们。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "村民是无辜的。你一时的怒火只会害了他们。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"avg_npc_082\")]",
        "type": "character",
        "name": "avg_npc_082.png"
    },
    {
        "id": 40,
        "raw": "[CameraShake(duration=0.5, xstrength=0, ystrength=20, vibrato=30, randomness=30, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "0.5,",
        "xstrength": "0,",
        "ystrength": "20,",
        "vibrato": "30,",
        "randomness": "30,",
