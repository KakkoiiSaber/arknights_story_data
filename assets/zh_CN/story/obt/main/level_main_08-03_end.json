        "block": false
    },
    {
        "id": 41,
        "raw": "[name=\"感染者纠察队\"]  发生什么事——天哪！发生什么了！谁！是谁干的！",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "发生什么事——天哪！发生什么了！谁！是谁干的！"
    },
    {
        "id": 42,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 43,
