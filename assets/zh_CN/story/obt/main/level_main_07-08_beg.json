        "type": "character",
        "name": "char_003_kalts_1",
        "name2": "avg_npc_057",
        "focus": 1
    },
    {
        "id": 170,
        "raw": "[name=\"凯尔希\"]  他有像自己所说的那样坚定地保护你们的生存权吗？",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "他有像自己所说的那样坚定地保护你们的生存权吗？"
