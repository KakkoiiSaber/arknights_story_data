        "id": 171,
        "raw": "[Character(name=\"char_003_kalts_1\",name2=\"avg_npc_057\",focus=2)]",
        "type": "character",
        "name": "char_003_kalts_1",
        "name2": "avg_npc_057",
        "focus": 2
    },
    {
        "id": 172,
        "raw": "[name=\"乌萨斯感染者\"]  你问的是什么......你这么问，要干什么！",
        "type": "dialog",
        "speaker": "乌萨斯感染者",
        "content": "你问的是什么......你这么问，要干什么！"
