        "type": "character",
        "name": "char_003_kalts_1",
        "name2": "avg_npc_057",
        "focus": 1
    },
    {
        "id": 174,
        "raw": "[name=\"凯尔希\"]  他和他所属的整合运动，不分是哪一部分，有威胁到你的生命，甚至做出伤害你的举动吗？",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "他和他所属的整合运动，不分是哪一部分，有威胁到你的生命，甚至做出伤害你的举动吗？"
    },
    {
        "id": 175,
        "raw": "[name=\"凯尔希\"]  如实回答，我会按照你的回答来处理他。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "如实回答，我会按照你的回答来处理他。"
    },
