    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 6,
        "raw": "[name=\"阿米娅\"]   事已至此......我们已经没有别的选择。如果陈长官拒绝——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "事已至此......我们已经没有别的选择。如果陈长官拒绝——"
    },
    {
        "id": 7,
        "raw": "[name=\"阿米娅\"]   那么罗德岛就会单方面出动。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "那么罗德岛就会单方面出动。"
    },
    {
        "id": 8,
        "raw": "[name=\"阿米娅\"]   况且这一行为，并不破坏罗德岛与龙门之间的协约。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "况且这一行为，并不破坏罗德岛与龙门之间的协约。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"陈\"]   近卫局当然会去。",
        "type": "dialog",
        "speaker": "陈",
        "content": "近卫局当然会去。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"阿米娅\"]   ......是，是吗......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......是，是吗......"
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]   ......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......"
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]   那我代表罗德岛感谢陈长官——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "那我代表罗德岛感谢陈长官——"
    },
    {
        "id": 15,
        "raw": "[name=\"阿米娅\"]   我知道，感染者对于龙门而言......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我知道，感染者对于龙门而言......"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"陈\"]   这是小事。",
        "type": "dialog",
        "speaker": "陈",
        "content": "这是小事。"
    },
    {
        "id": 18,
        "raw": "[name=\"陈\"]   只不过，我对于近卫局各个小队是否能突入分城内部还有一定的疑虑。",
        "type": "dialog",
        "speaker": "陈",
        "content": "只不过，我对于近卫局各个小队是否能突入分城内部还有一定的疑虑。"
    },
    {
        "id": 19,
        "raw": "[name=\"陈\"]   我们将见机行事。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我们将见机行事。"
    },
    {
        "id": 20,
        "raw": "[name=\"陈\"]   如果可能的话，我们一定会帮助你。",
        "type": "dialog",
        "speaker": "陈",
        "content": "如果可能的话，我们一定会帮助你。"
    },
    {
        "id": 21,
        "raw": "[name=\"陈\"]   但近卫局依然会以处理整合运动这一任务为最优先。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但近卫局依然会以处理整合运动这一任务为最优先。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"阿米娅\"]   这样......这样就够了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这样......这样就够了。"
    },
    {
        "id": 24,
        "raw": "[name=\"阿米娅\"]   ......谢谢你，陈长官。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......谢谢你，陈长官。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"陈\"]   抱歉，我有自己的使命。",
        "type": "dialog",
        "speaker": "陈",
        "content": "抱歉，我有自己的使命。"
    },
    {
        "id": 27,
        "raw": "[name=\"陈\"]   设备另一头的那个医生，听到了吗？",
        "type": "dialog",
        "speaker": "陈",
        "content": "设备另一头的那个医生，听到了吗？"
    },
    {
        "id": 28,
        "raw": "[name=\"陈\"]   我会与罗德岛一起行动。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我会与罗德岛一起行动。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 30,
        "raw": "[name=\"凯尔希\"]   阿米娅，小心点。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "阿米娅，小心点。"
    },
    {
        "id": 31,
        "raw": "[name=\"凯尔希\"]   事情并不单纯。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "事情并不单纯。"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 33,
        "raw": "[name=\"阿米娅\"]   我会小心的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我会小心的。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 35,
        "raw": "[name=\"凯尔希\"]   对了，我陆续建立了一些综合情报。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "对了，我陆续建立了一些综合情报。"
    },
    {
        "id": 36,
        "raw": "[name=\"凯尔希\"]   罗德岛已经派出了救援小队，协助其他参与任务的侦察小队。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "罗德岛已经派出了救援小队，协助其他参与任务的侦察小队。"
    },
    {
        "id": 37,
        "raw": "[name=\"凯尔希\"]   只不过陨星他们所在的地方，我们无法深入，无能为力。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "只不过陨星他们所在的地方，我们无法深入，无能为力。"
    },
    {
        "id": 38,
        "raw": "[name=\"凯尔希\"]   这要靠你了。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "这要靠你了。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 40,
        "raw": "[name=\"阿米娅\"]   只有陨星她们吗......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "只有陨星她们吗......"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 42,
        "raw": "[name=\"阿米娅\"]   我明白了。我会去找她们的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我明白了。我会去找她们的。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 44,
        "raw": "[name=\"凯尔希\"]   我会将把坐标发送给你。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我会将把坐标发送给你。"
    },
    {
        "id": 45,
        "raw": "[name=\"凯尔希\"]   记住，一切以安全为最优先。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "记住，一切以安全为最优先。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 47,
        "raw": "[name=\"阿米娅\"]   我明白。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我明白。"
    },
