    {
        "id": 53,
        "raw": "[name=\"星熊\"]   所以，什么时候出发？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "所以，什么时候出发？"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"陈\"]   现在。",
        "type": "dialog",
        "speaker": "陈",
        "content": "现在。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"星熊\"]   我去整备。你通知一下近卫局的其他人。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "我去整备。你通知一下近卫局的其他人。"
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 59,
        "raw": "[name=\"陈\"]   好。",
        "type": "dialog",
        "speaker": "陈",
        "content": "好。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 61,
        "raw": "[name=\"陈\"]   阿米娅，十分钟之后，我们一起出发。",
        "type": "dialog",
        "speaker": "陈",
        "content": "阿米娅，十分钟之后，我们一起出发。"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]   好的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "好的。"
    },
    {
