        "width": 700
    },
    {
        "id": 12,
        "raw": "[Subtitle(text=\"往南是送死，往北也是送死。往西……如果远北都出事了，西部那些矿场也不可能幸免。\", x=300, y=370, alignment=\"center\", size=24, delay=0.04, width=700)]",
