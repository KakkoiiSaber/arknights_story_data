        "raw": "[Character(name=\"avg_npc_053\")]",
        "type": "character",
        "name": "avg_npc_053"
    },
    {
        "id": 105,
        "raw": "[name=\"萨卡兹雇佣兵\"]我就当是这么回事吧。",
        "type": "dialog",
        "speaker": "萨卡兹雇佣兵",
        "content": "我就当是这么回事吧。"
    },
