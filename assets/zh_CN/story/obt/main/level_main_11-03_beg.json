        "raw": "[CameraShake(duration=0.3, xstrength=30, ystrength=30, vibrato=30, randomness=90, fadeout=true, block=false)]",
        "type": "camera_shake",
        "duration": "0.3,",
        "xstrength": "30,",
        "ystrength": "30,",
        "vibrato": "30,",
        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 237,
        "raw": "[name=\"费斯特\"]可我不想要这样的明天！",
        "type": "dialog",
        "speaker": "费斯特",
        "content": "可我不想要这样的明天！"
    },
    {
        "id": 238,
