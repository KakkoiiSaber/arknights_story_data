    {
        "id": 6,
        "raw": "[name=\"凯尔希\"]   知道了。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "知道了。"
    },
    {
        "id": 7,
        "raw": "[name=\"凯尔希\"]   好的，保持联络。嗅到气味就立刻告诉我。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "好的，保持联络。嗅到气味就立刻告诉我。"
    },
    {
        "id": 8,
        "raw": "[name=\"凯尔希\"]   按第三个键就行。嗯。",
