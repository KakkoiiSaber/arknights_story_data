        "raw": "[Character(name=\"char_2005_weiyw_1\")]",
        "type": "character",
        "name": "char_2005_weiyw_1.png"
    },
    {
        "id": 45,
        "raw": "[name=\"魏彦吾\"]   嗯？她的名字是？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "嗯？她的名字是？"
    },
    {
        "id": 46,
        "raw": "[name=\"魏彦吾\"]   我记得不是那么清楚了……",
        "type": "dialog",
        "speaker": "魏彦吾",
