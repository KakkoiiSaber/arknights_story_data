        "name": "char_003_kalts_1.png",
        "name2": "char_2005_weiyw_1",
        "focus": 1
    },
    {
        "id": 81,
        "raw": "[name=\"凯尔希\"]   ——那，第二个要求是？",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "——那，第二个要求是？"
