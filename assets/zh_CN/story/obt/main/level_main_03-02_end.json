    {
        "id": 100,
        "raw": "[name=\"碎骨\"]   米莎......",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "米莎......"
    },
    {
        "id": 101,
        "raw": "[name=\"碎骨\"]   会好的......一切都会好的。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "会好的......一切都会好的。"
    },
    {
        "id": 102,
        "raw": "[name=\"碎骨\"]   我不怪你。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "我不怪你。"
    },
    {
        "id": 103,
        "raw": "[name=\"碎骨\"]   当时......谁有勇气呢？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "当时......谁有勇气呢？"
    },
    {
        "id": 104,
        "raw": "[name=\"碎骨\"]   但至少现在，整合运动给了我勇气。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "但至少现在，整合运动给了我勇气。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"米莎\"]   亚......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "亚......"
    },
    {
        "id": 107,
        "raw": "[name=\"米莎\"]   碎骨......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "碎骨......"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"碎骨\"]   你可以选择，不去相信我们。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "你可以选择，不去相信我们。"
    },
    {
        "id": 110,
        "raw": "[name=\"碎骨\"]   ——即便你相信我们了，你也可以选择，不加入我们。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "——即便你相信我们了，你也可以选择，不加入我们。"
    },
    {
        "id": 111,
        "raw": "[name=\"碎骨\"]   但你是一个感染者。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "但你是一个感染者。"
    },
    {
        "id": 112,
        "raw": "[name=\"碎骨\"]   整合运动......一定会为了感染者的自由战斗到底。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "整合运动......一定会为了感染者的自由战斗到底。"
    },
