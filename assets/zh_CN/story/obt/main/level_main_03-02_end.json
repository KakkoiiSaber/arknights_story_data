        "id": 113,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 114,
        "raw": "[name=\"米莎\"]   可你们......摧毁了切尔诺伯格。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "可你们......摧毁了切尔诺伯格。"
    },
    {
        "id": 115,
        "raw": "[name=\"米莎\"]   有无数无辜的人死去——",
        "type": "dialog",
        "speaker": "米莎",
        "content": "有无数无辜的人死去——"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 117,
        "raw": "[name=\"碎骨\"]   ——无辜？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "——无辜？"
    },
    {
        "id": 118,
        "raw": "[name=\"碎骨\"]   呵，谁是无辜的？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "呵，谁是无辜的？"
    },
    {
        "id": 119,
        "raw": "[name=\"碎骨\"]   切尔诺伯格实行隔离制度时，有谁反对过吗？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "切尔诺伯格实行隔离制度时，有谁反对过吗？"
    },
    {
        "id": 120,
        "raw": "[name=\"碎骨\"]   在我们被拖去矿场，在乌萨斯把我们丢弃在矿场和冻野，任由我们在寒冬中死去时，有谁反对过吗？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "在我们被拖去矿场，在乌萨斯把我们丢弃在矿场和冻野，任由我们在寒冬中死去时，有谁反对过吗？"
    },
    {
        "id": 121,
        "raw": "[name=\"碎骨\"]   有谁，站出来，反对过吗？！",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "有谁，站出来，反对过吗？！"
    },
