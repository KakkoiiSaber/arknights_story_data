    },
    {
        "id": 151,
        "raw": "[name=\"米莎\"]   ......我理解你......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "......我理解你......"
    },
    {
        "id": 152,
        "raw": "[name=\"米莎\"]   这么长时间以来，你过得......很辛苦吧？",
        "type": "dialog",
        "speaker": "米莎",
        "content": "这么长时间以来，你过得......很辛苦吧？"
