        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 137,
        "raw": "[name=\"碎骨\"]   罗德岛？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "罗德岛？"
    },
    {
        "id": 138,
        "raw": "[name=\"碎骨\"]   明明是感染者，却帮助龙门，伤害我们？",
