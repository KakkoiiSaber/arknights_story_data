        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 154,
        "raw": "[name=\"碎骨\"]   大家都过得很痛苦。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "大家都过得很痛苦。"
    },
    {
        "id": 155,
        "raw": "[name=\"碎骨\"]   而现在，至少每个人都抱着希望。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "而现在，至少每个人都抱着希望。"
    },
    {
        "id": 156,
        "raw": "[name=\"碎骨\"]   塔露拉......是她带领感染者，反抗残忍的一切。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "塔露拉......是她带领感染者，反抗残忍的一切。"
    },
    {
        "id": 157,
        "raw": "[name=\"碎骨\"]   整合运动就是我们的希望。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "整合运动就是我们的希望。"
    },
    {
        "id": 158,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 159,
        "raw": "[name=\"米莎\"]   ......果然大家，都吃过很多苦。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "......果然大家，都吃过很多苦。"
    },
    {
        "id": 160,
        "raw": "[name=\"米莎\"]   如果整合运动真的能保护他们的话......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "如果整合运动真的能保护他们的话......"
    },
    {
        "id": 161,
        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=2)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "id": 162,
        "raw": "[name=\"碎骨\"]   当然了。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "当然了。"
    },
    {
        "id": 163,
        "raw": "[name=\"碎骨\"]   就像整合运动会保护大家......我也会保护你。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "就像整合运动会保护大家......我也会保护你。"
    },
    {
