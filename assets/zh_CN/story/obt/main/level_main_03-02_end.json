        "name": "char_012_misa_1#2",
        "name2": "char_1002_nsabr_2",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"整合运动成员\"]   为什么？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "为什么？"
    },
    {
        "id": 23,
        "raw": "[name=\"整合运动成员\"]   ————",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "————"
    },
    {
        "id": 24,
        "raw": "[name=\"整合运动成员\"]   我的妻子，孩子......都死在切尔诺伯格人的手里。",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "我的妻子，孩子......都死在切尔诺伯格人的手里。"
    },
    {
        "id": 25,
        "raw": "[name=\"整合运动成员\"]   乌萨斯感染者的遭遇，比牲畜还不如。",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "乌萨斯感染者的遭遇，比牲畜还不如。"
    },
    {
        "id": 26,
        "raw": "[name=\"整合运动成员\"]   毁灭切尔诺伯格——？作为复仇，太轻了，太轻了......",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "毁灭切尔诺伯格——？作为复仇，太轻了，太轻了......"
    },
    {
        "id": 27,
        "raw": "[name=\"整合运动成员\"]   他们手上有多少感染者的血？！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "他们手上有多少感染者的血？！"
    },
    {
        "id": 28,
        "raw": "[name=\"整合运动成员\"]   米莎——我们被人恐惧，被人愚弄，被人侮辱，被人迫害——",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "米莎——我们被人恐惧，被人愚弄，被人侮辱，被人迫害——"
    },
    {
        "id": 29,
        "raw": "[name=\"整合运动成员\"]   ——只因我们是感染者。",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "——只因我们是感染者。"
    },
    {
        "id": 30,
        "raw": "[name=\"整合运动成员\"]   仅仅是这样而已。",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "仅仅是这样而已。"
    },
