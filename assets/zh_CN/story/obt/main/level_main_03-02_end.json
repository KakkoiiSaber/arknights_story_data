        "raw": "[Character(name=\"char_012_misa_1#4\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"米莎\"]   ——但你们......在伤害别人。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "——但你们......在伤害别人。"
    },
    {
        "id": 65,
        "raw": "[name=\"米莎\"]   我不愿意......我不想......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "我不愿意......我不想......"
    },
    {
        "id": 66,
        "raw": "[name=\"米莎\"]   感染者为什么要互相......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "感染者为什么要互相......"
    },
    {
