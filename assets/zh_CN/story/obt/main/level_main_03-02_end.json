    {
        "id": 68,
        "raw": "[name=\"碎骨\"]   以眼还眼，理所应当。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "以眼还眼，理所应当。"
    },
    {
        "id": 69,
        "raw": "[name=\"碎骨\"]   乌萨斯人说，对待亲人，就该像春天一样温暖......",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "乌萨斯人说，对待亲人，就该像春天一样温暖......"
    },
