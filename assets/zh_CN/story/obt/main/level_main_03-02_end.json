        "name": "char_012_misa_1#4",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 135,
        "raw": "[name=\"米莎\"]   我也遇到过别的帮助感染者的人......他们......",
        "type": "dialog",
        "speaker": "米莎",
        "content": "我也遇到过别的帮助感染者的人......他们......"
