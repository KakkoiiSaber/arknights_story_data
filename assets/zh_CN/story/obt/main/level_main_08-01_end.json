    },
    {
        "id": 24,
        "raw": "[name=\"感染者纠察队\"] ......别以为事情就这么完了！",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "......别以为事情就这么完了！"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"avg_npc_078#4\")]",
        "type": "character",
        "name": "avg_npc_078#4"
    },
    {
        "id": 26,
        "raw": "[name=\"塔露拉\"] 我现在就剐了你的舌头。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我现在就剐了你的舌头。"
    },
    {
