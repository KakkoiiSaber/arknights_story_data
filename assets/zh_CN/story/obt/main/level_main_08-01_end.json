    },
    {
        "id": 22,
        "raw": "[name=\"塔露拉\"] 我没有砍掉你的手，爬起来！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我没有砍掉你的手，爬起来！"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_082\")]",
