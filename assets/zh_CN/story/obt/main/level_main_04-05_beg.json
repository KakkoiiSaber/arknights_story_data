        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 37,
        "raw": "[name=\"阿米娅\"]   大家......整理下装备，我觉得，应该是时候出发了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "大家......整理下装备，我觉得，应该是时候出发了。"
