        "name": "char_002_amiya_1"
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   凯尔希医生！是我！你接到了吗——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "凯尔希医生！是我！你接到了吗——"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1\", focus=-1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "focus": -1
    },
    {
        "id": 24,
        "raw": "[name=\"凯尔希\"]   我一直在舰桥监控。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "我一直在舰桥监控。"
    },
    {
        "id": 25,
        "raw": "[name=\"凯尔希\"]   你帮我问问你身边那个陈警官。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "你帮我问问你身边那个陈警官。"
    },
    {
        "id": 26,
        "raw": "[name=\"凯尔希\"]   就问——",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "就问——"
    },
    {
        "id": 27,
        "raw": "[name=\"凯尔希\"]   “龙门还要装腔作势到什么时候？”",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "“龙门还要装腔作势到什么时候？”"
