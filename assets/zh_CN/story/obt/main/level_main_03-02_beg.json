    {
        "id": 5,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 6,
        "raw": "[name=\"陈\"]   你终于到了，星熊。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你终于到了，星熊。"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"星熊\"]   抱歉，被那个人拖了好久。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "抱歉，被那个人拖了好久。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"陈\"]   有没有受伤？",
        "type": "dialog",
        "speaker": "陈",
        "content": "有没有受伤？"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"星熊\"]   没有。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "没有。"
    },
    {
        "id": 13,
        "raw": "[name=\"星熊\"]   但我确实被那个感染者的实力吓了一跳。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "但我确实被那个感染者的实力吓了一跳。"
    },
    {
        "id": 14,
        "raw": "[name=\"星熊\"]   特别督察组加强了对龙门本区的防守。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "特别督察组加强了对龙门本区的防守。"
    },
    {
        "id": 15,
        "raw": "[name=\"星熊\"]   我带出来的这些，就是全部可用的小队了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "我带出来的这些，就是全部可用的小队了。"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 17,
        "raw": "[name=\"陈\"]   ......特别督察组，真的是被她一个人阻挡住了？",
        "type": "dialog",
        "speaker": "陈",
        "content": "......特别督察组，真的是被她一个人阻挡住了？"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"星熊\"]   没亲眼见过之前，我也不敢相信。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "没亲眼见过之前，我也不敢相信。"
    },
    {
        "id": 20,
        "raw": "[name=\"星熊\"]   那个家伙，确实有这个水准。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "那个家伙，确实有这个水准。"
    },
    {
        "id": 21,
        "raw": "[name=\"星熊\"]   而且，她甚至有些......心不在焉？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "而且，她甚至有些......心不在焉？"
    },
    {
        "id": 22,
        "raw": "[name=\"星熊\"]   话说回来，你身边这些人——",
        "type": "dialog",
        "speaker": "星熊",
        "content": "话说回来，你身边这些人——"
    },
    {
        "id": 23,
        "raw": "[name=\"星熊\"]   是不是就是罗德岛啊？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "是不是就是罗德岛啊？"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 25,
        "raw": "[name=\"阿米娅\"]   陈长官，这位是......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官，这位是......"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"陈\"]   特别督察组的精英，星熊。",
        "type": "dialog",
        "speaker": "陈",
        "content": "特别督察组的精英，星熊。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"星熊\"]   你们就是罗德岛？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "你们就是罗德岛？"
    },
    {
        "id": 30,
        "raw": "[name=\"星熊\"]   咦，这么小的孩子，也是罗德岛的人吗？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "咦，这么小的孩子，也是罗德岛的人吗？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 32,
        "raw": "[name=\"陈\"]   她可是领导人。",
        "type": "dialog",
        "speaker": "陈",
        "content": "她可是领导人。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 34,
        "raw": "[name=\"阿米娅\"]   陈，陈长官。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈，陈长官。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 36,
        "raw": "[name=\"星熊\"]   哇......",
        "type": "dialog",
        "speaker": "星熊",
        "content": "哇......"
    },
    {
        "id": 37,
        "raw": "[name=\"星熊\"]   不问别的。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "不问别的。"
    },
    {
        "id": 38,
        "raw": "[name=\"星熊\"]   现在，你们有什么思路？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "现在，你们有什么思路？"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 40,
        "raw": "[name=\"阿米娅\"]   两位我方的特别行动人员，已经探明了劫持者的去向。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "两位我方的特别行动人员，已经探明了劫持者的去向。"
    },
    {
        "id": 41,
        "raw": "[name=\"阿米娅\"]   她们正在跟踪这支整合运动，我们可以随她们的指引行动。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "她们正在跟踪这支整合运动，我们可以随她们的指引行动。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"星熊\"]   可以啊。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "可以啊。"
    },
    {
        "id": 44,
        "raw": "[name=\"星熊\"]   老陈，你上次确实夸在点子上了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "老陈，你上次确实夸在点子上了。"
    },
    {
        "id": 45,
        "raw": "[name=\"星熊\"]   这些人很在行。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "这些人很在行。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 47,
        "raw": "[name=\"阿米娅\"]   陈长官......夸赞我们？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官......夸赞我们？"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 49,
        "raw": "[name=\"陈\"]   呵。",
        "type": "dialog",
        "speaker": "陈",
        "content": "呵。"
    },
    {
        "id": 50,
        "raw": "[name=\"陈\"]   星熊，召集近卫局所有小队，该行动了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊，召集近卫局所有小队，该行动了。"
    },
    {
        "id": 51,
        "raw": "[name=\"陈\"]   罗德岛，你们带路。",
        "type": "dialog",
        "speaker": "陈",
        "content": "罗德岛，你们带路。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 53,
        "raw": "[name=\"阿米娅\"]   ——了解。当然，整合运动似乎留下了一些断后的战斗人员。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——了解。当然，整合运动似乎留下了一些断后的战斗人员。"
    },
    {
        "id": 54,
        "raw": "[name=\"阿米娅\"]   他们正埋伏在路线上——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "他们正埋伏在路线上——"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 56,
        "raw": "[name=\"星熊\"]   这简单。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "这简单。"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 58,
        "raw": "[name=\"阿米娅\"]   嗯，我们只要小心谨慎地行动，就能发现他们的踪迹，先发制人。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "嗯，我们只要小心谨慎地行动，就能发现他们的踪迹，先发制人。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma"
    },
    {
        "id": 60,
        "raw": "[name=\"星熊\"]   好！",
        "type": "dialog",
        "speaker": "星熊",
        "content": "好！"
    },
    {
        "id": 61,
        "raw": "[name=\"星熊\"]   就让我看看，罗德岛战斗起来是不是也一样内行！",
        "type": "dialog",
        "speaker": "星熊",
        "content": "就让我看看，罗德岛战斗起来是不是也一样内行！"
    },
