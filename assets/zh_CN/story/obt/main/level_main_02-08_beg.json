        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 24,
        "raw": "[name=\"陈\"]   PC94172，看好这孩子。",
        "type": "dialog",
        "speaker": "陈",
        "content": "PC94172，看好这孩子。"
    },
