        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"陈\"]   龙门对感染者已经很宽厚了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "龙门对感染者已经很宽厚了。"
