        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"陈\"]   ——我会向魏长官申请的。",
        "type": "dialog",
        "speaker": "陈",
        "content": "——我会向魏长官申请的。"
    },
    {
        "id": 45,
        "raw": "[name=\"陈\"]   检查后如果没有其他问题，龙门就会把她移交给罗德岛。",
        "type": "dialog",
        "speaker": "陈",
        "content": "检查后如果没有其他问题，龙门就会把她移交给罗德岛。"
    },
