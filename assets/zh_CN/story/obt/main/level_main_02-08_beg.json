    {
        "id": 6,
        "raw": "[name=\"阿米娅\"]   芙兰卡，雷蛇，注意警戒四周。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "芙兰卡，雷蛇，注意警戒四周。"
    },
    {
        "id": 7,
        "raw": "[name=\"阿米娅\"]   我带米莎去见陈长官。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我带米莎去见陈长官。"
    },
    {
        "id": 8,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1.png"
    },
    {
        "id": 9,
        "raw": "[name=\"米莎\"]   ……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"陈\"]   你们又迟到了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你们又迟到了。"
    },
    {
        "id": 12,
        "raw": "[name=\"陈\"]   别给龙门增加多余的安全隐患。",
        "type": "dialog",
        "speaker": "陈",
        "content": "别给龙门增加多余的安全隐患。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]   陈长官，整合运动多次袭击我们的护送队。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官，整合运动多次袭击我们的护送队。"
    },
    {
        "id": 15,
        "raw": "[name=\"阿米娅\"]   而现在，敌人仍在我们周围徘徊。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "而现在，敌人仍在我们周围徘徊。"
    },
    {
        "id": 16,
        "raw": "[name=\"阿米娅\"]   这里并不安全，请赶快带米莎离开。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这里并不安全，请赶快带米莎离开。"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 18,
        "raw": "[name=\"陈\"]   你就是米莎？",
        "type": "dialog",
        "speaker": "陈",
        "content": "你就是米莎？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_012_misa_1\")]",
        "type": "character",
        "name": "char_012_misa_1.png"
    },
    {
        "id": 20,
        "raw": "[name=\"米莎\"]   ……是的。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……是的。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"陈\"]   从现在起，你必须听从近卫局的安排。",
        "type": "dialog",
        "speaker": "陈",
        "content": "从现在起，你必须听从近卫局的安排。"
    },
