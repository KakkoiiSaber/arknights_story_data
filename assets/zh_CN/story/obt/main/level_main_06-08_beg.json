    },
    {
        "id": 168,
        "raw": "[name=\"林雨霞\"]  ......",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "......"
    },
    {
        "id": 169,
        "raw": "[name=\"林雨霞\"]  做什么？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "做什么？"
    },
    {
        "id": 170,
        "raw": "[playsound(key=\"$d_gen_transmissionget\", volume=0.4)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.4
    },
    {
        "id": 171,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 172,
        "raw": "[name=\"诗怀雅\"]  臭老鼠，有个消息给你。有支整合运动，我们现在挡不住，需要你那支队伍的帮助。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "臭老鼠，有个消息给你。有支整合运动，我们现在挡不住，需要你那支队伍的帮助。"
    },
    {
        "id": 173,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 174,
        "raw": "[name=\"林雨霞\"]  ......怎么可能？不要骗我。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "......怎么可能？不要骗我。"
    },
    {
        "id": 175,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 176,
        "raw": "[name=\"诗怀雅\"]  我骗过你吗？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "我骗过你吗？"
    },
    {
        "id": 177,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 178,
        "raw": "[name=\"林雨霞\"]  你和我说要和我上同一所中学，结果你去了维多利亚。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "你和我说要和我上同一所中学，结果你去了维多利亚。"
    },
    {
        "id": 179,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 180,
        "raw": "[name=\"诗怀雅\"]  ......",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "......"
    },
    {
        "id": 181,
        "raw": "[name=\"诗怀雅\"]  对不起。实在对不起。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "对不起。实在对不起。"
    },
    {
        "id": 182,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 183,
        "raw": "[name=\"林雨霞\"]  没什么，我不在意了。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "没什么，我不在意了。"
    },
    {
        "id": 184,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 185,
        "raw": "[name=\"诗怀雅\"]  雨霞，你爸为龙门做了很多。我们不想失去这里，这里的居民也不能失去我们。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "雨霞，你爸为龙门做了很多。我们不想失去这里，这里的居民也不能失去我们。"
    },
    {
        "id": 186,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 187,
        "raw": "[name=\"林雨霞\"]  骗子。你会来这里吗？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "骗子。你会来这里吗？"
    },
    {
        "id": 188,
        "raw": "[name=\"林雨霞\"]  你会来贫民区吗？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "你会来贫民区吗？"
    },
    {
        "id": 189,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 190,
        "raw": "[name=\"诗怀雅\"]  ......陈会。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "......陈会。"
    },
    {
        "id": 191,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 192,
        "raw": "[name=\"林雨霞\"]  ......你还真不会骗人啊。她，关我什么事？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "......你还真不会骗人啊。她，关我什么事？"
    },
    {
        "id": 193,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 194,
        "raw": "[name=\"诗怀雅\"]  你爸出于一些原因，不能够直接着手调解普通人和感染者的矛盾，但陈会。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "你爸出于一些原因，不能够直接着手调解普通人和感染者的矛盾，但陈会。"
    },
    {
        "id": 195,
        "raw": "[name=\"诗怀雅\"]  陈和你的父亲一起调理着贫民区。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "陈和你的父亲一起调理着贫民区。"
    },
    {
        "id": 196,
        "raw": "[name=\"诗怀雅\"]  他们在努力让贫民区变成一个可以让更多人生活的地方，甚至是甩掉贫民区这个名字。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "他们在努力让贫民区变成一个可以让更多人生活的地方，甚至是甩掉贫民区这个名字。"
    },
    {
        "id": 197,
        "raw": "[name=\"诗怀雅\"]  你想......虽然龙门的普通市民很少居住在这，但是过去这些年里，他们不也经常来这里吗？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "你想......虽然龙门的普通市民很少居住在这，但是过去这些年里，他们不也经常来这里吗？"
    },
    {
        "id": 198,
        "raw": "[name=\"诗怀雅\"]  再过一些时间，我们就不需要贫民区了。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "再过一些时间，我们就不需要贫民区了。"
    },
    {
        "id": 199,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 200,
        "raw": "[name=\"林雨霞\"]  什么？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "什么？"
    },
    {
        "id": 201,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 202,
        "raw": "[name=\"诗怀雅\"]  虽然感染者的问题我们还没法解决，但我相信......这里可以变成一个更好的地方。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "虽然感染者的问题我们还没法解决，但我相信......这里可以变成一个更好的地方。"
    },
    {
        "id": 203,
        "raw": "[name=\"诗怀雅\"]  只是龙门的22到29下城区，而不是什么“贫民区”。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "只是龙门的22到29下城区，而不是什么“贫民区”。"
    },
    {
        "id": 204,
        "raw": "[name=\"诗怀雅\"]  这个城市本来就是因为能容纳许许多多、各种各样的人，才发展成现在这个样子的。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "这个城市本来就是因为能容纳许许多多、各种各样的人，才发展成现在这个样子的。"
    },
    {
        "id": 205,
        "raw": "[name=\"诗怀雅\"]  龙门不能失去任何人。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "龙门不能失去任何人。"
    },
    {
        "id": 206,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 207,
        "raw": "[name=\"林雨霞\"]  ......无聊。你变得和那个陈一样无聊。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "......无聊。你变得和那个陈一样无聊。"
    },
    {
        "id": 208,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 209,
        "raw": "[name=\"诗怀雅\"]  雨霞......",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "雨霞......"
    },
    {
        "id": 210,
        "raw": "[name=\"诗怀雅\"]  哎，我不想把气氛搞得像是垃圾终端连续剧一样。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "哎，我不想把气氛搞得像是垃圾终端连续剧一样。"
    },
    {
        "id": 211,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 212,
        "raw": "[name=\"林雨霞\"]  那支整合运动的位置在哪？",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "那支整合运动的位置在哪？"
    },
    {
        "id": 213,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 214,
        "raw": "[name=\"诗怀雅\"]  啊，啊？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "啊，啊？"
    },
    {
        "id": 215,
        "raw": "[Character(name=\"avg_npc_036\")]",
        "type": "character",
        "name": "avg_npc_036.png"
    },
    {
        "id": 216,
        "raw": "[name=\"林雨霞\"]  我不会说第二次的。",
        "type": "dialog",
        "speaker": "林雨霞",
        "content": "我不会说第二次的。"
    },
