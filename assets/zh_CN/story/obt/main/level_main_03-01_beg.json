    },
    {
        "id": 78,
        "raw": "[name=\"整合运动成员\"]   不，不要！别，别打我......",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "不，不要！别，别打我......"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 80,
        "raw": "[name=\"陈\"]   进入龙门之前难道没想过自己的下场吗！",
        "type": "dialog",
        "speaker": "陈",
        "content": "进入龙门之前难道没想过自己的下场吗！"
    },
    {
        "id": 81,
