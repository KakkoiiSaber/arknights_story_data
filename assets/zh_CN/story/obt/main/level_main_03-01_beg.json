        "focus": 2
    },
    {
        "id": 6,
        "raw": "[name=\"陈\"]   看来你们也不怎么好过。",
        "type": "dialog",
        "speaker": "陈",
        "content": "看来你们也不怎么好过。"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"阿米娅\"]   陈长官，究竟发生了什么事？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官，究竟发生了什么事？"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"陈\"]   整合运动的埋伏。",
        "type": "dialog",
        "speaker": "陈",
        "content": "整合运动的埋伏。"
    },
    {
        "id": 11,
        "raw": "[name=\"陈\"]   没有增援，火力猛烈，近卫局的队形很快被他们冲散了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "没有增援，火力猛烈，近卫局的队形很快被他们冲散了。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]   那米莎......？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "那米莎......？"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"陈\"]   被一个红衣服的女人劫走了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "被一个红衣服的女人劫走了。"
    },
    {
        "id": 16,
        "raw": "[name=\"陈\"]   我真该——",
        "type": "dialog",
        "speaker": "陈",
        "content": "我真该——"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"阿米娅\"]  ......？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"陈\"]   没什么。",
        "type": "dialog",
        "speaker": "陈",
        "content": "没什么。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   ——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——"
    },
    {
        "id": 23,
        "raw": "[name=\"阿米娅\"]   陈长官，米莎身上究竟有什么?",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官，米莎身上究竟有什么?"
    },
    {
        "id": 24,
        "raw": "[name=\"阿米娅\"]   再继续隐瞒下去，罗德岛与近卫局的合作进程只会越来越艰难。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "再继续隐瞒下去，罗德岛与近卫局的合作进程只会越来越艰难。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"陈\"]   我没有告知你的义务。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我没有告知你的义务。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"阿米娅\"]   但罗德岛有了解目标并做出应对策略的义务。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但罗德岛有了解目标并做出应对策略的义务。"
    },
    {
        "id": 29,
        "raw": "[name=\"阿米娅\"]   罗德岛在行动中会听从近卫局的指挥——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛在行动中会听从近卫局的指挥——"
    },
    {
        "id": 30,
        "raw": "[name=\"阿米娅\"]   不过，即便是用感染者去对抗感染者，我们也是需要情报的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不过，即便是用感染者去对抗感染者，我们也是需要情报的。"
    },
    {
        "id": 31,
        "raw": "[name=\"阿米娅\"]   近卫局拥有信息，却不懂得如何对抗感染者才能减少损失。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "近卫局拥有信息，却不懂得如何对抗感染者才能减少损失。"
    },
    {
        "id": 32,
        "raw": "[name=\"阿米娅\"]   罗德岛有对抗感染者的能力，却不知道整合运动想要什么。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛有对抗感染者的能力，却不知道整合运动想要什么。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"陈\"]   ——",
        "type": "dialog",
        "speaker": "陈",
        "content": "——"
    },
    {
        "id": 35,
        "raw": "[name=\"陈\"]   你刚才说的话，有点那个医生的味道。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你刚才说的话，有点那个医生的味道。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#6.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"阿米娅\"]   是，是嘛......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "是，是嘛......"
    },
    {
        "id": 38,
        "raw": "[name=\"阿米娅\"]   我想......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我想......"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"阿米娅\"]   这是因为，这对于我们双方来说都很重要。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这是因为，这对于我们双方来说都很重要。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"陈\"]   我明白了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我明白了。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"阿米娅\"]   如果要请示魏先生的话——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "如果要请示魏先生的话——"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"陈\"]   我们调查了米莎相关的情报，有一条情报指出，她的父亲是切尔诺伯格的要人之一。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我们调查了米莎相关的情报，有一条情报指出，她的父亲是切尔诺伯格的要人之一。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"阿米娅\"]   米莎的父亲？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "米莎的父亲？"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"陈\"]   当然，我们也不知道，米莎究竟握有多少切尔诺伯格的资料。",
        "type": "dialog",
        "speaker": "陈",
        "content": "当然，我们也不知道，米莎究竟握有多少切尔诺伯格的资料。"
    },
    {
        "id": 51,
        "raw": "[name=\"陈\"]   可能是零，也可能是一百。",
        "type": "dialog",
        "speaker": "陈",
        "content": "可能是零，也可能是一百。"
    },
    {
        "id": 52,
        "raw": "[name=\"陈\"]   谁都不会知道有多少——",
        "type": "dialog",
        "speaker": "陈",
        "content": "谁都不会知道有多少——"
    },
    {
        "id": 53,
        "raw": "[name=\"陈\"]   ——除了米莎本人。",
        "type": "dialog",
        "speaker": "陈",
        "content": "——除了米莎本人。"
    },
    {
        "id": 54,
        "raw": "[name=\"陈\"]   而那些切尔诺伯格的信息，究竟含括哪些内容，我们也不清楚。",
        "type": "dialog",
        "speaker": "陈",
        "content": "而那些切尔诺伯格的信息，究竟含括哪些内容，我们也不清楚。"
    },
    {
        "id": 55,
        "raw": "[name=\"陈\"]   既然你们推测整合运动的下一个目标是龙门——",
        "type": "dialog",
        "speaker": "陈",
        "content": "既然你们推测整合运动的下一个目标是龙门——"
    },
    {
        "id": 56,
        "raw": "[name=\"陈\"]   那么，阻止整合运动对切尔诺伯格的利用是理所应当的。",
        "type": "dialog",
        "speaker": "陈",
        "content": "那么，阻止整合运动对切尔诺伯格的利用是理所应当的。"
    },
    {
        "id": 57,
        "raw": "[name=\"陈\"]   所以，我们并不想让整合运动得到这名感染者，米莎。",
        "type": "dialog",
        "speaker": "陈",
        "content": "所以，我们并不想让整合运动得到这名感染者，米莎。"
    },
    {
        "id": 58,
        "raw": "[name=\"陈\"]   包括“有这样一个感染者随着逃难的人群进入了龙门”这条情报在内——",
        "type": "dialog",
        "speaker": "陈",
        "content": "包括“有这样一个感染者随着逃难的人群进入了龙门”这条情报在内——"
    },
    {
        "id": 59,
        "raw": "[name=\"陈\"]   在你发现米莎之前，我也并不能确定这几条情报的真实性。",
        "type": "dialog",
        "speaker": "陈",
        "content": "在你发现米莎之前，我也并不能确定这几条情报的真实性。"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 61,
        "raw": "[name=\"阿米娅\"]   这样的话，就不能再拖了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这样的话，就不能再拖了。"
    },
    {
        "id": 62,
        "raw": "[name=\"阿米娅\"]   必须在整合运动回到切尔诺伯格前阻止他们，救回米莎！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "必须在整合运动回到切尔诺伯格前阻止他们，救回米莎！"
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]   罗德岛，立刻进行整备！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛，立刻进行整备！"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"陈\"]   追缉这名感染者，是我们近卫局的任务。",
        "type": "dialog",
        "speaker": "陈",
        "content": "追缉这名感染者，是我们近卫局的任务。"
    },
    {
        "id": 66,
        "raw": "[name=\"陈\"]   ——同时，让她落入整合运动之手，也是我们的失职。",
        "type": "dialog",
        "speaker": "陈",
        "content": "——同时，让她落入整合运动之手，也是我们的失职。"
    },
    {
        "id": 67,
        "raw": "[name=\"陈\"]   比起共同追缉，我们需要罗德岛清除整合运动的其他威胁。",
        "type": "dialog",
        "speaker": "陈",
        "content": "比起共同追缉，我们需要罗德岛清除整合运动的其他威胁。"
    },
    {
        "id": 68,
        "raw": "[name=\"陈\"]   这是命令。",
        "type": "dialog",
        "speaker": "陈",
        "content": "这是命令。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"阿米娅\"]   ——我明白了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——我明白了。"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"陈\"]   交给你了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "交给你了。"
    },
