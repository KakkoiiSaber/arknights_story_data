        "fadetime": "0.6,",
        "block": true
    },
    {
        "id": 52,
        "raw": "[name=\"梅菲斯特\"]   我们的同胞，早就在各个城区中潜伏着，寻找着机会。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我们的同胞，早就在各个城区中潜伏着，寻找着机会。"
    },
    {
        "id": 53,
        "raw": "[name=\"梅菲斯特\"]   最终他们被我们追上，得到了应有的惩罚。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "最终他们被我们追上，得到了应有的惩罚。"
    },
    {
        "id": 54,
        "raw": "[name=\"梅菲斯特\"]   这些懦夫，这些施暴者，我们该怎么处理他们呢？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "这些懦夫，这些施暴者，我们该怎么处理他们呢？"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5.png"
    },
    {
        "id": 56,
        "raw": "[name=\"梅菲斯特\"]   当然是——让他们成为一个标志！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "当然是——让他们成为一个标志！"
    },
    {
        "id": 57,
        "raw": "[name=\"梅菲斯特\"]   一个宣告感染者身上的一切不公，终将被摧毁的标志——",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "一个宣告感染者身上的一切不公，终将被摧毁的标志——"
    },
    {
        "id": 58,
        "raw": "[name=\"梅菲斯特\"]   ——没错，那就是，整合运动的标志——",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "——没错，那就是，整合运动的标志——"
    },
    {
        "id": 59,
        "raw": "[name=\"梅菲斯特\"]   让它们一个个都成为恐怖的象征吧！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "让它们一个个都成为恐怖的象征吧！"
    },
    {
        "id": 60,
        "raw": "[name=\"梅菲斯特\"]   你们，去点燃那个标志！照亮周围！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你们，去点燃那个标志！照亮周围！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 62,
        "raw": "[name=\"整合运动成员\"]   是！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "是！"
