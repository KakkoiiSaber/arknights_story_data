        "randomness": "90,",
        "fadeout": "true,",
        "block": false
    },
    {
        "id": 99,
        "raw": "[name=\"陈\"]   ——龙门既不是因为有人出言不逊就拒绝善意的城市——",
        "type": "dialog",
        "speaker": "陈",
        "content": "——龙门既不是因为有人出言不逊就拒绝善意的城市——"
    },
    {
        "id": 100,
        "raw": "[name=\"陈\"]   却也不是收留无用说客的慈善机构。",
        "type": "dialog",
        "speaker": "陈",
        "content": "却也不是收留无用说客的慈善机构。"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_010_chen_1#5\", focus=1)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 102,
        "raw": "[name=\"魏彦吾\"]   陈警官。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "陈警官。"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_010_chen_1#5\", focus=2)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 104,
        "raw": "[name=\"陈\"]   魏长官，让外来的感染者参与龙门的机密事务，我认为并不妥当。",
        "type": "dialog",
        "speaker": "陈",
        "content": "魏长官，让外来的感染者参与龙门的机密事务，我认为并不妥当。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_010_chen_1#5\", focus=1)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"魏彦吾\"]   冷静些，陈警官，他们是客人。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "冷静些，陈警官，他们是客人。"
    },
    {
        "id": 107,
        "raw": "[name=\"魏彦吾\"]   ——我的客人。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——我的客人。"
    },
    {
        "id": 108,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_010_chen_1#5\", focus=2)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 109,
        "raw": "[name=\"陈\"]   .....",
        "type": "dialog",
        "speaker": "陈",
        "content": "....."
    },
    {
        "id": 110,
        "raw": "[name=\"陈\"]   是。",
        "type": "dialog",
        "speaker": "陈",
        "content": "是。"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 112,
        "raw": "[name=\"陈\"]   在他们违反龙门法律之前，我会容忍，长官。",
        "type": "dialog",
        "speaker": "陈",
        "content": "在他们违反龙门法律之前，我会容忍，长官。"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_2005_weiyw_1\", name2=\"char_003_kalts_1\", focus=1)]",
        "type": "character",
        "name": "char_2005_weiyw_1",
        "name2": "char_003_kalts_1",
        "focus": 1
    },
    {
        "id": 114,
        "raw": "[name=\"魏彦吾\"]   啊，不好意思。我想起来了，有这么一句——",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "啊，不好意思。我想起来了，有这么一句——"
    },
    {
        "id": 115,
        "raw": "[name=\"魏彦吾\"]   ——没错，呣......",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——没错，呣......"
    },
    {
        "id": 116,
        "raw": "[name=\"魏彦吾\"]   我所看重的就只有一点。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我所看重的就只有一点。"
    },
    {
        "id": 117,
        "raw": "[name=\"魏彦吾\"]   实力。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "实力。"
    },
    {
        "id": 118,
        "raw": "[name=\"魏彦吾\"]   据我所知，罗德岛也参与清剿了附近的感染者吧？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "据我所知，罗德岛也参与清剿了附近的感染者吧？"
    },
    {
        "id": 119,
        "raw": "[name=\"魏彦吾\"]   陈警官，以目前确切了解的情报，罗德岛在军事力量的实力如何？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "陈警官，以目前确切了解的情报，罗德岛在军事力量的实力如何？"
    },
    {
        "id": 120,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1"
    },
    {
        "id": 121,
        "raw": "[name=\"陈\"]   ......请容我简要描述一下我所见的罗德岛的行动情况。",
        "type": "dialog",
        "speaker": "陈",
        "content": "......请容我简要描述一下我所见的罗德岛的行动情况。"
