        "widgetID": "1",
        "fadetime": "0.5,",
        "block": true
    },
    {
        "id": 79,
        "raw": "[name=\"魏彦吾\"]   决定是否要和你们进行利益交换的是龙门。如果这种程度的信息罗德岛都无法提供的话——",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "决定是否要和你们进行利益交换的是龙门。如果这种程度的信息罗德岛都无法提供的话——"
    },
    {
        "id": 80,
        "raw": "[name=\"魏彦吾\"]   呵。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "呵。"
    },
    {
        "id": 81,
        "raw": "[name=\"魏彦吾\"]   龙门将无法信任你们的真实实力。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "龙门将无法信任你们的真实实力。"
    },
