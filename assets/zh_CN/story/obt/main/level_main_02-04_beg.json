        "name": "char_103_angel_1"
    },
    {
        "id": 58,
        "raw": "[name=\"能天使\"]   哟，罗德岛的各位~",
        "type": "dialog",
        "speaker": "能天使",
        "content": "哟，罗德岛的各位~"
    },
    {
        "id": 59,
        "raw": "[name=\"能天使\"]   任务是不是很快就完成了？“企鹅”的服务如何？",
        "type": "dialog",
        "speaker": "能天使",
        "content": "任务是不是很快就完成了？“企鹅”的服务如何？"
    },
    {
        "id": 60,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1"
    },
    {
        "id": 61,
        "raw": "[name=\"芙兰卡\"]   ——我就知道。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "——我就知道。"
    },
    {
