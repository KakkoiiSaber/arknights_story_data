        "name": "char_002_amiya_1",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"阿米娅\"]   毕竟是我们找到了目标......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "毕竟是我们找到了目标......"
    },
