        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 84,
        "raw": "[name=\"雷蛇\"]   看来整合运动确实已经渗透进了龙门。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "看来整合运动确实已经渗透进了龙门。"
    },
    {
