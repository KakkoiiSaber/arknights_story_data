        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"雷蛇\"]   （龙门近卫局并没有向我们出示过任何目标的具体资料。）",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "（龙门近卫局并没有向我们出示过任何目标的具体资料。）"
    },
    {
        "id": 35,
        "raw": "[name=\"雷蛇\"]   明明是合作者，却突然向我们告知，被我们发现的感染者有重要作用。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "明明是合作者，却突然向我们告知，被我们发现的感染者有重要作用。"
    },
    {
        "id": 36,
        "raw": "[name=\"雷蛇\"]   我们缺少了许多关键信息。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "我们缺少了许多关键信息。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 38,
        "raw": "[name=\"阿米娅\"]   （......近卫局不过多透露信息是理所当然的。）",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "（......近卫局不过多透露信息是理所当然的。）"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"雷蛇\"]   为什么？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "为什么？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"芙兰卡\"]   你那聪明脑瓜现在转不过来了？知道太多对罗德岛有什么好处？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "你那聪明脑瓜现在转不过来了？知道太多对罗德岛有什么好处？"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"雷蛇\"]   我只理解知道太少对任务有害。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "我只理解知道太少对任务有害。"
    },
    {
        "id": 45,
        "raw": "[name=\"雷蛇\"]   总之，我们得先把米莎护送到汇合地点。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "总之，我们得先把米莎护送到汇合地点。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 47,
        "raw": "[name=\"阿米娅\"]   路线的选择，唔——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "路线的选择，唔——"
    },
    {
        "id": 48,
        "raw": "[name=\"阿米娅\"]   又得麻烦他们了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "又得麻烦他们了。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"雷蛇\"]   你是指？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "你是指？"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 52,
