        "raw": "[Character(name=\"char_002_amiya_1#6\", name2=\"char_103_angel_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#6",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "id": 82,
