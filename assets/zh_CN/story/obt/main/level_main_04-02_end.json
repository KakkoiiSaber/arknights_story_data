        "id": 69,
        "raw": "[Character(name=\"char_002_amiya_1#3\")]",
        "type": "character",
        "name": "char_002_amiya_1#3"
    },
    {
        "id": 70,
        "raw": "[name=\"阿米娅\"]   感染者不是什么问题。无论是健康人还是感染者——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "感染者不是什么问题。无论是健康人还是感染者——"
    },
    {
        "id": 71,
        "raw": "[name=\"阿米娅\"]   你如果是个好孩子，就一直是个好孩子哦。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "你如果是个好孩子，就一直是个好孩子哦。"
    },
    {
        "id": 72,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 73,
        "raw": "[name=\"孩童\"]   唉——？我听不懂呢......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "唉——？我听不懂呢......"
    },
