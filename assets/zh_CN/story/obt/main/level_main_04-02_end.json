        "id": 79,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 80,
        "raw": "[name=\"阿米娅\"]   ......给，我只带了这些。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......给，我只带了这些。"
    },
    {
        "id": 81,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 82,
        "raw": "[name=\"孩童\"]   太好了！谢谢你，兔姐姐！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "太好了！谢谢你，兔姐姐！"
    },
    {
        "id": 83,
        "raw": "[name=\"孩童\"]   不过你.....为什么来这里？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "不过你.....为什么来这里？"
    },
    {
