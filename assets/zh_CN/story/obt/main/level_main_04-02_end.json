    },
    {
        "id": 11,
        "raw": "[name=\"阿米娅\"]   唔！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "唔！"
    },
    {
        "id": 12,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 13,
        "raw": "[name=\"孩童\"]   抱，抱歉，我不是有意撞过来......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "抱，抱歉，我不是有意撞过来......"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 15,
        "raw": "[name=\"阿米娅\"]   我没事的。你很有礼貌呢。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我没事的。你很有礼貌呢。"
    },
    {
        "id": 16,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 17,
        "raw": "[name=\"孩童\"]   嘿嘿......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "嘿嘿......"
    },
    {
        "id": 18,
        "raw": "[name=\"孩童\"]   咦，姐姐你在这里做什么？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "咦，姐姐你在这里做什么？"
    },
    {
        "id": 19,
        "raw": "[name=\"孩童\"]   这里可还在下雨呢，为什么不躲一躲？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "这里可还在下雨呢，为什么不躲一躲？"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   啊......嗯......我只是......出来走走。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊......嗯......我只是......出来走走。"
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   你是在找人帮忙吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "你是在找人帮忙吗？"
    },
    {
        "id": 23,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 24,
        "raw": "[name=\"孩童\"]   啊！姐姐是怎么知道的！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "啊！姐姐是怎么知道的！"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 26,
        "raw": "[name=\"阿米娅\"]   不能告诉你！这可是姐姐的秘密。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不能告诉你！这可是姐姐的秘密。"
    },
    {
        "id": 27,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 28,
        "raw": "[name=\"孩童\"]   唔唔......不管了！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "唔唔......不管了！"
    },
    {
        "id": 29,
        "raw": "[name=\"孩童\"]   姐姐，能不能请你——",
        "type": "dialog",
        "speaker": "孩童",
        "content": "姐姐，能不能请你——"
    },
    {
        "id": 30,
        "raw": "[name=\"孩童\"]   好像......不太行。姐姐，你的个子，太小了......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "好像......不太行。姐姐，你的个子，太小了......"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 32,
        "raw": "[name=\"阿米娅\"]   可不能这么说别人！你明明比我矮！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "可不能这么说别人！你明明比我矮！"
    },
    {
        "id": 33,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 34,
        "raw": "[name=\"孩童\"]  哇哇！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "哇哇！"
    },
    {
        "id": 35,
        "raw": "[name=\"孩童\"]  那，那我们试试吧......嗯......能不能帮我抬一下那块板子？一起来吧！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "那，那我们试试吧......嗯......能不能帮我抬一下那块板子？一起来吧！"
    },
    {
        "id": 36,
        "raw": "[name=\"孩童\"]  那个铁架下面，有台留声机，我想拿回去。",
        "type": "dialog",
        "speaker": "孩童",
        "content": "那个铁架下面，有台留声机，我想拿回去。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 38,
        "raw": "[name=\"阿米娅\"]   好的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "好的。"
    },
    {
        "id": 39,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 40,
        "raw": "[name=\"孩童\"]   1......2......3！嘿！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "1......2......3！嘿！"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 42,
        "raw": "[name=\"阿米娅\"]   成功了！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "成功了！"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 44,
        "raw": "[name=\"阿米娅\"]   ......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......"
    },
    {
        "id": 45,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 46,
        "raw": "[name=\"孩童\"]   哇，姐姐力气还蛮大的呢！谢谢姐姐！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "哇，姐姐力气还蛮大的呢！谢谢姐姐！"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 48,
        "raw": "[name=\"阿米娅\"]   可是......这个留声机......还是坏了啊。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "可是......这个留声机......还是坏了啊。"
    },
    {
        "id": 49,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 50,
        "raw": "[name=\"孩童\"]   没关系！因为它最开始就是坏的呢。",
        "type": "dialog",
        "speaker": "孩童",
        "content": "没关系！因为它最开始就是坏的呢。"
    },
    {
        "id": 51,
        "raw": "[name=\"孩童\"]   总有一天可以修好的。我给大家收集了不少唱片，虽然从来都没听过——",
        "type": "dialog",
        "speaker": "孩童",
        "content": "总有一天可以修好的。我给大家收集了不少唱片，虽然从来都没听过——"
    },
    {
        "id": 52,
        "raw": "[name=\"孩童\"]   ————但总有一天，我会给大家放的！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "————但总有一天，我会给大家放的！"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 54,
        "raw": "[name=\"阿米娅\"]   ......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......"
    },
    {
        "id": 55,
        "raw": "[name=\"阿米娅\"]   ......如此轻松的说着这些艰难的话......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......如此轻松的说着这些艰难的话......"
    },
    {
        "id": 56,
        "raw": "[name=\"阿米娅\"]   ......我到底是为了什么......又能做什么......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......我到底是为了什么......又能做什么......"
    },
    {
        "id": 57,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 58,
        "raw": "[name=\"孩童\"]   姐姐不怕我吗？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "姐姐不怕我吗？"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 60,
        "raw": "[name=\"阿米娅\"]   ......怕什么？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......怕什么？"
    },
    {
        "id": 61,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 62,
        "raw": "[name=\"孩童\"]   我可是感染者哦！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "我可是感染者哦！"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 64,
        "raw": "[name=\"阿米娅\"]   哈哈......我也是呀。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "哈哈......我也是呀。"
    },
    {
        "id": 65,
        "raw": "[Character(fadetime=0)]",
        "type": "character",
        "fadetime": 0
    },
    {
        "id": 66,
        "raw": "[name=\"孩童\"]   什么！太可惜了，姐姐长得这么可爱，居然是感染者......！",
        "type": "dialog",
        "speaker": "孩童",
        "content": "什么！太可惜了，姐姐长得这么可爱，居然是感染者......！"
