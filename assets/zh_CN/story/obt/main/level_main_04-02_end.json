        "speaker": "孩童",
        "content": "（咕噜......）"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1"
    },
    {
        "id": 76,
        "raw": "[name=\"阿米娅\"]   ......饿了吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......饿了吗？"
    },
    {
        "id": 77,
