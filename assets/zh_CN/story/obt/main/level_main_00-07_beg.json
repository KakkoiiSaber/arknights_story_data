        "raw": "[PlayMusic(intro=\"$calamity_intro\", key=\"$calamity_loop\", volume=1, crossfade=1.5)]",
        "type": "play_music",
        "intro": "audio/sound_beta_2/music/beta2_180603/m_dia_calamity_intro.mp3",
        "key": "audio/sound_beta_2/music/beta2_180603/m_dia_calamity_loop.mp3",
