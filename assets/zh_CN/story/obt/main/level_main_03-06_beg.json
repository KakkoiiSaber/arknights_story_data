        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"陈\"]   在战场上发呆是很危险的。",
        "type": "dialog",
        "speaker": "陈",
        "content": "在战场上发呆是很危险的。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"阿米娅\"]   ……抱歉。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……抱歉。"
    },
    {
        "id": 11,
        "raw": "[name=\"阿米娅\"]   我只是……没能理解。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我只是……没能理解。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"陈\"]   整合运动龟缩在一个废弃矿场里。",
        "type": "dialog",
        "speaker": "陈",
        "content": "整合运动龟缩在一个废弃矿场里。"
    },
    {
        "id": 14,
        "raw": "[name=\"陈\"]   那个女人，W，也一起逃进去了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "那个女人，W，也一起逃进去了。"
    },
    {
        "id": 15,
        "raw": "[name=\"陈\"]   ——",
        "type": "dialog",
        "speaker": "陈",
        "content": "——"
    },
    {
        "id": 16,
        "raw": "[name=\"陈\"]   你如果想独自待着，我也会给你点空间。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你如果想独自待着，我也会给你点空间。"
    },
    {
        "id": 17,
        "raw": "[name=\"陈\"]   但近卫局却没有能拿来浪费的时间。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但近卫局却没有能拿来浪费的时间。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"陈\"]   星熊，让其他人集合。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊，让其他人集合。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   （米莎……）",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "（米莎……）"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"阿米娅\"]   陈长官——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官——"
    },
    {
        "id": 24,
        "raw": "[name=\"阿米娅\"]   我有一个疑虑。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我有一个疑虑。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"陈\"]   疑虑？",
        "type": "dialog",
        "speaker": "陈",
        "content": "疑虑？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#2\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#2",
        "focus": 2
    },
    {
        "id": 28,
        "raw": "[name=\"阿米娅\"]   W擅长使用爆炸物。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "W擅长使用爆炸物。"
    },
    {
        "id": 29,
        "raw": "[name=\"阿米娅\"]   她极有可能会在战场上散布陷阱。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "她极有可能会在战场上散布陷阱。"
    },
    {
        "id": 30,
        "raw": "[name=\"阿米娅\"]   我担心，纯粹的正面进攻会给我们带来很大损失。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我担心，纯粹的正面进攻会给我们带来很大损失。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"阿米娅\"]   我提议，由罗德岛干员先行潜入矿场，近卫局在外围设置包围网。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我提议，由罗德岛干员先行潜入矿场，近卫局在外围设置包围网。"
    },
    {
        "id": 33,
        "raw": "[name=\"阿米娅\"]   任何从中逃出的整合运动，可以由近卫局立刻逮捕——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "任何从中逃出的整合运动，可以由近卫局立刻逮捕——"
    },
    {
        "id": 34,
        "raw": "[name=\"阿米娅\"]   而顽抗的整合运动，由我们处理。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "而顽抗的整合运动，由我们处理。"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 36,
        "raw": "[name=\"陈\"]   你们对付那个女人，有几成把握？",
        "type": "dialog",
        "speaker": "陈",
        "content": "你们对付那个女人，有几成把握？"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 38,
        "raw": "[name=\"阿米娅\"]   我不知道——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我不知道——"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 40,
        "raw": "[name=\"阿米娅\"]   ——但我们可以承担相应风险。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——但我们可以承担相应风险。"
    },
    {
        "id": 41,
        "raw": "[name=\"阿米娅\"]   我们与她战斗过不止一次，至少对她的作战风格有一定的了解。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们与她战斗过不止一次，至少对她的作战风格有一定的了解。"
    },
    {
        "id": 42,
        "raw": "[name=\"阿米娅\"]   有的风险，近卫局是承担不起的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "有的风险，近卫局是承担不起的。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"陈\"]   ——丢失任务目标的风险，近卫局同样承担不起。",
        "type": "dialog",
        "speaker": "陈",
        "content": "——丢失任务目标的风险，近卫局同样承担不起。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"阿米娅\"]   ……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 48,
        "raw": "[name=\"陈\"]   PC94172，你带近卫局的队伍包围矿场！",
        "type": "dialog",
        "speaker": "陈",
        "content": "PC94172，你带近卫局的队伍包围矿场！"
    },
    {
        "id": 49,
        "raw": "[name=\"陈\"]   星熊，去挑几个人。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊，去挑几个人。"
    },
    {
        "id": 50,
        "raw": "[name=\"陈\"]   我们各带一支小队，和罗德岛一起去。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我们各带一支小队，和罗德岛一起去。"
    },
    {
        "id": 51,
        "raw": "[name=\"陈\"]   星熊你和罗德岛分两路，同时摧毁他们的阵地，扰乱他们的防线。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊你和罗德岛分两路，同时摧毁他们的阵地，扰乱他们的防线。"
    },
    {
        "id": 52,
        "raw": "[name=\"陈\"]   我去处理火力点。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我去处理火力点。"
    },
    {
        "id": 53,
        "raw": "[name=\"陈\"]   为了龙门，我必须把米莎——",
        "type": "dialog",
        "speaker": "陈",
        "content": "为了龙门，我必须把米莎——"
    },
    {
        "id": 54,
        "raw": "[name=\"陈\"]   ……",
        "type": "dialog",
        "speaker": "陈",
        "content": "……"
    },
    {
        "id": 55,
        "raw": "[name=\"陈\"]   ……夺回来。",
        "type": "dialog",
        "speaker": "陈",
        "content": "……夺回来。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"阿米娅\"]   ——明白。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——明白。"
    },
    {
        "id": 58,
        "raw": "[name=\"阿米娅\"]   我去召集罗德岛干员。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我去召集罗德岛干员。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_136_hsguma\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"星熊\"]   老陈，矿场边缘——有波整合运动正向外移动。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "老陈，矿场边缘——有波整合运动正向外移动。"
    },
    {
        "id": 61,
        "raw": "[name=\"星熊\"]   ——动作还挺快的。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "——动作还挺快的。"
    },
    {
        "id": 62,
        "raw": "[name=\"星熊\"]   我先去了，否则会赶不上。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "我先去了，否则会赶不上。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_136_hsguma\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_136_hsguma",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"陈\"]   快去。一个也别漏掉。",
        "type": "dialog",
        "speaker": "陈",
        "content": "快去。一个也别漏掉。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_136_hsguma\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_136_hsguma",
        "focus": 1
    },
    {
        "id": 66,
        "raw": "[name=\"阿米娅\"]   啊，星熊督察，请稍等。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊，星熊督察，请稍等。"
    },
    {
        "id": 67,
        "raw": "[name=\"阿米娅\"]   敌人针对我们罗德岛设下的埋伏中，混有整合运动的术师。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "敌人针对我们罗德岛设下的埋伏中，混有整合运动的术师。"
    },
    {
        "id": 68,
        "raw": "[name=\"阿米娅\"]   我建议让我方干员芙兰卡和雷蛇跟着星熊督察你的小队。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我建议让我方干员芙兰卡和雷蛇跟着星熊督察你的小队。"
    },
    {
        "id": 69,
        "raw": "[name=\"阿米娅\"]   他们有非常丰富的对抗术师的经验。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "他们有非常丰富的对抗术师的经验。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_136_hsguma\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"星熊\"]   没问题。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "没问题。"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 73,
        "raw": "[name=\"芙兰卡\"]   那就，合作愉快咯？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "那就，合作愉快咯？"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1.png"
    },
    {
        "id": 75,
        "raw": "[name=\"雷蛇\"]   那你呢，阿米娅？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "那你呢，阿米娅？"
    },
    {
        "id": 76,
        "raw": "[name=\"雷蛇\"]   凯尔希医生嘱咐我们的是……",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "凯尔希医生嘱咐我们的是……"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 78,
        "raw": "[name=\"阿米娅\"]   这里有企鹅物流帮助我，没关系的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这里有企鹅物流帮助我，没关系的。"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 80,
        "raw": "[name=\"星熊\"]   那就这么定了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "那就这么定了。"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 82,
        "raw": "[name=\"陈\"]   千万不要逞强，撑不住就立刻撤退。",
        "type": "dialog",
        "speaker": "陈",
        "content": "千万不要逞强，撑不住就立刻撤退。"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_010_chen_1\",name2=\"char_002_amiya_1#7\",focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
