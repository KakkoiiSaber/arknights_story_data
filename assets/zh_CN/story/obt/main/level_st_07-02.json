        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 200,
        "raw": "[name=\"魏彦吾\"]  我不是个道德家。但文月，我细细看来，该死的还是只有一个人。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我不是个道德家。但文月，我细细看来，该死的还是只有一个人。"
    },
    {
        "id": 201,
        "raw": "[name=\"魏彦吾\"]  ——我。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——我。"
    },
    {
        "id": 202,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\")]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png"
    },
    {
        "id": 203,
        "raw": "[name=\"文月\"]  ……不要这样……别这样！",
        "type": "dialog",
        "speaker": "文月",
        "content": "……不要这样……别这样！"
    },
