    {
        "id": 98,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 99,
        "raw": "[name=\"魏彦吾\"]  ……即使我可以把凯尔希的话当成谎言，我也无法否认事实。那就是针对龙门的阴谋，实在是太像科西切的手笔了。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……即使我可以把凯尔希的话当成谎言，我也无法否认事实。那就是针对龙门的阴谋，实在是太像科西切的手笔了。"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"文月\"]  我不相信。小塔从来都不是那种人。她为什么要这么做？",
        "type": "dialog",
        "speaker": "文月",
        "content": "我不相信。小塔从来都不是那种人。她为什么要这么做？"
    },
    {
        "id": 102,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 103,
        "raw": "[name=\"魏彦吾\"]  你我现在不得不信。这一切都是塔露拉一手策划。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "你我现在不得不信。这一切都是塔露拉一手策划。"
    },
    {
        "id": 104,
        "raw": "[name=\"魏彦吾\"]  可如果她要觉得龙门会坐以待毙，她就大错特错。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "可如果她要觉得龙门会坐以待毙，她就大错特错。"
    },
    {
        "id": 105,
        "raw": "[name=\"魏彦吾\"]  龙门不会失败。我不会让龙门受到丁点伤害。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "龙门不会失败。我不会让龙门受到丁点伤害。"
    },
    {
        "id": 106,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 107,
        "raw": "[name=\"文月\"]  却也不能阻止战争。",
        "type": "dialog",
        "speaker": "文月",
        "content": "却也不能阻止战争。"
    },
    {
        "id": 108,
        "raw": "[name=\"文月\"]  ……你想让我与你共死吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "……你想让我与你共死吗？"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 110,
        "raw": "[name=\"魏彦吾\"]  文月？！",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "文月？！"
    },
    {
        "id": 111,
        "raw": "[name=\"魏彦吾\"]  ——你在威胁我？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——你在威胁我？"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 113,
        "raw": "[name=\"文月\"]  唉哟。不是。哎我不是这个意思。我是说……",
        "type": "dialog",
        "speaker": "文月",
        "content": "唉哟。不是。哎我不是这个意思。我是说……"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 115,
        "raw": "[name=\"魏彦吾\"]  不！绝不。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "不！绝不。"
    },
    {
        "id": 116,
        "raw": "[name=\"魏彦吾\"]  ……懦夫才要搭上别人的性命。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……懦夫才要搭上别人的性命。"
    },
    {
        "id": 117,
        "raw": "[name=\"魏彦吾\"]  何况是你！我不可能……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "何况是你！我不可能……"
    },
    {
        "id": 118,
        "raw": "[name=\"魏彦吾\"]  也许我曾懦弱过，但是，不，文月。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "也许我曾懦弱过，但是，不，文月。"
    },
    {
        "id": 119,
        "raw": "[name=\"魏彦吾\"]  我不允许任何人动你。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我不允许任何人动你。"
    },
    {
        "id": 120,
        "raw": "[name=\"魏彦吾\"]  我会把你藏起来。无论是莱塔尼亚还是萨尔贡，萨米……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我会把你藏起来。无论是莱塔尼亚还是萨尔贡，萨米……"
    },
    {
        "id": 121,
        "raw": "[name=\"魏彦吾\"]  你不能回东国，我把你送到遥远的国家去，送到那些没有人知道的宁静的小城去。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "你不能回东国，我把你送到遥远的国家去，送到那些没有人知道的宁静的小城去。"
    },
    {
        "id": 122,
        "raw": "[name=\"魏彦吾\"]  我会把你藏在无人知晓的地方。胞弟……他再怎么恨我也不会追杀你到那么远的地方……他不会。对，他不会。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我会把你藏在无人知晓的地方。胞弟……他再怎么恨我也不会追杀你到那么远的地方……他不会。对，他不会。"
    },
    {
        "id": 123,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 124,
        "raw": "[name=\"文月\"]  可我也活不了。",
        "type": "dialog",
        "speaker": "文月",
        "content": "可我也活不了。"
    },
    {
        "id": 125,
        "raw": "[name=\"文月\"]  你要我一个人独活吗，彦吾？",
        "type": "dialog",
        "speaker": "文月",
        "content": "你要我一个人独活吗，彦吾？"
    },
    {
        "id": 126,
        "raw": "[name=\"文月\"]  你想用你的死来折磨我吗？你难道不记得你的妹妹是为什么在忧郁中死去吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "你想用你的死来折磨我吗？你难道不记得你的妹妹是为什么在忧郁中死去吗？"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 128,
        "raw": "[name=\"魏彦吾\"]  不，不……文月，不，我想你活着。我……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "不，不……文月，不，我想你活着。我……"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 130,
        "raw": "[name=\"文月\"]  魏彦吾，我是说……我可以的。",
        "type": "dialog",
        "speaker": "文月",
        "content": "魏彦吾，我是说……我可以的。"
    },
    {
        "id": 131,
        "raw": "[name=\"文月\"]  和你一起死，已经是我能想象到的糟糕结局里最好的一种。或者，它尽管很糟糕，对我来说，也是好结局。",
        "type": "dialog",
        "speaker": "文月",
        "content": "和你一起死，已经是我能想象到的糟糕结局里最好的一种。或者，它尽管很糟糕，对我来说，也是好结局。"
    },
    {
        "id": 132,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 133,
        "raw": "[name=\"魏彦吾\"]  文月，不……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "文月，不……"
    },
    {
        "id": 134,
        "raw": "[name=\"魏彦吾\"]  我不会做这种人。我也不许你这么做。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我不会做这种人。我也不许你这么做。"
    },
    {
        "id": 135,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 136,
        "raw": "[name=\"文月\"]  但你知道，你拦不住我的。我要做什么，你从来没拦住过我。",
        "type": "dialog",
        "speaker": "文月",
        "content": "但你知道，你拦不住我的。我要做什么，你从来没拦住过我。"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 138,
        "raw": "[name=\"魏彦吾\"]  文月……！",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "文月……！"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 140,
        "raw": "[name=\"文月\"]  彦吾，你一直对我说真心话的。你有时候会什么都不说，但你只要说了，我知道你只会对我说真心话。",
        "type": "dialog",
        "speaker": "文月",
        "content": "彦吾，你一直对我说真心话的。你有时候会什么都不说，但你只要说了，我知道你只会对我说真心话。"
    },
    {
        "id": 141,
        "raw": "[name=\"文月\"]  我不想你死。我也不想小塔死。我不想我们里任何一个人死。",
        "type": "dialog",
        "speaker": "文月",
        "content": "我不想你死。我也不想小塔死。我不想我们里任何一个人死。"
    },
    {
        "id": 142,
        "raw": "[name=\"文月\"]  我想小塔了，她的面相和你的妹妹是那么像，但她的眼睛又像爱德华，小时候那脾气也不知道像谁……这么多年了，我这么多年没见她了。",
        "type": "dialog",
        "speaker": "文月",
        "content": "我想小塔了，她的面相和你的妹妹是那么像，但她的眼睛又像爱德华，小时候那脾气也不知道像谁……这么多年了，我这么多年没见她了。"
    },
    {
        "id": 143,
        "raw": "[name=\"文月\"]  这一切是我们欠她的。",
        "type": "dialog",
        "speaker": "文月",
        "content": "这一切是我们欠她的。"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 145,
        "raw": "[name=\"魏彦吾\"]  ……还有晖洁。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……还有晖洁。"
    },
    {
        "id": 146,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 147,
        "raw": "[name=\"文月\"]  对。还有小陈。",
        "type": "dialog",
        "speaker": "文月",
        "content": "对。还有小陈。"
    },
    {
        "id": 148,
        "raw": "[name=\"文月\"]  小陈已经走了，我以后再也看不见她，再也没法给她买漂亮的衣服，给她梳些适合她的发型了。",
        "type": "dialog",
        "speaker": "文月",
        "content": "小陈已经走了，我以后再也看不见她，再也没法给她买漂亮的衣服，给她梳些适合她的发型了。"
    },
    {
        "id": 149,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 150,
        "raw": "[name=\"魏彦吾\"]  她……她没那么喜欢传统的打扮。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "她……她没那么喜欢传统的打扮。"
    },
    {
        "id": 151,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 152,
        "raw": "[name=\"文月\"]  可是我喜欢啊。那有多漂亮，她会有多漂亮啊。",
        "type": "dialog",
        "speaker": "文月",
        "content": "可是我喜欢啊。那有多漂亮，她会有多漂亮啊。"
    },
    {
        "id": 153,
        "raw": "[name=\"文月\"]  ……可我还是想，哪怕这样，哪怕是就此永别，我也希望小陈在另一个地方好好活着，好好地活着。我就这么想。",
        "type": "dialog",
        "speaker": "文月",
        "content": "……可我还是想，哪怕这样，哪怕是就此永别，我也希望小陈在另一个地方好好活着，好好地活着。我就这么想。"
    },
    {
        "id": 154,
        "raw": "[name=\"文月\"]  我知道你不想倚仗罗德岛，也清楚你不会把宝全部押在他们身上。",
        "type": "dialog",
        "speaker": "文月",
        "content": "我知道你不想倚仗罗德岛，也清楚你不会把宝全部押在他们身上。"
    },
    {
        "id": 155,
        "raw": "[name=\"文月\"]  但我想你等上一等。",
        "type": "dialog",
        "speaker": "文月",
        "content": "但我想你等上一等。"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 157,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
    {
        "id": 158,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 159,
        "raw": "[name=\"文月\"]  让他们去做吧，彦吾。",
        "type": "dialog",
        "speaker": "文月",
        "content": "让他们去做吧，彦吾。"
    },
    {
        "id": 160,
        "raw": "[name=\"文月\"]  如果他们没做到，我们再一起去。你不想再沾上亲人的血了吧？",
        "type": "dialog",
        "speaker": "文月",
        "content": "如果他们没做到，我们再一起去。你不想再沾上亲人的血了吧？"
    },
    {
        "id": 161,
        "raw": "[name=\"文月\"]  那我来帮你取走小塔的性命。然后我再和你共死。",
        "type": "dialog",
        "speaker": "文月",
        "content": "那我来帮你取走小塔的性命。然后我再和你共死。"
    },
    {
        "id": 162,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 163,
        "raw": "[name=\"魏彦吾\"]  文月……！",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "文月……！"
    },
    {
        "id": 164,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 165,
        "raw": "[name=\"文月\"]  你也更想她也活着吧？这座龙门城，难道是想我们所有人都去死吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "你也更想她也活着吧？这座龙门城，难道是想我们所有人都去死吗？"
    },
    {
        "id": 166,
        "raw": "[name=\"文月\"]  我宁可再也见不到她们了。我宁可永远看不到小陈和小塔，把她们都忘了……我也想她们活着。",
        "type": "dialog",
        "speaker": "文月",
        "content": "我宁可再也见不到她们了。我宁可永远看不到小陈和小塔，把她们都忘了……我也想她们活着。"
    },
    {
        "id": 167,
        "raw": "[name=\"文月\"]  就像你一样。就像你也希望我这么选一样。",
        "type": "dialog",
        "speaker": "文月",
        "content": "就像你一样。就像你也希望我这么选一样。"
    },
    {
        "id": 168,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 169,
        "raw": "[name=\"魏彦吾\"]  文月。一旦事情陷入不可回转的境地，你必须听我的安排。我们的生命……不是不可分割的。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "文月。一旦事情陷入不可回转的境地，你必须听我的安排。我们的生命……不是不可分割的。"
    },
    {
        "id": 170,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 171,
        "raw": "[name=\"文月\"]  当然不是。彦吾，我并不只是为了你才站在这里的。",
        "type": "dialog",
        "speaker": "文月",
        "content": "当然不是。彦吾，我并不只是为了你才站在这里的。"
    },
    {
        "id": 172,
        "raw": "[name=\"文月\"]  ……我所做的一切，从头至尾，也不全是为了你。",
        "type": "dialog",
        "speaker": "文月",
        "content": "……我所做的一切，从头至尾，也不全是为了你。"
    },
    {
        "id": 173,
        "raw": "[name=\"文月\"]  你要看到我在坚持什么。",
        "type": "dialog",
        "speaker": "文月",
        "content": "你要看到我在坚持什么。"
    },
    {
        "id": 174,
        "raw": "[name=\"文月\"]  别再躲躲闪闪了。看着我。",
        "type": "dialog",
        "speaker": "文月",
        "content": "别再躲躲闪闪了。看着我。"
    },
    {
        "id": 175,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 176,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
    {
        "id": 177,
        "raw": "[name=\"魏彦吾\"]  我会坚持自己的决定……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我会坚持自己的决定……"
    },
    {
        "id": 178,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\")]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png"
    },
    {
        "id": 179,
        "raw": "[name=\"文月\"]  你想哭吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "你想哭吗？"
    },
    {
        "id": 180,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 181,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
