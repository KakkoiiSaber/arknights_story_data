        "content": ""
    },
    {
        "id": 15,
        "raw": "[name=\"文月\"]  ……",
        "type": "dialog",
        "speaker": "文月",
        "content": "……"
    },
    {
        "id": 16,
        "raw": "[name=\"文月\"]  不拉窗帘吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "不拉窗帘吗？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 18,
        "raw": "[name=\"魏彦吾\"]  玻璃已经碎了。拉上窗帘只是欺骗自己。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "玻璃已经碎了。拉上窗帘只是欺骗自己。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 20,
        "raw": "[name=\"文月\"]  玻璃是小事，小陈她没事……才是大事。",
        "type": "dialog",
        "speaker": "文月",
        "content": "玻璃是小事，小陈她没事……才是大事。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 22,
        "raw": "[name=\"魏彦吾\"]  身手很好。既不像她父亲，也不像她母亲。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "身手很好。既不像她父亲，也不像她母亲。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 24,
        "raw": "[name=\"文月\"]  是啊，不像她。",
        "type": "dialog",
        "speaker": "文月",
        "content": "是啊，不像她。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
    {
        "id": 27,
        "raw": "[name=\"魏彦吾\"]  我脚下已经又是一片灯火通明。龙门城已恢复了往日气象，可之后会发生什么，他们尚一无所知。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我脚下已经又是一片灯火通明。龙门城已恢复了往日气象，可之后会发生什么，他们尚一无所知。"
    },
    {
        "id": 28,
        "raw": "[name=\"魏彦吾\"]  这场灾难，陈晖洁一个人无法阻止。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "这场灾难，陈晖洁一个人无法阻止。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"文月\"]  还有罗德岛和她一起。他们会找到她的。",
        "type": "dialog",
        "speaker": "文月",
        "content": "还有罗德岛和她一起。他们会找到她的。"
    },
    {
        "id": 31,
        "raw": "[name=\"文月\"]  唉……",
        "type": "dialog",
        "speaker": "文月",
        "content": "唉……"
    },
    {
        "id": 32,
        "raw": "[name=\"文月\"]  维特已经钳制不住保守派了。这么多年来他努力压制各个大公，却也只能削弱他们，没法彻底打败他们。",
        "type": "dialog",
        "speaker": "文月",
        "content": "维特已经钳制不住保守派了。这么多年来他努力压制各个大公，却也只能削弱他们，没法彻底打败他们。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"魏彦吾\"]  大叛乱之后，各集团军将领和旧贵族已经元气大伤，他们的地位和资源只会被帝国议会逐一消化。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "大叛乱之后，各集团军将领和旧贵族已经元气大伤，他们的地位和资源只会被帝国议会逐一消化。"
    },
    {
        "id": 35,
        "raw": "[name=\"魏彦吾\"]  可我担心……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "可我担心……"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"文月\"]  担心什么？",
        "type": "dialog",
        "speaker": "文月",
        "content": "担心什么？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"魏彦吾\"]  如果维特在说谎呢？如果这件事正是维特和帝国皇帝谋划的呢？如果那个年轻的皇帝策划了这一切呢？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "如果维特在说谎呢？如果这件事正是维特和帝国皇帝谋划的呢？如果那个年轻的皇帝策划了这一切呢？"
    },
    {
        "id": 40,
        "raw": "[name=\"魏彦吾\"]  我们的敌人，一直身处暗处。我们却不得不站在最敞亮的地方。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我们的敌人，一直身处暗处。我们却不得不站在最敞亮的地方。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"文月\"]  比起其他许多人，你已经在暗处了。",
        "type": "dialog",
        "speaker": "文月",
        "content": "比起其他许多人，你已经在暗处了。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 44,
        "raw": "[name=\"魏彦吾\"]  ……还不够。就像当年一样。如果是科西切……如果是科西切，他会藏得更深。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……还不够。就像当年一样。如果是科西切……如果是科西切，他会藏得更深。"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"文月\"]  可你不是科西切。科西切不会把龙门建设成现在这样。",
        "type": "dialog",
        "speaker": "文月",
        "content": "可你不是科西切。科西切不会把龙门建设成现在这样。"
    },
    {
        "id": 47,
        "raw": "[name=\"文月\"]  只是，小塔……如果小塔真是被科西切教成这样的……",
        "type": "dialog",
        "speaker": "文月",
        "content": "只是，小塔……如果小塔真是被科西切教成这样的……"
    },
    {
        "id": 48,
        "raw": "[name=\"文月\"]  ……",
        "type": "dialog",
        "speaker": "文月",
        "content": "……"
    },
    {
        "id": 49,
        "raw": "[name=\"文月\"]  你觉得，那个罗德岛的医生，她在说谎吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "你觉得，那个罗德岛的医生，她在说谎吗？"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"魏彦吾\"]  我不清楚。像这个医生一样的人，很少有不说谎的。罗德岛善于掩藏自己。他们对我们示弱，不会透露一点秘密。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我不清楚。像这个医生一样的人，很少有不说谎的。罗德岛善于掩藏自己。他们对我们示弱，不会透露一点秘密。"
    },
    {
        "id": 52,
        "raw": "[name=\"魏彦吾\"]  但我宁可相信科西切塑造了现在的塔露拉。轻敌的恶果我们承担不起。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "但我宁可相信科西切塑造了现在的塔露拉。轻敌的恶果我们承担不起。"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 54,
        "raw": "[name=\"文月\"]  ……小塔……",
        "type": "dialog",
        "speaker": "文月",
        "content": "……小塔……"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 56,
        "raw": "[name=\"魏彦吾\"]  也正因如此，我不能让陈晖洁去做这件事。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "也正因如此，我不能让陈晖洁去做这件事。"
    },
    {
        "id": 57,
        "raw": "[name=\"魏彦吾\"]  科西切……事情正无疑向他期待的那样发展。即使他死了，他的愿景也可能被他的继承人塑造成型。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "科西切……事情正无疑向他期待的那样发展。即使他死了，他的愿景也可能被他的继承人塑造成型。"
    },
    {
        "id": 58,
        "raw": "[name=\"魏彦吾\"]  这一切绝不能如他所愿。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "这一切绝不能如他所愿。"
    },
    {
        "id": 59,
        "raw": "[name=\"魏彦吾\"]  侦察队回报，一部分从龙门离开的感染者正往核心城的方向移动。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "侦察队回报，一部分从龙门离开的感染者正往核心城的方向移动。"
    },
    {
        "id": 60,
        "raw": "[name=\"魏彦吾\"]  核心城必须停靠一段时间，这时间里他们会接收感染者难民。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "核心城必须停靠一段时间，这时间里他们会接收感染者难民。"
    },
    {
        "id": 61,
        "raw": "[name=\"魏彦吾\"]  纵使塔露拉露出了属于乌萨斯恶毒的尖牙，她也不会当着所有人的面背叛整合运动。这是最好的机会。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "纵使塔露拉露出了属于乌萨斯恶毒的尖牙，她也不会当着所有人的面背叛整合运动。这是最好的机会。"
    },
    {
        "id": 62,
        "raw": "[name=\"魏彦吾\"]  我会带上影卫。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我会带上影卫。"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 64,
        "raw": "[name=\"文月\"]  你？！",
        "type": "dialog",
        "speaker": "文月",
        "content": "你？！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 66,
        "raw": "[name=\"魏彦吾\"]  他们已经为我做得太多。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "他们已经为我做得太多。"
    },
    {
        "id": 67,
        "raw": "[name=\"魏彦吾\"]  我答应过他们，不会再让他们手沾血腥，之后却一次次地打破承诺。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我答应过他们，不会再让他们手沾血腥，之后却一次次地打破承诺。"
    },
    {
        "id": 68,
        "raw": "[name=\"魏彦吾\"]  现在又要让他们再为龙门而死？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "现在又要让他们再为龙门而死？"
    },
    {
        "id": 69,
        "raw": "[name=\"魏彦吾\"]  ……那我也必与他们一同。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……那我也必与他们一同。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=1)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 1
    },
    {
        "id": 71,
        "raw": "[name=\"文月\"]  不行。",
        "type": "dialog",
        "speaker": "文月",
        "content": "不行。"
    },
    {
        "id": 72,
        "raw": "[name=\"文月\"]  你这样做，也是科西切想看的。你这样根本不算赢。",
        "type": "dialog",
        "speaker": "文月",
        "content": "你这样做，也是科西切想看的。你这样根本不算赢。"
    },
    {
        "id": 73,
        "raw": "[name=\"文月\"]  ……难道从我们夺回龙门开始，一切就滑向了科西切的陷阱吗？",
        "type": "dialog",
        "speaker": "文月",
        "content": "……难道从我们夺回龙门开始，一切就滑向了科西切的陷阱吗？"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_2006_weiywfmzuki_1\",name2=\"char_2005_weiyw_1#5\",focus=2)]",
        "type": "character",
        "name": "char_2006_weiywfmzuki_1.png",
        "name2": "char_2005_weiyw_1#5",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
    {
        "id": 76,
        "raw": "[name=\"魏彦吾\"]  我们胜利过。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我们胜利过。"
    },
    {
        "id": 77,
        "raw": "[name=\"魏彦吾\"]  最初是我们的胜利。即使惨痛，我、你、爱德华、舸瑞，没有我们，他将会把这座城市蚕食干净。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "最初是我们的胜利。即使惨痛，我、你、爱德华、舸瑞，没有我们，他将会把这座城市蚕食干净。"
    },
    {
        "id": 78,
        "raw": "[name=\"魏彦吾\"]  我从来没有把这件事当成一个不幸的开始。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我从来没有把这件事当成一个不幸的开始。"
    },
    {
        "id": 79,
        "raw": "[name=\"魏彦吾\"]  ……我也不会把爱德华的死算在科西切的头上。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……我也不会把爱德华的死算在科西切的头上。"
    },
    {
