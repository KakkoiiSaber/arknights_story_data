    {
        "id": 49,
        "raw": "[name=\"陈\"]  星熊，我准备好了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊，我准备好了。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 51,
        "raw": "[name=\"星熊\"]  这才像话！我会把所有埋伏点都毁掉，把他们全都逼出来。给我三分钟。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "这才像话！我会把所有埋伏点都毁掉，把他们全都逼出来。给我三分钟。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"陈\"]  乱来，你要独自作战三分钟，毁掉所有埋伏点？别被冲昏头脑！",
        "type": "dialog",
        "speaker": "陈",
        "content": "乱来，你要独自作战三分钟，毁掉所有埋伏点？别被冲昏头脑！"
    },
    {
        "id": 54,
        "raw": "[name=\"陈\"]  如果你出了任何差错，我会立刻指挥进攻！",
        "type": "dialog",
        "speaker": "陈",
        "content": "如果你出了任何差错，我会立刻指挥进攻！"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"星熊\"]  不。给我三分钟。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "不。给我三分钟。"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"陈\"]  ......只有三分钟。",
        "type": "dialog",
        "speaker": "陈",
        "content": "......只有三分钟。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 60,
        "raw": "[name=\"星熊\"]  我去了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "我去了。"
    },
