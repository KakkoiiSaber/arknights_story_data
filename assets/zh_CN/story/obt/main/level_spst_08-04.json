    },
    {
        "id": 39,
        "raw": "[name=\"老练的罗德岛干员\"] ......什么情况？敌人呢？",
        "type": "dialog",
        "speaker": "老练的罗德岛干员",
        "content": "......什么情况？敌人呢？"
