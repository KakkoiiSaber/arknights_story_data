    {
        "id": 67,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 68,
        "raw": "[name=\"阿丽娜\"] ……有人告密了。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "……有人告密了。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"avg_npc_093#4\",name2=\"avg_npc_079#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_093#4.png",
        "name2": "avg_npc_079#4",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"老妇\"] 啊？什么？什么告密？",
        "type": "dialog",
        "speaker": "老妇",
        "content": "啊？什么？什么告密？"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_093#4\",name2=\"avg_npc_079#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_093#4.png",
        "name2": "avg_npc_079#4",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"阿丽娜\"] 纠察队知道我们村子里有一个感染者。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "纠察队知道我们村子里有一个感染者。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_093#4\",name2=\"avg_npc_079#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_093#4.png",
        "name2": "avg_npc_079#4",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"老妇\"] 怎么可能，不会这样的……啊！",
        "type": "dialog",
        "speaker": "老妇",
        "content": "怎么可能，不会这样的……啊！"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 76,
        "raw": "[name=\"阿丽娜\"] 我不知道他们从哪里得来的消息，但是我们都明白包藏感染者的下场是怎么个样子。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "我不知道他们从哪里得来的消息，但是我们都明白包藏感染者的下场是怎么个样子。"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"avg_npc_078#4\")]",
        "type": "character",
        "name": "avg_npc_078#4.png"
    },
    {
        "id": 78,
        "raw": "[name=\"塔露拉\"] ……",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "……"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_079#4\")]",
        "type": "character",
        "name": "avg_npc_079#4.png"
    },
    {
        "id": 80,
        "raw": "[name=\"阿丽娜\"] 老妈妈，我爸爸去世得早，妈妈也全赖你们照顾，我把你们就当是我自己的爷爷奶奶一样。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "老妈妈，我爸爸去世得早，妈妈也全赖你们照顾，我把你们就当是我自己的爷爷奶奶一样。"
    },
    {
        "id": 81,
        "raw": "[name=\"阿丽娜\"] 到现在这个关头，我也没什么好隐瞒的……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "到现在这个关头，我也没什么好隐瞒的……"
    },
