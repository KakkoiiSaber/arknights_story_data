        "type": "character",
        "name": "avg_npc_095.png"
    },
    {
        "id": 154,
        "raw": "[name=\"Pith\"]  你下不了手的话我来。",
        "type": "dialog",
        "speaker": "Pith",
        "content": "你下不了手的话我来。"
    },
