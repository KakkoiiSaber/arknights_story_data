        "type": "character",
        "name": "avg_npc_095.png"
    },
    {
        "id": 162,
        "raw": "[name=\"Pith\"]  我畏惧那个没能决断的未来。",
        "type": "dialog",
        "speaker": "Pith",
        "content": "我畏惧那个没能决断的未来。"
    },
