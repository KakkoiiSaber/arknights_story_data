    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012.png"
    },
    {
        "id": 60,
        "raw": "[name=\"罗德岛干员\"] ……通讯结束。",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "……通讯结束。"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 62,
        "raw": "[name=\"阿米娅\"] 状况怎么样？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "状况怎么样？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012.png"
    },
    {
        "id": 64,
        "raw": "[name=\"罗德岛干员\"] 啊，阿米娅。工程小组一人牺牲，其他人暂且还安全。",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "啊，阿米娅。工程小组一人牺牲，其他人暂且还安全。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 66,
        "raw": "[name=\"阿米娅\"] 迷迭香……我们的正面火力有点不足。游击队的迫击炮小队需要补给。我们要打个时间差。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "迷迭香……我们的正面火力有点不足。游击队的迫击炮小队需要补给。我们要打个时间差。"
    },
    {
        "id": 67,
        "raw": "[name=\"阿米娅\"] ……你还好吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……你还好吗？"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#7\",focus=1)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#7",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"迷迭香\"] ……阿米娅，Ace死了以后，你在想什么？",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "……阿米娅，Ace死了以后，你在想什么？"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"阿米娅\"] 啊……！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊……！"
    },
    {
        "id": 72,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 73,
        "raw": "[name=\"迷迭香\"] 不想回答也行。我只是很想知道。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "不想回答也行。我只是很想知道。"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 75,
        "raw": "[name=\"阿米娅\"] 抱歉，我不想想起太多。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "抱歉，我不想想起太多。"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"迷迭香\"] 阿米娅也会想要逃避吗？",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "阿米娅也会想要逃避吗？"
    },
    {
        "id": 78,
        "raw": "[Character(name=\"avg_npc_042\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_042.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 79,
        "raw": "[name=\"阿米娅\"] 不是，只是还没到重新面对的时候。眼泪要留到一切都结束之后。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不是，只是还没到重新面对的时候。眼泪要留到一切都结束之后。"
    },
    {
        "id": 80,
        "raw": "[name=\"阿米娅\"] 我只记得最后，我觉得……我想起来——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我只记得最后，我觉得……我想起来——"
    },
    {
        "id": 81,
        "raw": "[name=\"阿米娅\"] 不能让他和罗德岛的干员们白白死去。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不能让他和罗德岛的干员们白白死去。"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 83,
        "raw": "[name=\"迷迭香\"] 好。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "好。"
    },
    {
        "id": 84,
        "raw": "[name=\"迷迭香\"] 侦查干员，告诉我方位，我去。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "侦查干员，告诉我方位，我去。"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 86,
        "raw": "[name=\"阿米娅\"] 整合运动已经陷入了一片混乱，要小心。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "整合运动已经陷入了一片混乱，要小心。"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 88,
        "raw": "[name=\"迷迭香\"] 因为我们是他们的敌人？",
