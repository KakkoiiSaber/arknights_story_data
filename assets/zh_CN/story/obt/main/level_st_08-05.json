        "raw": "[Character(name=\"avg_npc_012\",name2=\"char_401_elysm\",focus=2)]",
        "type": "character",
        "name": "avg_npc_012.png",
        "name2": "char_401_elysm",
        "focus": 2
    },
    {
        "id": 201,
        "raw": "[name=\"极境\"] （嘘，嘘，再这样说，你可要被队长骂了。）",
        "type": "dialog",
        "speaker": "极境",
        "content": "（嘘，嘘，再这样说，你可要被队长骂了。）"
