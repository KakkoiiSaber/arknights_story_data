    {
        "id": 157,
        "raw": "[Character(name=\"avg_npc_095\")]",
        "type": "character",
        "name": "avg_npc_095.png"
    },
    {
        "id": 158,
        "raw": "[name=\"Pith\"]  你和阿米娅太相信他们的未来了。我们一步踏错，只会让别的人永远失去未来。",
        "type": "dialog",
        "speaker": "Pith",
        "content": "你和阿米娅太相信他们的未来了。我们一步踏错，只会让别的人永远失去未来。"
    },
    {
        "id": 159,
        "raw": "[Character(name=\"char_003_kalts_1\")]",
        "type": "character",
        "name": "char_003_kalts_1.png"
    },
    {
        "id": 160,
        "raw": "[name=\"凯尔希\"]  决断之前，至少先有所作为。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "决断之前，至少先有所作为。"
    },
