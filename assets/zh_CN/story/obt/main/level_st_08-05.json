        "name": "avg_npc_012.png"
    },
    {
        "id": 195,
        "raw": "[name=\"霍克\"] 怎么会没看到。",
        "type": "dialog",
        "speaker": "霍克",
        "content": "怎么会没看到。"
    },
    {
        "id": 196,
        "raw": "[Character(name=\"avg_npc_012\",name2=\"char_401_elysm\",focus=2)]",
        "type": "character",
        "name": "avg_npc_012.png",
        "name2": "char_401_elysm",
        "focus": 2
    },
    {
        "id": 197,
        "raw": "[name=\"极境\"] 你别说话，会暴露的。",
        "type": "dialog",
        "speaker": "极境",
        "content": "你别说话，会暴露的。"
    },
    {
