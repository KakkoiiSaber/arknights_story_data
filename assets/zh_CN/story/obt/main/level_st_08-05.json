        "name": "avg_npc_012.png",
        "name2": "char_401_elysm",
        "focus": 1
    },
    {
        "id": 199,
        "raw": "[name=\"霍克\"] （那你问我干什么？你可还在大声喧哗。）",
        "type": "dialog",
        "speaker": "霍克",
        "content": "（那你问我干什么？你可还在大声喧哗。）"
