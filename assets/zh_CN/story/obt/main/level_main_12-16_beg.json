        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_647_1#1$1.png",
        "focus": "m"
    },
    {
        "id": 57,
        "raw": "[name=\"戈尔丁\"]我知道，变形者，我很明白你说的这些话。",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "我知道，变形者，我很明白你说的这些话。"
