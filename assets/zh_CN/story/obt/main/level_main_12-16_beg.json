    {
        "id": 31,
        "raw": "[name=\"变形者集群\"]你为什么如此纠结于这一点？",
        "type": "dialog",
        "speaker": "变形者集群",
        "content": "你为什么如此纠结于这一点？"
    },
    {
        "id": 32,
