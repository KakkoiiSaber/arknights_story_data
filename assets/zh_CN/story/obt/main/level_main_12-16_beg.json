        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_647_1#2$1.png",
        "focus": "m"
    },
    {
        "id": 61,
        "raw": "[name=\"戈尔丁\"]可是，我知道，我没法做到，我没办法面对……",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "可是，我知道，我没法做到，我没办法面对……"
