        "raw": "[charslot(slot=\"m\",name=\"avg_npc_647_1#1$1\",focus=\"m\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_647_1#1$1.png",
        "focus": "m"
    },
    {
        "id": 55,
        "raw": "[name=\"戈尔丁\"]死了就是死了而已。",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "死了就是死了而已。"
