        "slot": "m",
        "name": "avg_npc_426_1#1$1.png",
        "focus": "m"
    },
    {
        "id": 27,
        "raw": "[name=\"变形者集群\"]莱托会伤心的。",
        "type": "dialog",
        "speaker": "变形者集群",
        "content": "莱托会伤心的。"
    },
    {
        "id": 28,
