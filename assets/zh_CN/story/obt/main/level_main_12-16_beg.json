        "slot": "m",
        "name": "avg_npc_647_1#2$1.png",
        "focus": "m"
    },
    {
        "id": 29,
        "raw": "[name=\"戈尔丁\"]我必须要这么做。",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "我必须要这么做。"
    },
