        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_647_1#7$1.png",
        "focus": "m"
    },
    {
        "id": 41,
        "raw": "[name=\"戈尔丁\"]我该承受这种怨恨。",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "我该承受这种怨恨。"
