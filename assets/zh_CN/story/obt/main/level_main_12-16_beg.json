        "focus": "m"
    },
    {
        "id": 45,
        "raw": "[name=\"变形者集群\"]说实话，这让我们困惑……",
        "type": "dialog",
        "speaker": "变形者集群",
        "content": "说实话，这让我们困惑……"
    },
