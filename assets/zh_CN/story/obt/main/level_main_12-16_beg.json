        "id": 38,
        "raw": "[charslot(slot=\"m\",name=\"avg_npc_647_1#7$1\",focus=\"m\")]",
        "type": "charslot",
        "slot": "m",
        "name": "avg_npc_647_1#7$1.png",
        "focus": "m"
    },
    {
        "id": 39,
        "raw": "[name=\"戈尔丁\"]这大概很难吧，那么多人因我而死。",
        "type": "dialog",
        "speaker": "戈尔丁",
        "content": "这大概很难吧，那么多人因我而死。"
    },
