        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"碎骨\"]   ——怎么？要我和罗德岛谈谈？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "——怎么？要我和罗德岛谈谈？"
