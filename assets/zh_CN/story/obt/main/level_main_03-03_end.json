        "raw": "[name=\"碎骨\"]   你有。",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "你有。"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"char_1504_cqbw\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_1504_cqbw.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 112,
        "raw": "[name=\"W\"]   行，行。",
        "type": "dialog",
        "speaker": "W",
        "content": "行，行。"
    },
    {
        "id": 113,
        "raw": "[name=\"W\"]   但，光是保护米莎，并不太够吧？",
        "type": "dialog",
        "speaker": "W",
        "content": "但，光是保护米莎，并不太够吧？"
    },
    {
