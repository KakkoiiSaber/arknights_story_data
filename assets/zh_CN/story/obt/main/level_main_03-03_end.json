        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 108,
        "raw": "[name=\"W\"]   我没有这个义务吧？",
        "type": "dialog",
        "speaker": "W",
        "content": "我没有这个义务吧？"
