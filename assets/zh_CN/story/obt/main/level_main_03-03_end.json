    {
        "id": 52,
        "raw": "[Character(name=\"char_012_misa_1\", name2=\"char_1500_skulsr\", focus=1)]",
        "type": "character",
        "name": "char_012_misa_1.png",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"米莎\"]   他们，他们一定会帮助感染者的。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "他们，他们一定会帮助感染者的。"
