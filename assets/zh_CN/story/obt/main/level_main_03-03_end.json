        "type": "dialog",
        "speaker": "碎骨",
        "content": "只要这样装上弹药......"
    },
    {
        "id": 10,
        "raw": "[name=\"碎骨\"]   瞄准敌人，按下扳机。",
        "type": "dialog",
        "speaker": "碎骨",
