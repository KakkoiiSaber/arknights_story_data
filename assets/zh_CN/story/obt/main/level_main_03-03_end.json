        "name": "char_1500_skulsr.png"
    },
    {
        "id": 55,
        "raw": "[name=\"碎骨\"]   我那么多同胞都死在罗德岛手上——",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "我那么多同胞都死在罗德岛手上——"
    },
    {
        "id": 56,
        "raw": "[name=\"碎骨\"]   你却让我，和他们谈谈？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "你却让我，和他们谈谈？"
    },
    {
        "id": 57,
        "raw": "[name=\"碎骨\"]   我的同胞，他们都是感染者！",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "我的同胞，他们都是感染者！"
    },
    {
        "id": 58,
        "raw": "[name=\"碎骨\"]   声称自己会救助感染者的罗德岛，难道帮助过他们吗？",
        "type": "dialog",
        "speaker": "碎骨",
        "content": "声称自己会救助感染者的罗德岛，难道帮助过他们吗？"
