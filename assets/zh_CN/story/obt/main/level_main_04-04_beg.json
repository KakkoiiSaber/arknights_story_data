        "name": "char_010_chen_1#5.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 26,
        "raw": "[name=\"阿米娅\"]   有数支整合运动小队正在谋划针对龙门的防卫力量发动袭击。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "有数支整合运动小队正在谋划针对龙门的防卫力量发动袭击。"
    },
    {
        "id": 27,
        "raw": "[name=\"阿米娅\"]   我们甚至查到一个整合运动向内渗透的渠道。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们甚至查到一个整合运动向内渗透的渠道。"
    },
