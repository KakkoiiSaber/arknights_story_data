        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"陈\"]   呵，真是嚣张。",
        "type": "dialog",
        "speaker": "陈",
        "content": "呵，真是嚣张。"
    },
    {
        "id": 30,
        "raw": "[name=\"陈\"]   龙门近卫局被小看了呢。",
        "type": "dialog",
        "speaker": "陈",
        "content": "龙门近卫局被小看了呢。"
    },
    {
        "id": 31,
        "raw": "[name=\"陈\"]   关于那个切尔诺伯格分城废墟的呢？",
