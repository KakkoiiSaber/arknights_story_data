    },
    {
        "id": 11,
        "raw": "[name=\"陈\"]   情况如何？",
        "type": "dialog",
        "speaker": "陈",
        "content": "情况如何？"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]   罗德岛的侦查小队已经提供了一些有效情报。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛的侦查小队已经提供了一些有效情报。"
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]   我总结了一下，从其中选了几条你会感兴趣的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我总结了一下，从其中选了几条你会感兴趣的。"
    },
    {
        "id": 15,
        "raw": "[name=\"阿米娅\"]   啊......星熊警官......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊......星熊警官......"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 17,
        "raw": "[name=\"星熊\"]   别在意。我也想稍微听一下。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "别在意。我也想稍微听一下。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 19,
        "raw": "[name=\"陈\"]   继续说吧，阿米娅，没关系的。",
        "type": "dialog",
        "speaker": "陈",
        "content": "继续说吧，阿米娅，没关系的。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   好的。依据罗德岛从部分感染者那里得来的线索——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "好的。依据罗德岛从部分感染者那里得来的线索——"
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   侦查小队已经查明了龙门平民区内整合运动的一部分窝点。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "侦查小队已经查明了龙门平民区内整合运动的一部分窝点。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5.png"
    },
    {
        "id": 24,
        "raw": "[name=\"陈\"]   然后呢？",
        "type": "dialog",
        "speaker": "陈",
        "content": "然后呢？"
