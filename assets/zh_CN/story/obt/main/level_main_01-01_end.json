        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"阿米娅\"]  也不全是这样......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "也不全是这样......"
    },
