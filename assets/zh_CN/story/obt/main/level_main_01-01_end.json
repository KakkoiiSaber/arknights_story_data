    {
        "id": 54,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1"
    },
    {
        "id": 55,
        "raw": "[name=\"阿米娅\"]  啊......他们是一家只医治感染者的黑市诊所。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊......他们是一家只医治感染者的黑市诊所。"
    },
    {
        "id": 56,
        "raw": "[name=\"阿米娅\"]  鉴于感染者的社会地位，大家是不可能在街道上抛头露面的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "鉴于感染者的社会地位，大家是不可能在街道上抛头露面的。"
    },
    {
        "id": 57,
        "raw": "[name=\"阿米娅\"]  有些不愿被抛进隔离区的感染者，依然也会在城市里，小心翼翼地掩藏自己的身姿，苟活着......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "有些不愿被抛进隔离区的感染者，依然也会在城市里，小心翼翼地掩藏自己的身姿，苟活着......"
    },
    {
        "id": 58,
        "raw": "[name=\"阿米娅\"]  阿撒兹勒，就是向这些感染者提供服务的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "阿撒兹勒，就是向这些感染者提供服务的。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 60,
        "raw": "[name=\"阿米娅\"]  ......它们，一定是拒绝了整合运动的合作要求。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......它们，一定是拒绝了整合运动的合作要求。"
    },
    {
        "id": 61,
        "raw": "[name=\"阿米娅\"]  博士，我之前和你说过，我们得了病吧？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "博士，我之前和你说过，我们得了病吧？"
    },
    {
        "id": 62,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1"
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]  ......这种病，不仅会杀死我们，也会让我们拥有不同于常人的力量。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......这种病，不仅会杀死我们，也会让我们拥有不同于常人的力量。"
    },
    {
        "id": 64,
        "raw": "[name=\"阿米娅\"]  我不用法杖，就能释放源石技艺哦。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我不用法杖，就能释放源石技艺哦。"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 66,
        "raw": "[name=\"阿米娅\"]  然而，这种病，不止在生理上，会消磨我们的生命......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "然而，这种病，不止在生理上，会消磨我们的生命......"
    },
    {
        "id": 67,
        "raw": "[name=\"阿米娅\"]  它也会让我们再也不能像正常人一样生活。正常人的社会，会剥去你的一切。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "它也会让我们再也不能像正常人一样生活。正常人的社会，会剥去你的一切。"
    },
    {
        "id": 68,
        "raw": "[name=\"阿米娅\"]  这座切尔诺伯格城，已经是所有规则的象征了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这座切尔诺伯格城，已经是所有规则的象征了。"
    },
    {
        "id": 69,
        "raw": "[name=\"阿米娅\"]  驱逐感染者，消灭感染者，鄙夷感染者，恐惧感染者......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "驱逐感染者，消灭感染者，鄙夷感染者，恐惧感染者......"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_148_nearl_1#2\")]",
        "type": "character",
        "name": "char_148_nearl_1#2"
    },
    {
        "id": 71,
        "raw": "[name=\"临光\"]  ......",
        "type": "dialog",
        "speaker": "临光",
        "content": "......"
    },
    {
        "id": 72,
        "raw": "[name=\"临光\"]  最后，落到如此下场。",
        "type": "dialog",
        "speaker": "临光",
        "content": "最后，落到如此下场。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 74,
        "raw": "[name=\"阿米娅\"]  可是，又有多少感染者，会有机会，选择整合运动，甚至是其他的感染者组织，或者罗德岛？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "可是，又有多少感染者，会有机会，选择整合运动，甚至是其他的感染者组织，或者罗德岛？"
    },
    {
        "id": 75,
        "raw": "[name=\"阿米娅\"]  大多数感染者，不过是失去了所有。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "大多数感染者，不过是失去了所有。"
    },
    {
        "id": 76,
        "raw": "[name=\"阿米娅\"]  这个诊所，大概，也曾经是最后那么几个感染者，温暖的家吧......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这个诊所，大概，也曾经是最后那么几个感染者，温暖的家吧......"
    },
    {
        "id": 77,
        "raw": "[name=\"阿米娅\"]  矿石病是无药可医的。至少此时此刻，感染者只能在绝望中......痛苦地失去生命。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "矿石病是无药可医的。至少此时此刻，感染者只能在绝望中......痛苦地失去生命。"
    },
    {
        "id": 78,
        "raw": "[name=\"阿米娅\"]  而后他们的遗体......也会成为新的传染源。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "而后他们的遗体......也会成为新的传染源。"
    },
    {
        "id": 79,
        "raw": "[name=\"阿米娅\"]  不同于常人的特殊力量，染上之后就必然会死去的可怕传染病——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不同于常人的特殊力量，染上之后就必然会死去的可怕传染病——"
    },
    {
        "id": 80,
        "raw": "[name=\"阿米娅\"]  感染者......被这片大地上的多数人所恐惧。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "感染者......被这片大地上的多数人所恐惧。"
    },
    {
        "id": 81,
        "raw": "[name=\"阿米娅\"]  ——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——"
    },
    {
        "id": 82,
        "raw": "[name=\"阿米娅\"]  光是这么两三句话，博士大概也没法切身体会吧。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "光是这么两三句话，博士大概也没法切身体会吧。"
    },
    {
        "id": 83,
        "raw": "[name=\"阿米娅\"]  但当你面对这些问题导致的后果时......你会明白的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但当你面对这些问题导致的后果时......你会明白的。"
    },
    {
        "id": 84,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 85,
        "raw": "[name=\"阿米娅\"]  你会明白，感染者的处境，究竟有多现实。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "你会明白，感染者的处境，究竟有多现实。"
    },
    {
        "id": 86,
        "raw": "[Character(name=\"char_002_amiya_1#4\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 87,
        "raw": "[name=\"杜宾\"]  像罗德岛这样不分彼此，或是整合运动那样狂热的排外拥内的感染者组织，都很少见。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "像罗德岛这样不分彼此，或是整合运动那样狂热的排外拥内的感染者组织，都很少见。"
    },
    {
        "id": 88,
        "raw": "[name=\"杜宾\"]  我能理解你的怒气，但我也能理解那个小诊所的苦衷。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "我能理解你的怒气，但我也能理解那个小诊所的苦衷。"
    },
    {
        "id": 89,
        "raw": "[Character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop"
    },
    {
        "id": 90,
        "raw": "[name=\"近卫干员\"]  ......我明白了。",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "......我明白了。"
    },
    {
        "id": 91,
        "raw": "[name=\"近卫干员\"]  可能，他们是真的碰上了什么问题吧......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "可能，他们是真的碰上了什么问题吧......"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 93,
        "raw": "[name=\"杜宾\"]  至少现在，我们的怨气，都该和这个诊所的曾经一样，化作粉尘。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "至少现在，我们的怨气，都该和这个诊所的曾经一样，化作粉尘。"
    },
    {
        "id": 94,
        "raw": "[Character(name=\"char_002_amiya_1#1\")]",
        "type": "character",
        "name": "char_002_amiya_1#1"
    },
    {
        "id": 95,
        "raw": "[name=\"阿米娅\"]  罗德岛的各位都是好人。也许会有很多人因畏惧与敌意，相互间产生了种种隔阂......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛的各位都是好人。也许会有很多人因畏惧与敌意，相互间产生了种种隔阂......"
    },
    {
        "id": 96,
        "raw": "[name=\"阿米娅\"]  但只要在罗德岛，大家一定能解开误会。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但只要在罗德岛，大家一定能解开误会。"
    },
    {
        "id": 97,
