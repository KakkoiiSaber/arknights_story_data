    },
    {
        "id": 10,
        "raw": "[name=\"医疗干员\"]  这个诊所......",
        "type": "dialog",
        "speaker": "医疗干员",
        "content": "这个诊所......"
    },
    {
        "id": 11,
        "raw": "[name=\"医疗干员\"]  阿米娅，是不是以前我们来过那个？",
        "type": "dialog",
        "speaker": "医疗干员",
        "content": "阿米娅，是不是以前我们来过那个？"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_016_medic\",name2=\"char_002_amiya_1#1\",focus=2)]",
        "type": "character",
        "name": "char_016_medic",
        "name2": "char_002_amiya_1#1",
        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]  ......确实是......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......确实是......"
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]  只是怎么......已经变成了，这个样子？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "只是怎么......已经变成了，这个样子？"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_016_medic\",name2=\"char_002_amiya_1#1\",focus=1)]",
        "type": "character",
        "name": "char_016_medic",
        "name2": "char_002_amiya_1#1",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"医疗干员\"]  已经人去楼空了......看来，是遭到了整合运动的袭击吧......",
        "type": "dialog",
        "speaker": "医疗干员",
        "content": "已经人去楼空了......看来，是遭到了整合运动的袭击吧......"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_016_medic\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "char_016_medic",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"阿米娅\"]  ......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_013_riop\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"近卫干员\"]  这难道就是那个感染者诊所，阿撒兹勒？",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "这难道就是那个感染者诊所，阿撒兹勒？"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_013_riop\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]  ......是。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......是。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_013_riop\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_013_riop",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"近卫干员\"]  明明掌握着整个切尔诺伯格的地下情报网，却不肯和我们合作......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "明明掌握着整个切尔诺伯格的地下情报网，却不肯和我们合作......"
    },
    {
        "id": 25,
        "raw": "[name=\"近卫干员\"]  那时，他们和整合运动之间的关系也十分模棱两可......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "那时，他们和整合运动之间的关系也十分模棱两可......"
    },
    {
        "id": 26,
        "raw": "[name=\"近卫干员\"]  至少，如果他们当时肯向我们分享情报，或者仅仅是给个提示......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "至少，如果他们当时肯向我们分享情报，或者仅仅是给个提示......"
    },
    {
        "id": 27,
        "raw": "[name=\"近卫干员\"]  我们也许就早点能离开这里了。",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "我们也许就早点能离开这里了。"
    },
    {
        "id": 28,
        "raw": "[name=\"近卫干员\"]  这种下场，是他们自作自受！",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "这种下场，是他们自作自受！"
    },
    {
        "id": 29,
