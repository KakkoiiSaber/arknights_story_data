    {
        "id": 32,
        "raw": "[name=\"近卫干员\"]  阿米娅，当时和他们交涉时你也在场吧？",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "阿米娅，当时和他们交涉时你也在场吧？"
    },
    {
        "id": 33,
        "raw": "[name=\"近卫干员\"]  他们那傲慢冷漠的态度，我真是......",
        "type": "dialog",
        "speaker": "近卫干员",
