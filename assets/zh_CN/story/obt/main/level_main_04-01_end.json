    {
        "id": 16,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1.png"
    },
    {
        "id": 17,
        "raw": "[name=\"霜叶\"]   我只是有点在意阿米娅她们的状况。",
        "type": "dialog",
        "speaker": "霜叶",
        "content": "我只是有点在意阿米娅她们的状况。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_219_meteo_1\" )]",
        "type": "character",
        "name": "char_219_meteo_1.png"
    },
    {
        "id": 19,
        "raw": "[name=\"陨星\"]   阿米娅她们已经顺利回到罗德岛了。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "阿米娅她们已经顺利回到罗德岛了。"
    },
    {
        "id": 20,
        "raw": "[name=\"陨星\"]   临光和杜宾一个星期前就已经动身前往龙门外的其他地区。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "临光和杜宾一个星期前就已经动身前往龙门外的其他地区。"
    },
    {
        "id": 21,
        "raw": "[name=\"陨星\"]   同时出动她们两个，应该也是挺艰难的任务。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "同时出动她们两个，应该也是挺艰难的任务。"
    },
    {
        "id": 22,
        "raw": "[name=\"陨星\"]   黑钢和企鹅物流也有自己的事情要处理。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "黑钢和企鹅物流也有自己的事情要处理。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_259_Jessica_1\")]",
        "type": "character",
        "name": "char_259_Jessica_1.png"
    },
    {
        "id": 24,
        "raw": "[name=\"杰西卡\"]   啊，雷蛇姐和芙兰卡姐……",
        "type": "dialog",
        "speaker": "杰西卡",
        "content": "啊，雷蛇姐和芙兰卡姐……"
    },
    {
        "id": 25,
        "raw": "[name=\"杰西卡\"]   她们，她们平安就好……",
        "type": "dialog",
        "speaker": "杰西卡",
        "content": "她们，她们平安就好……"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"陨星\"]   你可也要好好加油才行。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "你可也要好好加油才行。"
    },
    {
        "id": 28,
        "raw": "[name=\"陨星\"]   芙兰卡把你交到我手上的时候，可是跟我说她很看好你的。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "芙兰卡把你交到我手上的时候，可是跟我说她很看好你的。"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 30,
        "raw": "[name=\"杰西卡\"]   真……真的吗？",
        "type": "dialog",
        "speaker": "杰西卡",
        "content": "真……真的吗？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_259_Jessica_1\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1.png",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"陨星\"]   她说，前提是你别那么怯生生的。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "她说，前提是你别那么怯生生的。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#4.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 34,
        "raw": "[name=\"杰西卡\"]   呜……",
        "type": "dialog",
        "speaker": "杰西卡",
        "content": "呜……"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_259_Jessica_1#4\", name2=\"char_219_meteo_1\", focus=2)]",
        "type": "character",
        "name": "char_259_Jessica_1#4.png",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "id": 36,
        "raw": "[name=\"陨星\"]   ……别突然就一副要哭出来的样子呀！",
        "type": "dialog",
        "speaker": "陨星",
        "content": "……别突然就一副要哭出来的样子呀！"
    },
    {
        "id": 37,
        "raw": "[name=\"陨星\"]   你不是黑钢的一员吗……？",
        "type": "dialog",
        "speaker": "陨星",
        "content": "你不是黑钢的一员吗……？"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_259_Jessica_1#5\", name2=\"char_219_meteo_1\", focus=1)]",
        "type": "character",
        "name": "char_259_Jessica_1#5.png",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "id": 39,
        "raw": "[name=\"杰西卡\"]   我，我没有……没有在哭……",
        "type": "dialog",
        "speaker": "杰西卡",
        "content": "我，我没有……没有在哭……"
    },
    {
        "id": 40,
