        "type": "character",
        "name": "avg_npc_078#2"
    },
    {
        "id": 127,
        "raw": "[name=\"塔露拉\"]  因为......因为我想成为一个表里如一的人。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "因为......因为我想成为一个表里如一的人。"
