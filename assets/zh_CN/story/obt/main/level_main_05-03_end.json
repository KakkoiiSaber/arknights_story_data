    {
        "id": 118,
        "raw": "[name=\"线人\"]  拿好，陈sir……S249TA，F106。",
        "type": "dialog",
        "speaker": "线人",
        "content": "拿好，陈sir……S249TA，F106。"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_010_chen_1#1\",name2=\"avg_npc_013\",focus=1)]",
