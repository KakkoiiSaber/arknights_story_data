        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"陈\"]  庆幸你没在五年前遇见她吧。我也很久没见她这样了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "庆幸你没在五年前遇见她吧。我也很久没见她这样了。"
    },
