    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_017_homura_3#9\",fadetime=1,block=true)]",
        "type": "character",
        "name": "char_017_homura_3#9",
        "fadetime": "1,block=true"
    },
    {
        "id": 97,
        "raw": "[delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 98,
        "raw": "[name=\"煌\"]  你现在问这种问题？",
        "type": "dialog",
        "speaker": "煌",
        "content": "你现在问这种问题？"
    },
    {
        "id": 99,
        "raw": "[Character(name=\"char_017_homura_3#9\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#9",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 100,
        "raw": "[name=\"阿米娅\"]  煌。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "煌。"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#5",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 102,
        "raw": "[name=\"煌\"]  ......你说吧。",
        "type": "dialog",
        "speaker": "煌",
        "content": "......你说吧。"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "id": 104,
        "raw": "[name=\"阿米娅\"]  这个问题，我也常常问自己。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这个问题，我也常常问自己。"
    },
    {
        "id": 105,
        "raw": "[name=\"阿米娅\"]  感染者，普通人，每天都在我们面前死去。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "感染者，普通人，每天都在我们面前死去。"
    },
    {
        "id": 106,
        "raw": "[name=\"阿米娅\"]  ......我们不会，也不应该只是“阻止一次死亡”。对于这片大地来说，这没有意义。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......我们不会，也不应该只是“阻止一次死亡”。对于这片大地来说，这没有意义。"
    },
    {
        "id": 107,
        "raw": "[name=\"阿米娅\"]  就像现在......就像我们面对的这场战斗一样。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "就像现在......就像我们面对的这场战斗一样。"
    },
    {
        "id": 108,
        "raw": "[name=\"阿米娅\"]  让战斗双方死去的，绝不是一把弩，一个法术......一场爆炸或是一个伤口。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "让战斗双方死去的，绝不是一把弩，一个法术......一场爆炸或是一个伤口。"
    },
    {
        "id": 109,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 110,
        "raw": "[name=\"阿米娅\"]  我们要战胜的，是催生了这一切的......普通人对感染者的仇视，感染者对普通人的仇视，他们互相厮杀的理由。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们要战胜的，是催生了这一切的......普通人对感染者的仇视，感染者对普通人的仇视，他们互相厮杀的理由。"
    },
    {
        "id": 111,
        "raw": "[name=\"阿米娅\"]  我们要铲除滋生仇恨的土壤。既用药物，也用行动。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们要铲除滋生仇恨的土壤。既用药物，也用行动。"
    },
