    },
    {
        "id": 151,
        "raw": "[name=\"煌\"]  她开窍了？",
        "type": "dialog",
        "speaker": "煌",
        "content": "她开窍了？"
    },
    {
        "id": 152,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#1\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#5",
        "name2": "char_002_amiya_1#1",
        "focus": 2
    },
    {
        "id": 153,
        "raw": "[name=\"阿米娅\"]  你不知道她的过去吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "你不知道她的过去吗？"
    },
    {
        "id": 154,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#1\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#5",
        "name2": "char_002_amiya_1#1",
        "focus": 1
    },
    {
        "id": 155,
        "raw": "[name=\"煌\"]  她没告诉我啊？我们也没那么熟。",
        "type": "dialog",
        "speaker": "煌",
        "content": "她没告诉我啊？我们也没那么熟。"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#4\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#5",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 157,
        "raw": "[name=\"阿米娅\"]  她的父母是矿石病学者，为了感染者研究矿石病，却死在了一场感染者与当局发生的冲突之中。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "她的父母是矿石病学者，为了感染者研究矿石病，却死在了一场感染者与当局发生的冲突之中。"
    },
    {
        "id": 158,
        "raw": "[name=\"阿米娅\"]  她只是认为，我们遭遇的和她遭遇的并没有区别。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "她只是认为，我们遭遇的和她遭遇的并没有区别。"
    },
    {
        "id": 159,
        "raw": "[name=\"阿米娅\"]  灰喉比你想的敏感得多。她大概只是不想表达。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "灰喉比你想的敏感得多。她大概只是不想表达。"
    },
    {
        "id": 160,
        "raw": "[Character(name=\"char_017_homura_3#5\",name2=\"char_002_amiya_1#4\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#5",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 161,
        "raw": "[name=\"煌\"]  不肯说出来，我哪知道......",
        "type": "dialog",
        "speaker": "煌",
        "content": "不肯说出来，我哪知道......"
    },
