        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 73,
        "raw": "[name=\"阿米娅\"]  但哪怕只有一点点能做的，我们也会去做。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但哪怕只有一点点能做的，我们也会去做。"
    },
    {
        "id": 74,
        "raw": "[name=\"阿米娅\"]  我们一定会去做。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们一定会去做。"
