    },
    {
        "id": 60,
        "raw": "[name=\"灰喉\"]  他......",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "他......"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"阿米娅\"]  如果我没记错，他应该是梅菲斯特身边的弩手，整合运动的另一位指挥官。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "如果我没记错，他应该是梅菲斯特身边的弩手，整合运动的另一位指挥官。"
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]  ......你认识他？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......你认识他？"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1#4\",name2=\"char_367_swllow_1#3\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#4",
        "name2": "char_367_swllow_1#3",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"灰喉\"]  我不知道。我不知道自己和他......算不算认识。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "我不知道。我不知道自己和他......算不算认识。"
    },
