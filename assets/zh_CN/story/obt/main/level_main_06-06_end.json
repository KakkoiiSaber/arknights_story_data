    {
        "id": 58,
        "raw": "[name=\"阿米娅\"]  灰喉？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "灰喉？"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
