    },
    {
        "id": 180,
        "raw": "[name=\"警员\"]  识别码！",
        "type": "dialog",
        "speaker": "警员",
        "content": "识别码！"
    },
    {
        "id": 181,
        "raw": "[Character(name=\"char_017_homura_3#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#4",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 182,
        "raw": "[name=\"煌\"]  你用仪器扫一下！",
        "type": "dialog",
        "speaker": "煌",
        "content": "你用仪器扫一下！"
    },
    {
        "id": 183,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 184,
        "raw": "[name=\"煌\"]  （不好意思，我先和他们说点事！）",
        "type": "dialog",
        "speaker": "煌",
        "content": "（不好意思，我先和他们说点事！）"
    },
    {
        "id": 185,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 186,
        "raw": "[name=\"整合运动成员\"]  啊？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "啊？"
    },
    {
        "id": 187,
        "raw": "[Character(name=\"char_017_homura_3#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#4",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 188,
        "raw": "[name=\"煌\"]  龙门警员，听好！我是罗德岛的。",
        "type": "dialog",
        "speaker": "煌",
        "content": "龙门警员，听好！我是罗德岛的。"
    },
    {
        "id": 189,
        "raw": "[name=\"煌\"]  别射击，我没心思再边打架边处理流矢了。",
        "type": "dialog",
        "speaker": "煌",
        "content": "别射击，我没心思再边打架边处理流矢了。"
    },
    {
        "id": 190,
        "raw": "[name=\"煌\"]  这里交给我一个人就行，你们赶紧去下处封锁点吧。",
        "type": "dialog",
        "speaker": "煌",
        "content": "这里交给我一个人就行，你们赶紧去下处封锁点吧。"
    },
    {
        "id": 191,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 192,
        "raw": "[name=\"煌\"]  好啦，现在来解决我们这边的事情。",
        "type": "dialog",
        "speaker": "煌",
        "content": "好啦，现在来解决我们这边的事情。"
    },
    {
        "id": 193,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 194,
        "raw": "[name=\"整合运动成员\"]  这个女人什么意思？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "这个女人什么意思？"
    },
    {
        "id": 195,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 196,
        "raw": "[name=\"煌\"]  我解释一下你们应该就懂了，大概？",
        "type": "dialog",
        "speaker": "煌",
        "content": "我解释一下你们应该就懂了，大概？"
    },
    {
        "id": 197,
        "raw": "[name=\"煌\"]  （深吸一口气）",
        "type": "dialog",
        "speaker": "煌",
        "content": "（深吸一口气）"
    },
    {
        "id": 198,
        "raw": "[Character(name=\"char_017_homura_3#6\")]",
        "type": "character",
        "name": "char_017_homura_3#6"
    },
    {
        "id": 199,
        "raw": "[name=\"煌\"]  我是来自罗德岛的精英干员，煌。我的作战目标是让各位失去战斗能力。",
        "type": "dialog",
        "speaker": "煌",
        "content": "我是来自罗德岛的精英干员，煌。我的作战目标是让各位失去战斗能力。"
    },
    {
        "id": 200,
        "raw": "[name=\"煌\"]  不管各位是抱着什么样的心态入侵他国城邦，我们都只以解除各位的武装为首要目的。",
        "type": "dialog",
        "speaker": "煌",
        "content": "不管各位是抱着什么样的心态入侵他国城邦，我们都只以解除各位的武装为首要目的。"
    },
    {
        "id": 201,
        "raw": "[name=\"煌\"]  不论各位对他人人身造成的伤害、损失以及事后的刑罚，至少，各位现在的抵抗没有任何意义。放下武器，你们还有机会。",
        "type": "dialog",
        "speaker": "煌",
        "content": "不论各位对他人人身造成的伤害、损失以及事后的刑罚，至少，各位现在的抵抗没有任何意义。放下武器，你们还有机会。"
    },
    {
        "id": 202,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 203,
        "raw": "[name=\"整合运动成员\"]  啊？什么？你......",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "啊？什么？你......"
    },
    {
        "id": 204,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4"
    },
    {
        "id": 205,
        "raw": "[name=\"煌\"]  同是感染者，给你们一条路选吧。",
        "type": "dialog",
        "speaker": "煌",
        "content": "同是感染者，给你们一条路选吧。"
    },
    {
        "id": 206,
        "raw": "[name=\"煌\"]  立刻投降的话，我有资格抓你们去罗德岛，然后丢去个对感染者还算宽容的地方。",
        "type": "dialog",
        "speaker": "煌",
        "content": "立刻投降的话，我有资格抓你们去罗德岛，然后丢去个对感染者还算宽容的地方。"
    },
