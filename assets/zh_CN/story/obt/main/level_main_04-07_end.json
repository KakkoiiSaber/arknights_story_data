    {
        "id": 5,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 6,
        "raw": "[name=\"阿米娅\"]   为了攀爬个观测点，都要解决那么多整合运动……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "为了攀爬个观测点，都要解决那么多整合运动……"
    },
    {
        "id": 7,
        "raw": "[name=\"阿米娅\"]   咦……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "咦……"
    },
    {
        "id": 8,
        "raw": "[name=\"阿米娅\"]   那个……是陈长官吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "那个……是陈长官吗？"
    },
    {
        "id": 9,
        "raw": "[name=\"阿米娅\"]   陈长官！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官！"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6.png"
    },
    {
        "id": 11,
        "raw": "[name=\"阿米娅\"]   ——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——"
    },
    {
        "id": 12,
        "raw": "[name=\"阿米娅\"]   （怎么会有这么多尸体……）",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "（怎么会有这么多尸体……）"
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]   （这么多整合运动……全都是陈长官一个人打倒的吗？！）",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "（这么多整合运动……全都是陈长官一个人打倒的吗？！）"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_010_chen_1#5\")]",
        "type": "character",
        "name": "char_010_chen_1#5.png"
    },
    {
        "id": 15,
        "raw": "[name=\"陈\"]   ——！",
        "type": "dialog",
        "speaker": "陈",
        "content": "——！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_010_chen_1#3\")]",
        "type": "character",
        "name": "char_010_chen_1#3.png"
    },
    {
        "id": 17,
        "raw": "[name=\"陈\"]   是你们……",
        "type": "dialog",
        "speaker": "陈",
        "content": "是你们……"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_010_chen_1#6\")]",
        "type": "character",
        "name": "char_010_chen_1#6.png"
    },
    {
        "id": 19,
        "raw": "[name=\"陈\"]   我冲动了。抱歉。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我冲动了。抱歉。"
    },
    {
        "id": 20,
        "raw": "[name=\"陈\"]   我可能中了敌人的陷阱……",
        "type": "dialog",
        "speaker": "陈",
        "content": "我可能中了敌人的陷阱……"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   不……没事，没有偏离计划太多，只是————",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不……没事，没有偏离计划太多，只是————"
    },
    {
        "id": 23,
        "raw": "[name=\"阿米娅\"]   之前，出现的是……塔露拉？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "之前，出现的是……塔露拉？"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"陈\"]   ……",
        "type": "dialog",
        "speaker": "陈",
        "content": "……"
    },
    {
        "id": 26,
        "raw": "[name=\"陈\"]   ……不。无所谓了。应该是我的错觉，这里无论如何也不像有那个人在的状况。",
        "type": "dialog",
        "speaker": "陈",
        "content": "……不。无所谓了。应该是我的错觉，这里无论如何也不像有那个人在的状况。"
    },
    {
        "id": 27,
        "raw": "[name=\"陈\"]   还是，要以任务优先。",
        "type": "dialog",
        "speaker": "陈",
        "content": "还是，要以任务优先。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"陈\"]   ……如果不是我来带队，近卫局将很难开展搜查任务。",
        "type": "dialog",
        "speaker": "陈",
        "content": "……如果不是我来带队，近卫局将很难开展搜查任务。"
    },
    {
        "id": 30,
        "raw": "[name=\"陈\"]   尤其是现在的情况……",
        "type": "dialog",
        "speaker": "陈",
        "content": "尤其是现在的情况……"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"陈\"]   比我预想更复杂。",
        "type": "dialog",
        "speaker": "陈",
        "content": "比我预想更复杂。"
    },
    {
        "id": 33,
        "raw": "[name=\"陈\"]   依照现状，独自深入的代价太大了。",
        "type": "dialog",
        "speaker": "陈",
        "content": "依照现状，独自深入的代价太大了。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"阿米娅\"]   陈长官，罗德岛也希望你能够暂时返回近卫局队伍。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官，罗德岛也希望你能够暂时返回近卫局队伍。"
    },
    {
        "id": 36,
        "raw": "[name=\"阿米娅\"]   这里毕竟是天灾残留的源石丛多生地段，对于健康人而言是很不利的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这里毕竟是天灾残留的源石丛多生地段，对于健康人而言是很不利的。"
    },
    {
        "id": 37,
        "raw": "[name=\"阿米娅\"]   事先准备的防护消耗品也不一定能维持很久……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "事先准备的防护消耗品也不一定能维持很久……"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"陈\"]   你们呢？",
        "type": "dialog",
        "speaker": "陈",
        "content": "你们呢？"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"阿米娅\"]   保护龙门，优先清理龙门的威胁，当然是我们的任务——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "保护龙门，优先清理龙门的威胁，当然是我们的任务——"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 43,
        "raw": "[name=\"阿米娅\"]   但在我们来到这里的理由中，最重要的那个，是解救罗德岛的成员。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但在我们来到这里的理由中，最重要的那个，是解救罗德岛的成员。"
    },
    {
        "id": 44,
        "raw": "[name=\"阿米娅\"]   罗德岛不会放弃任何一个人。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "罗德岛不会放弃任何一个人。"
    },
    {
        "id": 45,
        "raw": "[name=\"阿米娅\"]   因此，罗德岛的作战方针也不会改变。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "因此，罗德岛的作战方针也不会改变。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"陈\"]   ……",
        "type": "dialog",
        "speaker": "陈",
        "content": "……"
    },
    {
        "id": 48,
        "raw": "[name=\"陈\"]   我会带队与你们汇合——在条件允许的情况下。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我会带队与你们汇合——在条件允许的情况下。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_010_chen_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"阿米娅\"]   好的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "好的。"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6.png"
    },
    {
        "id": 52,
        "raw": "[name=\"阿米娅\"]   陈长官！罗德岛可以让一支小队护送你——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陈长官！罗德岛可以让一支小队护送你——"
    },
    {
        "id": 53,
        "raw": "[Character(name=\"char_010_chen_1\")]",
        "type": "character",
        "name": "char_010_chen_1.png"
    },
    {
        "id": 54,
        "raw": "[name=\"陈\"]   不用。",
        "type": "dialog",
        "speaker": "陈",
        "content": "不用。"
    },
    {
        "id": 55,
        "raw": "[Dialog(fadetime=0.6)]",
        "type": "dialog_marker",
        "fadetime": 0.6
    },
    {
        "id": 56,
        "raw": "[Character(fadetime=0.6)]",
        "type": "character",
        "fadetime": 0.6
    },
    {
        "id": 57,
        "raw": "[Delay(time=0.6)]",
        "type": "delay",
        "time": 0.6
    },
    {
        "id": 58,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 59,
        "raw": "[name=\"阿米娅\"]   ……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……"
    },
    {
        "id": 60,
        "raw": "[name=\"阿米娅\"]   ……陈长官，真要强呢。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……陈长官，真要强呢。"
    },
    {
        "id": 61,
        "raw": "[name=\"阿米娅\"]   嗯？博士？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "嗯？博士？"
    },
    {
        "id": 62,
        "raw": "[name=\"阿米娅\"]   ……没关系的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……没关系的。"
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]   我知道……罗德岛又要孤军奋战了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我知道……罗德岛又要孤军奋战了。"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 65,
        "raw": "[name=\"阿米娅\"]   但现在可不是垂头丧气的时候。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但现在可不是垂头丧气的时候。"
    },
    {
        "id": 66,
        "raw": "[name=\"阿米娅\"]   毕竟，杰西卡她们还在等着我们。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "毕竟，杰西卡她们还在等着我们。"
    },
