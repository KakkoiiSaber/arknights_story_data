    },
    {
        "id": 12,
        "raw": "[name=\"阿米娅\"]   大家，请加快速度！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "大家，请加快速度！"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"雷蛇\"]   阿米娅，我们的身后有追兵。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "阿米娅，我们的身后有追兵。"
    },
    {
        "id": 15,
        "raw": "[name=\"雷蛇\"]   来得及反击吗？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "来得及反击吗？"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"阿米娅\"]   暂时不要吧......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "暂时不要吧......"
    },
    {
        "id": 18,
        "raw": "[name=\"阿米娅\"]   我最好甩开他们，避免无谓的战斗......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我最好甩开他们，避免无谓的战斗......"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1"
    },
    {
        "id": 20,
        "raw": "[name=\"雷蛇\"]   先不说安全问题了......",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "先不说安全问题了......"
    },
    {
        "id": 21,
        "raw": "[name=\"雷蛇\"]   我需要一条能最快离开贫民区，和陈长官汇合的路线。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "我需要一条能最快离开贫民区，和陈长官汇合的路线。"
    },
    {
        "id": 22,
        "raw": "[name=\"雷蛇\"]   整合运动，已经发现了我们的踪迹......",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "整合运动，已经发现了我们的踪迹......"
    },
    {
        "id": 23,
        "raw": "[name=\"雷蛇\"]   我们在路上花费的时间越多，罗德岛的处境越危险！",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "我们在路上花费的时间越多，罗德岛的处境越危险！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"能天使\"]   这好办，我这有一条敌人想不到的。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "这好办，我这有一条敌人想不到的。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"雷蛇\"]   你已经有主意了？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "你已经有主意了？"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_103_angel_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_103_angel_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"能天使\"]   当然~",
        "type": "dialog",
        "speaker": "能天使",
        "content": "当然~"
    },
    {
        "id": 30,
        "raw": "[name=\"能天使\"]   不过要说可不可靠，我还得亲自去踩点看看。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "不过要说可不可靠，我还得亲自去踩点看看。"
    },
