        "raw": "[Character(name=\"avg_npc_648_1#1$1\")]",
        "type": "character",
        "name": "avg_npc_648_1#1$1.png"
    },
    {
        "id": 77,
        "raw": "[name=\"凯瑟琳\"]我不需要保证，长官。",
        "type": "dialog",
        "speaker": "凯瑟琳",
        "content": "我不需要保证，长官。"
    },
    {
        "id": 78,
        "raw": "[name=\"凯瑟琳\"]年轻人总是以为自己能做到些什么。",
        "type": "dialog",
        "speaker": "凯瑟琳",
        "content": "年轻人总是以为自己能做到些什么。"
    },
    {
        "id": 79,
        "raw": "[name=\"凯瑟琳\"]但他们往往不知道自己面对的是什么。",
        "type": "dialog",
        "speaker": "凯瑟琳",
        "content": "但他们往往不知道自己面对的是什么。"
