        "name": "avg_npc_648_1#1$1.png"
    },
    {
        "id": 51,
        "raw": "[name=\"凯瑟琳\"]……跑掉的那个，是我的孙子。",
        "type": "dialog",
        "speaker": "凯瑟琳",
        "content": "……跑掉的那个，是我的孙子。"
