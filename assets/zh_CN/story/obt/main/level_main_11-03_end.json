        "name": "avg_npc_649_1#1$1.png"
    },
    {
        "id": 66,
        "raw": "[name=\"莱托中校\"]我可以理解为，你希望我放过他吗？",
        "type": "dialog",
        "speaker": "莱托中校",
        "content": "我可以理解为，你希望我放过他吗？"
