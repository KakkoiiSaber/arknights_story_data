    },
    {
        "id": 45,
        "raw": "[name=\"凯瑟琳\"]什么意思？",
        "type": "dialog",
        "speaker": "凯瑟琳",
        "content": "什么意思？"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"avg_npc_649_1#1$1\")]",
        "type": "character",
        "name": "avg_npc_649_1#1$1.png"
    },
    {
        "id": 47,
        "raw": "[name=\"莱托中校\"]我听说，贵工厂前几天，有工人跑了，所以，我想顺便清点一下人数，看一看贵工厂的名册。",
        "type": "dialog",
        "speaker": "莱托中校",
        "content": "我听说，贵工厂前几天，有工人跑了，所以，我想顺便清点一下人数，看一看贵工厂的名册。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"avg_npc_648_1#5$1\")]",
