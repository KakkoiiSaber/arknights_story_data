    {
        "id": 43,
        "raw": "[name=\"杜宾\"]  够了，走吧。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "够了，走吧。"
    },
    {
        "id": 44,
        "raw": "[name=\"杜宾\"]  无论整合运动的计划有多疯狂，对于我们来说......",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "无论整合运动的计划有多疯狂，对于我们来说......"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 46,
        "raw": "[name=\"阿米娅\"]   各位的安全才是最重要的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "各位的安全才是最重要的。"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 48,
        "raw": "[name=\"杜宾\"]  是。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "是。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 50,
        "raw": "[name=\"阿米娅\"]   整合运动的领袖，可能把这次的事件看作一个标志，一种手段......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "整合运动的领袖，可能把这次的事件看作一个标志，一种手段......"
    },
    {
        "id": 51,
        "raw": "[name=\"阿米娅\"]   对我来说，只是罗德岛的处境，变得越来越危险。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "对我来说，只是罗德岛的处境，变得越来越危险。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_002_amiya_1\",name2=\"char_014_riope\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 53,
        "raw": "[name=\"Ace\"]   在这个时间点挑起事端——",
        "type": "dialog",
        "speaker": "Ace",
        "content": "在这个时间点挑起事端——"
    },
    {
        "id": 54,
        "raw": "[name=\"Ace\"]   整合运动不是足够狠毒，就是足够疯狂。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "整合运动不是足够狠毒，就是足够疯狂。"
