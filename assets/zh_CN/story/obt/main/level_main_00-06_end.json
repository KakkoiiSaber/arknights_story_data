    {
        "id": 38,
        "raw": "[Character(name=\"char_130_doberm_ex\",name2=\"char_014_riope\",focus=2)]",
        "type": "character",
        "name": "char_130_doberm_ex.png",
        "name2": "char_014_riope",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"Ace\"]   杜宾，没时间了。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "杜宾，没时间了。"
    },
    {
        "id": 40,
        "raw": "[name=\"Ace\"]   罗德岛能躲过整合运动的袭击，也能瞒着乌萨斯帝国行动，但面对天灾，我们终归是脆弱的。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "罗德岛能躲过整合运动的袭击，也能瞒着乌萨斯帝国行动，但面对天灾，我们终归是脆弱的。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
