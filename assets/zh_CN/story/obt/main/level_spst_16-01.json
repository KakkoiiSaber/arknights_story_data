    {
        "id": 35,
        "raw": "[name=\"喜悦的农妇\"]塔露拉小姐，你们是在帮忙拔掉杂草吗？",
        "type": "dialog",
        "speaker": "喜悦的农妇",
        "content": "塔露拉小姐，你们是在帮忙拔掉杂草吗？"
    },
    {
        "id": 36,
        "raw": "[charslot(slot = \"m\", name = \"avg_npc_1983_1#1$1\")]",
        "type": "charslot"
    },
    {
        "id": 37,
        "raw": "[name=\"九\"]塔露拉，有人在跟你说话。",
        "type": "dialog",
        "speaker": "九",
        "content": "塔露拉，有人在跟你说话。"
    },
