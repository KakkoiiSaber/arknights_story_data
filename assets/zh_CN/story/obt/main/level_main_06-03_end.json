        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 101,
        "raw": "[name=\"浮士德\"]  ……那是我的战友。你是我的敌人。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……那是我的战友。你是我的敌人。"
    },
    {
        "id": 102,
        "raw": "[name=\"浮士德\"]  罗德岛怎么会有这样幼稚的人？",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "罗德岛怎么会有这样幼稚的人？"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 104,
        "raw": "[name=\"灰喉\"]  是的，我很幼稚。我只会按命令做事。当我自己做决定时，我什么都做不了。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "是的，我很幼稚。我只会按命令做事。当我自己做决定时，我什么都做不了。"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 106,
        "raw": "[name=\"浮士德\"]  你要当心。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你要当心。"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1#4\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1#4",
        "focus": 2
    },
    {
        "id": 108,
        "raw": "[name=\"灰喉\"]  手指松开！",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "手指松开！"
    },
    {
        "id": 109,
        "raw": "[name=\"灰喉\"]  你的弩没有连射机能。只要我躲过你的第一发射击，你就会死。别去按扳机。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "你的弩没有连射机能。只要我躲过你的第一发射击，你就会死。别去按扳机。"
    },
    {
        "id": 110,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1#4\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1#4",
        "focus": 1
    },
    {
        "id": 111,
        "raw": "[name=\"浮士德\"]  只听从命令，一味依赖别人的想法行动，最后会变成可怕的模样。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "只听从命令，一味依赖别人的想法行动，最后会变成可怕的模样。"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1#4\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1#4",
        "focus": 2
    },
    {
        "id": 113,
        "raw": "[name=\"灰喉\"]  为什么？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "为什么？"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1#4\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1#4",
        "focus": 1
    },
    {
        "id": 115,
        "raw": "[name=\"浮士德\"]  多数人只是盲从，他们会退缩，也会颤抖。他们并不真依赖谁，他们只是没有开始思考。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "多数人只是盲从，他们会退缩，也会颤抖。他们并不真依赖谁，他们只是没有开始思考。"
    },
    {
        "id": 116,
        "raw": "[name=\"浮士德\"]  ……而那些没有自己方向的人，只是种索求愿望来获得成就感和存在感的机器。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……而那些没有自己方向的人，只是种索求愿望来获得成就感和存在感的机器。"
    },
    {
        "id": 117,
        "raw": "[name=\"浮士德\"]  开动，不断运作，投入愿望，实现愿望，把周围一切都吃掉，把许愿的人也吃掉。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "开动，不断运作，投入愿望，实现愿望，把周围一切都吃掉，把许愿的人也吃掉。"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 119,
        "raw": "[name=\"灰喉\"]  我不会。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "我不会。"
    },
    {
        "id": 120,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 121,
        "raw": "[name=\"浮士德\"]  你经历的还不够多。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你经历的还不够多。"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 123,
        "raw": "[name=\"灰喉\"]  我看见你和刚才那个感染者最后的对话。你在做对的事。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "我看见你和刚才那个感染者最后的对话。你在做对的事。"
    },
    {
        "id": 124,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 125,
        "raw": "[name=\"浮士德\"]  你的对错和我无关。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你的对错和我无关。"
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 127,
        "raw": "[name=\"灰喉\"]  浮士德，你一直在避开近卫局，哪怕是落单的龙门近卫局，你也没有射击他们。这些我都看到了。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "浮士德，你一直在避开近卫局，哪怕是落单的龙门近卫局，你也没有射击他们。这些我都看到了。"
    },
    {
        "id": 128,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 129,
        "raw": "[name=\"浮士德\"]  ……别把我的忍耐当成软弱。如果伏击的人是我，你已经死了。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……别把我的忍耐当成软弱。如果伏击的人是我，你已经死了。"
    },
    {
        "id": 130,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 131,
        "raw": "[name=\"灰喉\"]  但你没有。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "但你没有。"
    },
    {
        "id": 132,
        "raw": "[name=\"灰喉\"]  你很累了。只要是用弩的人，都能看出你的疲劳。弦绷得太紧，这样下去一定会断掉。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "你很累了。只要是用弩的人，都能看出你的疲劳。弦绷得太紧，这样下去一定会断掉。"
    },
    {
        "id": 133,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 134,
        "raw": "[name=\"浮士德\"]  ……作为弩手，你实在太多话。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……作为弩手，你实在太多话。"
    },
    {
        "id": 135,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 2
    },
    {
        "id": 136,
        "raw": "[name=\"灰喉\"]  你也遭遇了那些特殊感染者，我们可以想办法。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "你也遭遇了那些特殊感染者，我们可以想办法。"
    },
    {
        "id": 137,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1",
        "focus": 1
    },
    {
        "id": 138,
        "raw": "[name=\"浮士德\"]  你说的也许很对。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你说的也许很对。"
    },
    {
        "id": 139,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_367_swllow_1#4\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_367_swllow_1#4",
        "focus": 2
    },
    {
        "id": 140,
        "raw": "[name=\"灰喉\"]  等等！",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "等等！"
    },
    {
        "id": 141,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 142,
        "raw": "[Character(name=\"char_1508_Faust_1#1\")]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png"
    },
    {
        "id": 143,
        "raw": "[Delay(time=0.7)]",
        "type": "delay",
        "time": 0.7
    },
    {
        "id": 144,
        "raw": "[Character(fadetime=1,block=true)]",
        "type": "character",
        "fadetime": "1,block=true"
    },
    {
        "id": 145,
        "raw": "[Delay(time=1)]",
        "type": "delay",
        "time": 1
    },
    {
        "id": 146,
        "raw": "[name=\"浮士德\"]  但我没有办法。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "但我没有办法。"
    },
    {
        "id": 147,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4.png"
    },
    {
        "id": 148,
        "raw": "[name=\"灰喉\"]  （在开始运动的一瞬间消失了？……没法判断他的位置！）",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "（在开始运动的一瞬间消失了？……没法判断他的位置！）"
    },
    {
        "id": 149,
        "raw": "[name=\"灰喉\"]  ……",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "……"
    },
    {
        "id": 150,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 151,
        "raw": "[name=\"灰喉\"]  ……嗯？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "……嗯？"
    },
    {
        "id": 152,
        "raw": "[name=\"灰喉\"]  为什么不杀我？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "为什么不杀我？"
    },
    {
        "id": 153,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 154,
        "raw": "[name=\"浮士德\"]  你没有射击我，我也没有。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你没有射击我，我也没有。"
    },
    {
        "id": 155,
        "raw": "[name=\"浮士德\"]  下次不会了。如果你没射杀我，我就会射杀你。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "下次不会了。如果你没射杀我，我就会射杀你。"
    },
    {
        "id": 156,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 157,
        "raw": "[name=\"灰喉\"]  我没有恶意！",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "我没有恶意！"
    },
    {
        "id": 158,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 159,
        "raw": "[name=\"浮士德\"]  那才最可怜。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "那才最可怜。"
    },
    {
        "id": 160,
        "raw": "[name=\"浮士德\"]  ……也许你需要别人回答你的问题。不回答，你就不懂。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……也许你需要别人回答你的问题。不回答，你就不懂。"
    },
    {
        "id": 161,
        "raw": "[name=\"浮士德\"]  别有负担，杀人、被杀，这种事天天发生。你们罗德岛也不可能避过的。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "别有负担，杀人、被杀，这种事天天发生。你们罗德岛也不可能避过的。"
    },
    {
        "id": 162,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1.png"
    },
    {
        "id": 163,
        "raw": "[name=\"灰喉\"]  ……为什么不能一起帮助他们？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "……为什么不能一起帮助他们？"
    },
    {
        "id": 164,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 165,
        "raw": "[name=\"浮士德\"]  ——我很想答应你的要求，但我知道不可能。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "——我很想答应你的要求，但我知道不可能。"
    },
    {
        "id": 166,
        "raw": "[name=\"浮士德\"]  别再追踪我了。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "别再追踪我了。"
    },
    {
        "id": 167,
        "raw": "[name=\"浮士德\"]  你和他们的接触太少了，大脑里满是错觉和误解。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你和他们的接触太少了，大脑里满是错觉和误解。"
    },
    {
        "id": 168,
        "raw": "[name=\"浮士德\"]  ……而我已经，没有任何办法了。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "……而我已经，没有任何办法了。"
    },
