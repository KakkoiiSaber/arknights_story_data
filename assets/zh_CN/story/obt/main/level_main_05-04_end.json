    {
        "id": 22,
        "raw": "[name=\"星熊\"]  你的公寓不是在太埔吗？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "你的公寓不是在太埔吗？"
    },
    {
        "id": 23,
