        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 65,
        "raw": "[name=\"星熊\"]  这真行吗？老陈，认真回答我，你是不是有点讨厌你爸？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "这真行吗？老陈，认真回答我，你是不是有点讨厌你爸？"
