    {
        "id": 6,
        "raw": "[name=\"星熊\"]  所有整合运动我都逮住了。根本没人知道具体的指令，刚他们说——",
        "type": "dialog",
        "speaker": "星熊",
        "content": "所有整合运动我都逮住了。根本没人知道具体的指令，刚他们说——"
    },
    {
        "id": 7,
        "raw": "[name=\"星熊\"]  ......",
        "type": "dialog",
        "speaker": "星熊",
        "content": "......"
    },
    {
        "id": 8,
        "raw": "[name=\"星熊\"]  老陈？看什么呢，这么入迷。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "老陈？看什么呢，这么入迷。"
