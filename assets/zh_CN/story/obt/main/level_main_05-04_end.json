        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 31,
        "raw": "[name=\"星熊\"]  但你这屋邸摆在这......该怎么称呼？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "但你这屋邸摆在这......该怎么称呼？"
