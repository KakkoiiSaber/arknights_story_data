        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"陈\"]  这里以前是不是大学道？",
        "type": "dialog",
        "speaker": "陈",
        "content": "这里以前是不是大学道？"
    },
    {
        "id": 11,
