        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 12,
        "raw": "[name=\"星熊\"]  嗯？是啊。后来改了名字。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "嗯？是啊。后来改了名字。"
