        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"星熊\"]  所以你一次也没回来过。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "所以你一次也没回来过。"
