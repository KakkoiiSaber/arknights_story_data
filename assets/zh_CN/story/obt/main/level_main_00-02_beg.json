        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 36,
        "raw": "[name=\"整合运动成员\"]   少口出狂言了，切尔诺伯格的混蛋！",
        "type": "dialog",
