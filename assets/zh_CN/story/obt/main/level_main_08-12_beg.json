        "name": "avg_npc_059.png"
    },
    {
        "id": 121,
        "raw": "[name=\"罗德岛近卫干员？\"] ......走！",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "......走！"
    },
    {
        "id": 122,
        "raw": "[name=\"罗德岛近卫干员？\"] 别再让我看见你。",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "别再让我看见你。"
    },
    {
        "id": 123,
        "raw": "[name=\"罗德岛近卫干员？\"] ——别再让我看见你！",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "——别再让我看见你！"
    },
    {
        "id": 124,
        "raw": "[Character(name=\"avg_npc_046#2\")]",
        "type": "character",
        "name": "avg_npc_046#2.png"
    },
    {
        "id": 125,
        "raw": "[name=\"W\"]  那谢谢。放心吧，如果这回没杀掉这个龙女，我们肯定就没机会再见了。",
        "type": "dialog",
        "speaker": "W",
        "content": "那谢谢。放心吧，如果这回没杀掉这个龙女，我们肯定就没机会再见了。"
    },
    {
        "id": 126,
        "raw": "[name=\"W\"]  他们已经行了，现在，游击队兄弟们，你们呢？",
        "type": "dialog",
        "speaker": "W",
        "content": "他们已经行了，现在，游击队兄弟们，你们呢？"
    },
