        "raw": "[name=\"迷迭香\"]  那好。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "那好。"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"avg_npc_046#5\")]",
        "type": "character",
        "name": "avg_npc_046#5.png"
    },
    {
        "id": 119,
        "raw": "[name=\"W\"]  所以我可以走了？",
        "type": "dialog",
        "speaker": "W",
        "content": "所以我可以走了？"
    },
    {
        "id": 120,
        "raw": "[Character(name=\"avg_npc_059\")]",
