        "id": 107,
        "raw": "[Character(name=\"avg_npc_046#2\")]",
        "type": "character",
        "name": "avg_npc_046#2.png"
    },
    {
        "id": 108,
        "raw": "[name=\"W\"]  你有的。你的命是我的老同事们堆出来的。",
        "type": "dialog",
        "speaker": "W",
        "content": "你有的。你的命是我的老同事们堆出来的。"
    },
    {
