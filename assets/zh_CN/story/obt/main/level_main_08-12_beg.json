        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 110,
        "raw": "[name=\"罗德岛近卫干员？\"] ......啊......！",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "......啊......！"
    },
    {
        "id": 111,
        "raw": "[name=\"罗德岛近卫干员？\"] 够了，够了！迷迭香，让她走吧！",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "够了，够了！迷迭香，让她走吧！"
    },
    {
        "id": 112,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 113,
        "raw": "[name=\"迷迭香\"]  所以她说的是真的？她保护了阿米娅她们？",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "所以她说的是真的？她保护了阿米娅她们？"
    },
    {
        "id": 114,
        "raw": "[Character(name=\"avg_npc_059\")]",
        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 115,
        "raw": "[name=\"罗德岛近卫干员？\"] 就相信我，也相信她这么一回。就这么一回。",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "就相信我，也相信她这么一回。就这么一回。"
