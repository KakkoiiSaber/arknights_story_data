    },
    {
        "id": 44,
        "raw": "[name=\"迷迭香\"]  就是她？",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "就是她？"
    },
    {
        "id": 45,
        "raw": "[name=\"迷迭香\"]  那Scout先生的仇就让我来报。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "那Scout先生的仇就让我来报。"
