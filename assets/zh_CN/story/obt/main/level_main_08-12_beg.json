        "speaker": "盾卫",
        "content": "......"
    },
    {
        "id": 129,
        "raw": "[name=\"盾卫\"]  大尉说过你不值得依赖。",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "大尉说过你不值得依赖。"
