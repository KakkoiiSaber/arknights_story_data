        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 10,
        "raw": "[name=\"杜宾\"]  还剩不到一个小时，没时间从其他区域绕行了……",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "还剩不到一个小时，没时间从其他区域绕行了……"
    },
    {
        "id": 11,
        "raw": "[name=\"杜宾\"]  我们浪费的时间越多，天灾在我们头顶发生的可能性就越大。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "我们浪费的时间越多，天灾在我们头顶发生的可能性就越大。"
    },
    {
        "id": 12,
        "raw": "[name=\"杜宾\"]  必须直接穿过当前区域。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "必须直接穿过当前区域。"
    },
    {
        "id": 13,
        "raw": "[name=\"杜宾\"]  以我们现在的规模，团队行动难免会被发觉。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "以我们现在的规模，团队行动难免会被发觉。"
    },
    {
        "id": 14,
        "raw": "[name=\"杜宾\"]  在狭窄的街巷中行动，很容易被埋伏包夹……",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "在狭窄的街巷中行动，很容易被埋伏包夹……"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_148_nearl_1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"临光\"]   怎么办？",
        "type": "dialog",
        "speaker": "临光",
        "content": "怎么办？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_148_nearl_1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_148_nearl_1.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 18,
        "raw": "[name=\"杜宾\"]   选择不多……",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "选择不多……"
    },
    {
        "id": 19,
        "raw": "[name=\"杜宾\"]  Dr.{@nickname}，你的想法呢？",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "Dr.{@nickname}，你的想法呢？"
    },
    {
        "id": 20,
        "raw": "[Decision(options=\"正面碾压过去就好！;……大概，他们也没法阻拦……;敌人想组织反击也需要时间。\", values=\"1;2;3\")]",
        "type": "decision",
        "options": "正面碾压过去就好！;……大概，他们也没法阻拦……;敌人想组织反击也需要时间。",
        "values": "1;2;3"
    },
    {
        "id": 21,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
        "references": "1"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 23,
        "raw": "[name=\"杜宾\"]  整合运动的个人实力并不能和我们相提并论。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "整合运动的个人实力并不能和我们相提并论。"
    },
    {
        "id": 24,
        "raw": "[name=\"杜宾\"]  大多数情况下，都只是在依赖人海战术围攻我们。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "大多数情况下，都只是在依赖人海战术围攻我们。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 26,
        "raw": "[name=\"临光\"]   依靠速度，不断前进，尽量减少一次性交战的人数的话——",
        "type": "dialog",
        "speaker": "临光",
        "content": "依靠速度，不断前进，尽量减少一次性交战的人数的话——"
    },
    {
        "id": 27,
        "raw": "[Predicate(references=\"2\")]",
        "type": "predicate",
        "references": "2"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 29,
        "raw": "[name=\"杜宾\"]   他们并没有构筑防御工事。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "他们并没有构筑防御工事。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 31,
        "raw": "[name=\"临光\"]   如果我们突袭他们的封锁线……",
        "type": "dialog",
        "speaker": "临光",
        "content": "如果我们突袭他们的封锁线……"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 33,
        "raw": "[name=\"杜宾\"]   虽然看上去人数众多，但整合运动这样松散的布置，是拦不住我们的。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "虽然看上去人数众多，但整合运动这样松散的布置，是拦不住我们的。"
    },
    {
        "id": 34,
        "raw": "[Predicate(references=\"3\")]",
        "type": "predicate",
        "references": "3"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 36,
        "raw": "[name=\"杜宾\"]   整合运动的通信方式，从过往的战斗来看，是十分原始的。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "整合运动的通信方式，从过往的战斗来看，是十分原始的。"
    },
    {
        "id": 37,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 38,
        "raw": "[name=\"临光\"]   在我们突破敌人的阻碍，当他们开始组织起来，尝试截击我们的时候……",
        "type": "dialog",
        "speaker": "临光",
        "content": "在我们突破敌人的阻碍，当他们开始组织起来，尝试截击我们的时候……"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 40,
        "raw": "[name=\"杜宾\"]   当整合运动终于集结完毕，我们也早已经到达了下一个区域。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "当整合运动终于集结完毕，我们也早已经到达了下一个区域。"
    },
    {
        "id": 41,
        "raw": "[Predicate]",
        "type": "predicate"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_148_nearl_1\")]",
        "type": "character",
        "name": "char_148_nearl_1.png"
    },
    {
        "id": 43,
        "raw": "[name=\"临光\"]   不错。",
        "type": "dialog",
        "speaker": "临光",
        "content": "不错。"
    },
    {
        "id": 44,
        "raw": "[name=\"临光\"]   猛烈冲击，搅乱阵形，破坏火力点，迅速撤退。",
        "type": "dialog",
        "speaker": "临光",
        "content": "猛烈冲击，搅乱阵形，破坏火力点，迅速撤退。"
    },
    {
        "id": 45,
        "raw": "[name=\"临光\"]   ……杜宾，你在考验我，还是在考验——",
        "type": "dialog",
        "speaker": "临光",
        "content": "……杜宾，你在考验我，还是在考验——"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1#1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#1.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"杜宾\"]  肉眼可见的威胁远比进退两难容易处理得多。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "肉眼可见的威胁远比进退两难容易处理得多。"
    },
    {
        "id": 48,
        "raw": "[name=\"杜宾\"]  我可以把这看作是Dr.{@nickname}的命令吗，阿米娅？",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "我可以把这看作是Dr.{@nickname}的命令吗，阿米娅？"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_002_amiya_1#1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"阿米娅\"]  局势很明了了。我相信博士的选择……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "局势很明了了。我相信博士的选择……"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_002_amiya_1#1\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#1.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"杜宾\"]   ——所谓信任，也不光是一场战役就能轻松建立的。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "——所谓信任，也不光是一场战役就能轻松建立的。"
    },
    {
        "id": 53,
        "raw": "[name=\"杜宾\"]   我很看好Dr.{@nickname}，但阿米娅……",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "我很看好Dr.{@nickname}，但阿米娅……"
    },
    {
        "id": 54,
        "raw": "[name=\"杜宾\"]   不要放松警惕。你当然可以借助博士的智慧，但不可以完全依赖他。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "不要放松警惕。你当然可以借助博士的智慧，但不可以完全依赖他。"
    },
    {
        "id": 55,
        "raw": "[Character(name=\"char_002_amiya_1#7\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 56,
        "raw": "[name=\"阿米娅\"]  ——我知道。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——我知道。"
    },
    {
        "id": 57,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 58,
        "raw": "[name=\"杜宾\"]  别介意，博士，我没想刁难你。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "别介意，博士，我没想刁难你。"
    },
    {
        "id": 59,
        "raw": "[name=\"杜宾\"]   只是，希望你能理解——阿米娅需要更多的学习和成长。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "只是，希望你能理解——阿米娅需要更多的学习和成长。"
    },
    {
        "id": 60,
        "raw": "[name=\"杜宾\"]   站在我的立场上，你也不会允许阿米娅太依靠别人的。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "站在我的立场上，你也不会允许阿米娅太依靠别人的。"
    },
    {
        "id": 61,
        "raw": "[name=\"杜宾\"]   不过，我已经认可了你的指挥能力。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "不过，我已经认可了你的指挥能力。"
    },
    {
        "id": 62,
        "raw": "[Decision(options=\"谢谢……\", values=\"1\")]",
        "type": "decision",
        "options": "谢谢……",
        "values": "1"
    },
    {
        "id": 63,
        "raw": "[Predicate(references=\"1\")]",
        "type": "predicate",
        "references": "1"
    },
    {
        "id": 64,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 65,
        "raw": "[name=\"杜宾\"]   也别那么拘谨，我们可已经是共患难的战友了。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "也别那么拘谨，我们可已经是共患难的战友了。"
    },
    {
        "id": 66,
        "raw": "[name=\"杜宾\"]   至少在战场，我的生命，已经交给你了。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "至少在战场，我的生命，已经交给你了。"
    },
    {
        "id": 67,
        "raw": "[name=\"杜宾\"]   闲谈到此为止，抓紧时间。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "闲谈到此为止，抓紧时间。"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_148_nearl_1#1\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_148_nearl_1#1.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 69,
        "raw": "[name=\"临光\"]   是的。",
        "type": "dialog",
        "speaker": "临光",
        "content": "是的。"
    },
    {
        "id": 70,
        "raw": "[name=\"临光\"]   卡西米尔有句谚语：“喘息时，死亡就会追上你。”",
        "type": "dialog",
        "speaker": "临光",
        "content": "卡西米尔有句谚语：“喘息时，死亡就会追上你。”"
