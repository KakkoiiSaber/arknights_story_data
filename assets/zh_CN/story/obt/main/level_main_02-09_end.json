    {
        "id": 12,
        "raw": "[name=\"整合运动\"]   ……呃啊！",
        "type": "dialog",
        "speaker": "整合运动",
        "content": "……呃啊！"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1.png"
    },
    {
        "id": 14,
        "raw": "[name=\"雷蛇\"]   确保！",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "确保！"
    },
    {
        "id": 15,
        "raw": "[name=\"雷蛇\"]   确认安全无虞！",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "确认安全无虞！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"芙兰卡\"]   敌方的指挥官呢？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "敌方的指挥官呢？"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"雷蛇\"]   ——不在这批敌人里。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "——不在这批敌人里。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"芙兰卡\"]   一直潜伏着……观察着，尾随着我们。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "一直潜伏着……观察着，尾随着我们。"
    },
    {
        "id": 22,
        "raw": "[name=\"芙兰卡\"]   是想消磨我们的体力，等到稳操胜券后，再发动袭击吗？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "是想消磨我们的体力，等到稳操胜券后，再发动袭击吗？"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"阿米娅\"]   整合运动的敌人非常擅长发动偷袭。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "整合运动的敌人非常擅长发动偷袭。"
    },
    {
        "id": 25,
        "raw": "[name=\"阿米娅\"]   这点，我们在切尔诺伯格时就领教过了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这点，我们在切尔诺伯格时就领教过了。"
    },
    {
        "id": 26,
        "raw": "[name=\"阿米娅\"]   暂时撤退——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "暂时撤退——"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 28,
        "raw": "[name=\"雷蛇\"]   我没法确保撤退路线的安全。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "我没法确保撤退路线的安全。"
    },
    {
        "id": 29,
        "raw": "[name=\"雷蛇\"]   如果他们破坏建筑物来封锁路口，我们就危险了。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "如果他们破坏建筑物来封锁路口，我们就危险了。"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1#7\", focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1#7",
        "focus": 2
    },
    {
        "id": 31,
        "raw": "[name=\"阿米娅\"]   ——立刻侦查其他的路线！越隐蔽越好！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——立刻侦查其他的路线！越隐蔽越好！"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_107_liskam_1\")]",
        "type": "character",
        "name": "char_107_liskam_1.png"
    },
    {
        "id": 33,
        "raw": "[name=\"雷蛇\"]   阿米娅，四点钟方向，那个向下方街道移动的阶梯如何？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "阿米娅，四点钟方向，那个向下方街道移动的阶梯如何？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_106_franka_1\")]",
        "type": "character",
        "name": "char_106_franka_1.png"
    },
    {
        "id": 35,
        "raw": "[name=\"芙兰卡\"]   那里可不好走哦。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "那里可不好走哦。"
    },
    {
        "id": 36,
