    {
        "id": 51,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 52,
        "raw": "[name=\"米莎\"]   ……长官。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……长官。"
    },
    {
        "id": 53,
        "raw": "[name=\"米莎\"]   ——贫民区……里有一些被感染的孩子。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "——贫民区……里有一些被感染的孩子。"
    },
    {
        "id": 54,
        "raw": "[name=\"米莎\"]   如果可以的话……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "如果可以的话……"
    },
    {
        "id": 55,
        "raw": "[name=\"米莎\"]   希望你能……照看他们。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "希望你能……照看他们。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 57,
        "raw": "[name=\"陈\"]   保护龙门是近卫局的责任。",
        "type": "dialog",
        "speaker": "陈",
        "content": "保护龙门是近卫局的责任。"
    },
    {
        "id": 58,
        "raw": "[name=\"陈\"]   感染者，并非是龙门公民。",
        "type": "dialog",
        "speaker": "陈",
        "content": "感染者，并非是龙门公民。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 60,
        "raw": "[name=\"米莎\"]   ……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"陈\"]   ……",
        "type": "dialog",
        "speaker": "陈",
        "content": "……"
    },
    {
        "id": 63,
        "raw": "[name=\"陈\"]   但龙门的感染者依然属于龙门。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但龙门的感染者依然属于龙门。"
    },
    {
        "id": 64,
        "raw": "[name=\"陈\"]   我没任何理由向你保证，但我会尽到我的职责。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我没任何理由向你保证，但我会尽到我的职责。"
    },
    {
        "id": 65,
        "raw": "[name=\"陈\"]   毕竟——",
        "type": "dialog",
        "speaker": "陈",
        "content": "毕竟——"
    },
    {
        "id": 66,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 67,
        "raw": "[name=\"米莎\"]  他们说过，以前也——",
        "type": "dialog",
        "speaker": "米莎",
        "content": "他们说过，以前也——"
    },
    {
        "id": 68,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]=",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1,
        "content": "="
    },
    {
        "id": 69,
        "raw": "[name=\"陈\"]   这是我们一直在做的事情。",
        "type": "dialog",
        "speaker": "陈",
        "content": "这是我们一直在做的事情。"
    },
    {
        "id": 70,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"米莎\"]   ……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……"
    },
    {
        "id": 72,
        "raw": "[name=\"米莎\"]   谢谢你……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "谢谢你……"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 74,
        "raw": "[name=\"陈\"]   ……",
        "type": "dialog",
        "speaker": "陈",
        "content": "……"
    },
    {
        "id": 75,
        "raw": "[name=\"陈\"]   ——你知道我们找你的原因吗？",
        "type": "dialog",
        "speaker": "陈",
        "content": "——你知道我们找你的原因吗？"
    },
    {
        "id": 76,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=2)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 2
    },
    {
        "id": 77,
        "raw": "[name=\"米莎\"]   ……我不清楚。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "……我不清楚。"
    },
    {
        "id": 78,
        "raw": "[name=\"米莎\"]   我想不出自己有什么值得你们追缉的理由。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "我想不出自己有什么值得你们追缉的理由。"
    },
    {
        "id": 79,
        "raw": "[name=\"米莎\"]   但我觉得，也许……",
        "type": "dialog",
        "speaker": "米莎",
        "content": "但我觉得，也许……"
    },
    {
        "id": 80,
        "raw": "[name=\"米莎\"]   原因不在我，却在——",
        "type": "dialog",
        "speaker": "米莎",
        "content": "原因不在我，却在——"
    },
    {
        "id": 81,
        "raw": "[name=\"米莎\"]   ——我的父亲身上。",
        "type": "dialog",
        "speaker": "米莎",
        "content": "——我的父亲身上。"
    },
    {
        "id": 82,
        "raw": "[Character(name=\"char_010_chen_1\", name2=\"char_012_misa_1\", focus=1)]",
        "type": "character",
        "name": "char_010_chen_1.png",
        "name2": "char_012_misa_1",
        "focus": 1
    },
    {
        "id": 83,
        "raw": "[name=\"陈\"]   ————是的。",
        "type": "dialog",
        "speaker": "陈",
        "content": "————是的。"
    },
    {
        "id": 84,
        "raw": "[name=\"陈\"]   你的父亲，是切尔诺伯格最著名的科学家。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你的父亲，是切尔诺伯格最著名的科学家。"
    },
    {
        "id": 85,
        "raw": "[name=\"陈\"]   同时，他也是切尔诺伯格重要的政治人物之一。",
        "type": "dialog",
        "speaker": "陈",
        "content": "同时，他也是切尔诺伯格重要的政治人物之一。"
    },
    {
        "id": 86,
        "raw": "[name=\"陈\"]   也许，你身上有着……",
        "type": "dialog",
        "speaker": "陈",
        "content": "也许，你身上有着……"
    },
    {
        "id": 87,
        "raw": "[name=\"陈\"]   ——",
        "type": "dialog",
        "speaker": "陈",
        "content": "——"
    },
    {
        "id": 88,
        "raw": "[name=\"陈\"]   也许没有。",
        "type": "dialog",
        "speaker": "陈",
        "content": "也许没有。"
    },
    {
        "id": 89,
        "raw": "[name=\"陈\"]   但我们不能允许你落入整合运动之手。",
        "type": "dialog",
        "speaker": "陈",
        "content": "但我们不能允许你落入整合运动之手。"
    },
    {
        "id": 90,
