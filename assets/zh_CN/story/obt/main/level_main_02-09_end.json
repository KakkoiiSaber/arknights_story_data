        "type": "character",
        "name": "char_1002_nsabr_2.png"
    },
    {
        "id": 37,
        "raw": "[name=\"整合运动\"]   啊啊！罗德岛！",
        "type": "dialog",
        "speaker": "整合运动",
        "content": "啊啊！罗德岛！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 39,
        "raw": "[name=\"阿米娅\"]   是伏击！小心！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "是伏击！小心！"
    },
