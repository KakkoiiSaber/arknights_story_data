        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]  这是……啊。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这是……啊。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_012\")]",
        "type": "character",
        "name": "avg_npc_012.png"
    },
    {
        "id": 24,
        "raw": "[name=\"罗德岛干员\"]  尖锐的刃形法术和打斗痕迹。迅速解决了两三个整合运动，都被丢在这边了。",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "尖锐的刃形法术和打斗痕迹。迅速解决了两三个整合运动，都被丢在这边了。"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 26,
        "raw": "[name=\"阿米娅\"]  ……还有气。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "……还有气。"
    },
    {
        "id": 27,
        "raw": "[name=\"阿米娅\"]  凯尔希医生！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "凯尔希医生！"
    },
    {
        "id": 28,
        "raw": "[name=\"阿米娅\"]  嗯，拜托你和医疗干员。这几个整合运动也许有我们需要的信息。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "嗯，拜托你和医疗干员。这几个整合运动也许有我们需要的信息。"
    },
    {
        "id": 29,
