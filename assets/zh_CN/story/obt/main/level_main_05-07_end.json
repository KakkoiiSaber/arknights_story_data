    {
        "id": 41,
        "raw": "[name=\"通讯\"]  ……",
        "type": "dialog",
        "speaker": "通讯",
        "content": "……"
    },
    {
        "id": 42,
        "raw": "[name=\"通讯\"]  整合运动已经经过铜钟。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "整合运动已经经过铜钟。"
    },
    {
        "id": 43,
        "raw": "[name=\"通讯\"]  下环同样有整合运动聚集，正在整队。这是AU7的任务简报。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "下环同样有整合运动聚集，正在整队。这是AU7的任务简报。"
    },
    {
        "id": 44,
        "raw": "[name=\"通讯\"]  AO3小队已照既定计划清理了前湾的整合运动，正逼迫残余势力退向近卫局方向，完毕。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "AO3小队已照既定计划清理了前湾的整合运动，正逼迫残余势力退向近卫局方向，完毕。"
    },
    {
        "id": 45,
        "raw": "[name=\"通讯\"]  已全歼太羯宫的所有整合运动。正撤向查理士大道，前往既定地点汇合。AL1小队汇报完毕。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "已全歼太羯宫的所有整合运动。正撤向查理士大道，前往既定地点汇合。AL1小队汇报完毕。"
    },
    {
        "id": 46,
        "raw": "[name=\"通讯\"]  ……",
        "type": "dialog",
        "speaker": "通讯",
        "content": "……"
    },
    {
        "id": 47,
        "raw": "[name=\"通讯\"]  以上为整合运动行迹与各小队进程通报。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "以上为整合运动行迹与各小队进程通报。"
    },
    {
        "id": 48,
        "raw": "[name=\"通讯\"]  通报完毕。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "通报完毕。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_010_chen_1#1\")]",
        "type": "character",
        "name": "char_010_chen_1#1.png"
    },
    {
        "id": 50,
        "raw": "[name=\"陈\"]  明白。",
        "type": "dialog",
        "speaker": "陈",
        "content": "明白。"
    },
    {
        "id": 51,
        "raw": "[name=\"陈\"]  继续行动。目标，将所有整合运动全都赶到指定区域。",
        "type": "dialog",
        "speaker": "陈",
        "content": "继续行动。目标，将所有整合运动全都赶到指定区域。"
    },
    {
        "id": 52,
        "raw": "[name=\"陈\"]  如果还有盘踞在其他区域的小股整合运动势力，允许直接消灭。",
        "type": "dialog",
        "speaker": "陈",
        "content": "如果还有盘踞在其他区域的小股整合运动势力，允许直接消灭。"
    },
    {
        "id": 53,
        "raw": "[name=\"陈\"]  可以的话，引诱他们出动。注意把伤亡比控制在最低。我们需要保存实力。",
        "type": "dialog",
        "speaker": "陈",
        "content": "可以的话，引诱他们出动。注意把伤亡比控制在最低。我们需要保存实力。"
    },
    {
        "id": 54,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 55,
        "raw": "[name=\"通讯\"]  Yes sir。",
        "type": "dialog",
        "speaker": "通讯",
        "content": "Yes sir。"
    },
