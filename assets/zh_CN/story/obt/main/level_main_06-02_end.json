        "id": 20,
        "raw": "[Character(name=\"char_017_homura_3#9\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_017_homura_3#9.png",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"煌\"]  我是哪里还得不到你们的信任？我甚至救了你们一命。",
        "type": "dialog",
        "speaker": "煌",
        "content": "我是哪里还得不到你们的信任？我甚至救了你们一命。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_017_homura_3#8\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_017_homura_3#8.png",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"近卫局成员\"]  退后......！我知道，可、可你......感染者......！",
        "type": "dialog",
        "speaker": "近卫局成员",
        "content": "退后......！我知道，可、可你......感染者......！"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_017_homura_3#5\")]",
        "type": "character",
        "name": "char_017_homura_3#5.png"
    },
    {
        "id": 25,
        "raw": "[name=\"煌\"]  哦，是啊。是啊。",
        "type": "dialog",
        "speaker": "煌",
        "content": "哦，是啊。是啊。"
    },
    {
        "id": 26,
        "raw": "[name=\"煌\"]  嘁。",
        "type": "dialog",
        "speaker": "煌",
        "content": "嘁。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_017_homura_3#4\")]",
        "type": "character",
        "name": "char_017_homura_3#4.png"
    },
    {
        "id": 28,
        "raw": "[name=\"煌\"]  博士，走了。",
        "type": "dialog",
        "speaker": "煌",
        "content": "博士，走了。"
    },
    {
        "id": 29,
        "raw": "[Decision(options=\"......\", values=\"1\")]",
        "type": "decision",
        "options": "......",
        "values": "1"
    },
