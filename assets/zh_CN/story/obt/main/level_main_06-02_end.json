        "type": "character",
        "name": "char_017_homura_3#4.png"
    },
    {
        "id": 44,
        "raw": "[name=\"煌\"]  ......别这种表情啊，我不是说我好得很吗？",
        "type": "dialog",
        "speaker": "煌",
        "content": "......别这种表情啊，我不是说我好得很吗？"
    },
    {
