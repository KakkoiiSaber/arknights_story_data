    {
        "id": 33,
        "raw": "[name=\"煌\"]  哎，算了。Dr.{@nickname}，过来。别动，这样快点。",
        "type": "dialog",
        "speaker": "煌",
        "content": "哎，算了。Dr.{@nickname}，过来。别动，这样快点。"
    },
