    {
        "id": 7,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"浮士德\"]  梅菲斯特？",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "梅菲斯特？"
    },
    {
        "id": 9,
        "raw": "[name=\"浮士德\"]  你刚才释放了什么法术？你的......队伍，比之前更狂躁了。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你刚才释放了什么法术？你的......队伍，比之前更狂躁了。"
    },
    {
        "id": 10,
        "raw": "[name=\"浮士德\"]  他们......他们很痛苦。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "他们......他们很痛苦。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"梅菲斯特\"]  啊，你看到了啊？我种下去的种子开花了。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "啊，你看到了啊？我种下去的种子开花了。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 14,
        "raw": "[name=\"梅菲斯特\"]  没事的，浮士德，他们不会攻击我们。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "没事的，浮士德，他们不会攻击我们。"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 16,
        "raw": "[name=\"浮士德\"]  你还在催化他们的感染？",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "你还在催化他们的感染？"
    },
    {
        "id": 17,
        "raw": "[name=\"浮士德\"]  梅菲斯特......停手吧。我们能活下去的。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "梅菲斯特......停手吧。我们能活下去的。"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"梅菲斯特\"]  只有我的法术能做到这种事情，也只有这样，我们才有可能逃出去！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "只有我的法术能做到这种事情，也只有这样，我们才有可能逃出去！"
    },
    {
        "id": 20,
        "raw": "[name=\"梅菲斯特\"]  你在侦察的时候也看得很清楚了吧，如果我们以现在的状态强行突破，近卫局在我们抵达贫民区的秘密通道之前，就能把我们全杀掉！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你在侦察的时候也看得很清楚了吧，如果我们以现在的状态强行突破，近卫局在我们抵达贫民区的秘密通道之前，就能把我们全杀掉！"
    },
    {
        "id": 21,
        "raw": "[name=\"梅菲斯特\"]  你以前见过那些武器吗？那些连切尔诺伯格的守卫都没用过的武器！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你以前见过那些武器吗？那些连切尔诺伯格的守卫都没用过的武器！"
    },
    {
        "id": 22,
        "raw": "[name=\"梅菲斯特\"]  他们太熟悉这座城市了，而我们只是些外来人！他们从哪里出现？又会在哪里消失？！仅凭现在这点人，我们没法与他们正面对抗！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "他们太熟悉这座城市了，而我们只是些外来人！他们从哪里出现？又会在哪里消失？！仅凭现在这点人，我们没法与他们正面对抗！"
    },
    {
        "id": 23,
        "raw": "[name=\"梅菲斯特\"]  切尔诺伯格的乌萨斯人太弱了......龙门把我们当军队看待，可我们不是军队，我们带领着的，只是些想活下去的同胞。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "切尔诺伯格的乌萨斯人太弱了......龙门把我们当军队看待，可我们不是军队，我们带领着的，只是些想活下去的同胞。"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#3\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#3",
        "focus": 1
    },
    {
        "id": 25,
        "raw": "[name=\"浮士德\"]  声音轻些。我们的士气相当低落。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "声音轻些。我们的士气相当低落。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 27,
        "raw": "[name=\"梅菲斯特\"]  但我的牧群根本不会因为这种事情动摇！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "但我的牧群根本不会因为这种事情动摇！"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 29,
        "raw": "[name=\"浮士德\"]  ......还有刚刚和我们汇合的很多整合运动成员在。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "......还有刚刚和我们汇合的很多整合运动成员在。"
    },
    {
        "id": 30,
        "raw": "[name=\"浮士德\"]  霜星一定会来支援我们。",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "霜星一定会来支援我们。"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 32,
        "raw": "[name=\"梅菲斯特\"]  霜星？那个霜星？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "霜星？那个霜星？"
    },
    {
        "id": 33,
        "raw": "[name=\"梅菲斯特\"]  呵，呵呵，她和她的雪怪，难道不是也背叛了吗？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "呵，呵呵，她和她的雪怪，难道不是也背叛了吗？"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"浮士德\"]  梅菲斯特！",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "梅菲斯特！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"梅菲斯特\"]  否则凭他们的实力，有什么能拦得住他们！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "否则凭他们的实力，有什么能拦得住他们！"
    },
    {
        "id": 38,
        "raw": "[name=\"梅菲斯特\"]  我不怪他们。哪怕是背叛，他们也只是为了生存。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我不怪他们。哪怕是背叛，他们也只是为了生存。"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 40,
        "raw": "[name=\"浮士德\"]  霜星不会背叛。我们不是说好了，要自己去看到真相？",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "霜星不会背叛。我们不是说好了，要自己去看到真相？"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 2
    },
    {
        "id": 42,
        "raw": "[name=\"梅菲斯特\"]  是啊......大家都在为了生存而努力。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "是啊......大家都在为了生存而努力。"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#2\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "id": 44,
        "raw": "[name=\"浮士德\"]  别冲动，别被近卫局的计策冲昏头脑！",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "别冲动，别被近卫局的计策冲昏头脑！"
    },
    {
        "id": 45,
        "raw": "[stopmusic(fadetime=2)]",
        "type": "stop_music",
        "fadetime": 2
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"梅菲斯特\"]  我有办法，浮士德。我可以让我的同胞们更好地活下去。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我有办法，浮士德。我可以让我的同胞们更好地活下去。"
    },
    {
        "id": 48,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 49,
        "raw": "[name=\"浮士德\"]  ......？你要做什么？",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "......？你要做什么？"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 51,
        "raw": "[name=\"梅菲斯特\"]  我要让近卫局看看比军队更可怕的东西。他们绝对无法想象我同胞们绽放出的花朵是什么样子。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我要让近卫局看看比军队更可怕的东西。他们绝对无法想象我同胞们绽放出的花朵是什么样子。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=1)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 1
    },
    {
        "id": 53,
        "raw": "[name=\"浮士德\"]  梅菲斯特？！",
        "type": "dialog",
        "speaker": "浮士德",
        "content": "梅菲斯特？！"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_1508_Faust_1#1\",name2=\"char_1507_Mephisto_1#5\",focus=2)]",
        "type": "character",
        "name": "char_1508_Faust_1#1.png",
        "name2": "char_1507_Mephisto_1#5",
        "focus": 2
    },
    {
        "id": 55,
        "raw": "[name=\"梅菲斯特\"]  近卫局一定要为他们的所作所为付出代价......那个陈，一定要为伤害你付出代价！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "近卫局一定要为他们的所作所为付出代价......那个陈，一定要为伤害你付出代价！"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5.png"
    },
    {
        "id": 57,
        "raw": "[name=\"梅菲斯特\"]  我的同胞们，我的族裔们，响应我吧！",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我的同胞们，我的族裔们，响应我吧！"
    },
