    },
    {
        "id": 36,
        "raw": "[name=\"严肃的乌萨斯军官\"]这是一个基于友谊的请求。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "这是一个基于友谊的请求。"
    },
    {
        "id": 37,
        "raw": "[name=\"严肃的乌萨斯军官\"]元帅他非常重视与您的友谊，同样也信任您的智慧。他相信，即使在这个时候，布列斯克与第四集团军的利益也是紧密相连的。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "元帅他非常重视与您的友谊，同样也信任您的智慧。他相信，即使在这个时候，布列斯克与第四集团军的利益也是紧密相连的。"
    },
    {
        "id": 38,
        "raw": "[name=\"严肃的乌萨斯军官\"]何况他并不请求您做什么额外的事——只要您的一个点头。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "何况他并不请求您做什么额外的事——只要您的一个点头。"
