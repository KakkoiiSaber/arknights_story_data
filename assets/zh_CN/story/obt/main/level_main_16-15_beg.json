    {
        "id": 30,
        "raw": "[name=\"严肃的乌萨斯军官\"]永远站在离危险最近的地方保护乌萨斯——元帅在履行乌萨斯军人的天职。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "永远站在离危险最近的地方保护乌萨斯——元帅在履行乌萨斯军人的天职。"
    },
    {
        "id": 31,
        "raw": "[name=\"严肃的乌萨斯军官\"]现在的问题，在于您，女大公殿下。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "现在的问题，在于您，女大公殿下。"
    },
    {
        "id": 32,
        "raw": "[name=\"严肃的乌萨斯军官\"]元帅需要您还愿意维系往日的合作。",
        "type": "dialog",
        "speaker": "严肃的乌萨斯军官",
        "content": "元帅需要您还愿意维系往日的合作。"
