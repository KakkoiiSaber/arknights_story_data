        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 89,
        "raw": "[name=\"星熊\"]   这么说话更不像你了，你是探长，是高级警司，不是政客，逢场作戏从来都不是你的天职。",
        "type": "dialog",
        "speaker": "星熊",
