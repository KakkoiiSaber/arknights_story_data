        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"星熊\"]  哈，哈……哎，推这么一下，这只胳膊居然就真不行了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "哈，哈……哎，推这么一下，这只胳膊居然就真不行了。"
