        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#4",
        "focus": 2
    },
    {
        "id": 65,
        "raw": "[name=\"陈\"]  然后留你一身伤，独自面对整合运动？",
        "type": "dialog",
        "speaker": "陈",
        "content": "然后留你一身伤，独自面对整合运动？"
