        "id": 42,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 43,
        "raw": "[name=\"陈\"]  你又救了我一次。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你又救了我一次。"
    },
    {
        "id": 44,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 45,
        "raw": "[name=\"星熊\"]  很奇怪吗，我救你的次数还少吗？就别郑重其事地说出来了，我听着不舒服。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "很奇怪吗，我救你的次数还少吗？就别郑重其事地说出来了，我听着不舒服。"
    },
    {
        "id": 46,
        "raw": "[name=\"星熊\"]  让我歇一会，我觉得全身骨头都散架了……偶尔也得允许我动弹不得一回吧。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "让我歇一会，我觉得全身骨头都散架了……偶尔也得允许我动弹不得一回吧。"
    },
