        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"星熊\"]  你就不能先去看还有什么人受伤了吗？",
        "type": "dialog",
        "speaker": "星熊",
        "content": "你就不能先去看还有什么人受伤了吗？"
