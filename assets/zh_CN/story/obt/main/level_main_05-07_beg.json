        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"陈\"]  我昏迷了多久？",
        "type": "dialog",
        "speaker": "陈",
        "content": "我昏迷了多久？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"星熊\"]  十几秒。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "十几秒。"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"陈\"]  ——星熊，让开。我来切碎积石。",
        "type": "dialog",
        "speaker": "陈",
        "content": "——星熊，让开。我来切碎积石。"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"星熊\"]  不好意思，我不能让。让这么一下，你我可能就都没了。我不要紧。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "不好意思，我不能让。让这么一下，你我可能就都没了。我不要紧。"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"陈\"]  你的胳膊。",
        "type": "dialog",
        "speaker": "陈",
        "content": "你的胳膊。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"星熊\"]  不要紧。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "不要紧。"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"陈\"]  ……你撑不了多久！至少有两层楼的废墟压在你的盾上！",
        "type": "dialog",
        "speaker": "陈",
        "content": "……你撑不了多久！至少有两层楼的废墟压在你的盾上！"
    },
    {
        "id": 25,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"星熊\"]  我不用撑多久。现在你醒了就好办了，蹲下，你要随时准备好冲出去。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "我不用撑多久。现在你醒了就好办了，蹲下，你要随时准备好冲出去。"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_136_hsguma\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
