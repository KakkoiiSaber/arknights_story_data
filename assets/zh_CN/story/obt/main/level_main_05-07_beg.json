        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"星熊\"]  这是你今天第三次睡醒，早安老陈。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "这是你今天第三次睡醒，早安老陈。"
    },
    {
        "id": 11,
