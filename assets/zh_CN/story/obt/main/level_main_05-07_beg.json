        "raw": "[name=\"陈\"]  *龙门粗口*。",
        "type": "dialog",
        "speaker": "陈",
        "content": "*龙门粗口*。"
    },
    {
        "id": 103,
        "raw": "[name=\"星熊\"]  哈哈哈。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "哈哈哈。"
    },
    {
        "id": 104,
        "raw": "[name=\"星熊\"]  算了，行吧。行啊，老陈，都听你的。",
