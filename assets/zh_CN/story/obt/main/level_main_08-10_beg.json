        "type": "character",
        "name": "avg_npc_058.png",
        "name2": "avg_npc_078#4",
        "focus": 1
    },
    {
        "id": 145,
        "raw": "[name=\"盾卫\"]  不可能！我们的战士都没有这个待遇！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "不可能！我们的战士都没有这个待遇！"
