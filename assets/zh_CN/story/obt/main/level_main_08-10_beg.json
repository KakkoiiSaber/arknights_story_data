        "name": "avg_npc_058.png",
        "name2": "avg_npc_078#4",
        "focus": 2
    },
    {
        "id": 142,
        "raw": "[name=\"塔露拉\"]  那就流放他们。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "那就流放他们。"
    },
    {
        "id": 143,
        "raw": "[name=\"塔露拉\"]  不准使用额外的暴力，而且，给他们一周的口粮。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "不准使用额外的暴力，而且，给他们一周的口粮。"
    },
