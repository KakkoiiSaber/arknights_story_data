    {
        "id": 98,
        "raw": "[Character(name=\"avg_npc_231\")]",
        "type": "character",
        "name": "avg_npc_231.png"
    },
    {
        "id": 99,
        "raw": "[name=\"“领袖”\"]  ……西尔莎·凯利。我以深池领袖的名义，判处你死刑。",
        "type": "dialog",
        "speaker": "“领袖”",
        "content": "……西尔莎·凯利。我以深池领袖的名义，判处你死刑。"
    },
    {
        "id": 100,
        "raw": "[name=\"“领袖”\"]  我会在这里亲手处决你。",
        "type": "dialog",
        "speaker": "“领袖”",
        "content": "我会在这里亲手处决你。"
    },
    {
        "id": 101,
        "raw": "[Character(name=\"avg_npc_213\",name2=\"avg_npc_231\",focus=1)]",
        "type": "character",
        "name": "avg_npc_213.png",
        "name2": "avg_npc_231",
        "focus": 1
    },
    {
        "id": 102,
        "raw": "[name=\"西尔莎\"]  看来……我还是要死了。",
        "type": "dialog",
        "speaker": "西尔莎",
        "content": "看来……我还是要死了。"
    },
    {
        "id": 103,
        "raw": "[name=\"西尔莎\"]  ……领袖。你是领袖，可能没人能阻止你，我的家人们都还是会死。但你能不能告诉我，我们会胜利吗？",
        "type": "dialog",
        "speaker": "西尔莎",
        "content": "……领袖。你是领袖，可能没人能阻止你，我的家人们都还是会死。但你能不能告诉我，我们会胜利吗？"
    },
    {
        "id": 104,
        "raw": "[name=\"西尔莎\"]  会有那么一天，我们塔拉人都能过上更好的生活？",
        "type": "dialog",
        "speaker": "西尔莎",
        "content": "会有那么一天，我们塔拉人都能过上更好的生活？"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"avg_npc_213\",name2=\"avg_npc_231\",focus=2)]",
        "type": "character",
        "name": "avg_npc_213.png",
        "name2": "avg_npc_231",
        "focus": 2
    },
    {
        "id": 106,
        "raw": "[name=\"“领袖”\"]  ……",
        "type": "dialog",
        "speaker": "“领袖”",
        "content": "……"
    },
    {
        "id": 107,
        "raw": "[name=\"“领袖”\"]  会的。",
        "type": "dialog",
        "speaker": "“领袖”",
        "content": "会的。"
    },
