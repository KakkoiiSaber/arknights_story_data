        "name2": "char_017_homura_3#4",
        "focus": 1
    },
    {
        "id": 148,
        "raw": "[name=\"灰喉\"]  那随你的便。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "那随你的便。"
    },
