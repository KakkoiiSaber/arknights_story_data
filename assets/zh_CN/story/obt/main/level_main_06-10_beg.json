    {
        "id": 5,
        "raw": "呜，呜......",
        "type": "narration",
        "content": "呜，呜......"
    },
    {
        "id": 6,
        "raw": "我肚子好饿！",
        "type": "narration",
        "content": "我肚子好饿！"
    },
    {
        "id": 7,
        "raw": "爸爸呢？爸爸去哪里了？",
        "type": "narration",
        "content": "爸爸呢？爸爸去哪里了？"
    },
    {
        "id": 8,
        "raw": "没有爸爸不行......我要爸爸！爸爸！",
        "type": "narration",
        "content": "没有爸爸不行......我要爸爸！爸爸！"
    },
    {
        "id": 9,
        "raw": "爸爸会来带我走的！",
        "type": "narration",
        "content": "爸爸会来带我走的！"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 11,
        "raw": "[name=\"灰喉\"]  ......！",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "......！"
    },
    {
        "id": 12,
        "raw": "[name=\"灰喉\"]  儿童？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "儿童？"
    },
    {
