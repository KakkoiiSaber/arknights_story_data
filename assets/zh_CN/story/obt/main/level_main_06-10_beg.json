        "type": "character"
    },
    {
        "id": 20,
        "raw": "[name=\"孩童\"]  呜，呜......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "呜，呜......"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 22,
        "raw": "[name=\"灰喉\"]  ......你好。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "......你好。"
    },
    {
        "id": 23,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 24,
        "raw": "[name=\"孩童\"]  你，你是谁？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "你，你是谁？"
    },
    {
        "id": 25,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 26,
        "raw": "[name=\"孩童\"]  你是龙门人？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "你是龙门人？"
    },
    {
        "id": 27,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 28,
        "raw": "[name=\"灰喉\"]  ......是不会伤害你的人。我乌萨斯话说得不好。我没敌意。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "......是不会伤害你的人。我乌萨斯话说得不好。我没敌意。"
    },
    {
        "id": 29,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 30,
        "raw": "[name=\"孩童\"]  你在说什么？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "你在说什么？"
    },
    {
        "id": 31,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 32,
        "raw": "[name=\"灰喉\"]  跟我走，这里很乱。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "跟我走，这里很乱。"
    },
    {
        "id": 33,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 34,
        "raw": "[name=\"孩童\"]  叔叔说待在这里，不可以动......",
        "type": "dialog",
        "speaker": "孩童",
        "content": "叔叔说待在这里，不可以动......"
    },
    {
        "id": 35,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 36,
        "raw": "[name=\"灰喉\"]  ......但我可以带你去找爸爸。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "......但我可以带你去找爸爸。"
    },
    {
        "id": 37,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 38,
        "raw": "[name=\"孩童\"]  真的吗？",
        "type": "dialog",
        "speaker": "孩童",
        "content": "真的吗？"
    },
    {
        "id": 39,
        "raw": "[Character(name=\"char_367_swllow_1\")]",
        "type": "character",
        "name": "char_367_swllow_1"
    },
    {
        "id": 40,
        "raw": "[name=\"灰喉\"]  真的。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "真的。"
    },
    {
        "id": 41,
        "raw": "[name=\"灰喉\"]  埋伏在我身后的人，出来。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "埋伏在我身后的人，出来。"
    },
    {
        "id": 42,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "id": 43,
        "raw": "[name=\"整合运动成员\"]  你......",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "你......"
    },
    {
        "id": 44,
        "raw": "[name=\"整合运动成员\"]  你不是那些人。",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "你不是那些人。"
    },
    {
        "id": 45,
        "raw": "[name=\"整合运动成员\"]  你是......你是罗德岛？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "你是......你是罗德岛？"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4"
    },
    {
        "id": 47,
        "raw": "[name=\"灰喉\"]  孩子，退后点。别过来。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "孩子，退后点。别过来。"
    },
    {
        "id": 48,
        "raw": "[name=\"灰喉\"]  放下武器，束手就擒。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "放下武器，束手就擒。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"整合运动成员\"]  啊？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "啊？"
    },
    {
        "id": 51,
        "raw": "[name=\"整合运动成员\"]  你不是来帮我们的吗？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "你不是来帮我们的吗？"
    },
    {
        "id": 52,
        "raw": "[name=\"整合运动成员\"]  罗德岛！你知道有什么东西潜藏在这里吗？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "罗德岛！你知道有什么东西潜藏在这里吗？"
    },
    {
        "id": 53,
        "raw": "[name=\"整合运动成员\"]  我们好不容易设置好的埋伏......不引诱他们出来，不杀掉他们，我们就会被杀！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "我们好不容易设置好的埋伏......不引诱他们出来，不杀掉他们，我们就会被杀！"
    },
    {
        "id": 54,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 55,
        "raw": "[name=\"灰喉\"]  拿孩子做埋伏的诱饵，你们不如被杀算了。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "拿孩子做埋伏的诱饵，你们不如被杀算了。"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 57,
        "raw": "[name=\"整合运动成员\"]  ......你在想什么？你以为我们被杀就了结了吗？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "......你在想什么？你以为我们被杀就了结了吗？"
    },
    {
        "id": 58,
        "raw": "[name=\"整合运动成员\"]  就算我们被杀，他们也不会放过孩子，他们谁都不会放过！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "就算我们被杀，他们也不会放过孩子，他们谁都不会放过！"
    },
    {
        "id": 59,
        "raw": "[name=\"整合运动成员\"]  如果能这么简单就结束了，我们甘愿被杀也不会把孩子当做诱饵！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "如果能这么简单就结束了，我们甘愿被杀也不会把孩子当做诱饵！"
    },
    {
        "id": 60,
        "raw": "[name=\"整合运动成员\"]  我们甚至没有攻击你！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "我们甚至没有攻击你！"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1#4",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 62,
        "raw": "[name=\"灰喉\"]  谁会这么做......你是说穿黑色雨披的人？",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "谁会这么做......你是说穿黑色雨披的人？"
    },
    {
        "id": 63,
        "raw": "[Character(name=\"char_367_swllow_1#4\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1#4",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 64,
        "raw": "[name=\"整合运动成员\"]  你见过他们了，你怎么会不明白！他们是要斩尽杀绝！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "你见过他们了，你怎么会不明白！他们是要斩尽杀绝！"
    },
    {
        "id": 65,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 66,
        "raw": "[name=\"灰喉\"]  这不是借口。等我制服你们以后，我会为你们申请保护。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "这不是借口。等我制服你们以后，我会为你们申请保护。"
    },
    {
        "id": 67,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 68,
        "raw": "[name=\"整合运动成员\"]  谁信你？！被你那弩箭射中，人都已经死了，还保护什么？",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "谁信你？！被你那弩箭射中，人都已经死了，还保护什么？"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=1)]",
        "type": "character",
        "name": "char_367_swllow_1",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "id": 70,
        "raw": "[name=\"灰喉\"]  暂时保护你们的生命。",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "暂时保护你们的生命。"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"char_367_swllow_1\",name2=\"char_1002_nsabr_1\",focus=2)]",
        "type": "character",
        "name": "char_367_swllow_1",
        "name2": "char_1002_nsabr_1",
        "focus": 2
    },
    {
        "id": 72,
        "raw": "[name=\"整合运动成员\"]  不要管了，先把她解决掉，我们重来一遍！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "不要管了，先把她解决掉，我们重来一遍！"
    },
    {
        "id": 73,
        "raw": "[name=\"整合运动成员\"]  明明已经听见集合命令和撤退点了，要是就这样死在这里，我们怎么对得起为了保护孩子而死的他们的父母，他们可是我们的队友！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "明明已经听见集合命令和撤退点了，要是就这样死在这里，我们怎么对得起为了保护孩子而死的他们的父母，他们可是我们的队友！"
    },
    {
        "id": 74,
        "raw": "[Character(name=\"char_367_swllow_1#4\")]",
        "type": "character",
        "name": "char_367_swllow_1#4"
    },
    {
        "id": 75,
        "raw": "[name=\"灰喉\"]  ......孩子，躲远些！",
        "type": "dialog",
        "speaker": "灰喉",
        "content": "......孩子，躲远些！"
    },
