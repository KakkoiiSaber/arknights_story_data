        "id": 80,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 81,
        "raw": "[name=\"杜宾\"]    与你无关，小子。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "与你无关，小子。"
    },
    {
        "id": 82,
        "raw": "[name=\"杜宾\"]    （阿米娅？）",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "（阿米娅？）"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 84,
        "raw": "[name=\"梅菲斯特\"]    哎呀，都是些企业人士了，连谈话时要注意礼节这个道理，都不明白吗？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "哎呀，都是些企业人士了，连谈话时要注意礼节这个道理，都不明白吗？"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 86,
        "raw": "[name=\"杜宾\"]    就是因为这世界上像你这样的人越来越多，才导致我不得不多学些能够形容你们的词汇！",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "就是因为这世界上像你这样的人越来越多，才导致我不得不多学些能够形容你们的词汇！"
    },
    {
        "id": 87,
        "raw": "[name=\"杜宾\"]    （阿米娅，发生什么了？）",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "（阿米娅，发生什么了？）"
    },
    {
        "id": 88,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 89,
        "raw": "[name=\"阿米娅\"]    （杜宾......我们的撤退路线，都被他的部队封锁了！）",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "（杜宾......我们的撤退路线，都被他的部队封锁了！）"
    },
    {
        "id": 90,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 91,
        "raw": "[name=\"杜宾\"]    （怎么会！短短几分钟内，他——）",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "（怎么会！短短几分钟内，他——）"
    },
    {
        "id": 92,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 93,
        "raw": "[name=\"梅菲斯特\"]    这样不好。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "这样不好。"
    },
    {
        "id": 94,
        "raw": "[name=\"梅菲斯特\"]    我诚心诚意地邀请你们......",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我诚心诚意地邀请你们......"
    },
    {
        "id": 95,
        "raw": "[name=\"梅菲斯特\"]    你们却只想着——",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你们却只想着——"
    },
    {
        "id": 96,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 97,
        "raw": "[name=\"梅菲斯特\"]    ——逃之夭夭？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "——逃之夭夭？"
    },
    {
        "id": 98,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 99,
        "raw": "[name=\"杜宾\"]    呿！",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "呿！"
    },
    {
        "id": 100,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 101,
        "raw": "[name=\"梅菲斯特\"]    其实，只要你们赢了，就可以安全地离开我的猎场。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "其实，只要你们赢了，就可以安全地离开我的猎场。"
    },
    {
        "id": 102,
        "raw": "[name=\"梅菲斯特\"]    接下来，我的这些朋友们，会不断地尝试杀掉你们。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "接下来，我的这些朋友们，会不断地尝试杀掉你们。"
    },
    {
        "id": 103,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 104,
        "raw": "[name=\"梅菲斯特\"]    你们只要活下来，就是胜利！怎么样，规则，很简单吧？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你们只要活下来，就是胜利！怎么样，规则，很简单吧？"
    },
    {
        "id": 105,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 106,
        "raw": "[name=\"杜宾\"]    Ace！",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "Ace！"
    },
    {
        "id": 107,
        "raw": "[Character(name=\"char_014_riope\" )]",
        "type": "character",
        "name": "char_014_riope"
    },
    {
        "id": 108,
        "raw": "[name=\"Ace\"]    已经做好了强行突围的准备！",
        "type": "dialog",
        "speaker": "Ace",
        "content": "已经做好了强行突围的准备！"
    },
    {
        "id": 109,
        "raw": "[name=\"Ace\"]    但我们要先扛过这次围攻！",
        "type": "dialog",
        "speaker": "Ace",
        "content": "但我们要先扛过这次围攻！"
    },
    {
        "id": 110,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_1507_Mephisto_1#1\",focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "id": 111,
        "raw": "[name=\"阿米娅\"]    ——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——"
    },
    {
        "id": 112,
        "raw": "[name=\"阿米娅\"]    为什么，明明天灾就要来了！再不撤出切城，所有人都会——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "为什么，明明天灾就要来了！再不撤出切城，所有人都会——"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"char_002_amiya_1#7\",name2=\"char_1507_Mephisto_1#1\",focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "id": 114,
        "raw": "[name=\"梅菲斯特\"]    你在说什么......",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你在说什么......"
    },
    {
        "id": 115,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 116,
        "raw": "[name=\"梅菲斯特\"]    正因为是天灾降临......这可是，一个最该被好好庆祝的时刻了呀。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "正因为是天灾降临......这可是，一个最该被好好庆祝的时刻了呀。"
    },
    {
        "id": 117,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 118,
        "raw": "[name=\"阿米娅\"]    ......你......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......你......"
    },
    {
        "id": 119,
        "raw": "[Character(name=\"char_1507_Mephisto_1#5\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#5"
    },
    {
        "id": 120,
        "raw": "[name=\"梅菲斯特\"]    我高贵的客人们，能邀请你们参加游戏，我感到十分荣幸。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我高贵的客人们，能邀请你们参加游戏，我感到十分荣幸。"
    },
    {
        "id": 121,
        "raw": "[Character(name=\"char_1002_nsabr_2\",name2=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2",
        "name2": "char_1002_nsabr_2"
    },
    {
        "id": 122,
        "raw": "[name=\"整合运动成员\"]    啊......啊......！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "啊......啊......！"
    },
    {
        "id": 123,
        "raw": "[name=\"整合运动成员\"]    杀......杀！！杀了......他们！！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "杀......杀！！杀了......他们！！"
    },
    {
        "id": 124,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "id": 125,
        "raw": "[name=\"杜宾\"]    阿米娅！小心！",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "阿米娅！小心！"
    },
    {
        "id": 126,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 127,
        "raw": "[name=\"梅菲斯特\"]    对了，对了......",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "对了，对了......"
    },
    {
        "id": 128,
        "raw": "[name=\"梅菲斯特\"]    其实，我们是知道你们在核心区里做了什么的。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "其实，我们是知道你们在核心区里做了什么的。"
    },
    {
        "id": 129,
        "raw": "[Character(name=\"char_002_amiya_1#6\")]",
        "type": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "id": 130,
        "raw": "[name=\"阿米娅\"]    ——！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——！"
    },
    {
        "id": 131,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 132,
        "raw": "[name=\"梅菲斯特\"]    那个你们从核心区里救出来的，一直遮住面庞的家伙......令人非常，非常在意呢。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "那个你们从核心区里救出来的，一直遮住面庞的家伙......令人非常，非常在意呢。"
    },
    {
        "id": 133,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 134,
        "raw": "[name=\"阿米娅\"]    ——？！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——？！"
    },
    {
        "id": 135,
        "raw": "[Character(name=\"char_1507_Mephisto_1#1\")]",
        "type": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "id": 136,
        "raw": "[name=\"梅菲斯特\"]    弑君者只关心你们之后要做什么，要去哪里。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "弑君者只关心你们之后要做什么，要去哪里。"
    },
    {
        "id": 137,
        "raw": "[name=\"梅菲斯特\"]    我不一样。我只关心......",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我不一样。我只关心......"
    },
    {
        "id": 138,
        "raw": "[name=\"梅菲斯特\"]    你，是什么？从哪里来？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "你，是什么？从哪里来？"
    },
    {
        "id": 139,
        "raw": "[name=\"梅菲斯特\"]    对，你，就是现在，盯着我看的你......你和我们有点不一样。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "对，你，就是现在，盯着我看的你......你和我们有点不一样。"
    },
    {
        "id": 140,
        "raw": "[name=\"梅菲斯特\"]    那个设施里，究竟是什么装置，有着保存生命的功能呢？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "那个设施里，究竟是什么装置，有着保存生命的功能呢？"
    },
    {
        "id": 141,
        "raw": "[name=\"梅菲斯特\"]    我非常，非常好奇。",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我非常，非常好奇。"
    },
    {
        "id": 142,
        "raw": "[name=\"梅菲斯特\"]    我也不是那种冷血的人......",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "我也不是那种冷血的人......"
    },
    {
        "id": 143,
        "raw": "[name=\"梅菲斯特\"]    来吧，罗德岛的客人们，把这个家伙当成见面礼留给我吧？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "来吧，罗德岛的客人们，把这个家伙当成见面礼留给我吧？"
    },
    {
        "id": 144,
        "raw": "[name=\"梅菲斯特\"]    那样的话，虽然令人惋惜，但我放你们离开，也是可以的哦？",
        "type": "dialog",
        "speaker": "梅菲斯特",
        "content": "那样的话，虽然令人惋惜，但我放你们离开，也是可以的哦？"
    },
    {
        "id": 145,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 146,
        "raw": "[name=\"阿米娅\"]    博士——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "博士——"
    },
    {
        "id": 147,
        "raw": "[name=\"阿米娅\"]    ——退到我身后！！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——退到我身后！！"
