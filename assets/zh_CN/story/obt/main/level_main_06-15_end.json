    {
        "id": 49,
        "raw": "[name=\"阿米娅\"]  我知道了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我知道了。"
    },
    {
        "id": 50,
        "raw": "[name=\"阿米娅\"]  博士，请告诉霜星小姐那句话。",
