        "type": "character",
        "name": "char_017_homura_3#5"
    },
    {
        "id": 26,
        "raw": "[name=\"煌\"]  寒流已经......消散了。",
        "type": "dialog",
        "speaker": "煌",
        "content": "寒流已经......消散了。"
    },
    {
        "id": 27,
        "raw": "[name=\"煌\"]  我没事！阿米娅，快，去看看那只白兔子！",
        "type": "dialog",
        "speaker": "煌",
        "content": "我没事！阿米娅，快，去看看那只白兔子！"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_1505_frstar_1\")]",
        "type": "character",
        "name": "char_1505_frstar_1"
    },
    {
        "id": 29,
        "raw": "[name=\"霜星\"]  赢得漂亮，罗德岛。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "赢得漂亮，罗德岛。"
    },
    {
        "id": 30,
        "raw": "[name=\"霜星\"]  我的兄弟姐妹们......我让他们白白死去了。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "我的兄弟姐妹们......我让他们白白死去了。"
    },
    {
        "id": 31,
        "raw": "[name=\"霜星\"]  我们什么都没做到。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "我们什么都没做到。"
    },
    {
        "id": 32,
        "raw": "[name=\"霜星\"]  我的生命......一点价值都没有。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "我的生命......一点价值都没有。"
    },
