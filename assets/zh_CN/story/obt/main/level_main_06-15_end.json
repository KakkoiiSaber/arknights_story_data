    {
        "id": 153,
        "raw": "[name=\"霜星\"]  但她绝对不是一个人。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "但她绝对不是一个人。"
    },
    {
        "id": 154,
        "raw": "[name=\"霜星\"]  现在开始，我在你身边。我在你们身边。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "现在开始，我在你身边。我在你们身边。"
    },
