        "type": "predicate",
        "references": "1"
    },
    {
        "id": 166,
        "raw": "[name=\"霜星\"]  原本整合运动......也是一样的。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "原本整合运动......也是一样的。"
    },
    {
        "id": 167,
        "raw": "[name=\"霜星\"]  真像啊。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "真像啊。"
    },
    {
        "id": 168,
        "raw": "[name=\"霜星\"]  你的眼神，和那个孩子，真的很像。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "你的眼神，和那个孩子，真的很像。"
    },
    {
        "id": 169,
        "raw": "[name=\"霜星\"]  只不过，你没他那么坚定，但却比他......温柔太多了。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "只不过，你没他那么坚定，但却比他......温柔太多了。"
    },
    {
        "id": 170,
        "raw": "[name=\"霜星\"]  放手吧。兄弟姐妹们在等我。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "放手吧。兄弟姐妹们在等我。"
    },
