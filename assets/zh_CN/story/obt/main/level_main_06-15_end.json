        "type": "character",
        "name": "char_1505_frstar_1"
    },
    {
        "id": 40,
        "raw": "[name=\"霜星\"]  去救你们还能救的人吧。赶快。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "去救你们还能救的人吧。赶快。"
    },
    {
        "id": 41,
        "raw": "[name=\"霜星\"]  快去。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "快去。"
    },
    {
        "id": 42,
        "raw": "[name=\"霜星\"]  无论是阻止那些穿雨衣的，还是去追杀梅菲斯特，还是收容那些无处可去的感染者......",
        "type": "dialog",
        "speaker": "霜星",
        "content": "无论是阻止那些穿雨衣的，还是去追杀梅菲斯特，还是收容那些无处可去的感染者......"
    },
    {
        "id": 43,
        "raw": "[name=\"霜星\"]  去吧。去做有价值的事。",
        "type": "dialog",
        "speaker": "霜星",
        "content": "去吧。去做有价值的事。"
    },
    {
