    {
        "id": 6,
        "raw": "[name=\"W\"]  这个感觉......真是让人感到，十分熟悉啊。",
        "type": "dialog",
        "speaker": "W",
        "content": "这个感觉......真是让人感到，十分熟悉啊。"
    },
    {
        "id": 7,
        "raw": "[name=\"W\"]  阿米娅，是吗。",
        "type": "dialog",
        "speaker": "W",
        "content": "阿米娅，是吗。"
    },
    {
        "id": 8,
        "raw": "[name=\"W\"]  ——",
        "type": "dialog",
        "speaker": "W",
        "content": "——"
    },
    {
        "id": 9,
        "raw": "[name=\"W\"]  啊，啊，哈哈......是这样......原来是这样。",
        "type": "dialog",
        "speaker": "W",
        "content": "啊，啊，哈哈......是这样......原来是这样。"
    },
    {
        "id": 10,
        "raw": "[name=\"W\"]  我记住了，阿米娅。",
        "type": "dialog",
        "speaker": "W",
        "content": "我记住了，阿米娅。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 12,
        "raw": "[name=\"阿米娅\"]  ......什么？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......什么？"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_1504_cqbw\")]",
        "type": "character",
        "name": "char_1504_cqbw"
    },
    {
        "id": 14,
        "raw": "[name=\"W\"]  我已经得到我想要的了。你们可以走了，快走哦。",
        "type": "dialog",
        "speaker": "W",
        "content": "我已经得到我想要的了。你们可以走了，快走哦。"
    },
