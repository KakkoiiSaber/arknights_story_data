        "id": 9,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=2)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"杜宾\"]  周围也变得越来越嘈杂……",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "周围也变得越来越嘈杂……"
    },
    {
        "id": 11,
        "raw": "[name=\"杜宾\"]  可能是切尔诺伯格的居民想要逃出城市，反而和整合运动发生了冲突吧。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "可能是切尔诺伯格的居民想要逃出城市，反而和整合运动发生了冲突吧。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_002_amiya_1#4\")]",
        "type": "character",
        "name": "char_002_amiya_1#4.png"
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]  ……",
