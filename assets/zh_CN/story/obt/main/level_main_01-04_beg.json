    {
        "id": 6,
        "raw": "[name=\"杜宾\"]  呼……甩开他们了。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "呼……甩开他们了。"
    },
    {
        "id": 7,
        "raw": "[Character(name=\"char_014_riope\", name2=\"char_130_doberm_ex\", focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"Ace\"]  按这个速度，我们很快就会离开中城区，抵达南面出口。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "按这个速度，我们很快就会离开中城区，抵达南面出口。"
    },
