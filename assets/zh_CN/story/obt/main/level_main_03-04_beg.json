        "name": "char_103_angel_1",
        "name2": "char_002_amiya_1#2",
        "focus": 1
    },
    {
        "id": 10,
        "raw": "[name=\"能天使\"]   唔，唔啊！",
        "type": "dialog",
        "speaker": "能天使",
        "content": "唔，唔啊！"
    },
    {
        "id": 11,
        "raw": "[name=\"能天使\"]   被比自己年龄小的孩子直接这么夸奖，还有点不好意思。",
        "type": "dialog",
        "speaker": "能天使",
        "content": "被比自己年龄小的孩子直接这么夸奖，还有点不好意思。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1"
    },
    {
        "id": 13,
        "raw": "[name=\"德克萨斯\"]   她可是我们的雇主，稍微礼貌一些。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "她可是我们的雇主，稍微礼貌一些。"
    },
    {
        "id": 14,
