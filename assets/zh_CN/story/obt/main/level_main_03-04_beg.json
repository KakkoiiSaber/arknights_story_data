        "type": "character",
        "name": "char_103_angel_1"
    },
    {
        "id": 15,
        "raw": "[name=\"能天使\"]   唉唉，不好意思！",
        "type": "dialog",
        "speaker": "能天使",
        "content": "唉唉，不好意思！"
    },
    {
        "id": 16,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 17,
        "raw": "[name=\"阿米娅\"]   没问题的，我还得谢谢你们呢！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "没问题的，我还得谢谢你们呢！"
    },
    {
        "id": 18,
