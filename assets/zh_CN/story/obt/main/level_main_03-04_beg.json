        "type": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"陈\"]   星熊，你留下帮罗德岛一把。",
        "type": "dialog",
        "speaker": "陈",
        "content": "星熊，你留下帮罗德岛一把。"
