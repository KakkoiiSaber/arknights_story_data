        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "id": 46,
        "raw": "[name=\"星熊\"]   明白。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "明白。"
    },
    {
        "id": 47,
