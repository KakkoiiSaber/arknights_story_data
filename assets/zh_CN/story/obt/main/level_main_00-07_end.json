    },
    {
        "id": 8,
        "raw": "[name=\"杜宾\"]  依照既定路线，我们已经很接近切城南边的中城区了。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "依照既定路线，我们已经很接近切城南边的中城区了。"
    },
    {
        "id": 9,
        "raw": "[name=\"杜宾\"]  穿过这个公园，就是汇合点。不出意外的话，临光和E4小队应该已经在那里等着我们了。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "穿过这个公园，就是汇合点。不出意外的话，临光和E4小队应该已经在那里等着我们了。"
    },
    {
        "id": 10,
        "raw": "[Character(name=\"char_013_riop\",name2=\"char_130_doberm_ex\",focus=1)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 11,
        "raw": "[name=\"近卫干员\"]   可是......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "可是......"
    },
    {
        "id": 12,
        "raw": "[name=\"近卫干员\"]   要是临光......被袭击了，会怎么样？",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "要是临光......被袭击了，会怎么样？"
    },
    {
        "id": 13,
        "raw": "[name=\"近卫干员\"]   要是他们原本想用通讯设施警告我们，却发现信号遭到干扰......",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "要是他们原本想用通讯设施警告我们，却发现信号遭到干扰......"
    },
    {
        "id": 14,
        "raw": "[name=\"近卫干员\"]   我们该怎么办？",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "我们该怎么办？"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_013_riop\",name2=\"char_130_doberm_ex\",focus=2)]",
        "type": "character",
        "name": "char_013_riop.png",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 16,
        "raw": "[name=\"杜宾\"]  ......",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "......"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 18,
        "raw": "[name=\"阿米娅\"]   我们会去确认。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们会去确认。"
    },
    {
        "id": 19,
        "raw": "[character(name=\"char_013_riop\")]",
        "type": "character",
        "name": "char_013_riop.png"
    },
    {
        "id": 20,
        "raw": "[name=\"近卫干员\"]   ......啊。",
        "type": "dialog",
        "speaker": "近卫干员",
        "content": "......啊。"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"char_014_riope\",name2=\"char_013_riop\",focus=1)]",
        "type": "character",
        "name": "char_014_riope.png",
        "name2": "char_013_riop",
        "focus": 1
    },
    {
        "id": 22,
        "raw": "[name=\"Ace\"]   我们要亲眼确认事件之后，才会做出揣测。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "我们要亲眼确认事件之后，才会做出揣测。"
    },
    {
        "id": 23,
        "raw": "[name=\"Ace\"]   不要用怀疑恐吓自己。",
        "type": "dialog",
        "speaker": "Ace",
        "content": "不要用怀疑恐吓自己。"
    },
