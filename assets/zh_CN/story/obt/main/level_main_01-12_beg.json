        "type": "character",
        "name": "char_002_amiya_1#7.png",
        "name2": "char_1504_cqbw",
        "focus": 2
    },
    {
        "id": 41,
        "raw": "[name=\"？？？\"]  唉唉，别这样。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "唉唉，别这样。"
    },
    {
        "id": 42,
        "raw": "[name=\"？？？\"]  我和那个塔露拉龙女可合不来。毕竟我并不是专职守门的人啊。做完了自己的工作赶过来也是很累的！",
        "type": "dialog",
        "speaker": "？？？",
        "content": "我和那个塔露拉龙女可合不来。毕竟我并不是专职守门的人啊。做完了自己的工作赶过来也是很累的！"
    },
    {
        "id": 43,
        "raw": "[name=\"？？？\"]  为了搞好关系，我们互换姓名吧？",
        "type": "dialog",
        "speaker": "？？？",
        "content": "为了搞好关系，我们互换姓名吧？"
