        "type": "character",
        "name": "char_002_amiya_1#7.png"
    },
    {
        "id": 39,
        "raw": "[name=\"阿米娅\"]  整合运动……还要，继续战斗吗？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "整合运动……还要，继续战斗吗？"
