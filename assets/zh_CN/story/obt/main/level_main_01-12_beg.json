    {
        "id": 36,
        "raw": "[name=\"？？？\"]  你不认识我很正常——",
        "type": "dialog",
        "speaker": "？？？",
        "content": "你不认识我很正常——"
    },
    {
        "id": 37,
        "raw": "[name=\"？？？\"]  不过，我认识你身边那个人。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "不过，我认识你身边那个人。"
    },
