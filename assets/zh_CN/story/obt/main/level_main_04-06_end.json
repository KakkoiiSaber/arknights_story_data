        "focus": 1
    },
    {
        "id": 8,
        "raw": "[name=\"星熊\"]   咳，作为路障来说，这家伙也未免太凶残了些！！",
        "type": "dialog",
        "speaker": "星熊",
        "content": "咳，作为路障来说，这家伙也未免太凶残了些！！"
    },
    {
        "id": 9,
        "raw": "[name=\"星熊\"]   ......",
        "type": "dialog",
        "speaker": "星熊",
        "content": "......"
    },
    {
        "id": 10,
        "raw": "[name=\"星熊\"]   老陈已经跑得没影了。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "老陈已经跑得没影了。"
    },
    {
        "id": 11,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#4",
        "focus": 2
    },
    {
        "id": 12,
        "raw": "[name=\"阿米娅\"]   这下糟了......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这下糟了......"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1#4\", focus=1)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#4",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"星熊\"]   通讯也不接！啧，这衰样，真是没变过！",
        "type": "dialog",
        "speaker": "星熊",
        "content": "通讯也不接！啧，这衰样，真是没变过！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_136_hsguma\")]",
        "type": "character",
        "name": "char_136_hsguma.png"
    },
    {
        "id": 16,
        "raw": "[name=\"星熊\"]   近卫局！全员，准备跟我一起进入——",
        "type": "dialog",
        "speaker": "星熊",
        "content": "近卫局！全员，准备跟我一起进入——"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_002_amiya_1\")]",
        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 18,
        "raw": "[name=\"阿米娅\"]   不，星熊督察。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不，星熊督察。"
    },
    {
        "id": 19,
        "raw": "[name=\"阿米娅\"]   交给我们吧。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "交给我们吧。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_136_hsguma\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   接下来，就是天灾留下的源石丛多生地段......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "接下来，就是天灾留下的源石丛多生地段......"
    },
    {
        "id": 22,
        "raw": "[name=\"阿米娅\"]   身为健康人的各位继续深入下去，可能会染上矿石病。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "身为健康人的各位继续深入下去，可能会染上矿石病。"
    },
    {
        "id": 23,
        "raw": "[name=\"阿米娅\"]   这是非常严重的后果。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这是非常严重的后果。"
    },
    {
        "id": 24,
        "raw": "[name=\"阿米娅\"]   而且，作为感染者的我们——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "而且，作为感染者的我们——"
    },
