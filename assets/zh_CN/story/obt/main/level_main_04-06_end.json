        "name": "char_136_hsguma.png"
    },
    {
        "id": 35,
        "raw": "[name=\"星熊\"]   近卫局！我们当好罗德岛的盾！",
        "type": "dialog",
        "speaker": "星熊",
        "content": "近卫局！我们当好罗德岛的盾！"
    },
