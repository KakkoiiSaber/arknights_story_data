        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1#6",
        "focus": 1
    },
    {
        "id": 32,
        "raw": "[name=\"星熊\"]   哈哈哈，别在意。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "哈哈哈，别在意。"
    },
    {
        "id": 33,
        "raw": "[name=\"星熊\"]   不过你确实不用花力气劝我，你的意思，我都明白。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "不过你确实不用花力气劝我，你的意思，我都明白。"
