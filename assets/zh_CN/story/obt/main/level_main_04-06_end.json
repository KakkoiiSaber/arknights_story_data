        "type": "character",
        "name": "char_136_hsguma.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 26,
        "raw": "[name=\"星熊\"]   哈。你用那小小的身子努力讲着官话的样子，真是有点可爱。",
        "type": "dialog",
        "speaker": "星熊",
        "content": "哈。你用那小小的身子努力讲着官话的样子，真是有点可爱。"
    },
