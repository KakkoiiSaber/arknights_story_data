    {
        "id": 211,
        "raw": "[name=\"阿丽娜\"]  塔露……拉……？",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "塔露……拉……？"
    },
    {
        "id": 212,
        "raw": "[name=\"塔露拉\"]  我听着呢，阿丽娜。你说。你说。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我听着呢，阿丽娜。你说。你说。"
    },
    {
        "id": 213,
        "raw": "[name=\"阿丽娜\"]  ……雪……比我想的……要暖。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "……雪……比我想的……要暖。"
    },
    {
        "id": 214,
        "raw": "[name=\"阿丽娜\"]  不好意思……我还没能把我们说的那些……都写下来。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "不好意思……我还没能把我们说的那些……都写下来。"
    },
    {
        "id": 215,
        "raw": "[name=\"塔露拉\"]  不要紧的。不要紧的，阿丽娜。都不要紧的。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "不要紧的。不要紧的，阿丽娜。都不要紧的。"
    },
    {
        "id": 216,
        "raw": "[name=\"阿丽娜\"]  那几个孩子……尤其是……伊诺……你要……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "那几个孩子……尤其是……伊诺……你要……"
    },
    {
        "id": 217,
        "raw": "[name=\"塔露拉\"]  我在听，我在听！阿丽娜……我在听！！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我在听，我在听！阿丽娜……我在听！！"
    },
    {
        "id": 218,
        "raw": "[name=\"阿丽娜\"]  光是……和他说是……没有……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "光是……和他说是……没有……"
    },
    {
        "id": 219,
        "raw": "[name=\"阿丽娜\"]  好热……塔露拉……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "好热……塔露拉……"
    },
    {
        "id": 220,
        "raw": "[name=\"阿丽娜\"]  ……我不想死……我还没……你的妹妹……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "……我不想死……我还没……你的妹妹……"
