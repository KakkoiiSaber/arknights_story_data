        "name": "avg_npc_078#8.png"
    },
    {
        "id": 110,
        "raw": "[name=\"塔露拉\"]  阿丽娜……！！！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "阿丽娜……！！！"
    },
    {
        "id": 111,
        "raw": "[Character(name=\"avg_npc_079#6\")]",
        "type": "character",
        "name": "avg_npc_079#6.png"
    },
    {
        "id": 112,
        "raw": "[name=\"阿丽娜\"]  真不想……让你看到我这样。",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "真不想……让你看到我这样。"
    },
    {
        "id": 113,
        "raw": "[Character(name=\"avg_npc_078#8\")]",
        "type": "character",
        "name": "avg_npc_078#8.png"
    },
    {
        "id": 114,
        "raw": "[name=\"塔露拉\"]  别说话！阿丽娜，别说话……别说话！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "别说话！阿丽娜，别说话……别说话！"
    },
    {
        "id": 115,
        "raw": "[name=\"塔露拉\"]  我帮你止血……！我帮你……！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "我帮你止血……！我帮你……！"
    },
    {
        "id": 116,
        "raw": "[Character(name=\"avg_npc_079#6\")]",
        "type": "character",
        "name": "avg_npc_079#6.png"
    },
    {
        "id": 117,
        "raw": "[name=\"阿丽娜\"]  已经……没有再流血了……只是……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "已经……没有再流血了……只是……"
    },
    {
        "id": 118,
        "raw": "[Character(name=\"avg_npc_078#9\")]",
        "type": "character",
        "name": "avg_npc_078#9.png"
    },
    {
        "id": 119,
        "raw": "[name=\"塔露拉\"]  那我们走……我们走！叫医护兵给你输血！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "那我们走……我们走！叫医护兵给你输血！"
    },
    {
        "id": 120,
        "raw": "[Character(name=\"avg_npc_079#6\")]",
        "type": "character",
        "name": "avg_npc_079#6.png"
    },
    {
        "id": 121,
        "raw": "[name=\"阿丽娜\"]  没关系……不过……换来的东西被……",
        "type": "dialog",
        "speaker": "阿丽娜",
        "content": "没关系……不过……换来的东西被……"
    },
    {
        "id": 122,
        "raw": "[Character(name=\"avg_npc_078#9\")]",
        "type": "character",
        "name": "avg_npc_078#9.png"
    },
    {
        "id": 123,
        "raw": "[name=\"塔露拉\"]  别管了……别管了……我带你走……带你走！！！",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "别管了……别管了……我带你走……带你走！！！"
    },
