        "name": "char_130_doberm_ex.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 124,
        "raw": "[name=\"阿米娅\"]   ——是的。光是研究治疗方法，或者仅仅去平息种种争端，都是不够的。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "——是的。光是研究治疗方法，或者仅仅去平息种种争端，都是不够的。"
    },
    {
        "id": 125,
        "raw": "[name=\"阿米娅\"]   我们必须直面感染者带来的所有问题。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我们必须直面感染者带来的所有问题。"
    },
    {
        "id": 126,
        "raw": "[name=\"阿米娅\"]   只有这样，罗德岛才能替感染者争取到一线生机……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "只有这样，罗德岛才能替感染者争取到一线生机……"
    },
    {
        "id": 127,
        "raw": "[Character(name=\"char_130_doberm_ex\")]",
        "type": "character",
        "name": "char_130_doberm_ex.png"
    },
    {
        "id": 128,
        "raw": "[name=\"杜宾\"]  作为感染者，我们也比普通人更能理解感染者。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "作为感染者，我们也比普通人更能理解感染者。"
    },
    {
        "id": 129,
        "raw": "[name=\"杜宾\"]  无论是普通人还是感染者，无论是和平还是纷争，罗德岛想要解决问题，而不是任由仇恨和疾病蔓延肆虐。",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "无论是普通人还是感染者，无论是和平还是纷争，罗德岛想要解决问题，而不是任由仇恨和疾病蔓延肆虐。"
    },
