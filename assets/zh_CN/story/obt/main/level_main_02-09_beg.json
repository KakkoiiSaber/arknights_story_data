        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 9,
        "raw": "[name=\"整合运动成员\"]   诶呀！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "诶呀！"
    },
    {
