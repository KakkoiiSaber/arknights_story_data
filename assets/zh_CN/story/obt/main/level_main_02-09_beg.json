        "content": "......"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 14,
        "raw": "[name=\"芙兰卡\"]   只有我一个人觉得敌人越来越多了吗？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "只有我一个人觉得敌人越来越多了吗？"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_1002_nsabr_2\")]",
        "type": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "id": 16,
        "raw": "[name=\"整合运动成员\"]   啊呀！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "啊呀！"
    },
    {
        "id": 17,
        "raw": "[Character(fadetime=0.2)]",
        "type": "character",
        "fadetime": 0.2
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"雷蛇\"]   不是错觉。很明显，整合运动的增援到了。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "不是错觉。很明显，整合运动的增援到了。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_002_amiya_1#7\")]",
        "type": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   可恶，我们甚至还没向他们报一箭之仇——！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "可恶，我们甚至还没向他们报一箭之仇——！"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 23,
        "raw": "[name=\"雷蛇\"]   结果，倒是他们先找上罗德岛了。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "结果，倒是他们先找上罗德岛了。"
    },
    {
        "id": 24,
        "raw": "[name=\"雷蛇\"]   芙兰卡，看。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "芙兰卡，看。"
    },
    {
        "id": 25,
        "raw": "[name=\"雷蛇\"]   东边的出口，藏匿着的可能是整合运动的术师。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "东边的出口，藏匿着的可能是整合运动的术师。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"芙兰卡\"]   正面的通道，两侧的高层建筑里，也有大量的整合运动暴徒——",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "正面的通道，两侧的高层建筑里，也有大量的整合运动暴徒——"
    },
    {
        "id": 28,
        "raw": "[name=\"芙兰卡\"]   ......想要装出没发现我们的样子摸过来。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "......想要装出没发现我们的样子摸过来。"
    },
    {
        "id": 29,
        "raw": "[name=\"芙兰卡\"]   这可是在......楼顶啊。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "这可是在......楼顶啊。"
    },
    {
        "id": 30,
        "raw": "[name=\"芙兰卡\"]   无论来多少敌人，被打下去的话就会立刻完蛋了吧......",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "无论来多少敌人，被打下去的话就会立刻完蛋了吧......"
    },
    {
        "id": 31,
        "raw": "[name=\"芙兰卡\"]   感觉我这聪明头脑被人小看了呢，整合运动居然选这里和我们作战......",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "感觉我这聪明头脑被人小看了呢，整合运动居然选这里和我们作战......"
    },
    {
        "id": 32,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"阿米娅\"]   整合运动，是要发动总攻了吗？",
        "type": "dialog",
        "speaker": "阿米娅",
