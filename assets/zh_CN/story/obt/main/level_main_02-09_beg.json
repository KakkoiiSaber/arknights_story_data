        "content": "——"
    },
    {
        "id": 7,
        "raw": "[name=\"雷蛇\"]   怎么有这么多整合运动！",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "怎么有这么多整合运动！"
    },
