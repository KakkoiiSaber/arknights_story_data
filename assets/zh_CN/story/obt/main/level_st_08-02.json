    {
        "id": 178,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 179,
        "raw": "[name=\"魏彦吾\"]  他向哪个方向去了？",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "他向哪个方向去了？"
    },
    {
        "id": 180,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 181,
        "raw": "[name=\"影卫\"]  西方。很快就能到达辉蹄城的禁区。",
        "type": "dialog",
        "speaker": "影卫",
        "content": "西方。很快就能到达辉蹄城的禁区。"
    },
    {
        "id": 182,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 183,
        "raw": "[name=\"魏彦吾\"]  ……这一切是他谋划好的。为了确认协议签署区的安保情况，莱塔尼亚外扩了冲突禁区，和我们的禁区重叠。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……这一切是他谋划好的。为了确认协议签署区的安保情况，莱塔尼亚外扩了冲突禁区，和我们的禁区重叠。"
    },
    {
        "id": 184,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 185,
        "raw": "[name=\"影卫\"]  我们能够潜入进去，杀死科西切，夺回小姐。",
        "type": "dialog",
        "speaker": "影卫",
        "content": "我们能够潜入进去，杀死科西切，夺回小姐。"
    },
    {
        "id": 186,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 187,
        "raw": "[name=\"魏彦吾\"]  不。他做好了准备。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "不。他做好了准备。"
    },
    {
        "id": 188,
        "raw": "[name=\"魏彦吾\"]  ……这次会面，孪生女皇直接派遣了女皇之声，随行的武装力量不在少数。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……这次会面，孪生女皇直接派遣了女皇之声，随行的武装力量不在少数。"
    },
    {
        "id": 189,
        "raw": "[name=\"魏彦吾\"]  女皇们刚登基不久，一旦科西切有意引爆外交冲突，我们一切的逾矩行为都可能成为女皇们彰示威权的借口。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "女皇们刚登基不久，一旦科西切有意引爆外交冲突，我们一切的逾矩行为都可能成为女皇们彰示威权的借口。"
    },
    {
        "id": 190,
        "raw": "[name=\"魏彦吾\"]  不能给科西切更多伤害龙门乃至大炎的机会。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "不能给科西切更多伤害龙门乃至大炎的机会。"
    },
    {
        "id": 191,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 192,
        "raw": "[name=\"陈晖洁\"]  舅舅！",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "舅舅！"
    },
    {
        "id": 193,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 194,
        "raw": "[name=\"魏彦吾\"]  ……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……"
    },
    {
        "id": 195,
        "raw": "[name=\"魏彦吾\"]  晖洁……",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "晖洁……"
    },
    {
        "id": 196,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 197,
        "raw": "[name=\"陈晖洁\"]  舅舅……不要怪小塔！",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "舅舅……不要怪小塔！"
    },
    {
        "id": 198,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 199,
        "raw": "[name=\"魏彦吾\"]  我没有责怪她。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "我没有责怪她。"
    },
    {
        "id": 200,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 201,
        "raw": "[name=\"陈晖洁\"]  ……那你骂我吧。",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "……那你骂我吧。"
    },
    {
        "id": 202,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 203,
        "raw": "[name=\"魏彦吾\"]  你没有做错什么。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "你没有做错什么。"
    },
    {
        "id": 204,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 205,
        "raw": "[name=\"陈晖洁\"]  我答应她要和她一起走的。可是我害怕了……我……我松开手了。我没和她一起……",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "我答应她要和她一起走的。可是我害怕了……我……我松开手了。我没和她一起……"
    },
    {
        "id": 206,
        "raw": "[name=\"陈晖洁\"]  她的眼神，很害怕。我很害怕，她也很害怕。我……我一定做错了。",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "她的眼神，很害怕。我很害怕，她也很害怕。我……我一定做错了。"
    },
    {
        "id": 207,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 208,
        "raw": "[name=\"魏彦吾\"]  ……晖洁，这是她的错，不是你的。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……晖洁，这是她的错，不是你的。"
    },
    {
        "id": 209,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 210,
        "raw": "[name=\"陈晖洁\"]  啊？可，可舅舅你说不会怪她的！",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "啊？可，可舅舅你说不会怪她的！"
    },
    {
        "id": 211,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 212,
        "raw": "[name=\"魏彦吾\"]  是的，不会。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "是的，不会。"
    },
    {
        "id": 213,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 214,
        "raw": "[name=\"陈晖洁\"]  但她……但她不是做错了吗？做错了也……不会被骂吗？",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "但她……但她不是做错了吗？做错了也……不会被骂吗？"
    },
    {
        "id": 215,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 216,
        "raw": "[name=\"魏彦吾\"]  ——",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——"
    },
    {
        "id": 217,
        "raw": "[name=\"魏彦吾\"]  她不知道真相。这个真相不该被任何人知道，所以她肯定会犯错，哪怕不是现在，将来也会。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "她不知道真相。这个真相不该被任何人知道，所以她肯定会犯错，哪怕不是现在，将来也会。"
    },
    {
        "id": 218,
        "raw": "[name=\"魏彦吾\"]  ……很多情况下，犯错是不该被责罚的。我们不仅会犯错，还会犯很多错。有些错，我们一定会犯，躲不开，避不过。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "……很多情况下，犯错是不该被责罚的。我们不仅会犯错，还会犯很多错。有些错，我们一定会犯，躲不开，避不过。"
    },
    {
        "id": 219,
        "raw": "[name=\"魏彦吾\"]  塔露拉只是犯了那个她一定会犯的错。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "塔露拉只是犯了那个她一定会犯的错。"
    },
    {
        "id": 220,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 221,
        "raw": "[name=\"陈晖洁\"]  那样的话还叫犯错吗？",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "那样的话还叫犯错吗？"
    },
    {
        "id": 222,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 223,
        "raw": "[name=\"魏彦吾\"]  是的，依然还是。这片土地不因一件事一定发生就宽容待它。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "是的，依然还是。这片土地不因一件事一定发生就宽容待它。"
    },
    {
        "id": 224,
        "raw": "[name=\"魏彦吾\"]  严苛的土地，严苛的人民，严苛的统治。除了对错，它们什么都不在乎，好像对错才是它们的生命，而不是呼吸和吞咽……！",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "严苛的土地，严苛的人民，严苛的统治。除了对错，它们什么都不在乎，好像对错才是它们的生命，而不是呼吸和吞咽……！"
    },
    {
        "id": 225,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 226,
        "raw": "[name=\"陈晖洁\"] ……",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "……"
    },
    {
        "id": 227,
        "raw": "[name=\"陈晖洁\"]  你说的这些我不懂，舅舅。",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "你说的这些我不懂，舅舅。"
    },
    {
        "id": 228,
        "raw": "[name=\"陈晖洁\"]  所以……小塔她还会回来吗？",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "所以……小塔她还会回来吗？"
    },
    {
        "id": 229,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 230,
        "raw": "[name=\"魏彦吾\"]  ——我不知道，晖洁。我不知道。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "——我不知道，晖洁。我不知道。"
    },
    {
        "id": 231,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 232,
        "raw": "[name=\"陈晖洁\"]  ……呜……那小塔她因为我……不会回来了吗？都怪我……都怪我……小塔……",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "……呜……那小塔她因为我……不会回来了吗？都怪我……都怪我……小塔……"
    },
    {
        "id": 233,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 234,
        "raw": "[name=\"魏彦吾\"]  晖洁！",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "晖洁！"
    },
    {
        "id": 235,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 236,
        "raw": "[name=\"陈晖洁\"]  呜……！",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "呜……！"
    },
    {
        "id": 237,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
        "name": "char_2005_weiyw_1#5.png"
    },
    {
        "id": 238,
        "raw": "[name=\"魏彦吾\"]  把你的眼泪擦掉。",
        "type": "dialog",
        "speaker": "魏彦吾",
        "content": "把你的眼泪擦掉。"
    },
    {
        "id": 239,
        "raw": "[Character]",
        "type": "character"
    },
    {
        "id": 240,
        "raw": "[name=\"陈晖洁\"]  呜，我……",
        "type": "dialog",
        "speaker": "陈晖洁",
        "content": "呜，我……"
    },
    {
        "id": 241,
        "raw": "[Character(name=\"char_2005_weiyw_1#5\")]",
        "type": "character",
