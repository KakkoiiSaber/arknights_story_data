        "name": "avg_npc_082.png"
    },
    {
        "id": 84,
        "raw": "[name=\"感染者纠察队\"]  说什么东西......你，也是感染者？",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "说什么东西......你，也是感染者？"
