    {
        "id": 12,
        "raw": "晖洁：",
        "type": "narration",
        "content": "晖洁："
    },
    {
        "id": 13,
        "raw": "老爷爷，根据我那点不怎么牢靠的记忆，是叫伊万·伊贾斯拉夫。",
        "type": "narration",
        "content": "老爷爷，根据我那点不怎么牢靠的记忆，是叫伊万·伊贾斯拉夫。"
    },
    {
        "id": 14,
        "raw": "是个很常见的名字。他也是个随处可见的农民。",
        "type": "narration",
        "content": "是个很常见的名字。他也是个随处可见的农民。"
    },
    {
        "id": 15,
        "raw": "但他牺牲了自己。出于种种，他牺牲了自己的性命......",
        "type": "narration",
        "content": "但他牺牲了自己。出于种种，他牺牲了自己的性命......"
    },
    {
        "id": 16,
        "raw": "我偶尔会想，我是不是真的值得别人牺牲性命？",
        "type": "narration",
        "content": "我偶尔会想，我是不是真的值得别人牺牲性命？"
    },
    {
        "id": 17,
        "raw": "阿丽娜随我一起行动。这个人虽然大多时候都很柔和，有时候却突然地尖酸起来，让我感觉很不舒服。",
        "type": "narration",
        "content": "阿丽娜随我一起行动。这个人虽然大多时候都很柔和，有时候却突然地尖酸起来，让我感觉很不舒服。"
    },
    {
        "id": 18,
        "raw": "计划顺利地推进着。",
        "type": "narration",
        "content": "计划顺利地推进着。"
    },
    {
        "id": 19,
        "raw": "按照我的想法，很快，这一部分的感染者，一定会团结起来。",
        "type": "narration",
        "content": "按照我的想法，很快，这一部分的感染者，一定会团结起来。"
    },
    {
        "id": 20,
        "raw": "希望这确实有效。",
        "type": "narration",
        "content": "希望这确实有效。"
    },
    {
        "id": 21,
        "raw": "也希望爷爷能够安眠。除了老奶奶，我没有比他更亲的亲人。",
        "type": "narration",
        "content": "也希望爷爷能够安眠。除了老奶奶，我没有比他更亲的亲人。"
    },
