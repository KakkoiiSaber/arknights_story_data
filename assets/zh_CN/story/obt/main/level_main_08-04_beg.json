        "raw": "[name=\"感染者纠察队\"]  ——",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "——"
    },
    {
        "id": 80,
        "raw": "[name=\"感染者纠察队\"]  你是哪来的？",
        "type": "dialog",
        "speaker": "感染者纠察队",
        "content": "你是哪来的？"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"avg_npc_078\")]",
        "type": "character",
        "name": "avg_npc_078.png"
    },
    {
        "id": 82,
        "raw": "[name=\"塔露拉\"] 从很远的东方来的。",
        "type": "dialog",
        "speaker": "塔露拉",
        "content": "从很远的东方来的。"
    },
    {
