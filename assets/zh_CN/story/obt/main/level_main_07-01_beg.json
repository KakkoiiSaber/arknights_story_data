    {
        "id": 22,
        "raw": "[name=\"PRTS\"]  Dr.{@nickname}表现出一定的攻击性。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Dr.{@nickname}表现出一定的攻击性。"
    },
    {
        "id": 23,
        "raw": "[name=\"PRTS\"]  请放心，系统不会因此电击你，不用太过顾忌系统对你的检测。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "请放心，系统不会因此电击你，不用太过顾忌系统对你的检测。"
