    {
        "id": 16,
        "raw": "[name=\"PRTS\"]  编号00000-00002，接入权限-8。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "编号00000-00002，接入权限-8。"
    },
    {
        "id": 17,
        "raw": "[name=\"PRTS\"]  Dr.{@nickname}，欢迎访问罗德岛综合生物处理室，已依据生物数据对您的意图进行判断。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "Dr.{@nickname}，欢迎访问罗德岛综合生物处理室，已依据生物数据对您的意图进行判断。"
    },
    {
        "id": 18,
        "raw": "[name=\"PRTS\"]  另外，系统检测到您的心情不佳。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "另外，系统检测到您的心情不佳。"
    },
