        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"陨星\"]   ——",
        "type": "dialog",
        "speaker": "陨星",
        "content": "——"
    },
    {
        "id": 26,
        "raw": "[name=\"陨星\"]   ——你不该来。这是个巨大的陷阱。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "——你不该来。这是个巨大的陷阱。"
    },
    {
        "id": 27,
        "raw": "[name=\"陨星\"]   让你来营救我们，代价太大了。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "让你来营救我们，代价太大了。"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#3\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#3",
        "focus": 2
    },
    {
        "id": 29,
        "raw": "[name=\"陨星\"]   这是个错误的决定......！",
        "type": "dialog",
        "speaker": "陨星",
        "content": "这是个错误的决定......！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"char_193_frostl_1\")]",
        "type": "character",
        "name": "char_193_frostl_1"
    },
    {
        "id": 31,
        "raw": "[name=\"霜叶\"]   现在责怪她也没有用。",
        "type": "dialog",
        "speaker": "霜叶",
        "content": "现在责怪她也没有用。"
    },
    {
        "id": 32,
        "raw": "[name=\"霜叶\"]   更何况，谁都看得出来你们根本没有机会逃出来......阿米娅是不会放弃你们的。",
        "type": "dialog",
        "speaker": "霜叶",
        "content": "更何况，谁都看得出来你们根本没有机会逃出来......阿米娅是不会放弃你们的。"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 34,
        "raw": "[name=\"陨星\"]   我没在责怪她！只是......",
        "type": "dialog",
        "speaker": "陨星",
        "content": "我没在责怪她！只是......"
    },
    {
        "id": 35,
        "raw": "[name=\"陨星\"]   啧。对不起，阿米娅。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "啧。对不起，阿米娅。"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 37,
        "raw": "[name=\"阿米娅\"]   没关系的。见到你们平安，我就已经非常开心了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "没关系的。见到你们平安，我就已经非常开心了。"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_219_meteo_1#5\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2",
        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 39,
        "raw": "[name=\"陨星\"]   阿米娅......",
        "type": "dialog",
        "speaker": "陨星",
        "content": "阿米娅......"
    },
    {
        "id": 40,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_219_meteo_1#5\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1",
        "name2": "char_219_meteo_1#5",
        "focus": 1
    },
    {
        "id": 41,
        "raw": "[name=\"阿米娅\"]   但是......杰西卡她怎么了？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但是......杰西卡她怎么了？"
    },
