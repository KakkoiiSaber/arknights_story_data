        "block": true
    },
    {
        "id": 11,
        "raw": "[name=\"霜叶\"]   我知道你在掩体后面，别开火。",
        "type": "dialog",
        "speaker": "霜叶",
        "content": "我知道你在掩体后面，别开火。"
    },
    {
        "id": 12,
        "raw": "[name=\"霜叶\"]   看看我带了谁来。",
        "type": "dialog",
        "speaker": "霜叶",
        "content": "看看我带了谁来。"
    },
    {
        "id": 13,
        "raw": "[Character(name=\"char_002_amiya_1#2\")]",
        "type": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]   陨星，是我们！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "陨星，是我们！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"char_219_meteo_1#4\")]",
        "type": "character",
        "name": "char_219_meteo_1#4"
    },
    {
        "id": 16,
        "raw": "[name=\"陨星\"]   谁？难道是......阿米娅吗！",
        "type": "dialog",
        "speaker": "陨星",
        "content": "谁？难道是......阿米娅吗！"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_219_meteo_1#5\")]",
        "type": "character",
        "name": "char_219_meteo_1#5"
    },
    {
        "id": 18,
        "raw": "[name=\"陨星\"]   阿米娅！你......你居然来了！",
        "type": "dialog",
        "speaker": "陨星",
        "content": "阿米娅！你......你居然来了！"
    },
    {
        "id": 19,
        "raw": "[name=\"陨星\"]   见到你，真是，真是太好了......",
        "type": "dialog",
        "speaker": "陨星",
        "content": "见到你，真是，真是太好了......"
    },
