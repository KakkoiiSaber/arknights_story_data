        "name2": "char_219_meteo_1#5",
        "focus": 2
    },
    {
        "id": 46,
        "raw": "[name=\"陨星\"]   她有点......被吓到了。",
        "type": "dialog",
        "speaker": "陨星",
        "content": "她有点......被吓到了。"
    },
    {
        "id": 47,
        "raw": "[name=\"陨星\"]   本来是想等她振作起来，但......",
        "type": "dialog",
        "speaker": "陨星",
        "content": "本来是想等她振作起来，但......"
    },
    {
        "id": 48,
        "raw": "[name=\"陨星\"]   该说是留下了心理创伤......吧。",
        "type": "dialog",
        "speaker": "陨星",
