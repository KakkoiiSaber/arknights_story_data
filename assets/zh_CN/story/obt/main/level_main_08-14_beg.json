        "type": "character",
        "name": "char_003_kalts_1.png"
    },
    {
        "id": 197,
        "raw": "[name=\"凯尔希\"]  ......它的意识似乎已经陷入了沉睡。它在无意识地宣泄。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "......它的意识似乎已经陷入了沉睡。它在无意识地宣泄。"
    },
    {
        "id": 198,
        "raw": "[name=\"凯尔希\"]  那些没有被它操控的牧群萨卡兹们，似乎也是因为它没有尝试去控制某个个体。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "那些没有被它操控的牧群萨卡兹们，似乎也是因为它没有尝试去控制某个个体。"
    },
    {
        "id": 199,
        "raw": "[name=\"凯尔希\"]  自由。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "自由。"
    },
    {
        "id": 200,
        "raw": "[name=\"凯尔希\"]  很讽刺。牧群竟然会有自由。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "很讽刺。牧群竟然会有自由。"
