        "type": "character",
        "name": "char_003_kalts_1.png"
    },
    {
        "id": 189,
        "raw": "[name=\"凯尔希\"]  任何修辞对这桩惨剧而言都是侮辱，我所说的字字属实。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "任何修辞对这桩惨剧而言都是侮辱，我所说的字字属实。"
    },
    {
        "id": 190,
        "raw": "[name=\"凯尔希\"]  感染源的活力如同毒药，它对生物的毒害不会自然停止。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "感染源的活力如同毒药，它对生物的毒害不会自然停止。"
    },
    {
        "id": 191,
        "raw": "[name=\"凯尔希\"]  那时我暗下决心，绝不让这类事件重演。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "那时我暗下决心，绝不让这类事件重演。"
    },
    {
        "id": 192,
        "raw": "[name=\"凯尔希\"]  然而事与愿违，我意识到，这些事情只会在我眼前一次又一次地发生。",
        "type": "dialog",
        "speaker": "凯尔希",
        "content": "然而事与愿违，我意识到，这些事情只会在我眼前一次又一次地发生。"
    },
