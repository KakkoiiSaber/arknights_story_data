        "type": "character"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 13,
        "raw": "[name=\"盾卫\"]  那些乌萨斯的混账的确混在感染者和雇佣兵队伍里！他们假装是整合运动，所有人都长点眼！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "那些乌萨斯的混账的确混在感染者和雇佣兵队伍里！他们假装是整合运动，所有人都长点眼！"
    },
    {
        "id": 14,
        "raw": "[name=\"盾卫\"]  除了刚才涂上漆的人，一个都别放过！哪怕是想往里面再走一步，都直接干掉！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "除了刚才涂上漆的人，一个都别放过！哪怕是想往里面再走一步，都直接干掉！"
    },
    {
        "id": 15,
        "raw": "[Character(name=\"avg_npc_059\")]",
        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 16,
        "raw": "[name=\"罗德岛近卫干员？\"]  可那些整合运动，也是被煽动被骗过来的吧？！一定要杀了他们吗？",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "可那些整合运动，也是被煽动被骗过来的吧？！一定要杀了他们吗？"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 18,
        "raw": "[name=\"盾卫\"]  这个问题，你该留给过几分钟被他们干掉的你自己！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "这个问题，你该留给过几分钟被他们干掉的你自己！"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"avg_npc_090\")]",
        "type": "character",
        "name": "avg_npc_090.png"
    },
    {
        "id": 20,
        "raw": "[name=\"罗德岛干员\"]  Guard，敌人的火力很猛！那可不是整合运动该有的火力！",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "Guard，敌人的火力很猛！那可不是整合运动该有的火力！"
    },
    {
        "id": 21,
        "raw": "[Character(name=\"avg_npc_059\")]",
        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 22,
        "raw": "[name=\"罗德岛近卫干员？\"]  该有的火力是什么意思？！！",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "该有的火力是什么意思？！！"
    },
    {
        "id": 23,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 24,
        "raw": "[name=\"盾卫\"]  如果给我们所有的炮手都配上新式兵器，我们大概能直接攻下切城，用不着靠天灾。",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "如果给我们所有的炮手都配上新式兵器，我们大概能直接攻下切城，用不着靠天灾。"
    },
    {
        "id": 25,
        "raw": "[name=\"盾卫\"]  他们已经顾不得会不会露馅了，现在的他们就是拼了命地往里冲！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "他们已经顾不得会不会露馅了，现在的他们就是拼了命地往里冲！"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 27,
        "raw": "[name=\"幻影弩手\"]  那为什么塔露拉没把他们放在身边？",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "那为什么塔露拉没把他们放在身边？"
    },
    {
        "id": 28,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 29,
        "raw": "[name=\"盾卫\"]  因为她害怕！她害怕我们会识破这些人的身手，识破他们的诡计！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "因为她害怕！她害怕我们会识破这些人的身手，识破他们的诡计！"
    },
    {
        "id": 30,
        "raw": "[Character(name=\"avg_npc_090\")]",
        "type": "character",
        "name": "avg_npc_090.png"
    },
    {
        "id": 31,
        "raw": "[name=\"罗德岛干员\"]  人太多的话，恐怕她也没法盖得住了。而且，那些武器他们是没法直接拿在手上的。",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "人太多的话，恐怕她也没法盖得住了。而且，那些武器他们是没法直接拿在手上的。"
    },
    {
        "id": 32,
        "raw": "[name=\"罗德岛干员\"]  那些武器怕是早就藏在核心城各个地方，就等这个最混乱的时候了！",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "那些武器怕是早就藏在核心城各个地方，就等这个最混乱的时候了！"
    },
    {
        "id": 33,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 34,
        "raw": "[name=\"盾卫\"]  他们一开始就是被设计来对付我们的！他们想要杀掉我们所有人。但他们错了！不是他们杀掉我们，是我们会杀掉他们！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "他们一开始就是被设计来对付我们的！他们想要杀掉我们所有人。但他们错了！不是他们杀掉我们，是我们会杀掉他们！"
    },
    {
        "id": 35,
        "raw": "[name=\"盾卫\"]  保持阵型！前进！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "保持阵型！前进！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"avg_npc_090\")]",
        "type": "character",
        "name": "avg_npc_090.png"
    },
    {
        "id": 37,
        "raw": "[name=\"罗德岛干员\"]  做什么？！你们要......要离开阵地？！",
        "type": "dialog",
        "speaker": "罗德岛干员",
        "content": "做什么？！你们要......要离开阵地？！"
    },
    {
        "id": 38,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 39,
        "raw": "[name=\"盾卫\"]  罗德岛的，看清楚！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "罗德岛的，看清楚！"
    },
    {
        "id": 40,
        "raw": "[name=\"盾卫\"]  我们就是战争的阵地！我们在哪里，阵线就在哪里！前进！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "我们就是战争的阵地！我们在哪里，阵线就在哪里！前进！"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1.png"
    },
    {
        "id": 42,
        "raw": "[name=\"整合运动成员\"]  这样不行的，我们的队伍跟不上！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "这样不行的，我们的队伍跟不上！"
    },
    {
        "id": 43,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 44,
        "raw": "[name=\"盾卫\"]  我们会顶住，找机会做掉他们，你们就能跟上！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "我们会顶住，找机会做掉他们，你们就能跟上！"
    },
    {
        "id": 45,
        "raw": "[Character(name=\"avg_npc_059\")]",
        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 46,
        "raw": "[name=\"罗德岛近卫干员？\"]  幻影弩手们，做得到吗？",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "幻影弩手们，做得到吗？"
    },
    {
        "id": 47,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 48,
        "raw": "[name=\"幻影弩手\"]  ......",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "......"
    },
    {
        "id": 49,
        "raw": "[name=\"幻影弩手\"]  没了队长，我们没什么优势。",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "没了队长，我们没什么优势。"
    },
    {
        "id": 50,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 51,
        "raw": "[name=\"盾卫\"]  但你们可以做到！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "但你们可以做到！"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 53,
        "raw": "[name=\"幻影弩手\"]  对。",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "对。"
    },
    {
        "id": 54,
        "raw": "[name=\"幻影弩手\"]  浮士德队长为了我们连命都可以不要。",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "浮士德队长为了我们连命都可以不要。"
    },
    {
        "id": 55,
        "raw": "[name=\"幻影弩手\"]  ......如果那个罗德岛的兔子真的可以为队长报仇，那我们的命也确实不算什么！",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "......如果那个罗德岛的兔子真的可以为队长报仇，那我们的命也确实不算什么！"
    },
    {
        "id": 56,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 57,
        "raw": "[name=\"迷迭香\"]  不。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "不。"
    },
    {
        "id": 58,
        "raw": "[name=\"迷迭香\"]  不用这样的。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "不用这样的。"
    },
    {
        "id": 59,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 60,
        "raw": "[name=\"幻影弩手\"]  啊......罗德岛的......",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "啊......罗德岛的......"
    },
    {
        "id": 61,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 62,
        "raw": "[name=\"迷迭香\"]  直接轰炸他们的阵地，是吗？",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "直接轰炸他们的阵地，是吗？"
    },
    {
        "id": 63,
        "raw": "[PlaySound(key=\"$d_gen_transmissionget\",volume=0.6)]",
        "type": "play_sound",
        "key": "audio/sound_beta_2/avg/d_gen_transmissionget.mp3",
        "volume": 0.6
    },
    {
        "id": 64,
        "raw": "[name=\"迷迭香\"]  Raidian，收到信息的话，帮我干扰他们的通讯。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "Raidian，收到信息的话，帮我干扰他们的通讯。"
    },
    {
        "id": 65,
        "raw": "[name=\"迷迭香\"]  一瞬间里让他们的耳机都爆炸就好了。啊，嗯，声音大一点，不是真的爆炸。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "一瞬间里让他们的耳机都爆炸就好了。啊，嗯，声音大一点，不是真的爆炸。"
    },
    {
        "id": 66,
        "raw": "[name=\"迷迭香\"]  当然把他们的耳朵炸掉也是可以的。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "当然把他们的耳朵炸掉也是可以的。"
    },
    {
        "id": 67,
        "raw": "[name=\"迷迭香\"]  好的，五秒是吗。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "好的，五秒是吗。"
    },
    {
        "id": 68,
        "raw": "[name=\"迷迭香\"]  四秒，幻影弩手们，准备。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "四秒，幻影弩手们，准备。"
    },
    {
        "id": 69,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 70,
        "raw": "[name=\"幻影弩手\"]  什么？！",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "什么？！"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 72,
        "raw": "[name=\"迷迭香\"]  三秒。Guard，让队伍散开。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "三秒。Guard，让队伍散开。"
    },
    {
        "id": 73,
        "raw": "[Character(name=\"avg_npc_059\")]",
        "type": "character",
        "name": "avg_npc_059.png"
    },
    {
        "id": 74,
        "raw": "[name=\"罗德岛近卫干员？\"]  ......我信你一回。",
        "type": "dialog",
        "speaker": "罗德岛近卫干员？",
        "content": "......我信你一回。"
    },
    {
        "id": 75,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 76,
        "raw": "[name=\"迷迭香\"]  盾卫，撤盾。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "盾卫，撤盾。"
    },
    {
        "id": 77,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 78,
        "raw": "[name=\"盾卫\"]  你会暴露！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "你会暴露！"
    },
    {
        "id": 79,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 80,
        "raw": "[name=\"迷迭香\"]  也没关系。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "也没关系。"
    },
    {
        "id": 81,
        "raw": "[Character(name=\"char_1002_nsabr_1\")]",
        "type": "character",
        "name": "char_1002_nsabr_1.png"
    },
    {
        "id": 82,
        "raw": "[name=\"整合运动成员\"]  可是，游击队兄弟......",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "可是，游击队兄弟......"
    },
    {
        "id": 83,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 84,
        "raw": "[name=\"迷迭香\"]  一秒。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "一秒。"
    },
    {
        "id": 85,
        "raw": "[Character(name=\"avg_npc_058\")]",
        "type": "character",
        "name": "avg_npc_058.png"
    },
    {
        "id": 86,
        "raw": "[name=\"盾卫\"]  肯把命托付给我们的人，我们的命，当然也由她！",
        "type": "dialog",
        "speaker": "盾卫",
        "content": "肯把命托付给我们的人，我们的命，当然也由她！"
    },
    {
        "id": 87,
        "raw": "[Character(name=\"avg_npc_016\")]",
        "type": "character",
        "name": "avg_npc_016.png"
    },
    {
        "id": 88,
        "raw": "[name=\"幻影弩手\"]  啊，那些混在整合运动里的家伙突然倒下了！",
        "type": "dialog",
        "speaker": "幻影弩手",
        "content": "啊，那些混在整合运动里的家伙突然倒下了！"
    },
    {
        "id": 89,
        "raw": "[Character(name=\"avg_npc_042\")]",
        "type": "character",
        "name": "avg_npc_042.png"
    },
    {
        "id": 90,
        "raw": "[name=\"迷迭香\"]  三把。",
        "type": "dialog",
        "speaker": "迷迭香",
        "content": "三把。"
    },
    {
