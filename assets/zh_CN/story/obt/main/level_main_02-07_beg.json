        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 24,
        "raw": "[name=\"雷蛇\"]   平时老说要传染我的不是你吗！",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "平时老说要传染我的不是你吗！"
