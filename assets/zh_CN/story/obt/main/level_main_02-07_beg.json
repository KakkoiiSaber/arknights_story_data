    },
    {
        "id": 10,
        "raw": "[name=\"阿米娅\"]   这，这是矿石病发作的征兆！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这，这是矿石病发作的征兆！"
    },
    {
        "id": 11,
        "raw": "[name=\"阿米娅\"]   啧，才一星期就......！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啧，才一星期就......！"
    },
    {
