        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"雷蛇\"]   芙兰卡，你是哪种？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "芙兰卡，你是哪种？"
    },
    {
