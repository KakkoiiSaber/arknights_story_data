        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 17,
        "raw": "[name=\"芙兰卡\"]   怎么，关心我了吗？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "怎么，关心我了吗？"
    },
    {
        "id": 18,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 19,
        "raw": "[name=\"雷蛇\"]   阿米娅，如果芙兰卡病逝了，我希望能在罗德岛火化她。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "阿米娅，如果芙兰卡病逝了，我希望能在罗德岛火化她。"
    },
    {
        "id": 20,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
