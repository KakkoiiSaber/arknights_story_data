    {
        "id": 58,
        "raw": "[name=\"整合运动成员\"]   大家都是感染者，我们不想动粗！别挡路！",
        "type": "dialog",
        "speaker": "整合运动成员",
        "content": "大家都是感染者，我们不想动粗！别挡路！"
    },
