        "focus": 2
    },
    {
        "id": 13,
        "raw": "[name=\"雷蛇\"]   矿石病也有急性的吗？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "矿石病也有急性的吗？"
    },
