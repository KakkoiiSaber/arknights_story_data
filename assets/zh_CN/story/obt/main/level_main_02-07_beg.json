        "name": "char_106_franka_1",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 21,
        "raw": "[name=\"芙兰卡\"]   喂！",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "喂！"
    },
    {
        "id": 22,
        "raw": "[name=\"芙兰卡\"]   你很过分哦，雷蛇！",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "你很过分哦，雷蛇！"
    },
