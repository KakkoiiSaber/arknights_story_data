        "name": "avg_npc_037",
        "name2": "char_002_amiya_1#1",
        "focus": 2
    },
    {
        "id": 71,
        "raw": "[name=\"阿米娅\"]  请问先生，我该怎么称呼你？",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "请问先生，我该怎么称呼你？"
    },
    {
        "id": 72,
