        "name2": "char_002_amiya_1#1",
        "focus": 1
    },
    {
        "id": 77,
        "raw": "[name=\"雪怪小队成员A\"]  抱歉，抱歉！就，就缓和下气氛。就叫雪怪1号怎么样？",
        "type": "dialog",
        "speaker": "雪怪小队成员A",
        "content": "抱歉，抱歉！就，就缓和下气氛。就叫雪怪1号怎么样？"
