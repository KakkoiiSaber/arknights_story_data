    {
        "id": 68,
        "raw": "[name=\"？？？\"]  赦罪师，回答。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "赦罪师，回答。"
    },
    {
        "id": 69,
        "raw": "[name=\"？？？\"]  整合运动的领袖，是否有结盟的价值？",
        "type": "dialog",
        "speaker": "？？？",
        "content": "整合运动的领袖，是否有结盟的价值？"
    },
    {
        "id": 70,
        "raw": "[Dialog]",
        "type": "dialog_marker"
    },
    {
        "id": 71,
        "raw": "[Character(name=\"avg_npc_055\",fadetime=1,block=true)]",
        "type": "character",
        "name": "avg_npc_055",
        "fadetime": "1,block=true"
    },
    {
        "id": 72,
        "raw": "[delay(time=2)]",
        "type": "delay",
        "time": 2
    },
    {
        "id": 73,
        "raw": "[name=\"赦罪师\"]  你很清楚的事情又何必问我，摄政王殿下？",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "你很清楚的事情又何必问我，摄政王殿下？"
    },
    {
        "id": 74,
        "raw": "[name=\"赦罪师\"]  一个没有积累、没有背景、没有资本的青年，不可能凭一己之力拿下乌萨斯的重要城市。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "一个没有积累、没有背景、没有资本的青年，不可能凭一己之力拿下乌萨斯的重要城市。"
    },
    {
        "id": 75,
        "raw": "[name=\"赦罪师\"]  身为非感染者的统治者们，并不清楚蕴含在她行为里的逻辑。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "身为非感染者的统治者们，并不清楚蕴含在她行为里的逻辑。"
    },
    {
        "id": 76,
        "raw": "[name=\"赦罪师\"]  他们会一味恐惧，反应过激，尝试通过破坏性的行为去解决混乱的局面——感染者带来的混乱局面。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "他们会一味恐惧，反应过激，尝试通过破坏性的行为去解决混乱的局面——感染者带来的混乱局面。"
    },
    {
        "id": 77,
        "raw": "[name=\"赦罪师\"]  但我们萨卡兹再清楚不过了。",
        "type": "dialog",
        "speaker": "赦罪师",
        "content": "但我们萨卡兹再清楚不过了。"
    },
