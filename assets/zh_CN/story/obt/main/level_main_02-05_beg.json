        "type": "character",
        "name": "char_002_amiya_1.png"
    },
    {
        "id": 57,
        "raw": "[name=\"阿米娅\"]   芙兰卡，集合各个小队，我们——",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "芙兰卡，集合各个小队，我们——"
