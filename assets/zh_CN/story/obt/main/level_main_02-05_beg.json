        "focus": 2
    },
    {
        "id": 33,
        "raw": "[name=\"芙兰卡\"]   阿米娅，企鹅物流的德克萨斯已归队。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "阿米娅，企鹅物流的德克萨斯已归队。"
    },
    {
        "id": 34,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_106_franka_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_106_franka_1",
        "focus": 1
    },
    {
        "id": 35,
        "raw": "[name=\"阿米娅\"]   啊......太好了！",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "啊......太好了！"
    },
    {
        "id": 36,
        "raw": "[Character(name=\"char_002_amiya_1#2\", name2=\"char_102_texas_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1#2.png",
        "name2": "char_102_texas_1",
        "focus": 2
    },
    {
        "id": 37,
        "raw": "[name=\"德克萨斯\"]   有些新情况。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "有些新情况。"
    },
    {
        "id": 38,
        "raw": "[name=\"德克萨斯\"]   我干掉了不少，那些叫整合运动的。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "我干掉了不少，那些叫整合运动的。"
    },
    {
        "id": 39,
        "raw": "[name=\"德克萨斯\"]   ——但他们后面，跟着的更多。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "——但他们后面，跟着的更多。"
    },
    {
        "id": 40,
        "raw": "[name=\"德克萨斯\"]   整合运动已经放弃了最开始的伪装，开始集体行动了。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "整合运动已经放弃了最开始的伪装，开始集体行动了。"
    },
    {
        "id": 41,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_102_texas_1\", focus=1)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_102_texas_1",
        "focus": 1
    },
    {
        "id": 42,
        "raw": "[name=\"阿米娅\"]   ......果然是这样吗......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "......果然是这样吗......"
    },
    {
        "id": 43,
        "raw": "[name=\"阿米娅\"]   整合运动已经通过贫民区混进龙门......",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "整合运动已经通过贫民区混进龙门......"
    },
    {
        "id": 44,
        "raw": "[name=\"阿米娅\"]   而且......目标和我们相同。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "而且......目标和我们相同。"
    },
    {
        "id": 45,
        "raw": "[name=\"阿米娅\"]   否则，他们没理由追击我们罗德岛。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "否则，他们没理由追击我们罗德岛。"
    },
    {
        "id": 46,
        "raw": "[Character(name=\"char_002_amiya_1\", name2=\"char_107_liskam_1\", focus=2)]",
        "type": "character",
        "name": "char_002_amiya_1.png",
        "name2": "char_107_liskam_1",
        "focus": 2
    },
    {
        "id": 47,
        "raw": "[name=\"雷蛇\"]   米莎小姐身上，有龙门和整合运动才知道的秘密。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "米莎小姐身上，有龙门和整合运动才知道的秘密。"
    },
    {
        "id": 48,
        "raw": "[name=\"雷蛇\"]   这对罗德岛很不利。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "这对罗德岛很不利。"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_107_liskam_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_107_liskam_1",
        "focus": 1
    },
    {
        "id": 50,
        "raw": "[name=\"芙兰卡\"]   形势有点不容乐观啊。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "形势有点不容乐观啊。"
    },
    {
        "id": 51,
        "raw": "[name=\"芙兰卡\"]   一会儿得去戳戳那个督察的漂亮脸蛋问个明白了。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "一会儿得去戳戳那个督察的漂亮脸蛋问个明白了。"
    },
    {
        "id": 52,
        "raw": "[Character(name=\"char_102_texas_1\")]",
        "type": "character",
        "name": "char_102_texas_1.png"
    },
    {
        "id": 53,
        "raw": "[name=\"德克萨斯\"]   ......还有事吗？",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "......还有事吗？"
    },
    {
        "id": 54,
        "raw": "[name=\"德克萨斯\"]   没事的话，我来带路。我很清楚该怎么走！",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "没事的话，我来带路。我很清楚该怎么走！"
    },
    {
        "id": 55,
        "raw": "[name=\"德克萨斯\"]   能天使已经确定了撤退路线，我带你们过去。",
        "type": "dialog",
        "speaker": "德克萨斯",
        "content": "能天使已经确定了撤退路线，我带你们过去。"
