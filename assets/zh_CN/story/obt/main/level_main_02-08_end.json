    },
    {
        "id": 80,
        "raw": "[name=\"弑君者\"]   进攻龙门对于整合运动，确实有战略性的意义。",
        "type": "dialog",
        "speaker": "弑君者",
        "content": "进攻龙门对于整合运动，确实有战略性的意义。"
    },
    {
        "id": 81,
        "raw": "[name=\"弑君者\"]   拿下龙门，整合运动能获得种种优势。",
        "type": "dialog",
        "speaker": "弑君者",
        "content": "拿下龙门，整合运动能获得种种优势。"
    },
    {
        "id": 82,
        "raw": "[name=\"弑君者\"]   但是风险与代价都很高。",
        "type": "dialog",
        "speaker": "弑君者",
        "content": "但是风险与代价都很高。"
    },
    {
        "id": 83,
        "raw": "[name=\"弑君者\"]   ——为什么那么执着？",
        "type": "dialog",
        "speaker": "弑君者",
        "content": "——为什么那么执着？"
    },
    {
