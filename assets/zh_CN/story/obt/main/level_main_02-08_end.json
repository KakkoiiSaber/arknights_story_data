    {
        "id": 5,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 6,
        "raw": "[name=\"芙兰卡\"]   呼，呼。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "呼，呼。"
    },
    {
        "id": 7,
        "raw": "[name=\"芙兰卡\"]   近卫局的护送队已经安全离开了。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "近卫局的护送队已经安全离开了。"
    },
    {
        "id": 8,
        "raw": "[name=\"芙兰卡\"]   而敌人嘛——暂时也不打算放过我们的样子。",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "而敌人嘛——暂时也不打算放过我们的样子。"
    },
    {
        "id": 9,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 10,
        "raw": "[name=\"阿米娅\"]   只要敌人还不知道米莎被近卫局接走，他们就越把注意力放在我们身上。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "只要敌人还不知道米莎被近卫局接走，他们就越把注意力放在我们身上。"
    },
    {
        "id": 11,
        "raw": "[name=\"阿米娅\"]   这样的话，米莎那边就越安全。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "这样的话，米莎那边就越安全。"
    },
    {
        "id": 12,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"雷蛇\"]   其实，为什么龙门和整合运动都要找这个孩子？",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "其实，为什么龙门和整合运动都要找这个孩子？"
    },
    {
        "id": 14,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 15,
        "raw": "[name=\"阿米娅\"]   不清楚，可能性很多。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不清楚，可能性很多。"
    },
    {
        "id": 16,
        "raw": "[name=\"阿米娅\"]   我能想到的是，这孩子本人，或者只有她知情的什么东西……足以影响——甚至，左右龙门的安危。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我能想到的是，这孩子本人，或者只有她知情的什么东西……足以影响——甚至，左右龙门的安危。"
    },
    {
        "id": 17,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 18,
        "raw": "[name=\"芙兰卡\"]   东西？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "东西？"
    },
    {
        "id": 19,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 20,
        "raw": "[name=\"阿米娅\"]   是的，也许是情报，也许是信息……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "是的，也许是情报，也许是信息……"
    },
    {
        "id": 21,
        "raw": "[name=\"阿米娅\"]   所以龙门和整合运动，都想得到她。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "所以龙门和整合运动，都想得到她。"
    },
    {
        "id": 22,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 23,
        "raw": "[name=\"雷蛇\"]   ——真是场危险的较量。",
        "type": "dialog",
        "speaker": "雷蛇",
        "content": "——真是场危险的较量。"
    },
    {
        "id": 24,
        "raw": "[Character(name=\"char_107_liskam_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_107_liskam_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 25,
        "raw": "[name=\"阿米娅\"]   不管是米莎、我们还是近卫局，都无法置身其外。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不管是米莎、我们还是近卫局，都无法置身其外。"
    },
    {
        "id": 26,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=1)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 1
    },
    {
        "id": 27,
        "raw": "[name=\"芙兰卡\"]   我们是不是被夹在很尴尬的位置啊？",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "我们是不是被夹在很尴尬的位置啊？"
    },
    {
        "id": 28,
        "raw": "[name=\"芙兰卡\"]   什么都不知道，又什么都要管……",
        "type": "dialog",
        "speaker": "芙兰卡",
        "content": "什么都不知道，又什么都要管……"
    },
    {
        "id": 29,
        "raw": "[Character(name=\"char_106_franka_1\", name2=\"char_002_amiya_1\", focus=2)]",
        "type": "character",
        "name": "char_106_franka_1.png",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "id": 30,
        "raw": "[name=\"阿米娅\"]   不，不清楚呢……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "不，不清楚呢……"
    },
    {
        "id": 31,
        "raw": "[name=\"阿米娅\"]   但陈长官那里……",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "但陈长官那里……"
    },
    {
        "id": 32,
        "raw": "[name=\"阿米娅\"]   我有预感。事情不会这么简单就结束。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "我有预感。事情不会这么简单就结束。"
    },
