        "id": 140,
        "raw": "[Character(name=\"avg_npc_038\",name2=\"char_010_chen_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_038",
        "name2": "char_010_chen_1#4",
        "focus": 2
    },
    {
        "id": 141,
        "raw": "[name=\"陈\"]  威胁我没有用。回答问题，这片区域的居民去了哪里？",
        "type": "dialog",
        "speaker": "陈",
        "content": "威胁我没有用。回答问题，这片区域的居民去了哪里？"
    },
    {
        "id": 142,
        "raw": "[Character(name=\"avg_npc_038\",name2=\"char_010_chen_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_038",
        "name2": "char_010_chen_1#4",
        "focus": 1
    },
    {
        "id": 143,
        "raw": "[name=\"？？？\"]  ——",
        "type": "dialog",
        "speaker": "？？？",
        "content": "——"
    },
    {
        "id": 144,
        "raw": "[Character(name=\"avg_npc_038\",name2=\"char_010_chen_1#4\",focus=2)]",
        "type": "character",
        "name": "avg_npc_038",
        "name2": "char_010_chen_1#4",
        "focus": 2
    },
    {
        "id": 145,
        "raw": "[name=\"陈\"]  我的手指就按在全员通报键上，你们想和近卫局全面为敌只要短短一秒。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我的手指就按在全员通报键上，你们想和近卫局全面为敌只要短短一秒。"
    },
    {
        "id": 146,
        "raw": "[name=\"陈\"]  或者，你可以在一秒钟之内，偏转我的剑刃，切掉我的手臂，拿下通讯器。",
        "type": "dialog",
        "speaker": "陈",
        "content": "或者，你可以在一秒钟之内，偏转我的剑刃，切掉我的手臂，拿下通讯器。"
    },
    {
        "id": 147,
        "raw": "[name=\"陈\"]  贫民区的居民究竟去了哪里？",
        "type": "dialog",
        "speaker": "陈",
        "content": "贫民区的居民究竟去了哪里？"
    },
    {
        "id": 148,
        "raw": "[Character(name=\"avg_npc_038\",name2=\"char_010_chen_1#4\",focus=1)]",
        "type": "character",
        "name": "avg_npc_038",
        "name2": "char_010_chen_1#4",
        "focus": 1
    },
    {
        "id": 149,
        "raw": "[name=\"？？？\"]  我们会退出这里。陈，我们一起退出。现在这段时间，我们互不干扰。",
        "type": "dialog",
        "speaker": "？？？",
        "content": "我们会退出这里。陈，我们一起退出。现在这段时间，我们互不干扰。"
    },
