        "focus": 1
    },
    {
        "id": 13,
        "raw": "[name=\"阿米娅\"]  嗯，我没事。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "嗯，我没事。"
    },
    {
        "id": 14,
        "raw": "[name=\"阿米娅\"]  依然能联系上煌、博士，以及灰喉吧？",
        "type": "dialog",
        "speaker": "阿米娅",
