    },
    {
        "id": 48,
        "raw": "[name=\"陈\"]  什么人？！",
        "type": "dialog",
        "speaker": "陈",
        "content": "什么人？！"
    },
    {
        "id": 49,
        "raw": "[Character(name=\"char_010_chen_1#2\",name2=\"char_015_lmg\",focus=2)]",
        "type": "character",
        "name": "char_010_chen_1#2",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "id": 50,
        "raw": "[name=\"近卫局成员\"]  报告！是我！",
        "type": "dialog",
        "speaker": "近卫局成员",
        "content": "报告！是我！"
    },
    {
        "id": 51,
        "raw": "[Character(name=\"char_010_chen_1#4\",name2=\"char_015_lmg\",focus=1)]",
        "type": "character",
        "name": "char_010_chen_1#4",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "id": 52,
        "raw": "[name=\"陈\"]  不是说你......",
        "type": "dialog",
