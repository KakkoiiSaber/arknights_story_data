        "focus": 1
    },
    {
        "id": 186,
        "raw": "[name=\"诗怀雅\"]  ......怎么回事？你刚刚是和谁，吵了什么？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "......怎么回事？你刚刚是和谁，吵了什么？"
    },
    {
        "id": 187,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 188,
        "raw": "[name=\"陈\"]  龙门的特殊力量私下出动了。这片区域内的所有居民都生死不明。",
        "type": "dialog",
        "speaker": "陈",
        "content": "龙门的特殊力量私下出动了。这片区域内的所有居民都生死不明。"
    },
    {
        "id": 189,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 190,
        "raw": "[name=\"诗怀雅\"]  啊？你说啥？怎么会有这种东西......",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "啊？你说啥？怎么会有这种东西......"
    },
    {
        "id": 191,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "id": 192,
        "raw": "[name=\"陈\"]  别蒙我，你心里有底。至少你听过，你绝对知道。",
        "type": "dialog",
        "speaker": "陈",
        "content": "别蒙我，你心里有底。至少你听过，你绝对知道。"
    },
    {
        "id": 193,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#5\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "id": 194,
        "raw": "[name=\"诗怀雅\"]  ......我哪知道？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "......我哪知道？"
    },
    {
        "id": 195,
        "raw": "[name=\"诗怀雅\"]  不，你也知道？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "不，你也知道？"
    },
    {
        "id": 196,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 197,
        "raw": "[name=\"陈\"]  我不知道。但你的祖父一定知道。",
        "type": "dialog",
        "speaker": "陈",
        "content": "我不知道。但你的祖父一定知道。"
    },
    {
        "id": 198,
        "raw": "[Character(name=\"char_308_swire_1#6\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#6",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 199,
        "raw": "[name=\"诗怀雅\"]  啊？你在说啥，我一点都不懂！丢啊，能不能说直白点！",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "啊？你在说啥，我一点都不懂！丢啊，能不能说直白点！"
    },
    {
        "id": 200,
        "raw": "[name=\"诗怀雅\"]  我爷爷到现在还趟在病床上，他连话都说不清！",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "我爷爷到现在还趟在病床上，他连话都说不清！"
    },
    {
        "id": 201,
        "raw": "[Character(name=\"char_308_swire_1#6\",name2=\"char_010_chen_1#2\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#6",
        "name2": "char_010_chen_1#2",
        "focus": 2
    },
    {
        "id": 202,
        "raw": "[name=\"陈\"]  难道疾病就能阻止他操作龙门？你祖父是什么人，你比我清楚！",
        "type": "dialog",
        "speaker": "陈",
        "content": "难道疾病就能阻止他操作龙门？你祖父是什么人，你比我清楚！"
    },
    {
        "id": 203,
        "raw": "[Character(name=\"char_308_swire_1#6\",name2=\"char_010_chen_1#2\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#6",
        "name2": "char_010_chen_1#2",
        "focus": 1
    },
    {
        "id": 204,
        "raw": "[name=\"诗怀雅\"]  绝对不可能！",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "绝对不可能！"
    },
    {
        "id": 205,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#2\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#2",
        "focus": 1
    },
    {
        "id": 206,
        "raw": "[name=\"诗怀雅\"]  ......但......",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "......但......"
    },
    {
        "id": 207,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 208,
        "raw": "[name=\"陈\"]  你想说谁？",
        "type": "dialog",
        "speaker": "陈",
        "content": "你想说谁？"
    },
    {
        "id": 209,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 210,
        "raw": "[name=\"诗怀雅\"]  “灰色的林”。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "“灰色的林”。"
    },
    {
        "id": 211,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=2)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "id": 212,
        "raw": "[name=\"陈\"]  哼，现在“不可能”这三个字，该轮到我来说了。林视整个贫民区如己出，怎么会允许这种事发生？",
        "type": "dialog",
        "speaker": "陈",
        "content": "哼，现在“不可能”这三个字，该轮到我来说了。林视整个贫民区如己出，怎么会允许这种事发生？"
    },
    {
        "id": 213,
        "raw": "[Character(name=\"char_308_swire_1#5\",name2=\"char_010_chen_1#1\",focus=1)]",
        "type": "character",
        "name": "char_308_swire_1#5",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "id": 214,
        "raw": "[name=\"诗怀雅\"]  打个电话问问，也许就知道了。",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "打个电话问问，也许就知道了。"
    },
    {
        "id": 215,
        "raw": "[name=\"诗怀雅\"]  你来？还是我来？",
        "type": "dialog",
        "speaker": "诗怀雅",
        "content": "你来？还是我来？"
    },
