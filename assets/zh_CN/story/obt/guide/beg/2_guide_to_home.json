        "name": "char_002_amiya_1#2",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "id": 58,
        "raw": "[name=\"杜宾\"]   一个感染者权益组织......本来我觉得他们只是有点盲目激进————",
        "type": "dialog",
        "speaker": "杜宾",
        "content": "一个感染者权益组织......本来我觉得他们只是有点盲目激进————"
    },
