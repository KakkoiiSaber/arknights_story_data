        "type": "character",
        "name": "char_002_amiya_1#1",
        "focus": -1
    },
    {
        "id": 132,
        "raw": "[name=\"PRTS\"]   不需要使用您的神经连接操作罗德岛的话，我将在稍后断开连接。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "不需要使用您的神经连接操作罗德岛的话，我将在稍后断开连接。"
    },
    {
        "id": 133,
        "raw": "[name=\"PRTS\"]   如果打扰到了您的派对，万分抱歉。",
        "type": "dialog",
        "speaker": "PRTS",
        "content": "如果打扰到了您的派对，万分抱歉。"
