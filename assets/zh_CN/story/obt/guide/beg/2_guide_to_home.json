        "type": "character",
        "name": "char_002_amiya_1#1",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "id": 63,
        "raw": "[name=\"阿米娅\"]   好的。我们已经成功救出博士，之后按照计划撤退就可以了。",
        "type": "dialog",
        "speaker": "阿米娅",
        "content": "好的。我们已经成功救出博士，之后按照计划撤退就可以了。"
